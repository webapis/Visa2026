<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="data.xlsx" />
    <None Remove="lookup.xlsm" />
    <None Remove="data.yaml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="data.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <Content Include="lookup.xlsm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="seed\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Visa2026.Module\DatabaseUpdate\LookupCatalogs\ApplicationTypeConfigurationCatalog.json">
      <Link>LookupCatalogs\ApplicationTypeConfigurationCatalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="data.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="legacy\visa2014\field-maps\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Visa2026.Blazor.Server\Visa2026.Blazor.Server.csproj" />
    <ProjectReference Include="..\Visa2026.Module\Visa2026.Module.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="legacy\visa2014\preview-export\_education-lookup-gap\**\*" />
    <None Include="legacy\visa2014\preview-export\_education-lookup-gap\**\*" />
    <Compile Remove="legacy\visa2014\preview-export\_address-lookup-gap\**\*" />
    <None Include="legacy\visa2014\preview-export\_address-lookup-gap\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.5" />
    <PackageReference Include="System.Text.Json" Version="9.0.6" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
