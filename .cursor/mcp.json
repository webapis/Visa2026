{
  "mcpServers": {
    "dxdocs": {
      "type": "sse",
      "url": "https://api.devexpress.com/mcp/docs"
    },
    "docker-docs": {
      "url": "https://mcp-docs.docker.com/mcp"
    },
    "visa2026-sql-local": {
      "command": "npx",
      "args": [
        "-y",
        "@connorbritain/mssql-mcp-reader@latest"
      ],
      "env": {
        "SERVER_NAME": "localhost\\SQLEXPRESS",
        "SQL_PORT": "1433",
        "DATABASE_NAME": "Visa2026DbDev",
        "SQL_AUTH_MODE": "sql",
        "SQL_USERNAME": "sa",
        "SQL_PASSWORD": "${env:SA_PASSWORD}",
        "TRUST_SERVER_CERTIFICATE": "true"
      }
    },
    "visa2014-sql-local": {
      "command": "npx",
      "args": [
        "-y",
        "@connorbritain/mssql-mcp-reader@latest"
      ],
      "env": {
        "SERVER_NAME": "localhost\\SQLEXPRESS",
        "SQL_PORT": "1433",
        "DATABASE_NAME": "VISA2015",
        "SQL_AUTH_MODE": "sql",
        "SQL_USERNAME": "sa",
        "SQL_PASSWORD": "${env:SA_PASSWORD}",
        "TRUST_SERVER_CERTIFICATE": "true"
      }
    },
    "visa2014-readonly-files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\webap\\Documents\\GitHub\\VISA2014"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests,actions"
      }
    }
  }
}