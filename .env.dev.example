# Copy to .env.dev and fill values for development/test.
# Match PG_PASSWORD with local F5 / appsettings when connecting from the host.
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_USER=postgres
DEVEXPRESS_LICENSEKEY=CHANGE_ME_LICENSE_KEY

# Optional overrides
APP_PORT=8081
DB_NAME=visa2026_dev
# Host-mapped Postgres port (default 5432). If local Postgres already uses 5432, set e.g. 5433.
# PG_HOST_PORT=5432
APP_IMAGE_TAG=latest
IMPORTER_IMAGE_TAG=latest
# One-shot: FORCE_XAF_DB_UPDATE=true (then remove) — see ENVIRONMENTS.md
# FORCE_XAF_DB_UPDATE=true

# Officer manual (separate nginx service; opt-in compose profile)
# COMPOSE_PROFILES=manual
# MANUAL_PORT=8083
# MANUAL_SITE_ROOT=./deploy/manual/site
# MANUAL_MEDIA_ROOT=./deploy/manual/media
# MANUAL_MEDIA_BASE_URL=https://localhost:8083/manual-media