# Demo playground — HTTP only on :8081 (Resminamalar Edit template needs HTTPS; use Staging for that).
SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEVEXPRESS_LICENSEKEY=CHANGE_ME_LICENSE_KEY

# PostgreSQL Demo pilot (recommended): EF Core uses Npgsql when EFCORE_PROVIDER=Postgres.
# Install PostgreSQL on the IIS host first; create empty DB matching DB_NAME.
EFCORE_PROVIDER=Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_PG_PASSWORD
DB_NAME=visa2026_demo

# SQL Server Demo (legacy): comment out EFCORE_PROVIDER / PG_* and set:
# DB_NAME=Visa2026DbDemo

# TEMPLATE_EDIT_STAGING_ENABLED=true
HTTPS_ENABLED=false
