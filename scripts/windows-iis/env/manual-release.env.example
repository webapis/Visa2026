# Copy to C:\visa2026\env\manual-release.env on the build/release host (e.g. 10.100.128.25).
# Used by Publish-Visa2026UserManualRelease.ps1 — never commit real paths with secrets.

# Public URL officers use for PNG/MP4 (baked into MkDocs HTML at build time)
MANUAL_MEDIA_BASE_URL=https://10.100.128.25:8082/manual-media

# IIS static roots (see Install-Visa2026ManualIisSite.ps1)
MANUAL_MEDIA_ROOT=C:\visa2026\manual\media
MANUAL_SITE_ROOT=C:\visa2026\manual\site

# Git checkout used to run Build-UserManual.ps1 / Record-EasyTest.ps1 on the server
REPO_ROOT=C:\visa2026\src\Visa2026

# Optional: default EasyTest filter when -Record is passed
# MANUAL_RECORD_FILTER=PersonOfficerJourney_LoginCreateEmployeeAddPassport
