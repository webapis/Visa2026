# Copy to C:\visa2026\env\prod.env on the server. Never commit real secrets.
SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DEVEXPRESS_LICENSEKEY=CHANGE_ME_LICENSE_KEY

# PostgreSQL (Production cutover): EF Core uses Npgsql when EFCORE_PROVIDER=Postgres.
# Install PostgreSQL on the IIS host first; create empty DB matching DB_NAME.
EFCORE_PROVIDER=Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_PG_PASSWORD
DB_NAME=visa2026_prod

# SQL Server Production (rollback): comment out EFCORE_PROVIDER / PG_* and set:
# DB_NAME=Visa2026DbProd

# One-shot: FORCE_XAF_DB_UPDATE=true on app pool (then remove) — see docs/ENVIRONMENTS.md
# FORCE_XAF_DB_UPDATE=true
# Resminamalar local sandbox template editing (HTTPS required for File System Access API):
# TEMPLATE_EDIT_STAGING_ENABLED=true
# HTTPS_ENABLED=true
# HTTPS_PORT=443
