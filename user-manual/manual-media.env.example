# Officer manual remote media (optional).
# Copy to repo root or set in your shell before Build-UserManual.ps1 / Serve-UserManual.ps1.
#
# When set, MkDocs rewrites guide links:
#   ../../assets/screenshots/v2026.08/en/login-step-01-logon.png
# to:
#   https://10.100.128.25:8082/manual-media/screenshots/v2026.08/en/login-step-01-logon.png
#
# Layout on the server must mirror user-manual/assets/:
#   {base}/screenshots/v{version}/{locale}/*.png
#   {base}/videos/v{version}/{locale}/*.mp4
#
# Unset for local preview (default): assets copied to user-manual/docs/assets/

MANUAL_MEDIA_BASE_URL=https://10.100.128.25:8082/manual-media

# Home-page footer link to the separate test results dashboard (not officer guide content).
# On-prem IIS (same host): /manual-test-reports/latest/summary.html
# Local preview: http://127.0.0.1:8766/latest/summary.html
# MANUAL_TEST_REPORT_URL=/manual-test-reports/latest/summary.html
