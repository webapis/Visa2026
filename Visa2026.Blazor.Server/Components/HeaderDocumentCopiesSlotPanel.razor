@namespace Visa2026.Blazor.Server.Components
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.Extensions.DependencyInjection
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.HeaderLinkedDocuments
@using Visa2026.Module.Services.PreviewSlot

<div class="resminamalar-slot-panel header-document-copies-slot-panel document-copies-slot-panel @(_previewActive ? "resminamalar-slot-panel--preview" : string.Empty)">
    @if (!_previewActive)
    {
        <div class="resminamalar-slot-panel__header visa-preview-drawer__header">
            <span class="visa-preview-drawer__title">@Title</span>
            <div class="visa-preview-drawer__header-actions">
                <button class="visa-preview-drawer__btn visa-preview-drawer__btn--close"
                        type="button"
                        title="@CloseLabel"
                        @onclick="ClosePanelAsync">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <div class="resminamalar-slot-panel__body">
        @if (!_previewActive)
        {
            <div class="resminamalar-slot-panel__catalog">
                <HeaderDocumentCopiesComponent Snapshot="_snapshot"
                                               UiCultureName="_uiCultureName"
                                               UseInlinePreview="true"
                                               RefreshRequested="_refreshRequested"
                                               OnInlinePreviewRequested="HandleInlinePreviewAsync" />
            </div>
        }
        else
        {
            <HeaderDocumentCopiesInlinePreview @ref="_inlinePreview"
                                               Family="_family"
                                               ParentId="_parentId"
                                               UiCultureName="_uiCultureName"
                                               PreviewClosed="OnPreviewClosedAsync" />
        }
    </div>
</div>

@code {
    [Parameter] public HeaderDocumentCopiesSlotRequest? Request { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService SlotService { get; set; } = null!;

    private HeaderDocumentCopiesFamily _family;
    private Guid _parentId;
    private HeaderLinkedDocumentsSnapshot _snapshot = new();
    private string _uiCultureName = string.Empty;
    private bool _previewActive;
    private HeaderDocumentCopiesInlinePreview? _inlinePreview;
    private EventCallback _refreshRequested;
    private string? _boundBindingKey;

    private string Title => HeaderDocumentCopiesLocalization.Title(_family, _uiCultureName);
    private string CloseLabel => VisaUiMessages.Get("PersonDocumentCopies.Action.Close", _uiCultureName);

    protected override void OnInitialized()
    {
        _refreshRequested = EventCallback.Factory.Create(this, ReloadSnapshotAsync);
        _uiCultureName = VisaUiCultureResolver.Resolve();
    }

    protected override void OnParametersSet()
    {
        if (Request == null || Request.ParentId == Guid.Empty)
        {
            _family = default;
            _parentId = Guid.Empty;
            _snapshot = new HeaderLinkedDocumentsSnapshot();
            _boundBindingKey = null;
            _previewActive = false;
            return;
        }

        var bindingKey = BuildBindingKey(Request);
        if (!string.Equals(_boundBindingKey, bindingKey, StringComparison.Ordinal))
        {
            _boundBindingKey = bindingKey;
            _previewActive = false;
        }

        _family = Request.Family;
        _parentId = Request.ParentId;
        ReloadSnapshot();
    }

    private static string BuildBindingKey(HeaderDocumentCopiesSlotRequest request)
    {
        var occupant = VisaPreviewSlotOccupantKeys.ForHeaderDocumentCopies(request);
        var context = request.ContextItemId?.ToString("N") ?? string.Empty;
        return $"{occupant}:{context}";
    }

    private void ReloadSnapshot()
    {
        if (_parentId == Guid.Empty)
        {
            _snapshot = new HeaderLinkedDocumentsSnapshot();
            return;
        }

        using var objectSpace = CreateObjectSpace(_family);
        if (objectSpace == null)
        {
            _snapshot = new HeaderLinkedDocumentsSnapshot
            {
                Family = _family,
                ParentId = _parentId,
                ContextItemId = Request?.ContextItemId,
            };
            return;
        }

        _snapshot = HeaderLinkedDocumentsResolver.Resolve(
            objectSpace,
            _family,
            _parentId,
            Request?.ContextItemId);
    }

    private IObjectSpace? CreateObjectSpace(HeaderDocumentCopiesFamily family) =>
        family switch
        {
            HeaderDocumentCopiesFamily.WorkPermit => ObjectSpaceFactory.CreateNonSecuredObjectSpace<WorkPermit>(),
            HeaderDocumentCopiesFamily.Invitation => ObjectSpaceFactory.CreateNonSecuredObjectSpace<Invitation>(),
            HeaderDocumentCopiesFamily.Rejection => ObjectSpaceFactory.CreateNonSecuredObjectSpace<Rejection>(),
            HeaderDocumentCopiesFamily.BorderZone => ObjectSpaceFactory.CreateNonSecuredObjectSpace<BorderZone>(),
            _ => null,
        };

    private Task ReloadSnapshotAsync()
    {
        ReloadSnapshot();
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleInlinePreviewAsync(HeaderDocumentCopiesInlinePreviewRequest request)
    {
        _previewActive = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (_inlinePreview != null)
            await _inlinePreview.OpenAsync(request);
    }

    private async Task OnPreviewClosedAsync()
    {
        _previewActive = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePanelAsync()
    {
        _previewActive = false;
        if (CloseRequested.HasDelegate)
            await CloseRequested.InvokeAsync();
        else
            await SlotService.CloseAsync();
    }
}
