@namespace Visa2026.Blazor.Server.Components
@using Microsoft.JSInterop
@using System.Text.Json
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.Services.HeaderLinkedDocuments
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.WordReports
@using Visa2026.Blazor.Server.Controllers
@implements IAsyncDisposable

<div class="visa-preview-slot__host">
@if (_state.Tabs.Count > 1)
{
    <div class="visa-preview-slot__tabs" role="tablist" aria-label="Preview tabs">
        @foreach (var tab in _state.Tabs)
        {
            <div class="visa-preview-slot__tab @(tab.IsActive ? "visa-preview-slot__tab--active" : null)" role="presentation">
                <button type="button"
                        class="visa-preview-slot__tab-btn"
                        role="tab"
                        aria-selected="@tab.IsActive"
                        title="@tab.Title"
                        @onclick="() => ActivateTabAsync(tab.Key)">
                    <span class="visa-preview-slot__tab-title">@tab.Title</span>
                </button>
                <button type="button"
                        class="visa-preview-slot__tab-close"
                        title="Close tab"
                        aria-label="Close @tab.Title"
                        @onclick="() => CloseTabAsync(tab.Key)">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        }
    </div>
}

<div class="visa-preview-slot__body">
@if (_state.Occupants.Count > 0)
{
    @foreach (var occupant in _state.Occupants)
    {
        <div class="visa-preview-slot__occupant @(occupant.IsActive ? "visa-preview-slot__occupant--active" : "visa-preview-slot__occupant--hidden")"
             @key="occupant.Key"
             data-occupant-key="@occupant.Key">
            @RenderOccupant(occupant)
        </div>
    }
}
else if (_state.Mode == VisaPreviewSlotMode.File)
{
    <VisaFilePreviewDrawer @key="_state.Version"
                           @ref="_fileDrawer"
                           HostManaged="true" />
}
else if (_state.Mode == VisaPreviewSlotMode.Resminamalar && _state.Resminamalar != null)
{
    <ResminamalarSlotPanel @key="_state.Version"
                           Request="_state.Resminamalar"
                           CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.DocumentCopies && _state.DocumentCopies != null)
{
    <DocumentCopiesSlotPanel @key="_state.Version"
                             Request="_state.DocumentCopies"
                             CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.ProgressLetters && _state.ProgressLetters != null)
{
    <ProgressLettersSlotPanel @key="_state.Version"
                              Request="_state.ProgressLetters"
                              CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.PersonDocumentCopies && _state.PersonDocumentCopies != null)
{
    <PersonDocumentCopiesSlotPanel @key="_state.Version"
                                   Request="_state.PersonDocumentCopies"
                                   CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.HeaderDocumentCopies && _state.HeaderDocumentCopies != null)
{
    <HeaderDocumentCopiesSlotPanel @key="_state.Version"
                                   Request="_state.HeaderDocumentCopies"
                                   CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.PlaceholderManual)
{
    <PlaceholderManualSlotPanel @key="_state.Version"
                                Request="_state.PlaceholderManual"
                                CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.IssueIssuedHeader && _state.IssueIssuedHeader != null)
{
    <IssueIssuedHeaderSlotPanel @key="@($"{_state.OccupantKey}|{_state.Version}")"
                                Request="_state.IssueIssuedHeader"
                                CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.IssueIssuedVisa && _state.IssueIssuedVisa != null)
{
    <IssueIssuedVisaSlotPanel @key="@($"{_state.OccupantKey}|{_state.Version}")"
                              Request="_state.IssueIssuedVisa"
                              CloseRequested="CloseFromPanelAsync" />
}
else if (_state.Mode == VisaPreviewSlotMode.ApprovalLegCatalog)
{
    <ApprovalLegProfileSlotPanel @key="@($"{_state.OccupantKey}|{_state.Version}")"
                                 Request="_state.ApprovalLegCatalog"
                                 CloseRequested="CloseFromPanelAsync" />
}
</div>
</div>

@code {
    [Inject] private IVisaPreviewSlotService SlotService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private ApplicationProfileInstanceProgressMinistryLetterFileAccess FileAccess { get; set; } = null!;
    [Inject] private PersonDossierNavigationHelper DossierNavigation { get; set; } = null!;

    private VisaPreviewSlotState _state = new();
    private VisaFilePreviewDrawer? _fileDrawer;
    private readonly Dictionary<string, VisaFilePreviewDrawer> _fileDrawersByKey = new(StringComparer.Ordinal);
    private DotNetObjectReference<VisaPreviewSlotHost>? _dotNetRef;
    private int _lastFileOpenVersion;
    private string? _lastFileOccupantKey;

    protected override void OnInitialized()
    {
        _state = SlotService.State;
        SlotService.StateChanged += OnSlotStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("visaPreviewDrawer.registerHost", _dotNetRef);
        }

        await ApplyStateAsync();

        if (_state.Mode != VisaPreviewSlotMode.Closed)
        {
            try
            {
                await JS.InvokeVoidAsync("visaPreviewDrawer.scheduleSlotThemeSync");
            }
            catch (JSDisconnectedException) { }
        }
    }

    private RenderFragment RenderOccupant(VisaPreviewSlotOccupantSnapshot occupant) => builder =>
    {
        switch (occupant.Mode)
        {
            case VisaPreviewSlotMode.File:
                builder.OpenComponent<VisaFilePreviewDrawer>(0);
                builder.AddAttribute(1, "HostManaged", true);
                builder.AddComponentReferenceCapture(2, inst =>
                {
                    if (inst is VisaFilePreviewDrawer drawer)
                        _fileDrawersByKey[occupant.Key] = drawer;
                });
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.Resminamalar when occupant.Resminamalar != null:
                builder.OpenComponent<ResminamalarSlotPanel>(10);
                builder.AddAttribute(11, "Request", occupant.Resminamalar);
                builder.AddAttribute(12, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.DocumentCopies when occupant.DocumentCopies != null:
                builder.OpenComponent<DocumentCopiesSlotPanel>(20);
                builder.AddAttribute(21, "Request", occupant.DocumentCopies);
                builder.AddAttribute(22, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.ProgressLetters when occupant.ProgressLetters != null:
                builder.OpenComponent<ProgressLettersSlotPanel>(30);
                builder.AddAttribute(31, "Request", occupant.ProgressLetters);
                builder.AddAttribute(32, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.PersonDocumentCopies when occupant.PersonDocumentCopies != null:
                builder.OpenComponent<PersonDocumentCopiesSlotPanel>(40);
                builder.AddAttribute(41, "Request", occupant.PersonDocumentCopies);
                builder.AddAttribute(42, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.HeaderDocumentCopies when occupant.HeaderDocumentCopies != null:
                builder.OpenComponent<HeaderDocumentCopiesSlotPanel>(50);
                builder.AddAttribute(51, "Request", occupant.HeaderDocumentCopies);
                builder.AddAttribute(52, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.PlaceholderManual:
                builder.OpenComponent<PlaceholderManualSlotPanel>(60);
                builder.AddAttribute(61, "Request", occupant.PlaceholderManual);
                builder.AddAttribute(62, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.IssueIssuedHeader when occupant.IssueIssuedHeader != null:
                builder.OpenComponent<IssueIssuedHeaderSlotPanel>(70);
                builder.AddAttribute(71, "Request", occupant.IssueIssuedHeader);
                builder.AddAttribute(72, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.IssueIssuedVisa when occupant.IssueIssuedVisa != null:
                builder.OpenComponent<IssueIssuedVisaSlotPanel>(80);
                builder.AddAttribute(81, "Request", occupant.IssueIssuedVisa);
                builder.AddAttribute(82, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
            case VisaPreviewSlotMode.ApprovalLegCatalog:
                builder.OpenComponent<ApprovalLegProfileSlotPanel>(90);
                builder.AddAttribute(91, "Request", occupant.ApprovalLegCatalog);
                builder.AddAttribute(92, "CloseRequested", EventCallback.Factory.Create(this, CloseFromPanelAsync));
                builder.CloseComponent();
                break;
        }
    };

    private void OnSlotStateChanged()
    {
        _state = SlotService.State;
        PruneFileDrawerRefs();
        _ = InvokeAsync(StateHasChanged);
    }

    private void PruneFileDrawerRefs()
    {
        var liveKeys = new HashSet<string>(
            _state.Occupants.Where(o => o.Mode == VisaPreviewSlotMode.File).Select(o => o.Key),
            StringComparer.Ordinal);
        foreach (var key in _fileDrawersByKey.Keys.Where(k => !liveKeys.Contains(k)).ToList())
            _fileDrawersByKey.Remove(key);
    }

    private async Task ApplyStateAsync()
    {
        var open = _state.Mode != VisaPreviewSlotMode.Closed;
        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.setSlotOpen", open);
        }
        catch (JSDisconnectedException) { }

        if (_state.Mode != VisaPreviewSlotMode.File
            || string.IsNullOrWhiteSpace(_state.FileSourceType)
            || _state.FileObjectId == Guid.Empty)
            return;

        var versionChanged = _state.Version != _lastFileOpenVersion;
        var keyChanged = !string.Equals(_state.OccupantKey, _lastFileOccupantKey, StringComparison.Ordinal);
        if (!versionChanged && !keyChanged)
            return;

        VisaFilePreviewDrawer? drawer = _fileDrawer;
        if (!string.IsNullOrWhiteSpace(_state.OccupantKey)
            && _fileDrawersByKey.TryGetValue(_state.OccupantKey, out var stacked))
            drawer = stacked;

        if (drawer == null)
            return;

        _lastFileOpenVersion = _state.Version;
        _lastFileOccupantKey = _state.OccupantKey;
        await drawer.OpenFilePreviewAsync(_state.FileSourceType, _state.FileObjectId);
    }

    [JSInvokable]
    public Task OpenAsync(string sourceType, string objectIdText) =>
        OpenFileFromJsAsync(sourceType, objectIdText);

    [JSInvokable]
    public Task OpenFileFromJsAsync(string sourceType, string objectIdText, string? ownerViewId = null)
    {
        if (!Guid.TryParse(objectIdText, out var objectId) || objectId == Guid.Empty)
            return Task.CompletedTask;

        return SlotService.OpenFileAsync(sourceType, objectId, ownerViewId);
    }

    [JSInvokable]
    public Task OpenResminamalarFromJsAsync(string applicationIdText, string scopeText, string itemIdsJson)
    {
        if (!Guid.TryParse(applicationIdText, out var applicationId) || applicationId == Guid.Empty)
            return Task.CompletedTask;

        if (!Enum.TryParse<WordReportPackageScope>(scopeText, ignoreCase: true, out var scope))
            scope = WordReportPackageScope.ApplicationProfileInstance;

        IReadOnlyList<Guid> itemIds = Array.Empty<Guid>();
        if (!string.IsNullOrWhiteSpace(itemIdsJson))
        {
            try
            {
                itemIds = JsonSerializer.Deserialize<List<Guid>>(itemIdsJson) ?? new List<Guid>();
            }
            catch (JsonException) { }
        }

        return SlotService.OpenResminamalarAsync(new ResminamalarSlotRequest
        {
            ApplicationProfileInstanceId = applicationId,
            Scope = scope,
            ApplicationItemIds = itemIds,
        });
    }

    [JSInvokable]
    public Task OpenProgressLettersFromJsAsync(string applicationIdText, string focusProgressIdText)
    {
        var applicationId = Guid.TryParse(applicationIdText, out var parsedApplicationProfileInstanceId)
            ? parsedApplicationProfileInstanceId
            : Guid.Empty;
        Guid? focusProgressId = Guid.TryParse(focusProgressIdText, out var parsedFocusId) && parsedFocusId != Guid.Empty
            ? parsedFocusId
            : null;

        if (applicationId == Guid.Empty
            && focusProgressId is Guid progressId
            && FileAccess.TryGetApplicationProfileInstanceIdForProgress(progressId, out var resolvedApplicationProfileInstanceId))
        {
            applicationId = resolvedApplicationProfileInstanceId;
        }

        if (applicationId == Guid.Empty)
            return Task.CompletedTask;

        return SlotService.OpenProgressLettersAsync(new ProgressLettersSlotRequest
        {
            ApplicationProfileInstanceId = applicationId,
            FocusProgressId = focusProgressId,
        });
    }

    [JSInvokable]
    public Task OpenListProgressFilesFromJsAsync(
        string applicationIdText,
        string focusProgressIdText,
        string ownerViewId)
    {
        var applicationId = Guid.TryParse(applicationIdText, out var parsedApplicationId)
            ? parsedApplicationId
            : Guid.Empty;
        Guid? focusProgressId = Guid.TryParse(focusProgressIdText, out var parsedFocusId) && parsedFocusId != Guid.Empty
            ? parsedFocusId
            : null;
        if (applicationId == Guid.Empty || focusProgressId == null)
            return Task.CompletedTask;

        return SlotService.OpenProgressLettersAsync(new ProgressLettersSlotRequest
        {
            ApplicationProfileInstanceId = applicationId,
            FocusProgressId = focusProgressId,
            PreviewAllFiles = true,
            OpenPreviewOnly = true,
        }, string.IsNullOrWhiteSpace(ownerViewId) ? null : ownerViewId);
    }

    [JSInvokable]
    public void MarkLetterLinkClickPending() => ProgressLetterLinkClickGate.MarkPending();

    [JSInvokable]
    public Task OpenPersonDocumentCopiesFromJsAsync(string personIdText)
    {
        if (!Guid.TryParse(personIdText, out var personId) || personId == Guid.Empty)
            return Task.CompletedTask;

        return SlotService.OpenPersonDocumentCopiesAsync(new PersonDocumentCopiesSlotRequest
        {
            PersonIds = new[] { personId },
        });
    }

    [JSInvokable]
    public Task OpenPersonDocumentCopyFromJsAsync(
        string personIdText,
        string recordKey,
        string displayName,
        string ownerViewId)
    {
        if (!Guid.TryParse(personIdText, out var personId) || personId == Guid.Empty)
            return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(recordKey))
            return Task.CompletedTask;

        return SlotService.OpenPersonDocumentCopiesAsync(
            new PersonDocumentCopiesSlotRequest
            {
                PersonIds = new[] { personId },
                FocusRecordKey = recordKey.Trim(),
                FocusDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim(),
                OpenPreviewOnly = true,
            },
            string.IsNullOrWhiteSpace(ownerViewId) ? null : ownerViewId.Trim());
    }

    [JSInvokable]
    public void MarkPersonDocumentCopiesLinkClickPending() => PersonDocumentCopiesLinkClickGate.MarkPending();

    [JSInvokable]
    public Task OpenPersonDossierFromJsAsync(string personIdText)
    {
        if (!Guid.TryParse(personIdText, out var personId) || personId == Guid.Empty)
            return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            if (PersonListViewDossierOpenBridge.TryOpenDossier(personId))
                return;

            PersonDossierLinkClickGate.MarkPending();
            DossierNavigation.OpenDossier(personId);
        });
    }

    [JSInvokable]
    public void MarkPersonDossierLinkClickPending() => PersonDossierLinkClickGate.MarkPending();

    [JSInvokable]
    public Task OpenHeaderDocumentCopiesFromJsAsync(string familyText, string parentIdText, string contextItemIdText)
    {
        if (!Enum.TryParse<HeaderDocumentCopiesFamily>(familyText, ignoreCase: true, out var family))
            return Task.CompletedTask;

        if (!Guid.TryParse(parentIdText, out var parentId) || parentId == Guid.Empty)
            return Task.CompletedTask;

        Guid? contextItemId = Guid.TryParse(contextItemIdText, out var contextId) && contextId != Guid.Empty
            ? contextId
            : null;

        return SlotService.OpenHeaderDocumentCopiesAsync(new HeaderDocumentCopiesSlotRequest
        {
            Family = family,
            ParentId = parentId,
            ContextItemId = contextItemId,
        });
    }

    [JSInvokable]
    public Task OpenListPersonDocumentCopyFromJsAsync(
        string familyText,
        string parentIdText,
        string? ownerViewId = null,
        string? invitationLifeKey = null,
        string? personIdText = null)
    {
        if (!Enum.TryParse<HeaderDocumentCopiesFamily>(familyText, ignoreCase: true, out var family))
            return Task.CompletedTask;

        if (!Guid.TryParse(parentIdText, out var parentId) || parentId == Guid.Empty)
            return Task.CompletedTask;

        return SlotService.OpenHeaderDocumentCopiesAsync(new HeaderDocumentCopiesSlotRequest
        {
            Family = family,
            ParentId = parentId,
            OpenPreviewOnly = true,
            PreviewAllCopies = true,
            InvitationLifeKey = string.IsNullOrWhiteSpace(invitationLifeKey) ? null : invitationLifeKey.Trim(),
            PersonId = Guid.TryParse(personIdText, out var personId) && personId != Guid.Empty ? personId : null,
        }, string.IsNullOrWhiteSpace(ownerViewId) ? null : ownerViewId);
    }

    [JSInvokable]
    public Task OpenListApplicationFromJsAsync(string applicationIdText)
    {
        if (!Guid.TryParse(applicationIdText, out var applicationId) || applicationId == Guid.Empty)
            return Task.CompletedTask;

        return InvokeAsync(() => ApplicationListLinkedPeopleOpenBridge.TryOpen(applicationId));
    }

    [JSInvokable]
    public Task OpenHeaderDocumentCopiesPreviewFromJsAsync(string familyText, string parentIdText, string? ownerViewId = null)
    {
        if (!Enum.TryParse<HeaderDocumentCopiesFamily>(familyText, ignoreCase: true, out var family))
            return Task.CompletedTask;

        if (!Guid.TryParse(parentIdText, out var parentId) || parentId == Guid.Empty)
            return Task.CompletedTask;

        return SlotService.OpenHeaderDocumentCopiesAsync(new HeaderDocumentCopiesSlotRequest
        {
            Family = family,
            ParentId = parentId,
            OpenPreviewOnly = true,
        }, ownerViewId);
    }

    [JSInvokable]
    public void MarkHeaderDocumentCopiesLinkClickPending() => HeaderDocumentCopiesLinkClickGate.MarkPending();

    [JSInvokable]
    public Task OpenIssueIssuedHeaderFromJsAsync(
        string applicationIdText,
        string kindText,
        string catalogKey,
        string? ownerViewId = null,
        string? existingHeaderIdText = null)
    {
        if (!Guid.TryParse(applicationIdText, out var applicationId) || applicationId == Guid.Empty)
            return Task.CompletedTask;

        if (!Enum.TryParse<IssueIssuedHeaderKind>(kindText, ignoreCase: true, out var kind))
        {
            if (!IssueIssuedHeaderComposeService.TryResolveKind(catalogKey, out kind))
                return Task.CompletedTask;
        }

        Guid? existingHeaderId = Guid.TryParse(existingHeaderIdText, out var existing) && existing != Guid.Empty
            ? existing
            : null;

        return SlotService.OpenIssueIssuedHeaderAsync(new IssueIssuedHeaderSlotRequest
        {
            ApplicationProfileInstanceId = applicationId,
            Kind = kind,
            CatalogKey = string.IsNullOrWhiteSpace(catalogKey)
                ? IssueIssuedHeaderComposeService.CatalogKeyFor(kind)
                : catalogKey.Trim(),
            ExistingHeaderId = existingHeaderId,
        }, ownerViewId);
    }

    [JSInvokable]
    public Task OpenIssueIssuedVisaFromJsAsync(
        string applicationIdText,
        string? ownerViewId = null,
        string? existingVisaIdText = null)
    {
        if (!Guid.TryParse(applicationIdText, out var applicationId) || applicationId == Guid.Empty)
            return Task.CompletedTask;

        Guid? existingVisaId = Guid.TryParse(existingVisaIdText, out var visaId) && visaId != Guid.Empty
            ? visaId
            : null;

        return SlotService.OpenIssueIssuedVisaAsync(new IssueIssuedVisaSlotRequest
        {
            ApplicationProfileInstanceId = applicationId,
            ExistingVisaId = existingVisaId,
        }, ownerViewId);
    }

    [JSInvokable]
    public Task CloseFromJsAsync() => SlotService.CloseAsync();

    private Task ActivateTabAsync(string key) => SlotService.ActivateTabAsync(key);

    private Task CloseTabAsync(string key) => SlotService.CloseTabAsync(key);

    private Task CloseFromPanelAsync()
    {
        if (!string.IsNullOrWhiteSpace(_state.OccupantKey) && _state.Tabs.Count > 1)
            return SlotService.CloseTabAsync(_state.OccupantKey);

        return SlotService.CloseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        SlotService.StateChanged -= OnSlotStateChanged;

        if (_dotNetRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("visaPreviewDrawer.unregisterHost");
            }
            catch (JSDisconnectedException) { }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}