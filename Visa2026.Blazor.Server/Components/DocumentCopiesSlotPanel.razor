@namespace Visa2026.Blazor.Server.Components
@using DevExpress.ExpressApp
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationItemLinkedDocuments
@using Visa2026.Module.Services.ApplicationPersonRoster
@using Visa2026.Module.Services.PreviewSlot

<div class="resminamalar-slot-panel document-copies-slot-panel @(_previewActive ? "resminamalar-slot-panel--preview" : string.Empty)">
    @if (!_previewActive)
    {
        <div class="resminamalar-slot-panel__header visa-preview-drawer__header">
            <span class="visa-preview-drawer__title doc-copies-brand-title">
                <span class="doc-copies-brand-title__icon" aria-hidden="true"></span>
                @Title
            </span>
            <div class="visa-preview-drawer__header-actions">
                <button class="visa-preview-drawer__btn visa-preview-drawer__btn--close"
                        type="button"
                        title="@CloseLabel"
                        @onclick="ClosePanelAsync">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <div class="resminamalar-slot-panel__body">
        @if (!_previewActive)
        {
            <div class="resminamalar-slot-panel__catalog">
                <ApplicationItemDocumentCopiesComponent ApplicationItemIds="_lineIds"
                                                        LineScope="_lineScope"
                                                        ApplicationId="_applicationId"
                                                        MergedGroups="_mergedGroups"
                                                        UiCultureName="_uiCultureName"
                                                        UseInlinePreview="true"
                                                        RefreshRequested="_refreshRequested"
                                                        OnInlinePreviewRequested="HandleInlinePreviewAsync" />
            </div>
        }
        else
        {
            <DocumentCopiesInlinePreview @ref="_inlinePreview"
                                         ApplicationItemIds="_lineIds"
                                         LineScope="_lineScope"
                                         UiCultureName="_uiCultureName"
                                         PreviewClosed="OnPreviewClosedAsync" />
        }
    </div>
</div>

@code {
    [Parameter] public DocumentCopiesSlotRequest? Request { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService SlotService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private IReadOnlyList<Guid> _lineIds = Array.Empty<Guid>();
    private DocumentCopiesLineScope _lineScope = DocumentCopiesLineScope.ApplicationItem;
    private Guid _applicationId;
    private IReadOnlyList<ApplicationItemLinkedDocumentMergedGroup> _mergedGroups =
        Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
    private string _uiCultureName = string.Empty;
    private bool _previewActive;
    private bool _previewOnlyMode;
    private DocumentCopiesInlinePreviewRequest? _pendingPreviewRequest;
    private DocumentCopiesInlinePreview? _inlinePreview;
    private EventCallback _refreshRequested;
    private string? _boundOccupantKey;

    private string Title => VisaUiMessages.Get("ApplicationItemDocumentCopies.Title", _uiCultureName);
    private string CloseLabel => VisaUiMessages.Get("ApplicationItemDocumentCopies.Action.Close", _uiCultureName);

    protected override void OnInitialized()
    {
        _refreshRequested = EventCallback.Factory.Create(this, ReloadMergedGroupsAsync);
        _uiCultureName = VisaUiCultureResolver.Resolve();
    }

    protected override void OnParametersSet()
    {
        _lineScope = Request?.Scope ?? DocumentCopiesLineScope.ApplicationItem;
        _applicationId = Request?.ApplicationId ?? Guid.Empty;

        var lineIds = _lineScope == DocumentCopiesLineScope.ApplicationPerson
            ? Request?.ApplicationPersonIds?
                .Where(id => id != Guid.Empty)
                .Distinct()
                .ToList() ?? new List<Guid>()
            : Request?.ApplicationItemIds?
                .Where(id => id != Guid.Empty)
                .Distinct()
                .ToList() ?? new List<Guid>();

        if (lineIds.Count == 0)
        {
            _lineIds = Array.Empty<Guid>();
            _mergedGroups = Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
            _boundOccupantKey = null;
            _previewActive = false;
            _previewOnlyMode = false;
            _pendingPreviewRequest = null;
            return;
        }

        var occupantKey = Request != null
            ? VisaPreviewSlotOccupantKeys.ForDocumentCopies(Request)
            : VisaPreviewSlotOccupantKeys.ForDocumentCopies(
                new DocumentCopiesSlotRequest { ApplicationItemIds = lineIds });

        var stateKey = Request?.OpenPreviewOnly == true && !string.IsNullOrWhiteSpace(Request.FocusSlotKey)
            ? $"{occupantKey}|preview:{Request.FocusSlotKey.Trim()}"
            : occupantKey;

        if (!string.Equals(_boundOccupantKey, stateKey, StringComparison.Ordinal))
        {
            _boundOccupantKey = stateKey;
            _previewOnlyMode = Request?.OpenPreviewOnly == true;
            if (_previewOnlyMode)
            {
                _previewActive = true;
                _pendingPreviewRequest = BuildPreviewRequest(Request);
            }
            else
            {
                _previewActive = false;
                _pendingPreviewRequest = null;
            }
        }

        _lineIds = lineIds;
        ReloadMergedGroups();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPreviewRequest != null)
        {
            var request = _pendingPreviewRequest;
            _pendingPreviewRequest = null;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (_inlinePreview != null)
                await _inlinePreview.OpenAsync(request);
            return;
        }

        if (_previewActive || _lineIds.Count == 0)
            return;

        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.scheduleSlotThemeSync");
        }
        catch (JSDisconnectedException) { }
    }

    private void ReloadMergedGroups()
    {
        if (_lineIds.Count == 0)
        {
            _mergedGroups = Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
            return;
        }

        if (_lineScope == DocumentCopiesLineScope.ApplicationPerson)
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationPerson>();
            var rows = _lineIds
                .Select(id => objectSpace.GetObjectByKey<ApplicationPerson>(id))
                .Where(row => row != null)
                .Cast<ApplicationPerson>()
                .ToList();

            _lineIds = rows.Select(row => row.ID).ToList();
            var lines = ApplicationPersonLinkedDocumentsResolver.ResolveMany(objectSpace, rows);
            _mergedGroups = ApplicationItemLinkedDocumentsMerger.MergeBySlot(lines);
            return;
        }

        using (var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationItem>())
        {
            var items = _lineIds
                .Select(id => objectSpace.GetObjectByKey<ApplicationItem>(id))
                .Where(item => item != null)
                .Cast<ApplicationItem>()
                .ToList();

            _lineIds = items.Select(item => item.ID).ToList();
            var lines = ApplicationItemLinkedDocumentsResolver.ResolveMany(objectSpace, items);
            _mergedGroups = ApplicationItemLinkedDocumentsMerger.MergeBySlot(lines);
        }
    }

    private Task ReloadMergedGroupsAsync()
    {
        ReloadMergedGroups();
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleInlinePreviewAsync(DocumentCopiesInlinePreviewRequest request)
    {
        _previewActive = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (_inlinePreview != null)
            await _inlinePreview.OpenAsync(request);
    }

    private async Task OnPreviewClosedAsync()
    {
        if (_previewOnlyMode)
        {
            _previewOnlyMode = false;
            _previewActive = false;
            await SlotService.CloseAsync();
            return;
        }

        _previewActive = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePanelAsync()
    {
        _previewOnlyMode = false;
        _previewActive = false;
        _pendingPreviewRequest = null;
        if (CloseRequested.HasDelegate)
            await CloseRequested.InvokeAsync();
        else
            await SlotService.CloseAsync();
    }

    private static DocumentCopiesInlinePreviewRequest? BuildPreviewRequest(DocumentCopiesSlotRequest? request)
    {
        if (request == null || string.IsNullOrWhiteSpace(request.FocusSlotKey))
            return null;

        return new DocumentCopiesInlinePreviewRequest
        {
            SlotKey = request.FocusSlotKey.Trim(),
            DisplayName = string.IsNullOrWhiteSpace(request.FocusDisplayName)
                ? request.FocusSlotKey.Trim()
                : request.FocusDisplayName.Trim(),
        };
    }
}
