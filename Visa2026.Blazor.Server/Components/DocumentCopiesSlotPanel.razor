@namespace Visa2026.Blazor.Server.Components
@using DevExpress.ExpressApp
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationPersonRoster
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationItemLinkedDocuments
@using Visa2026.Module.Services.ApplicationPersonRoster
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.PersonLinkedDocuments
@using Visa2026.Blazor.Server.Services

<div class="resminamalar-slot-panel document-copies-slot-panel @(_previewActive ? "resminamalar-slot-panel--preview" : string.Empty)">
    @if (!_previewActive)
    {
        <div class="resminamalar-slot-panel__header visa-preview-drawer__header">
            <span class="visa-preview-drawer__title doc-copies-brand-title">
                <span class="doc-copies-brand-title__icon" aria-hidden="true"></span>
                @Title
            </span>
            <div class="visa-preview-drawer__header-actions">
                <button class="visa-preview-drawer__btn visa-preview-drawer__btn--close"
                        type="button"
                        title="@CloseLabel"
                        @onclick="ClosePanelAsync">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <div class="resminamalar-slot-panel__body">
        @if (!_previewActive)
        {
            <div class="resminamalar-slot-panel__catalog">
                <ApplicationItemDocumentCopiesComponent ApplicationItemIds="_lineIds"
                                                        ApplicationProfileInstanceId="_applicationId"
                                                        MergedGroups="_mergedGroups"
                                                        UiCultureName="_uiCultureName"
                                                        UseInlinePreview="true"
                                                        RefreshRequested="_refreshRequested"
                                                        OnInlinePreviewRequested="HandleInlinePreviewAsync" />
            </div>
        }
        else if (_previewOnlyEmpty)
        {
            <div class="report-package-inline-preview app-item-doc-copies-preview">
                <div class="report-package-inline-preview__header app-item-doc-copies-preview__header">
                    <h3 class="app-item-doc-copies-preview__title">@_missingFamilyLabel</h3>
                    <div class="app-item-doc-copies-preview__header-actions">
                        <button type="button"
                                class="visa-preview-drawer__btn visa-preview-drawer__btn--close"
                                @onclick="ClosePanelAsync">
                            @CloseLabel
                        </button>
                    </div>
                </div>
                <div class="person-doc-copies-missing" role="status">
                    <div class="person-doc-copies-missing__icon" aria-hidden="true">⚠</div>
                    <h4 class="person-doc-copies-missing__title">@VisaUiMessages.Get("PersonDocumentCopies.Preview.MissingFile.Title", _uiCultureName)</h4>
                    <p class="person-doc-copies-missing__body">@MissingFamilyBody</p>
                    <div class="person-doc-copies-missing__actions">
                        @if (_missingLinkKind != null && _lineIds.Count > 0)
                        {
                            <button type="button" class="os-btn os-btn--primary" @onclick="UploadMissingFamilyAsync">
                                @VisaUiMessages.Get("PersonDocumentCopies.Preview.MissingFile.Upload", _uiCultureName)
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <DocumentCopiesInlinePreview @ref="_inlinePreview"
                                         ApplicationItemIds="_lineIds"
                                         ApplicationProfileInstanceId="_applicationId"
                                         UiCultureName="_uiCultureName"
                                         PreviewClosed="OnPreviewClosedAsync" />
        }
    </div>
</div>

@code {
    [Parameter] public DocumentCopiesSlotRequest? Request { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService SlotService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private XafApplicationHolder AppHolder { get; set; } = null!;

    private IReadOnlyList<Guid> _lineIds = Array.Empty<Guid>();
    private Guid _applicationId;
    private IReadOnlyList<ApplicationItemLinkedDocumentMergedGroup> _mergedGroups =
        Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
    private string _uiCultureName = string.Empty;
    private bool _previewActive;
    private bool _previewOnlyMode;
    private bool _previewOnlyEmpty;
    private string _missingFamilyKey = string.Empty;
    private string _missingFamilyLabel = string.Empty;
    private ApplicationProfileInstancePersonLinkKind? _missingLinkKind;
    private DocumentCopiesInlinePreviewRequest? _pendingPreviewRequest;
    private DocumentCopiesInlinePreview? _inlinePreview;
    private EventCallback _refreshRequested;
    private string? _boundOccupantKey;

    private string Title => VisaUiMessages.Get("ApplicationItemDocumentCopies.Title", _uiCultureName);
    private string CloseLabel => VisaUiMessages.Get("ApplicationItemDocumentCopies.Action.Close", _uiCultureName);

    protected override void OnInitialized()
    {
        _refreshRequested = EventCallback.Factory.Create(this, ReloadMergedGroupsAsync);
        _uiCultureName = VisaUiCultureResolver.Resolve();
    }

    protected override void OnParametersSet()
    {
        _applicationId = Request?.ApplicationProfileInstanceId ?? Guid.Empty;

        var lineIds = Request?.ApplicationProfileInstancePersonIds?
            .Where(id => id != Guid.Empty)
            .Distinct()
            .ToList() ?? new List<Guid>();

        if (lineIds.Count == 0)
        {
            _lineIds = Array.Empty<Guid>();
            _mergedGroups = Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
            _boundOccupantKey = null;
            _previewActive = false;
            _previewOnlyMode = false;
            _pendingPreviewRequest = null;
            return;
        }

        _lineIds = lineIds;
        ReloadMergedGroups();

        var occupantKey = VisaPreviewSlotOccupantKeys.ForDocumentCopies(Request);

        var stateKey = Request?.OpenPreviewOnly == true && !string.IsNullOrWhiteSpace(Request.FocusSlotKey)
            ? $"{occupantKey}|preview:{Request.FocusSlotKey.Trim()}"
            : occupantKey;

        if (!string.Equals(_boundOccupantKey, stateKey, StringComparison.Ordinal))
        {
            _boundOccupantKey = stateKey;
            _previewOnlyMode = Request?.OpenPreviewOnly == true;
            if (_previewOnlyMode)
            {
                _previewActive = true;
                var focus = Request?.FocusSlotKey?.Trim() ?? string.Empty;
                var display = string.IsNullOrWhiteSpace(Request?.FocusDisplayName) ? focus : Request!.FocusDisplayName!.Trim();
                if (ApplicationItemDocumentCopiesTypeCatalog.TryParseFamilyPreviewKey(focus, out var familyKey)
                    && !FamilyHasFiles(familyKey))
                {
                    _previewOnlyEmpty = true;
                    _pendingPreviewRequest = null;
                    _missingFamilyKey = familyKey;
                    _missingFamilyLabel = string.IsNullOrWhiteSpace(display)
                        ? ApplicationItemDocumentCopiesTypeCatalog.FamilyTitle(familyKey, _uiCultureName)
                        : display;
                    _missingLinkKind = PersonDocumentCopiesProfileSectionFilter.TryMapApplicationItemFamilyToLinkKind(familyKey);
                }
                else
                {
                    _previewOnlyEmpty = false;
                    _missingFamilyKey = string.Empty;
                    _missingFamilyLabel = string.Empty;
                    _missingLinkKind = null;
                    _pendingPreviewRequest = BuildPreviewRequest(Request);
                }
            }
            else
            {
                _previewActive = false;
                _previewOnlyEmpty = false;
                _pendingPreviewRequest = null;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPreviewRequest != null)
        {
            var request = _pendingPreviewRequest;
            _pendingPreviewRequest = null;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (_inlinePreview != null)
                await _inlinePreview.OpenAsync(request);
            return;
        }

        if (_previewActive || _lineIds.Count == 0)
            return;

        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.scheduleSlotThemeSync");
        }
        catch (JSDisconnectedException) { }
    }

    private void ReloadMergedGroups()
    {
        if (_lineIds.Count == 0)
        {
            _mergedGroups = Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
            return;
        }

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        if (!ApplicationRosterHelper.TryLoadSharedApplicationPeople(
                objectSpace,
                _lineIds,
                _applicationId,
                out var application,
                out var people)
            || application == null)
        {
            _mergedGroups = Array.Empty<ApplicationItemLinkedDocumentMergedGroup>();
            return;
        }

        _lineIds = people.Select(p => p.ID).ToList();
        var lines = ApplicationPersonLinkedDocumentsResolver.ResolveMany(objectSpace, application, people);
        _mergedGroups = ApplicationItemLinkedDocumentsMerger.MergeBySlot(lines);
    }

    private Task ReloadMergedGroupsAsync()
    {
        ReloadMergedGroups();
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleInlinePreviewAsync(DocumentCopiesInlinePreviewRequest request)
    {
        _previewActive = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (_inlinePreview != null)
            await _inlinePreview.OpenAsync(request);
    }

    private async Task OnPreviewClosedAsync()
    {
        if (_previewOnlyMode)
        {
            _previewOnlyMode = false;
            _previewActive = false;
            await SlotService.CloseAsync();
            return;
        }

        _previewActive = false;
        await InvokeAsync(StateHasChanged);
    }

    private string MissingFamilyBody =>
        VisaUiMessages.FormatForCulture(
            _uiCultureName,
            "PersonDocumentCopies.Preview.MissingFile.Body",
            string.IsNullOrWhiteSpace(_missingFamilyLabel) ? _missingFamilyKey : _missingFamilyLabel);

    private bool FamilyHasFiles(string familyKey)
    {
        var files = ApplicationItemDocumentCopiesTypeCatalog.CollectFamilyFiles(
            // lines not cached; use merged groups fallback via rebuild
            RebuildLinesForFamilyCheck(),
            familyKey);
        return files.Any(f => f.File?.HasContent == true);
    }

    private IReadOnlyList<ApplicationItemLinkedDocumentsLineSnapshot> RebuildLinesForFamilyCheck()
    {
        if (_lineIds.Count == 0 || _applicationId == Guid.Empty)
            return Array.Empty<ApplicationItemLinkedDocumentsLineSnapshot>();

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        if (!ApplicationRosterHelper.TryLoadSharedApplicationPeople(
                objectSpace,
                _lineIds,
                _applicationId,
                out var application,
                out var people)
            || application == null)
        {
            return Array.Empty<ApplicationItemLinkedDocumentsLineSnapshot>();
        }

        return ApplicationPersonLinkedDocumentsResolver.ResolveMany(objectSpace, application, people);
    }

    private Task UploadMissingFamilyAsync()
    {
        if (_missingLinkKind == null || _lineIds.Count == 0)
            return Task.CompletedTask;

        LinkedRecordDetailOpenHelper.ShowNewEditor(
            AppHolder.Application,
            _missingLinkKind.Value,
            _lineIds[0],
            onSaved: null);
        return Task.CompletedTask;
    }

    private async Task ClosePanelAsync()
    {
        _previewOnlyMode = false;
        _previewActive = false;
        _previewOnlyEmpty = false;
        _pendingPreviewRequest = null;
        if (CloseRequested.HasDelegate)
            await CloseRequested.InvokeAsync();
        else
            await SlotService.CloseAsync();
    }

    private static DocumentCopiesInlinePreviewRequest? BuildPreviewRequest(DocumentCopiesSlotRequest? request)
    {
        if (request == null || string.IsNullOrWhiteSpace(request.FocusSlotKey))
            return null;

        return new DocumentCopiesInlinePreviewRequest
        {
            SlotKey = request.FocusSlotKey.Trim(),
            DisplayName = string.IsNullOrWhiteSpace(request.FocusDisplayName)
                ? request.FocusSlotKey.Trim()
                : request.FocusDisplayName.Trim(),
        };
    }
}
