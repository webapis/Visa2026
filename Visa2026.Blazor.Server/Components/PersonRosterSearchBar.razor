@namespace Visa2026.Blazor.Server.Components
@using Visa2026.Module.Localization
@implements IDisposable

<div class="visa-roster-search-bar-block">
<form class="visa-roster-search-bar" @onsubmit="Submit" @onsubmit:preventDefault="true" aria-busy="@showProgress">
    <label class="visa-roster-search-gate__field">
        <span class="visa-roster-search-gate__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.75" />
                <path d="M16 16.5L20 20.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            </svg>
        </span>
        <input @ref="input"
               data-testid="visa-roster-search-input"
               value="@text"
               @oninput="OnInput"
               placeholder="@Msg("PersonRosterSearch.Placeholder")"
               aria-label="@Msg("PersonRosterSearch.Placeholder")"
               autocomplete="off"
               spellcheck="false" />
        @if (!string.IsNullOrEmpty(text))
        {
            <button type="button"
                    class="visa-roster-search-bar__clear"
                    data-testid="visa-roster-search-clear"
                    aria-label="@Msg("PersonRosterSearch.Clear")"
                    @onclick="Clear">
                <span aria-hidden="true">&times;</span>
            </button>
        }
        <span class="visa-roster-search-bar__spinner @(showProgress ? null : "is-idle")"
              role="status"
              data-testid="visa-roster-search-progress"
              aria-hidden="@(!showProgress)"
              aria-label="@(showProgress ? Msg("PersonRosterSearch.Searching") : null)"></span>
    </label>
</form>
@if (HasQuery)
{
    <p class="visa-roster-search-count" role="status">@(State?.ResultCount is int found ? CountText(found) : "\u00a0")</p>
}
</div>

@code {
    /// <summary>Short pause after typing stops, then the list query runs.</summary>
    private const int SearchInputDelayMs = 300;

    /// <summary>A single letter starts the search. Blank text clears it.</summary>
    private const int MinimumSearchLength = 1;

    private string text = string.Empty;
    private string committed = string.Empty;
    private bool searching;
    private bool showProgress;
    private int searchSerial;
    private CancellationTokenSource? searchDelayCts;
    private ElementReference input;
    private PersonRosterSearchState? subscribed;

    [Parameter] public PersonRosterSearchState? State { get; set; }

    [Parameter] public EventCallback<string> OnSearch { get; set; }

    [Parameter] public EventCallback OnClear { get; set; }

    private bool HasQuery => !string.IsNullOrWhiteSpace(State?.Query);

    protected override void OnParametersSet()
    {
        Subscribe();
        var incoming = State?.Query ?? string.Empty;
        if (!searching && text == committed)
            text = incoming;
        committed = incoming;
    }

    public void Dispose()
    {
        if (subscribed != null)
            subscribed.Changed -= OnStateChanged;
        subscribed = null;
        CancelPendingSearch();
    }

    private void Subscribe()
    {
        if (ReferenceEquals(subscribed, State))
            return;

        if (subscribed != null)
            subscribed.Changed -= OnStateChanged;

        subscribed = State;
        if (subscribed != null)
            subscribed.Changed += OnStateChanged;
    }

    private void OnStateChanged()
    {
        var incoming = State?.Query ?? string.Empty;
        if (!searching && text == committed)
            text = incoming;
        committed = incoming;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || HasQuery)
            return;

        try
        {
            await input.FocusAsync();
        }
        catch
        {
            // The bar can unmount before the browser finishes focusing.
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        text = e.Value?.ToString() ?? string.Empty;
        if (text.Trim().Length < MinimumSearchLength)
        {
            showProgress = false;
            _ = ReleaseShortQuery();
            return;
        }

        showProgress = true;
        // Do not return the delay task. An incomplete input handler redraws the box and can drop typed characters.
        _ = ScheduleSearchAsync();
    }

    private async Task ScheduleSearchAsync()
    {
        var serial = ArmSearchDelay();
        var query = text.Trim();
        var cts = searchDelayCts;
        if (cts == null)
            return;

        try
        {
            await Task.Delay(SearchInputDelayMs, cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }

        if (serial != searchSerial)
            return;

        await RunQueryAsync(query);
    }

    private Task SearchNowAsync()
    {
        CancelPendingSearch();
        return RunQueryAsync(text.Trim());
    }

    private Task Submit() => SearchNowAsync();

    private Task RunQueryAsync(string query)
    {
        if (query.Length < MinimumSearchLength)
        {
            showProgress = false;
            return ReleaseShortQuery();
        }

        showProgress = true;
        var serial = searchSerial;
        return RunAsync(serial, () => OnSearch.InvokeAsync(query));
    }

    private Task ReleaseShortQuery()
    {
        CancelPendingSearch();
        if (string.IsNullOrWhiteSpace(text))
            return Clear();

        if (string.IsNullOrWhiteSpace(committed) && !HasQuery)
            return Task.CompletedTask;

        return RunClearKeepTextAsync();
    }

    private async Task RunClearKeepTextAsync()
    {
        var kept = text;
        searching = true;
        try
        {
            await OnClear.InvokeAsync();
        }
        finally
        {
            searching = false;
            showProgress = false;
            text = kept;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task Clear()
    {
        CancelPendingSearch();
        text = string.Empty;
        showProgress = false;
        return RunClearAsync();
    }

    private int ArmSearchDelay()
    {
        CancelTimer();
        searchDelayCts = new CancellationTokenSource();
        return ++searchSerial;
    }

    private void CancelPendingSearch()
    {
        searchSerial++;
        CancelTimer();
    }

    private void CancelTimer()
    {
        var pending = searchDelayCts;
        searchDelayCts = null;
        if (pending == null)
            return;

        try
        {
            pending.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        pending.Dispose();
    }

    private async Task RunAsync(int serial, Func<Task> action)
    {
        searching = true;
        try
        {
            await action();
        }
        finally
        {
            searching = false;
            if (serial == searchSerial)
                showProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunClearAsync()
    {
        searching = true;
        try
        {
            await OnClear.InvokeAsync();
        }
        finally
        {
            searching = false;
            showProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);

    private static string CountText(int count) =>
        count == 1
            ? Msg("PersonRosterSearch.ResultCount.One")
            : VisaUiMessages.Format("PersonRosterSearch.ResultCount.Many", count);
}
