@namespace Visa2026.Blazor.Server.Components
@using System.Linq
@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.PreviewSlot

<div class="resminamalar-slot-panel issue-issued-header-slot-panel issue-issued-visa-slot-panel">
    <div class="resminamalar-slot-panel__header visa-preview-drawer__header">
        <div class="visa-preview-drawer__title-block">
            <span class="visa-preview-drawer__title">@PanelTitle</span>
            @if (!string.IsNullOrWhiteSpace(_draft?.ApplicationCaption))
            {
                <span class="visa-preview-drawer__subtitle">@_draft!.ApplicationCaption@ProfileSuffix</span>
            }
        </div>
        <div class="visa-preview-drawer__header-actions">
            <button class="visa-preview-drawer__btn visa-preview-drawer__btn--close"
                    type="button"
                    title="@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Workspace.Close")"
                    @onclick="RequestCloseFromChrome">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </div>

    @if (_draft != null)
    {
        <DetailRecordRibbon @ref="_ribbon"
                            RecordTitle="@PanelTitle"
                            IsDirty="@RibbonDirty"
                            CanSave="@RibbonCanSave"
                            CanCreate="true"
                            CanDelete="true"
                            HoldFocus="false"
                            IsBusy="@_busy"
                            TrySave="TrySaveAsync"
                            CloseRequested="ClosePanelAsync"
                            NewRequested="StartNewAsync"
                            DeleteRequested="DeleteFromRibbonAsync" />
    }

    <div class="resminamalar-slot-panel__body">
        <div class="resminamalar-slot-panel__catalog issue-issued-header-slot issue-issued-visa-slot">
            @if (_loadError != null)
            {
                <p class="issue-issued-header-slot__error">@_loadError</p>
            }
            else if (_draft == null)
            {
                <p class="issue-issued-header-slot__muted">@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Loading")</p>
            }
            else
            {
                @if (!_draft.IsEditMode)
                {
                    <p class="issue-issued-visa-slot__banner issue-issued-visa-slot__banner--info">
                        @(_draft.UsesInvitationSource
                            ? ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaBannerInvitation")
                            : ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaBannerRoster"))
                    </p>
                    @if (!_draft.HasUnusedLine)
                    {
                        <p class="issue-issued-visa-slot__banner issue-issued-visa-slot__banner--warn">
                            @UnusedWarningText
                        </p>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(_saveMessage))
                {
                    <p class="issue-issued-visa-slot__banner issue-issued-visa-slot__banner--success">@_saveMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <p class="issue-issued-header-slot__error">@_actionError</p>
                }
                <IssueComposeFieldCueLegend />

                @foreach (var section in PeopleSections)
                {
                    if (section.People.Count == 0)
                        continue;
                    <section class="issue-issued-visa-slot__group">
                        <h3 class="issue-issued-visa-slot__group-title">@(section.Title)</h3>
                        @foreach (var person in section.People)
                        {
                            var canOpen = CanOpenVisaPerson(person);
                            <article class="@VisaRowClass(person)" @onclick="() => OpenVisaPerson(person)">
                                <div class="issue-issued-visa-slot__card-head">
                                    @if (!_draft.IsEditMode)
                                    {
                                        <span @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   disabled="@(person.AlreadyIssued || !person.IsReady)"
                                                   checked="@person.Include"
                                                   @onchange="e => OnIncludeChanged(person, e)" />
                                        </span>
                                    }
                                    <span class="issue-issued-visa-slot__avatar">@Initials(person.PersonName)</span>
                                    <span class="issue-issued-visa-slot__person">
                                        <span class="issue-issued-visa-slot__person-name">@person.PersonName</span>
                                    </span>
                                    @if (!_draft.IsEditMode && !person.IsReady)
                                    {
                                        <span class="issue-issued-header-slot__status issue-issued-header-slot__status--warn">@ApplicationProfileLocalization.IssuedStatus("No passport")</span>
                                    }
                                    else if (!_draft.IsEditMode && person.Include)
                                    {
                                        <button type="button"
                                                class="issue-issued-header-slot__link-btn"
                                                @onclick="() => RemovePerson(person)"
                                                @onclick:stopPropagation="true">
                                            @ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Remove")
                                        </button>
                                    }
                                    @if (canOpen)
                                    {
                                        <button type="button"
                                                class="issue-issued-header-slot__link-btn"
                                                @onclick="() => OpenVisaPerson(person)"
                                                @onclick:stopPropagation="true">
                                            @ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.OpenItem")
                                        </button>
                                    }
                                </div>
                            </article>
                        }
                    </section>
                }

                @if (!_draft.IsEditMode && _draft.PeopleWithoutIssuedInvitation.Count > 0)
                {
                    var omittedNames = string.Join(", ", _draft.PeopleWithoutIssuedInvitation);
                    var omittedVerb = _draft.PeopleWithoutIssuedInvitation.Count == 1 ? "is" : "are";
                    var omittedHave = _draft.PeopleWithoutIssuedInvitation.Count == 1 ? "has" : "have";
                    <p class="issue-issued-visa-slot__omit">
                        @omittedNames @omittedVerb on this case but @omittedHave no issued invitation — not listed.
                    </p>
                }

            }
        </div>
    </div>
    @if (_visaDialog is IssueIssuedVisaPersonCardDraft editPerson && _draft != null)
    {
        var numberKey = CueKey(editPerson, "visaNumber");
        var typeKey = CueKey(editPerson, "visaType");
        var categoryKey = CueKey(editPerson, "visaCategory");
        var periodKey = CueKey(editPerson, "visaPeriod");
        var placeKey = CueKey(editPerson, "visaPlace");
        var issueKey = CueKey(editPerson, "issueDate");
        var startKey = CueKey(editPerson, "startDate");
        var expKey = CueKey(editPerson, "expiration");
        var zoneKey = CueKey(editPerson, "borderZone");
        var passportKey = CueKey(editPerson, "passport");
        var visibleDocs = editPerson.Documents.Where(doc => !_visaDialogRemovedDocs.Contains(doc.DocumentId)).ToList();
        <div class="issue-issued-wp-dialog-back" @onclick="DismissVisaDialogAsync">
            <div class="issue-issued-wp-dialog issue-issued-visa-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="issue-issued-visa-dialog-title"
                 tabindex="-1"
                 @ref="_visaDialogEl"
                 @onclick:stopPropagation="true"
                 @onkeydown="OnVisaDialogKeyDown">
                <header class="issue-issued-wp-dialog__head">
                    <h2 id="issue-issued-visa-dialog-title" class="issue-issued-wp-dialog__title">@editPerson.PersonName</h2>
                    <span class="issue-issued-wp-dialog__tools">
                        <button type="button"
                                class="issue-issued-wp-dialog__gear @(_visaPlaceGear ? "is-on" : null)"
                                aria-pressed="@_visaPlaceGear"
                                title="@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaPlaceGear")"
                                @onclick="ToggleVisaPlaceGear"
                                @onclick:stopPropagation="true">⚙</button>
                        <button type="button"
                                class="issue-issued-wp-dialog__close"
                            title="@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Cancel")"
                            @onclick="DismissVisaDialogAsync">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                        </svg>
                        </button>
                    </span>
                </header>
                <div class="issue-issued-header-slot__grid">
                    <label class="issue-issued-header-slot__field @FieldCueClass(numberKey, true, IssueComposeFieldCue.HasText(editPerson.VisaNumber))">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaNumber")</span>
                        <input class="issue-issued-header-slot__input" @bind="editPerson.VisaNumber" @bind:event="oninput" />
                    </label>
                    <label class="issue-issued-header-slot__field @FieldCueClass(typeKey, true, IssueComposeFieldCue.HasId(editPerson.VisaTypeId))">
                        <span>@ApplicationProfileLocalization.Field("VisaType") *</span>
                        <select class="issue-issued-header-slot__input"
                                value="@GuidText(editPerson.VisaTypeId)"
                                @onchange="e => editPerson.VisaTypeId = ParseGuid(e.Value)">
                            <option value="">—</option>
                            @foreach (var opt in _draft.VisaTypes)
                            {
                                <option value="@opt.Id.ToString("N")">@opt.Caption</option>
                            }
                        </select>
                    </label>
                    <label class="issue-issued-header-slot__field @FieldCueClass(categoryKey, true, IssueComposeFieldCue.HasId(editPerson.VisaCategoryId))">
                        <span>@ApplicationProfileLocalization.Field("VisaCategory") *</span>
                        <select class="issue-issued-header-slot__input"
                                value="@GuidText(editPerson.VisaCategoryId)"
                                @onchange="e => editPerson.VisaCategoryId = ParseGuid(e.Value)">
                            <option value="">—</option>
                            @foreach (var opt in _draft.VisaCategories)
                            {
                                <option value="@opt.Id.ToString("N")">@opt.Caption</option>
                            }
                        </select>
                    </label>
                    @if (_draft.UsesInvitationSource)
                    {
                        <label class="issue-issued-header-slot__field @FieldCueClass(periodKey, true, IssueComposeFieldCue.HasId(editPerson.VisaPeriodId))">
                            <span>@ApplicationProfileLocalization.Field("VisaPeriod") *</span>
                            <select class="issue-issued-header-slot__input"
                                    value="@GuidText(editPerson.VisaPeriodId)"
                                    @onchange="e => editPerson.VisaPeriodId = ParseGuid(e.Value)">
                                <option value="">—</option>
                                @foreach (var opt in _draft.VisaPeriods)
                                {
                                    <option value="@opt.Id.ToString("N")">@opt.Caption</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <label class="issue-issued-header-slot__field issue-issued-header-slot__field--readonly">
                            <span>@ApplicationProfileLocalization.Field("VisaPeriod")</span>
                            <input class="issue-issued-header-slot__input" readonly
                                   value="@(LookupCaption(_draft.VisaPeriods, editPerson.VisaPeriodId))" />
                        </label>
                    }
                    <div class="issue-issued-header-slot__field @FieldCueClass(placeKey, true, IssueComposeFieldCue.HasId(editPerson.VisaIssuedPlaceId))">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaIssuedPlace")</span>
                        <div @onkeydown:stopPropagation="true">
                        <AddressAutocompleteField SingleLine="true"
                                                  ShowCatalogActions="_visaPlaceGear"
                                                  Required="true"
                                                  FieldName="@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaIssuedPlace")"
                                                  ItemNoun="place"
                                                  ItemNounPlural="places"
                                                  Placeholder="Start typing a place"
                                                  EmptyHint="@(_visaPlaceGear ? "Search saved places. Use the + button to add a new one." : "Start typing to search saved places.")"
                                                  Suggestions="@VisaPlaceSuggestions"
                                                  Value="@VisaPlaceCaption(editPerson.VisaIssuedPlaceId)"
                                                  ValueChanged="text => OnVisaPlaceValueChanged(editPerson, text)"
                                                  AddSaved="OnVisaIssuedPlaceAddAsync"
                                                  RenameSaved="OnVisaIssuedPlaceRenameAsync" />
                        </div>
                    </div>
                    <label class="issue-issued-header-slot__field @FieldCueClass(issueKey, true, IssueComposeFieldCue.HasDate(editPerson.IssueDate))">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.IssuedDate") *</span>
                        <OfficerDateEdit Date="editPerson.IssueDate"
                                         DateChanged="value => OnVisaDialogIssueDateChanged(editPerson, value)" />
                    </label>
                    <label class="issue-issued-header-slot__field @FieldCueClass(startKey, true, IssueComposeFieldCue.HasDate(editPerson.StartDate))">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Start")</span>
                        <OfficerDateEdit Date="editPerson.StartDate"
                                         DateChanged="value => OnVisaDialogStartDateChanged(editPerson, value)" />
                    </label>
                    <label class="issue-issued-header-slot__field @FieldCueClass(expKey, true, IssueComposeFieldCue.HasDate(editPerson.ExpirationDate))">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Expiration")</span>
                        <OfficerDateEdit Date="editPerson.ExpirationDate"
                                         DateChanged="value => editPerson.ExpirationDate = value?.Date" />
                    </label>
                    <div class="issue-issued-header-slot__field issue-issued-header-slot__field--wide @FieldCueClass(zoneKey, false, IssueComposeFieldCue.HasText(editPerson.BorderZoneLocation))">
                        <span>@ApplicationProfileLocalization.Field("BorderZone")</span>
                        <LocationMultiSelectField Value="@editPerson.BorderZoneLocation"
                                                  Suggestions="@LoadIssuedSavedLocations(ApplicationProfileSavedLocationField.BorderZone)"
                                                  NoneValue="@CommaSeparatedSelectionHelper.NoneValue"
                                                  FieldName="border zone location"
                                                  Placeholder="Start typing a location"
                                                  EmptyHint="Search saved locations. Use the + button to add a new one."
                                                  ValueChanged="@(value => editPerson.BorderZoneLocation = value ?? string.Empty)"
                                                  AddSaved="text => OnIssuedVisaLocationAddAsync(ApplicationProfileSavedLocationField.BorderZone, text)"
                                                  RenameSaved="pair => OnIssuedVisaLocationRenameAsync(ApplicationProfileSavedLocationField.BorderZone, pair)" />
                    </div>
                    <label class="issue-issued-header-slot__field issue-issued-header-slot__field--wide @FieldCueClass(passportKey, false, IssueComposeFieldCue.HasText(editPerson.PassportNumber), true)">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Org.PassportNumber")</span>
                        <input class="issue-issued-header-slot__input" value="@editPerson.PassportNumber" disabled />
                    </label>
                    <div class="issue-issued-header-slot__field issue-issued-header-slot__field--wide">
                        <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaCopy")</span>
                        <p class="issue-issued-header-slot__muted">
                            @ApplicationProfileLocalization.Format("ApplicationProfileInstance.Issued.CopyHint", ApplicationProfileLocalization.Msg("ApplicationProfile.Doc.Visa"), MaxCopyUploadMb)
                        </p>
                        @if (visibleDocs.Count == 0 && string.IsNullOrWhiteSpace(editPerson.PendingCopyFileName))
                        {
                            <p class="issue-issued-header-slot__muted">@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Workspace.NoCopy")</p>
                        }
                        else
                        {
                            <ul class="issue-issued-visa-slot__copy-list">
                                @foreach (var doc in visibleDocs)
                                {
                                    <li @key="@doc.DocumentId">
                                        <span>@doc.FileName</span>
                                        @if (_draft.IsEditMode)
                                        {
                                            <button type="button"
                                                    class="issue-issued-header-slot__link-btn"
                                                    disabled="@_busy"
                                                    @onclick="() => StageVisaDialogRemove(doc.DocumentId)">
                                                @ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Remove")
                                            </button>
                                        }
                                    </li>
                                }
                                @if (!string.IsNullOrWhiteSpace(editPerson.PendingCopyFileName))
                                {
                                    <li>
                                        <span>@ApplicationProfileLocalization.Format("ApplicationProfileInstance.Issued.AttachesOnCreate", editPerson.PendingCopyFileName)</span>
                                        <button type="button"
                                                class="issue-issued-header-slot__link-btn"
                                                disabled="@_busy"
                                                @onclick="() => ClearPendingCopy(editPerson)">
                                            @ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Remove")
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        <label class="issue-issued-header-slot__upload">
                            <InputFile OnChange="OnVisaDialogCopySelected"
                                       accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp"
                                       disabled="@_busy" />
                            <span>@ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.UploadCopy")</span>
                        </label>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <p class="issue-issued-header-slot__error">@_actionError</p>
                }
                <footer class="issue-issued-wp-dialog__actions">
                    <button type="button" class="issue-issued-header-slot__btn" @onclick="DismissVisaDialogAsync">
                        @ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.Cancel")
                    </button>
                    <button type="button" class="issue-issued-header-slot__btn issue-issued-header-slot__btn--primary" disabled="@_busy" @onclick="KeepVisaDialogAsync">
                        @ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.KeepItem")
                    </button>
                </footer>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IssueIssuedVisaSlotRequest? Request { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService SlotService { get; set; } = null!;
    [Inject] private IApplicationWorkspacePersonUiActions? WorkspaceActions { get; set; }

    private readonly Dictionary<string, IReadOnlyList<CaseAddressAutocomplete.SavedEntry>> _issuedLocCache = new(StringComparer.Ordinal);

    private async Task OnIssuedVisaLocationAddAsync(ApplicationProfileSavedLocationField field, string text)
    {
        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var instanceId = _draft?.ApplicationProfileInstanceId ?? Guid.Empty;
        if (instanceId == Guid.Empty)
            return;
        var profile = objectSpace.GetObjectByKey<ApplicationProfileInstance>(instanceId)?.ApplicationProfile;
        if (profile == null)
            return;
        if (!CaseSavedLocation.TryAdd(objectSpace, profile, field, text, out var error))
            throw new InvalidOperationException(error ?? CaseSavedLocation.DuplicateError);
        objectSpace.CommitChanges();
        _issuedLocCache.Remove(field.ToString());
        await Task.CompletedTask;
    }

    private async Task OnIssuedVisaLocationRenameAsync(
        ApplicationProfileSavedLocationField field,
        (string Previous, string Next) pair)
    {
        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var instanceId = _draft?.ApplicationProfileInstanceId ?? Guid.Empty;
        if (instanceId == Guid.Empty)
            return;
        var profile = objectSpace.GetObjectByKey<ApplicationProfileInstance>(instanceId)?.ApplicationProfile;
        if (profile == null)
            return;
        if (!CaseSavedLocation.TryRename(objectSpace, profile, field, pair.Previous, pair.Next, out var error))
            throw new InvalidOperationException(error ?? CaseSavedLocation.DuplicateError);
        objectSpace.CommitChanges();
        _issuedLocCache.Remove(field.ToString());
        await Task.CompletedTask;
    }

    private IReadOnlyList<CaseAddressAutocomplete.SavedEntry> LoadIssuedSavedLocations(ApplicationProfileSavedLocationField field)
    {
        var key = field.ToString();
        if (_issuedLocCache.TryGetValue(key, out var cached))
            return cached;
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            cached = CaseSavedLocation.List(objectSpace, field);
        }
        catch
        {
            cached = Array.Empty<CaseAddressAutocomplete.SavedEntry>();
        }
        _issuedLocCache[key] = cached;
        return cached;
    }


    private IssueIssuedVisaComposeDraft? _draft;
    private string? _loadError;
    private string? _actionError;
    private string? _saveMessage;
    private string? _boundOccupantKey;
    private string? _pristineFingerprint;
    private bool _busy;
    private const int MaxCopyUploadMb = 5;
    private readonly HashSet<string> _reviewedFields = new(StringComparer.Ordinal);
    private readonly HashSet<string> _defaultFields = new(StringComparer.Ordinal);
    private IssueIssuedVisaPersonCardDraft? _visaDialog;
    private bool _visaPlaceGear;
    private List<IssueIssuedVisaLookupOption> _visaPlaceOptions = new();
    private readonly HashSet<Guid> _visaDialogRemovedDocs = new();
    private ElementReference _visaDialogEl;
    private bool _visaDialogFocus;

    private string PanelTitle =>
        _draft?.IsEditMode == true
            ? ApplicationProfileLocalization.IssuedComposeTitle(
                string.IsNullOrWhiteSpace(_draft.Title) ? "Issued visa" : _draft.Title)
            : ApplicationProfileLocalization.IssuedComposeTitle("New issued visa");

    private string ProfileSuffix =>
        string.IsNullOrWhiteSpace(_draft?.ProfileCode) ? string.Empty : $" · {_draft.ProfileCode}";

    private string UnusedWarningText
    {
        get
        {
            if (_draft == null)
                return string.Empty;
            if (_draft.UsesInvitationSource)
                return "Cannot create visas — no unused issued invitation line.";
            if (!_draft.AllPeople.Any())
                return "Cannot create visas — no people on this case.";
            return "Cannot create visas — every person on this case already has an issued visa.";
        }
    }

    private bool CanCreate =>
        _draft != null
        && !_busy
        && _draft.HasUnusedLine
        && _draft.SelectedUnusedCount > 0;

    /// <summary>
    /// Create: people still waiting for a visa (not selected, selected, not ready — name only).
    /// Visas already saved on this case stay on the case list and are not shown here.
    /// Edit: keep invitation / case grouping as loaded.
    /// </summary>
    private IEnumerable<(string Title, IReadOnlyList<IssueIssuedVisaPersonCardDraft> People)> PeopleSections
    {
        get
        {
            if (_draft == null)
                return Array.Empty<(string, IReadOnlyList<IssueIssuedVisaPersonCardDraft>)>();

            if (_draft.IsEditMode)
            {
                return _draft.Groups.Select(group => (
                    Title: _draft.UsesInvitationSource
                        ? $"{ApplicationProfileLocalization.Msg("ApplicationProfile.Doc.Invitation")} {group.InvitationNumber} · {group.InvitationIssuedDate:dd MMM yyyy}"
                        : ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.PeopleOnCase"),
                    People: (IReadOnlyList<IssueIssuedVisaPersonCardDraft>)group.People));
            }

            var people = _draft.AllPeople
                .OrderBy(p => p.PersonName, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            return
            [
                (
                    ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaCreateNotSelected"),
                    (IReadOnlyList<IssueIssuedVisaPersonCardDraft>)people
                        .Where(p => !p.AlreadyIssued && p.IsReady && !p.Include)
                        .ToList()),
                (
                    ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaCreateSelected"),
                    (IReadOnlyList<IssueIssuedVisaPersonCardDraft>)people
                        .Where(p => !p.AlreadyIssued && p.IsReady && p.Include)
                        .ToList()),
                (
                    ApplicationProfileLocalization.Msg("ApplicationProfileInstance.Issued.VisaCreateNotReady"),
                    (IReadOnlyList<IssueIssuedVisaPersonCardDraft>)people
                        .Where(p => !p.AlreadyIssued && !p.IsReady)
                        .ToList()),
            ];
        }
    }

    /// <summary>
    /// Edit: Save only when modified (XAF ObjectSpace.IsModified style).
    /// </summary>
    private bool CanSaveVisa =>
        _draft is { IsEditMode: true }
        && !_busy
        && IsDirty;

    private bool RibbonCanSave => _draft?.IsEditMode == true ? CanSaveVisa : CanCreate;

    private bool _savedClean;
    private DetailRecordRibbon? _ribbon;

    private bool RibbonDirty =>
        _draft != null && (IsDirty || (!_draft.IsEditMode && !_savedClean));

    private bool IsDirty =>
        _draft != null
        && !string.IsNullOrEmpty(_pristineFingerprint)
        && !string.Equals(_pristineFingerprint, BuildFingerprint(), StringComparison.Ordinal);

    protected override void OnParametersSet()
    {
        if (Request == null)
        {
            _draft = null;
            _loadError = "Compose request is missing.";
            _boundOccupantKey = null;
            _pristineFingerprint = null;
            CancelVisaDialog();
            return;
        }

        var occupantKey = VisaPreviewSlotOccupantKeys.ForIssueIssuedVisa(Request);
        if (string.Equals(_boundOccupantKey, occupantKey, StringComparison.Ordinal) && _draft != null)
            return;

        _boundOccupantKey = occupantKey;
        _savedClean = false;
        _actionError = null;
        _saveMessage = null;
        CancelVisaDialog();
        LoadDraft();
    }

    private void LoadDraft()
    {
        _loadError = null;
        _draft = null;
        if (Request == null || Request.ApplicationProfileInstanceId == Guid.Empty)
        {
            _loadError = "Application is not available.";
            _pristineFingerprint = null;
            return;
        }

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        if (Request.ExistingVisaId is Guid visaId && visaId != Guid.Empty)
        {
            _draft = IssueIssuedVisaComposeService.LoadExistingDraft(
                objectSpace,
                Request.ApplicationProfileInstanceId,
                visaId);
            if (_draft == null)
            {
                _loadError = "This visa is not issued by this application.";
                _pristineFingerprint = null;
            }
            else
            {
                CaptureFieldCues();
                CapturePristine();
                _visaPlaceOptions = _draft.VisaIssuedPlaces.ToList();
                var person = _draft.AllPeople.FirstOrDefault();
                if (person != null)
                    OpenVisaPerson(person);
            }
            return;
        }

        _draft = IssueIssuedVisaComposeService.LoadDraft(objectSpace, Request.ApplicationProfileInstanceId);
        if (_draft == null)
        {
            _loadError = "This application cannot issue visas.";
            _pristineFingerprint = null;
        }
        else
        {
            CaptureFieldCues();
            CapturePristine();
            _visaPlaceOptions = _draft.VisaIssuedPlaces.ToList();
        }
    }

    private void OnIncludeChanged(IssueIssuedVisaPersonCardDraft person, ChangeEventArgs e)
    {
        if (person.AlreadyIssued || !person.IsReady)
            return;

        person.Include = e.Value is bool flag
            ? flag
            : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        if (person.Include)
            OpenVisaPerson(person);
        else if (_visaDialog != null && SameVisaPerson(_visaDialog, person))
            CancelVisaDialog();
    }

    private void RemovePerson(IssueIssuedVisaPersonCardDraft person)
    {
        if (person.AlreadyIssued)
            return;
        person.Include = false;
        if (_visaDialog != null && SameVisaPerson(_visaDialog, person))
            CancelVisaDialog();
    }

    private static string CueKey(IssueIssuedVisaPersonCardDraft person, string field)
    {
        var id = person.InvitationItemId != Guid.Empty ? person.InvitationItemId : person.PersonId;
        return $"{id:N}:{field}";
    }

    private string FieldCueClass(string key, bool required, bool hasValue, bool sourced = false) =>
        IssueComposeFieldCue.FieldClass(
            required,
            hasValue,
            isDefault: _defaultFields.Contains(key),
            reviewed: _reviewedFields.Contains(key),
            sourced);

    private void ReviewField(string key)
    {
        if (string.IsNullOrEmpty(key))
            return;
        _reviewedFields.Add(key);
    }

    private void CaptureFieldCues()
    {
        _reviewedFields.Clear();
        _defaultFields.Clear();
        if (_draft == null)
            return;

        foreach (var person in _draft.AllPeople)
        {
            if (IssueComposeFieldCue.HasText(person.VisaNumber))
                _defaultFields.Add(CueKey(person, "visaNumber"));
            if (IssueComposeFieldCue.HasId(person.VisaTypeId))
                _defaultFields.Add(CueKey(person, "visaType"));
            if (IssueComposeFieldCue.HasId(person.VisaCategoryId))
                _defaultFields.Add(CueKey(person, "visaCategory"));
            if (_draft.UsesInvitationSource && IssueComposeFieldCue.HasId(person.VisaPeriodId))
                _defaultFields.Add(CueKey(person, "visaPeriod"));
            if (IssueComposeFieldCue.HasId(person.VisaIssuedPlaceId))
                _defaultFields.Add(CueKey(person, "visaPlace"));
            if (IssueComposeFieldCue.HasDate(person.IssueDate))
                _defaultFields.Add(CueKey(person, "issueDate"));
            if (IssueComposeFieldCue.HasDate(person.StartDate))
                _defaultFields.Add(CueKey(person, "startDate"));
            if (IssueComposeFieldCue.HasDate(person.ExpirationDate))
                _defaultFields.Add(CueKey(person, "expiration"));
            if (IssueComposeFieldCue.HasText(person.BorderZoneLocation))
                _defaultFields.Add(CueKey(person, "borderZone"));
        }

        if (_draft.IsEditMode)
        {
            foreach (var key in _defaultFields)
                _reviewedFields.Add(key);
            _defaultFields.Clear();
        }
    }

    private void ClearPendingCopy(IssueIssuedVisaPersonCardDraft person)
    {
        person.PendingCopyFileName = null;
        person.PendingCopyBytes = null;
        _actionError = null;
    }

    private async Task RemoveCopyAsync(IssueIssuedVisaPersonCardDraft person, Guid documentId)
    {
        if (_draft == null || _busy || documentId == Guid.Empty)
            return;
        if (person.ExistingVisaId is not Guid visaId || visaId == Guid.Empty)
            return;

        _busy = true;
        _actionError = null;
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var result = IssueIssuedVisaComposeService.RemoveDocument(
                objectSpace,
                Request!.ApplicationProfileInstanceId,
                visaId,
                documentId);
            if (!result.Succeeded)
            {
                _actionError = result.ErrorMessage;
                return;
            }

            ReloadDocuments(person);
            WorkspaceActions?.NotifyWorkspaceChanged();
        }
        finally
        {
            _busy = false;
        }

        await Task.CompletedTask;
    }

    private void ReloadDocuments(IssueIssuedVisaPersonCardDraft person)
    {
        if (person.ExistingVisaId is not Guid visaId || visaId == Guid.Empty)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        person.Documents = IssueIssuedVisaComposeService.ListDocuments(objectSpace, visaId).ToList();
    }

    private void CapturePristine()
    {
        _pristineFingerprint = _draft == null ? null : BuildFingerprint();
    }

    private string BuildFingerprint()
    {
        var person = _draft?.AllPeople.FirstOrDefault();
        if (person == null)
            return string.Empty;

        return string.Join("|",
            person.VisaNumber?.Trim() ?? string.Empty,
            GuidText(person.VisaTypeId),
            GuidText(person.VisaCategoryId),
            GuidText(person.VisaPeriodId),
            GuidText(person.VisaIssuedPlaceId),
            person.IssueDate.ToString("yyyy-MM-dd"),
            person.StartDate.ToString("yyyy-MM-dd"),
            person.ExpirationDate?.ToString("yyyy-MM-dd") ?? string.Empty,
            person.BorderZoneLocation?.Trim() ?? string.Empty);
    }

    private async Task CreateAsync()
    {
        if (!CanCreate || Request == null || _draft == null)
            return;

        _busy = true;
        _actionError = null;
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var result = IssueIssuedVisaComposeService.Create(objectSpace, _draft);
            if (result.Succeeded)
            {
                WorkspaceActions?.NotifyWorkspaceChanged();
                var createdId = result.Rows.Count == 1 ? result.Rows[0].VisaId : Guid.Empty;
                if (createdId != Guid.Empty && Request != null)
                {
                    _busy = false;
                    await SlotService.OpenIssueIssuedVisaAsync(new IssueIssuedVisaSlotRequest
                    {
                        ApplicationProfileInstanceId = Request.ApplicationProfileInstanceId,
                        ExistingVisaId = createdId,
                    });
                    return;
                }

                LoadDraft();
                _savedClean = true;
                _saveMessage = "Saved.";
                return;
            }

            _actionError = result.ErrorMessage ?? "Cannot create visas.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSaveVisa || Request == null || _draft == null)
            return;

        _busy = true;
        _actionError = null;
        _saveMessage = null;
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var result = IssueIssuedVisaComposeService.Update(objectSpace, _draft);
            if (result.Succeeded)
            {
                WorkspaceActions?.NotifyWorkspaceChanged();
                LoadDraft();
                _saveMessage = "Visa saved.";
            }
            else
            {
                _actionError = result.ErrorMessage ?? "Cannot save visa.";
            }
        }
        finally
        {
            _busy = false;
        }

        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_visaDialogFocus || _visaDialog == null)
            return;
        _visaDialogFocus = false;
        try
        {
            await _visaDialogEl.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Dialog was closed before focus.
        }
    }

    private bool CanOpenVisaPerson(IssueIssuedVisaPersonCardDraft person) =>
        _draft != null && (_draft.IsEditMode || (!person.AlreadyIssued && person.IsReady));

    private string VisaRowClass(IssueIssuedVisaPersonCardDraft person)
    {
        var open = _visaDialog != null && SameVisaPerson(_visaDialog, person);
        if (open)
            return "issue-issued-visa-slot__card issue-issued-visa-slot__card--row issue-issued-visa-slot__card--open";
        if (CanOpenVisaPerson(person))
            return "issue-issued-visa-slot__card issue-issued-visa-slot__card--row";
        return "issue-issued-visa-slot__card issue-issued-visa-slot__card--row issue-issued-visa-slot__card--static";
    }

    private void OpenVisaPerson(IssueIssuedVisaPersonCardDraft person)
    {
        if (!CanOpenVisaPerson(person))
            return;
        if (_visaDialog != null && SameVisaPerson(_visaDialog, person))
            return;
        _visaDialog = CloneVisaPerson(person);
        _visaDialogRemovedDocs.Clear();
        _visaPlaceGear = false;
        _visaDialogFocus = true;
        _actionError = null;
    }

    private void CancelVisaDialog()
    {
        _visaDialog = null;
        _visaDialogRemovedDocs.Clear();
        _visaPlaceGear = false;
    }

    private void ToggleVisaPlaceGear() => _visaPlaceGear = !_visaPlaceGear;

    private IReadOnlyList<CaseAddressAutocomplete.SavedEntry> VisaPlaceSuggestions =>
        _visaPlaceOptions
            .Select(place => new CaseAddressAutocomplete.SavedEntry(place.Caption, 0, DateTime.MinValue))
            .ToList();

    private string VisaPlaceCaption(Guid? id) =>
        id is Guid placeId && placeId != Guid.Empty
            ? _visaPlaceOptions.FirstOrDefault(place => place.Id == placeId)?.Caption ?? string.Empty
            : string.Empty;

    private Task OnVisaPlaceValueChanged(IssueIssuedVisaPersonCardDraft person, string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            person.VisaIssuedPlaceId = null;
            ReviewField(CueKey(person, "visaPlace"));
            return Task.CompletedTask;
        }

        var key = CaseAddressAutocomplete.FoldKey(text);
        var match = _visaPlaceOptions.FirstOrDefault(place =>
            string.Equals(CaseAddressAutocomplete.FoldKey(place.Caption), key, StringComparison.Ordinal));
        if (match != null)
            person.VisaIssuedPlaceId = match.Id;
        ReviewField(CueKey(person, "visaPlace"));
        return Task.CompletedTask;
    }

    private Task OnVisaIssuedPlaceAddAsync(string text)
    {
        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<VisaIssuedPlace>();
        IssueIssuedVisaComposeService.AddVisaIssuedPlace(objectSpace, text);
        _visaPlaceOptions = IssueIssuedVisaComposeService.ListVisaIssuedPlaces(objectSpace);
        return Task.CompletedTask;
    }

    private Task OnVisaIssuedPlaceRenameAsync((string Previous, string Next) pair)
    {
        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<VisaIssuedPlace>();
        IssueIssuedVisaComposeService.RenameVisaIssuedPlace(objectSpace, pair.Previous, pair.Next);
        _visaPlaceOptions = IssueIssuedVisaComposeService.ListVisaIssuedPlaces(objectSpace);
        return Task.CompletedTask;
    }

    private async Task OnVisaDialogKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
            await DismissVisaDialogAsync();
    }

    private async Task DismissVisaDialogAsync()
    {
        if (_draft?.IsEditMode == true)
        {
            await ClosePanelAsync();
            return;
        }

        CancelVisaDialog();
    }

    private async Task KeepVisaDialogAsync()
    {
        var edit = _visaDialog;
        if (edit == null || _draft == null)
        {
            CancelVisaDialog();
            return;
        }

        var target = _draft.AllPeople.FirstOrDefault(p => SameVisaPerson(p, edit));
        if (target == null)
        {
            CancelVisaDialog();
            return;
        }

        target.VisaNumber = edit.VisaNumber?.Trim() ?? string.Empty;
        target.VisaTypeId = edit.VisaTypeId;
        target.VisaCategoryId = edit.VisaCategoryId;
        target.VisaPeriodId = edit.VisaPeriodId;
        target.VisaIssuedPlaceId = edit.VisaIssuedPlaceId;
        target.IssueDate = edit.IssueDate;
        target.StartDate = edit.StartDate;
        target.ExpirationDate = edit.ExpirationDate;
        target.BorderZoneLocation = edit.BorderZoneLocation ?? string.Empty;
        target.PendingCopyFileName = edit.PendingCopyFileName;
        target.PendingCopyBytes = edit.PendingCopyBytes;

        ReviewField(CueKey(target, "visaNumber"));
        ReviewField(CueKey(target, "visaType"));
        ReviewField(CueKey(target, "visaCategory"));
        ReviewField(CueKey(target, "visaPeriod"));
        ReviewField(CueKey(target, "visaPlace"));
        ReviewField(CueKey(target, "issueDate"));
        ReviewField(CueKey(target, "startDate"));
        ReviewField(CueKey(target, "expiration"));
        ReviewField(CueKey(target, "borderZone"));

        var removed = _visaDialogRemovedDocs.ToList();
        var pendingName = edit.PendingCopyFileName;
        var pendingBytes = edit.PendingCopyBytes;
        var editMode = _draft.IsEditMode;
        if (!editMode)
        {
            CancelVisaDialog();
            return;
        }

        foreach (var documentId in removed)
            await RemoveCopyAsync(target, documentId);

        if (pendingBytes is { Length: > 0 })
        {
            target.PendingCopyFileName = null;
            target.PendingCopyBytes = null;
            await SaveStagedVisaCopyAsync(target, pendingName, pendingBytes);
        }

        _busy = true;
        _actionError = null;
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var result = IssueIssuedVisaComposeService.Update(objectSpace, _draft);
            if (!result.Succeeded)
            {
                _actionError = result.ErrorMessage ?? "Cannot save visa.";
                return;
            }

            WorkspaceActions?.NotifyWorkspaceChanged();
            await ClosePanelAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static Task OnVisaDialogIssueDateChanged(IssueIssuedVisaPersonCardDraft card, DateTime? value)
    {
        var previousIssueDate = card.IssueDate;
        card.IssueDate = value ?? DateTime.Today;
        if (card.StartDate == default || card.StartDate.Date == previousIssueDate.Date)
            card.StartDate = card.IssueDate.Date;
        else if (card.StartDate.Date < card.IssueDate.Date)
            card.StartDate = card.IssueDate.Date;
        return Task.CompletedTask;
    }

    private static Task OnVisaDialogStartDateChanged(IssueIssuedVisaPersonCardDraft card, DateTime? value)
    {
        var start = value ?? card.IssueDate;
        card.StartDate = start.Date < card.IssueDate.Date ? card.IssueDate.Date : start.Date;
        return Task.CompletedTask;
    }

    private void StageVisaDialogRemove(Guid documentId)
    {
        if (documentId != Guid.Empty)
            _visaDialogRemovedDocs.Add(documentId);
    }

    private async Task OnVisaDialogCopySelected(InputFileChangeEventArgs args)
    {
        var person = _visaDialog;
        if (person == null || _draft == null || _busy || args.FileCount == 0)
            return;

        var file = args.File;
        if (file == null)
            return;

        _busy = true;
        _actionError = null;
        try
        {
            await using var stream = file.OpenReadStream(MaxCopyUploadMb * 1024L * 1024L);
            using var memory = new System.IO.MemoryStream();
            await stream.CopyToAsync(memory);
            var content = memory.ToArray();
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var validationError = IssueIssuedHeaderComposeService.ValidateDocumentBytes(
                objectSpace, file.Name, content);
            if (!string.IsNullOrEmpty(validationError))
            {
                _actionError = validationError;
                return;
            }

            person.PendingCopyFileName = file.Name;
            person.PendingCopyBytes = content;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveStagedVisaCopyAsync(IssueIssuedVisaPersonCardDraft person, string? fileName, byte[] content)
    {
        if (_draft == null || person.ExistingVisaId is not Guid visaId || visaId == Guid.Empty)
            return;

        _busy = true;
        _actionError = null;
        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var result = IssueIssuedVisaComposeService.AddDocument(
                objectSpace,
                Request!.ApplicationProfileInstanceId,
                visaId,
                fileName ?? "visa-copy.pdf",
                content);
            if (!result.Succeeded)
            {
                _actionError = result.ErrorMessage;
                return;
            }

            ReloadDocuments(person);
            _saveMessage = "Copy saved.";
            WorkspaceActions?.NotifyWorkspaceChanged();
        }
        finally
        {
            _busy = false;
        }

        await Task.CompletedTask;
    }

    private static bool SameVisaPerson(IssueIssuedVisaPersonCardDraft left, IssueIssuedVisaPersonCardDraft right)
    {
        if (left.InvitationItemId != Guid.Empty || right.InvitationItemId != Guid.Empty)
            return left.InvitationItemId == right.InvitationItemId;
        return left.PersonId == right.PersonId && left.ExistingVisaId == right.ExistingVisaId;
    }

    private static IssueIssuedVisaPersonCardDraft CloneVisaPerson(IssueIssuedVisaPersonCardDraft source) =>
        new()
        {
            InvitationId = source.InvitationId,
            InvitationNumber = source.InvitationNumber,
            InvitationIssuedDate = source.InvitationIssuedDate,
            InvitationItemId = source.InvitationItemId,
            PersonId = source.PersonId,
            PersonName = source.PersonName,
            PassportId = source.PassportId,
            PassportNumber = source.PassportNumber,
            Include = source.Include,
            AlreadyIssued = source.AlreadyIssued,
            IsReady = source.IsReady,
            ExistingVisaId = source.ExistingVisaId,
            ExistingVisaNumber = source.ExistingVisaNumber,
            VisaNumber = source.VisaNumber,
            VisaTypeId = source.VisaTypeId,
            VisaCategoryId = source.VisaCategoryId,
            VisaPeriodId = source.VisaPeriodId,
            VisaIssuedPlaceId = source.VisaIssuedPlaceId,
            IssueDate = source.IssueDate,
            StartDate = source.StartDate,
            ExpirationDate = source.ExpirationDate,
            BorderZoneLocation = source.BorderZoneLocation,
            Documents = source.Documents.ToList(),
            PendingCopyFileName = source.PendingCopyFileName,
            PendingCopyBytes = source.PendingCopyBytes,
        };

    private async Task<bool> TrySaveAsync()
    {
        if (_draft?.IsEditMode == true)
        {
            if (!CanSaveVisa)
                return false;
            await SaveAsync();
            return string.IsNullOrWhiteSpace(_actionError) && !IsDirty;
        }

        if (!CanCreate)
            return false;
        await CreateAsync();
        return string.IsNullOrWhiteSpace(_actionError);
    }

