@namespace Visa2026.Blazor.Server.Components
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using System.IO
@using Microsoft.JSInterop
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.AspNetCore.Http
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.ApplicationItemLinkedDocuments
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.RuntimeLogging
@using System.Linq
@using System.Collections.Generic
@implements IAsyncDisposable

<div class="report-package-inline-preview app-item-doc-copies-preview">
    <div class="report-package-inline-preview__header app-item-doc-copies-preview__header">
        <h3 class="app-item-doc-copies-preview__title">@HeaderText</h3>
        <div class="app-item-doc-copies-preview__header-actions">
            @if (!_loading && _pdfDownloadContent != null)
            {
                <DxButton Text="@ActionDownload"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          Click="@DownloadPreviewPdfAsync" />
            }
            @if (ShowImageDownload)
            {
                <DxButton Text="@ActionDownloadImage"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          Enabled="@(!_imageDownloadBusy)"
                          Click="@DownloadPreviewImageAsync" />
            }
            @if (!_loading && ShowBatchSummaryAction)
            {
                <DxButton Text="@ActionBatchSummary"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          Click="@DownloadBatchSummaryAsync" />
            }
            <DxButton Text="@ActionClose"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      Click="@ClosePreviewAsync" />
        </div>
    </div>

    @if (ShowPrintLayout)
    {
        <DocumentCopyPrintLayoutBar Layout="_printLayout"
                                    Disabled="_loading"
                                    UiCultureName="@EffectiveUiCulture"
                                    LayoutChanged="OnPrintLayoutChanged" />
    }

    @if (!string.IsNullOrWhiteSpace(_imageDownloadError))
    {
        <div class="app-item-doc-copies-preview__image-error" role="alert">@_imageDownloadError</div>
    }

    <div class="report-package-inline-preview__body app-item-doc-copies-preview">
        @if (_loading)
        {
            <div class="app-item-doc-copies-preview__state app-item-doc-copies-preview__state--loading" role="status" aria-live="polite">
                <div class="app-item-doc-copies-preview__loading">
                    <span class="app-report-package__preview-busy-label">@_previewLoadingLabel</span>
                    <div class="app-report-package__entry-progress" role="progressbar" aria-busy="true"
                         aria-label="@_previewLoadingLabel">
                        <div class="app-report-package__preview-progress-track">
                            <div class="app-report-package__preview-progress-indeterminate"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="app-item-doc-copies-preview__state app-item-doc-copies-preview__state--error" role="alert">@_error</div>
        }
        else if (_useXfaViewer)
        {
            <div class="app-item-doc-copies-preview__viewer-shell report-package-inline-preview__viewer-shell">
                <div @ref="_xfaHost"
                     class="app-item-doc-copies-preview__xfa-host"
                     data-bs-theme="light"
                     title="@_fileName"></div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_pdfBlobUrl))
        {
            <div class="app-item-doc-copies-preview__viewer-shell report-package-inline-preview__viewer-shell">
                <iframe class="app-item-doc-copies-preview__iframe"
                        src="@_pdfBlobUrl"
                        title="@_fileName"
                        allow="fullscreen"></iframe>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<Guid> ApplicationItemIds { get; set; } = Array.Empty<Guid>();
    [Parameter] public Guid ApplicationProfileInstanceId { get; set; }
    [Parameter] public EventCallback PreviewClosed { get; set; }
    [Parameter] public string UiCultureName { get; set; } = string.Empty;

    [Inject] private ApplicationItemDocumentFileAccess FileAccess { get; set; } = null!;
    [Inject] private IFileDownloader FileDownloader { get; set; } = null!;
    [Inject] private IXafCultureInfoService CultureInfoService { get; set; } = null!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private IApplicationErrorReporter ErrorReporter { get; set; } = null!;

    private string _fileName = string.Empty;
    private string _error = string.Empty;
    private bool _loading;
    private string? _pdfBlobUrl;
    private ElementReference _xfaHost;
    private bool _useXfaViewer;
    private IReadOnlyList<byte[]>? _xfaDocuments;
    private IReadOnlyList<string?>? _xfaPhotoDataUris;
    private readonly List<string> _xfaBlobUrls = new();
    private IJSObjectReference? _xfaJsModule;
    private bool _xfaRenderPending;
    private byte[]? _pdfDownloadContent;
    private string _pdfDownloadFileName = string.Empty;
    private string _pdfDownloadContentType = "application/pdf";
    private string _activeSlotKey = string.Empty;
    private string _printLayoutKey = string.Empty;
    private string _previewHeaderLabel = string.Empty;
    private DocumentCopyPrintLayout _printLayout;
    private string _imageFamilyKey = string.Empty;
    private bool _offerImageDownload;
    private bool _imageDownloadBusy;
    private string _imageDownloadError = string.Empty;
    private ApplicationItemDocumentPackageOptions _packageOptions = ApplicationItemDocumentPackageOptions.CreateDefaults();
    private string _previewLoadingLabel = string.Empty;
    private int _layoutSyncGeneration;

    private string EffectiveUiCulture =>
        VisaUiCultureResolver.Resolve(CultureInfoService, HttpContextAccessor.HttpContext, UiCultureName);

    private string Msg(string key) => VisaUiMessages.Get(key, EffectiveUiCulture);

    private string FormatMsg(string key, params object[] args) =>
        VisaUiMessages.FormatForCulture(EffectiveUiCulture, key, args);

    private string HeaderText =>
        string.IsNullOrWhiteSpace(_fileName)
            ? PreviewTitle
            : $"{PreviewTitle}: {_fileName}";

    private string PreviewTitle => Msg("ApplicationItemDocumentCopies.Preview.Title");
    private string PreviewError => Msg("ApplicationItemDocumentCopies.Preview.Error");
    private string ActionClose => Msg("ApplicationItemDocumentCopies.Action.Close");
    private string ActionDownload => Msg("ApplicationItemDocumentCopies.Action.Download");
    private string ActionDownloadImage => Msg("ApplicationItemDocumentCopies.Action.DownloadImage");
    private string ImageDownloadError => Msg("ApplicationItemDocumentCopies.DownloadImage.Error");
    private string ActionBatchSummary => Msg("ApplicationItemDocumentCopies.Action.BatchSummary");

    private bool ShowImageDownload =>
        !_loading
        && _offerImageDownload
        && _pdfDownloadContent != null
        && !ApplicationItemDocumentCopiesTypeCatalog.IsApplicationFormPreview(_activeSlotKey, _imageFamilyKey);

    private bool ShowBatchSummaryAction =>
        !string.IsNullOrWhiteSpace(_activeSlotKey)
        && ApplicationItemIds.Count >= 2
        && ApplicationItemDocumentBatchSummaryKindMapping.TryFromSlotKey(_activeSlotKey, _packageOptions, out _);

    private bool ShowPrintLayout =>
        DocumentCopyPrintLayout.AppliesTo(_printLayoutKey)
        && !ApplicationItemDocumentCopiesTypeCatalog.IsApplicationFormPreview(_activeSlotKey, _imageFamilyKey);

    public async Task OpenAsync(DocumentCopiesInlinePreviewRequest request)
    {
        if (request == null || string.IsNullOrWhiteSpace(request.SlotKey))
            return;

        _activeSlotKey = request.SlotKey;
        _packageOptions = request.PackageOptions ?? ApplicationItemDocumentPackageOptions.CreateDefaults();
        _previewLoadingLabel = FormatMsg("ApplicationReportPackage.Preview.Downloading", request.DisplayName);
        _imageDownloadError = string.Empty;
        _imageDownloadBusy = false;
        var familyKey = request.FamilyKey;
        if (string.IsNullOrWhiteSpace(familyKey))
            ApplicationItemDocumentCopiesTypeCatalog.TryParseFamilyPreviewKey(request.SlotKey, out familyKey);
        _imageFamilyKey = familyKey ?? string.Empty;
        _offerImageDownload = !ApplicationItemDocumentCopiesTypeCatalog.IsApplicationFormPreview(request.SlotKey, _imageFamilyKey);
        _previewHeaderLabel = request.DisplayName;

        if (ApplicationItemDocumentCopiesTypeCatalog.IsApplicationFormPreview(request.SlotKey, request.FamilyKey))
        {
            _printLayoutKey = string.Empty;
            await OpenApplicationFormAsync(request.DisplayName);
            return;
        }

        var layoutKey = !string.IsNullOrWhiteSpace(_imageFamilyKey)
            ? _imageFamilyKey + "."
            : request.SlotKey;
        if (!string.Equals(_printLayoutKey, layoutKey, StringComparison.Ordinal))
        {
            _printLayoutKey = layoutKey;
            _printLayout = DocumentCopyPrintLayout.DefaultFor(layoutKey);
        }

        await LoadCurrentPdfAsync();
    }

    private async Task OnPrintLayoutChanged(DocumentCopyPrintLayout layout)
    {
        _printLayout = layout;
        await LoadCurrentPdfAsync();
    }

    private async Task LoadCurrentPdfAsync()
    {
        await OpenPdfAsync(
            _previewHeaderLabel,
            () =>
            {
                if (!string.IsNullOrWhiteSpace(_imageFamilyKey))
                {
                    if (!FileAccess.TryGetMergedFamilyPdf(
                            ApplicationItemIds,
                            _imageFamilyKey,
                            out var familyResult,
                            ApplicationProfileInstanceId,
                            _printLayout)
                        || familyResult == null)
                        return (null, null, PreviewError);

                    return (familyResult.Content, familyResult.FileName, null);
                }

                if (!FileAccess.TryGetMergedSlotPdf(
                        ApplicationItemIds,
                        _activeSlotKey,
                        out var result,
                        ApplicationProfileInstanceId,
                        _printLayout)
                    || result == null)
                    return (null, null, PreviewError);

                return (result.Content, result.FileName, null);
            });
    }

    public async Task CloseAsync()
    {
        await ResetStateAsync();
        if (PreviewClosed.HasDelegate)
            await PreviewClosed.InvokeAsync();
    }

    private async Task OpenApplicationFormAsync(string headerLabel)
    {
        _pdfDownloadContent = null;
        _pdfDownloadFileName = string.Empty;
        _pdfDownloadContentType = "application/pdf";
        _fileName = headerLabel;
        _previewLoadingLabel = FormatMsg("ApplicationReportPackage.Preview.Downloading", headerLabel);
        _error = string.Empty;
        _loading = true;

        await ClearXfaViewerAsync();
        await RevokePdfBlobUrlAsync();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (!FileAccess.TryGetFilledApplicationFormPreview(
                    ApplicationItemIds,
                    out var preview,
                    out var download,
                    out var errorKey,
                    ApplicationProfileInstanceId)
                || preview == null
                || preview.Content.Length == 0)
            {
                SetPreviewError(
                    !string.IsNullOrWhiteSpace(errorKey) ? Msg(errorKey) : PreviewError);
                return;
            }

            _fileName = string.IsNullOrWhiteSpace(preview.FileName) ? headerLabel : preview.FileName;
            _pdfDownloadContent = download?.Content ?? preview.Content;
            _pdfDownloadFileName = download?.FileName ?? preview.FileName;
            _pdfDownloadContentType = download?.ContentType ?? "application/pdf";
            _xfaDocuments = preview.XfaDocuments is { Count: > 0 }
                ? preview.XfaDocuments
                : new[] { preview.Content };
            _xfaPhotoDataUris = preview.PhotoDataUris;
            _useXfaViewer = true;
            _xfaRenderPending = true;
        }
        catch (Exception ex)
        {
            SetPreviewError(PreviewError, ex);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
            await ScheduleViewerLayoutSyncAsync();
        }
    }

    private async Task OpenPdfAsync(
        string headerLabel,
        Func<(byte[]? Content, string? FileName, string? Error)> loadPdf)
    {
        _pdfDownloadContent = null;
        _pdfDownloadFileName = string.Empty;
        _fileName = headerLabel;
        _previewLoadingLabel = FormatMsg("ApplicationReportPackage.Preview.Downloading", headerLabel);
        _error = string.Empty;
        _loading = true;

        await ClearXfaViewerAsync();
        await RevokePdfBlobUrlAsync();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var (content, fileName, error) = loadPdf();
            if (!string.IsNullOrWhiteSpace(error))
            {
                SetPreviewError(error);
                return;
            }

            if (content == null || content.Length == 0)
            {
                SetPreviewError(PreviewError);
                return;
            }

            _fileName = string.IsNullOrWhiteSpace(fileName) ? headerLabel : fileName;
            _pdfDownloadContent = content;
            _pdfDownloadFileName = string.IsNullOrWhiteSpace(fileName) ? "document-copies.pdf" : fileName;
            _pdfDownloadContentType = "application/pdf";
            _pdfBlobUrl = await JS.InvokeAsync<string>(
                "visaDocumentCopyPreview.createPdfBlobUrl",
                content,
                _printLayout.UsesDocumentSize);
        }
        catch (Exception ex)
        {
            SetPreviewError(PreviewError, ex);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
            await ScheduleViewerLayoutSyncAsync();
        }
    }

    private void SetPreviewError(string message, Exception? exception = null)
    {
        _error = message;
        ErrorReporter.ReportDocumentCopiesError(
            message,
            ApplicationRuntimeLogCategories.DocumentCopiesPreviewDialog,
            exception);
    }

    private async Task ClosePreviewAsync() => await CloseAsync();

    private async Task DownloadPreviewPdfAsync()
    {
        if (_pdfDownloadContent == null || _pdfDownloadContent.Length == 0)
            return;

        using var stream = new MemoryStream(_pdfDownloadContent, writable: false);
        await FileDownloader.DownloadAsync(
            string.IsNullOrWhiteSpace(_pdfDownloadFileName) ? "document-copies.pdf" : _pdfDownloadFileName,
            stream,
            _pdfDownloadContentType);
    }

    private async Task DownloadPreviewImageAsync()
    {
        if (_imageDownloadBusy || !_offerImageDownload)
            return;

        _imageDownloadBusy = true;
        _imageDownloadError = string.Empty;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (!FileAccess.TryGetImageDownload(
                    ApplicationItemIds,
                    _activeSlotKey,
                    _imageFamilyKey,
                    out var result,
                    ApplicationProfileInstanceId)
                || result == null
                || result.Content == null
                || result.Content.Length == 0)
            {
                _imageDownloadError = ImageDownloadError;
                return;
            }

            using var stream = new MemoryStream(result.Content, writable: false);
            await FileDownloader.DownloadAsync(result.FileName, stream, result.ContentType);
        }
        catch (Exception ex)
        {
            _imageDownloadError = ImageDownloadError;
            ErrorReporter.ReportDocumentCopiesError(
                ImageDownloadError,
                ApplicationRuntimeLogCategories.DocumentCopiesPreviewDialog,
                ex);
        }
        finally
        {
            _imageDownloadBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadBatchSummaryAsync()
    {
        if (!ApplicationItemDocumentBatchSummaryKindMapping.TryFromSlotKey(_activeSlotKey, _packageOptions, out var kind)
            || !FileAccess.TryGetBatchSummaryPdf(
                ApplicationItemIds,
                kind,
                _packageOptions,
                out var result,
                ApplicationProfileInstanceId)
            || result == null)
        {
            SetPreviewError(PreviewError);
            await InvokeAsync(StateHasChanged);
            return;
        }

        using var stream = new MemoryStream(result.Content, writable: false);
        await FileDownloader.DownloadAsync(result.FileName, stream, result.ContentType);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_xfaRenderPending || !_useXfaViewer || _loading || _xfaDocuments == null || _xfaDocuments.Count == 0)
            return;

        _xfaRenderPending = false;
        try
        {
            await RenderXfaDocumentsAsync(_xfaDocuments, _xfaPhotoDataUris);
            await ScheduleViewerLayoutSyncAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            SetPreviewError(PreviewError, ex);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RenderXfaDocumentsAsync(IReadOnlyList<byte[]> documents, IReadOnlyList<string?>? photoDataUris)
    {
        await RevokeXfaBlobUrlsAsync();
        var previewDocs = new List<object>();
        for (var i = 0; i < documents.Count; i++)
        {
            var pdf = documents[i];
            if (pdf == null || pdf.Length == 0)
                continue;

            var url = await JS.InvokeAsync<string>("visaDocumentCopyPreview.createPdfBlobUrl", pdf);
            if (string.IsNullOrWhiteSpace(url))
                continue;

            _xfaBlobUrls.Add(url);
            previewDocs.Add(new XfaPreviewJsDocument
            {
                Url = url,
                PhotoDataUri = photoDataUris != null && i < photoDataUris.Count ? photoDataUris[i] : null
            });
        }

        if (previewDocs.Count == 0)
            throw new InvalidOperationException("Application form preview has no PDF bytes.");

        try
        {
            _xfaJsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/lib/pdfjs/visa-xfa-preview.js?v=xfaphoto2");
        }
        catch (JSDisconnectedException)
        {
            throw;
        }
        catch (JSException)
        {
            _xfaJsModule = null;
        }

        if (_xfaJsModule != null)
        {
            await _xfaJsModule.InvokeVoidAsync("renderAll", _xfaHost, previewDocs);
            return;
        }

        await JS.InvokeVoidAsync("visaXfaPreview.renderAll", _xfaHost, previewDocs);
    }

    private sealed class XfaPreviewJsDocument
    {
        public string Url { get; set; } = string.Empty;
        public string? PhotoDataUri { get; set; }
    }

    private async Task ScheduleViewerLayoutSyncAsync()
    {
        if (string.IsNullOrWhiteSpace(_pdfBlobUrl) && !_useXfaViewer)
            return;

        var generation = ++_layoutSyncGeneration;
        await Task.Delay(150);
        if (generation != _layoutSyncGeneration || (string.IsNullOrWhiteSpace(_pdfBlobUrl) && !_useXfaViewer))
            return;

        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.syncInlinePreviewHeight");
        }
        catch (JSDisconnectedException) { }
    }

    private async Task ResetStateAsync()
    {
        _layoutSyncGeneration++;
        _fileName = string.Empty;
        _error = string.Empty;
        _loading = false;
        _activeSlotKey = string.Empty;
        _printLayoutKey = string.Empty;
        _previewHeaderLabel = string.Empty;
        _printLayout = default;
        _previewLoadingLabel = string.Empty;
        _pdfDownloadContent = null;
        _pdfDownloadFileName = string.Empty;
        _pdfDownloadContentType = "application/pdf";
        _imageFamilyKey = string.Empty;
        _offerImageDownload = false;
        _imageDownloadBusy = false;
        _imageDownloadError = string.Empty;
        _packageOptions = ApplicationItemDocumentPackageOptions.CreateDefaults();
        await ClearXfaViewerAsync();
        await RevokePdfBlobUrlAsync();
    }

    private async Task ClearXfaViewerAsync()
    {
        _xfaRenderPending = false;
        _xfaDocuments = null;
        _xfaPhotoDataUris = null;
        if (_useXfaViewer)
        {
            try
            {
                if (_xfaJsModule != null)
                    await _xfaJsModule.InvokeVoidAsync("clear", _xfaHost);
                else
                    await JS.InvokeVoidAsync("visaXfaPreview.clear", _xfaHost);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        await RevokeXfaBlobUrlsAsync();
        _useXfaViewer = false;
    }

    private async Task RevokeXfaBlobUrlsAsync()
    {
        foreach (var url in _xfaBlobUrls)
        {
            try
            {
                await JS.InvokeVoidAsync("visaDocumentCopyPreview.revokePdfBlobUrl", url);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _xfaBlobUrls.Clear();
    }

    private async Task RevokePdfBlobUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_pdfBlobUrl))
            return;

        try
        {
            await JS.InvokeVoidAsync("visaDocumentCopyPreview.revokePdfBlobUrl", _pdfBlobUrl);
        }
        catch (JSDisconnectedException) { }

        _pdfBlobUrl = null;
    }

    public async ValueTask DisposeAsync()
    {
        await ClearXfaViewerAsync();
        await RevokePdfBlobUrlAsync();
        if (_xfaJsModule != null)
        {
            try
            {
                await _xfaJsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }

            _xfaJsModule = null;
        }
    }
}
