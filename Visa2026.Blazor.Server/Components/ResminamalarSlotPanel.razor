@namespace Visa2026.Blazor.Server.Components
@using DevExpress.ExpressApp
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.WordReports

<div class="resminamalar-slot-panel @(_previewActive ? "resminamalar-slot-panel--preview" : string.Empty)">
    @if (!_previewActive)
    {
        <div class="resminamalar-slot-panel__header visa-preview-drawer__header">
            <span class="visa-preview-drawer__title templates-brand-title">
                <span class="templates-brand-title__icon" aria-hidden="true"></span>
                @Title
            </span>
            <div class="visa-preview-drawer__header-actions">
                <button class="visa-preview-drawer__btn visa-preview-drawer__btn--close"
                        type="button"
                        title="@CloseLabel"
                        @onclick="ClosePanelAsync">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <div class="resminamalar-slot-panel__body">
        @if (!_previewActive)
        {
            <div class="resminamalar-slot-panel__catalog">
                @if (!string.IsNullOrWhiteSpace(_emptyMessage))
                {
                    <div class="app-item-doc-copies__empty" role="status">
                        <p>@_emptyMessage</p>
                    </div>
                }
                else if (_applicationId != Guid.Empty)
                {
                    <ApplicationReportPackageComponent ApplicationProfileInstanceId="_applicationId"
                                                     PackageScope="_packageScope"
                                                     ApplicationItemIds="_applicationItemIds"
                                                     ApplicationNumber="@_applicationNumber"
                                                     CatalogEntries="_catalogEntries"
                                                     RecycleBinEntries="_recycleBinEntries"
                                                     SharedEntries="_sharedEntries"
                                                     ShowRecycleBin="_showRecycleBin"
                                                     UiCultureName="_uiCultureName"
                                                     FocusEntryKey="_focusEntryKey"
                                                     UseInlinePreview="true"
                                                     RefreshRequested="_refreshRequested"
                                                     OnInlinePreviewRequested="HandleInlinePreviewAsync" />
                }
            </div>
        }
        else
        {
            <ReportPackageInlinePreview @ref="_inlinePreview"
                                        UiCultureName="_uiCultureName"
                                        PreviewClosed="OnPreviewClosedAsync" />
        }
    </div>
</div>

@code {
    [Parameter] public ResminamalarSlotRequest? Request { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    [Inject] private ApplicationWordReportPackageCatalogService CatalogService { get; set; } = null!;
    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService SlotService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private Guid _applicationId;
    private WordReportPackageScope _packageScope = WordReportPackageScope.ApplicationProfileInstance;
    private IReadOnlyList<Guid> _applicationItemIds = Array.Empty<Guid>();
    private string _applicationNumber = string.Empty;
    private IReadOnlyList<ApplicationWordReportPackageCatalogEntry> _catalogEntries =
        Array.Empty<ApplicationWordReportPackageCatalogEntry>();
    private IReadOnlyList<ApplicationWordReportPackageCatalogEntry> _recycleBinEntries =
        Array.Empty<ApplicationWordReportPackageCatalogEntry>();
    private IReadOnlyList<ApplicationWordReportPackageCatalogEntry> _sharedEntries =
        Array.Empty<ApplicationWordReportPackageCatalogEntry>();
    private bool _showRecycleBin;
    private string _emptyMessage = string.Empty;
    private string _uiCultureName = string.Empty;
    private string? _focusEntryKey;
    private bool _previewActive;
    private bool _previewOnlyMode;
    private ReportPackagePreviewRequest? _pendingPreviewRequest;
    private ReportPackageInlinePreview? _inlinePreview;
    private EventCallback _refreshRequested;
    private string? _boundOccupantKey;

    private string Title => VisaUiMessages.Get("ApplicationReportPackage.Title", _uiCultureName);
    private string CloseLabel => VisaUiMessages.Get("ApplicationItemDocumentCopies.Action.Close", _uiCultureName);

    protected override void OnInitialized()
    {
        _refreshRequested = EventCallback.Factory.Create(this, ReloadCatalogAsync);
        _uiCultureName = VisaUiCultureResolver.Resolve();
    }

    protected override void OnParametersSet()
    {
        if (Request == null || Request.ApplicationProfileInstanceId == Guid.Empty)
        {
            _applicationId = Guid.Empty;
            _catalogEntries = Array.Empty<ApplicationWordReportPackageCatalogEntry>();
            _recycleBinEntries = Array.Empty<ApplicationWordReportPackageCatalogEntry>();
            _sharedEntries = Array.Empty<ApplicationWordReportPackageCatalogEntry>();
            _showRecycleBin = false;
            _emptyMessage = string.Empty;
            _boundOccupantKey = null;
            _previewActive = false;
            _previewOnlyMode = false;
            _pendingPreviewRequest = null;
            return;
        }

        var occupantKey = VisaPreviewSlotOccupantKeys.ForResminamalar(Request);
        var stateKey = Request.OpenPreviewOnly && !string.IsNullOrWhiteSpace(Request.FocusEntryKey)
            ? $"{occupantKey}|preview:{Request.FocusEntryKey.Trim()}"
            : occupantKey;

        if (!string.Equals(_boundOccupantKey, stateKey, StringComparison.Ordinal))
        {
            _boundOccupantKey = stateKey;
            _previewOnlyMode = Request.OpenPreviewOnly;
            if (_previewOnlyMode)
            {
                _previewActive = true;
                _pendingPreviewRequest = BuildPreviewRequest(Request);
            }
            else
            {
                _previewActive = false;
                _pendingPreviewRequest = null;
            }
        }

        _applicationId = Request.ApplicationProfileInstanceId;
        _packageScope = Request.Scope;
        _applicationItemIds = Request.ApplicationItemIds ?? Array.Empty<Guid>();
        _emptyMessage = Request.EmptyCatalogMessage ?? string.Empty;
        _focusEntryKey = string.IsNullOrWhiteSpace(Request.FocusEntryKey)
            ? null
            : Request.FocusEntryKey.Trim();

        if (!_previewOnlyMode && string.IsNullOrWhiteSpace(_emptyMessage))
            ReloadCatalog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPreviewRequest != null)
        {
            var request = _pendingPreviewRequest;
            _pendingPreviewRequest = null;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (_inlinePreview != null)
                await _inlinePreview.OpenAsync(request);
            return;
        }

        if (_previewActive || _applicationId == Guid.Empty)
            return;

        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.scheduleSlotThemeSync");
        }
        catch (JSDisconnectedException) { }
    }

    private void ReloadCatalog()
    {
        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var application = objectSpace.GetObjectByKey<ApplicationProfileInstance>(_applicationId);
        if (application == null)
        {
            _catalogEntries = Array.Empty<ApplicationWordReportPackageCatalogEntry>();
            _recycleBinEntries = Array.Empty<ApplicationWordReportPackageCatalogEntry>();
            _sharedEntries = Array.Empty<ApplicationWordReportPackageCatalogEntry>();
            _showRecycleBin = false;
            _applicationNumber = string.Empty;
            return;
        }

        var context = _packageScope == WordReportPackageScope.RosterPerson
            ? WordReportGenerationContext.ForApplicationItems(_applicationItemIds.ToList())
            : WordReportGenerationContext.ForApplication();

        var catalog = CatalogService.Build(objectSpace, application, context);
        _catalogEntries = catalog.Entries;
        _recycleBinEntries = catalog.RecycleBinEntries;
        _sharedEntries = catalog.SharedEntries;
        _showRecycleBin = catalog.HasProfileNestedCatalog;
        _applicationNumber = application.FullApplicationNumber ?? string.Empty;
        if (catalog.HasProfileNestedCatalog || catalog.RecycleBinEntries.Count > 0)
            _emptyMessage = string.Empty;
    }

    private Task ReloadCatalogAsync()
    {
        if (string.IsNullOrWhiteSpace(_emptyMessage))
            ReloadCatalog();
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleInlinePreviewAsync(ReportPackagePreviewRequest request)
    {
        _previewActive = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        if (_inlinePreview != null)
            await _inlinePreview.OpenAsync(request);
    }

    private async Task OnPreviewClosedAsync()
    {
        if (_previewOnlyMode)
        {
            _previewOnlyMode = false;
            _previewActive = false;
            _focusEntryKey = null;
            await SlotService.CloseAsync();
            return;
        }

        _previewActive = false;
        _focusEntryKey = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePanelAsync()
    {
        _previewOnlyMode = false;
        _previewActive = false;
        _focusEntryKey = null;
        _pendingPreviewRequest = null;
        if (CloseRequested.HasDelegate)
            await CloseRequested.InvokeAsync();
        else
            await SlotService.CloseAsync();
    }

    private static ReportPackagePreviewRequest? BuildPreviewRequest(ResminamalarSlotRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.FocusEntryKey))
            return null;

        return new ReportPackagePreviewRequest
        {
            ApplicationProfileInstanceId = request.ApplicationProfileInstanceId,
            EntryKey = request.FocusEntryKey.Trim(),
            DisplayName = string.IsNullOrWhiteSpace(request.FocusDisplayName)
                ? request.FocusEntryKey.Trim()
                : request.FocusDisplayName.Trim(),
            ApplicationItemIds = request.ApplicationItemIds,
        };
    }
}
