    <script>
        (function () {
            window.visaDocumentCopyPreview = window.visaDocumentCopyPreview || {};

            window.visaDocumentCopyPreview.createPdfBlobUrl = function (byteArray) {
                var bytes = byteArray instanceof Uint8Array ? byteArray : new Uint8Array(byteArray);
                var blob = new Blob([bytes], { type: "application/pdf" });
                var baseUrl = URL.createObjectURL(blob);
                return baseUrl + "#view=FitH";
            };

            window.visaDocumentCopyPreview.revokePdfBlobUrl = function (url) {
                if (!url) {
                    return;
                }

                var baseUrl = url.split("#")[0];
                URL.revokeObjectURL(baseUrl);
            };

            window.visaDocumentCopyPreview.syncViewerHeight = function () {
                var popup = document.querySelector(".app-item-doc-copies-preview-popup");
                if (!popup) {
                    return;
                }

                var content = popup.querySelector(".dxbl-popup-content");
                var header = popup.querySelector(".dxbl-popup-header");
                var shell = popup.querySelector(".app-item-doc-copies-preview__viewer-shell");
                var iframe = popup.querySelector(".app-item-doc-copies-preview__iframe");
                if (!content || !shell || !iframe) {
                    return;
                }

                var totalHeight = content.clientHeight;
                if (totalHeight <= 0) {
                    return;
                }

                var reserved = (header ? header.getBoundingClientRect().height : 0) + 8;
                var viewerHeight = Math.max(280, Math.floor(totalHeight - reserved));

                shell.style.width = "100%";
                shell.style.height = viewerHeight + "px";
                shell.style.minHeight = viewerHeight + "px";
                shell.style.maxHeight = viewerHeight + "px";
                iframe.style.width = "100%";
                iframe.style.height = viewerHeight + "px";
                iframe.style.border = "0";
            };
        })();
    </script>

    <script>
        (function () {
            // Global file preview drawer — triggered from anywhere via window.visaPreviewDrawer.open(sourceType, objectId, event?)
            window.visaPreviewDrawer = window.visaPreviewDrawer || {};

            window.visaPersonDossier = window.visaPersonDossier || {};
            window.visaPersonDossier._hostRef = null;
            window.visaPersonDossier.registerHost = function (hostRef) {
                window.visaPersonDossier._hostRef = hostRef;
            };
            window.visaPersonDossier.unregisterHost = function () {
                window.visaPersonDossier._hostRef = null;
            };
            window.visaPersonDossier.open = function (personId) {
                var ref = window.visaPersonDossier._hostRef;
                if (ref) {
                    ref.invokeMethodAsync("OpenFromJs", personId || "");
                }
            };

            window.visaPreviewDrawer._hostRef = null;

            window.visaPreviewDrawer.registerHost = function (hostRef) {
                window.visaPreviewDrawer._hostRef = hostRef;
            };

            window.visaPreviewDrawerOpenFile = function (sourceType, objectId, ownerViewId) {
                window.visaPreviewDrawer.open(sourceType, objectId, null, ownerViewId);
            };

            window.visaPreviewDrawer.unregisterHost = function () {
                window.visaPreviewDrawer._hostRef = null;
            };

            window.visaPreviewDrawer.open = function (sourceType, objectId, event, ownerViewId) {
                if (event && typeof event.preventDefault === 'function') {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();
                } else if (typeof event === 'string' && !ownerViewId) {
                    ownerViewId = event;
                }
                var ref = window.visaPreviewDrawer._hostRef;
                if (ref) {
                    ref.invokeMethodAsync("OpenFileFromJsAsync", sourceType, objectId, ownerViewId || "");
                }
            };

            window.visaPreviewDrawer.close = function () {
                var ref = window.visaPreviewDrawer._hostRef;
                if (ref) {
                    ref.invokeMethodAsync("CloseFromJsAsync");
                }
            };

            window.visaPreviewDrawer.openResminamalar = function (applicationId, scope, itemIdsJson, event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();
                }
                var ref = window.visaPreviewDrawer._hostRef;
                if (ref) {
                    ref.invokeMethodAsync(
                        "OpenResminamalarFromJsAsync",
                        applicationId,
                        scope || "Application",
                        itemIdsJson || "[]");
                }
            };

            window.visaPreviewDrawer.openProgressLetters = function (applicationId, focusProgressId, event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();
                }
                var ref = window.visaPreviewDrawer._hostRef;
                if (ref) {
                    ref.invokeMethodAsync(
                        "OpenProgressLettersFromJsAsync",
                        applicationId || "",
                        focusProgressId || "");
                }
            };

            window.visaPreviewDrawer.openPersonDossier = function (personId, event) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
