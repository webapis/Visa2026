                for (var i = 0; i < selectors.length; i++) {
                    var candidate = document.querySelector(selectors[i]);
                    if (candidate && getComputedStyle(candidate).getPropertyValue('--dxbl-text-color').trim()) {
                        return candidate;
                    }
                }
                return document.querySelector('app .dxbl-application')
                    || document.querySelector('app')
                    || document.body;
            };

            window.visaPreviewDrawer.clearSlotThemeInline = function (slot) {
                (window.visaPreviewDrawer._themeVarNames || []).forEach(function (name) {
                    slot.style.removeProperty(name);
                });
            };

            window.visaPreviewDrawer.copyThemeClasses = function (slot, themeRoot) {
                Array.from(slot.classList).forEach(function (cls) {
                    if (cls.indexOf('dxbl-theme-') === 0 || cls.indexOf('dxbl-mode-') === 0) {
                        slot.classList.remove(cls);
                    }
                });

                slot.classList.add('dxbl-application');

                function addThemeClasses(el) {
                    if (!el || !el.classList) {
                        return;
                    }
                    Array.from(el.classList).forEach(function (cls) {
                        if (cls.indexOf('dxbl-theme-') === 0 || cls.indexOf('dxbl-mode-') === 0) {
                            slot.classList.add(cls);
                        }
                    });
                }

                addThemeClasses(themeRoot);
                addThemeClasses(document.querySelector('app'));
                addThemeClasses(document.body);
                addThemeClasses(document.documentElement);
            };

            window.visaPreviewDrawer.syncSlotTheme = function () {
                var slot = document.getElementById('visa-preview-slot');
                if (!slot) {
                    return false;
                }

                var themeRoot = window.visaPreviewDrawer.resolveThemeRoot();
                if (!themeRoot) {
                    return false;
                }

                window.visaPreviewDrawer.clearSlotThemeInline(slot);

                var sources = [themeRoot, document.body, document.documentElement];
                var seen = {};
                var hasTheme = false;
                sources.forEach(function (source) {
                    if (!source || seen[source]) {
                        return;
                    }
                    seen[source] = true;
                    var sourceStyles = getComputedStyle(source);
                    window.visaPreviewDrawer._themeVarNames.forEach(function (name) {
                        var value = sourceStyles.getPropertyValue(name);
                        if (value && value.trim()) {
                            slot.style.setProperty(name, value.trim());
                            if (name === '--dxbl-text-color'
                                || name === '--dxbl-body-bg'
                                || name === '--bs-body-bg') {
                                hasTheme = true;
                            }
                        }
                    });
                });

                var themeAttr = themeRoot.getAttribute('data-bs-theme')
                    || document.body.getAttribute('data-bs-theme')
                    || document.documentElement.getAttribute('data-bs-theme');
                if (themeAttr) {
                    slot.setAttribute('data-bs-theme', themeAttr);
                } else {
                    slot.removeAttribute('data-bs-theme');
                }

                window.visaPreviewDrawer.copyThemeClasses(slot, themeRoot);
                return hasTheme;
            };

            window.visaPreviewDrawer.scheduleSlotThemeSync = function () {
                if (!window.visaPreviewDrawer.isSlotOpen()) {
                    return;
                }
                window.requestAnimationFrame(function () {
                    var synced = window.visaPreviewDrawer.syncSlotTheme();
                    if (synced) {
                        window.visaPreviewDrawer._themeSyncAttempts = 0;
                        return;
                    }

                    var attempts = window.visaPreviewDrawer._themeSyncAttempts || 0;
                    if (attempts >= 15) {
                        return;
                    }

                    window.visaPreviewDrawer._themeSyncAttempts = attempts + 1;
                    window.setTimeout(function () {
                        window.visaPreviewDrawer.scheduleSlotThemeSync();
                    }, 120);
                });
            };

            window.visaPreviewDrawer.ensureThemeWatcher = function () {
                if (window.visaPreviewDrawer._themeWatcherAttached) {
                    return;
                }
                window.visaPreviewDrawer._themeWatcherAttached = true;

                var onThemeMutation = function () {
                    window.visaPreviewDrawer.scheduleSlotThemeSync();
                };

                var attrObserver = new MutationObserver(onThemeMutation);
                var watchAttrs = { attributes: true, attributeFilter: ['class', 'data-bs-theme', 'data-theme', 'style'] };

                attrObserver.observe(document.documentElement, watchAttrs);
                attrObserver.observe(document.body, watchAttrs);

                var attachAppObserver = function () {
                    var app = document.querySelector('app');
                    if (!app) {
                        return false;
                    }
                    attrObserver.observe(app, {
                        attributes: true,
                        subtree: true,
                        attributeFilter: ['class', 'data-bs-theme', 'data-theme', 'style']
                    });
                    return true;
                };

                if (!attachAppObserver()) {
                    var appWait = window.setInterval(function () {
                        if (attachAppObserver()) {
                            window.clearInterval(appWait);
                        }
                    }, 400);
                }

                var headObserver = new MutationObserver(onThemeMutation);
                headObserver.observe(document.head, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['href', 'rel', 'media']
                });
            };

            window.visaPreviewDrawer.ensureThemeWatcher();
            window.visaPreviewDrawer.ensureSlotResize();
        })();
    </script>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
