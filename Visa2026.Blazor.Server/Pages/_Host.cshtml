            }
            var src = "/lib/pdfjs/visa-xfa-preview.js?v=xfaphoto2";
            window.visaXfaPreview = {
                renderAll: async function (container, documents) {
                    var mod = await import(src);
                    return mod.renderAll(container, documents);
                },
                clear: async function (container) {
                    var mod = await import(src);
                    return mod.clear(container);
                }
            };
        })();
    </script>

