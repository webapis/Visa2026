    <script>
        // Login-only chrome: build version (bottom) and usage-license banner (top).
        // Blazor navigates via history.pushState/replaceState, so popstate alone misses post-login URL changes.
        (function () {
            function isLoginRoute() {
                var path = window.location && window.location.pathname ? window.location.pathname : '';
                return path.toLowerCase().indexOf('/loginpage') === 0;
            }
            function updateVisibility() {
                var onLogin = isLoginRoute();
                var versionEl = document.getElementById('app-version-badge');
                if (versionEl) versionEl.hidden = !onLogin;
                var licenseEl = document.getElementById('usage-license-banner');
                if (licenseEl) licenseEl.hidden = !onLogin;
            }
            function hookHistory(methodName) {
                var original = history[methodName];
                if (typeof original !== 'function') return;
                history[methodName] = function () {
                    var result = original.apply(this, arguments);
                    updateVisibility();
                    return result;
                };
            }
            updateVisibility();
            window.addEventListener('popstate', updateVisibility);
            hookHistory('pushState');
            hookHistory('replaceState');
        })();
    </script>

