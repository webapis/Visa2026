@using Microsoft.JSInterop
@using Visa2026.Module.Localization
@using Visa2026.Module.Services

<div class="cw-loc-ms" data-loc-value="@FormatCurrent()">
    <div class="cw-loc-ms__row">
        <div class="cw-loc-ms__field" @onfocusin="OnFocusIn" @onfocusout="OnFocusOut">
            <div class="cw-loc-ms__box" @onclick="FocusInput">
                @foreach (var chip in VisibleChips)
                {
                    var chipItem = chip;
                    <span class="cw-loc-ms__chip" title="@chipItem.Label">
                        @if (AllowCatalogEdit)
                        {
                            <button type="button"
                                    class="cw-loc-ms__chip-edit-btn"
                                    disabled="@(!Enabled || ReadOnly)"
                                    aria-label="@($"Edit {chipItem.Label}")"
                                    @onmousedown:preventDefault="true"
                                    @onclick="() => OpenEditDialogAsync(chipItem)"
                                    @onclick:stopPropagation="true">
                                <span class="cw-loc-ms__chip-lbl">@chipItem.Label</span>
                                <svg class="cw-loc-ms__pen" width="11" height="11" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                </svg>
                            </button>
                        }
                        else
                        {
                            <span class="cw-loc-ms__chip-lbl">@chipItem.Label</span>
                        }
                        @if (Enabled && !ReadOnly)
                        {
                            <button type="button"
                                    class="cw-loc-ms__chip-x"
                                    tabindex="-1"
                                    title="@("Remove " + chipItem.Label)"
                                    aria-label="@("Remove " + chipItem.Label)"
                                    @onmousedown:preventDefault="true"
                                    @onclick="() => RemoveChipAsync(chipItem)"
                                    @onclick:stopPropagation="true">×</button>
                        }
                    </span>
                }
                @if (ShowMoreChip)
                {
                    <span class="cw-loc-ms__chip cw-loc-ms__chip--more"
                          @onmousedown:preventDefault="true"
                          @onclick="ExpandChips"
                          @onclick:stopPropagation="true">+@(_chips.Count - CaseLocationAutocomplete.LimitTags)</span>
                }
                <input id="@_inputId"
                       class="cw-loc-ms__input"
                       type="text"
                       maxlength="@CaseLocationAutocomplete.MaxLength"
                       disabled="@(!Enabled || ReadOnly)"
                       readonly="@ReadOnly"
                       placeholder="@(_chips.Count == 0 ? Placeholder : string.Empty)"
                       role="combobox"
                       aria-expanded="@(_listOpen ? "true" : "false")"
                       aria-controls="@_listId"
                       aria-autocomplete="list"
                       aria-multiselectable="true"
                       aria-activedescendant="@(_activeIndex >= 0 && _activeIndex < _hits.Count ? OptionId(_activeIndex) : null)"
                       aria-describedby="@_statusId"
                       value="@_draft"
                       @ref="_inputRef"
                       @oninput="OnInput"
                       @onkeydown="OnKeyDown"
                       @onkeydown:preventDefault="@_preventEnter" />
                @if (Enabled && !ReadOnly && _chips.Count > 0)
                {
                    <button type="button"
                            class="cw-loc-ms__clear"
                            title="Clear all"
                            tabindex="-1"
                            @onmousedown:preventDefault="true"
                            @onclick="ClearAllAsync"
                            @onclick:stopPropagation="true">×</button>
                }
            </div>
            @if (_listOpen && _hits.Count > 0)
            {
                <ul id="@_listId" class="cw-loc-ms__list cw-addr-ac__list" role="listbox" aria-multiselectable="true">
                    @for (var i = 0; i < _hits.Count; i++)
                    {
                        var index = i;
                        var item = _hits[index];
                        <li id="@OptionId(index)"
                            class="@(_activeIndex == index ? "cw-addr-ac__option is-active" : "cw-addr-ac__option")"
                            role="option"
                            aria-selected="@(_activeIndex == index)"
                            @onmousedown:preventDefault="true"
                            @onmousedown="() => PickAsync(item.Text)">
                            <span class="cw-addr-ac__option-main">@Highlight(item.Text)</span>
                            @if (AllowCatalogEdit)
                            {
                                <span class="cw-addr-ac__option-meta">@(item.UseCount <= 0 ? "New" : $"Used {item.UseCount}×")</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
        @if (AllowCatalogEdit && Enabled && !ReadOnly && !_suggestionsFailed)
        {
            <button type="button"
                    class="cw-loc-ms__add"
                    title="Add new"
                    aria-label="@($"Add new {FieldName}")"
                    @onclick="OpenAddDialogAsync">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </svg>
            </button>
        }
    </div>
    <div id="@_statusId" class="cw-addr-ac__status" data-state="@_statusState" role="status" aria-live="polite">@_statusText</div>
    <div class="cw-loc-ms__sr" aria-live="polite">@_liveText</div>
</div>

@if (AllowCatalogEdit)
{
<SavedValueDialog IsOpen="@_dialogOpen"
                  Kind="location"
                  Mode="@_dialogMode"
                  FieldName="@FieldName"
                  InitialText="@_dialogInitial"
                  ExcludeText="@(_dialogMode == "edit" ? _editChip?.Label : null)"
                  UseCount="@EditUseCount"
                  Suggestions="@Suggestions"
                  ExternalError="@_dialogSaveError"
                  OnCancel="CloseDialogAsync"
                  OnSave="OnDialogSaveAsync" />
}

@code {
    private sealed class Chip
    {
        public string Label { get; set; } = string.Empty;
    }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> AddSaved { get; set; }
    [Parameter] public EventCallback<(string Previous, string Next)> RenameSaved { get; set; }
    [Parameter] public IReadOnlyList<CaseAddressAutocomplete.SavedEntry> Suggestions { get; set; } =
        Array.Empty<CaseAddressAutocomplete.SavedEntry>();
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string FieldName { get; set; } = "location";
    [Parameter] public string Placeholder { get; set; } = "Start typing a location";
    [Parameter] public string EmptyHint { get; set; } = "Search saved locations. Use the + button to add a new one.";
    [Parameter] public string? NoneValue { get; set; } = CommaSeparatedSelectionHelper.NoneValue;
    /// <summary>When false, the field only picks existing suggestions. The add button and chip pen stay hidden.</summary>
    [Parameter] public bool AllowCatalogEdit { get; set; } = true;

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private readonly string _inputId = "cw-loc-ms-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _listId = "cw-loc-ms-list-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _statusId = "cw-loc-ms-status-" + Guid.NewGuid().ToString("N")[..8];

    private ElementReference _inputRef;
    private readonly List<Chip> _chips = new();
    private string _draft = string.Empty;
    private string? _lastExternal;
    private bool _listOpen;
    private bool _pickInFlight;
    private bool _focused;
    private bool _forceExpand;
    private bool _preventEnter;
    private bool _suggestionsFailed;
    private int _activeIndex = -1;
    private IReadOnlyList<CaseAddressAutocomplete.SavedEntry> _hits =
        Array.Empty<CaseAddressAutocomplete.SavedEntry>();
    private int _hitTotal;
    private string _statusText = string.Empty;
    private string _statusState = string.Empty;
    private string _liveText = string.Empty;
    private bool _userEdited;
    private bool _needsPush;
    private string? _lastPushed;

    private bool _dialogOpen;
    private string _dialogMode = "add";
    private string _dialogInitial = string.Empty;
    private string? _dialogSaveError;
    private Chip? _editChip;

    private int EditUseCount
    {
        get
        {
            if (_editChip == null)
                return 0;
            var key = CaseLocationAutocomplete.FoldKey(_editChip.Label);
            var hit = Suggestions?.FirstOrDefault(item =>
                string.Equals(CaseLocationAutocomplete.FoldKey(item.Text), key, StringComparison.Ordinal));
            return hit?.UseCount ?? 0;
        }
    }

    private IEnumerable<Chip> VisibleChips =>
        (!_focused && !_forceExpand && _chips.Count > CaseLocationAutocomplete.LimitTags)
            ? _chips.Take(CaseLocationAutocomplete.LimitTags)
            : _chips;

    private bool ShowMoreChip =>
        !_focused && !_forceExpand && _chips.Count > CaseLocationAutocomplete.LimitTags;

    protected override void OnParametersSet()
    {
        var incoming = Value ?? string.Empty;
        if (string.Equals(incoming, _lastExternal, StringComparison.Ordinal))
        {
            RefreshStatus(keepList: false);
            return;
        }

        if (_chips.Count > 0 && string.IsNullOrWhiteSpace(incoming))
        {
            _needsPush = true;
            return;
        }

        if (_userEdited || _pickInFlight)
        {
            var current = FormatCurrent();
            if (string.Equals(incoming, current, StringComparison.Ordinal))
            {
                _lastExternal = incoming;
                return;
            }

            if (!string.IsNullOrEmpty(current)
                && !string.Equals(current, _lastPushed, StringComparison.Ordinal))
                _needsPush = true;
            return;
        }

        _lastExternal = incoming;
        HydrateFromValue(incoming);
        RefreshStatus(keepList: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsPush || !ValueChanged.HasDelegate)
            return;

        var current = FormatCurrent();
        _needsPush = false;
        if (!string.IsNullOrEmpty(current)
            && !string.Equals(Value ?? string.Empty, current, StringComparison.Ordinal)
            && !string.Equals(current, _lastPushed, StringComparison.Ordinal))
        {
            _lastPushed = current;
            _lastExternal = current;
            await ValueChanged.InvokeAsync(current);
        }
    }

    private void HydrateFromValue(string? stored)
    {
        _chips.Clear();
        foreach (var label in CaseLocationAutocomplete.ParseChips(stored, NoneValue))
            _chips.Add(new Chip { Label = label });
    }

    private string FormatCurrent() =>
        CaseLocationAutocomplete.FormatChips(_chips.Select(c => c.Label), NoneValue);

    private async Task FocusInput()
    {
        if (!Enabled || ReadOnly)
            return;
        try { await _inputRef.FocusAsync(); } catch { /* ignore */ }
    }

    private void ExpandChips()
    {
        _forceExpand = true;
        _ = FocusInput();
    }

    private void OnFocusIn()
    {
        _focused = true;
        _forceExpand = true;
        RefreshStatus(keepList: true);
    }

    private async Task OnFocusOut()
    {
        if (_pickInFlight || _dialogOpen)
            return;
        _focused = false;
        _forceExpand = false;
        _listOpen = false;
        _activeIndex = -1;
        // Spec: unpicked search text is discarded on blur.
        _draft = string.Empty;
        RefreshStatus(keepList: false);
        await Task.CompletedTask;
    }

    private void OnInput(ChangeEventArgs e)
    {
        _draft = e.Value?.ToString() ?? string.Empty;
        RefreshStatus(keepList: true);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        _preventEnter = false;
        if (!Enabled || ReadOnly)
            return;

        if (e.Key == "Escape")
        {
            _listOpen = false;
            _activeIndex = -1;
            return;
        }

        if (e.Key == "ArrowDown")
        {
            RefreshStatus(keepList: true);
            if (_hits.Count == 0)
                return;
            _listOpen = true;
            _activeIndex = _activeIndex < 0 ? 0 : Math.Min(_hits.Count - 1, _activeIndex + 1);
            return;
        }

        if (e.Key == "ArrowUp")
        {
            if (_hits.Count == 0)
                return;
            _listOpen = true;
            _activeIndex = _activeIndex <= 0 ? _hits.Count - 1 : _activeIndex - 1;
            return;
        }

        if (e.Key == "Enter")
        {
            _preventEnter = true;
            if (_listOpen && _activeIndex >= 0 && _activeIndex < _hits.Count)
            {
                await PickAsync(_hits[_activeIndex].Text);
                return;
            }

            var q = CaseLocationAutocomplete.NormalizeDisplay(_draft);
            if (!string.IsNullOrEmpty(q)
                && CaseLocationAutocomplete.IsExactSaved(q, Suggestions ?? Array.Empty<CaseAddressAutocomplete.SavedEntry>())
                && !_chips.Any(c => string.Equals(CaseLocationAutocomplete.FoldKey(c.Label), CaseLocationAutocomplete.FoldKey(q), StringComparison.Ordinal)))
            {
                await PickAsync(q);
            }
            return;
        }

        if (e.Key == "Backspace" && string.IsNullOrEmpty(_draft) && _chips.Count > 0)
            await RemoveChipAsync(_chips[^1]);
    }

    private async Task PickAsync(string text)
    {
        _pickInFlight = true;
        try
        {
            await TryAddChipAsync(text);
            _draft = string.Empty;
            _listOpen = false;
            _activeIndex = -1;
            await CommitAsync();
            try { await _inputRef.FocusAsync(); } catch { /* ignore */ }
        }
        finally
        {
            _pickInFlight = false;
        }
    }

    private Task TryAddChipAsync(string label)
    {
        var display = CaseLocationAutocomplete.NormalizeDisplay(label);
        if (string.IsNullOrEmpty(display))
            return Task.CompletedTask;

        if (_chips.Any(c => string.Equals(CaseLocationAutocomplete.FoldKey(c.Label), CaseLocationAutocomplete.FoldKey(display), StringComparison.Ordinal)))
        {
            Announce(display + " is already selected.");
            return Task.CompletedTask;
        }

        _chips.Add(new Chip { Label = display });
        Announce("Added " + display + ". " + _chips.Count + " selected.");
        return Task.CompletedTask;
    }

    private async Task RemoveChipAsync(Chip chip)
    {
        _chips.Remove(chip);
        Announce("Removed " + chip.Label + ". " + _chips.Count + " selected.");
        await CommitAsync();
    }

    private async Task ClearAllAsync()
    {
        _chips.Clear();
        _draft = string.Empty;
        Announce("All locations cleared.");
        await CommitAsync();
    }

    private async Task CommitAsync()
    {
        _userEdited = true;
        var formatted = FormatCurrent();
        _lastExternal = formatted;
        _lastPushed = formatted;
        RefreshStatus(keepList: false);
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(formatted);
    }

    private async Task OpenAddDialogAsync()
    {
        var typed = CaseLocationAutocomplete.NormalizeDisplay(_draft);
        if (!string.IsNullOrEmpty(typed)
            && _chips.Any(c => string.Equals(
                CaseLocationAutocomplete.FoldKey(c.Label),
                CaseLocationAutocomplete.FoldKey(typed),
                StringComparison.Ordinal)))
        {
            Announce(typed + " is already selected.");
            _draft = string.Empty;
            RefreshStatus(keepList: false);
            return;
        }

        // Already saved: select it instead of opening Add (avoids duplicate dialog error).
        if (!string.IsNullOrEmpty(typed)
            && CaseLocationAutocomplete.IsExactSaved(
                typed,
                Suggestions ?? Array.Empty<CaseAddressAutocomplete.SavedEntry>()))
        {
            await PickAsync(typed);
            return;
        }

        _dialogMode = "add";
        _dialogInitial = _draft;
        _dialogSaveError = null;
        _editChip = null;
        _dialogOpen = true;
        _listOpen = false;
    }

    private Task OpenEditDialogAsync(Chip chip)
    {
        if (!Enabled || ReadOnly || chip == null)
            return Task.CompletedTask;
        _dialogMode = "edit";
        _editChip = chip;
        _dialogInitial = chip.Label;
        _dialogSaveError = null;
        _dialogOpen = true;
        _listOpen = false;
        return Task.CompletedTask;
    }

    private Task CloseDialogAsync()
    {
        _dialogOpen = false;
        _dialogSaveError = null;
        _editChip = null;
        return Task.CompletedTask;
    }

    private async Task OnDialogSaveAsync(string text)
    {
        _dialogSaveError = null;
        try
        {
            if (string.Equals(_dialogMode, "edit", StringComparison.OrdinalIgnoreCase) && _editChip != null)
            {
                var previous = _editChip.Label;
                if (_chips.Any(c => !ReferenceEquals(c, _editChip)
                    && string.Equals(CaseLocationAutocomplete.FoldKey(c.Label), CaseLocationAutocomplete.FoldKey(text), StringComparison.Ordinal)))
                {
                    _dialogSaveError = $"\u201c{text}\u201d is already selected.";
                    return;
                }

                if (RenameSaved.HasDelegate)
                    await RenameSaved.InvokeAsync((previous, text));
                _editChip.Label = text;
                _dialogOpen = false;
                _editChip = null;
                Announce("Location updated.");
                await CommitAsync();
                try { await _inputRef.FocusAsync(); } catch { /* ignore */ }
                return;
            }

            // Exact existing saved location: select it (do not invent a duplicate via TryAdd).
            if (CaseLocationAutocomplete.IsExactSaved(
                    text,
                    Suggestions ?? Array.Empty<CaseAddressAutocomplete.SavedEntry>()))
            {
                _dialogOpen = false;
                _draft = string.Empty;
                await TryAddChipAsync(text);
                Announce("Added " + text + ".");
                await CommitAsync();
                try { await _inputRef.FocusAsync(); } catch { /* ignore */ }
                return;
            }

            if (AddSaved.HasDelegate)
                await AddSaved.InvokeAsync(text);
            _dialogOpen = false;
            _draft = string.Empty;
            await TryAddChipAsync(text);
            Announce("New location added.");
            await CommitAsync();
            try { await _inputRef.FocusAsync(); } catch { /* ignore */ }
        }
        catch (Exception ex)
        {
            _dialogSaveError = ex.InnerException?.Message ?? ex.Message;
            _dialogOpen = true;
        }
    }

    private void RefreshStatus(bool keepList)
    {
        if (_suggestionsFailed)
        {
            _statusState = "new";
            _statusText = VisaUiMessages.Get("LocationMultiSelect.Unavailable");
            _listOpen = false;
            return;
        }

        var q = CaseLocationAutocomplete.NormalizeDisplay(_draft);
        var selectedLabels = _chips.Select(c => c.Label).ToList();

        if (string.IsNullOrEmpty(q))
        {
            _hits = Array.Empty<CaseAddressAutocomplete.SavedEntry>();
            _hitTotal = 0;
            _listOpen = false;
            _activeIndex = -1;
            if (_chips.Count > 0)
            {
                _statusState = "ok";
                _statusText = VisaUiMessages.Format("LocationMultiSelect.Selected", _chips.Count);
            }
            else
            {
                _statusState = string.Empty;
                _statusText = EmptyHint;
            }
            return;
        }

        if (selectedLabels.Any(l => string.Equals(CaseLocationAutocomplete.FoldKey(l), CaseLocationAutocomplete.FoldKey(q), StringComparison.Ordinal)))
        {
            _hits = Array.Empty<CaseAddressAutocomplete.SavedEntry>();
            _hitTotal = 0;
            _listOpen = false;
            _statusState = string.Empty;
            _statusText = VisaUiMessages.Get("LocationMultiSelect.Already");
            return;
        }

        var result = CaseLocationAutocomplete.Search(
            q,
            Suggestions ?? Array.Empty<CaseAddressAutocomplete.SavedEntry>(),
            selectedLabels);
        _hits = result.Items;
        _hitTotal = result.Total;

        if (CaseLocationAutocomplete.IsExactSaved(q, Suggestions ?? Array.Empty<CaseAddressAutocomplete.SavedEntry>()))
        {
            _statusState = "ok";
            _statusText = AllowCatalogEdit
                ? VisaUiMessages.Get("LocationMultiSelect.SavedEnter")
                : VisaUiMessages.Get("LocationMultiSelect.PressEnter");
            _listOpen = false;
            _activeIndex = -1;
            return;
        }

        if (_hits.Count > 0)
        {
            _statusState = string.Empty;
            _statusText = VisaUiMessages.Format(
                _hitTotal == 1 ? "LocationMultiSelect.Match" : "LocationMultiSelect.Matches",
                _hitTotal);
            _listOpen = keepList && _focused;
            if (!_listOpen)
                _activeIndex = -1;
            return;
        }

        _statusState = "new";
        _statusText = AllowCatalogEdit
            ? VisaUiMessages.Format("LocationMultiSelect.NoMatchAdd", q)
            : VisaUiMessages.Format("LocationMultiSelect.NoMatch", q);
        _listOpen = false;
        _activeIndex = -1;
    }

    private void Announce(string msg)
    {
        _liveText = string.Empty;
        _liveText = msg;
    }

    private string OptionId(int index) => $"{_listId}-opt-{index}";

    private RenderFragment Highlight(string text) => builder =>
    {
        var ranges = CaseLocationAutocomplete.HighlightRanges(text, _draft);
        if (ranges.Count == 0)
        {
            builder.AddContent(0, text);
            return;
        }

        var seq = 0;
        var cursor = 0;
        foreach (var (start, end) in ranges)
        {
            var s = Math.Max(0, Math.Min(start, text.Length));
            var e = Math.Max(s, Math.Min(end, text.Length));
            if (s > cursor)
                builder.AddContent(seq++, text[cursor..s]);
            builder.OpenElement(seq++, "mark");
            builder.AddContent(seq++, text[s..e]);
            builder.CloseElement();
            cursor = e;
        }
        if (cursor < text.Length)
            builder.AddContent(seq, text[cursor..]);
    };
}