@using Visa2026.Module.Services.ApplicationProfileOverview
@using Visa2026.Module.Services.ApplicationProfileCatalog

<div class="ap-overview">
    @if (IsLoading || Snapshot == null)
    {
        <div class="ap-overview__loading" role="status">Loading Application Profile overview…</div>
    }
    else
    {
        @if (Snapshot.IsPrototypeMock)
        {
            <div class="ap-overview__banner">
                <strong>Prototype</strong> — profile id was not resolved. Select a saved Application Profile to see live configuration and linked applications.
            </div>
        }

        <header class="ap-overview__header">
            <div>
                @if (CloseRequested.HasDelegate)
                {
                    <button type="button"
                            class="ap-overview__back"
                            @onclick="CloseAsync">
                        ← Back to list
                    </button>
                }
                <h1 class="ap-overview__title">@Snapshot.Name</h1>
                <p class="ap-overview__sub">
                    @Snapshot.Code
                    @if (!string.IsNullOrWhiteSpace(Snapshot.SelectionCode))
                    {
                        <text> · quick @Snapshot.SelectionCode</text>
                    }
                    · @Snapshot.ActionFamilyLabel · @Snapshot.ProgressRouteLabel
                </p>
                @if (!string.IsNullOrWhiteSpace(Snapshot.Description))
                {
                    <p class="ap-overview__desc">@Snapshot.Description</p>
                }
            </div>
            <div class="ap-overview__header-actions">
                <div class="ap-overview__pills">
                    @if (Snapshot.IsActive)
                    {
                        <span class="ap-overview__pill ap-overview__pill--on">Active</span>
                    }
                    else
                    {
                        <span class="ap-overview__pill">Inactive</span>
                    }
                    @if (Snapshot.IsConfigLocked)
                    {
                        <span class="ap-overview__pill ap-overview__pill--warn">Config locked</span>
                    }
                </div>
                <button type="button"
                        class="ap-overview__btn ap-overview__btn--primary"
                        @onclick="ConfigureAsync">
                    Configure profile
                </button>
                @if (CanDelete)
                {
                    @if (_confirmDelete)
                    {
                        <button type="button"
                                class="ap-overview__btn ap-overview__btn--danger"
                                @onclick="ConfirmDeleteAsync">
                            Confirm delete
                        </button>
                        <button type="button"
                                class="ap-overview__btn"
                                @onclick="CancelDelete">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="ap-overview__btn ap-overview__btn--danger-outline"
                                @onclick="AskDelete">
                            Delete template
                        </button>
                    }
                }
            </div>
        </header>

        @if (Snapshot.AudienceLabels.Count > 0)
        {
            <div class="ap-overview__audience">
                <span class="ap-overview__label">Audience</span>
                @foreach (var audience in Snapshot.AudienceLabels)
                {
                    <span class="ap-overview__chip">@audience</span>
                }
            </div>
        }

        <div class="ap-overview__grid">
            <section class="ap-overview__card">
                <h2>Identity &amp; purpose</h2>
                <p class="ap-overview__hint">Who this profile is for and how applications are directed.</p>
                <ul class="ap-overview__list">
                    <li>Applicability: @(Snapshot.IsAlwaysAvailable ? "Always available" : "Scoped")</li>
                    @if (!Snapshot.IsAlwaysAvailable && !string.IsNullOrWhiteSpace(Snapshot.ApplicabilityCriteria))
                    {
                        <li>Criteria: @Snapshot.ApplicabilityCriteria</li>
                    }
                    @foreach (var line in Snapshot.LiveConfigurationLines)
                    {
                        <li>@line</li>
                    }
                    @if (Snapshot.LiveConfigurationLines.Count == 0)
                    {
                        <li>@(Snapshot.ActionFamilyLabel) — no produce/cancel documents.</li>
                    }
                </ul>
            </section>

            <section class="ap-overview__card">
                <h2>Per-application defaults</h2>
                <p class="ap-overview__hint">Use on Results &amp; fields. Copied once at create; officers may change values on each application.</p>
                @if (Snapshot.PerApplicationDefaults.Count == 0)
                {
                    <p class="ap-overview__empty">No required ApplicationProfileInstance properties on this profile.</p>
                }
                else
                {
                    <table class="ap-overview__table">
                        <thead>
                            <tr>
                                <th>Field</th>
                                <th>Default</th>
                                <th>Required</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Snapshot.PerApplicationDefaults)
                            {
                                <tr>
                                    <td>@row.FieldLabel</td>
                                    <td>@row.DefaultValue</td>
                                    <td>@(row.Required ? "Yes" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <section class="ap-overview__card">
            <h2>Company, Signatories</h2>
            <p class="ap-overview__hint">Live Configuration records — not copied onto this template. Reports merge these rows.</p>
            <div class="ap-overview__org">
                <div>
                    <h3>Company</h3>
                    @if (!Snapshot.Organization.HasCompany)
                    {
                        <p class="ap-overview__empty">No Company record yet.</p>
                    }
                    else
                    {
                        <dl class="ap-overview__dl">
                            <div><dt>Name</dt><dd>@OrDash(Snapshot.Organization.CompanyName)</dd></div>
                            <div><dt>Code</dt><dd>@OrDash(Snapshot.Organization.CompanyCode)</dd></div>
                            <div><dt>Phone</dt><dd>@OrDash(Snapshot.Organization.CompanyPhone)</dd></div>
                            <div class="ap-overview__dl--full"><dt>Address</dt><dd>@OrDash(Snapshot.Organization.CompanyAddress)</dd></div>
                            <div><dt>Email</dt><dd>@OrDash(Snapshot.Organization.CompanyEmail)</dd></div>
                            <div><dt>Tax information</dt><dd>@OrDash(Snapshot.Organization.CompanyTaxInformation)</dd></div>
                        </dl>
                    }
                </div>
                <div>
                    <h3>Authorized Signatory</h3>
                    @if (!Snapshot.Organization.HasSignatory)
                    {
                        <p class="ap-overview__empty">No Authorized Signatory yet.</p>
                    }
                    else
                    {
                        <dl class="ap-overview__dl">
                            <div><dt>Full name</dt><dd>@OrDash(Snapshot.Organization.SignatoryFullName)</dd></div>
                            <div><dt>Position (Tm)</dt><dd>@OrDash(Snapshot.Organization.SignatoryPositionTitleTm)</dd></div>
                            <div><dt>Passport number</dt><dd>@OrDash(Snapshot.Organization.SignatoryPassportNumber)</dd></div>
                            <div><dt>Passport authority</dt><dd>@OrDash(Snapshot.Organization.SignatoryPassportAuthority)</dd></div>
                            <div><dt>Passport issue date</dt><dd>@OrDash(Snapshot.Organization.SignatoryPassportIssueDateText)</dd></div>
                        </dl>
                    }
                </div>
                <div>
                    <h3>Authorized Representative</h3>
                    @if (!Snapshot.Organization.HasRepresentative)
                    {
                        <p class="ap-overview__empty">No Authorized Representative yet.</p>
                    }
                    else
                    {
                        <dl class="ap-overview__dl">
                            <div><dt>Full name</dt><dd>@OrDash(Snapshot.Organization.RepresentativeFullName)</dd></div>
                            <div><dt>Position (Tm)</dt><dd>@OrDash(Snapshot.Organization.RepresentativePositionTitleTm)</dd></div>
                            <div><dt>Phone</dt><dd>@OrDash(Snapshot.Organization.RepresentativePhone)</dd></div>
                            <div><dt>Passport number</dt><dd>@OrDash(Snapshot.Organization.RepresentativePassportNumber)</dd></div>
                            <div><dt>Passport authority</dt><dd>@OrDash(Snapshot.Organization.RepresentativePassportAuthority)</dd></div>
                            <div><dt>Passport issue date</dt><dd>@OrDash(Snapshot.Organization.RepresentativePassportIssueDateText)</dd></div>
                        </dl>
                    }
                </div>
            </div>
        </section>

        <div class="ap-overview__grid">
            <section class="ap-overview__card">
                <h2>Process &amp; SLA</h2>
                <p class="ap-overview__hint">Expected duration. Instance steps follow Directed to and Approval legs.</p>
                <ul class="ap-overview__list">
                    @if (Snapshot.IsViaMinistry)
                    {
                        <li>Ministry SLA: @Snapshot.MinistrySlaDays days</li>
                    }
                    <li>Migration SLA: @Snapshot.MigrationSlaDays days</li>
                </ul>
            </section>

            <section class="ap-overview__card">
                <h2>Approval legs</h2>
                @if (Snapshot.ApprovalLegVersions.Count > 0)
                {
                    @foreach (var version in Snapshot.ApprovalLegVersions)
                    {
                        <h3 class="ap-overview__subhead">
                            @version.Name
                            @if (version.IsDefault)
                            {
                                <span class="ap-overview__pill">Default</span>
                            }
                        </h3>
                        @if (version.Legs.Count == 0)
                        {
                            <p class="ap-overview__empty">No ministries on this version.</p>
                        }
                        else
                        {
                            <table class="ap-overview__table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Ministry</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var leg in version.Legs)
                                    {
                                        <tr>
                                            <td>@leg.Sequence</td>
                                            <td>@leg.MinistryName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                }
                else if (Snapshot.ApprovalLegs.Count == 0)
                {
                    <p class="ap-overview__empty">No approval legs (direct migration, or none configured).</p>
                }
                else
                {
                    <table class="ap-overview__table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ministry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leg in Snapshot.ApprovalLegs)
                            {
                                <tr>
                                    <td>@leg.Sequence</td>
                                    <td>@leg.MinistryName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            <section class="ap-overview__card">
                <h2>Person data requirements</h2>
                @if (Snapshot.PersonDataToggles.Count == 0)
                {
                    <p class="ap-overview__empty">No person-data requirements on this profile.</p>
                }
                else
                {
                    <div class="ap-overview__chips">
                        @foreach (var toggle in Snapshot.PersonDataToggles)
                        {
                            <span class="ap-overview__chip">@toggle</span>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="ap-overview__card">
            <h2>Nested templates</h2>
            @if (Snapshot.NestedTemplates.Count == 0)
            {
                <p class="ap-overview__empty">No nested report templates.</p>
            }
            else
            {
                <table class="ap-overview__table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Scope</th>
                            <th>Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Snapshot.NestedTemplates)
                        {
                            <tr>
                                <td>
                                    @template.Name
                                    @if (!string.IsNullOrWhiteSpace(template.Category))
                                    {
                                        <span class="ap-overview__chip ap-overview__chip--quiet">@template.Category</span>
                                    }
                                </td>
                                <td>@template.Kind</td>
                                <td>@template.Scope</td>
                                <td>@template.DataScope</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="ap-overview__card">
            <h2>Linked applications <span class="ap-overview__count">(@LinkedCountCaption(Snapshot))</span></h2>
            <p class="ap-overview__hint">Applications that use this profile. Open a number to view the case workspace.</p>
            @if (Snapshot.LinkedApplications.Count == 0)
            {
                <p class="ap-overview__empty">No applications use this profile yet.</p>
            }
            else
            {
                <table class="ap-overview__table">
                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Snapshot.LinkedApplications)
                        {
                            <tr>
                                <td>
                                    @if (CanOpenInstance(app))
                                    {
                                        <button type="button"
                                                class="ap-overview__link"
                                                @onclick="() => OpenInstanceAsync(app.ApplicationProfileInstanceId)">
                                            @app.FullNumber
                                        </button>
                                    }
                                    else
                                    {
                                        @app.FullNumber
                                    }
                                </td>
                                <td>@app.ApplicationDate</td>
                                <td>@app.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public ApplicationProfileOverviewSnapshot? Snapshot { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback ConfigureRequested { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenInstanceRequested { get; set; }
    [Parameter] public EventCallback<Guid> DeleteProfileRequested { get; set; }

    private bool _confirmDelete;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialLoadRequested.HasDelegate)
            await InitialLoadRequested.InvokeAsync();
    }

    private Task ConfigureAsync() => ConfigureRequested.InvokeAsync();

    private Task CloseAsync() => CloseRequested.InvokeAsync();

    private bool CanDelete =>
        Snapshot != null
        && !Snapshot.IsPrototypeMock
        && ApplicationProfileUnlinkedDeleteHelper.CanDelete(Snapshot.LinkedApplicationCount)
        && DeleteProfileRequested.HasDelegate;

    private void AskDelete() => _confirmDelete = true;

    private void CancelDelete() => _confirmDelete = false;

    private async Task ConfirmDeleteAsync()
    {
        _confirmDelete = false;
        if (Snapshot == null || !DeleteProfileRequested.HasDelegate)
            return;

        await DeleteProfileRequested.InvokeAsync(Snapshot.ApplicationProfileId);
    }

    private Task OpenInstanceAsync(Guid instanceId) => OpenInstanceRequested.InvokeAsync(instanceId);

    private static string OrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private bool CanOpenInstance(ApplicationProfileOverviewLinkedAppRow app) =>
        OpenInstanceRequested.HasDelegate && app.ApplicationProfileInstanceId != Guid.Empty;

    private static string LinkedCountCaption(ApplicationProfileOverviewSnapshot snapshot)
    {
        if (snapshot.LinkedApplicationCount > snapshot.LinkedApplications.Count)
            return $"{snapshot.LinkedApplications.Count} of {snapshot.LinkedApplicationCount}";
        return snapshot.LinkedApplicationCount.ToString();
    }
}
