@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationProfileOverview
@using Visa2026.Module.Services.ApplicationProfileCatalog

<div class="ap-overview">
    @if (IsLoading || Snapshot == null)
    {
        <div class="ap-overview__loading" role="status">@Msg("ApplicationProfile.Overview.Loading")</div>
    }
    else
    {
        @if (Snapshot.IsPrototypeMock)
        {
            <div class="ap-overview__banner">
                <strong>Prototype</strong> — profile id was not resolved. Select a saved Application Profile to see live configuration and linked applications.
            </div>
        }

        <header class="ap-overview__header">
            <div>
                @if (CloseRequested.HasDelegate)
                {
                    <button type="button"
                            class="ap-overview__back"
                            @onclick="CloseAsync">
                        @Msg("ApplicationProfile.Overview.BackToList")
                    </button>
                }
                <h1 class="ap-overview__title">@Snapshot.Name</h1>
                <p class="ap-overview__sub">
                    @Snapshot.Code
                    @if (!string.IsNullOrWhiteSpace(Snapshot.SelectionCode))
                    {
                        <text> · quick @Snapshot.SelectionCode</text>
                    }
                    · @Snapshot.ActionFamilyLabel · @Snapshot.ProgressRouteLabel
                </p>
                @if (!string.IsNullOrWhiteSpace(Snapshot.Description))
                {
                    <p class="ap-overview__desc">@Snapshot.Description</p>
                }
            </div>
            <div class="ap-overview__header-actions">
                <div class="ap-overview__pills">
                    @if (Snapshot.IsActive)
                    {
                        <span class="ap-overview__pill ap-overview__pill--on">@Msg("ApplicationProfile.Status.Active")</span>
                    }
                    else
                    {
                        <span class="ap-overview__pill">@Msg("ApplicationProfile.Status.Inactive")</span>
                    }
                    @if (Snapshot.IsConfigLocked)
                    {
                        <span class="ap-overview__pill ap-overview__pill--warn">@Msg("ApplicationProfile.Status.ConfigLocked")</span>
                    }
                </div>
                <button type="button"
                        class="ap-overview__btn ap-overview__btn--primary"
                        @onclick="ConfigureAsync">
                    @Msg("ApplicationProfile.Overview.Configure")
                </button>
                @if (CanDelete)
                {
                    @if (_confirmDelete)
                    {
                        <button type="button"
                                class="ap-overview__btn ap-overview__btn--danger"
                                @onclick="ConfirmDeleteAsync">
                            @Msg("ApplicationProfile.Catalog.ConfirmDelete")
                        </button>
                        <button type="button"
                                class="ap-overview__btn"
                                @onclick="CancelDelete">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="ap-overview__btn ap-overview__btn--danger-outline"
                                @onclick="AskDelete">
                            @Msg("ApplicationProfile.Overview.DeleteTemplate")
                        </button>
                    }
                }
            </div>
        </header>

        @if (Snapshot.AudienceLabels.Count > 0)
        {
            <div class="ap-overview__audience">
                <span class="ap-overview__label">@Msg("ApplicationProfile.Overview.Audience")</span>
                @foreach (var audience in Snapshot.AudienceLabels)
                {
                    <span class="ap-overview__chip">@audience</span>
                }
            </div>
        }

        <div class="ap-overview__grid">
            <section class="ap-overview__card">
                <h2>@Msg("ApplicationProfile.Overview.IdentityTitle")</h2>
                <p class="ap-overview__hint">@Msg("ApplicationProfile.Overview.IdentityHint")</p>
                <ul class="ap-overview__list">
                    @foreach (var line in Snapshot.LiveConfigurationLines)
                    {
                        <li>@line</li>
                    }
                    @if (Snapshot.LiveConfigurationLines.Count == 0)
                    {
                        <li>@VisaUiMessages.Format("ApplicationProfile.Overview.NoProduce", Snapshot.ActionFamilyLabel)</li>
                    }
                </ul>
            </section>

            <section class="ap-overview__card">
                <h2>@Msg("ApplicationProfile.Overview.DefaultsTitle")</h2>
                <p class="ap-overview__hint">@Msg("ApplicationProfile.Overview.DefaultsHint")</p>
                @if (Snapshot.PerApplicationDefaults.Count == 0)
                {
                    <p class="ap-overview__empty">@Msg("ApplicationProfile.Overview.NoRequiredProps")</p>
                }
                else
                {
                    <table class="ap-overview__table">
                        <thead>
                            <tr>
                                <th>@Msg("ApplicationProfile.Overview.ColField")</th>
                                <th>@Msg("ApplicationProfile.Overview.ColDefault")</th>
                                <th>@Msg("ApplicationProfile.Overview.ColRequired")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Snapshot.PerApplicationDefaults)
                            {
                                <tr>
                                    <td>@row.FieldLabel</td>
                                    <td>@row.DefaultValue</td>
                                    <td>@(row.Required ? Msg("ApplicationProfile.Overview.Yes") : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <div class="ap-overview__grid">
            <section class="ap-overview__card">
                <h2>@Msg("ApplicationProfile.Overview.ProcessTitle")</h2>
                <p class="ap-overview__hint">@Msg("ApplicationProfile.Overview.ProcessHint")</p>
                <ul class="ap-overview__list">
                    @if (Snapshot.IsViaMinistry)
                    {
                        <li>@VisaUiMessages.Format("ApplicationProfile.Overview.MinistrySla", Snapshot.MinistrySlaDays)</li>
                    }
                    <li>@VisaUiMessages.Format("ApplicationProfile.Overview.MigrationSla", Snapshot.MigrationSlaDays)</li>
                </ul>
            </section>

            <section class="ap-overview__card">
                <h2>@Msg("ApplicationProfile.Overview.PersonTitle")</h2>
                @if (Snapshot.PersonDataToggles.Count == 0)
                {
                    <p class="ap-overview__empty">@Msg("ApplicationProfile.Overview.NoPersonReqs")</p>
                }
                else
                {
                    <div class="ap-overview__chips">
                        @foreach (var toggle in Snapshot.PersonDataToggles)
                        {
                            <span class="ap-overview__chip">@toggle</span>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="ap-overview__card">
            <h2>@Msg("ApplicationProfile.Overview.NestedTitle")</h2>
            @if (Snapshot.NestedTemplates.Count == 0)
            {
                <p class="ap-overview__empty">@Msg("ApplicationProfile.Overview.NoNested")</p>
            }
            else
            {
                <table class="ap-overview__table">
                    <thead>
                        <tr>
                            <th>@Msg("ApplicationProfile.Overview.ColName")</th>
                            <th>@Msg("ApplicationProfile.Overview.ColType")</th>
                            <th>@Msg("ApplicationProfile.Overview.ColScope")</th>
                            <th>@Msg("ApplicationProfile.Overview.ColData")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Snapshot.NestedTemplates)
                        {
                            <tr>
                                <td>
                                    @template.Name
                                    @if (!string.IsNullOrWhiteSpace(template.Category))
                                    {
                                        <span class="ap-overview__chip ap-overview__chip--quiet">@template.Category</span>
                                    }
                                </td>
                                <td>@template.Kind</td>
                                <td>@template.Scope</td>
                                <td>@template.DataScope</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="ap-overview__card">
            <h2>@Msg("ApplicationProfile.Overview.LinkedTitle") <span class="ap-overview__count">(@LinkedCountCaption(Snapshot))</span></h2>
            <p class="ap-overview__hint">@Msg("ApplicationProfile.Overview.LinkedHint")</p>
            @if (Snapshot.LinkedApplications.Count == 0)
            {
                <p class="ap-overview__empty">@Msg("ApplicationProfile.Overview.NoLinked")</p>
            }
            else
            {
                <table class="ap-overview__table">
                    <thead>
                        <tr>
                            <th>@Msg("ApplicationProfile.Overview.ColApplication")</th>
                            <th>@Msg("ApplicationProfile.Overview.ColDate")</th>
                            <th>@Msg("ApplicationProfile.Overview.ColStatus")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Snapshot.LinkedApplications)
                        {
                            <tr>
                                <td>
                                    @if (CanOpenInstance(app))
                                    {
                                        <button type="button"
                                                class="ap-overview__link"
                                                @onclick="() => OpenInstanceAsync(app.ApplicationProfileInstanceId)">
                                            @app.FullNumber
                                        </button>
                                    }
                                    else
                                    {
                                        @app.FullNumber
                                    }
                                </td>
                                <td>@app.ApplicationDate</td>
                                <td>@app.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public ApplicationProfileOverviewSnapshot? Snapshot { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback ConfigureRequested { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenInstanceRequested { get; set; }
    [Parameter] public EventCallback<Guid> DeleteProfileRequested { get; set; }

    private bool _confirmDelete;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialLoadRequested.HasDelegate)
            await InitialLoadRequested.InvokeAsync();
    }

    private Task ConfigureAsync() => ConfigureRequested.InvokeAsync();

    private Task CloseAsync() => CloseRequested.InvokeAsync();

    private bool CanDelete =>
        Snapshot != null
        && !Snapshot.IsPrototypeMock
        && ApplicationProfileUnlinkedDeleteHelper.CanDelete(Snapshot.LinkedApplicationCount)
        && DeleteProfileRequested.HasDelegate;

    private void AskDelete() => _confirmDelete = true;

    private void CancelDelete() => _confirmDelete = false;

    private async Task ConfirmDeleteAsync()
    {
        _confirmDelete = false;
        if (Snapshot == null || !DeleteProfileRequested.HasDelegate)
            return;

        await DeleteProfileRequested.InvokeAsync(Snapshot.ApplicationProfileId);
    }

    private Task OpenInstanceAsync(Guid instanceId) => OpenInstanceRequested.InvokeAsync(instanceId);

    private bool CanOpenInstance(ApplicationProfileOverviewLinkedAppRow app) =>
        OpenInstanceRequested.HasDelegate && app.ApplicationProfileInstanceId != Guid.Empty;

    private static string LinkedCountCaption(ApplicationProfileOverviewSnapshot snapshot)
    {
        if (snapshot.LinkedApplicationCount > snapshot.LinkedApplications.Count)
            return VisaUiMessages.Format("ApplicationProfile.Overview.CountOf", snapshot.LinkedApplications.Count, snapshot.LinkedApplicationCount);
        return snapshot.LinkedApplicationCount.ToString();
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);
}
