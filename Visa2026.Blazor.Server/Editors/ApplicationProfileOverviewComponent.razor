@using Visa2026.Module.Services.ApplicationProfileOverview

<div class="ap-overview">
    @if (IsLoading || Snapshot == null)
    {
        <div class="ap-overview__loading" role="status">Loading Application Profile overview…</div>
    }
    else
    {
        @if (Snapshot.IsPrototypeMock)
        {
            <div class="ap-overview__banner">
                <strong>Prototype</strong> — profile id was not resolved. Select a saved Application Profile to see live configuration and linked applications.
            </div>
        }

        <header class="ap-overview__header">
            <div>
                @if (CloseRequested.HasDelegate)
                {
                    <button type="button"
                            class="ap-overview__back"
                            @onclick="CloseAsync">
                        ← Back to list
                    </button>
                }
                <h1 class="ap-overview__title">@Snapshot.Name</h1>
                <p class="ap-overview__sub">@Snapshot.Code · @Snapshot.ActionFamilyLabel · @Snapshot.ProgressRouteLabel</p>
                @if (!string.IsNullOrWhiteSpace(Snapshot.Description))
                {
                    <p class="ap-overview__desc">@Snapshot.Description</p>
                }
            </div>
            <div class="ap-overview__header-actions">
                <div class="ap-overview__pills">
                    @if (Snapshot.IsActive)
                    {
                        <span class="ap-overview__pill ap-overview__pill--on">Active</span>
                    }
                    else
                    {
                        <span class="ap-overview__pill">Inactive</span>
                    }
                    @if (Snapshot.IsConfigLocked)
                    {
                        <span class="ap-overview__pill ap-overview__pill--warn">Config locked</span>
                    }
                </div>
                <button type="button"
                        class="ap-overview__btn ap-overview__btn--primary"
                        @onclick="ConfigureAsync">
                    Configure profile
                </button>
            </div>
        </header>

        @if (Snapshot.AudienceLabels.Count > 0)
        {
            <div class="ap-overview__audience">
                <span class="ap-overview__label">Audience</span>
                @foreach (var audience in Snapshot.AudienceLabels)
                {
                    <span class="ap-overview__chip">@audience</span>
                }
            </div>
        }

        <div class="ap-overview__grid">
            <section class="ap-overview__card">
                <h2>Configuration (live)</h2>
                <p class="ap-overview__hint">Applies to all applications linked to this profile.</p>
                <ul class="ap-overview__list">
                    @foreach (var line in Snapshot.LiveConfigurationLines)
                    {
                        <li>@line</li>
                    }
                </ul>
            </section>

            <section class="ap-overview__card">
                <h2>Per-application defaults</h2>
                <p class="ap-overview__hint">Copied once at create; officers may change values on each application.</p>
                @if (Snapshot.PerApplicationDefaults.Count == 0)
                {
                    <p class="ap-overview__empty">No required defaults on this profile.</p>
                }
                else
                {
                    <table class="ap-overview__table">
                        <thead>
                            <tr>
                                <th>Field</th>
                                <th>Default</th>
                                <th>Required</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Snapshot.PerApplicationDefaults)
                            {
                                <tr>
                                    <td>@row.FieldLabel</td>
                                    <td>@row.DefaultValue</td>
                                    <td>@(row.Required ? "Yes" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        <div class="ap-overview__grid">
            <section class="ap-overview__card">
                <h2>Approval legs</h2>
                @if (Snapshot.ApprovalLegs.Count == 0)
                {
                    <p class="ap-overview__empty">No approval legs (direct migration, or none configured).</p>
                }
                else
                {
                    <table class="ap-overview__table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ministry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leg in Snapshot.ApprovalLegs)
                            {
                                <tr>
                                    <td>@leg.Sequence</td>
                                    <td>@leg.MinistryName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            <section class="ap-overview__card">
                <h2>Person data requirements</h2>
                @if (Snapshot.PersonDataToggles.Count == 0)
                {
                    <p class="ap-overview__empty">No person-data requirements on this profile.</p>
                }
                else
                {
                    <div class="ap-overview__chips">
                        @foreach (var toggle in Snapshot.PersonDataToggles)
                        {
                            <span class="ap-overview__chip">@toggle</span>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="ap-overview__card">
            <h2>Nested templates</h2>
            @if (Snapshot.NestedTemplates.Count == 0)
            {
                <p class="ap-overview__empty">No nested report templates.</p>
            }
            else
            {
                <table class="ap-overview__table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Snapshot.NestedTemplates)
                        {
                            <tr>
                                <td>@template.Name</td>
                                <td>@template.Kind</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="ap-overview__card">
            <h2>Linked applications <span class="ap-overview__count">(@LinkedCountCaption(Snapshot))</span></h2>
            <p class="ap-overview__hint">Applications that use this profile. Open a number to view the case workspace.</p>
            @if (Snapshot.LinkedApplications.Count == 0)
            {
                <p class="ap-overview__empty">No applications use this profile yet.</p>
            }
            else
            {
                <table class="ap-overview__table">
                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Snapshot.LinkedApplications)
                        {
                            <tr>
                                <td>
                                    @if (CanOpenInstance(app))
                                    {
                                        <button type="button"
                                                class="ap-overview__link"
                                                @onclick="() => OpenInstanceAsync(app.ApplicationProfileInstanceId)">
                                            @app.FullNumber
                                        </button>
                                    }
                                    else
                                    {
                                        @app.FullNumber
                                    }
                                </td>
                                <td>@app.ApplicationDate</td>
                                <td>@app.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public ApplicationProfileOverviewSnapshot? Snapshot { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback ConfigureRequested { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenInstanceRequested { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialLoadRequested.HasDelegate)
            await InitialLoadRequested.InvokeAsync();
    }

    private Task ConfigureAsync() => ConfigureRequested.InvokeAsync();

    private Task CloseAsync() => CloseRequested.InvokeAsync();

    private Task OpenInstanceAsync(Guid instanceId) => OpenInstanceRequested.InvokeAsync(instanceId);

    private bool CanOpenInstance(ApplicationProfileOverviewLinkedAppRow app) =>
        OpenInstanceRequested.HasDelegate && app.ApplicationProfileInstanceId != Guid.Empty;

    private static string LinkedCountCaption(ApplicationProfileOverviewSnapshot snapshot)
    {
        if (snapshot.LinkedApplicationCount > snapshot.LinkedApplications.Count)
            return $"{snapshot.LinkedApplications.Count} of {snapshot.LinkedApplicationCount}";
        return snapshot.LinkedApplicationCount.ToString();
    }
}
