@namespace Visa2026.Blazor.Server.Editors
@using Visa2026.Module.Services.TemplateConvert
@using Visa2026.Module.Services.TemplateScan
@using Visa2026.Module.Localization
@using Visa2026.Blazor.Server.Localization
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.AspNetCore.Http

<div class="tas-help">
    <h3>@Msg("TemplateScan.Help.Title")</h3>
    <p>@Msg("TemplateScan.Help.Body")</p>

    @if (Gaps.Count == 0 && UnmappedFields.Count == 0)
    {
        <p class="tas-chat__empty">@Msg("TemplateScan.Help.None")</p>
    }
    else
    {
        <ul class="tas-gap-list">
            @foreach (var gap in Gaps)
            {
                <li class="tas-gap-list__item">
                    <span class="tas-conf tas-conf--gap">@Msg("TemplateScan.Gap")</span>
                    <strong>@gap.LabelText</strong>
                    @if (!string.IsNullOrWhiteSpace(gap.SuggestedPropertyName))
                    {
                        <code>@FormatMsg("TemplateScan.Help.Suggested", gap.SuggestedPropertyName)</code>
                    }
                </li>
            }
            @foreach (var field in UnmappedFields)
            {
                <li class="tas-gap-list__item">
                    <span class="tas-conf tas-conf--low">@Msg("TemplateScan.Unmapped")</span>
                    <strong>@field.LabelText</strong>
                    <span>@FormatMsg("TemplateScan.Help.Page", field.PageIndex + 1)</span>
                </li>
            }
        </ul>
    }

    @if (ValidationIssues.Count > 0)
    {
        <h4>@Msg("TemplateScan.Help.Validation")</h4>
        <ul class="tas-issues">
            @foreach (var issue in ValidationIssues.Take(8))
            {
                <li class="tas-issue @(issue.Severity == TemplateValidationSeverity.Error ? "tas-issue--fail" : "tas-issue--warn")">
                    @issue.Message
                </li>
            }
        </ul>
    }

    <div class="tas-help__meta">
        <div><span>@Msg("TemplateScan.Help.ScanFile")</span><strong>@ScanFileName</strong></div>
        <div><span>@Msg("TemplateScan.Help.Profile")</span><strong>@ProfileName</strong></div>
        <div><span>@Msg("TemplateScan.Help.Instance")</span><strong>@InstanceLabel</strong></div>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ScanGap> Gaps { get; set; } = Array.Empty<ScanGap>();
    [Parameter] public IReadOnlyList<ScanDetectedField> UnmappedFields { get; set; } = Array.Empty<ScanDetectedField>();
    [Parameter] public IReadOnlyList<TemplateValidationIssue> ValidationIssues { get; set; } =
        Array.Empty<TemplateValidationIssue>();
    [Parameter] public string ScanFileName { get; set; } = string.Empty;
    [Parameter] public string ProfileName { get; set; } = string.Empty;
    [Parameter] public string InstanceLabel { get; set; } = "—";

    [Inject] private IXafCultureInfoService CultureInfoService { get; set; } = null!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;

    private string EffectiveUiCulture =>
        VisaUiCultureResolver.Resolve(CultureInfoService, HttpContextAccessor.HttpContext);

    private string Msg(string key) => VisaUiMessages.Get(key, EffectiveUiCulture);

    private string FormatMsg(string key, params object[] args) =>
        VisaUiMessages.FormatForCulture(EffectiveUiCulture, key, args);
}
