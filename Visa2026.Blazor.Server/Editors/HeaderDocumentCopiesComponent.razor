@namespace Visa2026.Blazor.Server.Editors
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Http
@using DevExpress.ExpressApp.Blazor.Services
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.HeaderLinkedDocuments
@using Visa2026.Module.Services.PreviewSlot

<div class="app-item-doc-copies app-header-doc-copies doc-copies-catalog @(UseInlinePreview ? "app-item-doc-copies--inline-slot" : string.Empty)">
    <div class="app-item-doc-copies__body">
        @if (Snapshot.ParentId == Guid.Empty)
        {
            <div class="app-item-doc-copies__empty" role="status">
                <p>@EmptyNoParent</p>
            </div>
            <div class="app-item-doc-copies__top-actions">
                <DxButton Text="@ActionRefresh"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          CssClass="app-item-doc-copies__action-btn"
                          Click="@OnRefreshClick" />
            </div>
        }
        else if (Snapshot.Records.Count == 0)
        {
            <div class="app-item-doc-copies__empty" role="status">
                <p>@EmptyNoRecords</p>
                @if (!string.IsNullOrWhiteSpace(HeaderLine))
                {
                    <p class="app-item-doc-copies__hint">@HeaderLine</p>
                }
            </div>
            <div class="app-item-doc-copies__top-actions">
                <DxButton Text="@ActionRefresh"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          CssClass="app-item-doc-copies__action-btn"
                          Click="@OnRefreshClick" />
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(HeaderLine))
            {
                <p class="doc-copies-catalog__context-line">@HeaderLine</p>
            }
            @if (Snapshot.ShowSharedScansHint)
            {
                <p class="app-item-doc-copies__hint">@SharedScansHint</p>
            }

            <div class="doc-copies-catalog__sections">
                @{
                    var documentsCollapsed = _sectionCollapsed;
                    var documentsSectionId = DocumentCopiesCatalogNavIcons.Documents;
                }
                <section class="doc-copies-catalog__section @(documentsCollapsed ? "doc-copies-catalog__section--collapsed" : null)"
                         aria-label="@DocumentsSectionLabel">
                    <header class="doc-copies-catalog__section-head doc-copies-catalog__section-head--nav"
                            role="button"
                            tabindex="0"
                            aria-expanded="@(!documentsCollapsed)"
                            aria-label="@(documentsCollapsed ? SectionExpandLabel : SectionCollapseLabel)"
                            @onclick="@ToggleSectionNavAsync"
                            @onkeydown="@OnSectionNavKeyDownAsync">
                        <span class="doc-copies-catalog__nav-icon @DocumentCopiesCatalogNavIcons.CssClass(documentsSectionId)" aria-hidden="true">
                            @((MarkupString)DocumentCopiesCatalogNavIcons.Svg(documentsSectionId))
                        </span>

                        <div class="doc-copies-catalog__section-head-main">
                            <span class="doc-copies-catalog__section-title">@DocumentsSectionLabel</span>
                            <span class="doc-copies-catalog__section-summary">@GetSectionSummary()</span>
                        </div>

                        <div class="doc-copies-catalog__section-head-actions" @onclick:stopPropagation="true">
                            <button type="button"
                                    class="doc-copies-catalog__nav-open"
                                    aria-expanded="@(!documentsCollapsed)"
                                    @onclick="@ToggleSectionNavAsync">
                                @(documentsCollapsed ? ActionOpen : ActionClose)
                            </button>
                        </div>
                    </header>

                    @if (!documentsCollapsed)
                    {
                        <div class="doc-copies-catalog__rows" role="table">
                            <div class="doc-copies-catalog__row doc-copies-catalog__row--head" role="row">
                                <div class="doc-copies-catalog__col-record" role="columnheader">@ColumnRecord</div>
                                <div class="doc-copies-catalog__row-meta">
                                    <div class="doc-copies-catalog__col-files" role="columnheader">@ColumnFiles</div>
                                    <div class="doc-copies-catalog__col-status" role="columnheader">@ColumnStatus</div>
                                    <div class="doc-copies-catalog__col-action" role="columnheader" aria-hidden="true"></div>
                                </div>
                            </div>

                            @foreach (var record in Snapshot.Records)
                            {
                                var fileCount = CountFiles(record);
                                var hasFiles = fileCount > 0;
                                var rowLoading = IsPreviewLoading(record.RecordKey);

                                <div class="@GetRowCssClass(hasFiles, rowLoading)"
                                     role="row"
                                     @onclick="@(() => OnRowClickAsync(record))">
                                    <div class="doc-copies-catalog__col-record" role="cell">
                                        <span class="doc-copies-catalog__record-label" title="@record.RecordLabel">
                                            @record.RecordLabel
                                        </span>
                                    </div>
                                    <div class="doc-copies-catalog__row-meta">
                                        <div class="doc-copies-catalog__col-files" role="cell">
                                            @(hasFiles ? fileCount.ToString() : "—")
                                        </div>
                                        <div class="doc-copies-catalog__col-status" role="cell">
                                            @if (hasFiles)
                                            {
                                                <span class="person-dossier__pill st-approved doc-copies-catalog__pill">@StatusReady</span>
                                            }
                                            else
                                            {
                                                <span class="person-dossier__pill st-expiring doc-copies-catalog__pill">@StatusMissing</span>
                                            }
                                        </div>
                                        <div class="doc-copies-catalog__col-action" role="cell" @onclick:stopPropagation="true">
                                            @if (hasFiles && !rowLoading)
                                            {
                                                <button type="button"
                                                        class="doc-copies-catalog__preview-link"
                                                        disabled="@IsAnyPreviewLoading"
                                                        aria-label="@ActionPreview"
                                                        @onclick="@(() => PreviewRecordAsync(record))">
                                                    @ActionPreview
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @if (rowLoading)
                                {
                                    <div class="doc-copies-catalog__progress-row">
                                        <div class="app-report-package__entry-progress" role="progressbar" aria-busy="true"
                                             aria-label="@FormatMsg("ApplicationReportPackage.Preview.Downloading", record.RecordLabel)">
                                            <div class="app-report-package__preview-progress-track">
                                                <div class="app-report-package__preview-progress-indeterminate"></div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (ShowDetails && hasFiles)
                                {
                                    @foreach (var file in record.Files.Where(f => f.HasContent))
                                    {
                                        <div class="doc-copies-catalog__file-row">
                                            <span class="doc-copies-catalog__file-name" title="@file.FileName">@file.FileName</span>
                                            <span class="doc-copies-catalog__file-size">@FormatSize(file.SizeBytes)</span>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                </section>
            </div>
        }
    </div>

    @if (Snapshot.ParentId != Guid.Empty)
    {
        <footer class="app-item-doc-copies__footer">
            <div class="app-item-doc-copies__footer-actions">
                <DxButton Text="@ActionRefresh"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          CssClass="app-item-doc-copies__action-btn"
                          Click="@OnRefreshClick" />
            </div>
            <button type="button"
                    class="@GearButtonCssClass"
                    title="@GearToolTip"
                    aria-label="@GearToolTip"
                    aria-pressed="@ShowDetails"
                    @onclick="ToggleDetailsAsync">
                <svg class="cs-multi-select-popup__gear-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81a.488.488 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L2.74 8.87a.488.488 0 0 0 .12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.488.488 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.488.488 0 0 0-.12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 15.6 12 3.6 3.6 0 0 1 12 15.6z" />
                </svg>
            </button>
        </footer>
    }
</div>

@code {
    [Parameter] public HeaderLinkedDocumentsSnapshot Snapshot { get; set; } = new();
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public string UiCultureName { get; set; } = string.Empty;
    [Parameter] public bool UseInlinePreview { get; set; }
    [Parameter] public EventCallback<HeaderDocumentCopiesInlinePreviewRequest> OnInlinePreviewRequested { get; set; }

    [Inject] private IXafCultureInfoService CultureInfoService { get; set; } = null!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;

    private bool ShowDetails;
    private bool _sectionCollapsed = true;
    private Guid _catalogParentId;
    private string? _previewLoadingKey;
    private string _previewStatusMessage = string.Empty;

    private static readonly TimeSpan MinimumPreviewProgressDuration = TimeSpan.FromSeconds(1.5);

    protected override void OnParametersSet()
    {
        if (Snapshot.ParentId != _catalogParentId)
        {
            _catalogParentId = Snapshot.ParentId;
            _sectionCollapsed = true;
        }
    }

    private bool IsAnyPreviewLoading => !string.IsNullOrEmpty(_previewLoadingKey);

    private string EffectiveUiCulture =>
        VisaUiCultureResolver.Resolve(CultureInfoService, HttpContextAccessor.HttpContext, UiCultureName);

    private string Msg(string key) => VisaUiMessages.Get(key, EffectiveUiCulture);

    private string FormatMsg(string key, params object[] args) =>
        VisaUiMessages.FormatForCulture(EffectiveUiCulture, key, args);

    private string HeaderLine
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Snapshot.HeaderTitle))
                return Snapshot.Subtitle ?? string.Empty;

            if (string.IsNullOrWhiteSpace(Snapshot.Subtitle))
                return Snapshot.HeaderTitle;

            return $"{Snapshot.HeaderTitle} — {Snapshot.Subtitle}";
        }
    }

    private string EmptyNoParent => Msg("HeaderDocumentCopies.Empty.NoParent");
    private string EmptyNoRecords => Msg("HeaderDocumentCopies.Empty.NoRecords");
    private string SharedScansHint => Msg("HeaderDocumentCopies.Hint.SharedParentScans");
    private string ActionPreview => Msg("PersonDocumentCopies.Action.Preview");
    private string ActionOpen => Msg("PersonDocumentCopies.Action.Open");
    private string ActionClose => Msg("PersonDocumentCopies.Action.Close");
    private string ActionRefresh => Msg("PersonDocumentCopies.Action.Refresh");
    private string GearToolTip => Msg("PersonDocumentCopies.Action.ShowDetails");
    private string ColumnRecord => Msg("PersonDocumentCopies.Column.Record");
    private string ColumnFiles => Msg("PersonDocumentCopies.Column.Files");
    private string ColumnStatus => Msg("PersonDocumentCopies.Column.Status");
    private string StatusMissing => Msg("PersonDocumentCopies.Status.Missing");
    private string StatusReady => Msg("PersonDocumentCopies.Status.Ready");
    private string DocumentsSectionLabel => Msg("HeaderDocumentCopies.Section.Documents");
    private string SectionExpandLabel => Msg("PersonDocumentCopies.Section.Expand");
    private string SectionCollapseLabel => Msg("PersonDocumentCopies.Section.Collapse");
    private string GearButtonCssClass => ShowDetails
        ? "cs-multi-select-popup__gear-btn cs-multi-select-popup__gear-btn--active"
        : "cs-multi-select-popup__gear-btn";

    private bool IsPreviewLoading(string recordKey) =>
        string.Equals(_previewLoadingKey, recordKey, StringComparison.Ordinal);

    private static int CountFiles(HeaderLinkedDocumentRecord record) =>
        record.Files.Count(file => file.HasContent);

    private string GetSectionSummary()
    {
        var total = Snapshot.Records.Count;
        var withFiles = Snapshot.Records.Count(r => CountFiles(r) > 0);
        if (total == 1)
        {
            if (withFiles > 0)
                return FormatMsg("PersonDocumentCopies.Section.SummaryOneWithFiles", withFiles);
            return Msg("PersonDocumentCopies.Section.SummaryOneNone");
        }

        if (withFiles > 0)
            return FormatMsg("PersonDocumentCopies.Section.Summary", total, withFiles);

        return FormatMsg("PersonDocumentCopies.Section.SummaryNone", total);
    }

    private static string GetRowCssClass(bool hasFiles, bool rowLoading)
    {
        var classes = new List<string> { "doc-copies-catalog__row" };
        if (!hasFiles)
            classes.Add("doc-copies-catalog__row--empty");
        if (hasFiles && !rowLoading)
            classes.Add("doc-copies-catalog__row--clickable");
        if (rowLoading)
            classes.Add("doc-copies-catalog__row--loading");
        return string.Join(' ', classes);
    }

    private async Task OnRowClickAsync(HeaderLinkedDocumentRecord record)
    {
        if (!record.Files.Any(file => file.HasContent) || IsAnyPreviewLoading)
            return;

        await PreviewRecordAsync(record);
    }

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private async Task PreviewRecordAsync(HeaderLinkedDocumentRecord record)
    {
        if (IsAnyPreviewLoading || string.IsNullOrWhiteSpace(record.RecordKey))
            return;

        if (!UseInlinePreview || !OnInlinePreviewRequested.HasDelegate)
            return;

        _previewLoadingKey = record.RecordKey;
        _previewStatusMessage = FormatMsg("ApplicationReportPackage.Preview.Downloading", record.RecordLabel);
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await Task.Delay(100);

        var progressStartedUtc = DateTime.UtcNow;
        var previewSucceeded = false;

        try
        {
            await OnInlinePreviewRequested.InvokeAsync(new HeaderDocumentCopiesInlinePreviewRequest
            {
                Family = Snapshot.Family,
                ParentId = Snapshot.ParentId,
                RecordKey = record.RecordKey,
                DisplayName = record.RecordLabel,
            });
            previewSucceeded = true;
        }
        finally
        {
            if (previewSucceeded)
            {
                var elapsed = DateTime.UtcNow - progressStartedUtc;
                var remaining = MinimumPreviewProgressDuration - elapsed;
                if (remaining > TimeSpan.Zero)
                    await Task.Delay(remaining);
            }

            _previewLoadingKey = null;
            _previewStatusMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnRefreshClick()
    {
        if (RefreshRequested.HasDelegate)
            await RefreshRequested.InvokeAsync();
    }

    private Task ToggleDetailsAsync()
    {
        ShowDetails = !ShowDetails;
        return InvokeAsync(StateHasChanged);
    }

    private Task ToggleSectionNavAsync()
    {
        _sectionCollapsed = !_sectionCollapsed;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnSectionNavKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            return ToggleSectionNavAsync();

        return Task.CompletedTask;
    }
}
