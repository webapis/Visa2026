                                <button type="button" class="os-btn os-btn--primary" @onclick="StartCaseSummaryEdit">
                                    @Msg("ApplicationProfileInstance.Workspace.EditCaseSummary")
                                </button>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(HeaderFieldStatusMessage))
                {
                    <p class="cw-summary-status @(HeaderFieldStatusIsError ? "is-error" : null)">@HeaderFieldStatusMessage</p>
                }
                @if (view.HeaderFields.Count == 0 && view.SummaryTiles.Count == 0)
                {
                    <p class="cw-summary-empty">@Msg("ApplicationProfileInstance.Picker.NoRequiredProps")</p>
                }
                else if (IsCaseSummaryEditing && view.HeaderFields.Count > 0)
                {
                    var identityFields = IdentityHeaderFields(view.HeaderFields);
                    var mainFields = MainHeaderFields(view.HeaderFields);
                    <div class="cw-summary-body @(mainFields.Count == 0 ? "cw-summary-body--identity-only" : null)">
                        @if (mainFields.Count > 0)
                        {
                            <div class="cw-summary-main">
                                <div class="cw-summary-form">
                                    @foreach (var field in mainFields)
                                    {
                                        @RenderSummaryField(field)
                                    }
                                </div>
                            </div>
                        }
                        @if (identityFields.Count > 0)
                        {
                            <aside class="cw-summary-identity" aria-label="@Msg("ApplicationProfileInstance.Workspace.IdentityAria")">
                                <div class="cw-summary-form cw-summary-form--stack">
                                    @foreach (var field in identityFields)
                                    {
                                        @RenderSummaryField(field)
                                    }
                                </div>
                            </aside>
                        }
                    </div>
                    <p class="cw-summary-foot">@Msg("ApplicationProfileInstance.Workspace.SummaryFoot")</p>
                }
                else
                {
                    var tiles = OverviewTiles(view).ToList();
                    var identityTiles = IdentityTiles(tiles);
                    var mainTiles = MainTiles(tiles);
                    <div class="cw-summary-body @(mainTiles.Count == 0 ? "cw-summary-body--identity-only" : null)">
                        @if (mainTiles.Count > 0)
                        {
                            <div class="cw-summary-main">
                                <div class="cw-summary-grid">
                                    @foreach (var field in mainTiles)
                                    {
                                        @RenderSummaryTile(field)
                                    }
                                </div>
                            </div>
                        }
                        @if (identityTiles.Count > 0)
                        {
                            <aside class="cw-summary-identity" aria-label="@Msg("ApplicationProfileInstance.Workspace.IdentityAria")">
                                <div class="cw-summary-grid cw-summary-grid--stack">
                                    @foreach (var field in identityTiles)
                                    {
                                        @RenderSummaryTile(field)
                                    }
                                </div>
                            </aside>
                        }
                    </div>
                }
            </section>
            <p class="cw-foot">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ProfileNamed", string.IsNullOrWhiteSpace(view.Chrome.ProfileTemplateName) ? Snapshot!.Profile.Title : view.Chrome.ProfileTemplateName)</p>
        </div>;
    };

    private RenderFragment RenderApplicationResult(ApplicationWorkspaceCaseView view) => __builder =>
    {
        var issuedTiles = HybridIssuedTiles(view);
        var selectedIssued = issuedTiles.FirstOrDefault(t =>
            string.Equals(t.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase))
            ?? issuedTiles.FirstOrDefault();
        var resultTotals = ApplicationWorkspaceIssuedResultOverview.Sum(issuedTiles);
        <div class="cw-overview">
            @if (issuedTiles.Count == 0)
            {
                <section class="cw-card">
                    <h2 class="cw-card__title">@Msg("ApplicationProfileInstance.Workspace.ApplicationResult")</h2>
                    <p class="cw-summary-empty">@Msg("ApplicationProfileInstance.Workspace.ApplicationResultEmpty")</p>
                </section>
            }
            else
            {
            <section class="cw-card cw-result-board">
                @{
                    var resultComplete = resultTotals.Missing == 0;
                }
                <header class="cw-result-board__head">
                    <div>
                        <h2 class="cw-card__title">@Msg("ApplicationProfileInstance.Workspace.ApplicationResultOverview")</h2>
                        <p class="cw-card__sub">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ApplicationResultOverviewSub", view.PeopleSummary.Total)</p>
                    </div>
                    <span class="cw-result-board__badge @(resultComplete ? "is-ok" : "is-miss")">
                        @(resultComplete
                            ? Msg("ApplicationProfileInstance.Workspace.CompleteApplicationResult")
                            : VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ApplicationResultIssuedMissing", resultTotals.Issued, resultTotals.Missing))
                    </span>
                </header>
                <div class="cw-result-types">
                    @foreach (var tile in issuedTiles)
                    {
                        var missing = ApplicationWorkspaceIssuedResultOverview.Missing(tile);
                        var typePct = ApplicationWorkspaceIssuedResultOverview.CoveragePercent(tile);
                        var typeClass = tile.IsOptional
                            ? "cw-result-type--optional"
                            : missing > 0 ? "cw-result-type--miss" : "cw-result-type--ok";
                        <article class="cw-result-type cw-result-type--@tile.Tone @typeClass">
                            <span class="cw-result-type__top">
                                <span class="cw-result-type__icon">@tile.Glyph</span>
                                <span class="cw-result-type__label">@ApplicationProfileLocalization.IssuedRecordLabel(tile.Label)</span>
                                <span class="cw-result-type__pill">@(tile.IsOptional
                                    ? Msg("ApplicationProfileInstance.Workspace.ApplicationResultOptional")
                                    : missing > 0
                                        ? Msg("ApplicationProfileInstance.Workspace.ApplicationResultMissing")
                                        : Msg("ApplicationProfileInstance.Workspace.ApplicationResultIssued"))</span>
                            </span>
                            <span class="cw-result-type__figures">
                                <strong class="cw-result-type__ratio">@(tile.IsOptional ? tile.CoverageCount.ToString() : $"{tile.CoverageCount} / {tile.ExpectedCount}")</strong>
                                <span class="cw-result-type__pct">@typePct%</span>
                            </span>
                            <span class="cw-result-type__track" aria-hidden="true">
                                <span class="cw-result-type__fill" style="width: @(typePct)%"></span>
                            </span>
                            <span class="cw-result-type__line">@(tile.IsOptional
                                ? VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ApplicationResultOptionalLine", tile.CoverageCount)
                                : VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ApplicationResultIssuedMissing", tile.CoverageCount, missing))</span>
                        </article>
                    }
                </div>
            </section>
            <section class="cw-card cw-result-actions">
                <h2 class="cw-card__title">@Msg("ApplicationProfileInstance.Workspace.ApplicationResultActions")</h2>
                <p class="cw-card__sub">@Msg("ApplicationProfileInstance.Workspace.IssuedSub")</p>
                    <div class="cw-issued-row">
                        @foreach (var tile in issuedTiles)
                        {
                            var isSelected = string.Equals(tile.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase);
                            var canAdd = ApplicationWorkspaceIssuedResultOverview.CanCreateMore(tile);
                            var addCaption = ApplicationProfileLocalization.IssuedAddCaption(tile.AddCaption);
                            var addTitle = canAdd
                                ? addCaption
                                : VisaUiMessages.Format(
                                    "ApplicationProfileInstance.Issued.AddQuotaFull",
                                    ApplicationProfileLocalization.IssuedRecordLabel(tile.Label));
                            <div class="cw-issued-btn cw-issued-btn--@tile.Tone @(tile.Count == 0 ? "is-empty" : null) @(isSelected ? "is-selected" : null) @(!canAdd ? "is-quota-full" : null)">
                                <button type="button"
                                        class="cw-issued-btn__select"
                                        @onclick="() => SelectIssuedTile(tile.Key)">
                                    <span class="cw-issued-btn__icon">@tile.Glyph</span>
                                    <span class="cw-issued-btn__copy">
                                        <span class="cw-issued-btn__label">@ApplicationProfileLocalization.IssuedRecordLabel(tile.Label)</span>
                                        <strong class="cw-issued-btn__count">@(tile.Count == 0 ? "—" : tile.Count.ToString())</strong>
                                    </span>
                                </button>
                                <button type="button"
                                        class="cw-issued-btn__cta"
                                        title="@addTitle"
                                        disabled="@(!canAdd)"
                                        @onclick="() => AddIssuedHeaderAsync(tile)">
                                    @addCaption
                                </button>
                            </div>
                        }
                    </div>
                    @if (selectedIssued != null)
                    {
                        <div class="cw-issued-panel">
                            <h3 class="cw-issued-panel__title">@ApplicationProfileLocalization.IssuedPanelTitle(selectedIssued.PanelTitle)</h3>
                            @if (selectedIssued.Count == 0)
                            {
                                <p class="cw-issued-panel__hint">@IssuedEmptyHint(view, selectedIssued)</p>
                            }
                            else
                            {
                                <ul class="cw-issued-list @(selectedIssued.ColumnKeys.Count > 0 ? "cw-issued-list--table" : null)"
                                    style="@(selectedIssued.ColumnKeys.Count > 0 ? $"--issued-cols:{selectedIssued.ColumnKeys.Count}" : null)">
                                    @if (selectedIssued.ColumnKeys.Count > 0)
                                    {
                                        <li class="cw-issued-list__head" aria-hidden="true">
                                            @foreach (var columnKey in selectedIssued.ColumnKeys)
                                            {
                                                <span>@IssuedColumnCaption(columnKey)</span>
                                            }
                                            <span></span>
                                            <span></span>
                                        </li>
                                    }
                                    @foreach (var row in selectedIssued.Rows)
                                    {
                                        var issuedRowId = row.Id;
                                        var issuedCatalogKey = selectedIssued.Key;
                                        var issuedTitle = row.Title;
                                        var canDeleteIssued = IssueIssuedHeaderComposeService.TryResolveKind(issuedCatalogKey, out _);
                                        var isIssuedVisa = string.Equals(
                                            issuedCatalogKey,
                                            ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa,
                                            StringComparison.OrdinalIgnoreCase);
                                        var canPreviewIssued = canDeleteIssued || isIssuedVisa;
                                        var issuedRowOpen = IsIssuedRowOpen(issuedCatalogKey, issuedRowId);
                                        @if (row.Cells.Count > 0)
                                        {
                                            <li class="cw-issued-list__row cw-issued-list__row--cols @(issuedRowOpen ? "is-selected" : null)"
                                                @onclick="() => OpenIssuedHeaderAsync(issuedCatalogKey, issuedRowId)">
                                                @foreach (var cell in row.Cells)
                                                {
                                                    <span>@cell</span>
                                                }
                                                @if (canPreviewIssued)
                                                {
                                                    <button type="button"
                                                            class="cw-issued-list__preview"
                                                            title="@(row.HasCopy ? Msg("ApplicationProfileInstance.Workspace.PreviewCopy") : Msg("ApplicationProfileInstance.Workspace.NoCopy"))"
                                                            disabled="@(!row.HasCopy)"
                                                            @onclick="() => PreviewIssuedHeaderCopyAsync(issuedCatalogKey, issuedRowId)"
                                                            @onclick:stopPropagation="true">
                                                        @Msg("ApplicationItemDocumentCopies.Action.Preview")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span></span>
                                                }
                                                @if (canDeleteIssued || isIssuedVisa)
                                                {
                                                    <button type="button"
                                                            class="cw-issued-list__delete"
                                                            title="@Msg("ApplicationProfileInstance.Workspace.Delete")"
                                                            @onclick="() => DeleteIssuedHeaderAsync(issuedCatalogKey, issuedRowId, issuedTitle)"
                                                            @onclick:stopPropagation="true">
                                                        @Msg("ApplicationProfileInstance.Workspace.Delete")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span></span>
                                                }
                                            </li>
                                        }
                                        else
                                        {
                                        <li class="cw-issued-list__row @(issuedRowOpen ? "is-selected" : null)">
                                            <button type="button"
                                                    class="cw-issued-list__item"
                                                    aria-current="@(issuedRowOpen ? "true" : null)"
                                                    @onclick="() => OpenIssuedHeaderAsync(issuedCatalogKey, issuedRowId)">
                                                <strong>@issuedTitle</strong>
                                                <span>@row.Subtitle</span>
                                            </button>
                                            @if (canPreviewIssued)
                                            {
                                                <button type="button"
                                                        class="cw-issued-list__preview"
                                                        title="@(row.HasCopy ? Msg("ApplicationProfileInstance.Workspace.PreviewCopy") : Msg("ApplicationProfileInstance.Workspace.NoCopy"))"
                                                        disabled="@(!row.HasCopy)"
                                                        @onclick="() => PreviewIssuedHeaderCopyAsync(issuedCatalogKey, issuedRowId)"
                                                        @onclick:stopPropagation="true">
                                                    @Msg("ApplicationItemDocumentCopies.Action.Preview")
                                                </button>
                                            }
                                            @if (canDeleteIssued || isIssuedVisa)
                                            {
                                                <button type="button"
                                                        class="cw-issued-list__delete"
                                                        title="@Msg("ApplicationProfileInstance.Workspace.Delete")"
                                                        @onclick="() => DeleteIssuedHeaderAsync(issuedCatalogKey, issuedRowId, issuedTitle)"
                                                        @onclick:stopPropagation="true">
                                                    @Msg("ApplicationProfileInstance.Workspace.Delete")
                                                </button>
                                            }
                                        </li>
                                        }
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrWhiteSpace(_issuedDeleteError))
                            {
                                <p class="cw-issued-panel__error">@_issuedDeleteError</p>
                            }
                        </div>
                    }
            </section>
            }
        </div>;
    };

