    private void ReleaseCaseNav()
    {
        if (!_caseNavHeld)
            return;

        _caseNavHeld = false;
        try
        {
            _ = JS.InvokeVoidAsync("visaCaseWorkspaceNav.release");
        }
        catch (InvalidOperationException)
        {
            // Circuit already gone.
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private void OnPreviewSlotStateChanged()
    {
        var mode = PreviewSlotService.State.Mode;
        var previous = _previewSlotMode;
        _previewSlotMode = mode;

        // Resminamalar preview lives in #visa-preview-slot. Re-rendering the case workspace
        // rebuilds the 17-row catalog on the same circuit and makes open/close feel stuck.
        // Still refresh when Linked records is open so the dialog can shift beside the slot.
        if (mode == VisaPreviewSlotMode.Resminamalar && !ShowPersonLinkReview)
            return;
        if (mode == VisaPreviewSlotMode.Closed && previous == VisaPreviewSlotMode.Resminamalar && !ShowPersonLinkReview)
            return;

        EnsureLinkReviewBesidePreview();
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsIssuedRowOpen(string catalogKey, Guid rowId)
    {
        if (rowId == Guid.Empty || Snapshot == null)
            return false;

        var state = PreviewSlotService.State;
        var instanceId = Snapshot.ApplicationProfileInstanceId;

        if (state.Mode == VisaPreviewSlotMode.IssueIssuedHeader)
        {
            var request = state.IssueIssuedHeader;
            if (request == null
                || request.ApplicationProfileInstanceId != instanceId
                || request.ExistingHeaderId != rowId)
            {
                return false;
            }

            return IssueIssuedHeaderComposeService.TryResolveKind(catalogKey, out var kind)
                && request.Kind == kind;
        }

        if (state.Mode == VisaPreviewSlotMode.HeaderDocumentCopies)
        {
            var copies = state.HeaderDocumentCopies;
            if (copies == null || copies.ParentId != rowId)
                return false;

            return ApplicationWorkspaceIssuedRecordsCatalog.TryGetDocumentCopiesFamily(catalogKey, out var family)
                && copies.Family == family;
        }

        if (state.Mode == VisaPreviewSlotMode.IssueIssuedVisa)
        {
            var visaRequest = state.IssueIssuedVisa;
            return visaRequest != null
                && visaRequest.ApplicationProfileInstanceId == instanceId
                && visaRequest.ExistingVisaId == rowId
                && string.Equals(catalogKey, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    protected override void OnParametersSet()
    {
        if (ShowPersonLinkReview && !_reviewWasOpen)
        {
            _reviewGearOn = false;
            _reviewTab = "overview";
            _reviewCreating = false;
            _linkReviewUserPositioned = false;
            _linkReviewPosX = null;
            _linkReviewPosY = null;
            EnsureLinkReviewBesidePreview();
        }

        _reviewWasOpen = ShowPersonLinkReview;

        var instanceId = Snapshot?.ApplicationProfileInstanceId ?? Guid.Empty;
        if (instanceId != _caseSummaryInstanceId)
        {
            _caseSummaryInstanceId = instanceId;
            _caseSummaryEditing = false;
            _summarySaving = false;
            _pendingHeaders.Clear();
            _headerOriginals = null;
            _boundHeaderFields = null;
            _organizationEditing = false;
            _documentCopiesCompletenessKey = null;
            _documentCopiesNavReady = false;
            _documentCopiesLoadAttempted = false;
        }

        SyncDocumentPeopleFilter(Snapshot?.CaseView);
        SyncPeopleRecordFocus();

        // Dropdown catalogs load when Edit opens. Later saves must not replace the page.
        if (_caseSummaryEditing)
        {
            EnsureHeaderLookupCatalogs();
            ReapplyPendingHeaderFields();
            ApplyStagedHeaderSelection();
        }
        else
        {
            _boundHeaderFields = Snapshot?.CaseView.HeaderFields;
        }

        if (_caseSummaryEditing
            && !_summarySaving
            && !string.Equals(ActiveTab, "overview", StringComparison.OrdinalIgnoreCase))
            DiscardCaseSummaryDraft();
        if (_organizationEditing)
            EnsureOrganizationCatalogOptions();

        if (!ApplicationWorkspaceCaseSummaryCompletenessGate.BlocksProcessNavigation(Snapshot?.CaseView))
            _blockedSectionLabel = null;

        if (ApplicationWorkspaceCaseSummaryCompletenessGate.BlocksTab(Snapshot?.CaseView, ActiveTab)
            && CaseTabChanged.HasDelegate
            && !_tabSwitching)
        {
            RememberBlockedSection(ActiveTab);
            _ = CaseTabChanged.InvokeAsync("overview");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_caseNavHeld)
        {
            try
            {
                await JS.InvokeVoidAsync("visaCaseWorkspaceNav.hold");
                _caseNavHeld = true;
            }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

        if (!IsLoading && Snapshot != null && !_documentCopiesNavReady && !_documentCopiesLoadAttempted)
        {
            _documentCopiesLoadAttempted = true;
            EnsureDocumentCopiesCompleteness(Snapshot.CaseView);
            if (_documentCopiesNavReady)
                await InvokeAsync(StateHasChanged);
        }

        if (_peopleActionMenuNeedsPlace && (_peopleDocMenuOpen || _peopleResmiMenuOpen))
        {
            _peopleActionMenuNeedsPlace = false;
            await PlaceOpenPeopleActionMenuAsync();
        }

        if (!_tabSwitching || !_tabContentReady)
            return;

        if (_resminamalarCatalogPending
            && string.Equals(ActiveTab, "resminamalar", StringComparison.OrdinalIgnoreCase))
            return;

        _tabSwitching = false;
        _pendingTab = null;
        await InvokeAsync(StateHasChanged);
    }

