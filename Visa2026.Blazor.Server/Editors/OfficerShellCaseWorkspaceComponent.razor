    private Guid _addressEditorId;
    private string? _addressActionError;

    private sealed record PersonLinkedRow(IReadOnlyList<string> Cells, Guid LinkedObjectId, bool OfferCaseAddress);

    private IReadOnlyList<PersonLinkedRow> PersonLinkedRows(ApplicationWorkspaceCasePerson person, string recordKey)
    {
        var tab = FindLinkedTab(recordKey);
        if (tab == null || tab.Rows.Count == 0)
            return Array.Empty<PersonLinkedRow>();

        var rows = new List<PersonLinkedRow>();
        if (person.PersonId != Guid.Empty && tab.RowPersonIds.Count == tab.Rows.Count)
        {
            for (var i = 0; i < tab.Rows.Count; i++)
            {
                if (tab.RowPersonIds[i] != person.PersonId)
                    continue;
                var linkedId = i < tab.RowLinkedObjectIds.Count ? tab.RowLinkedObjectIds[i] : Guid.Empty;
                var offer = i < tab.RowOfferCaseAddress.Count && tab.RowOfferCaseAddress[i];
                rows.Add(new PersonLinkedRow(LinkedRecordCells(tab, tab.Rows[i]), linkedId, offer));
            }
            return rows;
        }

        foreach (var row in tab.Rows.Where(row => row.Count > 0
                     && string.Equals(row[0], person.Name, StringComparison.Ordinal)))
        {
            rows.Add(new PersonLinkedRow(LinkedRecordCells(tab, row), Guid.Empty, false));
        }
        return rows;
    }

