    /// <summary>
    /// Primary linked value(s) for the people table: first data column from the workspace tab,
    /// stacked for Last-N (plain text). Empty → —.
    /// </summary>
    private bool TryGetPeopleDocUploadTarget(
        ApplicationWorkspaceCasePerson person,
        ApplicationWorkspaceCasePersonRecord? record,
        out ApplicationProfileInstancePersonLinkKind kind,
        out Guid sourceObjectId)
    {
        kind = default;
        sourceObjectId = Guid.Empty;
        if (person.PersonId == Guid.Empty || record == null || record.IsCaptionOnly || record.Count <= 0)
            return false;

        var mapped = PersonLinkedDocumentUploadService.TryMapPeopleRecordKey(record.Key);
        if (mapped == null || !PersonLinkedDocumentUploadService.SupportsLinkKind(mapped.Value))
            return false;

        kind = mapped.Value;
        var rows = PersonLinkedRows(person, record.Key);
        sourceObjectId = rows.Select(r => r.LinkedObjectId).FirstOrDefault(id => id != Guid.Empty);
        if (sourceObjectId == Guid.Empty)
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<Person>();
            var loaded = objectSpace.GetObjectByKey<Person>(person.PersonId);
            var resolved = loaded == null
                ? null
                : PersonLinkedDocumentUploadService.ResolvePreferredSourceObjectId(loaded, kind);
            if (resolved is not Guid id || id == Guid.Empty)
                return false;
            sourceObjectId = id;
        }

        return true;
    }

    private bool PeopleDocHasScans(ApplicationProfileInstancePersonLinkKind kind, Guid sourceObjectId)
    {
        if (sourceObjectId == Guid.Empty)
            return false;
        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<Person>();
        return PersonLinkedDocumentUploadService.HasScanFiles(objectSpace, kind, sourceObjectId);
    }

    private async Task OpenPeopleDocNusgaAsync(
        ApplicationWorkspaceCasePerson person,
        ApplicationProfileInstancePersonLinkKind kind,
        Guid sourceObjectId,
        ApplicationWorkspaceCasePersonRecord? record)
    {
        if (person.PersonId == Guid.Empty || sourceObjectId == Guid.Empty)
            return;

        ClosePeoplePreviewMenus();
        await InvokeAsync(StateHasChanged);

        var label = record == null
            ? kind.ToString()
            : ApplicationProfileLocalization.LinkedRecordLabel(record.Label);
        var recordKey = PersonLinkedDocumentUploadService.BuildRecordKey(kind, sourceObjectId);
        await PreviewSlotService.OpenPersonDocumentCopiesAsync(
            new PersonDocumentCopiesSlotRequest
            {
                PersonIds = new[] { person.PersonId },
                FocusRecordKey = recordKey,
                FocusDisplayName = label,
                OpenPreviewOnly = true,
                AllowEditFiles = true,
                UploadPersonId = person.PersonId,
                UploadLinkKind = kind,
                UploadSourceObjectId = sourceObjectId,
            },
            PreviewSlotOwnerViewId);
    }
    private string FormatPeopleLinkCell(
        ApplicationWorkspaceCasePerson person,
        ApplicationWorkspaceCasePersonRecord? record)
    {
        if (record is null)
            return "—";
        if (record.IsCaptionOnly)
            return string.IsNullOrWhiteSpace(record.Caption) ? "—" : record.Caption;

        var rows = PersonLinkedRows(person, record.Key);
        if (rows.Count == 0)
            return "—";

        var lines = new List<string>();
        foreach (var row in rows)
        {
            var primary = row.Cells.Count > 0 ? row.Cells[0]?.Trim() : null;
            if (string.IsNullOrWhiteSpace(primary) || primary == "—")
                continue;
            if (!lines.Contains(primary, StringComparer.OrdinalIgnoreCase))
                lines.Add(primary);
        }

        return lines.Count == 0 ? "—" : string.Join("\n", lines);
    }

    private static string PersonColor(int index) => PersonColors[index % PersonColors.Length];

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);
