    private List<PeoplePreviewMenuItem> BuildDocumentSectionMenuItems(IReadOnlyList<Guid> personIds)
    {
        if (personIds.Count == 0)
            return [];

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var applicationId = Snapshot?.ApplicationProfileInstanceId ?? Guid.Empty;
        var application = applicationId == Guid.Empty
            ? null
            : objectSpace.GetObjectsQuery<ApplicationProfileInstance>()
                .Include(item => item.ApplicationProfile)
                .FirstOrDefault(item => item.ID == applicationId);
        var profile = application?.ApplicationProfile;
        var allowed = PersonDocumentCopiesProfileSectionFilter.GetAllowedPersonSectionIds(profile);
        if (allowed.Count == 0)
            return [];

        var menuIds = PersonDocumentCopiesProfileSectionFilter.ExpandPeopleMenuSectionIds(allowed);
        var hasFilesByCatalog = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var personId in personIds)
        {
            var person = objectSpace.GetObjectByKey<Person>(personId);
            if (person == null)
                continue;

            var snapshot = PersonLinkedDocumentsResolver.Resolve(objectSpace, person);
            foreach (var section in snapshot.Sections.OrderBy(s => s.SortOrder))
            {
                if (!PersonDocumentCopiesProfileSectionFilter.IsPersonSectionAllowed(profile, section.SectionId))
                    continue;

                if (section.Records.Any(r => r.Files.Any(f => f.HasContent)))
                    hasFilesByCatalog.Add(section.SectionId);
            }
        }

        var items = new List<PeoplePreviewMenuItem>();
        foreach (var menuId in menuIds)
        {
            var catalogId = PersonDocumentCopiesProfileSectionFilter.NormalizeCatalogSectionId(menuId);
            items.Add(new PeoplePreviewMenuItem(
                menuId,
                ToTitleCaseLabel(PersonDocumentCopiesProfileSectionFilter.PersonSectionLabel(menuId)),
                personIds[0],
                HasFiles: hasFilesByCatalog.Contains(catalogId)));
        }

        return items;
    }

    private List<PeoplePreviewMenuItem> BuildResminamalarMenuItems(Guid applicationId, IReadOnlyList<Guid> personIds)
    {
        if (applicationId == Guid.Empty || personIds.Count == 0)
            return [];

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var application = objectSpace.GetObjectsQuery<ApplicationProfileInstance>()
            .Include(item => item.ProjectContract)
            .Include(item => item.MigrationService)
            .Include(item => item.ApplicationProfile)
            .FirstOrDefault(item => item.ID == applicationId);
        if (application == null)
            return [];

        var catalog = WordReportCatalogService.Build(
            objectSpace,
            application,
            WordReportGenerationContext.ForRosterPersons(personIds));

        return catalog.Entries
            .OrderBy(entry => entry.SortOrder)
            .ThenBy(entry => entry.DisplayName, StringComparer.OrdinalIgnoreCase)
            .Select(entry => new PeoplePreviewMenuItem(
                entry.EntryKey,
                ToTitleCaseLabel(string.IsNullOrWhiteSpace(entry.DisplayName) ? entry.EntryKey : entry.DisplayName),
                Guid.Empty,
                FocusEntryKey: entry.EntryKey))
            .ToList();
    }

