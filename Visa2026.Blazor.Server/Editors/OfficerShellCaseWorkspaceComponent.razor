        var label = string.IsNullOrWhiteSpace(number)
            ? Msg("ApplicationProfileInstance.Workspace.CaseWorkspace")
            : $"№ {number}";
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ConfirmDelete", label));
        }
        catch (JSException)
        {
            return;
        }
        catch (InvalidOperationException)
        {
            return;
        }

        if (confirmed)
            await DeleteCaseRequested.InvokeAsync();
    }
