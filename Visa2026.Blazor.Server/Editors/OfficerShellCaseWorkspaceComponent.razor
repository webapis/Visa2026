    private bool TryBlockIncompleteProcessWork(string? tabKey = null)
    {
        var view = Snapshot?.CaseView;
        var blocked = tabKey == null
            ? ApplicationWorkspaceCaseSummaryCompletenessGate.BlocksProcessNavigation(view)
            : ApplicationWorkspaceCaseSummaryCompletenessGate.BlocksTab(view, tabKey);
