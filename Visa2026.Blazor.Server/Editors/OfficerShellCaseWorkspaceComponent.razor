                                    @if (rows.Count == 0)
                                    {
                                        <p class="cw-issued-panel__hint">@(tab?.EmptyMessage ?? $"No {selected.Label.ToLowerInvariant()} linked for {person.Name}.")</p>
                                    }
                                    else
                                    {
                                        <table class="os-table">
                                            <thead>
                                                <tr>
                                                    @foreach (var column in columns)
                                                    {
                                                        <th>@column</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in rows)
                                                {
                                                    <tr>
                                                        @foreach (var cell in LinkedRecordCells(tab, row))
                                                        {
                                                            <td>@cell</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    @if (view.Chrome.ResolvedLinksLocked)
                                    {
                                        <div class="cw-issued-panel__actions">
                                            <p class="cw-issued-panel__hint">People and linked records are locked on this case.</p>
                                        </div>
                                    }
                                    else if (IsIssuedPersonItem(selected.Key))
                                    {
                                        <div class="cw-issued-panel__actions">
                                            <p class="cw-issued-panel__hint">Create this from Overview → Issued records, then it can link to this person.</p>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </section>
                }
            }
        </div>;
    };

    private RenderFragment RenderSla(ApplicationWorkspaceCaseView view) => __builder =>
    {
        var sla = view.Sla;
        var complete = sla.IsTerminal;
        var caseRemaining = sla.CaseDaysRemaining;
        var stepRemaining = sla.CurrentStepDaysRemaining;
        var casePct = complete ? 100 : SlaRemainingPercent(caseRemaining, sla.TotalSlaDays);
        var stepPct = complete ? 100 : SlaRemainingPercent(stepRemaining, Math.Max(stepRemaining ?? 0, 14));
        var stepTitle = string.IsNullOrWhiteSpace(sla.CurrentStepLabel) ? "Current step" : sla.CurrentStepLabel;
        var stepDue = SlaDisplayDate(sla.CurrentStepDueDate);
        var started = SlaDisplayDate(sla.StartedOn);
        var ministryDue = SlaDisplayDate(sla.MinistryDueDate);
        var expected = SlaDisplayDate(sla.ExpectedCompletionDate);
        var migrationDays = sla.MigrationSlaLabel.Split(' ').FirstOrDefault() ?? "—";
        var caseStatusClass = complete ? "ct-sla-tone ct-sla-tone--ok" : SlaToneClass(caseRemaining);
        var stepStatusClass = complete ? "ct-sla-tone ct-sla-tone--ok" : SlaToneClass(stepRemaining);
        var caseRingClass = complete ? "ct-sla-ring--ok ct-sla-ring--done" : SlaRingTone(caseRemaining);
        var stepRingClass = complete ? "ct-sla-ring--ok ct-sla-ring--done" : SlaRingTone(stepRemaining);
        var caseValue = complete ? "Done" : (caseRemaining?.ToString() ?? "—");
        var stepValue = complete ? "Done" : (stepRemaining?.ToString() ?? "—");
        var caption = complete ? "complete" : "days left";
        var caseLabel = complete ? sla.CaseStatus : SlaToneLabel(caseRemaining);
        var stepStatusText = complete ? sla.CaseStatus : SlaToneLabel(stepRemaining);
        var stepHint = complete ? "No open deadline" : (stepDue == "—" ? "No due date yet" : "Due " + stepDue);
        var midTitle = complete ? "Completed" : "Current due";
        var midDate = complete ? expected : ministryDue;
        var endTitle = complete ? "Finished" : "Expected completion";
        <div class="ct-page ct-sla">
            <header class="ct-sla-head">
                <h2 class="ct-page__title">SLA &amp; deadlines</h2>
                <p class="ct-page__sub">Working days against the profile template. Dates in UTC+5 (Ashgabat).</p>
            </header>
            <div class="ct-sla-metrics">
                <article class="ct-sla-metric">
                    <h3>Overall case</h3>
                    <div class="ct-sla-metric__body">
                        <div class="ct-sla-gauge">
                            <div class="ct-sla-ring ct-sla-ring--lg @caseRingClass" style="--ct-pct:@casePct%" role="img" aria-label="@caseLabel">
                                <strong>@caseValue</strong>
                            </div>
                            <span class="ct-sla-gauge__caption">@caption</span>
                        </div>
                        <dl class="ct-sla-stats">
                            <div><dt>Total SLA</dt><dd>@sla.TotalSlaDays days</dd></div>
                            <div><dt>Elapsed</dt><dd>@sla.ElapsedDays days</dd></div>
                            <div><dt>Status</dt><dd class="@caseStatusClass">@caseLabel</dd></div>
                        </dl>
                    </div>
                </article>
                <article class="ct-sla-metric">
                    <h3>@stepTitle</h3>
                    <p class="ct-sla-metric__hint">@stepHint</p>
                    <div class="ct-sla-metric__body">
                        <div class="ct-sla-gauge">
                            <div class="ct-sla-ring @stepRingClass" style="--ct-pct:@stepPct%" role="img" aria-label="@stepStatusText">
                                <strong>@stepValue</strong>
                            </div>
                            <span class="ct-sla-gauge__caption">@caption</span>
                        </div>
                        <dl class="ct-sla-stats">
                            <div><dt>Status</dt><dd class="@stepStatusClass">@stepStatusText</dd></div>
                        </dl>
                    </div>
                </article>
                <article class="ct-sla-metric">
                    <h3>Profile SLA</h3>
                    <p class="ct-sla-metric__hint">Configured on template</p>
                    <div class="ct-sla-metric__body ct-sla-metric__body--stack">
                        <p class="ct-sla-metric__big">@migrationDays <span>days</span></p>
                        <p class="ct-muted">@(string.IsNullOrWhiteSpace(sla.ProfileSlaSource) ? "Profile template" : sla.ProfileSlaSource)</p>
                    </div>
                </article>
            </div>
            <div class="ct-sla-timeline" aria-label="Case timeline">
                <div class="ct-sla-timeline__node">
                    <span class="ct-sla-timeline__dot" aria-hidden="true"></span>
                    <strong>Started</strong>
                    <span>@started</span>
                </div>
                <div class="ct-sla-timeline__node">
                    <span class="ct-sla-timeline__dot @(complete ? "ct-sla-timeline__dot--muted" : null)" aria-hidden="true"></span>
                    <strong>@midTitle</strong>
                    <span>@midDate</span>
                </div>
                <div class="ct-sla-timeline__node">
                    <span class="ct-sla-timeline__dot ct-sla-timeline__dot--muted" aria-hidden="true"></span>
                    <strong>@endTitle</strong>
                    <span>@expected</span>
                </div>
            </div>
            <div class="ct-sla-lower">
                <div class="ct-sla-table-wrap">
                    <h3>SLA by step</h3>
                    <table class="os-table">
                        <thead><tr><th>Step</th><th>Due date</th><th>Days left</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var row in sla.Deadlines)
                            {
                                <tr class="@(row.IsCurrent ? "ct-sla-row--current" : null)">
                                    <td>@if (row.IsCurrent) { <strong>@row.Step</strong> } else { @row.Step }</td>
                                    <td>@SlaDisplayDate(row.DueDate)</td>
                                    <td class="@(row.Status is "inprogress" or "overdue" ? (row.Status == "overdue" ? "ct-sla-days--due" : "ct-sla-days--ok") : null)">@SlaDisplayDate(row.DaysLeft)</td>
                                    <td><span class="os-status os-status--@SlaStatusClass(row.Status)">@SlaStatusLabel(row.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="ct-sla-aside">
                    @if (!string.IsNullOrWhiteSpace(sla.AlertMessage))
                    {
                        <div class="ct-sla-alert" role="status">
                            <div>
                                <strong>Deadline approaching</strong>
                                <p>@sla.AlertMessage</p>
                            </div>
                        </div>
                    }
                    <div class="ct-sla-source">
                        <h4>SLA source</h4>
                        <p>@(string.IsNullOrWhiteSpace(sla.ProfileSlaSource) ? "Profile template" : sla.ProfileSlaSource)</p>
                        <p class="ct-muted">Migration SLA <strong>@sla.TotalSlaDays days</strong></p>
                    </div>
                </div>
            </div>
        </div>;
    };

    private RenderFragment RenderRail(ApplicationWorkspaceCaseView view) => __builder =>
    {
        @switch (ActiveTab)
        {
            case "overview":
                <section class="cw-rail-block">
                    <h4>Readiness</h4>
                    <ul class="cw-checklist">
                        <li>✓ Required data complete</li>
                        <li>✓ BO states valid</li>
                    </ul>
                </section>
                <section class="cw-rail-block">
                    <h4>Quick actions</h4>
                    <button type="button" class="cw-rail-btn" @onclick='() => SelectTab("documents")'>📂 Open document copies</button>
                    <button type="button" class="cw-rail-btn" @onclick='() => SelectTab("resminamalar")'>📦 Generate Resminamalar package</button>
                    @if (view.IssuedRecordTiles.Count > 0)
                    {
                        <button type="button" class="cw-rail-btn" @onclick="IssueRecordQuickAction">＋ Issue record…</button>
                    }
                    <button type="button" class="cw-rail-btn cw-rail-btn--primary" @onclick="AdvanceProgressAsync">▶ Advance progress</button>
                    @if (CanRevertFromRail)
                    {
                        <button type="button" class="cw-rail-btn" @onclick="RevertProgressAsync">◀ Revert progress</button>
                    }
                </section>
                <section class="cw-rail-block">
                    <h4>Activity</h4>
                    <ul class="cw-timeline">
                        @foreach (var item in view.Activities)
                        {
                            <li><strong>@item.Title</strong><span>@item.Subtitle</span></li>
                        }
                    </ul>
                </section>
                break;
            case "people":
                <section class="cw-rail-block">
                    <h4>People summary</h4>
                    <ul class="ct-summary-list">
                        <li><span>Total</span><strong>@view.PeopleSummary.Total</strong></li>
                        <li><span>Primary</span><strong>@view.PeopleSummary.Primary</strong></li>
                        <li><span>Dependents</span><strong>@view.PeopleSummary.Dependents</strong></li>
                        <li><span>Sponsors</span><strong>@view.PeopleSummary.Sponsors</strong></li>
                    </ul>
                </section>
                <section class="cw-rail-block">
                    <h4>Linked records summary</h4>
                    <ul class="ct-summary-list">
                        @foreach (var pair in view.LinkedRecordsSummary.OrderBy(p => p.Key))
                        {
                            <li><span>@pair.Key</span><strong>@pair.Value</strong></li>
                        }
                    </ul>
                </section>
                break;
            case "progress":
                var current = view.ProgressSteps.FirstOrDefault(s => s.State == "current");
                var daysLeft = current?.SlaDaysRemaining;
                var railComplete = view.Sla.IsTerminal;
                var ringPct = railComplete ? 100 : SlaRemainingPercent(daysLeft, Math.Max(daysLeft ?? 0, 14));
                var railRingClass = railComplete ? "ct-sla-ring--ok ct-sla-ring--done" : SlaRingTone(daysLeft);
                var railValue = railComplete ? "Done" : (daysLeft?.ToString() ?? "—");
                var railCaption = railComplete ? "complete" : "days left";
                <section class="cw-rail-block">
                    <h4>SLA for current step</h4>
                    <div class="ct-sla-gauge">
                        <div class="ct-sla-ring @railRingClass" style="--ct-pct:@ringPct%" role="img" aria-label="@railCaption">
                            <strong>@railValue</strong>
                        </div>
                        <span class="ct-sla-gauge__caption">@railCaption</span>
                    </div>
                    @if (current != null)
                    {
                        <ul class="ct-summary-list" style="margin-top:10px">
                            <li><span>Target date</span><strong>@(string.IsNullOrWhiteSpace(current.SlaTargetDate) ? "—" : current.SlaTargetDate)</strong></li>
                        </ul>
                    }
                </section>
                <section class="cw-rail-block">
                    <button type="button" class="os-btn os-btn--primary" style="width:100%;margin-bottom:8px" @onclick="AdvanceProgressAsync">▶ Advance progress</button>
                    @if (CanRevertFromRail)
                    {
                        <button type="button" class="os-btn os-btn--ghost" style="width:100%;margin-bottom:8px" @onclick="RevertProgressAsync">◀ Revert progress</button>
                    }
                </section>
                <section class="cw-rail-block">
                    <h4>History</h4>
                    <ul class="cw-timeline">
                        @foreach (var row in Snapshot!.ProgressHistory)
                        {
                            <li><strong>@row.State</strong><span>@row.Date</span></li>
                        }
                    </ul>
                </section>
                break;
            case "sla":
                break;
        }
    };

    private static string SlaStatusClass(string status) => status switch
    {
        "completed" => "ready",
        "inprogress" => "process",
        "overdue" => "hold",
        _ => "hold",
    };

    private static string SlaStatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "inprogress" => "In progress",
        "overdue" => "Overdue",
        _ => "Pending",
    };

    private static int SlaRemainingPercent(int? remaining, int total)
    {
        if (total <= 0)
            return remaining is > 0 ? 40 : 0;
        var days = Math.Max(remaining ?? 0, 0);
        return Math.Clamp((int)Math.Round(100.0 * days / total), 0, 100);
    }

    private static string SlaDisplayDate(string? value) =>
        string.IsNullOrWhiteSpace(value) || value == "—" ? "—" : value.Trim();

    private static string SlaRingTone(int? daysRemaining) => daysRemaining switch
    {
        null => "",
        <= 1 => "ct-sla-ring--due",
        <= 10 => "ct-sla-ring--warn",
        _ => "ct-sla-ring--ok",
    };

    private static string SlaToneClass(int? daysRemaining) => daysRemaining switch
    {
        null => "ct-sla-tone",
        <= 1 => "ct-sla-tone ct-sla-tone--due",
        <= 10 => "ct-sla-tone ct-sla-tone--warn",
        _ => "ct-sla-tone ct-sla-tone--ok",
    };

    private static string SlaToneLabel(int? daysRemaining) => daysRemaining switch
    {
        null => "—",
        <= 0 => "Due",
        1 => "Due tomorrow",
        <= 10 => "Due soon",
        _ => "On track",
    };

    private async Task SelectTab(string key)
    {
        if (string.IsNullOrWhiteSpace(key) || _tabSwitching)
            return;
        if (string.Equals(key, ActiveTab, StringComparison.OrdinalIgnoreCase) && _tabContentReady)
            return;

        await PaintTabSwitchAsync(key);
        try
        {
            if (CaseTabChanged.HasDelegate)
                await CaseTabChanged.InvokeAsync(key);
        }
        finally
        {
            _tabContentReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PaintTabSwitchAsync(string key)
    {
        _pendingTab = key;
        _tabSwitching = true;
        _tabContentReady = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
    }

    private static bool IsIssuedPersonItem(string? key) =>
        key is "inv" or "wp" or "bz" or "rejection";

    private async Task OpenLinkedRecordTile(string tabKey)
    {
        if (_tabSwitching)
            return;

        await PaintTabSwitchAsync("people");
        try
        {
            if (LinkedRecordTileClicked.HasDelegate)
                await LinkedRecordTileClicked.InvokeAsync(tabKey);
            else if (CaseTabChanged.HasDelegate)
                await CaseTabChanged.InvokeAsync("people");
        }
        finally
        {
            _tabContentReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsPersonRecordSelected(int personIndex, string? recordKey)
    {
        if (string.IsNullOrWhiteSpace(recordKey) || string.IsNullOrWhiteSpace(EffectivePeopleRecordKey))
            return false;
        if (!string.Equals(recordKey, EffectivePeopleRecordKey, StringComparison.OrdinalIgnoreCase))
            return false;
        return _peopleRecordPersonIndex is not int scoped
            || scoped == personIndex;
    }

    private void TogglePersonRecord(int personIndex, string recordKey)
    {
        if (IsPersonRecordSelected(personIndex, recordKey)
            && _peopleRecordPersonIndex == personIndex)
        {
            _peopleRecordKey = null;
            _peopleRecordPersonIndex = null;
            return;
        }

        _peopleRecordKey = recordKey;
        _peopleRecordPersonIndex = personIndex;
    }

    private ApplicationWorkspaceTab? FindLinkedTab(string? key)
    {
        if (string.IsNullOrWhiteSpace(key) || Snapshot?.Tabs == null)
            return null;
        return Snapshot.Tabs.FirstOrDefault(tab =>
            string.Equals(tab.Key, key, StringComparison.OrdinalIgnoreCase));
    }

    private IReadOnlyList<IReadOnlyList<string>> PersonRecordRows(
        ApplicationWorkspaceCasePerson person,
        string recordKey)
    {
        var tab = FindLinkedTab(recordKey);
        if (tab == null || tab.Rows.Count == 0)
            return Array.Empty<IReadOnlyList<string>>();

        if (person.PersonId != Guid.Empty
            && tab.RowPersonIds.Count == tab.Rows.Count)
        {
            return tab.Rows
                .Where((_, index) => tab.RowPersonIds[index] == person.PersonId)
                .ToList();
        }

        return tab.Rows
            .Where(row => row.Count > 0
                && string.Equals(row[0], person.Name, StringComparison.Ordinal))
            .ToList();
    }

    private static IReadOnlyList<string> LinkedRecordColumns(ApplicationWorkspaceTab? tab)
    {
        if (tab == null || tab.Columns.Count == 0)
            return Array.Empty<string>();
        return tab.Columns[0] == "Person" ? tab.Columns.Skip(1).ToList() : tab.Columns;
    }

    private static IReadOnlyList<string> LinkedRecordCells(
        ApplicationWorkspaceTab? tab,
        IReadOnlyList<string> row)
    {
        if (tab != null && tab.Columns.Count > 0 && tab.Columns[0] == "Person" && row.Count > 1)
            return row.Skip(1).ToList();
        return row;
    }

    private Task BackToListAsync() => BackToListRequested.InvokeAsync();
    private Task LinkPersonAsync() => LinkPersonRequested.InvokeAsync();
    private Task AdvanceProgressAsync()
    {
        var current = Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.State == "current")
            ?? Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.CanAdvance);
        if (current?.CanAdvance != true || current.AdvanceOptions.Count == 0)
            return SelectTab("progress");

        if (!string.Equals(ActiveTab, "progress", StringComparison.OrdinalIgnoreCase))
            return SelectTab("progress");

        if (_progressTab != null)
            return _progressTab.AdvanceFromRailAsync();

        return AdvanceProgressRequested.InvokeAsync(new OfficerShellCaseProgressAdvanceRequest
        {
            StateCode = ApplicationWorkspaceProgressAdvancePreview.PreferredAdvanceCode(
                current.Key,
                current.AdvanceOptions,
                _progressTab?.SelectedAdvanceStateCode) ?? string.Empty,
            Notes = current.OfficerNotes ?? string.Empty,
            Date = _progressTab?.AdvanceDate ?? DateTime.Today,
            LetterFileName = _progressTab?.PendingLetterFileName,
            LetterContent = _progressTab?.PendingLetterContent,
            ProcessNumber = _progressTab?.ProcessNumberOnAdvance,
        });
    }

    private bool CanRevertFromRail =>
        Snapshot?.CaseView.ProgressSteps.Any(s => s.CanRevert) == true;

    private Task RevertProgressAsync()
    {
        if (!CanRevertFromRail)
            return SelectTab("progress");

        if (!string.Equals(ActiveTab, "progress", StringComparison.OrdinalIgnoreCase))
            return SelectTab("progress");

        var last = Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.CanRevert);
        return RevertProgressRequested.InvokeAsync(new OfficerShellCaseProgressRevertRequest
        {
            StepKey = last != null ? null : "office",
        });
    }

    private async Task SelectPersonRow(int rowIndex)
    {
        if (SelectPersonRowRequested.HasDelegate)
            await SelectPersonRowRequested.InvokeAsync(rowIndex);
    }

    private async Task OpenPersonByIndex(int rowIndex)
    {
        if (OpenPersonDetailByIndexRequested.HasDelegate)
            await OpenPersonDetailByIndexRequested.InvokeAsync(rowIndex);
        else if (OpenPersonDetailRequested.HasDelegate)
            await OpenPersonDetailRequested.InvokeAsync();
    }

    private bool IsRelinking => _relinkingPersonId != Guid.Empty;

    private async Task RelinkPersonById(Guid personId)
    {
        if (personId == Guid.Empty || !RelinkPersonRequested.HasDelegate || IsRelinking)
            return;

        _relinkingPersonId = personId;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            await RelinkPersonRequested.InvokeAsync(personId);
        }
        finally
        {
            _relinkingPersonId = Guid.Empty;
        }
    }

    private async Task UnlinkPersonById(Guid personId)
    {
        if (personId == Guid.Empty || !UnlinkPersonRequested.HasDelegate)
            return;
        await UnlinkPersonRequested.InvokeAsync(personId);
    }

    private static string FormatLinkedCount(int count, int expected) =>
        expected > 1 ? $"{count}/{expected}" : count.ToString();

    private static string PersonColor(int index) => PersonColors[index % PersonColors.Length];

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
