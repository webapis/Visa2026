    private async Task SelectTab(string key)
    {
        if (string.IsNullOrWhiteSpace(key) || _tabSwitching || _summarySaving)
            return;
        if (ApplicationWorkspaceCaseSummaryCompletenessGate.BlocksTab(Snapshot?.CaseView, key))
        {
            RememberBlockedSection(key);
            _keepBlockedSectionLabel = true;
            StartCaseSummaryEdit();
            if (!string.Equals(ActiveTab, "overview", StringComparison.OrdinalIgnoreCase))
                await SelectTab("overview");
            _keepBlockedSectionLabel = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (_caseSummaryEditing
            && !string.Equals(key, "overview", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(key, "people", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(key, "result", StringComparison.OrdinalIgnoreCase))
            DiscardCaseSummaryDraft();
        if (!_keepBlockedSectionLabel)
            _blockedSectionLabel = null;
        if (string.Equals(key, "result", StringComparison.OrdinalIgnoreCase))
            EnsureHybridIssuedKey(Snapshot?.CaseView);
        if (string.Equals(key, ActiveTab, StringComparison.OrdinalIgnoreCase) && _tabContentReady)
        {
            if (string.Equals(key, "result", StringComparison.OrdinalIgnoreCase))
                await InvokeAsync(StateHasChanged);
            return;
        }

        _resminamalarCatalogPending = string.Equals(key, "resminamalar", StringComparison.OrdinalIgnoreCase);
        await PaintTabSwitchAsync(key);
        try
        {
            if (CaseTabChanged.HasDelegate)
                await CaseTabChanged.InvokeAsync(key);
        }
        finally
        {
            _tabContentReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void EnsureHybridIssuedKey(ApplicationWorkspaceCaseView? view)
    {
        var tiles = view?.IssuedRecordTiles;
        if (tiles == null || tiles.Count == 0)
        {
            _selectedIssuedKey = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(_selectedIssuedKey)
            && tiles.Any(tile => string.Equals(tile.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase)))
            return;

        var shortTile = tiles.FirstOrDefault(tile =>
                !tile.IsOptional && ApplicationWorkspaceIssuedResultOverview.Missing(tile) > 0)
            ?? tiles[0];
        _selectedIssuedKey = shortTile.Key;
    }

