    private bool CanAdvanceFromRail =>
        Snapshot?.CaseView.ProgressSteps.Any(s => s.CanAdvance && s.AdvanceOptions.Count > 0) == true;

    private string? AdvanceBlockedTitle
    {
        get
        {
            if (CanAdvanceFromRail || Snapshot == null)
                return null;

            var reason = Snapshot.CaseView.ProgressSteps
                .Select(s => s.AdvanceBlockedReason)
                .FirstOrDefault(text => !string.IsNullOrWhiteSpace(text));
            if (!string.IsNullOrWhiteSpace(reason))
                return ApplicationProfileLocalization.ProgressReason(reason);

            return Snapshot.CaseView.Sla.IsTerminal
                ? Msg("ApplicationProfileInstance.Workspace.TerminalBlocked")
                : Msg("ApplicationProfileInstance.Workspace.NoFurtherSteps");
        }
    }

    private RenderFragment AdvanceActionButton(string cssClass, string? style = null) => __builder =>
    {
        <button type="button"
                class="@($"{cssClass}{(_progressUpdating ? " is-busy" : "")}")"
                style="@style"
                disabled="@(_progressUpdating || _ignoreAdvanceClick || !CanAdvanceFromRail)"
                aria-busy="@_progressUpdating"
                title="@AdvanceBlockedTitle"
                @onclick="AdvanceProgressAsync">
            @if (_progressUpdating)
            {
                <span class="cw-advance-spin" aria-hidden="true"></span>
                @Msg("ApplicationProfileInstance.Workspace.AdvancingProgress")
            }
            else
            {
                <text>▶ @Msg("ApplicationProfileInstance.Workspace.AdvanceProgress")</text>
            }
        </button>
    };

    private async Task OnAdvanceProgressRequested(OfficerShellCaseProgressAdvanceRequest request)
    {
        if (_progressUpdating || _ignoreAdvanceClick)
            return;

        _progressUpdating = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await AdvanceProgressRequested.InvokeAsync(request);
        }
        finally
        {
            _progressUpdating = false;
            // A second click queued during the save must not advance the next step.
            _ignoreAdvanceClick = true;
            _ = ReleaseAdvanceClickAsync();
        }
    }

    private async Task ReleaseAdvanceClickAsync()
    {
        await Task.Delay(400);
        _ignoreAdvanceClick = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task AdvanceProgressAsync()
    {
        if (_progressUpdating || _ignoreAdvanceClick || !CanAdvanceFromRail)
            return Task.CompletedTask;

        if (TryBlockIncompleteProcessWork())
            return Task.CompletedTask;

        var current = Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.State == "current")
            ?? Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.CanAdvance);
        if (current?.CanAdvance != true || current.AdvanceOptions.Count == 0)
            return SelectTab("progress");

        if (!string.Equals(ActiveTab, "progress", StringComparison.OrdinalIgnoreCase))
            return SelectTab("progress");

        if (_progressTab != null)
            return _progressTab.AdvanceFromRailAsync();

        return OnAdvanceProgressRequested(new OfficerShellCaseProgressAdvanceRequest
        {
            StateCode = ApplicationWorkspaceProgressAdvancePreview.PreferredAdvanceCode(
                current.Key,
                current.AdvanceOptions,
                _progressTab?.SelectedAdvanceStateCode) ?? string.Empty,
            Notes = null,
            Date = _progressTab?.AdvanceDate ?? DateTime.Today,
            LetterFileName = _progressTab?.PendingLetterFileName,
            LetterContent = _progressTab?.PendingLetterContent,
            ProcessNumber = _progressTab?.ProcessNumberOnAdvance,
            SubmissionDocumentNumber = _progressTab?.SubmissionDocumentNumberOnAdvance,
        });
    }

    private bool CanRevertFromRail =>
        Snapshot?.CaseView.ProgressSteps.Any(s => s.CanRevert) == true;

    private Task RevertProgressAsync()
    {
        if (TryBlockIncompleteProcessWork())
            return Task.CompletedTask;

        if (!CanRevertFromRail)
            return SelectTab("progress");

        if (!string.Equals(ActiveTab, "progress", StringComparison.OrdinalIgnoreCase))
            return SelectTab("progress");

        var last = Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.CanRevert);
        return RevertProgressRequested.InvokeAsync(new OfficerShellCaseProgressRevertRequest
        {
            StepKey = last != null ? null : "office",
        });
    }

