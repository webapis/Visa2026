@using System.Linq
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.ApplicationPersonLink
@using Visa2026.Module.Services.OfficerShell

<div class="officer-case-workspace">
    @if (IsLoading || Snapshot == null)
    {
        <div class="os-loading" role="status">Loading case workspace…</div>
    }
    else if (Snapshot.ApplicationProfileInstanceId == Guid.Empty)
    {
        <div class="os-loading">No case selected.</div>
    }
    else
    {
        var view = Snapshot.CaseView;
        var chrome = view.Chrome;
        <header class="cw-head">
            <div class="cw-head__top">
                <div class="cw-head__title-block">
                    <div class="cw-head__accent" style="background:@OfficerShellTemplateFamily.GetColor(chrome.TemplateFamilyKey)"></div>
                    <div>
                        <h1>ApplicationProfileInstance № @chrome.DisplayNumber</h1>
                        <p class="cw-head__sub">@chrome.TemplateFamilyLabel · Started @(string.IsNullOrWhiteSpace(chrome.StartedOn) ? "—" : chrome.StartedOn)</p>
                    </div>
                </div>
                <div class="cw-head__badges">
                    @if (chrome.SlaDaysRemaining is int slaDays)
                    {
                        <span class="cw-head-badge cw-head-badge--sla">📅 @slaDays days remaining</span>
                    }
                    <span class="cw-head-badge cw-head-badge--process">⚙ In process</span>
                    @if (view.Chrome.ResolvedLinksLocked)
                    {
                        <span class="cw-head-badge cw-head-badge--locked" title="People and linked records cannot be changed">🔒 Links locked</span>
                    }
                    <button type="button"
                            class="cw-head__close"
                            aria-label="Close case workspace"
                            title="Close"
                            @onclick="BackToListAsync">×</button>
                </div>
            </div>
            <div class="cw-head__people">
                @foreach (var (name, index) in chrome.PeopleNames.Select((n, i) => (n, i)))
                {
                    <span class="cw-person">
                        <span class="cw-person__avatar" style="background:@PersonColor(index)">@Initials(name)</span>
                        @name
                    </span>
                }
                @if (chrome.MergedFromCount is int merged && merged > 1)
                {
                    <span class="cw-merge">⊞ Merged from @merged staged profiles</span>
                }
            </div>
        </header>

        <div class="cw-layout @(IsWideTab(ActiveTab) ? "cw-layout--wide" : null)">
            <nav class="cw-nav" aria-label="Case sections">
                @foreach (var tab in CaseTabs)
                {
                    <button type="button"
                            class="cw-nav__item @(ActiveTab == tab.Key ? "is-active" : null)"
                            @onclick="() => SelectTab(tab.Key)">
                        <span aria-hidden="true">@tab.Glyph</span>
                        <span>@tab.Label</span>
                    </button>
                }
            </nav>

            <div class="cw-main @(IsWideTab(ActiveTab) ? "cw-main--full" : null)">
                @switch (ActiveTab)
                {
                    case "overview":
                        @RenderOverview(view)
                        break;
                    case "people":
                        @RenderPeople(view)
                        break;
                    case "progress":
                        <OfficerShellCaseProgressTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                     View="view"
                                                     StatusMessage="@ProgressStatusMessage"
                                                     IsStatusError="@ProgressStatusIsError"
                                                     SaveNotesRequested="@SaveProgressNotesRequested"
                                                     UploadMinistryLetterRequested="@UploadMinistryLetterRequested"
                                                     AdvanceProgressRequested="@AdvanceProgressRequested" />
                        break;
                    case "documents":
                        <OfficerShellCaseDocumentsTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId" Snapshot="Snapshot" />
                        break;
                    case "resminamalar":
                        <OfficerShellCaseResminamalarTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId" />
                        break;
                    case "sla":
                        @RenderSla(view)
                        break;
                }
            </div>

            @if (!IsWideTab(ActiveTab))
            {
                <aside class="cw-rail">
                    @RenderRail(view)
                </aside>
            }
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Label, string Glyph)[] CaseTabs =
    [
        ("overview", "Overview", "⌂"),
        ("people", "People & links", "👥"),
        ("progress", "Progress", "▤"),
        ("documents", "Document copies", "📄"),
        ("resminamalar", "Resminamalar", "📦"),
        ("sla", "SLA & deadlines", "⏱"),
    ];

    private static readonly string[] PersonColors =
        ["#7c3aed", "#0f9d58", "#ea580c", "#2563eb", "#db2777"];

    [Parameter] public ApplicationWorkspaceSnapshot? Snapshot { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string ActiveTab { get; set; } = "overview";
    [Parameter] public int SelectedPersonRowIndex { get; set; } = -1;
    [Parameter] public string? PeopleLinkedRecordFocusKey { get; set; }
    [Parameter] public bool CanLinkPerson { get; set; }
    [Parameter] public bool CanUnlinkPerson { get; set; }
    [Parameter] public bool CanOpenPersonDetail { get; set; }
    [Parameter] public bool CanOpenDocumentCopies { get; set; }
    [Parameter] public EventCallback<string> CaseTabChanged { get; set; }
    [Parameter] public EventCallback<string> LinkedRecordTileClicked { get; set; }
    [Parameter] public EventCallback<string> IssuedHeaderNewRequested { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceIssuedHeaderOpenRequest> IssuedHeaderOpenRequested { get; set; }
    [Parameter] public EventCallback BackToListRequested { get; set; }
    [Parameter] public EventCallback LinkPersonRequested { get; set; }
    [Parameter] public EventCallback UnlinkPersonRequested { get; set; }
    [Parameter] public EventCallback OpenPersonDetailRequested { get; set; }
    [Parameter] public EventCallback<int> OpenPersonDetailByIndexRequested { get; set; }
    [Parameter] public EventCallback OpenDocumentCopiesRequested { get; set; }
    [Parameter] public EventCallback OpenResminamalarRequested { get; set; }
    [Parameter] public EventCallback<int> SelectPersonRowRequested { get; set; }
    [Parameter] public string? ProgressStatusMessage { get; set; }
    [Parameter] public bool ProgressStatusIsError { get; set; }
    [Parameter] public EventCallback<string> SaveProgressNotesRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileUpload> UploadMinistryLetterRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressAdvanceRequest> AdvanceProgressRequested { get; set; }
    [Parameter] public bool ShowPersonLinkPicker { get; set; }
    [Parameter] public IReadOnlyList<ApplicationProfileInstancePersonLinkCandidateRow> PersonLinkCandidates { get; set; } = Array.Empty<ApplicationProfileInstancePersonLinkCandidateRow>();
    [Parameter] public bool PersonLinkIsSearching { get; set; }
    [Parameter] public bool PersonLinkIsLinking { get; set; }
    [Parameter] public string? PersonLinkStatusMessage { get; set; }
    [Parameter] public bool PersonLinkStatusIsError { get; set; }
    [Parameter] public EventCallback<string> PersonLinkSearchRequested { get; set; }
    [Parameter] public EventCallback<Guid> LinkPersonFromPickerRequested { get; set; }
    [Parameter] public EventCallback ClosePersonLinkPickerRequested { get; set; }

    private static bool IsWideTab(string tab) => tab is "documents" or "resminamalar";

    private string? _selectedIssuedKey;

    private static string IssuedEmptyHint(ApplicationWorkspaceCaseView view, ApplicationWorkspaceCaseIssuedTile tile)
    {
        var number = view.Chrome.DisplayNumber;
        if (string.IsNullOrWhiteSpace(number))
            return tile.EmptyHint;

        return tile.EmptyHint.Replace(
            "this application.",
            "Application № " + number + ".",
            StringComparison.Ordinal);
    }

    private void SelectIssuedTile(string key)
    {
        _selectedIssuedKey = string.Equals(_selectedIssuedKey, key, StringComparison.OrdinalIgnoreCase)
            ? null
            : key;
    }

    private void IssueRecordQuickAction()
    {
        var tiles = Snapshot?.CaseView.IssuedRecordTiles;
        if (tiles == null || tiles.Count == 0)
            return;

        var empty = tiles.FirstOrDefault(t => t.Count == 0);
        _selectedIssuedKey = (empty ?? tiles[0]).Key;
    }

    private async Task NewIssuedHeaderAsync(string key)
    {
        if (IssuedHeaderNewRequested.HasDelegate)
            await IssuedHeaderNewRequested.InvokeAsync(key);
    }

    private async Task OpenIssuedHeaderAsync(string key, Guid id)
    {
        if (!IssuedHeaderOpenRequested.HasDelegate || id == Guid.Empty)
            return;

        await IssuedHeaderOpenRequested.InvokeAsync(new ApplicationWorkspaceIssuedHeaderOpenRequest
        {
            Key = key,
            Id = id,
        });
    }

    private RenderFragment RenderOverview(ApplicationWorkspaceCaseView view) => __builder =>
    {
        <div class="cw-overview">
            <section class="cw-card">
                <h2 class="cw-card__title">Case summary</h2>
                <div class="cw-summary-grid">
                    @foreach (var tile in view.SummaryTiles)
                    {
                        <div class="cw-sum-tile cw-sum-tile--@tile.Tone">
                            <span class="cw-sum-tile__icon">@tile.Glyph</span>
                            <span class="cw-sum-tile__label">@tile.Label</span>
                            <strong class="cw-sum-tile__value">@tile.Value</strong>
                        </div>
                    }
                </div>
            </section>
            <section class="cw-card">
                <h2 class="cw-card__title">ApplicationProfileInstance progress</h2>
                <div class="cw-prog-stepper">
                @for (var i = 0; i < view.ProgressSteps.Count; i++)
                {
                    var step = view.ProgressSteps[i];
                    var currentIdx = view.ProgressSteps.ToList().FindIndex(s => s.State == "current");
                    var badge = step.State == "done" ? "Completed" : step.State == "current" ? "In progress" : "Pending";
                    var badgeCls = step.State == "done" ? "ok" : step.State == "current" ? "active" : "muted";
                    var lineCls = i < view.ProgressSteps.Count - 1
                        ? i < currentIdx ? "done" : i == currentIdx ? "current" : "pending"
                        : null;
                        <div class="cw-prog-step cw-prog-step--@step.State">
                            <div class="cw-prog-step__track">
                                <span class="cw-prog-step__dot">@(step.State == "done" ? "✓" : (i + 1).ToString())</span>
                                @if (lineCls != null)
                                {
                                    <span class="cw-prog-step__line cw-prog-step__line--@lineCls"></span>
                                }
                            </div>
                            <div class="cw-prog-step__body">
                                <strong>@step.Label</strong>
                                <span class="cw-prog-step__badge cw-prog-step__badge--@badgeCls">@badge</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
            <section class="cw-card">
                <h2 class="cw-card__title">Linked records</h2>
                @if (view.Chrome.ResolvedLinksLocked)
                {
                    <p class="cw-linked-lock">🔒 Process complete — linked people and records are locked on this case.</p>
                }
                @if (view.LinkedRecordTiles.Count == 0)
                {
                    <p class="cw-linked-empty">No linked person-related records yet. Link people on the <strong>People &amp; links</strong> tab — records auto-resolve from profile requirements.</p>
                }
                else
                {
                    <div class="cw-link-row">
                        @foreach (var tile in view.LinkedRecordTiles)
                        {
                            <button type="button" class="cw-link-tile cw-link-tile--@tile.Tone" @onclick="() => OpenLinkedRecordTile(tile.TabKey)">
                                <span class="cw-link-tile__icon">@tile.Glyph</span>
                                <span class="cw-link-tile__label">@tile.Label</span>
                                <strong class="cw-link-tile__count">@tile.Count</strong>
                                <span class="cw-link-tile__chev">›</span>
                            </button>
                        }
                    </div>
                }
            </section>
            @if (view.IssuedRecordTiles.Count > 0)
            {
                var selectedIssued = view.IssuedRecordTiles.FirstOrDefault(t =>
                    string.Equals(t.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase));
                <section class="cw-card">
                    <h2 class="cw-card__title">Issued records</h2>
                    <p class="cw-card__sub">Created by this application · visible when May produce is on</p>
                    <div class="cw-issued-row">
                        @foreach (var tile in view.IssuedRecordTiles)
                        {
                            var isSelected = string.Equals(tile.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="cw-link-tile cw-link-tile--@tile.Tone cw-issued-tile @(tile.Count == 0 ? "is-empty" : null) @(isSelected ? "is-selected" : null)"
                                    @onclick="() => SelectIssuedTile(tile.Key)">
                                <span class="cw-link-tile__icon">@tile.Glyph</span>
                                <span class="cw-link-tile__label">@tile.Label</span>
                                @if (tile.Count == 0)
                                {
                                    <span class="cw-issued-tile__add">@tile.AddCaption</span>
                                }
                                else
                                {
                                    <strong class="cw-link-tile__count">@tile.Count</strong>
                                }
                                <span class="cw-link-tile__chev">›</span>
                            </button>
                        }
                    </div>
                    @if (selectedIssued != null)
                    {
                        <div class="cw-issued-panel">
                            <h3 class="cw-issued-panel__title">@selectedIssued.PanelTitle</h3>
                            @if (selectedIssued.Count == 0)
                            {
                                <p class="cw-issued-panel__hint">@IssuedEmptyHint(view, selectedIssued)</p>
                            }
                            else
                            {
                                <ul class="cw-issued-list">
                                    @foreach (var row in selectedIssued.Rows)
                                    {
                                        <li>
                                            <button type="button"
                                                    class="cw-issued-list__item"
                                                    @onclick="() => OpenIssuedHeaderAsync(selectedIssued.Key, row.Id)">
                                                <strong>@row.Title</strong>
                                                <span>@row.Subtitle</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="cw-issued-panel__actions">
                                <button type="button" class="os-btn os-btn--primary" @onclick="() => NewIssuedHeaderAsync(selectedIssued.Key)">@selectedIssued.NewCaption</button>
                            </div>
                        </div>
                    }
                </section>
            }
            <p class="cw-foot">Application Profile instance · Template: @(string.IsNullOrWhiteSpace(view.Chrome.ProfileTemplateName) ? Snapshot!.Profile.Title : view.Chrome.ProfileTemplateName)</p>
        </div>;
    };

    private RenderFragment RenderPeople(ApplicationWorkspaceCaseView view) => __builder =>
    {
        <div class="ct-page">
            <h2 class="ct-page__title">People on this case</h2>
            @if (view.Chrome.ResolvedLinksLocked)
            {
                <p class="cw-linked-lock" style="margin-bottom:12px">🔒 People and linked records are locked — this process is complete (issued, rejected, or cancelled).</p>
            }
            <div class="os-toolbar" style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap">
                <button type="button" class="os-btn os-btn--primary" disabled="@(!CanLinkPerson || ShowPersonLinkPicker)" @onclick="LinkPersonAsync">Link existing…</button>
                <button type="button" class="os-btn" disabled="@(!CanUnlinkPerson)" @onclick="UnlinkPersonAsync">Unlink</button>
            </div>
            <OfficerShellPersonLinkPickerComponent IsOpen="@ShowPersonLinkPicker"
                                                   Candidates="@PersonLinkCandidates"
                                                   IsSearching="@PersonLinkIsSearching"
                                                   IsLinking="@PersonLinkIsLinking"
                                                   StatusMessage="@PersonLinkStatusMessage"
                                                   IsStatusError="@PersonLinkStatusIsError"
                                                   SearchRequested="@PersonLinkSearchRequested"
                                                   LinkRequested="@LinkPersonFromPickerRequested"
                                                   CloseRequested="@ClosePersonLinkPickerRequested" />
            @if (view.People.Count == 0)
            {
                <p class="os-empty">No people linked.</p>
            }
            else
            {
                <div class="os-panel" style="margin-bottom:16px">
                    <table class="os-table">
                        <thead>
                            <tr><th>Person</th><th>Role</th><th>Passport</th><th>Visa</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var person in view.People)
                            {
                                <tr class="@(person.Index == SelectedPersonRowIndex ? "is-selected" : null)" @onclick="() => SelectPersonRow(person.Index)">
                                    <td><span class="ct-link">@person.Name</span></td>
                                    <td>@person.RoleLabel</td>
                                    <td><code>@person.PassportNumber</code></td>
                                    <td><code>@person.VisaNumber</code></td>
                                    <td>
                                        <button type="button" class="os-btn os-btn--ghost ct-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenPersonByIndex(person.Index)">Open person detail</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <h2 class="ct-page__title">Linked records by person</h2>
                @foreach (var person in view.People)
                {
                    <details class="ct-person-panel" open>
                        <summary class="ct-person-panel__head">
                            <span>👤 <strong>@person.Name</strong></span>
                            <button type="button" class="os-btn os-btn--ghost ct-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenPersonByIndex(person.Index)">Open person detail</button>
                        </summary>
                        <div class="ct-rec-grid">
                            @foreach (var record in person.Records)
                            {
                                var isFocused = !string.IsNullOrWhiteSpace(PeopleLinkedRecordFocusKey)
                                    && string.Equals(record.Key, PeopleLinkedRecordFocusKey, StringComparison.OrdinalIgnoreCase);
                                <div class="ct-rec @(isFocused ? "ct-rec--focus" : null)">
                                    <span class="ct-rec__icon">@record.Glyph</span>
                                    <span class="ct-rec__label">@record.Label</span>
                                    <strong class="ct-rec__count">@record.Count</strong>
                                    @if (record.State == "valid")
                                    {
                                        <span class="ct-rec__status ct-rec__status--valid">✓ Valid</span>
                                    }
                                    else
                                    {
                                        <span class="ct-rec__status ct-rec__status--muted">—</span>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            }
        </div>;
    };

    private RenderFragment RenderSla(ApplicationWorkspaceCaseView view) => __builder =>
    {
        var sla = view.Sla;
        var casePct = sla.TotalSlaDays > 0
            ? Math.Clamp((int)Math.Round(100.0 * sla.ElapsedDays / sla.TotalSlaDays), 5, 95)
            : 73;
        var stepPct = sla.CurrentStepDaysRemaining is int stepRem && sla.TotalSlaDays > 0
            ? Math.Clamp(100 - stepRem * 10, 10, 90)
            : 20;
        <div class="ct-page">
            <h2 class="ct-page__title">SLA dashboard</h2>
            <div class="ct-sla-metrics">
                <div class="ct-sla-metric">
                    <h3>Overall case SLA</h3>
                    <div class="ct-sla-metric__body">
                        <div class="ct-sla-ring ct-sla-ring--lg" style="--ct-pct:@(100 - casePct)%">
                            <strong>@(sla.CaseDaysRemaining?.ToString() ?? "—")</strong><span>days remaining</span>
                        </div>
                        <div>
                            <p class="ct-muted">Total SLA <strong>@sla.TotalSlaDays days</strong></p>
                            <p class="ct-muted">Elapsed <strong>@sla.ElapsedDays days</strong></p>
                            <p class="ct-on-track"><span></span> On track</p>
                        </div>
                    </div>
                </div>
                <div class="ct-sla-metric">
                    <h3>Current step</h3>
                    <p class="ct-muted">Ministry review deadline · Due @sla.MinistryDueDate</p>
                    <div class="ct-sla-metric__body">
                        <div class="ct-sla-ring" style="--ct-pct:@(100 - stepPct)%">
                            <strong>@(sla.CurrentStepDaysRemaining?.ToString() ?? "—")</strong><span>days remaining</span>
                        </div>
                        <p class="ct-on-track"><span></span> On track</p>
                    </div>
                </div>
                <div class="ct-sla-metric">
                    <h3>Migration SLA</h3>
                    <p class="ct-sla-metric__big">@sla.MigrationSlaLabel.Split(' ').FirstOrDefault() <span>days</span></p>
                    <p class="ct-muted">Total configured on profile</p>
                </div>
            </div>
            <div class="ct-sla-timeline">
                <div class="ct-sla-timeline__node"><span>🚩</span><strong>Started</strong><span>@sla.StartedOn</span></div>
                <div class="ct-sla-timeline__line"></div>
                <div class="ct-sla-timeline__node"><span>🏛</span><strong>Ministry due</strong><span>@sla.MinistryDueDate</span></div>
                <div class="ct-sla-timeline__line"></div>
                <div class="ct-sla-timeline__node"><span>🏁</span><strong>Expected completion</strong><span>@sla.ExpectedCompletionDate</span></div>
            </div>
            <div class="ct-sla-lower">
                <div class="ct-sla-table-wrap">
                    <h3>Deadlines</h3>
                    <table class="os-table">
                        <thead><tr><th>Step</th><th>Due date</th><th>Days left</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var row in sla.Deadlines)
                            {
                                <tr class="@(row.IsCurrent ? "ct-sla-row--current" : null)">
                                    <td>@if (row.IsCurrent) { <strong>@row.Step</strong> } else { @row.Step }</td>
                                    <td>@row.DueDate</td>
                                    <td class="@(row.Status == "inprogress" ? "ct-sla-days--ok" : null)">@row.DaysLeft</td>
                                    <td><span class="os-status os-status--@SlaStatusClass(row.Status)">@SlaStatusLabel(row.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="ct-sla-aside">
                    @if (!string.IsNullOrWhiteSpace(sla.AlertMessage))
                    {
                        <div class="ct-sla-alert">⚠ <div><strong>Ministry review deadline approaching</strong><p>@sla.AlertMessage</p></div></div>
                    }
                    <div class="cw-rail-block" style="box-shadow:none;margin:0">
                        <h4>SLA source (Profile template)</h4>
                        <button type="button" class="cw-link-btn">MigrationSlaDays from template</button>
                        <p class="ct-muted" style="margin:8px 0 0">Total SLA (days): <strong>@sla.TotalSlaDays</strong></p>
                    </div>
                </div>
            </div>
            <p class="ct-sla-foot">All dates are displayed in system time zone (UTC+5:00) Ashgabat.</p>
        </div>;
    };

    private RenderFragment RenderRail(ApplicationWorkspaceCaseView view) => __builder =>
    {
        @switch (ActiveTab)
        {
            case "overview":
                <section class="cw-rail-block">
                    <h4>Readiness</h4>
                    <ul class="cw-checklist">
                        <li>✓ Required data complete</li>
                        <li>✓ BO states valid</li>
                    </ul>
                </section>
                <section class="cw-rail-block">
                    <h4>Quick actions</h4>
                    <button type="button" class="cw-rail-btn" @onclick='() => SelectTab("documents")'>📂 Open document copies</button>
                    <button type="button" class="cw-rail-btn" @onclick='() => SelectTab("resminamalar")'>📦 Generate Resminamalar package</button>
                    @if (view.IssuedRecordTiles.Count > 0)
                    {
                        <button type="button" class="cw-rail-btn" @onclick="IssueRecordQuickAction">＋ Issue record…</button>
                    }
                    <button type="button" class="cw-rail-btn cw-rail-btn--primary" @onclick="AdvanceProgressAsync">▶ Advance progress</button>
                </section>
                <section class="cw-rail-block">
                    <h4>Activity</h4>
                    <ul class="cw-timeline">
                        @foreach (var item in view.Activities.Take(4))
                        {
                            <li><strong>@item.Title</strong><span>@item.Subtitle</span></li>
                        }
                    </ul>
                </section>
                break;
            case "people":
                <section class="cw-rail-block">
                    <h4>People summary</h4>
                    <ul class="ct-summary-list">
                        <li><span>Total</span><strong>@view.PeopleSummary.Total</strong></li>
                        <li><span>Primary</span><strong>@view.PeopleSummary.Primary</strong></li>
                        <li><span>Dependents</span><strong>@view.PeopleSummary.Dependents</strong></li>
                        <li><span>Sponsors</span><strong>@view.PeopleSummary.Sponsors</strong></li>
                    </ul>
                </section>
                <section class="cw-rail-block">
                    <h4>Linked records summary</h4>
                    <ul class="ct-summary-list">
                        @foreach (var pair in view.LinkedRecordsSummary.OrderBy(p => p.Key))
                        {
                            <li><span>@pair.Key</span><strong>@pair.Value</strong></li>
                        }
                    </ul>
                </section>
                break;
            case "progress":
                var current = view.ProgressSteps.FirstOrDefault(s => s.State == "current");
                var ringPct = current?.SlaDaysRemaining is int d ? Math.Clamp(100 - d * 8, 10, 90) : 50;
                <section class="cw-rail-block">
                    <h4>SLA for current step</h4>
                    <div class="ct-sla-ring" style="--ct-pct:@ringPct%">
                        <strong>@(current?.SlaDaysRemaining?.ToString() ?? "—")</strong><span>days left</span>
                    </div>
                    @if (current != null)
                    {
                        <ul class="ct-summary-list" style="margin-top:10px">
                            <li><span>Target date</span><strong>@current.SlaTargetDate</strong></li>
                        </ul>
                    }
                </section>
                <section class="cw-rail-block">
                    <button type="button" class="os-btn os-btn--primary" style="width:100%;margin-bottom:8px" @onclick="AdvanceProgressAsync">▶ Advance progress</button>
                </section>
                <section class="cw-rail-block">
                    <h4>History</h4>
                    <ul class="cw-timeline">
                        @foreach (var row in Snapshot!.ProgressHistory.Take(3))
                        {
                            <li><strong>@row.State</strong><span>@row.Date</span></li>
                        }
                    </ul>
                </section>
                break;
            case "sla":
                break;
        }
    };

    private static string SlaStatusClass(string status) => status switch
    {
        "completed" => "ready",
        "inprogress" => "process",
        _ => "hold",
    };

    private static string SlaStatusLabel(string status) => status switch
    {
        "completed" => "Completed",
        "inprogress" => "In progress",
        _ => "Pending",
    };

    private async Task SelectTab(string key)
    {
        if (CaseTabChanged.HasDelegate)
            await CaseTabChanged.InvokeAsync(key);
    }

    private async Task OpenLinkedRecordTile(string tabKey)
    {
        if (LinkedRecordTileClicked.HasDelegate)
            await LinkedRecordTileClicked.InvokeAsync(tabKey);
        else
            await SelectTab("people");
    }

    private Task BackToListAsync() => BackToListRequested.InvokeAsync();
    private Task LinkPersonAsync() => LinkPersonRequested.InvokeAsync();
    private Task UnlinkPersonAsync() => UnlinkPersonRequested.InvokeAsync();
    private Task AdvanceProgressAsync()
    {
        var current = Snapshot?.CaseView.ProgressSteps.FirstOrDefault(s => s.State == "current");
        if (current?.CanAdvance != true || current.AdvanceOptions.Count == 0)
            return SelectTab("progress");

        return AdvanceProgressRequested.InvokeAsync(new OfficerShellCaseProgressAdvanceRequest
        {
            StateCode = current.AdvanceOptions[0].StateCode,
            Notes = current.OfficerNotes ?? string.Empty,
        });
    }

    private async Task SelectPersonRow(int rowIndex)
    {
        if (SelectPersonRowRequested.HasDelegate)
            await SelectPersonRowRequested.InvokeAsync(rowIndex);
    }

    private async Task OpenPersonByIndex(int rowIndex)
    {
        if (OpenPersonDetailByIndexRequested.HasDelegate)
            await OpenPersonDetailByIndexRequested.InvokeAsync(rowIndex);
        else if (OpenPersonDetailRequested.HasDelegate)
            await OpenPersonDetailRequested.InvokeAsync();
    }

    private static string PersonColor(int index) => PersonColors[index % PersonColors.Length];

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
