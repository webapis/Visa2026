@using System.Collections.Generic
@using System.Linq
@using Microsoft.JSInterop
@using DevExpress.ExpressApp
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.BusinessObjects.OfficerShell
@using Visa2026.Module.Services.ApplicationItemLinkedDocuments
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.ApplicationPersonLink
@using Visa2026.Module.Services.OfficerShell
@using Visa2026.Module.Editors
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.HeaderLinkedDocuments
@using Visa2026.Blazor.Server.Services
@implements IDisposable
@inject IJSRuntime JS
@inject IVisaPreviewSlotService PreviewSlotService
@inject INonSecuredObjectSpaceFactory ObjectSpaceFactory
@inject IApplicationWorkspacePersonUiActions WorkspaceActions

<div class="officer-case-workspace">
    @if (IsLoading || Snapshot == null)
    {
        <div class="os-loading" role="status">Loading case workspace…</div>
    }
    else if (Snapshot.ApplicationProfileInstanceId == Guid.Empty)
    {
        <div class="os-loading">No case selected.</div>
    }
    else
    {
        var view = Snapshot.CaseView;
        var chrome = view.Chrome;
        <header class="cw-head">
            <div class="cw-head__top">
                <div class="cw-head__title-block">
                    <div class="cw-head__accent" style="background:@OfficerShellTemplateFamily.GetColor(chrome.TemplateFamilyKey)"></div>
                    <div>
                        <h1>ApplicationProfileInstance № @chrome.DisplayNumber</h1>
                        @{
                            var profileName = !string.IsNullOrWhiteSpace(chrome.ProfileTemplateName)
                                ? chrome.ProfileTemplateName
                                : Snapshot!.Profile.Title;
                        }
                        @if (!string.IsNullOrWhiteSpace(profileName))
                        {
                            <p class="cw-head__profile" title="Application Profile">@profileName</p>
                        }
                        <p class="cw-head__sub">@chrome.TemplateFamilyLabel · Started @(string.IsNullOrWhiteSpace(chrome.StartedOn) ? "—" : chrome.StartedOn)</p>
                    </div>
                </div>
                <div class="cw-head__badges">
                    @{
                        var processTone = view.ProgressSteps.LastOrDefault(s =>
                            s.OutcomeKind is "issued" or "rejected" or "cancelled")?.OutcomeKind;
                    }
                    @if (chrome.SlaDaysRemaining is int slaDays)
                    {
                        <span class="cw-head-badge cw-head-badge--sla">📅 @slaDays days remaining</span>
                    }
                    @if (processTone == "issued")
                    {
                        <span class="cw-head-badge cw-head-badge--issued">Issued</span>
                    }
                    else if (processTone == "rejected")
                    {
                        <span class="cw-head-badge cw-head-badge--rejected">Rejected</span>
                    }
                    else if (processTone == "cancelled")
                    {
                        <span class="cw-head-badge cw-head-badge--cancelled">Cancelled</span>
                    }
                    else
                    {
                        <span class="cw-head-badge cw-head-badge--process">⚙ In process</span>
                    }
                    @if (view.Chrome.ResolvedLinksLocked)
                    {
                        <span class="cw-head-badge cw-head-badge--locked" title="People and linked records cannot be changed">🔒 Links locked</span>
                    }
                    <button type="button"
                            class="cw-head__close"
                            aria-label="Close case workspace"
                            title="Close"
                            @onclick="BackToListAsync">×</button>
                </div>
            </div>
            <div class="cw-head__people">
                @if (view.People.Count > 0)
                {
                    @foreach (var person in view.People)
                    {
                        var selected = IsDocumentPersonSelected(person.PersonId);
                        var personName = ApplicationItemDocumentCopiesPersonCatalog.DisplayPersonName(person.Name);
                        <button type="button"
                                class="cw-person @(selected ? "is-selected" : "is-muted")"
                                aria-pressed="@selected"
                                title="@(selected
                                    ? "Hide this person in Document copies"
                                    : "Show this person in Document copies")"
                                @onclick="() => ToggleDocumentPersonFilter(person.PersonId)">
                            <span class="cw-person__avatar" style="background:@PersonColor(person.Index)">@Initials(personName)</span>
                            @personName
                        </button>
                    }
                }
                else
                {
                    @foreach (var (name, index) in chrome.PeopleNames.Select((n, i) => (n, i)))
                    {
                        <span class="cw-person">
                            <span class="cw-person__avatar" style="background:@PersonColor(index)">@Initials(name)</span>
                            @name
                        </span>
                    }
                }
                @if (chrome.MergedFromCount is int merged && merged > 1)
                {
                    <span class="cw-merge">⊞ Merged from @merged staged profiles</span>
                }
            </div>
        </header>

        <div class="cw-layout @(IsWideTab(DisplayedTab) ? "cw-layout--wide" : null)">
            <nav class="cw-nav" aria-label="Case sections">
                @foreach (var tab in CaseTabs)
                {
                    <button type="button"
                            class="cw-nav__item @(DisplayedTab == tab.Key ? "is-active" : null)"
                            disabled="@_tabSwitching"
                            @onclick="() => SelectTab(tab.Key)">
                        <span aria-hidden="true">@tab.Glyph</span>
                        <span>@tab.Label</span>
                    </button>
                }
            </nav>

            <div class="cw-main @(IsWideTab(DisplayedTab) ? "cw-main--full" : null) @(_tabSwitching ? "cw-main--switching" : null)">
                @if (_tabSwitching)
                {
                    <div class="cw-tab-loading" role="status" aria-live="polite" aria-busy="true">
                        <div class="cw-tab-loading__panel">
                            <div class="cw-tab-loading__label">@TabSwitchStatus</div>
                            <div class="cw-tab-loading__track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-label="@TabSwitchStatus">
                                <div class="cw-tab-loading__fill cw-tab-loading__fill--indeterminate"></div>
                            </div>
                        </div>
                    </div>
                }
                @if (_tabContentReady)
                {
                    @switch (ActiveTab)
                    {
                        case "overview":
                            @RenderOverview(view)
                            break;
                        case "people":
                            @RenderPeople(view)
                            break;
                        case "progress":
                            <OfficerShellCaseProgressTab @ref="_progressTab"
                                                         ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                         View="view"
                                                         ProgressHistory="Snapshot.ProgressHistory"
                                                         StatusMessage="@ProgressStatusMessage"
                                                         IsStatusError="@ProgressStatusIsError"
                                                         SaveNotesRequested="@SaveProgressNotesRequested"
                                                         UploadMinistryLetterRequested="@UploadMinistryLetterRequested"
                                                         AdvanceProgressRequested="@AdvanceProgressRequested"
                                                         RevertProgressRequested="@RevertProgressRequested"
                                                         ShowRevertToHere="@ShowRevertToHere"
                                                         PreviewSlotOwnerViewId="@PreviewSlotOwnerViewId" />
                            break;
                        case "documents":
                            <OfficerShellCaseDocumentsTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                         Snapshot="Snapshot"
                                                         SelectedPersonIds="SelectedDocumentPersonIds"
                                                         PreviewSlotOwnerViewId="@PreviewSlotOwnerViewId" />
                            break;
                        case "resminamalar":
                            <OfficerShellCaseResminamalarTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                            Snapshot="Snapshot"
                                                            SelectedPersonIds="SelectedDocumentPersonIds" />
                            break;
                        case "sla":
                            @RenderSla(view)
                            break;
                    }
                }
            </div>

            @if (!IsWideTab(DisplayedTab))
            {
                <aside class="cw-rail">
                    @RenderRail(view)
                </aside>
            }
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Label, string Glyph)[] CaseTabs =
    [
        ("overview", "Overview", "⌂"),
        ("people", "People & links", "👥"),
        ("progress", "Progress", "▤"),
        ("documents", "Document copies", "📄"),
        ("resminamalar", "Resminamalar", "📦"),
        ("sla", "SLA & deadlines", "⏱"),
    ];

    private static readonly string[] PersonColors =
        ["#7c3aed", "#0f9d58", "#ea580c", "#2563eb", "#db2777"];

    private OfficerShellCaseProgressTab? _progressTab;
    private string? _pendingTab;
    private bool _tabSwitching;
    private bool _tabContentReady = true;
    private Guid _relinkingPersonId;

    private string DisplayedTab =>
        string.IsNullOrWhiteSpace(_pendingTab) ? ActiveTab : _pendingTab;

    private string PendingTabLabel
    {
        get
        {
            foreach (var tab in CaseTabs)
            {
                if (string.Equals(tab.Key, DisplayedTab, StringComparison.OrdinalIgnoreCase))
                    return tab.Label;
            }

            return "section";
        }
    }

    private string TabSwitchStatus => $"Opening {PendingTabLabel}…";

    [Parameter] public ApplicationWorkspaceSnapshot? Snapshot { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string ActiveTab { get; set; } = "overview";
    [Parameter] public int SelectedPersonRowIndex { get; set; } = -1;
    [Parameter] public string? PeopleLinkedRecordFocusKey { get; set; }
    [Parameter] public bool CanLinkPerson { get; set; }
    [Parameter] public bool CanUnlinkPerson { get; set; }
    [Parameter] public bool CanOpenPersonDetail { get; set; }
    [Parameter] public bool CanOpenDocumentCopies { get; set; }
    [Parameter] public EventCallback<string> CaseTabChanged { get; set; }
    [Parameter] public EventCallback<string> LinkedRecordTileClicked { get; set; }
    [Parameter] public EventCallback<string> IssuedHeaderNewRequested { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceIssuedHeaderOpenRequest> IssuedHeaderOpenRequested { get; set; }
    [Parameter] public EventCallback BackToListRequested { get; set; }
    [Parameter] public EventCallback LinkPersonRequested { get; set; }
    [Parameter] public EventCallback<Guid> UnlinkPersonRequested { get; set; }
    [Parameter] public EventCallback OpenPersonDetailRequested { get; set; }
    [Parameter] public EventCallback<int> OpenPersonDetailByIndexRequested { get; set; }
    [Parameter] public EventCallback<Guid> RelinkPersonRequested { get; set; }
    [Parameter] public EventCallback OpenDocumentCopiesRequested { get; set; }
    [Parameter] public EventCallback OpenResminamalarRequested { get; set; }
    [Parameter] public EventCallback<int> SelectPersonRowRequested { get; set; }
    [Parameter] public string? ProgressStatusMessage { get; set; }
    [Parameter] public bool ProgressStatusIsError { get; set; }
    [Parameter] public EventCallback<string> SaveProgressNotesRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileUpload> UploadMinistryLetterRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressAdvanceRequest> AdvanceProgressRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressRevertRequest> RevertProgressRequested { get; set; }
    [Parameter] public bool ShowRevertToHere { get; set; }
    [Parameter] public bool ShowPersonLinkPicker { get; set; }
    [Parameter] public IReadOnlyList<ApplicationProfileInstancePersonLinkCandidateRow> PersonLinkCandidates { get; set; } = Array.Empty<ApplicationProfileInstancePersonLinkCandidateRow>();
    [Parameter] public bool PersonLinkIsSearching { get; set; }
    [Parameter] public bool PersonLinkIsLinking { get; set; }
    [Parameter] public string? PersonLinkStatusMessage { get; set; }
    [Parameter] public bool PersonLinkStatusIsError { get; set; }
    [Parameter] public EventCallback<string> PersonLinkSearchRequested { get; set; }
    [Parameter] public EventCallback<Guid> LinkPersonFromPickerRequested { get; set; }
    [Parameter] public EventCallback ClosePersonLinkPickerRequested { get; set; }
    [Parameter] public string? HeaderFieldStatusMessage { get; set; }
    [Parameter] public bool HeaderFieldStatusIsError { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceCaseHeaderFieldUpdate> HeaderFieldChanged { get; set; }
    [Parameter] public string PreviewSlotOwnerViewId { get; set; } = OfficerShellViewIds.DetailView;

    private readonly HashSet<Guid> _selectedDocumentPersonIds = [];
    private string _documentPeopleRosterKey = string.Empty;
    private string? _peopleRecordKey;
    private int? _peopleRecordPersonIndex;
    private string? _appliedPeopleFocusKey;
    private bool _caseSummaryEditing;
    private Guid _caseSummaryInstanceId;

    private bool IsCaseSummaryEditing =>
        _caseSummaryEditing && Snapshot?.CaseView.HeaderFields.Count > 0;

    private IReadOnlyList<Guid> SelectedDocumentPersonIds =>
        _selectedDocumentPersonIds.Count == 0
            ? Array.Empty<Guid>()
            : _selectedDocumentPersonIds.ToList();

    private static bool IsWideTab(string tab) => tab is "documents" or "resminamalar";

    private string? EffectivePeopleRecordKey =>
        !string.IsNullOrWhiteSpace(_peopleRecordKey)
            ? _peopleRecordKey
            : PeopleLinkedRecordFocusKey;

    protected override void OnInitialized()
    {
        PreviewSlotService.StateChanged += OnPreviewSlotStateChanged;
    }

    public void Dispose()
    {
        PreviewSlotService.StateChanged -= OnPreviewSlotStateChanged;
    }

    private void OnPreviewSlotStateChanged() => _ = InvokeAsync(StateHasChanged);

    private bool IsIssuedRowOpen(string catalogKey, Guid rowId)
    {
        if (rowId == Guid.Empty || Snapshot == null)
            return false;

        var state = PreviewSlotService.State;
        var instanceId = Snapshot.ApplicationProfileInstanceId;

        if (state.Mode == VisaPreviewSlotMode.IssueIssuedHeader)
        {
            var request = state.IssueIssuedHeader;
            if (request == null
                || request.ApplicationProfileInstanceId != instanceId
                || request.ExistingHeaderId != rowId)
            {
                return false;
            }

            return IssueIssuedHeaderComposeService.TryResolveKind(catalogKey, out var kind)
                && request.Kind == kind;
        }

        if (state.Mode == VisaPreviewSlotMode.HeaderDocumentCopies)
        {
            var copies = state.HeaderDocumentCopies;
            if (copies == null || copies.ParentId != rowId)
                return false;

            return ApplicationWorkspaceIssuedRecordsCatalog.TryGetDocumentCopiesFamily(catalogKey, out var family)
                && copies.Family == family;
        }

        if (state.Mode == VisaPreviewSlotMode.IssueIssuedVisa)
        {
            var visaRequest = state.IssueIssuedVisa;
            return visaRequest != null
                && visaRequest.ApplicationProfileInstanceId == instanceId
                && visaRequest.ExistingVisaId == rowId
                && string.Equals(catalogKey, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    protected override void OnParametersSet()
    {
        var instanceId = Snapshot?.ApplicationProfileInstanceId ?? Guid.Empty;
        if (instanceId != _caseSummaryInstanceId)
        {
            _caseSummaryInstanceId = instanceId;
            _caseSummaryEditing = false;
        }

        SyncDocumentPeopleFilter(Snapshot?.CaseView);
        SyncPeopleRecordFocus();

        // Save reloads CaseView without dropdown catalogs. Reload them while Edit is open
        // so Visa type / Project / etc. keep a matching <option> and stay visible.
        if (_caseSummaryEditing)
            EnsureHeaderLookupCatalogs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tabSwitching || !_tabContentReady)
            return;

        _tabSwitching = false;
        _pendingTab = null;
        await InvokeAsync(StateHasChanged);
    }

    private void StartCaseSummaryEdit()
    {
        EnsureHeaderLookupCatalogs();
        _caseSummaryEditing = true;
    }

    private void EnsureHeaderLookupCatalogs()
    {
        var view = Snapshot?.CaseView;
        if (view == null || view.HeaderFields.Count == 0)
            return;

        var needsCatalogs = view.HeaderFields.Any(field =>
            field.Kind is ApplicationWorkspaceCaseHeaderFieldKind.Lookup
                or ApplicationWorkspaceCaseHeaderFieldKind.CommaSeparatedMultiSelect
            && field.Options.Count == 0
            && field.MultiSelectOptions.Count == 0);
        if (!needsCatalogs)
            return;

        var applicationId = Snapshot!.ApplicationProfileInstanceId;
        if (applicationId == Guid.Empty)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var application = objectSpace.GetObjectByKey<ApplicationProfileInstance>(applicationId);
        if (application == null)
            return;

        view.HeaderFields = ApplicationWorkspaceCaseHeaderFieldsHelper.Build(
            application,
            application.ApplicationProfile,
            objectSpace,
            loadLookupCatalogs: true);
    }

    private void FinishCaseSummaryEdit() => _caseSummaryEditing = false;

    private IEnumerable<ApplicationWorkspaceCaseSummaryTile> OverviewTiles(ApplicationWorkspaceCaseView view) =>
        view.HeaderFields.Count > 0
            ? view.HeaderFields.Select(ToSummaryTile)
            : view.SummaryTiles;

    private static ApplicationWorkspaceCaseSummaryTile ToSummaryTile(ApplicationWorkspaceCaseHeaderField field) =>
        new()
        {
            Key = field.Key,
            Label = field.Label,
            Value = field.DisplayValue,
            Tone = field.Tone,
            Glyph = field.Glyph,
            FillState = field.FillState,
        };

    private static List<ApplicationWorkspaceCaseHeaderField> IdentityHeaderFields(
        IEnumerable<ApplicationWorkspaceCaseHeaderField> fields)
    {
        var map = fields
            .Where(field => !string.IsNullOrEmpty(field.Key))
            .GroupBy(field => field.Key, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
        var result = new List<ApplicationWorkspaceCaseHeaderField>(ApplicationWorkspaceCaseHeaderFieldsHelper.IdentityFieldKeys.Length);
        foreach (var key in ApplicationWorkspaceCaseHeaderFieldsHelper.IdentityFieldKeys)
        {
            if (map.TryGetValue(key, out var field))
                result.Add(field);
        }

        return result;
    }

    private static List<ApplicationWorkspaceCaseHeaderField> MainHeaderFields(
        IEnumerable<ApplicationWorkspaceCaseHeaderField> fields) =>
        fields.Where(field => !ApplicationWorkspaceCaseHeaderFieldsHelper.IsIdentityField(field.Key)).ToList();

    private static List<ApplicationWorkspaceCaseSummaryTile> IdentityTiles(
        IEnumerable<ApplicationWorkspaceCaseSummaryTile> tiles)
    {
        var map = tiles
            .Where(tile => !string.IsNullOrEmpty(tile.Key))
            .GroupBy(tile => tile.Key, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
        var result = new List<ApplicationWorkspaceCaseSummaryTile>(ApplicationWorkspaceCaseHeaderFieldsHelper.IdentityFieldKeys.Length);
        foreach (var key in ApplicationWorkspaceCaseHeaderFieldsHelper.IdentityFieldKeys)
        {
            if (map.TryGetValue(key, out var tile))
                result.Add(tile);
        }

        return result;
    }

    private static List<ApplicationWorkspaceCaseSummaryTile> MainTiles(
        IEnumerable<ApplicationWorkspaceCaseSummaryTile> tiles) =>
        tiles.Where(tile => !ApplicationWorkspaceCaseHeaderFieldsHelper.IsIdentityField(tile.Key)).ToList();

    private static string FillCss(ApplicationWorkspaceCaseSummaryFillState state) =>
        ApplicationWorkspaceCaseSummaryFill.CssToken(state);

    private static string EditorAliasFor(string? fieldKey) =>
        string.Equals(fieldKey, ApplicationWorkspaceCaseHeaderFieldsHelper.WorkPermitLocation, StringComparison.Ordinal)
            ? CommaSeparatedMultiSelectEditorAliases.WorkPermittedLocation
            : CommaSeparatedMultiSelectEditorAliases.BorderZone;

    private Task OnHeaderFieldChanged(string key, string? value)
    {
        if (!HeaderFieldChanged.HasDelegate || string.IsNullOrWhiteSpace(key))
            return Task.CompletedTask;

        return HeaderFieldChanged.InvokeAsync(new ApplicationWorkspaceCaseHeaderFieldUpdate
        {
            Key = key,
            Value = value,
        });
    }

    private void SyncPeopleRecordFocus()
    {
        var focus = string.IsNullOrWhiteSpace(PeopleLinkedRecordFocusKey)
            ? null
            : PeopleLinkedRecordFocusKey.Trim();
        if (string.Equals(focus, _appliedPeopleFocusKey, StringComparison.OrdinalIgnoreCase))
            return;

        _appliedPeopleFocusKey = focus;
        _peopleRecordKey = focus;
        _peopleRecordPersonIndex = null;
    }

    private void SyncDocumentPeopleFilter(ApplicationWorkspaceCaseView? view)
    {
        var people = view?.People
            .Where(person => person.PersonId != Guid.Empty)
            .ToList() ?? [];
        var key = string.Join(",", people.Select(person => person.PersonId).OrderBy(id => id));
        if (!string.Equals(key, _documentPeopleRosterKey, StringComparison.Ordinal))
        {
            _documentPeopleRosterKey = key;
            _selectedDocumentPersonIds.Clear();
            foreach (var person in people)
                _selectedDocumentPersonIds.Add(person.PersonId);
            return;
        }

        var valid = people.Select(person => person.PersonId).ToHashSet();
        _selectedDocumentPersonIds.RemoveWhere(id => !valid.Contains(id));
    }

    private bool IsDocumentPersonSelected(Guid personId) =>
        personId != Guid.Empty && _selectedDocumentPersonIds.Contains(personId);

    private void ToggleDocumentPersonFilter(Guid personId)
    {
        if (personId == Guid.Empty)
            return;

        if (!_selectedDocumentPersonIds.Remove(personId))
            _selectedDocumentPersonIds.Add(personId);
    }

    private string? _selectedIssuedKey;
    private string? _issuedDeleteError;

    private static string IssuedEmptyHint(ApplicationWorkspaceCaseView view, ApplicationWorkspaceCaseIssuedTile tile)
    {
        var number = view.Chrome.DisplayNumber;
        if (string.IsNullOrWhiteSpace(number))
            return tile.EmptyHint;

        return tile.EmptyHint.Replace(
            "this application.",
            "Application № " + number + ".",
            StringComparison.Ordinal);
    }

    private void SelectIssuedTile(string key)
    {
        _issuedDeleteError = null;
        _selectedIssuedKey = string.Equals(_selectedIssuedKey, key, StringComparison.OrdinalIgnoreCase)
            ? null
            : key;
    }

    private void IssueRecordQuickAction()
    {
        var tiles = Snapshot?.CaseView.IssuedRecordTiles;
        if (tiles == null || tiles.Count == 0)
            return;

        var empty = tiles.FirstOrDefault(t => t.Count == 0);
        _selectedIssuedKey = (empty ?? tiles[0]).Key;
    }

    private async Task NewIssuedHeaderAsync(string key)
    {
        if (Snapshot == null || Snapshot.ApplicationProfileInstanceId == Guid.Empty)
            return;

        if (IssueIssuedHeaderComposeService.TryResolveKind(key, out _))
        {
            await OpenIssuedHeaderInSlotAsync(key, existingHeaderId: null);
            return;
        }

        if (string.Equals(key, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase)
            && await TryOpenIssuedVisaInSlotAsync())
        {
            return;
        }

        if (IssuedHeaderNewRequested.HasDelegate)
            await IssuedHeaderNewRequested.InvokeAsync(key);
    }

    private async Task OpenIssuedHeaderAsync(string key, Guid id)
    {
        if (id == Guid.Empty)
            return;

        if (IssueIssuedHeaderComposeService.TryResolveKind(key, out _))
        {
            await OpenIssuedHeaderInSlotAsync(key, id);
            return;
        }

        if (string.Equals(key, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase)
            && await TryOpenIssuedVisaInSlotAsync(id))
        {
            return;
        }

        if (!IssuedHeaderOpenRequested.HasDelegate)
            return;

        await IssuedHeaderOpenRequested.InvokeAsync(new ApplicationWorkspaceIssuedHeaderOpenRequest
        {
            Key = key,
            Id = id,
        });
    }

    private async Task OpenIssuedHeaderInSlotAsync(string key, Guid? existingHeaderId)
    {
        if (Snapshot == null || Snapshot.ApplicationProfileInstanceId == Guid.Empty)
            return;

        if (!IssueIssuedHeaderComposeService.TryResolveKind(key, out var kind))
            return;

        var catalog = IssueIssuedHeaderComposeService.CatalogKeyFor(kind);
        var appId = Snapshot.ApplicationProfileInstanceId;
        var headerId = existingHeaderId is Guid id && id != Guid.Empty ? id : (Guid?)null;
        var existingText = headerId is Guid h ? h.ToString("D") : string.Empty;
        var request = new IssueIssuedHeaderSlotRequest
        {
            ApplicationProfileInstanceId = appId,
            Kind = kind,
            CatalogKey = catalog,
            ExistingHeaderId = headerId,
        };

        // DI first so same-circuit Host StateChanged always sees the new header id.
        await PreviewSlotService.OpenIssueIssuedHeaderAsync(request, PreviewSlotOwnerViewId);

        // JS bridge for Host when it lives on a separate render root / circuit.
        try
        {
            await JS.InvokeAsync<bool>(
                "visaPreviewDrawer.openIssueIssuedHeader",
                appId.ToString("D"),
                kind.ToString(),
                catalog,
                PreviewSlotOwnerViewId ?? string.Empty,
                existingText);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task<bool> TryOpenIssuedVisaInSlotAsync(Guid? existingVisaId = null)
    {
        if (Snapshot == null || Snapshot.ApplicationProfileInstanceId == Guid.Empty)
            return false;

        var tiles = Snapshot.CaseView?.IssuedRecordTiles;
        if (tiles == null || tiles.Count == 0)
            return false;

        var invitationVisible = tiles.Any(t => string.Equals(t.Key, ApplicationWorkspaceIssuedRecordsCatalog.Invitation, StringComparison.OrdinalIgnoreCase));
        var visaVisible = tiles.Any(t => string.Equals(t.Key, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase));
        if (!invitationVisible || !visaVisible)
            return false;

        var appId = Snapshot.ApplicationProfileInstanceId;
        Guid? visaId = existingVisaId is Guid id && id != Guid.Empty ? id : null;
        var request = new IssueIssuedVisaSlotRequest
        {
            ApplicationProfileInstanceId = appId,
            ExistingVisaId = visaId,
        };

        await PreviewSlotService.OpenIssueIssuedVisaAsync(request, PreviewSlotOwnerViewId);

        try
        {
            await JS.InvokeAsync<bool>(
                "visaPreviewDrawer.openIssueIssuedVisa",
                appId.ToString("D"),
                PreviewSlotOwnerViewId ?? string.Empty,
                visaId is Guid v ? v.ToString("D") : string.Empty);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        return true;
    }

    private async Task PreviewIssuedHeaderCopyAsync(string catalogKey, Guid headerId)
    {
        if (headerId == Guid.Empty)
            return;
        if (!ApplicationWorkspaceIssuedRecordsCatalog.TryGetDocumentCopiesFamily(catalogKey, out var family))
            return;

        var request = new HeaderDocumentCopiesSlotRequest
        {
            Family = family,
            ParentId = headerId,
            OpenPreviewOnly = true,
        };

        await PreviewSlotService.OpenHeaderDocumentCopiesAsync(request, PreviewSlotOwnerViewId);

        try
        {
            await JS.InvokeVoidAsync(
                "visaPreviewDrawer.openHeaderDocumentCopiesPreview",
                family.ToString(),
                headerId.ToString("D"),
                PreviewSlotOwnerViewId ?? string.Empty);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task DeleteIssuedHeaderAsync(string catalogKey, Guid headerId, string caption)
    {
        _issuedDeleteError = null;
        if (Snapshot == null || headerId == Guid.Empty)
            return;
        if (string.Equals(catalogKey, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase))
        {
            await DeleteIssuedVisaAsync(headerId, caption);
            return;
        }
        if (!IssueIssuedHeaderComposeService.TryResolveKind(catalogKey, out var kind))
            return;

        var noun = IssuedHeaderNoun(kind);
        var label = string.IsNullOrWhiteSpace(caption) ? noun : $"{noun} {caption}";
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {label}? This cannot be undone.");
        }
        catch (JSException)
        {
            return;
        }
        catch (InvalidOperationException)
        {
            return;
        }

        if (!confirmed)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var result = IssueIssuedHeaderComposeService.Delete(
            objectSpace,
            Snapshot.ApplicationProfileInstanceId,
            kind,
            headerId);
        if (!result.Succeeded)
        {
            _issuedDeleteError = result.ErrorMessage;
            return;
        }

        await CloseIssuedHeaderPreviewIfOpenAsync(kind, headerId);
        WorkspaceActions.NotifyWorkspaceChanged();
    }

    private async Task DeleteIssuedVisaAsync(Guid visaId, string caption)
    {
        _issuedDeleteError = null;
        if (Snapshot == null || visaId == Guid.Empty)
            return;

        var label = string.IsNullOrWhiteSpace(caption) ? "visa" : $"visa {caption}";
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {label}? This cannot be undone.");
        }
        catch (JSException)
        {
            return;
        }
        catch (InvalidOperationException)
        {
            return;
        }

        if (!confirmed)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var result = IssueIssuedVisaComposeService.Delete(
            objectSpace,
            Snapshot.ApplicationProfileInstanceId,
            visaId);
        if (!result.Succeeded)
        {
            _issuedDeleteError = result.ErrorMessage;
            return;
        }

        await CloseIssuedVisaSurfacesIfOpenAsync(visaId);
        WorkspaceActions.NotifyWorkspaceChanged();
    }

    private async Task CloseIssuedVisaSurfacesIfOpenAsync(Guid visaId)
    {
        if (Snapshot == null || visaId == Guid.Empty)
            return;

        var state = PreviewSlotService.State;
        var close = false;
        if (state.Mode == VisaPreviewSlotMode.IssueIssuedVisa
            && state.IssueIssuedVisa?.ExistingVisaId == visaId)
        {
            close = true;
        }
        else if (state.Mode == VisaPreviewSlotMode.HeaderDocumentCopies
            && state.HeaderDocumentCopies?.Family == HeaderDocumentCopiesFamily.Visa
            && state.HeaderDocumentCopies.ParentId == visaId)
        {
            close = true;
        }

        if (!close)
            return;

        await PreviewSlotService.CloseAsync();
        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.close");
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task CloseIssuedHeaderPreviewIfOpenAsync(IssueIssuedHeaderKind kind, Guid headerId)
    {
        if (Snapshot == null || headerId == Guid.Empty)
            return;

        var expected = VisaPreviewSlotOccupantKeys.ForIssueIssuedHeader(new IssueIssuedHeaderSlotRequest
        {
            ApplicationProfileInstanceId = Snapshot.ApplicationProfileInstanceId,
            Kind = kind,
            CatalogKey = IssueIssuedHeaderComposeService.CatalogKeyFor(kind),
            ExistingHeaderId = headerId,
        });
        if (!string.Equals(PreviewSlotService.State.OccupantKey, expected, StringComparison.Ordinal))
            return;

        await PreviewSlotService.CloseAsync();
        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.close");
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private static string IssuedHeaderNoun(IssueIssuedHeaderKind kind) => kind switch
    {
        IssueIssuedHeaderKind.Invitation => "invitation",
        IssueIssuedHeaderKind.WorkPermit => "work permit",
        IssueIssuedHeaderKind.Rejection => "rejection",
        IssueIssuedHeaderKind.BorderZone => "border zone",
        _ => "record",
    };

    private RenderFragment RenderSummaryTile(ApplicationWorkspaceCaseSummaryTile field) => __builder =>
    {
        <div class="cw-sum-tile cw-sum-tile--@field.Tone cw-sum-tile--fill-@FillCss(field.FillState)">
            <span class="cw-sum-tile__icon">@field.Glyph</span>
            <span class="cw-sum-tile__label">@field.Label</span>
            <strong class="cw-sum-tile__value">@field.Value</strong>
        </div>
    };

    private RenderFragment RenderSummaryField(ApplicationWorkspaceCaseHeaderField field) => __builder =>
    {
        <label class="cw-summary-field cw-summary-field--fill-@FillCss(field.FillState)">
            <span class="cw-summary-field__label">@field.Label</span>
            @if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Date)
            {
                <input type="date"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnHeaderFieldChanged(field.Key, e.Value?.ToString())" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.CommaSeparatedMultiSelect)
            {
                <BorderZoneLocationField Value="@field.Value"
                                         EditorAlias="@EditorAliasFor(field.Key)"
                                         ReadOnly="@field.ReadOnly"
                                         CatalogItems="@field.MultiSelectOptions"
                                         ValueChanged="@(value => OnHeaderFieldChanged(field.Key, value))" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Lookup)
            {
                <select class="cw-summary-field__input"
                        value="@field.Value"
                        disabled="@field.ReadOnly"
                        @onchange="e => OnHeaderFieldChanged(field.Key, e.Value?.ToString())">
                    <option value="">— Select —</option>
                    @foreach (var option in field.Options)
                    {
                        var optionId = option.Id.ToString("D");
                        <option value="@optionId" selected="@(string.Equals(field.Value, optionId, StringComparison.OrdinalIgnoreCase))">@option.DisplayName</option>
                    }
                </select>
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.ShortText)
            {
                <input type="text"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       maxlength="@(field.MaxLength ?? ApplicationWorkspaceCaseHeaderFieldsHelper.InstanceNumberMaxLength)"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnHeaderFieldChanged(field.Key, e.Value?.ToString())" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Text)
            {
                <textarea class="cw-summary-field__input cw-summary-field__textarea"
                          maxlength="@ApplicationWorkspaceCaseHeaderFieldsHelper.PurposeMaxLength"
                          rows="4"
                          disabled="@field.ReadOnly"
                          @onchange="e => OnHeaderFieldChanged(field.Key, e.Value?.ToString())">@field.Value</textarea>
            }
            else
            {
                <input type="text"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnHeaderFieldChanged(field.Key, e.Value?.ToString())" />
            }
        </label>
    };

    private RenderFragment RenderOverview(ApplicationWorkspaceCaseView view) => __builder =>
    {
        <div class="cw-overview">
            <section class="cw-card">
                <div class="cw-card__title-row">
                    <div>
                        <h2 class="cw-card__title">Case summary</h2>
                        @{
                            var summaryProfileName = !string.IsNullOrWhiteSpace(view.Chrome.ProfileTemplateName)
                                ? view.Chrome.ProfileTemplateName
                                : Snapshot!.Profile.Title;
                        }
                        <p class="cw-summary-sub">
                            @if (!string.IsNullOrWhiteSpace(summaryProfileName))
                            {
                                <span>Application Profile: <strong>@summaryProfileName</strong></span>
                                <span> · </span>
                            }
                            <span>Use fields only@(IsCaseSummaryEditing ? " · Saved on this case (defaults copied at create)" : null)</span>
                        </p>
                    </div>
                    @if (view.HeaderFields.Count > 0)
                    {
                        @if (IsCaseSummaryEditing)
                        {
                            <button type="button" class="cw-summary-mode-btn" @onclick="FinishCaseSummaryEdit">Done</button>
                        }
                        else
                        {
                            <button type="button" class="cw-summary-mode-btn" @onclick="StartCaseSummaryEdit">✎ Edit</button>
                        }
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(HeaderFieldStatusMessage))
                {
                    <p class="cw-summary-status @(HeaderFieldStatusIsError ? "is-error" : null)">@HeaderFieldStatusMessage</p>
                }
                @if (view.HeaderFields.Count == 0 && view.SummaryTiles.Count == 0)
                {
                    <p class="cw-summary-empty">No ApplicationProfileInstance properties required on this profile.</p>
                }
                else if (IsCaseSummaryEditing && view.HeaderFields.Count > 0)
                {
                    var identityFields = IdentityHeaderFields(view.HeaderFields);
                    var mainFields = MainHeaderFields(view.HeaderFields);
                    <div class="cw-summary-body @(mainFields.Count == 0 ? "cw-summary-body--identity-only" : null)">
                        @if (mainFields.Count > 0)
                        {
                            <div class="cw-summary-main">
                                <div class="cw-summary-form">
                                    @foreach (var field in mainFields)
                                    {
                                        @RenderSummaryField(field)
                                    }
                                </div>
                            </div>
                        }
                        @if (identityFields.Count > 0)
                        {
                            <aside class="cw-summary-identity" aria-label="Application number, date, process number, and urgency">
                                <div class="cw-summary-form cw-summary-form--stack">
                                    @foreach (var field in identityFields)
                                    {
                                        @RenderSummaryField(field)
                                    }
                                </div>
                            </aside>
                        }
                    </div>
                    <p class="cw-summary-foot">Changing these does not change the Application Profile template.</p>
                }
                else
                {
                    var tiles = OverviewTiles(view).ToList();
                    var identityTiles = IdentityTiles(tiles);
                    var mainTiles = MainTiles(tiles);
                    <div class="cw-summary-body @(mainTiles.Count == 0 ? "cw-summary-body--identity-only" : null)">
                        @if (mainTiles.Count > 0)
                        {
                            <div class="cw-summary-main">
                                <div class="cw-summary-grid">
                                    @foreach (var field in mainTiles)
                                    {
                                        @RenderSummaryTile(field)
                                    }
                                </div>
                            </div>
                        }
                        @if (identityTiles.Count > 0)
                        {
                            <aside class="cw-summary-identity" aria-label="Application number, date, process number, and urgency">
                                <div class="cw-summary-grid cw-summary-grid--stack">
                                    @foreach (var field in identityTiles)
                                    {
                                        @RenderSummaryTile(field)
                                    }
                                </div>
                            </aside>
                        }
                    </div>
                }
            </section>
            <section class="cw-card">
                <h2 class="cw-card__title">ApplicationProfileInstance progress</h2>
                <div class="cw-prog-stepper">
                @for (var i = 0; i < view.ProgressSteps.Count; i++)
                {
                    var step = view.ProgressSteps[i];
                    var currentIdx = view.ProgressSteps.ToList().FindIndex(s => s.State == "current");
                    var badge = !string.IsNullOrWhiteSpace(step.CurrentStateLabel)
                        ? step.CurrentStateLabel
                        : step.State == "done" && !string.Equals(step.Key, "office", StringComparison.OrdinalIgnoreCase)
                            ? "Completed"
                            : step.State == "current" ? "In progress"
                            : step.State == "pending" ? "Pending"
                            : string.Empty;
                    var badgeCls = step.OutcomeKind switch
                    {
                        "issued" => "issued",
                        "rejected" => "rejected",
                        "cancelled" => "cancelled",
                        "current" => "active",
                        "pending" => "muted",
                        _ => "ok",
                    };
                    var lineCls = i < view.ProgressSteps.Count - 1
                        ? i < currentIdx ? "done" : i == currentIdx ? "current" : "pending"
                        : null;
                    var dotGlyph = step.OutcomeKind switch
                    {
                        "rejected" => "✕",
                        "cancelled" => "–",
                        "issued" or "ok" => "✓",
                        _ => step.State == "done" ? "✓" : (i + 1).ToString(),
                    };
                        <div class="cw-prog-step cw-prog-step--@step.State cw-prog-step--tone-@step.OutcomeKind">
                            <div class="cw-prog-step__track">
                                <span class="cw-prog-step__dot">@dotGlyph</span>
                                @if (lineCls != null)
                                {
                                    <span class="cw-prog-step__line cw-prog-step__line--@lineCls"></span>
                                }
                            </div>
                            <div class="cw-prog-step__body">
                                <strong>@step.Label</strong>
                                @if (!string.IsNullOrWhiteSpace(badge))
                                {
                                    <span class="cw-prog-step__badge cw-prog-step__badge--@badgeCls">@badge</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(step.Date))
                                {
                                    <span class="cw-prog-step__date">@step.Date</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(step.MinistryLetterFileName) && step.ProgressId is Guid)
                                {
                                    <span class="cw-prog-step__letter">
                                        <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                                           ProgressId="step.ProgressId"
                                                                           FileName="@step.MinistryLetterFileName"
                                                                           OwnerViewId="@PreviewSlotOwnerViewId" />
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
            <section class="cw-card">
                <h2 class="cw-card__title">Linked records</h2>
                @if (view.Chrome.ResolvedLinksLocked)
                {
                    <p class="cw-linked-lock">🔒 Process complete — linked people and records are locked on this case.</p>
                }
                @if (view.LinkedRecordTiles.Count == 0)
                {
                    <p class="cw-linked-empty">No linked person-related records yet. Link people on the <strong>People &amp; links</strong> tab — records auto-resolve from profile requirements.</p>
                }
                else
                {
                    <div class="cw-link-row">
                        @foreach (var tile in view.LinkedRecordTiles)
                        {
                            <button type="button"
                                    class="cw-link-tile cw-link-tile--@tile.Tone @(tile.Count < Math.Max(tile.ExpectedCount, 1) ? "is-empty" : null)"
                                    @onclick="() => OpenLinkedRecordTile(tile.TabKey)">
                                <span class="cw-link-tile__icon">@tile.Glyph</span>
                                <span class="cw-link-tile__label">@tile.Label</span>
                                <strong class="cw-link-tile__count">@FormatLinkedCount(tile.Count, tile.ExpectedCount)</strong>
                                <span class="cw-link-tile__chev">›</span>
                            </button>
                        }
                    </div>
                }
            </section>
            @if (view.IssuedRecordTiles.Count > 0)
            {
                var selectedIssued = view.IssuedRecordTiles.FirstOrDefault(t =>
                    string.Equals(t.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase));
                <section class="cw-card">
                    <h2 class="cw-card__title">Issued records</h2>
                    <p class="cw-card__sub">Created by this application · visible when May produce is on</p>
                    <div class="cw-issued-row">
                        @foreach (var tile in view.IssuedRecordTiles)
                        {
                            var isSelected = string.Equals(tile.Key, _selectedIssuedKey, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="cw-link-tile cw-link-tile--@tile.Tone cw-issued-tile @(tile.Count == 0 ? "is-empty" : null) @(isSelected ? "is-selected" : null)"
                                    @onclick="() => SelectIssuedTile(tile.Key)">
                                <span class="cw-link-tile__icon">@tile.Glyph</span>
                                <span class="cw-link-tile__label">@tile.Label</span>
                                @if (tile.Count == 0)
                                {
                                    <span class="cw-issued-tile__add">@tile.AddCaption</span>
                                }
                                else
                                {
                                    <strong class="cw-link-tile__count">@tile.Count</strong>
                                }
                                <span class="cw-link-tile__chev">›</span>
                            </button>
                        }
                    </div>
                    @if (selectedIssued != null)
                    {
                        <div class="cw-issued-panel">
                            <h3 class="cw-issued-panel__title">@selectedIssued.PanelTitle</h3>
                            @if (selectedIssued.Count == 0)
                            {
                                <p class="cw-issued-panel__hint">@IssuedEmptyHint(view, selectedIssued)</p>
                            }
                            else
                            {
                                <ul class="cw-issued-list">
                                    @foreach (var row in selectedIssued.Rows)
                                    {
                                        var issuedRowId = row.Id;
                                        var issuedCatalogKey = selectedIssued.Key;
                                        var issuedTitle = row.Title;
                                        var canDeleteIssued = IssueIssuedHeaderComposeService.TryResolveKind(issuedCatalogKey, out _);
                                        var isIssuedVisa = string.Equals(
                                            issuedCatalogKey,
                                            ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa,
                                            StringComparison.OrdinalIgnoreCase);
                                        var canPreviewIssued = canDeleteIssued || isIssuedVisa;
                                        var issuedRowOpen = IsIssuedRowOpen(issuedCatalogKey, issuedRowId);
                                        <li class="cw-issued-list__row @(issuedRowOpen ? "is-selected" : null)">
                                            <button type="button"
                                                    class="cw-issued-list__item"
                                                    aria-current="@(issuedRowOpen ? "true" : null)"
                                                    @onclick="() => OpenIssuedHeaderAsync(issuedCatalogKey, issuedRowId)">
                                                <strong>@issuedTitle</strong>
                                                <span>@row.Subtitle</span>
                                            </button>
                                            @if (canPreviewIssued)
                                            {
                                                <button type="button"
                                                        class="cw-issued-list__preview"
                                                        title="@(row.HasCopy ? "Preview copy" : "No copy attached yet")"
                                                        disabled="@(!row.HasCopy)"
                                                        @onclick="() => PreviewIssuedHeaderCopyAsync(issuedCatalogKey, issuedRowId)"
                                                        @onclick:stopPropagation="true">
                                                    Preview
                                                </button>
                                            }
                                            @if (canDeleteIssued || isIssuedVisa)
                                            {
                                                <button type="button"
                                                        class="cw-issued-list__delete"
                                                        title="Delete"
                                                        @onclick="() => DeleteIssuedHeaderAsync(issuedCatalogKey, issuedRowId, issuedTitle)"
                                                        @onclick:stopPropagation="true">
                                                    Delete
                                                </button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrWhiteSpace(_issuedDeleteError))
                            {
                                <p class="cw-issued-panel__error">@_issuedDeleteError</p>
                            }
                            <div class="cw-issued-panel__actions">
                                <button type="button" class="os-btn os-btn--primary" @onclick="() => NewIssuedHeaderAsync(selectedIssued.Key)">@selectedIssued.NewCaption</button>
                            </div>
                        </div>
                    }
                </section>
            }
            <p class="cw-foot">Application Profile: @(string.IsNullOrWhiteSpace(view.Chrome.ProfileTemplateName) ? Snapshot!.Profile.Title : view.Chrome.ProfileTemplateName)</p>
        </div>;
    };

