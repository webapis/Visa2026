    private void ApplyStagedHeaderSelection()
    {
        var staged = StagedHeaderSelection;
        if (staged == null || staged.Token == _seenStageToken || string.IsNullOrWhiteSpace(staged.Key))
            return;

        _seenStageToken = staged.Token;
        ApplyHeaderDraft(staged.Key, staged.Value, staged.DisplayName);
    }

    private void ReapplyPendingHeaderFields()
    {
        var fields = Snapshot?.CaseView.HeaderFields;
        if (fields == null || ReferenceEquals(fields, _boundHeaderFields) || _pendingHeaders.Count == 0)
        {
            _boundHeaderFields = fields;
            return;
        }

        var pending = _pendingHeaders
            .Select(item => (item.Key, item.Value.Value, item.Value.DisplayName))
            .ToList();
        _headerOriginals = null;
        _boundHeaderFields = fields;
        foreach (var item in pending)
            ApplyHeaderDraft(item.Key, item.Value, item.DisplayName);
    }

    private void ApplyHeaderDraft(string key, string? value, string? displayName)
    {
        if (_summarySaving || string.IsNullOrWhiteSpace(key))
            return;

        var field = Snapshot?.CaseView.HeaderFields.FirstOrDefault(item =>
            string.Equals(item.Key, key, StringComparison.Ordinal));
        if (field == null || field.ReadOnly)
            return;

        RememberHeaderOriginal(field);
        var text = value ?? string.Empty;
        field.Value = text;
        if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Lookup)
        {
            field.SelectedId = Guid.TryParse(text, out var selected) && selected != Guid.Empty
                ? selected
                : null;
            var match = field.Options.FirstOrDefault(option =>
                string.Equals(OptionValue(option), text, StringComparison.OrdinalIgnoreCase));
            if (match == null
                && !string.IsNullOrWhiteSpace(displayName)
                && field.SelectedId is Guid added)
            {
                match = new ApplicationWorkspaceLookupOption
                {
                    Id = added,
                    DisplayName = displayName,
                };
                field.Options = field.Options.Append(match).ToList();
            }

            field.DisplayValue = match?.DisplayName
                ?? (string.IsNullOrWhiteSpace(text) ? "—" : text);
        }
        else if (string.IsNullOrWhiteSpace(text))
        {
            field.DisplayValue = "—";
        }
        else
        {
            field.DisplayValue = text;
        }

        var original = _headerOriginals![field.Key];
        if (string.Equals(text, original.Value, StringComparison.Ordinal))
            _pendingHeaders.Remove(field.Key);
        else
            _pendingHeaders[field.Key] = new PendingHeader(text, displayName);
    }

    private void RememberHeaderOriginal(ApplicationWorkspaceCaseHeaderField field)
    {
        _headerOriginals ??= new Dictionary<string, HeaderOriginal>(StringComparer.Ordinal);
        if (_headerOriginals.ContainsKey(field.Key))
            return;

        _headerOriginals[field.Key] = new HeaderOriginal(
            field.Value ?? string.Empty,
            field.DisplayValue ?? "—",
            field.SelectedId,
            field.Options);
    }

    private void DiscardCaseSummaryDraft()
    {
        var fields = Snapshot?.CaseView.HeaderFields;
        if (fields != null && _headerOriginals != null)
        {
            foreach (var field in fields)
            {
                if (!_headerOriginals.TryGetValue(field.Key, out var original))
                    continue;

                field.Value = original.Value;
                field.DisplayValue = original.DisplayValue;
                field.SelectedId = original.SelectedId;
                field.Options = original.Options;
            }
        }

        _pendingHeaders.Clear();
        _headerOriginals = null;
        _caseSummaryEditing = false;
    }

    private static string OptionValue(ApplicationWorkspaceLookupOption option) =>
        !string.IsNullOrWhiteSpace(option.SearchText)
            ? option.SearchText
            : option.Id.ToString("D");

    private sealed record HeaderOriginal(
        string Value,
        string DisplayValue,
        Guid? SelectedId,
        IReadOnlyList<ApplicationWorkspaceLookupOption> Options);

    private sealed record PendingHeader(string Value, string? DisplayName);

    private void SyncPeopleRecordFocus()
    {
        var focus = string.IsNullOrWhiteSpace(PeopleLinkedRecordFocusKey)
            ? null
            : PeopleLinkedRecordFocusKey.Trim();
        if (string.Equals(focus, _appliedPeopleFocusKey, StringComparison.OrdinalIgnoreCase))
            return;

        _appliedPeopleFocusKey = focus;
        _peopleRecordKey = focus;
        _peopleRecordPersonIndex = null;
    }

    private void SyncDocumentPeopleFilter(ApplicationWorkspaceCaseView? view)
    {
        var people = view?.ActivePeople
            .Where(person => person.PersonId != Guid.Empty)
            .ToList() ?? [];
        var key = string.Join(",", people.Select(person => person.PersonId).OrderBy(id => id));
        if (!string.Equals(key, _documentPeopleRosterKey, StringComparison.Ordinal))
        {
            _documentPeopleRosterKey = key;
            _selectedDocumentPersonIds.Clear();
            foreach (var person in people)
                _selectedDocumentPersonIds.Add(person.PersonId);
            return;
        }

        var valid = people.Select(person => person.PersonId).ToHashSet();
        _selectedDocumentPersonIds.RemoveWhere(id => !valid.Contains(id));
    }

    private bool IsDocumentPersonSelected(Guid personId) =>
        personId != Guid.Empty && _selectedDocumentPersonIds.Contains(personId);

    private void ToggleDocumentPersonFilter(Guid personId)
    {
        if (personId == Guid.Empty)
            return;

        if (!_selectedDocumentPersonIds.Remove(personId))
            _selectedDocumentPersonIds.Add(personId);
    }

    private void SetDocumentPersonSelected(Guid personId, bool selected)
    {
        if (personId == Guid.Empty)
            return;

        if (selected)
            _selectedDocumentPersonIds.Add(personId);
        else
            _selectedDocumentPersonIds.Remove(personId);
    }

    private void OnSelectAllPeopleChanged(ChangeEventArgs e)
    {
        var selected = e.Value is bool flag
            ? flag
            : string.Equals(Convert.ToString(e.Value), "true", StringComparison.OrdinalIgnoreCase);
        SetAllDocumentPeopleSelected(selected);
    }

    private void OnPersonRowCheckedChanged(Guid personId, ChangeEventArgs e)
    {
        var selected = e.Value is bool flag
            ? flag
            : string.Equals(Convert.ToString(e.Value), "true", StringComparison.OrdinalIgnoreCase);
        SetDocumentPersonSelected(personId, selected);
    }

    private void OnDocumentCopiesCatalogReloaded()
    {
        _documentCopiesCompletenessKey = null;
        _documentCopiesLoadAttempted = false;
        EnsureDocumentCopiesCompleteness(Snapshot?.CaseView);
    }

    private void EnsureDocumentCopiesCompleteness(ApplicationWorkspaceCaseView? view)
    {
        var people = view?.ActivePeople
            .Where(person => person.PersonId != Guid.Empty)
            .ToList() ?? [];
        var instanceId = Snapshot?.ApplicationProfileInstanceId ?? Guid.Empty;
        var key = instanceId.ToString("N") + ":" + string.Join(";", people.Select(person =>
            person.PersonId.ToString("N") + ":" + string.Join(",",
                person.Records.Select(record => record.Key + "=" + record.Count))));
        if (string.Equals(key, _documentCopiesCompletenessKey, StringComparison.Ordinal))
            return;

        if (people.Count == 0)
        {
            _documentCopiesCompletenessKey = key;
            _documentCopiesNavReady = true;
            _documentCopiesNav = ApplicationWorkspaceDocumentCopiesCompleteness.NavStatus.EmptyRoster;
            _documentCopiesMissing = 0;
            return;
        }

        if (instanceId == Guid.Empty)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var personIds = people.Select(person => person.PersonId).Distinct().ToList();
        var summary = ApplicationWorkspaceDocumentCopiesCompleteness.TryLoadSummary(
            objectSpace,
            instanceId,
            personIds);
        if (summary == null)
            return;

        _documentCopiesCompletenessKey = key;
        _documentCopiesNavReady = true;
        _documentCopiesMissing = ApplicationWorkspaceDocumentCopiesCompleteness.MissingSlotCount(summary);
        _documentCopiesNav = ApplicationWorkspaceDocumentCopiesCompleteness.Resolve(hasPeople: true, summary);
    }

    private string? _selectedIssuedKey;
    private string? _issuedDeleteError;
    private bool _issuedDeleteConfirmVisible;
    private string _issuedDeleteConfirmMessage = string.Empty;
    private string? _pendingIssuedDeleteCatalogKey;
    private Guid _pendingIssuedDeleteId;
    private bool _pendingIssuedDeleteIsVisa;

    private static string IssuedEmptyHint(ApplicationWorkspaceCaseView view, ApplicationWorkspaceCaseIssuedTile tile) =>
        ApplicationProfileLocalization.IssuedEmptyHint(tile.Label, view.Chrome.DisplayNumber);

    private static string IssuedColumnCaption(string key) =>
        VisaUiMessages.Get(key).TrimEnd(' ', '*');

    private void SelectIssuedTile(string key)
    {
        _issuedDeleteError = null;
        _selectedIssuedKey = string.Equals(_selectedIssuedKey, key, StringComparison.OrdinalIgnoreCase)
            ? null
            : key;
    }

    private async Task AddIssuedHeaderAsync(ApplicationWorkspaceCaseIssuedTile tile)
    {
        if (tile == null || !ApplicationWorkspaceIssuedResultOverview.CanCreateMore(tile))
            return;

        _issuedDeleteError = null;
        _selectedIssuedKey = tile.Key;
        await NewIssuedHeaderAsync(tile.Key);
    }

    private async Task NewIssuedHeaderAsync(string key)
    {
        if (TryBlockIncompleteProcessWork())
            return;

        if (Snapshot == null || Snapshot.ApplicationProfileInstanceId == Guid.Empty)
            return;

        var tile = Snapshot.CaseView?.IssuedRecordTiles?.FirstOrDefault(t =>
            string.Equals(t.Key, key, StringComparison.OrdinalIgnoreCase));
        if (tile != null && !ApplicationWorkspaceIssuedResultOverview.CanCreateMore(tile))
            return;

        if (IssueIssuedHeaderComposeService.TryResolveKind(key, out _))
        {
            await OpenIssuedHeaderInSlotAsync(key, existingHeaderId: null);
            return;
        }

        if (string.Equals(key, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase)
            && await TryOpenIssuedVisaInSlotAsync())
        {
            return;
        }

        if (IssuedHeaderNewRequested.HasDelegate)
            await IssuedHeaderNewRequested.InvokeAsync(key);
    }

    private async Task OpenIssuedHeaderAsync(string key, Guid id)
    {
        if (id == Guid.Empty)
            return;

        if (IssueIssuedHeaderComposeService.TryResolveKind(key, out _))
        {
            await OpenIssuedHeaderInSlotAsync(key, id);
            return;
        }

        if (string.Equals(key, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase)
            && await TryOpenIssuedVisaInSlotAsync(id))
        {
            return;
        }

        if (!IssuedHeaderOpenRequested.HasDelegate)
            return;

        await IssuedHeaderOpenRequested.InvokeAsync(new ApplicationWorkspaceIssuedHeaderOpenRequest
        {
            Key = key,
            Id = id,
        });
    }

    private async Task OpenIssuedHeaderInSlotAsync(string key, Guid? existingHeaderId)
    {
        if (Snapshot == null || Snapshot.ApplicationProfileInstanceId == Guid.Empty)
            return;

        if (!IssueIssuedHeaderComposeService.TryResolveKind(key, out var kind))
            return;

        var catalog = IssueIssuedHeaderComposeService.CatalogKeyFor(kind);
        var appId = Snapshot.ApplicationProfileInstanceId;
        var headerId = existingHeaderId is Guid id && id != Guid.Empty ? id : (Guid?)null;
        var existingText = headerId is Guid h ? h.ToString("D") : string.Empty;
        Guid? sourceVisaId = null;
        if (kind == IssueIssuedHeaderKind.BorderZone && headerId == null)
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            sourceVisaId = IssueIssuedHeaderComposeService.TryResolveNextUngrantedSourceVisaId(objectSpace, appId);
        }

        var request = new IssueIssuedHeaderSlotRequest
        {
            ApplicationProfileInstanceId = appId,
            Kind = kind,
            CatalogKey = catalog,
            ExistingHeaderId = headerId,
            SourceVisaId = sourceVisaId,
        };

        // DI first so same-circuit Host StateChanged always sees the new header id.
        await PreviewSlotService.OpenIssueIssuedHeaderAsync(request, PreviewSlotOwnerViewId);

        // JS bridge for Host when it lives on a separate render root / circuit.
        try
        {
            await JS.InvokeAsync<bool>(
                "visaPreviewDrawer.openIssueIssuedHeader",
                appId.ToString("D"),
                kind.ToString(),
                catalog,
                PreviewSlotOwnerViewId ?? string.Empty,
                existingText);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task<bool> TryOpenIssuedVisaInSlotAsync(Guid? existingVisaId = null)
    {
        if (Snapshot == null || Snapshot.ApplicationProfileInstanceId == Guid.Empty)
            return false;

        var tiles = Snapshot.CaseView?.IssuedRecordTiles;
        if (tiles == null || tiles.Count == 0)
            return false;

        var invitationVisible = tiles.Any(t => string.Equals(t.Key, ApplicationWorkspaceIssuedRecordsCatalog.Invitation, StringComparison.OrdinalIgnoreCase));
        var visaVisible = tiles.Any(t => string.Equals(t.Key, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase));
        if (!invitationVisible || !visaVisible)
            return false;

        var appId = Snapshot.ApplicationProfileInstanceId;
        Guid? visaId = existingVisaId is Guid id && id != Guid.Empty ? id : null;
        var request = new IssueIssuedVisaSlotRequest
        {
            ApplicationProfileInstanceId = appId,
            ExistingVisaId = visaId,
        };

        await PreviewSlotService.OpenIssueIssuedVisaAsync(request, PreviewSlotOwnerViewId);

        try
        {
            await JS.InvokeAsync<bool>(
                "visaPreviewDrawer.openIssueIssuedVisa",
                appId.ToString("D"),
                PreviewSlotOwnerViewId ?? string.Empty,
                visaId is Guid v ? v.ToString("D") : string.Empty);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        return true;
    }

    private async Task PreviewIssuedHeaderCopyAsync(string catalogKey, Guid headerId)
    {
        if (headerId == Guid.Empty)
            return;
        if (!ApplicationWorkspaceIssuedRecordsCatalog.TryGetDocumentCopiesFamily(catalogKey, out var family))
            return;

        var request = new HeaderDocumentCopiesSlotRequest
        {
            Family = family,
            ParentId = headerId,
            OpenPreviewOnly = true,
        };

        await PreviewSlotService.OpenHeaderDocumentCopiesAsync(request, PreviewSlotOwnerViewId);

        try
        {
            await JS.InvokeVoidAsync(
                "visaPreviewDrawer.openHeaderDocumentCopiesPreview",
                family.ToString(),
                headerId.ToString("D"),
                PreviewSlotOwnerViewId ?? string.Empty);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private Task DeleteIssuedHeaderAsync(string catalogKey, Guid headerId, string caption)
    {
        _issuedDeleteError = null;
        if (Snapshot == null || headerId == Guid.Empty)
            return Task.CompletedTask;

        if (string.Equals(catalogKey, ApplicationWorkspaceIssuedRecordsCatalog.IssuedVisa, StringComparison.OrdinalIgnoreCase))
        {
            var visaNoun = Msg("ApplicationProfile.Doc.Visa");
            var visaLabel = string.IsNullOrWhiteSpace(caption) ? visaNoun : $"{visaNoun} {caption.Trim()}";
            _pendingIssuedDeleteCatalogKey = catalogKey;
            _pendingIssuedDeleteId = headerId;
            _pendingIssuedDeleteIsVisa = true;
            _issuedDeleteConfirmMessage = VisaUiMessages.Format(
                "ApplicationProfileInstance.Workspace.ConfirmDelete",
                visaLabel);
            _issuedDeleteConfirmVisible = true;
            return Task.CompletedTask;
        }

        if (!IssueIssuedHeaderComposeService.TryResolveKind(catalogKey, out var kind))
            return Task.CompletedTask;

        var noun = IssuedHeaderNounLocalized(kind);
        var label = string.IsNullOrWhiteSpace(caption) ? noun : $"{noun} {caption.Trim()}";
        _pendingIssuedDeleteCatalogKey = catalogKey;
        _pendingIssuedDeleteId = headerId;
        _pendingIssuedDeleteIsVisa = false;
        _issuedDeleteConfirmMessage = VisaUiMessages.Format(
            "ApplicationProfileInstance.Workspace.ConfirmDelete",
            label);
        _issuedDeleteConfirmVisible = true;
        return Task.CompletedTask;
    }

    private void CancelPendingIssuedDelete()
    {
        _issuedDeleteConfirmVisible = false;
        _pendingIssuedDeleteCatalogKey = null;
        _pendingIssuedDeleteId = Guid.Empty;
        _pendingIssuedDeleteIsVisa = false;
        _issuedDeleteConfirmMessage = string.Empty;
    }

    private async Task ConfirmPendingIssuedDeleteAsync()
    {
        var catalogKey = _pendingIssuedDeleteCatalogKey;
        var id = _pendingIssuedDeleteId;
        var isVisa = _pendingIssuedDeleteIsVisa;
        CancelPendingIssuedDelete();

        if (Snapshot == null || id == Guid.Empty)
            return;

        if (isVisa)
        {
            using var visaSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
            var visaResult = IssueIssuedVisaComposeService.Delete(
                visaSpace,
                Snapshot.ApplicationProfileInstanceId,
                id);
            if (!visaResult.Succeeded)
            {
                _issuedDeleteError = visaResult.ErrorMessage;
                return;
            }

            await CloseIssuedVisaSurfacesIfOpenAsync(id);
            WorkspaceActions.NotifyWorkspaceChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(catalogKey)
            || !IssueIssuedHeaderComposeService.TryResolveKind(catalogKey, out var kind))
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var result = IssueIssuedHeaderComposeService.Delete(
            objectSpace,
            Snapshot.ApplicationProfileInstanceId,
            kind,
            id);
        if (!result.Succeeded)
        {
            _issuedDeleteError = result.ErrorMessage;
            return;
        }

        await CloseIssuedHeaderPreviewIfOpenAsync(kind, id);
        WorkspaceActions.NotifyWorkspaceChanged();
    }

    private async Task CloseIssuedVisaSurfacesIfOpenAsync(Guid visaId)
    {
        if (Snapshot == null || visaId == Guid.Empty)
            return;

        var state = PreviewSlotService.State;
        var close = false;
        if (state.Mode == VisaPreviewSlotMode.IssueIssuedVisa
            && state.IssueIssuedVisa?.ExistingVisaId == visaId)
        {
            close = true;
        }
        else if (state.Mode == VisaPreviewSlotMode.HeaderDocumentCopies
            && state.HeaderDocumentCopies?.Family == HeaderDocumentCopiesFamily.Visa
            && state.HeaderDocumentCopies.ParentId == visaId)
        {
            close = true;
        }

        if (!close)
            return;

        await PreviewSlotService.CloseAsync();
        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.close");
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task CloseIssuedHeaderPreviewIfOpenAsync(IssueIssuedHeaderKind kind, Guid headerId)
    {
        if (Snapshot == null || headerId == Guid.Empty)
            return;

        var expected = VisaPreviewSlotOccupantKeys.ForIssueIssuedHeader(new IssueIssuedHeaderSlotRequest
        {
            ApplicationProfileInstanceId = Snapshot.ApplicationProfileInstanceId,
            Kind = kind,
            CatalogKey = IssueIssuedHeaderComposeService.CatalogKeyFor(kind),
            ExistingHeaderId = headerId,
        });
        if (!string.Equals(PreviewSlotService.State.OccupantKey, expected, StringComparison.Ordinal))
            return;

        await PreviewSlotService.CloseAsync();
        try
        {
            await JS.InvokeVoidAsync("visaPreviewDrawer.close");
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private static string IssuedHeaderNounLocalized(IssueIssuedHeaderKind kind) => kind switch
    {
        IssueIssuedHeaderKind.Invitation => VisaUiMessages.Get("ApplicationProfile.Doc.Invitation"),
        IssueIssuedHeaderKind.WorkPermit => VisaUiMessages.Get("ApplicationProfile.Doc.WorkPermit"),
        IssueIssuedHeaderKind.Rejection => VisaUiMessages.Get("ApplicationProfile.Doc.Rejection"),
        IssueIssuedHeaderKind.BorderZone => VisaUiMessages.Get("ApplicationProfile.Doc.BorderZone"),
        _ => VisaUiMessages.Get("ApplicationProfileInstance.Issued.Record"),
    };

