    private void StartCaseSummaryEdit()
    {
        EnsureHeaderLookupCatalogs();
        if (!_caseSummaryEditing)
            _boundHeaderFields = null;
        _caseSummaryEditing = true;
    }

    private void EnsureHeaderLookupCatalogs()
    {
        var view = Snapshot?.CaseView;
        if (view == null || view.HeaderFields.Count == 0)
            return;

        var needsCatalogs = view.HeaderFields.Any(field =>
            field.Kind is ApplicationWorkspaceCaseHeaderFieldKind.Lookup
                or ApplicationWorkspaceCaseHeaderFieldKind.CommaSeparatedMultiSelect
            && field.Options.Count == 0
            && field.MultiSelectOptions.Count == 0);
        if (!needsCatalogs)
            return;

        var applicationId = Snapshot!.ApplicationProfileInstanceId;
        if (applicationId == Guid.Empty)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        var application = objectSpace.GetObjectByKey<ApplicationProfileInstance>(applicationId);
        if (application == null)
            return;

        view.HeaderFields = ApplicationWorkspaceCaseHeaderFieldsHelper.Build(
            application,
            application.ApplicationProfile,
            objectSpace,
            loadLookupCatalogs: true);
    }

    private async Task FinishCaseSummaryEdit()
    {
        if (_summarySaving)
            return;

        // Mouse-down must not move focus. Read the focused value before the click ends,
        // then save every edited field once. Leaving the case without Done discards them.
        var focused = await ReadFocusedSummaryFieldAsync();
        ApplyFocusedSummaryField(focused);
        var updates = _pendingHeaders
            .Select(item => new ApplicationWorkspaceCaseHeaderFieldUpdate
            {
                Key = item.Key,
                Value = item.Value.Value,
            })
            .ToList();
        if (updates.Count == 0 || !HeaderFieldsSaved.HasDelegate)
        {
            _caseSummaryEditing = false;
            _pendingHeaders.Clear();
            _headerOriginals = null;
            return;
        }

        _summarySaving = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await HeaderFieldsSaved.InvokeAsync(updates);
            if (HeaderFieldStatusIsError)
                return;

            _pendingHeaders.Clear();
            _headerOriginals = null;
            _caseSummaryEditing = false;
        }
        finally
        {
            _summarySaving = false;
        }
    }

    private async Task<FocusedSummaryField?> ReadFocusedSummaryFieldAsync()
    {
        try
        {
            return await JS.InvokeAsync<FocusedSummaryField?>("visaCaseWorkspaceNav.readActiveSummaryField");
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
        catch (JSException)
        {
            return null;
        }
        catch (InvalidOperationException)
        {
            return null;
        }
    }

    private void ApplyFocusedSummaryField(FocusedSummaryField? focused)
    {
        if (focused == null || string.IsNullOrWhiteSpace(focused.Key))
            return;

        var field = Snapshot?.CaseView.HeaderFields.FirstOrDefault(item =>
            string.Equals(item.Key, focused.Key, StringComparison.Ordinal));
        if (field == null || field.ReadOnly)
            return;

        var value = NormalizeFocusedSummaryValue(field, focused.Value);
        if (value == null)
            return;

        ApplyHeaderDraft(field.Key, value, null);
    }

    private static string? NormalizeFocusedSummaryValue(ApplicationWorkspaceCaseHeaderField field, string? raw)
    {
        if (field.Kind != ApplicationWorkspaceCaseHeaderFieldKind.Date)
            return raw ?? string.Empty;

        var text = (raw ?? string.Empty).Trim();
        if (text.Length == 0)
            return string.Empty;

        if (DateTime.TryParseExact(text, "dd.MM.yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var display))
            return ApplicationWorkspaceCaseHeaderField.FormatEditorDate(display);

        if (DateTime.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var iso))
            return ApplicationWorkspaceCaseHeaderField.FormatEditorDate(iso);

        return null;
    }

    private sealed class FocusedSummaryField
    {
        public string Key { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

