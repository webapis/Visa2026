    private static List<ApplicationWorkspaceCaseHeaderField> IdentityHeaderFields(
        IEnumerable<ApplicationWorkspaceCaseHeaderField> fields)
    {
        var map = fields
            .Where(field => !string.IsNullOrEmpty(field.Key))
            .GroupBy(field => field.Key, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.Ordinal);
        var result = new List<ApplicationWorkspaceCaseHeaderField>(ApplicationWorkspaceCaseHeaderFieldsHelper.IdentityFieldKeys.Length);
        foreach (var key in ApplicationWorkspaceCaseHeaderFieldsHelper.IdentityFieldKeys)
        {
            if (map.TryGetValue(key, out var field))
                result.Add(field);
        }

        return result;
    }

