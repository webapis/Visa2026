    private static bool IsCreateFieldShown(PersonLinkReviewCreateForm form, PersonLinkReviewCreateField field)
    {
        if (string.IsNullOrEmpty(field.ShowWhenKey))
            return true;
        var other = form.Fields.FirstOrDefault(item => item.Key == field.ShowWhenKey);
        return string.Equals(other?.Value, field.ShowWhenValue, StringComparison.Ordinal);
    }

    private static IEnumerable<PersonLinkReviewCreateOption> CreateOptions(PersonLinkReviewCreateForm form, PersonLinkReviewCreateField field)
    {
        if (string.IsNullOrEmpty(field.FilterByKey))
            return field.Options;
        var parent = form.Fields.FirstOrDefault(item => item.Key == field.FilterByKey)?.Value;
        if (string.IsNullOrEmpty(parent))
            return Array.Empty<PersonLinkReviewCreateOption>();
        return field.Options.Where(option => string.Equals(option.ParentId, parent, StringComparison.Ordinal));
    }

    private void OnCreateFieldChanged(PersonLinkReviewCreateForm form, PersonLinkReviewCreateField field, ChangeEventArgs change)
    {
        field.Value = change.Value?.ToString() ?? string.Empty;
        foreach (var dependent in form.Fields.Where(item => item.FilterByKey == field.Key))
            dependent.Value = string.Empty;
        if (field.Key == "type")
        {
            foreach (var place in form.Fields.Where(item => item.ShowWhenKey == "type"))
                place.Value = string.Empty;
        }
    }

