    private static int SlaRemainingPercent(int? remaining, int total)
    {
        if (total <= 0)
            return remaining is > 0 ? 40 : 0;
        var days = Math.Max(remaining ?? 0, 0);
        return Math.Clamp((int)Math.Round(100.0 * days / total), 0, 100);
    }

    private static string SlaDisplayDate(string? value) =>
        string.IsNullOrWhiteSpace(value) || value == "—" ? "—" : value.Trim();

