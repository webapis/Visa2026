    private RenderFragment RenderPeople(ApplicationWorkspaceCaseView view) => __builder =>
    {
        var selectablePeople = view.ActivePeople.Where(p => p.PersonId != Guid.Empty).ToList();
        var allPeopleSelected = AreAllDocumentPeopleSelected(view);
        var anyPeopleSelected = _selectedDocumentPersonIds.Count > 0;
        <div class="ct-page">
            <h2 class="ct-page__title">People on this case</h2>
            @if (view.Chrome.ResolvedLinksLocked)
            {
                <p class="cw-linked-lock" style="margin-bottom:12px">🔒 People and linked records are locked — this process is complete (issued, rejected, or cancelled).</p>
            }
            <div class="os-toolbar cw-people-toolbar" style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <button type="button" class="os-btn os-btn--primary" disabled="@(!CanLinkPerson || ShowPersonLinkPicker || ShowPersonLinkReview || IsRelinking)" @onclick="LinkPersonAsync">Link existing…</button>
                <span class="cw-people-toolbar__reports" role="group" aria-label="Preview reports">
                    <div class="cw-people-action-menu">
                        <button type="button"
                                id="cw-people-doc-menu-btn"
                                class="os-btn cw-people-toolbar__report @(_peopleDocMenuOpen ? "is-open" : null) @(_peopleDocMenuLoading ? "is-busy" : null)"
                                disabled="@(!anyPeopleSelected)"
                                aria-haspopup="menu"
                                aria-expanded="@_peopleDocMenuOpen"
                                title="Preview document copies for checked rows"
                                @onclick="TogglePeopleDocumentCopiesMenuAsync">
                            @if (_peopleDocMenuLoading)
                            {
                                <span class="cw-summary-spin" aria-hidden="true"></span>
                            }
                            📄 Preview document copies ▾
                        </button>
                        @if (_peopleDocMenuOpen)
                        {
                            <div id="cw-people-doc-menu-panel" class="cw-people-action-menu__panel" role="menu">
                                @if (_peopleDocMenuLoading)
                                {
                                    <div class="cw-people-action-menu__loading" role="status" aria-live="polite">
                                        <span class="cw-summary-spin" aria-hidden="true"></span>
                                        <span>Loading document sections…</span>
                                    </div>
                                }
                                else if (_peopleDocMenuItems.Count == 0)
                                {
                                    <div class="cw-people-action-menu__empty">No required document sections for this profile</div>
                                }
                                else
                                {
                                    @foreach (var item in _peopleDocMenuItems)
                                    {
                                        var menuItem = item;
                                        <button type="button"
                                                class="cw-people-action-menu__item"
                                                role="menuitem"
                                                @onclick="() => PreviewDocumentSectionAsync(menuItem)">
                                            <span class="cw-people-action-menu__glyph" aria-hidden="true">📄</span>
                                            <span class="cw-people-action-menu__label">@menuItem.Label</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="cw-people-action-menu">
                        <button type="button"
                                id="cw-people-resmi-menu-btn"
                                class="os-btn cw-people-toolbar__report @(_peopleResmiMenuOpen ? "is-open" : null) @(_peopleResmiMenuLoading ? "is-busy" : null)"
                                disabled="@(!anyPeopleSelected)"
                                aria-haspopup="menu"
                                aria-expanded="@_peopleResmiMenuOpen"
                                title="Preview Resminamalar for checked rows"
                                @onclick="TogglePeopleResminamalarMenuAsync">
                            @if (_peopleResmiMenuLoading)
                            {
                                <span class="cw-summary-spin" aria-hidden="true"></span>
                            }
                            📦 Preview Resminamalar ▾
                        </button>
                        @if (_peopleResmiMenuOpen)
                        {
                            <div id="cw-people-resmi-menu-panel" class="cw-people-action-menu__panel" role="menu">
                                @if (_peopleResmiMenuLoading)
                                {
                                    <div class="cw-people-action-menu__loading" role="status" aria-live="polite">
                                        <span class="cw-summary-spin" aria-hidden="true"></span>
                                        <span>Loading Resminamalar…</span>
                                    </div>
                                }
                                else if (_peopleResmiMenuItems.Count == 0)
                                {
                                    <div class="cw-people-action-menu__empty">No Resminamalar templates</div>
                                }
                                else
                                {
                                    @foreach (var item in _peopleResmiMenuItems)
                                    {
                                        var menuItem = item;
                                        <button type="button"
                                                class="cw-people-action-menu__item"
                                                role="menuitem"
                                                @onclick="() => PreviewResminamalarEntryAsync(menuItem)">
                                            <span class="cw-people-action-menu__glyph" aria-hidden="true">📗</span>
                                            <span class="cw-people-action-menu__label">@menuItem.Label</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </span>
                <span class="cw-people-toolbar__hint">Checked rows only</span>
            </div>
            <OfficerShellPersonLinkPickerComponent IsOpen="@ShowPersonLinkPicker"
                                                   Candidates="@PersonLinkCandidates"
                                                   IsSearching="@PersonLinkIsSearching"
                                                   IsLinking="@PersonLinkIsLinking"
                                                   StatusMessage="@PersonLinkStatusMessage"
                                                   IsStatusError="@PersonLinkStatusIsError"
                                                   SearchRequested="@PersonLinkSearchRequested"
                                                   LinkRequested="@LinkPersonFromPickerRequested"
                                                   CloseRequested="@ClosePersonLinkPickerRequested" />
            <DxWindow Visible="@ShowPersonLinkReview"
                      VisibleChanged="OnPersonLinkReviewVisibleChanged"
                      HeaderText="@Msg("ApplicationProfileInstance.Workspace.LinkedRecords")"
                      ShowFooter="@(_reviewTab == "overview" && !_reviewCreating)"
                      ShowCloseButton="true"
                      CloseOnEscape="true"
                      AllowDrag="true"
                      AllowDragByHeaderOnly="true"
                      PositionX="@LinkReviewPositionX"
                      PositionY="@LinkReviewPositionY"
                      DragCompleted="OnLinkReviewDragCompleted"
                      Width="@LinkReviewPopupWidth"
                      CssClass="@LinkReviewPopupCssClass">
                <BodyContentTemplate>
                    <div class="os-link-review-person">
                        @if (!string.IsNullOrEmpty(PersonLinkReviewPhotoDataUri))
                        {
                            <img class="os-link-review-person__photo" src="@PersonLinkReviewPhotoDataUri" alt="@PersonLinkReviewPersonName" />
                        }
                        else
                        {
                            <div class="os-link-review-person__photo-empty" aria-hidden="true"></div>
                        }
                        <span class="os-link-review-person__name">@(string.IsNullOrWhiteSpace(PersonLinkReviewPersonName) ? "—" : PersonLinkReviewPersonName)</span>
                        <button type="button"
                                class="os-link-review__gear @(_reviewGearOn ? "is-on" : null)"
                                title="@Msg("ApplicationProfileInstance.LinkReview.ChooseAnother")"
                                aria-pressed="@_reviewGearOn"
                                @onclick="ToggleReviewGear">⚙</button>
                    </div>
                    @if (_reviewGearOn)
                    {
                        <div class="os-link-review-tabs" role="tablist">
                            <button type="button"
                                    class="os-link-review-tabs__tab @(_reviewTab == "overview" ? "is-active" : null)"
                                    role="tab"
                                    aria-selected="@(_reviewTab == "overview")"
                                    @onclick='() => SelectReviewTab("overview")'>@Msg("ApplicationProfileInstance.Workspace.Overview")</button>
                            @foreach (var tab in PersonLinkReviewLines)
                            {
                                var tabKey = tab.ResolveTabKey();
                                <button type="button"
                                        class="os-link-review-tabs__tab @(_reviewTab == tabKey ? "is-active" : null)"
                                        role="tab"
                                        aria-selected="@(_reviewTab == tabKey)"
                                        @onclick="() => SelectReviewTab(tabKey)">@ApplicationProfileLocalization.LinkedRecordLabel(tab.Label)@(tab.SlotCount > 1 ? $" ({tab.SlotIndex}/{tab.SlotCount})" : null)</button>
                            }
                        </div>
                    }
                    @if (_reviewTab == "overview")
                    {
                        <div class="os-link-review" role="tabpanel" aria-label="@Msg("ApplicationProfileInstance.Workspace.Overview")">
                            
                            @if (PersonLinkReviewLines.Any(IsRequestedLocationReviewLine))
                            {
                                <div class="os-loc-chips-legend" aria-label="@Msg("ApplicationProfileInstance.LinkReview.LocationChipLegend")">
                                    <span class="os-loc-chips-legend__item"><span class="os-loc-chips-legend__swatch is-joined"></span>@Msg("ApplicationProfileInstance.LinkReview.LocationSource.Joined")</span>
                                    <span class="os-loc-chips-legend__item"><span class="os-loc-chips-legend__swatch is-case"></span>@Msg("ApplicationProfileInstance.LinkReview.LocationSource.Case")</span>
                                    <span class="os-loc-chips-legend__item"><span class="os-loc-chips-legend__swatch is-visa"></span>@Msg("ApplicationProfileInstance.LinkReview.LocationSource.Visa")</span>
                                    <span class="os-loc-chips-legend__item"><span class="os-loc-chips-legend__swatch is-wp"></span>@Msg("ApplicationProfileInstance.LinkReview.LocationSource.WorkPermitItem")</span>
                                    <span class="os-loc-chips-legend__item"><span class="os-loc-chips-legend__swatch is-manual"></span>@Msg("ApplicationProfileInstance.LinkReview.LocationSource.Manual")</span>
                                </div>
                            }@foreach (var line in PersonLinkReviewLines)
                            {
                                <div class="os-link-review__row">
                                    <span class="os-link-review__label">
                                        @ApplicationProfileLocalization.LinkedRecordLabel(line.Label)
                                        @if (line.SlotCount > 1)
                                        {
                                            <span class="os-link-review__slot">@($"{line.SlotIndex} of {line.SlotCount}")</span>
                                        }
                                    </span>
                                    @if (line.SupportsDocumentCopy)
                                    {
                                        <button type="button"
                                                class="os-link-review__eye @(line.HasDocumentCopy ? null : "is-disabled")"
                                                disabled="@(!line.HasDocumentCopy)"
                                                title="@(line.HasDocumentCopy ? Msg("ApplicationProfileInstance.LinkReview.PreviewCopy") : Msg("ApplicationProfileInstance.LinkReview.NoCopy"))"
                                                aria-label="@(line.HasDocumentCopy ? Msg("ApplicationProfileInstance.LinkReview.PreviewCopy") : Msg("ApplicationProfileInstance.LinkReview.NoCopy"))"
                                                @onclick="() => PreviewLinkReviewDocumentAsync(line)">
                                            <svg class="os-link-review__eye-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path fill="currentColor" d="M12 5c-5 0-9.27 3.11-11 7.5C2.73 16.89 7 20 12 20s9.27-3.11 11-7.5C21.27 8.11 17 5 12 5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8a3 3 0 100 6 3 3 0 000-6z"/>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="os-link-review__eye-spacer" aria-hidden="true"></span>
                                    }
                                    @if (IsRequestedLocationReviewLine(line))
                                    {
                                        <div class="os-link-review__value os-link-review__value--chips">
                                            <div class="os-loc-chips" role="list">
                                                @foreach (var chip in line.LocationChips.Where(c => !c.Hidden))
                                                {
                                                    <span class="os-loc-chip @LinkReviewLocationChips.SourceCssClass(chip.Source)"
                                                          role="listitem"
                                                          title="@LocationChipSourceTitle(chip.Source)">
                                                        <span class="os-loc-chip__text">@chip.Value</span>
                                                        <button type="button"
                                                                class="os-loc-chip__remove"
                                                                title="@Msg("ApplicationProfileInstance.LinkReview.RemoveLocationChip")"
                                                                @onclick="() => HideLocationChip(line, chip)">×</button>
                                                    </span>
                                                }
                                                @if (!line.LocationChips.Any(c => !c.Hidden))
                                                {
                                                    <span class="os-link-review__value">—</span>
                                                }
                                            </div>
                                            @if (_reviewGearOn)
                                            {
                                                <div class="os-link-review__value--multiselect os-loc-chips__add">
                                                    <BorderZoneLocationField @key="_locationChipAddNonce"
                                                                             Value="@null"
                                                                             EditorAlias="@(IsWorkPermitLocationReviewLine(line) ? CommaSeparatedMultiSelectEditorAliases.WorkPermittedLocation : CommaSeparatedMultiSelectEditorAliases.BorderZone)"
                                                                             ReadOnly="false"
                                                                             ValueChanged="value => AddManualLocationChips(line, value)" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (_reviewGearOn && line.Choices.Count > 0)
                                    {
                                        <select class="os-link-review__select"
                                                value="@line.ObjectId"
                                                @onchange="e => OnReviewChoiceChanged(line, e)">
                                            @foreach (var choice in line.Choices)
                                            {
                                                <option value="@choice.ObjectId">@choice.Label</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="os-link-review__value">@line.Summary</span>
                                    }
                                    @if (_reviewGearOn && !line.OmitFromJoin)
                                    {
                                        <span class="os-link-review__icons">
                                            <button type="button"
                                                    class="cw-addr-icon cw-addr-icon--plus"
                                                    title="@Msg("ApplicationProfileInstance.Issued.AddPerson")"
                                                    @onclick="() => StartCreateAsync(line)">+</button>
                                            @if (line.ObjectId != Guid.Empty || line.Kind == ApplicationProfileInstancePersonLinkKind.AddressOfResidence)
                                            {
                                                <button type="button"
                                                        class="cw-addr-icon cw-addr-icon--pen"
                                                        title="@Msg("ApplicationProfileInstance.LinkReview.Edit")"
                                                        @onclick="() => StartEditAsync(line)">✎</button>
                                            }
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_reviewCreating && PersonLinkReviewCreateForm is { } draft && draft.Kind.ToString() == _reviewTab)
                    {
                        <div class="os-link-review-form" role="tabpanel" aria-label="@draft.Title">
                            <h3 class="os-link-review-form__title">@draft.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(draft.Error))
                            {
                                <div class="os-banner os-banner--warn">@draft.Error</div>
                            }
                            @foreach (var field in draft.Fields.Where(item => IsCreateFieldShown(draft, item)))
                            {
                                <div class="os-link-review-form__row">
                                    <span class="os-link-review-form__label">
                                        @field.Label
                                        @if (field.Required)
                                        {
                                            <span class="os-link-review-form__req" aria-hidden="true">*</span>
                                        }
                                    </span>
                                    @if (field.Editor == "lookup")
                                    {
                                        <select class="os-link-review__select"
                                                value="@field.Value"
                                                @onchange="e => OnCreateFieldChanged(draft, field, e)">
                                            <option value=""></option>
                                            @foreach (var option in CreateOptions(draft, field))
                                            {
                                                <option value="@option.Id">@option.Label</option>
                                            }
                                        </select>
                                    }
                                    else if (field.Editor == "date")
                                    {
                                        <OfficerDateEdit Date="@CreateFieldDate(field)"
                                                         DateChanged="value => OnCreateDateChanged(field, value)"
                                                         CssClass="os-link-review-form__date" />
                                    }
                                    else
                                    {
                                        <input class="os-link-review__select"
                                               value="@field.Value"
                                               @onchange="e => OnCreateFieldChanged(draft, field, e)" />
                                    }
                                </div>
                            }
                            <div class="os-link-review__actions">
                                <button type="button" class="os-btn os-btn--primary" disabled="@(_reviewCreateSaving || draft.Fields.Count == 0)" @onclick="SaveCreateAsync">@Msg("ApplicationProfileInstance.Issued.Save")</button>
                                <button type="button" class="os-btn" disabled="@_reviewCreateSaving" @onclick="CancelCreate">@Msg("ApplicationProfileInstance.Issued.Cancel")</button>
                            </div>
                        </div>
                    }
                    else if (ActiveReviewLine is { } active)
                    {
                        <div class="os-link-review-form" role="tabpanel" aria-label="@ApplicationProfileLocalization.LinkedRecordLabel(active.Label)">
                            <h3 class="os-link-review-form__title">@ApplicationProfileLocalization.LinkedRecordLabel(active.Label)</h3>
                            @foreach (var field in active.Fields)
                            {
                                <div class="os-link-review-form__row">
                                    <span class="os-link-review-form__label">
                                        @field.Label
                                        @if (field.Required)
                                        {
                                            <span class="os-link-review-form__req" aria-hidden="true">*</span>
                                        }
                                    </span>
                                    <div class="os-link-review-form__value @(field.Lookup ? "is-lookup" : null)">
                                        <span class="os-link-review-form__text">@field.Value</span>
                                        @if (field.Lookup)
                                        {
                                            <span class="os-link-review-form__tools">
                                                <span class="os-link-review-form__tool" aria-hidden="true">×</span>
                                                <button type="button"
                                                        class="os-link-review-form__tool os-link-review-form__tool--pen"
                                                        title="@Msg("ApplicationProfileInstance.LinkReview.Edit")"
                                                        @onclick="() => StartEditAsync(active)">✎</button>
                                                <span class="os-link-review-form__tool" aria-hidden="true">+</span>
                                                <span class="os-link-review-form__tool" aria-hidden="true">▾</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(PersonLinkStatusMessage))
                    {
                        <div class="os-banner @(PersonLinkStatusIsError ? "os-banner--warn" : "os-banner--ok")">@PersonLinkStatusMessage</div>
                    }
                </BodyContentTemplate>
                <FooterContentTemplate>
                    <div class="os-link-review__actions">
                        <button type="button"
                                class="os-btn os-btn--primary @(PersonLinkIsLinking ? "is-busy" : null)"
                                disabled="@PersonLinkIsLinking"
                                aria-busy="@PersonLinkIsLinking"
                                @onclick="JoinPersonLinkReviewAsync">
                            @if (PersonLinkIsLinking)
                            {
                                <span class="cw-advance-spin" aria-hidden="true"></span>
                            }
                            @(PersonLinkReviewExisting ? Msg("ApplicationProfileInstance.Issued.Save") : Msg("ApplicationProfileInstance.LinkReview.Join"))
                        </button>
                        <button type="button" class="os-btn" disabled="@PersonLinkIsLinking" @onclick="CancelPersonLinkReviewAsync">@Msg("ApplicationProfileInstance.Issued.Cancel")</button>
                    </div>
                </FooterContentTemplate>
            </DxWindow>
            @if (view.People.Count == 0)
            {
                <p class="os-empty">No people linked.</p>
            }
            else
            {
                var peopleLinkColumns = view.People.FirstOrDefault()?.Records
                    ?? Array.Empty<ApplicationWorkspaceCasePersonRecord>();
                <div class="os-panel" style="margin-bottom:16px">
                    <table class="os-table os-table--people-links">
                        <thead>
                            <tr>
                                <th class="os-people-check-col">
                                    <input type="checkbox"
                                           checked="@allPeopleSelected"
                                           disabled="@(selectablePeople.Count == 0)"
                                           title="Select all"
                                           aria-label="Select all people"
                                           @onchange="OnSelectAllPeopleChanged" />
                                </th>
                                <th>Person</th>
                                <th>Role</th>
                                @foreach (var col in peopleLinkColumns)
                                {
                                    <th>@ApplicationProfileLocalization.LinkedRecordLabel(col.Label)</th>
                                }
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var person in view.People)
                            {
                                var personSelected = IsDocumentPersonSelected(person.PersonId);
                                <tr class="os-person-row @(person.Index == SelectedPersonRowIndex ? "is-selected" : null) @(person.IsExcluded ? "is-excluded" : null)"
                                    @onclick="() => OpenPersonReviewFromRowAsync(person)">
                                    <td class="os-people-check-col" @onclick:stopPropagation="true">
                                        @if (!person.IsExcluded && person.PersonId != Guid.Empty)
                                        {
                                            <input type="checkbox"
                                                   checked="@personSelected"
                                                   title="Include in preview"
                                                   aria-label="@($"Select {person.Name}")"
                                                   @onchange="e => OnPersonRowCheckedChanged(person.PersonId, e)" />
                                        }
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="ct-link"
                                                disabled="@(person.PersonId == Guid.Empty || !CanLinkPerson)"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenExistingPersonLinkReviewAsync(person.PersonId)">@person.Name</button>
                                        @if (person.IsExcluded)
                                        {
                                            <span class="cw-excluded-badge" title="@ExcludedTitle(person)">@ApplicationListLinkedPeople.FormatExcludedBadge(person.ExcludedLetterNumber, person.ExcludedLetterDate)</span>
                                        }
                                    </td>
                                    <td>@person.RoleLabel</td>
                                    @foreach (var col in peopleLinkColumns)
                                    {
                                        var record = person.Records.FirstOrDefault(r =>
                                            string.Equals(r.Key, col.Key, StringComparison.OrdinalIgnoreCase));
                                        var missing = record != null
                                            && ApplicationWorkspacePeopleLinksCompleteness.IsRecordShort(record, view.Chrome.ResolvedLinksLocked);
                                        <td>
                                            <div class="os-people-doc-cell">
                                                <span class="os-people-doc @(missing ? "cw-cell-missing" : null)">@FormatPeopleLinkCell(person, record)</span>
                                                @if (TryGetPeopleDocUploadTarget(person, record, out var uploadKind, out var uploadSourceId))
                                                {
                                                    var kind = uploadKind;
                                                    var sourceId = uploadSourceId;
                                                    var missingScans = !PeopleDocHasScans(kind, sourceId);
                                                    <button type="button"
                                                            class="ct-link os-people-doc-nusga"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => OpenPeopleDocNusgaAsync(person, kind, sourceId, record)">
                                                        @Msg("PersonDocumentCopies.People.Nusga")
                                                    </button>
                                                    @if (missingScans)
                                                    {
                                                        <button type="button"
                                                                class="os-people-doc-missing"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => OpenPeopleDocNusgaAsync(person, kind, sourceId, record)">
                                                            <span class="os-people-doc-missing__icon" aria-hidden="true">⚠</span>
                                                            <span>@Msg("PersonDocumentCopies.People.NoFile")</span>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    }
                                    <td>
                                        <button type="button"
                                                class="os-btn os-btn--primary ct-btn-sm"
                                                disabled="@(!CanLinkPerson || person.PersonId == Guid.Empty || IsRelinking)"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => RelinkPersonById(person.PersonId)">
                                            @(person.PersonId == _relinkingPersonId ? "Relinking…" : "Relink")
                                        </button>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="os-btn ct-btn-sm"
                                                disabled="@(!CanUnlinkPerson || person.PersonId == Guid.Empty || IsRelinking || person.IsExcluded)"
                                                title="@(person.IsExcluded ? VisaUiMessages.Get("ApplicationProfileInstance.People.ExcludedStayOnRoster") : null)"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => UnlinkPersonById(person.PersonId)">Unlink</button>
                                    </td>
                                    <td>
                                        <button type="button" class="os-btn os-btn--ghost ct-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenPersonByIndex(person.Index)">Open person detail</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>;
    };

    private RenderFragment RenderSla(ApplicationWorkspaceCaseView view) => __builder =>
    {
        var sla = view.Sla;
        var complete = sla.IsTerminal;
        var caseRemaining = sla.CaseDaysRemaining;
        var stepRemaining = sla.CurrentStepDaysRemaining;
        var casePct = complete ? 100 : SlaRemainingPercent(caseRemaining, sla.TotalSlaDays);
        var stepPct = complete ? 100 : SlaRemainingPercent(stepRemaining, Math.Max(stepRemaining ?? 0, 14));
        var stepTitle = string.IsNullOrWhiteSpace(sla.CurrentStepLabel) || sla.CurrentStepLabel == "Current step"
            ? Msg("ApplicationProfileInstance.Workspace.CurrentStep")
            : ApplicationProfileLocalization.ProgressStepLabel(sla.CurrentStepLabel);
        var stepDue = SlaDisplayDate(sla.CurrentStepDueDate);
        var started = SlaDisplayDate(sla.StartedOn);
        var ministryDue = SlaDisplayDate(sla.MinistryDueDate);
        var expected = SlaDisplayDate(sla.ExpectedCompletionDate);
        var slaSource = string.IsNullOrWhiteSpace(sla.ProfileSlaSource) || sla.ProfileSlaSource == "Profile template"
            ? Msg("ApplicationProfileInstance.Workspace.ProfileTemplate")
            : sla.ProfileSlaSource;
        var caseStatusClass = complete ? "ct-sla-tone ct-sla-tone--ok" : SlaToneClass(caseRemaining);
        var stepStatusClass = complete ? "ct-sla-tone ct-sla-tone--ok" : SlaToneClass(stepRemaining);
        var caseRingClass = complete ? "ct-sla-ring--ok ct-sla-ring--done" : SlaRingTone(caseRemaining);
        var stepRingClass = complete ? "ct-sla-ring--ok ct-sla-ring--done" : SlaRingTone(stepRemaining);
        var caseValue = complete ? Msg("ApplicationProfileInstance.Workspace.Done") : (caseRemaining?.ToString() ?? "—");
        var stepValue = complete ? Msg("ApplicationProfileInstance.Workspace.Done") : (stepRemaining?.ToString() ?? "—");
        var caption = complete ? Msg("ApplicationProfileInstance.Workspace.Complete") : Msg("ApplicationProfileInstance.Workspace.DaysLeft");
        var caseLabel = complete ? sla.CaseStatus : SlaToneLabel(caseRemaining);
        var stepStatusText = complete ? sla.CaseStatus : SlaToneLabel(stepRemaining);
        var stepHint = complete
            ? Msg("ApplicationProfileInstance.Workspace.NoOpenDeadline")
            : (stepDue == "—"
                ? Msg("ApplicationProfileInstance.Workspace.NoDueDate")
                : VisaUiMessages.Format("ApplicationProfileInstance.Workspace.DueOn", stepDue));
        var midTitle = complete ? Msg("ApplicationProfileInstance.Workspace.Completed") : Msg("ApplicationProfileInstance.Workspace.CurrentDue");
        var midDate = complete ? expected : ministryDue;
        var endTitle = complete ? Msg("ApplicationProfileInstance.Workspace.Finished") : Msg("ApplicationProfileInstance.Workspace.ExpectedCompletion");
        var showAlert = !complete && stepRemaining is int && stepRemaining <= 10 && stepDue != "—";
        <div class="ct-page ct-sla">
            <header class="ct-sla-head">
                <h2 class="ct-page__title">@Msg("ApplicationProfileInstance.Workspace.Sla")</h2>
                <p class="ct-page__sub">@Msg("ApplicationProfileInstance.Workspace.SlaSub")</p>
            </header>
            <div class="ct-sla-metrics">
                <article class="ct-sla-metric">
                    <h3>@Msg("ApplicationProfileInstance.Workspace.OverallCase")</h3>
                    <div class="ct-sla-metric__body">
                        <div class="ct-sla-gauge">
                            <div class="ct-sla-ring ct-sla-ring--lg @caseRingClass" style="--ct-pct:@casePct%" role="img" aria-label="@caseLabel">
                                <strong>@caseValue</strong>
                            </div>
                            <span class="ct-sla-gauge__caption">@caption</span>
                        </div>
                        <dl class="ct-sla-stats">
                            <div><dt>@Msg("ApplicationProfileInstance.Workspace.TotalSla")</dt><dd>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.DaysCount", sla.TotalSlaDays)</dd></div>
                            <div><dt>@Msg("ApplicationProfileInstance.Workspace.Elapsed")</dt><dd>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.DaysCount", sla.ElapsedDays)</dd></div>
                            <div><dt>@Msg("ApplicationProfileInstance.Workspace.Status")</dt><dd class="@caseStatusClass">@caseLabel</dd></div>
                        </dl>
                    </div>
                </article>
                <article class="ct-sla-metric">
                    <h3>@stepTitle</h3>
                    <p class="ct-sla-metric__hint">@stepHint</p>
                    <div class="ct-sla-metric__body">
                        <div class="ct-sla-gauge">
                            <div class="ct-sla-ring @stepRingClass" style="--ct-pct:@stepPct%" role="img" aria-label="@stepStatusText">
                                <strong>@stepValue</strong>
                            </div>
                            <span class="ct-sla-gauge__caption">@caption</span>
                        </div>
                        <dl class="ct-sla-stats">
                            <div><dt>@Msg("ApplicationProfileInstance.Workspace.Status")</dt><dd class="@stepStatusClass">@stepStatusText</dd></div>
                        </dl>
                    </div>
                </article>
                <article class="ct-sla-metric">
                    <h3>@Msg("ApplicationProfileInstance.Workspace.ProfileSla")</h3>
                    <p class="ct-sla-metric__hint">@Msg("ApplicationProfileInstance.Workspace.ConfiguredOnTemplate")</p>
                    <div class="ct-sla-metric__body ct-sla-metric__body--stack">
                        <p class="ct-sla-metric__big">@sla.TotalSlaDays <span>@Msg("ApplicationProfileInstance.Workspace.DaysUnit")</span></p>
                        <p class="ct-muted">@slaSource</p>
                    </div>
                </article>
            </div>
            <div class="ct-sla-timeline" aria-label="@Msg("ApplicationProfileInstance.Workspace.CaseTimeline")">
                <div class="ct-sla-timeline__node">
                    <span class="ct-sla-timeline__dot" aria-hidden="true"></span>
                    <strong>@Msg("ApplicationProfileInstance.Workspace.StartedLabel")</strong>
                    <span>@started</span>
                </div>
                <div class="ct-sla-timeline__node">
                    <span class="ct-sla-timeline__dot @(complete ? "ct-sla-timeline__dot--muted" : null)" aria-hidden="true"></span>
                    <strong>@midTitle</strong>
                    <span>@midDate</span>
                </div>
                <div class="ct-sla-timeline__node">
                    <span class="ct-sla-timeline__dot ct-sla-timeline__dot--muted" aria-hidden="true"></span>
                    <strong>@endTitle</strong>
                    <span>@expected</span>
                </div>
            </div>
            <div class="ct-sla-lower">
                <div class="ct-sla-table-wrap">
                    <h3>@Msg("ApplicationProfileInstance.Workspace.SlaByStep")</h3>
                    <table class="os-table">
                        <thead><tr><th>@Msg("ApplicationProfileInstance.Workspace.Step")</th><th>@Msg("ApplicationProfileInstance.Workspace.DueDate")</th><th>@Msg("ApplicationProfileInstance.Workspace.DaysLeftCol")</th><th>@Msg("ApplicationProfileInstance.Workspace.Status")</th></tr></thead>
                        <tbody>
                            @foreach (var row in sla.Deadlines)
                            {
                                <tr class="@(row.IsCurrent ? "ct-sla-row--current" : null)">
                                    <td>@if (row.IsCurrent) { <strong>@ApplicationProfileLocalization.ProgressStepLabel(row.Step)</strong> } else { @ApplicationProfileLocalization.ProgressStepLabel(row.Step) }</td>
                                    <td>@SlaDisplayDate(row.DueDate)</td>
                                    <td class="@(row.Status is "inprogress" or "overdue" ? (row.Status == "overdue" ? "ct-sla-days--due" : "ct-sla-days--ok") : null)">@SlaDisplayDate(row.DaysLeft)</td>
                                    <td><span class="os-status os-status--@SlaStatusClass(row.Status)">@SlaStatusLabel(row.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="ct-sla-aside">
                    @if (showAlert)
                    {
                        <div class="ct-sla-alert" role="status">
                            <div>
                                <strong>@Msg("ApplicationProfileInstance.Workspace.DeadlineApproaching")</strong>
                                <p>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.SlaAlert", stepTitle, stepRemaining, stepDue)</p>
                            </div>
                        </div>
                    }
                    <div class="ct-sla-source">
                        <h4>@Msg("ApplicationProfileInstance.Workspace.SlaSource")</h4>
                        <p>@slaSource</p>
                        <p class="ct-muted">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.MigrationSlaDays", sla.TotalSlaDays)</p>
                    </div>
                </div>
            </div>
        </div>;
    };

