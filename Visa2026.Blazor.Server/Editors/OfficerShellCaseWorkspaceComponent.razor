    private async Task UseCaseAddressAsync(Guid personId, Guid addressId)
    {
        _addressActionError = null;
        if (Snapshot == null || personId == Guid.Empty || addressId == Guid.Empty)
            return;

        using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>();
        if (!InvitationStayAddressCopy.TryRelinkFromStay(
                objectSpace,
                Snapshot.ApplicationProfileInstanceId,
                personId,
                addressId,
                out var error))
        {
            _addressActionError = error;
            return;
        }

        try
        {
            if (objectSpace.IsModified)
                objectSpace.CommitChanges();
        }
        catch (Exception ex)
        {
            _addressActionError = ex.Message;
            return;
        }

        if (_addressEditorId == addressId)
            _addressEditorId = Guid.Empty;
        WorkspaceActions.NotifyWorkspaceChanged();
        await Task.CompletedTask;
    }
