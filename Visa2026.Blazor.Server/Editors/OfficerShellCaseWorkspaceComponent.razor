@using System.Globalization
@using System.Collections.Generic
@using System.Linq
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using DevExpress.ExpressApp
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.BusinessObjects.OfficerShell
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationItemLinkedDocuments
@using Visa2026.Module.Services
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.ApplicationPersonLink
@using Visa2026.Module.Services.OfficerShell
@using Visa2026.Module.Editors
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.HeaderLinkedDocuments
@using Visa2026.Module.Services.PersonLinkedDocuments
@using Visa2026.Module.Services.WordReports
@using Visa2026.Blazor.Server.Components
@using Visa2026.Blazor.Server.Services
@implements IDisposable
@inject IJSRuntime JS
@inject IVisaPreviewSlotService PreviewSlotService
@inject INonSecuredObjectSpaceFactory ObjectSpaceFactory
@inject IApplicationWorkspacePersonUiActions WorkspaceActions
@inject ApplicationWordReportPackageCatalogService WordReportCatalogService

<div class="officer-case-workspace @(IsLoading || Snapshot == null ? "officer-case-workspace--loading" : null)">
    @if (IsLoading || Snapshot == null)
    {
        var loadingLabel = string.IsNullOrWhiteSpace(LoadingMessage)
            ? Msg("ApplicationProfileInstance.Workspace.Opening")
            : LoadingMessage;
        var indeterminate = LoadingProgressPercent < 0;
        <div class="cw-loading" role="status" aria-live="polite" aria-busy="true">
            <div class="cw-loading__banner">
                <div class="cw-loading__kicker">@Msg("ApplicationProfileInstance.Workspace.CaseWorkspace")</div>
                <div class="cw-loading__label">@loadingLabel</div>
                <div class="cw-loading__track"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@(indeterminate ? null : LoadingProgressPercent)"
                     aria-label="@loadingLabel">
                    <div class="cw-loading__fill @(indeterminate ? "cw-loading__fill--indeterminate" : null)"
                         style="@(indeterminate ? null : $"width:{LoadingProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                </div>
                @if (!indeterminate)
                {
                    <div class="cw-loading__pct">@LoadingProgressPercent%</div>
                }
            </div>
            <div class="cw-loading__chrome" aria-hidden="true">
                <div class="cw-loading__head">
                    <div class="cw-loading__line cw-loading__line--title"></div>
                    <div class="cw-loading__line cw-loading__line--sub"></div>
                    <div class="cw-loading__chips">
                        <span class="cw-loading__chip"></span>
                        <span class="cw-loading__chip"></span>
                        <span class="cw-loading__chip"></span>
                    </div>
                </div>
                <div class="cw-loading__layout">
                    <div class="cw-loading__nav">
                        <div class="cw-loading__nav-item"></div>
                        <div class="cw-loading__nav-item"></div>
                        <div class="cw-loading__nav-item"></div>
                        <div class="cw-loading__nav-item"></div>
                        <div class="cw-loading__nav-item"></div>
                        <div class="cw-loading__nav-item"></div>
                    </div>
                    <div class="cw-loading__tiles">
                        <div class="cw-loading__tile"></div>
                        <div class="cw-loading__tile"></div>
                        <div class="cw-loading__tile"></div>
                        <div class="cw-loading__tile"></div>
                        <div class="cw-loading__tile"></div>
                        <div class="cw-loading__tile"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Snapshot.ApplicationProfileInstanceId == Guid.Empty)
    {
        <div class="cw-loading cw-loading--empty" role="status">
            <div class="cw-loading__banner">
                <div class="cw-loading__kicker">@Msg("ApplicationProfileInstance.Workspace.CaseWorkspace")</div>
                <div class="cw-loading__label">@Msg("ApplicationProfileInstance.Workspace.NoCase")</div>
            </div>
        </div>
    }
    else
    {
        var view = Snapshot.CaseView;
        var chrome = view.Chrome;
        <header class="cw-head">
            <div class="cw-head__top">
                <div class="cw-head__title-block">
                    <div class="cw-head__accent" style="background:@OfficerShellTemplateFamily.GetColor(chrome.TemplateFamilyKey)"></div>
                    <div>
                        @{
                            var profileName = !string.IsNullOrWhiteSpace(chrome.ProfileTemplateName)
                                ? chrome.ProfileTemplateName
                                : Snapshot!.Profile.Title;
                        }
                        <h1>@(string.IsNullOrWhiteSpace(profileName) ? $"№ {chrome.DisplayNumber}" : profileName)</h1>
                        <p class="cw-head__sub">
                            @if (!string.IsNullOrWhiteSpace(profileName) && !string.IsNullOrWhiteSpace(chrome.DisplayNumber))
                            {
                                <text>№ @chrome.DisplayNumber · </text>
                            }
                            @chrome.TemplateFamilyLabel · @VisaUiMessages.Format("ApplicationProfileInstance.Workspace.Started", string.IsNullOrWhiteSpace(chrome.StartedOn) ? "—" : chrome.StartedOn)
                        </p>
                    </div>
                </div>
                <div class="cw-head__badges">
                    @{
                        var processTone = view.ProgressSteps.LastOrDefault(s =>
                            s.OutcomeKind is "issued" or "rejected" or "cancelled")?.OutcomeKind;
                    }
                    @if (chrome.SlaDaysRemaining is int slaDays)
                    {
                        <span class="cw-head-badge cw-head-badge--sla">📅 @VisaUiMessages.Format("ApplicationProfileInstance.Workspace.DaysRemaining", slaDays)</span>
                    }
                    @if (processTone == "issued")
                    {
                        <span class="cw-head-badge cw-head-badge--issued">@Msg("ApplicationProfileInstance.Workspace.Issued")</span>
                    }
                    else if (processTone == "rejected")
                    {
                        <span class="cw-head-badge cw-head-badge--rejected">@Msg("ApplicationProfileInstance.Workspace.Rejected")</span>
                    }
                    else if (processTone == "cancelled")
                    {
                        <span class="cw-head-badge cw-head-badge--cancelled">@Msg("ApplicationProfileInstance.Workspace.Cancelled")</span>
                    }
                    @if (view.Chrome.ResolvedLinksLocked)
                    {
                        <span class="cw-head-badge cw-head-badge--locked" title="@Msg("ApplicationProfileInstance.Workspace.LinksLockedTitle")">🔒 @Msg("ApplicationProfileInstance.Workspace.LinksLocked")</span>
                    }
                    @if (DeleteCaseRequested.HasDelegate)
                    {
                        <button type="button"
                                class="cw-head__delete"
                                title="@Msg("ApplicationProfileInstance.Workspace.DeleteCase")"
                                @onclick="DeleteCaseAsync">@Msg("ApplicationProfileInstance.Workspace.DeleteCase")</button>
                    }
                    <button type="button"
                            class="cw-head__close"
                            aria-label="@Msg("ApplicationProfileInstance.Workspace.CloseAria")"
                            title="@Msg("ApplicationProfileInstance.Workspace.Close")"
                            @onclick="BackToListAsync">×</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(DeleteCaseErrorMessage))
            {
                <p class="cw-head__error" role="alert">@DeleteCaseErrorMessage</p>
            }
            <div class="cw-head__people">
                @if (view.People.Count > 0)
                {
                    @foreach (var person in view.People)
                    {
                        var selected = IsDocumentPersonSelected(person.PersonId);
                        var personName = ApplicationItemDocumentCopiesPersonCatalog.DisplayPersonName(person.Name);
                        if (person.IsExcluded)
                        {
                            <span class="cw-person is-excluded" title="@ExcludedTitle(person)">
                                <span class="cw-person__avatar" style="background:@PersonColor(person.Index)">@Initials(personName)</span>
                                @personName
                            </span>
                            continue;
                        }
                        <button type="button"
                                class="cw-person @(selected ? "is-selected" : "is-muted")"
                                aria-pressed="@selected"
                                title="@(selected
                                    ? Msg("ApplicationProfileInstance.Workspace.HidePerson")
                                    : Msg("ApplicationProfileInstance.Workspace.ShowPerson"))"
                                @onclick="() => ToggleDocumentPersonFilter(person.PersonId)">
                            <span class="cw-person__avatar" style="background:@PersonColor(person.Index)">@Initials(personName)</span>
                            @personName
                        </button>
                    }
                }
                else
                {
                    @foreach (var (name, index) in chrome.PeopleNames.Select((n, i) => (n, i)))
                    {
                        <span class="cw-person">
                            <span class="cw-person__avatar" style="background:@PersonColor(index)">@Initials(name)</span>
                            @name
                        </span>
                    }
                }
                @if (chrome.MergedFromCount is int merged && merged > 1)
                {
                    <span class="cw-merge">⊞ @VisaUiMessages.Format("ApplicationProfileInstance.Workspace.MergedFrom", merged)</span>
                }
            </div>
        </header>

        <div class="cw-layout @(IsWideTab(DisplayedTab) ? "cw-layout--wide" : null) @(HidesCaseRail(DisplayedTab) ? "cw-layout--no-rail" : null)">
            <nav class="cw-nav" aria-label="@Msg("ApplicationProfileInstance.Workspace.SectionsAria")">
                @{
                    var peopleNav = ApplicationWorkspacePeopleLinksCompleteness.Resolve(view);
                    var peopleGaps = ApplicationWorkspacePeopleLinksCompleteness.PeopleWithGaps(view);
                    var overviewNav = ApplicationWorkspaceCaseSummaryCompletenessGate.ResolveOverviewNav(view);
                    var overviewMissing = ApplicationWorkspaceCaseSummaryCompletenessGate.MissingRequiredCount(view);
                    var documentsNav = _documentCopiesNav;
                    var documentsMissing = _documentCopiesMissing;
                    var documentsNavReady = _documentCopiesNavReady;
                    var progressLetterMissing = ApplicationWorkspaceProgressLetterCompleteness.MissingCount(view);
                    var resultTotals = ApplicationWorkspaceIssuedResultOverview.Sum(view.IssuedRecordTiles);
                }
                @foreach (var tab in CaseTabs)
                {
                    <button type="button"
                            class="cw-nav__item @(DisplayedTab == tab.Key ? "is-active" : null)"
                            disabled="@_tabSwitching"
                            title="@TabBlockedTitle(tab.Key)"
                            @onclick="() => SelectTab(tab.Key)">
                        <span aria-hidden="true">@tab.Glyph</span>
                        <span>@tab.Label</span>
                        @if (tab.Key == "overview")
                        {
                            @if (overviewNav == ApplicationWorkspaceCaseSummaryCompletenessGate.OverviewNavStatus.Incomplete)
                            {
                                <span class="cw-nav__badge cw-nav__badge--missing"
                                      title="@(overviewMissing == 1 ? "1 required Case summary field is empty" : overviewMissing + " required Case summary fields are empty")"
                                      aria-label="@(overviewMissing == 1 ? "1 required Case summary field is empty" : overviewMissing + " required Case summary fields are empty")">@overviewMissing</span>
                            }
                            else
                            {
                                <span class="cw-nav__badge cw-nav__badge--ok"
                                      title="@Msg("ApplicationProfileInstance.Workspace.CompleteCaseSummary")"
                                      aria-label="@Msg("ApplicationProfileInstance.Workspace.CompleteCaseSummary")">✓</span>
                            }
                        }
                        else if (tab.Key == "people")
                        {
                            @switch (peopleNav)
                            {
                                case ApplicationWorkspacePeopleLinksCompleteness.NavStatus.EmptyRoster:
                                    <span class="cw-nav__badge cw-nav__badge--missing"
                                          title="@Msg("ApplicationProfileInstance.Workspace.NoPeople")"
                                          aria-label="@Msg("ApplicationProfileInstance.Workspace.NoPeople")"></span>
                                    break;
                                case ApplicationWorkspacePeopleLinksCompleteness.NavStatus.Incomplete:
                                    <span class="cw-nav__badge cw-nav__badge--missing"
                                          title="@(peopleGaps == 1 ? "1 person missing required linked records" : peopleGaps + " people missing required linked records")"
                                          aria-label="@(peopleGaps == 1 ? "1 person missing required linked records" : peopleGaps + " people missing required linked records")">@peopleGaps</span>
                                    break;
                                default:
                                    <span class="cw-nav__badge cw-nav__badge--ok"
                                          title="@Msg("ApplicationProfileInstance.Workspace.CompletePeople")"
                                          aria-label="@Msg("ApplicationProfileInstance.Workspace.CompletePeople")">✓</span>
                                    break;
                            }
                        }
                        else if (tab.Key == "result" && view.IssuedRecordTiles.Count > 0)
                        {
                            @if (resultTotals.Missing > 0)
                            {
                                <span class="cw-nav__badge cw-nav__badge--missing"
                                      title="@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ApplicationResultIssuedMissing", resultTotals.Issued, resultTotals.Missing)"
                                      aria-label="@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ApplicationResultIssuedMissing", resultTotals.Issued, resultTotals.Missing)">@resultTotals.Missing</span>
                            }
                            else
                            {
                                <span class="cw-nav__badge cw-nav__badge--ok"
                                      title="@Msg("ApplicationProfileInstance.Workspace.CompleteApplicationResult")"
                                      aria-label="@Msg("ApplicationProfileInstance.Workspace.CompleteApplicationResult")">✓</span>
                            }
                        }
                        else if (tab.Key == "progress" && progressLetterMissing > 0)
                        {
                            <span class="cw-nav__badge cw-nav__badge--warn"
                                  title="@(progressLetterMissing == 1 ? "1 approval letter is missing" : progressLetterMissing + " approval letters are missing")"
                                  aria-label="@(progressLetterMissing == 1 ? "1 approval letter is missing" : progressLetterMissing + " approval letters are missing")">@progressLetterMissing</span>
                        }
                        else if (tab.Key == "seretmezlik" && view.ExcludedPeopleCount > 0)
                        {
                            <span class="cw-nav__badge cw-nav__badge--excluded"
                                  title="@(view.ExcludedPeopleCount == 1 ? "1 person excluded" : view.ExcludedPeopleCount + " people excluded")"
                                  aria-label="@(view.ExcludedPeopleCount == 1 ? "1 person excluded" : view.ExcludedPeopleCount + " people excluded")">@view.ExcludedPeopleCount</span>
                        }
                        else if (tab.Key == "documents" && documentsNavReady)
                        {
                            @switch (documentsNav)
                            {
                                case ApplicationWorkspaceDocumentCopiesCompleteness.NavStatus.EmptyRoster:
                                    <span class="cw-nav__badge cw-nav__badge--warn"
                                          title="@Msg("ApplicationProfileInstance.Workspace.NoPeople")"
                                          aria-label="@Msg("ApplicationProfileInstance.Workspace.NoPeople")"></span>
                                    break;
                                case ApplicationWorkspaceDocumentCopiesCompleteness.NavStatus.Incomplete:
                                    <span class="cw-nav__badge cw-nav__badge--warn"
                                          title="@(documentsMissing == 1 ? "1 required document copy is missing" : documentsMissing + " required document copies are missing")"
                                          aria-label="@(documentsMissing == 1 ? "1 required document copy is missing" : documentsMissing + " required document copies are missing")">@documentsMissing</span>
                                    break;
                                default:
                                    <span class="cw-nav__badge cw-nav__badge--ok"
                                          title="@Msg("ApplicationProfileInstance.Workspace.CompleteDocuments")"
                                          aria-label="@Msg("ApplicationProfileInstance.Workspace.CompleteDocuments")">✓</span>
                                    break;
                            }
                        }
                    </button>
                }
            </nav>

            <div class="cw-main @(IsWideTab(DisplayedTab) ? "cw-main--full" : null) @(_tabSwitching ? "cw-main--switching" : null)">
                @if (_tabSwitching)
                {
                    <div class="cw-tab-loading" role="status" aria-live="polite" aria-busy="true">
                        <div class="cw-tab-loading__panel">
                            <div class="cw-tab-loading__label">@TabSwitchStatus</div>
                            <div class="cw-tab-loading__track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-label="@TabSwitchStatus">
                                <div class="cw-tab-loading__fill cw-tab-loading__fill--indeterminate"></div>
                            </div>
                        </div>
                    </div>
                }
                @if (_tabContentReady)
                {
                    @switch (ActiveTab)
                    {
                        case "overview":
                        case "people":
                        case "result":
                        case "progress":
                            @RenderHybrid(view)
                            break;
                        case "documents":
                            <OfficerShellCaseDocumentsTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                         Snapshot="Snapshot"
                                                         SelectedPersonIds="SelectedDocumentPersonIds"
                                                         PreviewSlotOwnerViewId="@PreviewSlotOwnerViewId"
                                                         CatalogReloaded="OnDocumentCopiesCatalogReloaded" />
                            break;
                        case "resminamalar":
                            <OfficerShellCaseResminamalarTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                            Snapshot="Snapshot"
                                                            SelectedPersonIds="SelectedDocumentPersonIds"
                                                            InitialCatalogSettled="OnResminamalarCatalogSettled" />
                            break;
                        case "seretmezlik":
                            <OfficerShellCaseSeretmezlikTab ApplicationProfileInstanceId="Snapshot.ApplicationProfileInstanceId"
                                                           Snapshot="Snapshot"
                                                           PreviewSlotOwnerViewId="@PreviewSlotOwnerViewId" />
                            break;
                        case "sla":
                            @RenderSla(view)
                            break;
                        case "organization":
                            @RenderOrganization(view)
                            break;
                    }
                }
            </div>

            @if (!IsWideTab(DisplayedTab) && !HidesCaseRail(DisplayedTab))
            {
                <aside class="cw-rail">
                    @RenderRail(view)
                </aside>
            }
        </div>
    }

    <OfficerDeleteConfirmDialog @bind-Visible="_issuedDeleteConfirmVisible"
                                Message="@_issuedDeleteConfirmMessage"
                                Confirmed="ConfirmPendingIssuedDeleteAsync"
                                Cancelled="CancelPendingIssuedDelete" />
</div>

@code {
    private static (string Key, string Label, string Glyph)[] CaseTabs =>
    [
        ("overview", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Overview"), "⌂"),
        ("people", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.PeopleLinks"), "👥"),
        ("progress", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Progress"), "▤"),
        ("result", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ApplicationResult"), "⚑"),
        ("documents", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Documents"), "📄"),
        ("resminamalar", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Resminamalar"), "📦"),
        // Seretmezlik tab removed (slice 15): use standalone Seretmezlik Application Profile Instance.
        ("sla", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Sla"), "⏱"),
        ("organization", VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Organization"), "🏢"),
    ];

    private static readonly string[] PersonColors =
        ["#7c3aed", "#0f9d58", "#ea580c", "#2563eb", "#db2777"];

    private OfficerShellCaseProgressTab? _progressTab;
    private bool _progressUpdating;
    private bool _ignoreAdvanceClick;
    private string? _pendingTab;
    private string? _blockedSectionLabel;
    private bool _keepBlockedSectionLabel;
    private bool _tabSwitching;
    private bool _tabContentReady = true;
    private bool _resminamalarCatalogPending;
    private Guid _relinkingPersonId;
    private string? _documentCopiesCompletenessKey;
    private bool _documentCopiesNavReady;
    private bool _documentCopiesLoadAttempted;
    private ApplicationWorkspaceDocumentCopiesCompleteness.NavStatus _documentCopiesNav =
        ApplicationWorkspaceDocumentCopiesCompleteness.NavStatus.EmptyRoster;
    private int _documentCopiesMissing;

    private string DisplayedTab =>
        string.IsNullOrWhiteSpace(_pendingTab) ? ActiveTab : _pendingTab;

    private string PendingTabLabel
    {
        get
        {
            foreach (var tab in CaseTabs)
            {
                if (string.Equals(tab.Key, DisplayedTab, StringComparison.OrdinalIgnoreCase))
                    return tab.Label;
            }

            return Msg("ApplicationProfileInstance.Workspace.Section");
        }
    }

    private string TabSwitchStatus => VisaUiMessages.Format("ApplicationProfileInstance.Workspace.OpeningTab", PendingTabLabel);

    [Parameter] public ApplicationWorkspaceSnapshot? Snapshot { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string LoadingMessage { get; set; } = string.Empty;
    [Parameter] public int LoadingProgressPercent { get; set; } = -1;
    [Parameter] public string ActiveTab { get; set; } = "overview";
    [Parameter] public int SelectedPersonRowIndex { get; set; } = -1;
    [Parameter] public string? PeopleLinkedRecordFocusKey { get; set; }
    [Parameter] public bool CanLinkPerson { get; set; }
    [Parameter] public bool CanUnlinkPerson { get; set; }
    [Parameter] public bool CanOpenPersonDetail { get; set; }
    [Parameter] public bool CanOpenDocumentCopies { get; set; }
    [Parameter] public EventCallback<string> CaseTabChanged { get; set; }
    [Parameter] public EventCallback<string> LinkedRecordTileClicked { get; set; }
    [Parameter] public EventCallback<string> IssuedHeaderNewRequested { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceIssuedHeaderOpenRequest> IssuedHeaderOpenRequested { get; set; }
    [Parameter] public EventCallback BackToListRequested { get; set; }
    [Parameter] public EventCallback DeleteCaseRequested { get; set; }
    [Parameter] public string? DeleteCaseErrorMessage { get; set; }
    [Parameter] public EventCallback LinkPersonRequested { get; set; }
    [Parameter] public EventCallback<Guid> UnlinkPersonRequested { get; set; }
    [Parameter] public EventCallback OpenPersonDetailRequested { get; set; }
    [Parameter] public EventCallback<int> OpenPersonDetailByIndexRequested { get; set; }
    [Parameter] public EventCallback<Guid> RelinkPersonRequested { get; set; }
    [Parameter] public EventCallback OpenDocumentCopiesRequested { get; set; }
    [Parameter] public EventCallback OpenResminamalarRequested { get; set; }
    [Parameter] public EventCallback<int> SelectPersonRowRequested { get; set; }
    [Parameter] public string? ProgressStatusMessage { get; set; }
    [Parameter] public bool ProgressStatusIsError { get; set; }
    [Parameter] public int ProgressCorrectionRevision { get; set; }
    [Parameter] public EventCallback<string> SaveProgressNotesRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileUpload> UploadMinistryLetterRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressAdvanceRequest> AdvanceProgressRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseMigrationSubmissionRequest> SaveMigrationSubmissionRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressRevertRequest> RevertProgressRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressStepCorrection> SaveStepRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileChange> ChangeFileRequested { get; set; }
    [Parameter] public bool ShowRevertToHere { get; set; }
    [Parameter] public bool ShowPersonLinkPicker { get; set; }
    [Parameter] public IReadOnlyList<ApplicationProfileInstancePersonLinkCandidateRow> PersonLinkCandidates { get; set; } = Array.Empty<ApplicationProfileInstancePersonLinkCandidateRow>();
    [Parameter] public bool PersonLinkIsSearching { get; set; }
    [Parameter] public bool PersonLinkIsLinking { get; set; }
    [Parameter] public string? PersonLinkStatusMessage { get; set; }
    [Parameter] public bool PersonLinkStatusIsError { get; set; }
    [Parameter] public EventCallback<string> PersonLinkSearchRequested { get; set; }
    [Parameter] public EventCallback<Guid> LinkPersonFromPickerRequested { get; set; }
    [Parameter] public EventCallback ClosePersonLinkPickerRequested { get; set; }
    [Parameter] public bool ShowPersonLinkReview { get; set; }
    [Parameter] public bool PersonLinkReviewExisting { get; set; }
    [Parameter] public EventCallback<Guid> OpenExistingPersonLinkReviewRequested { get; set; }
    [Parameter] public Guid PersonLinkReviewPersonId { get; set; }
    [Parameter] public string? PersonLinkReviewPersonName { get; set; }
    [Parameter] public string? PersonLinkReviewPhotoDataUri { get; set; }
    [Parameter] public IReadOnlyList<PersonLinkReviewLine> PersonLinkReviewLines { get; set; } = Array.Empty<PersonLinkReviewLine>();
    [Parameter] public EventCallback JoinPersonLinkReviewRequested { get; set; }
    [Parameter] public EventCallback CancelPersonLinkReviewRequested { get; set; }
    [Parameter] public EventCallback<PersonLinkReviewLine> EditPersonLinkReviewRequested { get; set; }
    [Parameter] public EventCallback<PersonLinkReviewChoiceRequest> SelectPersonLinkReviewRequested { get; set; }
    [Parameter] public EventCallback<PersonLinkReviewLine> CreatePersonLinkReviewRequested { get; set; }
    [Parameter] public PersonLinkReviewCreateForm? PersonLinkReviewCreateForm { get; set; }
    [Parameter] public EventCallback<PersonLinkReviewCreateForm> SavePersonLinkReviewCreateRequested { get; set; }
    [Parameter] public string? HeaderFieldStatusMessage { get; set; }
    [Parameter] public bool HeaderFieldStatusIsError { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceCaseHeaderFieldUpdate> HeaderFieldChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<ApplicationWorkspaceCaseHeaderFieldUpdate>> HeaderFieldsSaved { get; set; }
    [Parameter] public ApplicationWorkspaceStagedHeaderSelection? StagedHeaderSelection { get; set; }
    [Parameter] public EventCallback AlternativeAddressCreateRequested { get; set; }

    [Parameter] public EventCallback<string> InvitationSiteCreateRequested { get; set; }
    [Parameter] public string? OrganizationStatusMessage { get; set; }
    [Parameter] public bool OrganizationStatusIsError { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceOrganizationLetterheadUpdate> OrganizationLetterheadChanged { get; set; }
    [Parameter] public EventCallback<(string Kind, Guid Id)> OrganizationCatalogEditorRequested { get; set; }
    [Parameter] public string PreviewSlotOwnerViewId { get; set; } = OfficerShellViewIds.DetailView;

    private readonly HashSet<Guid> _selectedDocumentPersonIds = [];
    private string _documentPeopleRosterKey = string.Empty;
    private string? _peopleRecordKey;
    private int? _peopleRecordPersonIndex;
    private string? _appliedPeopleFocusKey;
    private bool _caseSummaryEditing;
    private bool _summarySaving;
    private Guid _caseSummaryInstanceId;
    private int _seenStageToken;
    private IReadOnlyList<ApplicationWorkspaceCaseHeaderField>? _boundHeaderFields;
    private Dictionary<string, HeaderOriginal>? _headerOriginals;
    private readonly Dictionary<string, PendingHeader> _pendingHeaders = new(StringComparer.Ordinal);
    private bool _organizationEditing;

    private bool IsCaseSummaryEditing =>
        _caseSummaryEditing && Snapshot?.CaseView.HeaderFields.Count > 0;

