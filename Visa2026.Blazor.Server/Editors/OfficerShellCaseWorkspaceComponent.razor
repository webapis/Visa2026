    private async Task PreviewLinkReviewDocumentAsync(PersonLinkReviewLine line)
    {
        if (line == null || !line.SupportsDocumentCopy || !line.HasDocumentCopy || PersonLinkReviewPersonId == Guid.Empty)
            return;

        if (line.Kind == ApplicationProfileInstancePersonLinkKind.BorderZoneItem && line.ObjectId != Guid.Empty)
        {
            using var os = ObjectSpaceFactory.CreateNonSecuredObjectSpace<BorderZoneItem>();
            var item = os.GetObjectByKey<BorderZoneItem>(line.ObjectId);
            var borderZoneId = item?.BorderZone?.ID ?? Guid.Empty;
            if (borderZoneId == Guid.Empty)
                return;

            await PreviewSlotService.OpenHeaderDocumentCopiesAsync(
                new HeaderDocumentCopiesSlotRequest
                {
                    Family = HeaderDocumentCopiesFamily.BorderZone,
                    ParentId = borderZoneId,
                    ContextItemId = line.ObjectId,
                    OpenPreviewOnly = true,
                    PreviewAllCopies = true,
                    FocusDisplayName = ApplicationProfileLocalization.LinkedRecordLabel(line.Label),
                },
                ownerViewId: null,
                stackWithCurrent: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(line.DocumentCopyRecordKey))
            return;

        await PreviewSlotService.OpenPersonDocumentCopiesAsync(
            new PersonDocumentCopiesSlotRequest
            {
                PersonIds = new[] { PersonLinkReviewPersonId },
                FocusRecordKey = line.DocumentCopyRecordKey,
                FocusDisplayName = ApplicationProfileLocalization.LinkedRecordLabel(line.Label),
                OpenPreviewOnly = true,
            },
            ownerViewId: null,
            stackWithCurrent: true);
    }
