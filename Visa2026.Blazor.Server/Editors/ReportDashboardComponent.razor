@namespace Visa2026.Blazor.Server.Editors
@using Visa2026.Module.Services.ReportDashboard

<div class="report-dashboard">
    <div class="rd-card">
        <div class="rd-project-filter-row">
            <span class="rd-project-filter-label">Project</span>
            <div class="rd-project-filter">
                @foreach (var chip in VisibleProjects)
                {
                    <button type="button"
                            class="rd-chip @(ProjectKey == chip.Key ? "active" : null)"
                            @onclick="() => OnProject(chip.Key)">
                        @chip.Label
                        @if (chip.Key != "All")
                        {
                            <span class="count">(@chip.Count)</span>
                        }
                    </button>
                }
                @if (HiddenProjectCount > 0)
                {
                    <button type="button" class="rd-chip rd-chip-more" @onclick="ToggleProjectsExpanded">
                        @(_projectsExpanded ? "Show less" : $"+{HiddenProjectCount} more")
                    </button>
                }
            </div>
            <div class="rd-period-select">
                <span class="rd-period-label">Last</span>
                <select class="rd-period-picker" @onchange="OnPeriodChange">
                    <option value="6"  selected="@(DateRangeMonths == 6)">6 months</option>
                    <option value="7"  selected="@(DateRangeMonths == 7)">7 months</option>
                    <option value="8"  selected="@(DateRangeMonths == 8)">8 months</option>
                    <option value="9"  selected="@(DateRangeMonths == 9)">9 months</option>
                    <option value="10" selected="@(DateRangeMonths == 10)">10 months</option>
                    <option value="11" selected="@(DateRangeMonths == 11)">11 months</option>
                    <option value="12" selected="@(DateRangeMonths == 12)">1 year</option>
                    <option value="24" selected="@(DateRangeMonths == 24)">2 years</option>
                    <option value="36" selected="@(DateRangeMonths == 36)">3 years</option>
                </select>
            </div>
        </div>

        <div class="rd-tabs-underline" role="tablist">
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.Employees ? "active" : null)"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.Employees)">Employees</button>
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.FamilyMembers ? "active" : null)"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.FamilyMembers)">Family Members</button>
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.TemporaryVisitors ? "active" : null)"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.TemporaryVisitors)">Temporary Visitors</button>
        </div>

        <div class="rd-body">
            <div class="rd-cat-nav" role="tablist">
                <button type="button"
                        class="rd-cat-tab rd-cat-tab-overview @(ShowAllView ? "active" : null)"
                        @onclick="OnShowAll">
                    <span>Overview</span>
                </button>
                @foreach (var category in ReportDashboardCatalog.Categories)
                {
                    var count = GetCategoryCount(category);
                    <button type="button"
                            class="rd-cat-tab @(!ShowAllView && Category == category ? "active" : null)"
                            @onclick="() => OnCategory(category)">
                        <span>@ReportDashboardCatalog.CategoryLabel(category)</span>
                        <span class="rd-cat-tab-count">@count</span>
                    </button>
                }
            </div>

            <div class="rd-report-area">
                @if (ShowAllView)
                {
                    <div class="rd-overview-grid">
                        @foreach (var category in ReportDashboardCatalog.Categories)
                        {
                            var count    = GetCategoryCount(category);
                            var subs     = ReportDashboardCatalog.SubReports(category);
                            var buckets  = GetOverviewBuckets(category);
                            var total    = buckets.Sum(b => b.Count);
                            var maxCount = buckets.Count > 0 ? buckets.Max(b => b.Count) : 1;
                            <button type="button" class="rd-overview-card" @onclick="() => OnCategory(category)">
                                <div class="rd-overview-card-header">
                                    <span class="rd-overview-card-name">@ReportDashboardCatalog.CategoryLabel(category)</span>
                                    <span class="rd-overview-card-count">@count</span>
                                </div>

                                @if (buckets.Count > 0 && total > 0)
                                {
                                    <div class="rd-overview-mini-chart">
                                        <div class="rd-overview-mini-pie-wrap">
                                            <div class="rd-overview-mini-pie" style="@MiniPieStyle(buckets, total)"></div>
                                        </div>
                                        <div class="rd-overview-mini-bars">
                                            @foreach (var bucket in buckets.Take(5))
                                            {
                                                var w = (int)Math.Round(100.0 * bucket.Count / maxCount);
                                                <div class="rd-overview-mini-bar-row">
                                                    <span class="rd-overview-mini-bar-label" title="@bucket.Label">@bucket.Label</span>
                                                    <span class="rd-overview-mini-bar-track">
                                                        <span class="rd-overview-mini-bar-fill @bucket.CssClass"
                                                              style="width:@(w.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                    </span>
                                                    <span class="rd-overview-mini-bar-count">@bucket.Count</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="rd-overview-card-subs">
                                    @foreach (var sub in subs)
                                    {
                                        <span class="rd-overview-sub-chip">@sub.Label</span>
                                    }
                                </div>
                                <div class="rd-overview-card-footer">
                                    View reports &rsaquo;
                                </div>
                            </button>
                        }
                    </div>
                }
                else if (Panel != null)
                {
                    <div class="rd-report-head">
                        <div>
                            <h2>@Panel.Title</h2>
                            <p class="rd-report-sub">@Panel.Subtitle</p>
                        </div>
                        <div class="rd-report-head-right">
                            <div class="rd-report-total">
                                <span class="rd-report-total-num">@FilteredTotal</span>
                                <span class="rd-report-total-label">total records</span>
                            </div>
                            <button type="button"
                                    class="rd-excel-link @(Panel.ExcelConfigured ? null : "disabled")"
                                    disabled="@(!Panel.ExcelConfigured)"
                                    title="@(Panel.ExcelConfigured ? "Download Excel template" : "Excel template not configured")"
                                    @onclick="OnExcel">
                                Open in Excel
                            </button>
                            <button type="button" class="rd-list-link" @onclick="() => OnListView(null)">
                                Open ListView
                            </button>
                        </div>
                    </div>

                    @if (ReportDashboardCatalog.SubReports(Category).Count > 1)
                    {
                        <div class="rd-sub-tabs" role="tablist">
                            @foreach (var sub in ReportDashboardCatalog.SubReports(Category))
                            {
                                <button type="button"
                                        class="rd-sub-tab @(SubReport == sub.Key ? "active" : null)"
                                        @onclick="() => OnSubReport(sub.Key)">
                                    @sub.Label
                                </button>
                            }
                        </div>
                    }

                    <div class="rd-chart-block">
                        <div class="rd-chart-toolbar">
                            <span class="rd-chart-toolbar-label">View</span>
                            <div class="rd-view-switch">
                                <button type="button" class="@(ChartView == "list" ? "active" : null)" @onclick='() => OnChartView("list")'>List</button>
                                <button type="button" class="@(ChartView == "pie" ? "active" : null)"  @onclick='() => OnChartView("pie")'>Pie Chart</button>
                                <button type="button" class="@(ChartView == "bar" ? "active" : null)"  @onclick='() => OnChartView("bar")'>Bar Chart</button>
                            </div>
                        </div>

                        @if (FilteredBuckets.Count == 0 || FilteredTotal == 0)
                        {
                            <div class="rd-chart-empty">No records for this selection.</div>
                        }
                        else if (ChartView == "list")
                        {
                            <div class="rd-stat-list">
                                @foreach (var bucket in FilteredBuckets)
                                {
                                    var pct = FilteredTotal > 0 ? (int)Math.Round(100.0 * bucket.Count / FilteredTotal) : 0;
                                    <button type="button" class="rd-stat-list-row" @onclick="() => OnListView(bucket.Label)">
                                        <span class="rd-stat-list-left">
                                            <span class="rd-legend-dot @bucket.CssClass"></span>@bucket.Label
                                        </span>
                                        <span class="rd-stat-list-right">
                                            <span>@pct%</span>
                                            <span class="count">@bucket.Count</span>
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else if (ChartView == "pie")
                        {
                            <div class="rd-pie-wrap">
                                <div class="rd-pie-circle" style="@PieGradientStyle"></div>
                                <div class="rd-pie-legend">
                                    @foreach (var bucket in FilteredBuckets)
                                    {
                                        var pct = FilteredTotal > 0 ? (int)Math.Round(100.0 * bucket.Count / FilteredTotal) : 0;
                                        <button type="button" class="rd-legend-item" @onclick="() => OnListView(bucket.Label)">
                                            <span class="rd-legend-dot @bucket.CssClass"></span>
                                            @bucket.Label
                                            <span class="rd-legend-count">@bucket.Count</span>
                                            (@pct%)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            var maxCount = FilteredBuckets.Max(b => b.Count);
                            <div class="rd-bar-rows">
                                @foreach (var bucket in FilteredBuckets)
                                {
                                    var width = maxCount > 0 ? (100.0 * bucket.Count / maxCount) : 0;
                                    <button type="button" class="rd-bar-row" @onclick="() => OnListView(bucket.Label)">
                                        <span class="rd-bar-row-label">
                                            <span class="rd-legend-dot @bucket.CssClass"></span>@bucket.Label
                                        </span>
                                        <span class="rd-bar-row-track">
                                            <span class="rd-bar-row-fill @bucket.CssClass"
                                                  style="width:@width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                        </span>
                                        <span class="rd-bar-row-count">@bucket.Count</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="rd-listview-block">
                        <table>
                            <thead>
                                <tr>
                                    @foreach (var header in Panel.TableHeaders)
                                    {
                                        <th>@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredRows.Count == 0)
                                {
                                    <tr class="rd-empty-row"><td colspan="@Panel.TableHeaders.Count">No records for this project.</td></tr>
                                }
                                else
                                {
                                    @foreach (var row in FilteredRows)
                                    {
                                        <tr>
                                            <td>@row.Name</td>
                                            <td><span class="rd-project-tag">@row.Project</span></td>
                                            <td>@row.ColumnA</td>
                                            <td>@row.ColumnB</td>
                                            <td><span class="rd-status-dot @row.StatusCssClass"></span>@row.Status</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ReportDashboardSnapshot?  Snapshot    { get; set; }
    [Parameter] public ReportDashboardPanelData? Panel       { get; set; }
    [Parameter] public IReadOnlyDictionary<ReportDashboardCategory, ReportDashboardPanelData>? AllPanels { get; set; }
    [Parameter] public ReportDashboardPersonType PersonType      { get; set; } = ReportDashboardPersonType.Employees;
    [Parameter] public ReportDashboardCategory   Category        { get; set; } = ReportDashboardCategory.VisaExtension;
    [Parameter] public string                    SubReport       { get; set; } = "default";
    [Parameter] public string                    ProjectKey      { get; set; } = "All";
    [Parameter] public string                    ChartView       { get; set; } = "bar";
    [Parameter] public int                       DateRangeMonths { get; set; } = 6;
    [Parameter] public bool                      ShowAllView     { get; set; } = true;

    [Parameter] public EventCallback<ReportDashboardPersonType> PersonTypeChanged   { get; set; }
    [Parameter] public EventCallback<ReportDashboardCategory>   CategoryChanged     { get; set; }
    [Parameter] public EventCallback<string>                    SubReportChanged    { get; set; }
    [Parameter] public EventCallback<string>                    ProjectKeyChanged   { get; set; }
    [Parameter] public EventCallback<string>                    ChartViewChanged    { get; set; }
    [Parameter] public EventCallback<bool>                      ShowAllViewChanged  { get; set; }
    [Parameter] public EventCallback                            OpenExcelRequested  { get; set; }
    [Parameter] public EventCallback<string?>                   OpenListViewRequested { get; set; }
    [Parameter] public EventCallback<int>                       DateRangeChanged    { get; set; }

    private bool _projectsExpanded;
    private const int VisibleProjectChipLimit = 5;

    private IEnumerable<ReportDashboardProjectChip> VisibleProjects
    {
        get
        {
            var all = Snapshot?.Projects ?? Array.Empty<ReportDashboardProjectChip>();
            return _projectsExpanded ? all : all.Take(VisibleProjectChipLimit);
        }
    }

    private int HiddenProjectCount
    {
        get
        {
            var total = Snapshot?.Projects?.Count ?? 0;
            return Math.Max(0, total - VisibleProjectChipLimit);
        }
    }

    private IReadOnlyList<ReportDashboardPreviewRow>   FilteredRows    => Panel?.PreviewRows ?? Array.Empty<ReportDashboardPreviewRow>();
    private int                                         FilteredTotal   => FilteredRows.Count;
    private IReadOnlyList<ReportDashboardStatusBucket> FilteredBuckets =>
        FilteredRows
            .GroupBy(r => r.Status)
            .Select(g => new ReportDashboardStatusBucket { Label = g.Key, Count = g.Count(), CssClass = g.First().StatusCssClass })
            .OrderByDescending(b => b.Count)
            .ToList();

    private IReadOnlyList<ReportDashboardStatusBucket> GetOverviewBuckets(ReportDashboardCategory category)
    {
        if (AllPanels == null || !AllPanels.TryGetValue(category, out var panel))
            return Array.Empty<ReportDashboardStatusBucket>();
        return panel.PreviewRows
            .GroupBy(r => r.Status)
            .Select(g => new ReportDashboardStatusBucket { Label = g.Key, Count = g.Count(), CssClass = g.First().StatusCssClass })
            .OrderByDescending(b => b.Count)
            .ToList();
    }

    private string MiniPieStyle(IReadOnlyList<ReportDashboardStatusBucket> buckets, int total)
    {
        if (total == 0) return "background:#eef1f4";
        double cumulative = 0;
        var stops = new List<string>();
        foreach (var bucket in buckets)
        {
            var pct = 100.0 * bucket.Count / total;
            var color = CssToHex(bucket.CssClass);
            stops.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
                "{0} {1:0.##}% {2:0.##}%", color, cumulative, cumulative + pct));
            cumulative += pct;
        }
        return "background:conic-gradient(" + string.Join(", ", stops) + ")";
    }

    private string PieGradientStyle
    {
        get
        {
            if (FilteredTotal == 0) return "background:#eef1f4";
            double cumulative = 0;
            var stops = new List<string>();
            foreach (var bucket in FilteredBuckets)
            {
                var pct   = 100.0 * bucket.Count / FilteredTotal;
                var color = CssToHex(bucket.CssClass);
                stops.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
                    "{0} {1:0.##}% {2:0.##}%", color, cumulative, cumulative + pct));
                cumulative += pct;
            }
            return "background:conic-gradient(" + string.Join(", ", stops) + ")";
        }
    }

    private static string CssToHex(string css) => css switch
    {
        "st-approved" => "#2f8f4e",
        "st-expiring" => "#c05a3a",
        "st-pending"  => "#c1841f",
        "st-cat-1"    => "#3b7cc9",
        "st-cat-2"    => "#2f8f4e",
        "st-cat-3"    => "#c1841f",
        "st-cat-4"    => "#9b59b6",
        "st-cat-5"    => "#e74c3c",
        _             => "#8896a8"
    };

    private int GetCategoryCount(ReportDashboardCategory category)
    {
        if (Snapshot?.CategoryCounts == null) return 0;
        return Snapshot.CategoryCounts.TryGetValue((PersonType, category), out var count) ? count : 0;
    }

    private void ToggleProjectsExpanded() => _projectsExpanded = !_projectsExpanded;

    private async Task OnPersonType(ReportDashboardPersonType personType) => await PersonTypeChanged.InvokeAsync(personType);
    private async Task OnCategory(ReportDashboardCategory category)       => await CategoryChanged.InvokeAsync(category);
    private async Task OnSubReport(string key)                             => await SubReportChanged.InvokeAsync(key);
    private async Task OnProject(string key)                               => await ProjectKeyChanged.InvokeAsync(key);
    private async Task OnChartView(string view)                            => await ChartViewChanged.InvokeAsync(view);
    private async Task OnExcel()                                           => await OpenExcelRequested.InvokeAsync();
    private async Task OnListView(string? status)                          => await OpenListViewRequested.InvokeAsync(status);
    private async Task OnShowAll()                                         => await ShowAllViewChanged.InvokeAsync(true);

    private async Task OnPeriodChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var months) && months > 0)
            await DateRangeChanged.InvokeAsync(months);
    }
}