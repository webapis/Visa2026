@namespace Visa2026.Blazor.Server.Editors
@using Visa2026.Module.Services.ReportDashboard
@using Visa2026.Module.Localization

<div class="report-dashboard">
    <div class="rd-card">
        <div class="rd-project-filter-row">
            <span class="rd-project-filter-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Project")</span>
            <div class="rd-project-filter">
                @foreach (var chip in VisibleProjects)
                {
                    <button type="button"
                            class="rd-chip @(ProjectKey == chip.Key ? "active" : null)"
                            disabled="@ShowLoading"
                            @onclick="() => OnProject(chip.Key)">
                        @(chip.Key == "All" ? ReportDashboardLocalization.Get("ReportDashboard.PersonType.All") : chip.Label)
                        @if (chip.Key != "All")
                        {
                            <span class="count">(@chip.Count)</span>
                        }
                    </button>
                }
                @if (HiddenProjectCount > 0)
                {
                    <button type="button" class="rd-chip rd-chip-more" disabled="@ShowLoading" @onclick="ToggleProjectsExpanded">
                        @(_projectsExpanded ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.ShowLess") : ReportDashboardLocalization.Format("ReportDashboard.Chrome.MoreProjects", HiddenProjectCount))
                    </button>
                }
            </div>
            @* Last-N months moved to Education (and Overview Education filter) — not global. *@
        </div>

        <div class="rd-tabs-underline" role="tablist">
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.All ? "active" : null)"
                    disabled="@ShowLoading"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.All)">@PersonTypeTabLabel(ReportDashboardPersonType.All)</button>
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.Employees ? "active" : null)"
                    disabled="@ShowLoading"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.Employees)">@PersonTypeTabLabel(ReportDashboardPersonType.Employees)</button>
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.FamilyMembers ? "active" : null)"
                    disabled="@ShowLoading"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.FamilyMembers)">@PersonTypeTabLabel(ReportDashboardPersonType.FamilyMembers)</button>
            <button type="button" class="rd-tab-underline @(PersonType == ReportDashboardPersonType.TemporaryVisitors ? "active" : null)"
                    disabled="@ShowLoading"
                    @onclick="() => OnPersonType(ReportDashboardPersonType.TemporaryVisitors)">@PersonTypeTabLabel(ReportDashboardPersonType.TemporaryVisitors)</button>
        </div>

        <div class="rd-body">
            <div class="rd-cat-nav" role="tablist">
                <button type="button"
                        class="rd-cat-tab rd-cat-tab-overview @(ShowAllView ? "active" : null)"
                        disabled="@ShowLoading"
                        @onclick="OnShowAll">
                    <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Overview")</span>
                </button>
                @foreach (var category in ReportDashboardCatalog.Categories)
                {
                    <button type="button"
                            class="rd-cat-tab @(!ShowAllView && Category == category ? "active" : null)"
                            disabled="@ShowLoading"
                            @onclick="() => OnCategory(category)">
                        <span>@ReportDashboardCatalog.CategoryLabel(category)</span>
                    </button>
                }
            </div>

            <div class="rd-report-area @(ShowLoading ? "rd-report-area--loading" : null)">
                @if (ShowLoading)
                {
                    <div class="rd-loading-overlay" role="status" aria-live="polite" aria-busy="true">
                        <div class="rd-loading-panel">
                            <div class="rd-loading-label">
                                @(string.IsNullOrWhiteSpace(EffectiveLoadingMessage) ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Loading") : EffectiveLoadingMessage)
                            </div>
                            <div class="rd-loading-track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@(ShowIndeterminateLoading ? null : EffectiveLoadingPercent)"
                                 aria-label='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.LoadingProgress")'>
                                <div class="rd-loading-fill @(ShowIndeterminateLoading ? "rd-loading-fill--indeterminate" : null)"
                                     style="@(ShowIndeterminateLoading ? null : $"width:{EffectiveLoadingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                            </div>
                            @if (!ShowIndeterminateLoading)
                            {
                                <div class="rd-loading-pct">@EffectiveLoadingPercent%</div>
                            }
                        </div>
                    </div>
                }
                @if (ShowAllView)
                {
                    <div class="rd-overview-toolbar">
                        <div class="rd-period-select"
                             title="@(ValidVisaPersonsOnly ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisa") : ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.Date.Education"))">
                            <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Period.EducationLast")</span>
                            <select class="rd-period-picker" disabled="@(ShowLoading || ValidVisaPersonsOnly)"
                                    @onchange="e => OnCategoryPeriodChange(ReportDashboardCategory.Education, e)">
                                @foreach (var m in PeriodMonthOptions)
                                {
                                    <option value="@m" selected="@(DateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                }
                            </select>
                        </div>
                        <div class="rd-period-select"
                             title="@(ValidVisaPersonsOnly ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisaAlign") : ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.Date.Passport"))">
                            <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Period.PassportLast")</span>
                            <select class="rd-period-picker" disabled="@(ShowLoading || ValidVisaPersonsOnly)"
                                    @onchange="e => OnCategoryPeriodChange(ReportDashboardCategory.Passport, e)">
                                @foreach (var m in PeriodMonthOptions)
                                {
                                    <option value="@m" selected="@(PassportDateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                }
                            </select>
                        </div>
                        <div class="rd-period-select"
                             title="@(ValidVisaPersonsOnly ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisa") : ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.Date.Position"))">
                            <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Period.PositionLast")</span>
                            <select class="rd-period-picker" disabled="@(ShowLoading || ValidVisaPersonsOnly)"
                                    @onchange="e => OnCategoryPeriodChange(ReportDashboardCategory.PositionHistory, e)">
                                @foreach (var m in PeriodMonthOptions)
                                {
                                    <option value="@m" selected="@(PositionHistoryDateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                }
                            </select>
                        </div>
                        <div class="rd-period-select"
                             title="@(ValidVisaPersonsOnly ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisa") : ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.Date.Address"))">
                            <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Period.AddressLast")</span>
                            <select class="rd-period-picker" disabled="@(ShowLoading || ValidVisaPersonsOnly)"
                                    @onchange="e => OnCategoryPeriodChange(ReportDashboardCategory.AddressOfResidence, e)">
                                @foreach (var m in PeriodMonthOptions)
                                {
                                    <option value="@m" selected="@(AddressOfResidenceDateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                }
                            </select>
                        </div>
                        <div class="rd-period-select"
                             title="@(ValidVisaPersonsOnly ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisa") : ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.Date.Medical"))">
                            <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Period.MedicalLast")</span>
                            <select class="rd-period-picker" disabled="@(ShowLoading || ValidVisaPersonsOnly)"
                                    @onchange="e => OnCategoryPeriodChange(ReportDashboardCategory.MedicalRecord, e)">
                                @foreach (var m in PeriodMonthOptions)
                                {
                                    <option value="@m" selected="@(MedicalRecordDateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="rd-overview-grid">
                        @foreach (var category in ReportDashboardCatalog.Categories)
                        {
                            var buckets  = GetOverviewBuckets(category);
                            var count    = GetOverviewTotal(category, buckets);
                            var subs     = ReportDashboardCatalog.SubReports(category);
                            var total    = buckets.Sum(b => b.Count);
                            var maxCount = buckets.Count > 0 ? buckets.Max(b => b.Count) : 1;
                            <button type="button" class="rd-overview-card" @onclick="() => OnCategory(category)">
                                <div class="rd-overview-card-header">
                                    <span class="rd-overview-card-name">@ReportDashboardCatalog.CategoryLabel(category)</span>
                                    <span class="rd-overview-card-count">@count</span>
                                </div>

                                @if (buckets.Count > 0 && total > 0)
                                {
                                    <div class="rd-overview-mini-chart">
                                        <div class="rd-overview-mini-pie-wrap">
                                            <div class="rd-overview-mini-pie" style="@MiniPieStyle(buckets, total)"></div>
                                        </div>
                                        <div class="rd-overview-mini-bars">
                                            @foreach (var bucket in buckets.Take(5))
                                            {
                                                var w = (int)Math.Round(100.0 * bucket.Count / maxCount);
                                                <div class="rd-overview-mini-bar-row">
                                                    <span class="rd-overview-mini-bar-label" title="@ReportDashboardLocalization.Status(bucket.Label)">@ReportDashboardLocalization.Status(bucket.Label)</span>
                                                    <span class="rd-overview-mini-bar-track">
                                                        <span class="rd-overview-mini-bar-fill @bucket.CssClass"
                                                              style="width:@(w.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                    </span>
                                                    <span class="rd-overview-mini-bar-count">@bucket.Count</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="rd-overview-card-subs">
                                    @foreach (var sub in subs)
                                    {
                                        <span class="rd-overview-sub-chip" title="@sub.Label">@sub.Label</span>
                                    }
                                </div>
                                <div class="rd-overview-card-footer">
                                    @ReportDashboardLocalization.Get("ReportDashboard.Chrome.ViewReports")
                                </div>
                            </button>
                        }
                    </div>
                }
                else if (Panel != null)
                {
                    <div class="rd-report-head">
                        <div>
                            <h2>@Panel.Title</h2>
                            <p class="rd-report-sub">@Panel.Subtitle</p>
                        </div>
                        <div class="rd-report-head-right">
                            <div class="rd-report-total">
                                <span class="rd-report-total-num">@FilteredTotal</span>
                                <span class="rd-report-total-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.TotalRecords")</span>
                            </div>
                        </div>
                    </div>

                    @if (ReportDashboardCatalog.SubReports(Category).Count > 1)
                    {
                        <div class="rd-sub-tabs-row">
                            <div class="rd-sub-tabs" role="tablist">
                                @foreach (var sub in ReportDashboardCatalog.OrderedSubReports(Category, SubReportCounts))
                                {
                                    var subCount = GetSubReportCount(sub.Key);
                                    <button type="button"
                                            class="rd-sub-tab @(SubReport == sub.Key ? "active" : null)"
                                            @onclick="() => OnSubReport(sub.Key)">
                                        @if (subCount >= 0)
                                        {
                                            <text>@sub.Label (@subCount)</text>
                                        }
                                        else
                                        {
                                            @sub.Label
                                        }
                                    </button>
                                }
                            </div>
                            <div class="rd-sub-tab-filters">
                                @if (ReportDashboardCatalog.SupportsCategoryDateRange(Category))
                                {
                                    <div class="rd-period-select"
                                         title="@(ReportDashboardCatalog.SupportsCategoryDateRange(Category) && ValidVisaPersonsOnly
                                             ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisa")
                                             : ReportDashboardLocalization.CategoryDateRangeTitle(Category))">
                                        <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Last")</span>
                                        <select class="rd-period-picker"
                                                disabled="@(ShowLoading || (ReportDashboardCatalog.SupportsCategoryDateRange(Category) && ValidVisaPersonsOnly))"
                                                @onchange="e => OnCategoryPeriodChange(Category, e)">
                                            @foreach (var m in PeriodMonthOptions)
                                            {
                                                <option value="@m" selected="@(ActiveCategoryDateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                            }
                                        </select>
                                    </div>
                                }
                                @if (ReportDashboardCatalog.SupportsIncludeCompletedApplicationProcesses(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IncludeCompleted")'>
                                        <input type="checkbox"
                                               checked="@IncludeCompletedApplicationProcesses"
                                               @onchange="OnIncludeCompletedApplicationChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.IncludeCompleted")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsIncludeCancelledApplicationProcesses(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IncludeCancelled")'>
                                        <input type="checkbox"
                                               checked="@IncludeCancelledApplicationProcesses"
                                               @onchange="OnIncludeCancelledApplicationChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.IncludeCancelled")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsOneLastValidVisaPerPerson(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.OneLastVisa")'>
                                        <input type="checkbox"
                                               checked="@OneLastValidVisaPerPerson"
                                               @onchange="OnOneLastValidVisaChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.OneLastValidVisa")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsOneLastValidWorkPermitPerPerson(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.OneLastWp")'>
                                        <input type="checkbox"
                                               checked="@OneLastValidWorkPermitPerPerson"
                                               @onchange="OnOneLastValidWorkPermitChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.OneLastValidWorkPermit")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsValidVisaPersonsOnly(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.ValidVisaOnly")'>
                                        <input type="checkbox"
                                               checked="@ValidVisaPersonsOnly"
                                               @onchange="OnValidVisaPersonsOnlyChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.ValidVisaOnly")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsIncludeArchivedPersons(Category))
                                {
                                    <label class="rd-panel-filter" title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IncludeArchived")'>
                                        <input type="checkbox"
                                               checked="@IncludeArchivedPersons"
                                               @onchange="OnIncludeArchivedChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.IncludeArchived")</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    else if (ReportDashboardCatalog.SupportsIncludeArchivedPersons(Category)
                          || ReportDashboardCatalog.SupportsOneLastValidVisaPerPerson(Category)
                          || ReportDashboardCatalog.SupportsOneLastValidWorkPermitPerPerson(Category)
                          || ReportDashboardCatalog.SupportsValidVisaPersonsOnly(Category)
                          || ReportDashboardCatalog.SupportsIncludeCompletedApplicationProcesses(Category)
                          || ReportDashboardCatalog.SupportsIncludeCancelledApplicationProcesses(Category)
                          || ReportDashboardCatalog.SupportsCategoryDateRange(Category))
                    {
                        <div class="rd-sub-tabs-row">
                            <div class="rd-sub-tab-filters">
                                @if (ReportDashboardCatalog.SupportsCategoryDateRange(Category))
                                {
                                    <div class="rd-period-select"
                                         title="@(ReportDashboardCatalog.SupportsCategoryDateRange(Category) && ValidVisaPersonsOnly
                                             ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IgnoredValidVisa")
                                             : ReportDashboardLocalization.CategoryDateRangeTitle(Category))">
                                        <span class="rd-period-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Last")</span>
                                        <select class="rd-period-picker"
                                                disabled="@(ShowLoading || (ReportDashboardCatalog.SupportsCategoryDateRange(Category) && ValidVisaPersonsOnly))"
                                                @onchange="e => OnCategoryPeriodChange(Category, e)">
                                            @foreach (var m in PeriodMonthOptions)
                                            {
                                                <option value="@m" selected="@(ActiveCategoryDateRangeMonths == m)">@PeriodMonthLabel(m)</option>
                                            }
                                        </select>
                                    </div>
                                }
                                @if (ReportDashboardCatalog.SupportsIncludeCompletedApplicationProcesses(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IncludeCompleted")'>
                                        <input type="checkbox"
                                               checked="@IncludeCompletedApplicationProcesses"
                                               @onchange="OnIncludeCompletedApplicationChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.IncludeCompleted")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsIncludeCancelledApplicationProcesses(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IncludeCancelled")'>
                                        <input type="checkbox"
                                               checked="@IncludeCancelledApplicationProcesses"
                                               @onchange="OnIncludeCancelledApplicationChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.IncludeCancelled")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsOneLastValidVisaPerPerson(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.OneLastVisa")'>
                                        <input type="checkbox"
                                               checked="@OneLastValidVisaPerPerson"
                                               @onchange="OnOneLastValidVisaChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.OneLastValidVisa")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsOneLastValidWorkPermitPerPerson(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.OneLastWp")'>
                                        <input type="checkbox"
                                               checked="@OneLastValidWorkPermitPerPerson"
                                               @onchange="OnOneLastValidWorkPermitChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.OneLastValidWorkPermit")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsValidVisaPersonsOnly(Category))
                                {
                                    <label class="rd-panel-filter"
                                           title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.ValidVisaOnly")'>
                                        <input type="checkbox"
                                               checked="@ValidVisaPersonsOnly"
                                               @onchange="OnValidVisaPersonsOnlyChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.ValidVisaOnly")</span>
                                    </label>
                                }
                                @if (ReportDashboardCatalog.SupportsIncludeArchivedPersons(Category))
                                {
                                    <label class="rd-panel-filter" title='@ReportDashboardLocalization.Get("ReportDashboard.Chrome.Title.IncludeArchived")'>
                                        <input type="checkbox"
                                               checked="@IncludeArchivedPersons"
                                               @onchange="OnIncludeArchivedChanged" />
                                        <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.IncludeArchived")</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <div class="rd-chart-block">
                        <div class="rd-chart-toolbar">
                            <span class="rd-chart-toolbar-label">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.View")</span>
                            <div class="rd-view-switch">
                                <button type="button" class="@(ChartView == "pie" ? "active" : null)"  @onclick='() => OnChartView("pie")'>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.PieChart")</button>
                                <button type="button" class="@(ChartView == "bar" ? "active" : null)"  @onclick='() => OnChartView("bar")'>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.BarChart")</button>
                                <button type="button" class="@(ChartView == "list" ? "active" : null)" @onclick='() => OnChartView("list")'>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.List")</button>
                            </div>
                        </div>

                        @if (FilteredBuckets.Count == 0 || FilteredTotal == 0)
                        {
                            <div class="rd-chart-empty">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.EmptySelection")</div>
                        }
                        else if (ChartView == "list")
                        {
                            <div class="rd-stat-list">
                                @foreach (var bucket in FilteredBuckets)
                                {
                                    var pct = FilteredTotal > 0 ? (int)Math.Round(100.0 * bucket.Count / FilteredTotal) : 0;
                                    <button type="button" class="rd-stat-list-row" @onclick="() => OnListView(bucket.Label)">
                                        <span class="rd-stat-list-left">
                                            <span class="rd-legend-dot @bucket.CssClass"></span>@ReportDashboardLocalization.Status(bucket.Label)
                                        </span>
                                        <span class="rd-stat-list-right">
                                            <span>@pct%</span>
                                            <span class="count">@bucket.Count</span>
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else if (ChartView == "pie")
                        {
                            <div class="rd-pie-wrap">
                                <div class="rd-pie-circle" style="@PieGradientStyle"></div>
                                <div class="rd-pie-legend">
                                    @foreach (var bucket in FilteredBuckets)
                                    {
                                        var pct = FilteredTotal > 0 ? (int)Math.Round(100.0 * bucket.Count / FilteredTotal) : 0;
                                        <button type="button" class="rd-legend-item" title="@ReportDashboardLocalization.Status(bucket.Label)" @onclick="() => OnListView(bucket.Label)">
                                            <span class="rd-legend-dot @bucket.CssClass"></span>
                                            <span class="rd-legend-label">@ReportDashboardLocalization.Status(bucket.Label)</span>
                                            <span class="rd-legend-count">@bucket.Count</span>
                                            <span class="rd-legend-pct">@pct%</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            var maxCount = FilteredBuckets.Max(b => b.Count);
                            <div class="rd-bar-rows">
                                @foreach (var bucket in FilteredBuckets)
                                {
                                    var width = maxCount > 0 ? (100.0 * bucket.Count / maxCount) : 0;
                                    <button type="button" class="rd-bar-row" @onclick="() => OnListView(bucket.Label)">
                                        <span class="rd-bar-row-label" title="@ReportDashboardLocalization.Status(bucket.Label)">
                                            <span class="rd-legend-dot @bucket.CssClass"></span>
                                            <span class="rd-bar-row-label-text">@ReportDashboardLocalization.Status(bucket.Label)</span>
                                        </span>
                                        <span class="rd-bar-row-track">
                                            <span class="rd-bar-row-fill @bucket.CssClass"
                                                  style="width:@width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                        </span>
                                        <span class="rd-bar-row-count">@bucket.Count</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="rd-listview-block">
                        <div class="rd-preview-actions">
                            <button type="button"
                                    class="rd-excel-link @(Panel.ExcelConfigured ? null : "disabled")"
                                    disabled="@(!Panel.ExcelConfigured || ShowLoading)"
                                    title="@(Panel.ExcelConfigured ? ReportDashboardLocalization.Get("ReportDashboard.Chrome.ExcelDownloadTitle") : ReportDashboardLocalization.Get("ReportDashboard.Chrome.ExcelNotConfiguredTitle"))"
                                    @onclick="OnExcel">
                                @ReportDashboardLocalization.Get("ReportDashboard.Chrome.OpenInExcel")
                            </button>
                            <button type="button"
                                    class="rd-list-link"
                                    disabled="@ShowLoading"
                                    @onclick="() => OnListView(null)">
                                @ReportDashboardLocalization.Get("ReportDashboard.Chrome.OpenListView")
                            </button>
                        </div>
                        <div class="rd-listview-scroll">
                            <table>
                                <thead>
                                    <tr>
                                        @foreach (var header in Panel.TableHeaders)
                                        {
                                            <th>@header</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredRows.Count == 0)
                                    {
                                        <tr class="rd-empty-row"><td colspan="@Panel.TableHeaders.Count">@ReportDashboardLocalization.Get("ReportDashboard.Chrome.EmptyProject")</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in PagedRows)
                                        {
                                            <tr>
                                                <td>@row.Name</td>
                                                <td><span class="rd-project-tag">@row.Project</span></td>
                                                <td>@row.ColumnA</td>
                                                <td>@row.ColumnB</td>
                                                @if (Panel.TableHeaders.Count >= 6)
                                                {
                                                    <td>@row.ColumnC</td>
                                                }
                                                @if (Panel.TableHeaders.Count >= 7)
                                                {
                                                    <td>@row.ColumnD</td>
                                                }
                                                @if (Panel.TableHeaders.Count >= 8)
                                                {
                                                    <td>@row.ColumnE</td>
                                                }
                                                @if (Panel.TableHeaders.Count >= 9)
                                                {
                                                    <td>@row.ColumnF</td>
                                                }
                                                @if (Panel.TableHeaders.Count >= 10)
                                                {
                                                    <td>@row.ColumnG</td>
                                                }
                                                @if (Panel.TableHeaders.Count >= 11)
                                                {
                                                    <td>@row.ColumnH</td>
                                                }
                                                <td><span class="rd-status-dot @row.StatusCssClass"></span>@ReportDashboardLocalization.Status(row.Status)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (FilteredRows.Count > 0)
                        {
                            <div class="rd-preview-pager">
                                <span class="rd-preview-pager-range">@PreviewRangeLabel</span>
                                <label class="rd-preview-pager-size">
                                    <span>@ReportDashboardLocalization.Get("ReportDashboard.Chrome.PageSize")</span>
                                    <select value="@_previewPageSize" @onchange="OnPreviewPageSizeChanged">
                                        @foreach (var size in PreviewPageSizeOptions)
                                        {
                                            <option value="@size">@size</option>
                                        }
                                    </select>
                                </label>
                                <div class="rd-preview-pager-nav">
                                    <button type="button"
                                            class="rd-preview-pager-btn"
                                            disabled="@(!CanPreviewPrev)"
                                            @onclick="PreviewPrevPage">
                                        @ReportDashboardLocalization.Get("ReportDashboard.Chrome.Prev")
                                    </button>
                                    <span class="rd-preview-pager-page">@_previewPageDisplay / @PreviewPageCount</span>
                                    <button type="button"
                                            class="rd-preview-pager-btn"
                                            disabled="@(!CanPreviewNext)"
                                            @onclick="PreviewNextPage">
                                        @ReportDashboardLocalization.Get("ReportDashboard.Chrome.Next")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ReportDashboardSnapshot?  Snapshot    { get; set; }
    [Parameter] public ReportDashboardPanelData? Panel       { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int>? SubReportCounts { get; set; }
    [Parameter] public IReadOnlyDictionary<ReportDashboardCategory, ReportDashboardPanelData>? AllPanels { get; set; }
    [Parameter] public ReportDashboardPersonType PersonType      { get; set; } = ReportDashboardPersonType.Employees;
    [Parameter] public ReportDashboardCategory   Category        { get; set; } = ReportDashboardCategory.VisaExtension;
    [Parameter] public string                    SubReport       { get; set; } = "default";
    [Parameter] public string                    ProjectKey      { get; set; } = "All";
    [Parameter] public string                    ChartView       { get; set; } = "pie";
    [Parameter] public int                       DateRangeMonths { get; set; } = ReportDashboardCatalog.DefaultCategoryDateRangeMonths;
    [Parameter] public int                       PassportDateRangeMonths { get; set; } = ReportDashboardCatalog.DefaultCategoryDateRangeMonths;
    [Parameter] public int                       PositionHistoryDateRangeMonths { get; set; } = ReportDashboardCatalog.DefaultCategoryDateRangeMonths;
    [Parameter] public int                       AddressOfResidenceDateRangeMonths { get; set; } = ReportDashboardCatalog.DefaultCategoryDateRangeMonths;
    [Parameter] public int                       MedicalRecordDateRangeMonths { get; set; } = ReportDashboardCatalog.DefaultCategoryDateRangeMonths;
    [Parameter] public bool                      ShowAllView     { get; set; } = true;
    [Parameter] public bool                      IsLoading       { get; set; }
    [Parameter] public int                       LoadingProgressPercent { get; set; }
    [Parameter] public string                    LoadingMessage  { get; set; } = string.Empty;
    [Parameter] public bool                      IncludeArchivedPersons { get; set; }
    [Parameter] public bool                      OneLastValidVisaPerPerson { get; set; }
    [Parameter] public bool                      OneLastValidWorkPermitPerPerson { get; set; }
    [Parameter] public bool                      IncludeCompletedApplicationProcesses { get; set; }
    [Parameter] public bool                      IncludeCancelledApplicationProcesses { get; set; }
    [Parameter] public bool                      ValidVisaPersonsOnly { get; set; } = true;

    [Parameter] public EventCallback<ReportDashboardPersonType> PersonTypeChanged   { get; set; }
    [Parameter] public EventCallback<ReportDashboardCategory>   CategoryChanged     { get; set; }
    [Parameter] public EventCallback<string>                    SubReportChanged    { get; set; }
    [Parameter] public EventCallback<string>                    ProjectKeyChanged   { get; set; }
    [Parameter] public EventCallback<string>                    ChartViewChanged    { get; set; }
    [Parameter] public EventCallback<bool>                      ShowAllViewChanged  { get; set; }
    [Parameter] public EventCallback<bool>                      IncludeArchivedPersonsChanged { get; set; }
    [Parameter] public EventCallback<bool>                      OneLastValidVisaPerPersonChanged { get; set; }
    [Parameter] public EventCallback<bool>                      OneLastValidWorkPermitPerPersonChanged { get; set; }
    [Parameter] public EventCallback<bool>                      IncludeCompletedApplicationProcessesChanged { get; set; }
    [Parameter] public EventCallback<bool>                      IncludeCancelledApplicationProcessesChanged { get; set; }
    [Parameter] public EventCallback<bool>                      ValidVisaPersonsOnlyChanged { get; set; }
    [Parameter] public EventCallback                            InitialLoadRequested { get; set; }
    [Parameter] public EventCallback                            OpenExcelRequested  { get; set; }
    [Parameter] public EventCallback<string?>                   OpenListViewRequested { get; set; }
    [Parameter] public EventCallback<int>                       DateRangeChanged    { get; set; }
    [Parameter] public EventCallback<int>                       PassportDateRangeChanged { get; set; }
    [Parameter] public EventCallback<int>                       PositionHistoryDateRangeChanged { get; set; }
    [Parameter] public EventCallback<int>                       AddressOfResidenceDateRangeChanged { get; set; }
    [Parameter] public EventCallback<int>                       MedicalRecordDateRangeChanged { get; set; }

    private bool _projectsExpanded;
    private bool _initialLoadStarted;
    private bool _localLoading;
    private string _localLoadingMessage = ReportDashboardLocalization.Get("ReportDashboard.Chrome.Loading");
    private const int VisibleProjectChipLimit = 5;

    private bool ShowLoading => IsLoading || _localLoading;
    private bool ShowIndeterminateLoading => IsLoading && LoadingProgressPercent < 0;
    private string EffectiveLoadingMessage =>
        IsLoading && !string.IsNullOrWhiteSpace(LoadingMessage) ? LoadingMessage : _localLoadingMessage;
    private int EffectiveLoadingPercent => IsLoading && LoadingProgressPercent >= 0 ? LoadingProgressPercent : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !InitialLoadRequested.HasDelegate)
            return;

        _initialLoadStarted = true;
        await InitialLoadRequested.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        // Parent owns the overlay once its IsLoading flag is set.
        if (IsLoading)
            _localLoading = false;

        var key = $"{Category}|{SubReport}|{ProjectKey}|{PersonType}|{Panel?.SubReport}|{Panel?.TotalCount}|{FilteredRows.Count}";
        if (!string.Equals(key, _previewContextKey, StringComparison.Ordinal))
        {
            _previewContextKey = key;
            _previewPageIndex = 0;
        }

        EnsurePreviewPageInRange();
    }

    private IEnumerable<ReportDashboardProjectChip> VisibleProjects
    {
        get
        {
            var all = Snapshot?.Projects ?? Array.Empty<ReportDashboardProjectChip>();
            return _projectsExpanded ? all : all.Take(VisibleProjectChipLimit);
        }
    }

    private int HiddenProjectCount
    {
        get
        {
            var total = Snapshot?.Projects?.Count ?? 0;
            return Math.Max(0, total - VisibleProjectChipLimit);
        }
    }

    private IReadOnlyList<ReportDashboardPreviewRow>   FilteredRows    => Panel?.PreviewRows ?? Array.Empty<ReportDashboardPreviewRow>();
    private int                                         FilteredTotal   => Panel is { TotalCount: > 0 } p ? p.TotalCount : FilteredRows.Count;
    private IReadOnlyList<ReportDashboardStatusBucket> FilteredBuckets =>
        Panel?.StatusBuckets is { Count: > 0 } buckets
            ? buckets
            : FilteredRows
                .GroupBy(r => r.Status)
                .Select(g => new ReportDashboardStatusBucket { Label = g.Key, Count = g.Count(), CssClass = g.First().StatusCssClass })
                .OrderByDescending(b => b.Count)
                .ToList();

    private static readonly int[] PreviewPageSizeOptions = [25, 50, 100, 200];
    private int _previewPageIndex;
    private int _previewPageSize = 50;
    private string _previewContextKey = string.Empty;

    private int PreviewPageCount =>
        Math.Max(1, (int)Math.Ceiling(FilteredRows.Count / (double)Math.Max(1, _previewPageSize)));

    private int _previewPageDisplay => Math.Min(_previewPageIndex + 1, PreviewPageCount);

    private bool CanPreviewPrev => _previewPageIndex > 0;
    private bool CanPreviewNext => _previewPageIndex < PreviewPageCount - 1;

    private IReadOnlyList<ReportDashboardPreviewRow> PagedRows
    {
        get
        {
            EnsurePreviewPageInRange();
            var size = Math.Max(1, _previewPageSize);
            return FilteredRows.Skip(_previewPageIndex * size).Take(size).ToList();
        }
    }

    private string PreviewRangeLabel
    {
        get
        {
            if (FilteredRows.Count == 0)
                return string.Empty;
            var size = Math.Max(1, _previewPageSize);
            var from = _previewPageIndex * size + 1;
            var to = Math.Min(FilteredRows.Count, (_previewPageIndex + 1) * size);
            var loaded = FilteredRows.Count;
            var total = FilteredTotal;
            if (total > loaded)
            {
                return ReportDashboardLocalization.Format(
                    "ReportDashboard.Chrome.PreviewRangeCapped",
                    from, to, loaded, total);
            }

            return ReportDashboardLocalization.Format(
                "ReportDashboard.Chrome.PreviewRange",
                from, to, loaded);
        }
    }

    private void EnsurePreviewPageInRange()
    {
        var maxIndex = PreviewPageCount - 1;
        if (_previewPageIndex > maxIndex)
            _previewPageIndex = Math.Max(0, maxIndex);
        if (_previewPageIndex < 0)
            _previewPageIndex = 0;
    }

    private void PreviewPrevPage()
    {
        if (!CanPreviewPrev) return;
        _previewPageIndex--;
    }

    private void PreviewNextPage()
    {
        if (!CanPreviewNext) return;
        _previewPageIndex++;
    }

    private void OnPreviewPageSizeChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size) || size <= 0)
            return;
        _previewPageSize = size;
        _previewPageIndex = 0;
    }

    private string MiniPieStyle(IReadOnlyList<ReportDashboardStatusBucket> buckets, int total)
    {
        if (total == 0) return "background:#eef1f4";
        double cumulative = 0;
        var stops = new List<string>();
        foreach (var bucket in buckets)
        {
            var pct = 100.0 * bucket.Count / total;
            var color = CssToHex(bucket.CssClass);
            stops.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
                "{0} {1:0.##}% {2:0.##}%", color, cumulative, cumulative + pct));
            cumulative += pct;
        }
        return "background:conic-gradient(" + string.Join(", ", stops) + ")";
    }

    private string PieGradientStyle
    {
        get
        {
            if (FilteredTotal == 0) return "background:#eef1f4";
            double cumulative = 0;
            var stops = new List<string>();
            foreach (var bucket in FilteredBuckets)
            {
                var pct   = 100.0 * bucket.Count / FilteredTotal;
                var color = CssToHex(bucket.CssClass);
                stops.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
                    "{0} {1:0.##}% {2:0.##}%", color, cumulative, cumulative + pct));
                cumulative += pct;
            }
            return "background:conic-gradient(" + string.Join(", ", stops) + ")";
        }
    }

    private static string CssToHex(string css) => css switch
    {
        "st-approved" => "#2f8f4e",
        "st-expiring" => "#c05a3a",
        "st-pending"  => "#c1841f",
        "st-cat-1"    => "#3b7cc9",
        "st-cat-2"    => "#2f8f4e",
        "st-cat-3"    => "#c1841f",
        "st-cat-4"    => "#9b59b6",
        "st-cat-5"    => "#e74c3c",
        _             => "#8896a8"
    };

    private int GetCategoryCount(ReportDashboardCategory category)
    {
        // Overview / AllPanels: always first-subreport TotalCount (including 0). No mock fallback.
        if (AllPanels != null && AllPanels.TryGetValue(category, out var panel))
            return panel.TotalCount;

        if (Snapshot?.CategoryCounts == null) return 0;
        return Snapshot.CategoryCounts.TryGetValue((PersonType, category), out var count) ? count : 0;
    }

    private int GetOverviewTotal(
        ReportDashboardCategory category,
        IReadOnlyList<ReportDashboardStatusBucket> buckets)
    {
        // Card total = first sub-report snapshot TotalCount for every category.
        if (AllPanels != null && AllPanels.TryGetValue(category, out var panel))
            return panel.TotalCount;
        var fromBuckets = buckets.Sum(b => b.Count);
        return fromBuckets > 0 ? fromBuckets : GetCategoryCount(category);
    }

    private string PersonTypeTabLabel(ReportDashboardPersonType personType)
    {
        var name = ReportDashboardCatalog.PersonTypeLabel(personType);
        var count = 0;
        if (Snapshot?.PersonRoleCounts != null
            && Snapshot.PersonRoleCounts.TryGetValue(personType, out var n))
            count = n;
        return $"{name} ({count})";
    }

    /// <summary>Returns total for a sub-tab; -1 when counts are not loaded yet.</summary>
    private int GetSubReportCount(string subKey)
    {
        if (SubReportCounts != null && SubReportCounts.TryGetValue(subKey, out var n))
            return n;
        // Active panel fallback while counts dictionary is warming up.
        if (string.Equals(SubReport, subKey, StringComparison.Ordinal) && Panel != null)
            return Panel.TotalCount;
        return -1;
    }

    private IReadOnlyList<ReportDashboardStatusBucket> GetOverviewBuckets(ReportDashboardCategory category)
    {
        if (AllPanels == null || !AllPanels.TryGetValue(category, out var panel))
            return Array.Empty<ReportDashboardStatusBucket>();

        // Use full StatusBuckets (view/SQL totals) — never regroup PreviewRows (paging skew).
        if (panel.StatusBuckets is { Count: > 0 } buckets)
            return buckets;

        return panel.PreviewRows
            .GroupBy(r => r.Status)
            .Select(g => new ReportDashboardStatusBucket { Label = g.Key, Count = g.Count(), CssClass = g.First().StatusCssClass })
            .OrderByDescending(b => b.Count)
            .ToList();
    }

    private void ToggleProjectsExpanded() => _projectsExpanded = !_projectsExpanded;

    private async Task BeginLocalLoadingAsync(string message)
    {
        _localLoading = true;
        _localLoadingMessage = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);
    }

    private async Task OnPersonType(ReportDashboardPersonType personType)
    {
        await BeginLocalLoadingAsync(ReportDashboardLocalization.Get("ReportDashboard.Chrome.Loading"));
        await PersonTypeChanged.InvokeAsync(personType);
    }

    private async Task OnCategory(ReportDashboardCategory category)
    {
        await BeginLocalLoadingAsync(ReportDashboardLocalization.Get("ReportDashboard.Chrome.LoadingReport"));
        await CategoryChanged.InvokeAsync(category);
    }

    private async Task OnSubReport(string key)
    {
        await BeginLocalLoadingAsync(ReportDashboardLocalization.Get("ReportDashboard.Chrome.LoadingReport"));
        await SubReportChanged.InvokeAsync(key);
    }

    private async Task OnProject(string key)
    {
        await BeginLocalLoadingAsync(ReportDashboardLocalization.Get("ReportDashboard.Chrome.Loading"));
        await ProjectKeyChanged.InvokeAsync(key);
    }

    private async Task OnChartView(string view)                            => await ChartViewChanged.InvokeAsync(view);
    private async Task OnExcel()                                           => await OpenExcelRequested.InvokeAsync();
    private async Task OnListView(string? status)
    {
        if (ShowLoading || !OpenListViewRequested.HasDelegate)
            return;
        await OpenListViewRequested.InvokeAsync(status);
    }

    private async Task OnShowAll()
    {
        await BeginLocalLoadingAsync(ReportDashboardLocalization.Get("ReportDashboard.Chrome.LoadingOverview"));
        await ShowAllViewChanged.InvokeAsync(true);
    }
    private async Task OnIncludeArchivedChanged(ChangeEventArgs e)
    {
        var include = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
        await IncludeArchivedPersonsChanged.InvokeAsync(include);
    }

    private async Task OnOneLastValidVisaChanged(ChangeEventArgs e)
    {
        var oneLast = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
        await OneLastValidVisaPerPersonChanged.InvokeAsync(oneLast);
    }

    private async Task OnOneLastValidWorkPermitChanged(ChangeEventArgs e)
    {
        var oneLast = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
        await OneLastValidWorkPermitPerPersonChanged.InvokeAsync(oneLast);
    }

    private async Task OnValidVisaPersonsOnlyChanged(ChangeEventArgs e)
    {
        var validOnly = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => true
        };
        await ValidVisaPersonsOnlyChanged.InvokeAsync(validOnly);
    }

    private async Task OnIncludeCompletedApplicationChanged(ChangeEventArgs e)
    {
        var include = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
        await IncludeCompletedApplicationProcessesChanged.InvokeAsync(include);
    }

    private async Task OnIncludeCancelledApplicationChanged(ChangeEventArgs e)
    {
        var include = e.Value switch
        {
            bool b => b,
            string s when bool.TryParse(s, out var parsed) => parsed,
            _ => false
        };
        await IncludeCancelledApplicationProcessesChanged.InvokeAsync(include);
    }

    private static readonly int[] PeriodMonthOptions = [6, 7, 8, 9, 10, 11, 12, 24, 36];

    private int ActiveCategoryDateRangeMonths => Category switch
    {
        ReportDashboardCategory.Passport => PassportDateRangeMonths,
        ReportDashboardCategory.PositionHistory => PositionHistoryDateRangeMonths,
        ReportDashboardCategory.AddressOfResidence => AddressOfResidenceDateRangeMonths,
        ReportDashboardCategory.MedicalRecord => MedicalRecordDateRangeMonths,
        _ => DateRangeMonths
    };

    private static string CategoryDateRangeTitle(ReportDashboardCategory category) =>
        ReportDashboardLocalization.CategoryDateRangeTitle(category);

    private static string PeriodMonthLabel(int months) =>
        ReportDashboardLocalization.PeriodMonthLabel(months);

    private async Task OnCategoryPeriodChange(ReportDashboardCategory category, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var months) || months <= 0)
            return;

        if (category == ReportDashboardCategory.Passport)
            await PassportDateRangeChanged.InvokeAsync(months);
        else if (category == ReportDashboardCategory.PositionHistory)
            await PositionHistoryDateRangeChanged.InvokeAsync(months);
        else if (category == ReportDashboardCategory.AddressOfResidence)
            await AddressOfResidenceDateRangeChanged.InvokeAsync(months);
        else if (category == ReportDashboardCategory.MedicalRecord)
            await MedicalRecordDateRangeChanged.InvokeAsync(months);
        else
            await DateRangeChanged.InvokeAsync(months);
    }
}