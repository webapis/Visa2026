    private static readonly int[] PeriodMonthOptions = [6, 7, 8, 9, 10, 11, 12, 24, 36];

    private int ActiveCategoryDateRangeMonths => Category switch
    {
        ReportDashboardCategory.Passport => PassportDateRangeMonths,
        ReportDashboardCategory.PositionHistory => PositionHistoryDateRangeMonths,
        ReportDashboardCategory.AddressOfResidence => AddressOfResidenceDateRangeMonths,
        ReportDashboardCategory.MedicalRecord => MedicalRecordDateRangeMonths,
        _ => DateRangeMonths
    };

    private static string CategoryDateRangeTitle(ReportDashboardCategory category) => category switch
    {
        ReportDashboardCategory.Passport =>
            "Passport: ApplicationItem.CurrentPassport with Application.ApplicationDate in range",
        ReportDashboardCategory.PositionHistory =>
            "Position History: ApplicationItem.CurrentPositionHistory with Application.ApplicationDate in range",
        ReportDashboardCategory.AddressOfResidence =>
            "Address of Residence: ApplicationItem.CurrentAddressOfResidence with Application.ApplicationDate in range",
        ReportDashboardCategory.MedicalRecord =>
            "Medical Records: ApplicationItem.CurrentMedicalRecord with Application.ApplicationDate in range",
        _ =>
            "Education: ApplicationItem.CurrentEducation with Application.ApplicationDate in range"
    };

    private static string PeriodMonthLabel(int months) => months switch
    {
        12 => "1 year",
        24 => "2 years",
        36 => "3 years",
        _ => $"{months} months"
    };

    private async Task OnCategoryPeriodChange(ReportDashboardCategory category, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var months) || months <= 0)
            return;

        if (category == ReportDashboardCategory.Passport)
            await PassportDateRangeChanged.InvokeAsync(months);
        else if (category == ReportDashboardCategory.PositionHistory)
            await PositionHistoryDateRangeChanged.InvokeAsync(months);
        else if (category == ReportDashboardCategory.AddressOfResidence)
            await AddressOfResidenceDateRangeChanged.InvokeAsync(months);
        else if (category == ReportDashboardCategory.MedicalRecord)
            await MedicalRecordDateRangeChanged.InvokeAsync(months);
        else
            await DateRangeChanged.InvokeAsync(months);
    }
