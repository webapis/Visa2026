    private bool _projectsExpanded;
    private bool _initialLoadStarted;
    private bool _localLoading;
    private string _localLoadingMessage = "Loading…";
    private const int VisibleProjectChipLimit = 5;

    private bool ShowLoading => IsLoading || _localLoading;
    private string EffectiveLoadingMessage =>
        IsLoading && !string.IsNullOrWhiteSpace(LoadingMessage) ? LoadingMessage : _localLoadingMessage;
    private int EffectiveLoadingPercent => IsLoading ? LoadingProgressPercent : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !InitialLoadRequested.HasDelegate)
            return;

        _initialLoadStarted = true;
        await InitialLoadRequested.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        // Parent owns the overlay once its IsLoading flag is set.
        if (IsLoading)
            _localLoading = false;
    }

    private IEnumerable<ReportDashboardProjectChip> VisibleProjects
    {
        get
        {
            var all = Snapshot?.Projects ?? Array.Empty<ReportDashboardProjectChip>();
            return _projectsExpanded ? all : all.Take(VisibleProjectChipLimit);
        }
    }

    private int HiddenProjectCount
    {
        get
        {
            var total = Snapshot?.Projects?.Count ?? 0;
            return Math.Max(0, total - VisibleProjectChipLimit);
        }
    }

    private IReadOnlyList<ReportDashboardPreviewRow>   FilteredRows    => Panel?.PreviewRows ?? Array.Empty<ReportDashboardPreviewRow>();
    private int                                         FilteredTotal   => Panel is { TotalCount: > 0 } p ? p.TotalCount : FilteredRows.Count;
    private IReadOnlyList<ReportDashboardStatusBucket> FilteredBuckets =>
        Panel?.StatusBuckets is { Count: > 0 } buckets
            ? buckets
            : FilteredRows
                .GroupBy(r => r.Status)
                .Select(g => new ReportDashboardStatusBucket { Label = g.Key, Count = g.Count(), CssClass = g.First().StatusCssClass })
                .OrderByDescending(b => b.Count)
                .ToList();

    private string MiniPieStyle(IReadOnlyList<ReportDashboardStatusBucket> buckets, int total)
    {
        if (total == 0) return "background:#eef1f4";
        double cumulative = 0;
        var stops = new List<string>();
        foreach (var bucket in buckets)
        {
            var pct = 100.0 * bucket.Count / total;
            var color = CssToHex(bucket.CssClass);
            stops.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
                "{0} {1:0.##}% {2:0.##}%", color, cumulative, cumulative + pct));
            cumulative += pct;
        }
        return "background:conic-gradient(" + string.Join(", ", stops) + ")";
    }

    private string PieGradientStyle
    {
        get
        {
            if (FilteredTotal == 0) return "background:#eef1f4";
            double cumulative = 0;
            var stops = new List<string>();
            foreach (var bucket in FilteredBuckets)
            {
                var pct   = 100.0 * bucket.Count / FilteredTotal;
                var color = CssToHex(bucket.CssClass);
                stops.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
                    "{0} {1:0.##}% {2:0.##}%", color, cumulative, cumulative + pct));
                cumulative += pct;
            }
            return "background:conic-gradient(" + string.Join(", ", stops) + ")";
        }
    }

    private static string CssToHex(string css) => css switch
    {
        "st-approved" => "#2f8f4e",
        "st-expiring" => "#c05a3a",
        "st-pending"  => "#c1841f",
        "st-cat-1"    => "#3b7cc9",
        "st-cat-2"    => "#2f8f4e",
        "st-cat-3"    => "#c1841f",
        "st-cat-4"    => "#9b59b6",
        "st-cat-5"    => "#e74c3c",
        _             => "#8896a8"
    };

    private int GetCategoryCount(ReportDashboardCategory category)
    {
        // Prefer real panel totals when Overview (or any AllPanels) already loaded them.
        if (AllPanels != null && AllPanels.TryGetValue(category, out var panel))
        {
            if (panel.TotalCount > 0)
                return panel.TotalCount;
            if (panel.StatusBuckets is { Count: > 0 } buckets)
                return buckets.Sum(b => b.Count);
        }

        if (Snapshot?.CategoryCounts == null) return 0;
        return Snapshot.CategoryCounts.TryGetValue((PersonType, category), out var count) ? count : 0;
    }

    private int GetOverviewTotal(
        ReportDashboardCategory category,
        IReadOnlyList<ReportDashboardStatusBucket> buckets)
    {
        if (AllPanels != null && AllPanels.TryGetValue(category, out var panel) && panel.TotalCount > 0)
            return panel.TotalCount;
        var fromBuckets = buckets.Sum(b => b.Count);
        return fromBuckets > 0 ? fromBuckets : GetCategoryCount(category);
    }

    private string PersonTypeTabLabel(ReportDashboardPersonType personType)
    {
        var name = ReportDashboardCatalog.PersonTypeLabel(personType);
        var count = 0;
        if (Snapshot?.PersonRoleCounts != null
            && Snapshot.PersonRoleCounts.TryGetValue(personType, out var n))
            count = n;
        return $"{name} ({count})";
    }

    /// <summary>Returns total for a sub-tab; -1 when counts are not loaded yet.</summary>
    private int GetSubReportCount(string subKey)
    {
        if (SubReportCounts != null && SubReportCounts.TryGetValue(subKey, out var n))
            return n;
        // Active panel fallback while counts dictionary is warming up.
        if (string.Equals(SubReport, subKey, StringComparison.Ordinal) && Panel != null)
            return Panel.TotalCount;
        return -1;
    }

    private IReadOnlyList<ReportDashboardStatusBucket> GetOverviewBuckets(ReportDashboardCategory category)
    {
        if (AllPanels == null || !AllPanels.TryGetValue(category, out var panel))
            return Array.Empty<ReportDashboardStatusBucket>();

        // Use full StatusBuckets (view/SQL totals) — never regroup PreviewRows (Take(50) skew).
        if (panel.StatusBuckets is { Count: > 0 } buckets)
            return buckets;

        return panel.PreviewRows
            .GroupBy(r => r.Status)
            .Select(g => new ReportDashboardStatusBucket { Label = g.Key, Count = g.Count(), CssClass = g.First().StatusCssClass })
            .OrderByDescending(b => b.Count)
            .ToList();
    }

    private void ToggleProjectsExpanded() => _projectsExpanded = !_projectsExpanded;

    private async Task BeginLocalLoadingAsync(string message)
    {
        _localLoading = true;
        _localLoadingMessage = message;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);
    }

