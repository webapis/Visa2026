@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationProfilePicker

<div class="ap-wizard__panel-head">
    <h2>@Msg("ApplicationProfile.Wizard.Step.Review")</h2>
    <p>@Msg("ApplicationProfile.Wizard.ReviewIntro")</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__summary">
        <div class="ap-wizard__sum-card">
            <h4>@Msg("ApplicationProfile.Wizard.ReviewIdentity")</h4>
            <ul>
                <li>@Profile.Name</li>
                <li>@FormatCodeLine(Profile)</li>
                <li>@FormatRoute(Profile.ProgressRoute) · @FormatAudience(Profile) · @FormatRelatedTo(Profile)</li>
                @if (Profile.ActionFamily == ApplicationProfileActionFamily.Issuance)
                {
                    <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewProduces", FormatProduce(Profile))</li>
                }
                else if (Profile.ActionFamily == ApplicationProfileActionFamily.Cancellation)
                {
                    <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewCancel", FormatCancel(Profile))</li>
                }
                else if (Profile.ActionFamily == ApplicationProfileActionFamily.Change)
                {
                    <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewChange", FormatChange(Profile))</li>
                }
                else if (Profile.ActionFamily == ApplicationProfileActionFamily.Registration
                    && Profile.RegistrationKind != ApplicationProfileRegistrationKind.None)
                {
                    <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewRegistrationIs", FormatRegistrationKind(Profile.RegistrationKind))</li>
                }
            </ul>
        </div>
        <div class="ap-wizard__sum-card">
            <h4>@Msg("ApplicationProfile.Wizard.ReviewFields")</h4>
            <ul>
                <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewRequiredCount", CountRequiredProps(Profile))</li>
            </ul>
        </div>
        <div class="ap-wizard__sum-card">
            <h4>@Msg("ApplicationProfile.Wizard.ReviewProcess")</h4>
            <ul>
                <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewSla", Profile.MinistrySlaDays, Profile.MigrationSlaDays)</li>
            </ul>
        </div>
        <div class="ap-wizard__sum-card">
            <h4>@Msg("ApplicationProfile.Wizard.Step.Person")</h4>
            <ul>
                <li>@VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewPersonCount", CountPersonToggles(Profile))</li>
            </ul>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;

    private static string Msg(string key) => VisaUiMessages.Get(key);

    private static string FormatCodeLine(ApplicationProfile profile)
    {
        var line = VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewCode", profile.Code);
        if (!string.IsNullOrWhiteSpace(profile.SelectionCode))
            line += " " + VisaUiMessages.Format("ApplicationProfile.Wizard.ReviewQuick", profile.SelectionCode);
        return line;
    }

    private static string FormatRoute(ApplicationProfileInstanceProgressRouteKind route) =>
        ApplicationProfileLocalization.ProgressRoute(route);

    private static string FormatAudience(ApplicationProfile profile)
    {
        var parts = new List<string>();
        if (profile.ForEmployee) parts.Add(Msg("ApplicationProfile.Audience.Employee"));
        if (profile.ForFamilyMember) parts.Add(Msg("ApplicationProfile.Audience.Family"));
        if (profile.ForTemporaryVisitor) parts.Add(Msg("ApplicationProfile.Audience.Visitor"));
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }

    private static string FormatRelatedTo(ApplicationProfile profile) =>
        ApplicationProfilePickerDisplayHelper.FormatRelatedTo(profile);

    private static string FormatRegistrationKind(ApplicationProfileRegistrationKind kind) =>
        ApplicationProfilePickerDisplayHelper.FormatRegistrationKind(kind);

    private static string FormatProduce(ApplicationProfile p)
    {
        var items = new List<string>();
        if (p.ProduceInvitation) items.Add(Msg("ApplicationProfile.Doc.Invitation"));
        if (p.ProduceWorkPermit) items.Add(Msg("ApplicationProfile.Doc.WorkPermit"));
        if (p.ProduceVisa) items.Add(Msg("ApplicationProfile.Doc.Visa"));
        if (p.ProduceBorderZone) items.Add(Msg("ApplicationProfile.Doc.BorderZone"));
        if (p.ProduceRejection) items.Add(Msg("ApplicationProfile.Doc.Rejection"));
        if (p.ProduceWorkLocation) items.Add(Msg("ApplicationProfile.Doc.WorkLocation"));
        return items.Count == 0 ? "—" : string.Join(", ", items);
    }

    private static string FormatCancel(ApplicationProfile p)
    {
        var items = new List<string>();
        if (p.CancelInvitations) items.Add(Msg("ApplicationProfile.Doc.Invitation"));
        if (p.CancelWorkPermits) items.Add(Msg("ApplicationProfile.Doc.WorkPermit"));
        if (p.CancelVisas) items.Add(Msg("ApplicationProfile.Doc.Visa"));
        return items.Count == 0 ? "—" : string.Join(", ", items);
    }

    private static string FormatChange(ApplicationProfile p)
    {
        var items = new List<string>();
        if (p.ChangeInvitations) items.Add(Msg("ApplicationProfile.Doc.Invitation"));
        if (p.ChangeWorkPermits) items.Add(Msg("ApplicationProfile.Doc.WorkPermit"));
        if (p.ChangeVisas) items.Add(Msg("ApplicationProfile.Doc.Visa"));
        if (p.ChangeBorderZonePermits) items.Add(Msg("ApplicationProfile.Doc.BorderZone"));
        if (p.ChangeApplicationProfileInstances) items.Add(Msg("ApplicationProfile.Doc.Application"));
        return items.Count == 0 ? "—" : string.Join(", ", items);
    }

    private static int CountRequiredProps(ApplicationProfile p)
    {
        var n = 0;
        if (p.RequireVisaType) n++;
        if (p.RequireVisaCategory) n++;
        if (p.RequireVisaPeriod) n++;
        if (p.RequireBorderZone) n++;
        if (p.RequireMigrationService) n++;
        if (p.RequireStartDate) n++;
        if (p.RequireEndDate) n++;
        if (p.RequireRegion) n++;
        if (p.RequireCity) n++;
        if (p.RequireBusinessTripAddress) n++;
        if (p.RequirePurpose) n++;
        if (p.RequireProject) n++;
        if (p.RequireUrgency) n++;
        if (p.RequireWorkPermitLocation) n++;
        if (p.RequireEntryDate) n++;
        if (p.RequireEntryCheckPoint) n++;
        return n;
    }

    private static int CountPersonToggles(ApplicationProfile p)
    {
        var n = 0;
        if (p.RequirePersonPassport) n++;
        if (p.RequirePersonEducation && ApplicationProfileEducationPolicy.AllowsPersonEducation(p)) n++;
        if (p.RequirePersonPosition) n++;
        if (p.RequirePersonAddressOfResidence) n++;
        if (p.RequirePersonVisa) n++;
        if (p.RequirePersonInvitationItem) n++;
        if (p.RequirePersonWorkPermitItem) n++;
        if (p.RequirePersonBorderZoneItem) n++;
        if (p.RequirePersonSalary) n++;
        if (p.RequirePersonMedical) n++;
        if (p.RequirePersonRejectionItem) n++;
        if (p.RequirePersonTravelHistory && ApplicationProfileTravelHistoryPolicy.AllowsPersonTravelHistory(p)) n++;
        return n;
    }
}
