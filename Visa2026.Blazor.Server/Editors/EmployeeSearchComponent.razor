@using System.Globalization
@using System.Linq
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.Services
@using Visa2026.Module.Localization
@using DevExpress.ExpressApp
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.EmployeeSearch

<div class="esearch">
    @if (IsLoading && !ShowResults)
    {
        <div class="esearch__loading" role="status">@L("Loading")</div>
    }
    else if (!ShowResults)
    {
        <form class="esearch__form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <header class="esearch__head">
                <div>
                    <h1 class="esearch__title">@L("Title")</h1>
                    <p class="esearch__sub">@L("Subtitle")</p>
                </div>
                <span class="esearch__bar-actions">
                    <button type="button" class="esearch__btn" @onclick="Clear" disabled="@IsBusy">@L("Clear")</button>
                    <button type="submit" class="esearch__btn esearch__btn--primary" disabled="@IsBusy">@L("Search")</button>
                </span>
            </header>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="@(IsStatusError ? "esearch__error" : "esearch__hint")" role="status">@StatusMessage</p>
            }

            @{
                var setCriteria = SetCriteria();
            }
            <div class="esearch__picker @(setCriteria.Count > 0 ? "has-set" : null)">
                @if (setCriteria.Count > 0)
                {
                    <div class="esearch__set">
                        @foreach (var item in setCriteria)
                        {
                            <button type="button" class="esearch__set-chip" title="@item.Label" @onclick="() => _openGroup = item.Group">
                                <span class="esearch__set-group">@L(item.GroupLabel)</span>
                                <span class="esearch__set-value">@item.Label</span>
                            </button>
                        }
                    </div>
                }
                <div class="esearch__tabs" role="tablist" aria-label="@L("Aria.Criteria")">
                    @foreach (var tab in SearchTabs)
                    {
                        var open = _openGroup == tab.Id;
                        <button type="button" class="esearch__tab @(open ? "is-open" : "")" role="tab" aria-selected="@open" @onclick="() => _openGroup = tab.Id">
                            <span class="esearch__tab-name">@L(tab.Label)</span>
                        </button>
                    }
                </div>
            </div>

            <div class="esearch__cards">
                @if (_openGroup == 1)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Name")</h2>
                    <label>@L("FirstName")<input @bind="_firstName" @bind:event="oninput" /></label>
                    <label>@L("MiddleName")<input @bind="_middleName" @bind:event="oninput" /></label>
                    <label>@L("LastName")<input @bind="_lastName" @bind:event="oninput" /></label>
                    <label>@L("FullName")<input @bind="_fullName" @bind:event="oninput" /></label>
                    <label>@L("PersonalNumber")<input @bind="_personalNumber" /></label>
                    <label>@L("Email")<input @bind="_email" /></label>
                    <label>@L("PhotoOnFile")<EmployeeSearchYesNo @bind-Value="_hasPhoto" Label="@L("PhotoOnFile")" /></label>
                    <div class="esearch__switch esearch__switch--3" role="group" aria-label="@L("Aria.Archive")">
                        <button type="button" class="@SwitchClass(_archive == "active")" @onclick='() => _archive = "active"'>@L("Active")</button>
                        <button type="button" class="@SwitchClass(_archive == "archived")" @onclick='() => _archive = "archived"'>@L("Archived")</button>
                        <button type="button" class="@SwitchClass(_archive == "both")" @onclick='() => _archive = "both"'>@L("Both")</button>
                    </div>
                    <label>@L("IncompleteFile")<EmployeeSearchYesNo @bind-Value="_incomplete" Label="@L("IncompleteFile")" /></label>
                    <label>@L("MissingArea")
                        <EmployeeSearchMultiSelect Options="GapOptions" @bind-Value="_gaps" FieldName="missing area" ResetKey="@PickerKey("gaps")" />
                    </label>
                </section>
                }

                @if (_openGroup == 2)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Age")</h2>
                    <label>@L("Gender")
                        <EmployeeSearchMultiSelect Options="Genders" @bind-Value="_gender" FieldName="gender" ResetKey="@PickerKey("gender")" />
                    </label>
                    <div class="esearch__pair">
                        <label>@L("AgeFrom")<input type="number" min="0" max="120" @bind="_ageFrom" /></label>
                        <label>@L("AgeTo")<input type="number" min="0" max="120" @bind="_ageTo" /></label>
                    </div>
                    <label>@L("AgeAsOfYear")<input type="number" min="1900" max="2100" @bind="_ageAsOf" /></label>
                    <div class="esearch__pair">
                        <label>@L("BirthFrom")<OfficerDateEdit @bind-Date="_birthFrom" CssClass="esearch__date" /></label>
                        <label>@L("BirthTo")<OfficerDateEdit @bind-Date="_birthTo" CssClass="esearch__date" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("BirthYearFrom")<input type="number" min="1900" max="2100" @bind="_birthYearFrom" /></label>
                        <label>@L("BirthYearTo")<input type="number" min="1900" max="2100" @bind="_birthYearTo" /></label>
                    </div>
                    <label>@L("MaritalStatus")
                        <EmployeeSearchMultiSelect Options="MaritalStatuses" @bind-Value="_marital" FieldName="marital status" ResetKey="@PickerKey("marital")" />
                    </label>
                    <label>@L("HasFamily")<EmployeeSearchYesNo @bind-Value="_family" Label="@L("HasFamily")" /></label>
                    <label>@L("FamilyRelationship")
                        <EmployeeSearchMultiSelect Options="Relationships" @bind-Value="_relationship" FieldName="relationship" ResetKey="@PickerKey("relationship")" />
                    </label>
                    <div class="esearch__pair">
                        <label>@L("FamilyAtLeast")<input type="number" min="0" max="40" @bind="_familyFrom" /></label>
                        <label>@L("FamilyAtMost")<input type="number" min="0" max="40" @bind="_familyTo" /></label>
                    </div>
                    <label>@L("FamilyVisaYear")<EmployeeSearchYesNo @bind-Value="_familyVisa" Label="@L("FamilyVisaYear")" /></label>
                    <label>@L("ThatYear")<input type="number" min="1990" max="2100" @bind="_familyVisaYear" /></label>
                    <label>@L("VisaFamilyText")<input @bind="_familyText" /></label>
                    <label>@L("FamilyTextEmpty")<EmployeeSearchYesNo @bind-Value="_familyTextEmpty" Label="@L("FamilyTextEmpty")" /></label>
                </section>
                }

                @if (_openGroup == 3)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Citizenship")</h2>
                    <label>@L("Citizenship")
                        <EmployeeSearchMultiSelect Options="Countries" @bind-Value="_nationality" FieldName="citizenship" ResetKey="@PickerKey("nationality")" />
                    </label>
                    <label>@L("CountryOfBirth")
                        <EmployeeSearchMultiSelect Options="Countries" @bind-Value="_birthCountry" FieldName="country of birth" ResetKey="@PickerKey("birthCountry")" />
                    </label>
                    <label>@L("PlaceOfBirth")<input @bind="_birthPlace" /></label>
                    <label>@L("CitizenshipDiffers")<EmployeeSearchYesNo @bind-Value="_citizenshipDiffers" Label="@L("CitizenshipDiffers")" /></label>
                    <label>@L("PassportOtherCountry")<EmployeeSearchYesNo @bind-Value="_otherPassport" Label="@L("PassportOtherCountry")" /></label>
                    <label>@L("ForeignCountry")
                        <EmployeeSearchMultiSelect Options="Countries" @bind-Value="_foreignCountry" FieldName="foreign country" ResetKey="@PickerKey("foreignCountry")" />
                    </label>
                    <label>@L("ForeignAddress")<input @bind="_foreignAddress" /></label>
                </section>
                }

                @if (_openGroup == 4)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Position")</h2>
                    <label>@L("Department")
                        <EmployeeSearchMultiSelect Options="Departments" @bind-Value="_department" FieldName="department" ResetKey="@PickerKey("department")" />
                    </label>
                    <label>@L("Position")
                        <EmployeeSearchMultiSelect Options="Positions" @bind-Value="_position" FieldName="position" ResetKey="@PickerKey("position")" />
                    </label>
                    <label>@L("ActualPosition")
                        <EmployeeSearchMultiSelect Options="ActualPositions" @bind-Value="_actualPosition" FieldName="actual position" ResetKey="@PickerKey("actual")" />
                    </label>
                    <div class="esearch__switch esearch__switch--3" role="group" aria-label="@L("Aria.Position")">
                        <button type="button" class="@SwitchClass(!_positionAnyTime && !_positionLeft)" @onclick="SetPositionCurrent">@L("Current")</button>
                        <button type="button" class="@SwitchClass(_positionAnyTime)" @onclick="SetPositionAny">@L("AnyTime")</button>
                        <button type="button" class="@SwitchClass(_positionLeft)" @onclick="SetPositionLeft">@L("Left")</button>
                    </div>
                    <label>@L("LeftInYear")<input type="number" min="1990" max="2100" @bind="_leftYear" /></label>
                    <div class="esearch__pair">
                        <label>@L("PositionYearFrom")<input type="number" min="1990" max="2100" @bind="_positionYearFrom" /></label>
                        <label>@L("PositionYearTo")<input type="number" min="1990" max="2100" @bind="_positionYearTo" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("HiredFrom")<OfficerDateEdit @bind-Date="_hireFrom" CssClass="esearch__date" /></label>
                        <label>@L("HiredTo")<OfficerDateEdit @bind-Date="_hireTo" CssClass="esearch__date" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("YearsFrom")<input type="number" min="0" max="80" @bind="_yearsFrom" /></label>
                        <label>@L("YearsTo")<input type="number" min="0" max="80" @bind="_yearsTo" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("ChangedDepartment")<input type="number" min="1990" max="2100" @bind="_changedDepartmentYear" /></label>
                        <label>@L("ChangedPosition")<input type="number" min="1990" max="2100" @bind="_changedPositionYear" /></label>
                    </div>
                    <label>@L("SeveralPositions")<EmployeeSearchYesNo @bind-Value="_severalPositions" Label="@L("SeveralPositions")" /></label>
                    <label>@L("InYear")<input type="number" min="1990" max="2100" @bind="_severalPositionsYear" /></label>
                    <label>@L("PreviousWork")<input @bind="_previousWork" /></label>
                </section>
                }

                @if (_openGroup == 5)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Project")</h2>
                    <label>@L("ProjectContract")
                        <EmployeeSearchMultiSelect Options="Contracts" @bind-Value="_contract" FieldName="project contract" ResetKey="@PickerKey("contract")" />
                    </label>
                    <div class="esearch__pair">
                        <label>@L("ContractYearFrom")<input type="number" min="1990" max="2100" @bind="_contractYearFrom" /></label>
                        <label>@L("YearTo")<input type="number" min="1990" max="2100" @bind="_contractYearTo" /></label>
                    </div>
                    <label>@L("ContractActive")<EmployeeSearchYesNo @bind-Value="_contractActive" Label="@L("ContractActive")" /></label>
                    <label>@L("ContractDescription")<input @bind="_contractDescription" /></label>
                    <label>@L("SeveralContracts")<EmployeeSearchYesNo @bind-Value="_severalContracts" Label="@L("SeveralContracts")" /></label>
                    <label>@L("Subcontractor")
                        <EmployeeSearchMultiSelect Options="Subcontractors" @bind-Value="_subcontractor" FieldName="subcontractor" ResetKey="@PickerKey("subcontractor")" />
                    </label>
                </section>
                }

                @if (_openGroup == 6)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Pay")</h2>
                    <div class="esearch__pair">
                        <label>@L("SalaryFrom")<input type="number" step="0.01" @bind="_salaryFrom" /></label>
                        <label>@L("SalaryTo")<input type="number" step="0.01" @bind="_salaryTo" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("SalaryYearFrom")<input type="number" min="1990" max="2100" @bind="_salaryYearFrom" /></label>
                        <label>@L("SalaryYearTo")<input type="number" min="1990" max="2100" @bind="_salaryYearTo" /></label>
                    </div>
                    <label>@L("SalaryChanged")<EmployeeSearchYesNo @bind-Value="_salaryChanged" Label="@L("SalaryChanged")" /></label>
                    <label>@L("ChangedInYear")<input type="number" min="1990" max="2100" @bind="_salaryChangedYear" /></label>
                </section>
                }

                @if (_openGroup == 7)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Education")</h2>
                    <label>@L("Specialty")
                        <EmployeeSearchMultiSelect Options="Specialties" @bind-Value="_specialty" FieldName="specialty" ResetKey="@PickerKey("specialty")" />
                    </label>
                    <label>@L("EducationCountry")
                        <EmployeeSearchMultiSelect Options="Countries" @bind-Value="_educationCountry" FieldName="education country" ResetKey="@PickerKey("eduCountry")" />
                    </label>
                    <label>@L("EducationLevel")
                        <EmployeeSearchMultiSelect Options="EducationLevels" @bind-Value="_educationLevel" FieldName="education level" ResetKey="@PickerKey("level")" />
                    </label>
                    <label>@L("Institution")
                        <EmployeeSearchMultiSelect Options="Institutions" @bind-Value="_institution" FieldName="institution" ResetKey="@PickerKey("institution")" />
                    </label>
                    <div class="esearch__pair">
                        <label>@L("GraduationFrom")<input type="number" min="1950" max="2100" @bind="_gradFrom" /></label>
                        <label>@L("GraduationTo")<input type="number" min="1950" max="2100" @bind="_gradTo" /></label>
                    </div>
                    <label>@L("HasEducation")<EmployeeSearchYesNo @bind-Value="_hasEducation" Label="@L("HasEducation")" /></label>
                    <label>@L("EducatedOutside")<EmployeeSearchYesNo @bind-Value="_educatedOutside" Label="@L("EducatedOutside")" /></label>
                    <label>@L("SpecialtyDiffers")<EmployeeSearchYesNo @bind-Value="_specialtyDiffers" Label="@L("SpecialtyDiffers")" /></label>
                    <label>@L("Diploma")<EmployeeSearchYesNo @bind-Value="_diploma" Label="@L("Diploma")" /></label>
                </section>
                }

                @if (_openGroup == 8)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Visas")</h2>
                    <div class="esearch__pair">
                        <label>@L("VisaYearFrom")<input type="number" min="1990" max="2100" @bind="_visaYearFrom" /></label>
                        <label>@L("YearTo")<input type="number" min="1990" max="2100" @bind="_visaYearTo" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("ValidFrom")<OfficerDateEdit @bind-Date="_visaFrom" CssClass="esearch__date" /></label>
                        <label>@L("ValidTo")<OfficerDateEdit @bind-Date="_visaTo" CssClass="esearch__date" /></label>
                    </div>
                    <label>@L("ValidOn")<OfficerDateEdit @bind-Date="_visaOn" CssClass="esearch__date" /></label>
                    <label class="esearch__check"><input type="checkbox" @bind="_stillValid" /> @L("ValidToday")</label>
                    <label>@L("ExpiringDays")<input type="number" min="1" max="3650" @bind="_expiringDays" /></label>
                    <label>@L("VisaExpired")<EmployeeSearchYesNo @bind-Value="_visaExpired" Label="@L("VisaExpired")" /></label>
                    <label>@L("ExpiredInYear")<input type="number" min="1990" max="2100" @bind="_visaExpiredYear" /></label>
                    <label>@L("NeverVisa")<EmployeeSearchYesNo @bind-Value="_neverVisa" Label="@L("NeverVisa")" /></label>
                    <div class="esearch__pair">
                        <label>@L("FirstVisaFrom")<input type="number" min="1990" max="2100" @bind="_firstVisaFrom" /></label>
                        <label>@L("FirstVisaTo")<input type="number" min="1990" max="2100" @bind="_firstVisaTo" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("LastVisaFrom")<input type="number" min="1990" max="2100" @bind="_lastVisaFrom" /></label>
                        <label>@L("LastVisaTo")<input type="number" min="1990" max="2100" @bind="_lastVisaTo" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("CoveredFrom")<input type="number" min="1990" max="2100" @bind="_coveredFrom" /></label>
                        <label>@L("CoveredTo")<input type="number" min="1990" max="2100" @bind="_coveredTo" /></label>
                    </div>
                    <label>@L("AllowedGap")<input type="number" min="0" max="3650" @bind="_allowedGap" /></label>
                    <label>@L("HadGap")<EmployeeSearchYesNo @bind-Value="_hadGap" Label="@L("HadGap")" /></label>
                    <label>@L("GapDays")<input type="number" min="0" max="3650" @bind="_gapDays" /></label>
                    <label>@L("VisaNumber")<input @bind="_visaNumber" /></label>
                    <label>@L("VisaType")
                        <EmployeeSearchMultiSelect Options="VisaTypes" @bind-Value="_visaType" FieldName="visa type" ResetKey="@PickerKey("visaType")" />
                    </label>
                    <label>@L("VisaCategory")
                        <EmployeeSearchMultiSelect Options="VisaCategories" @bind-Value="_visaCategory" FieldName="visa category" ResetKey="@PickerKey("visaCategory")" />
                    </label>
                    <label>@L("IssuedPlace")
                        <EmployeeSearchMultiSelect Options="VisaPlaces" @bind-Value="_visaPlace" FieldName="issued place" ResetKey="@PickerKey("visaPlace")" />
                    </label>
                    <label>@L("Extended")<EmployeeSearchYesNo @bind-Value="_visaExtended" Label="@L("Extended")" /></label>
                    <label>@L("ExtensionRequired")<EmployeeSearchYesNo @bind-Value="_extensionRequired" Label="@L("ExtensionRequired")" /></label>
                    <label>@L("Registration")<input @bind="_registration" /></label>
                    <label>@L("VisaBorder")<input @bind="_visaBorder" /></label>
                    <div class="esearch__pair">
                        <label>@L("StayFrom")<input type="number" min="0" max="3660" @bind="_stayFrom" /></label>
                        <label>@L("StayTo")<input type="number" min="0" max="3660" @bind="_stayTo" /></label>
                    </div>
                    <label>@L("StayYear")<input type="number" min="1990" max="2100" @bind="_stayYear" /></label>
                </section>
                }

                @if (_openGroup == 9)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Passport")</h2>
                    <label>@L("PassportNumber")<input @bind="_passport" /></label>
                    <label class="esearch__check"><input type="checkbox" @bind="_passportCurrent" /> @L("CurrentPassport")</label>
                    <label>@L("PassportType")
                        <EmployeeSearchMultiSelect Options="PassportTypes" @bind-Value="_passportType" FieldName="passport type" ResetKey="@PickerKey("passportType")" />
                    </label>
                    <label>@L("IssuedCountry")
                        <EmployeeSearchMultiSelect Options="Countries" @bind-Value="_passportCountry" FieldName="issued country" ResetKey="@PickerKey("passportCountry")" />
                    </label>
                    <div class="esearch__pair">
                        <label>@L("IssuedFrom")<OfficerDateEdit @bind-Date="_passportIssuedFrom" CssClass="esearch__date" /></label>
                        <label>@L("IssuedTo")<OfficerDateEdit @bind-Date="_passportIssuedTo" CssClass="esearch__date" /></label>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("ExpiresFrom")<OfficerDateEdit @bind-Date="_passportExpiresFrom" CssClass="esearch__date" /></label>
                        <label>@L("ExpiresTo")<OfficerDateEdit @bind-Date="_passportExpiresTo" CssClass="esearch__date" /></label>
                    </div>
                    <label>@L("Expired")<EmployeeSearchYesNo @bind-Value="_passportExpired" Label="@L("Expired")" /></label>
                    <label>@L("ExpiringDays")<input type="number" min="1" max="3650" @bind="_passportExpiringDays" /></label>
                    <label>@L("Cancelled")<EmployeeSearchYesNo @bind-Value="_passportCancelled" Label="@L("Cancelled")" /></label>
                    <label>@L("SeveralPassports")<EmployeeSearchYesNo @bind-Value="_severalPassports" Label="@L("SeveralPassports")" /></label>
                </section>
                }

                @if (_openGroup == 10)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Invitation")</h2>
                    <div class="esearch__switch esearch__switch--4" role="group" aria-label="@L("Aria.Invitation")">
                        <button type="button" class="@SwitchClass(_invitationMode == "")" @onclick='() => _invitationMode = ""'>@L("Any")</button>
                        <button type="button" class="@SwitchClass(_invitationMode == "ever")" @onclick='() => _invitationMode = "ever"'>@L("Ever")</button>
                        <button type="button" class="@SwitchClass(_invitationMode == "unused")" @onclick='() => _invitationMode = "unused"'>@L("Unused")</button>
                        <button type="button" class="@SwitchClass(_invitationMode == "used")" @onclick='() => _invitationMode = "used"'>@L("Used")</button>
                    </div>
                    <label>@L("InvitationNumber")<input @bind="_invitation" /></label>
                    <div class="esearch__pair">
                        <label>@L("IssuedYearFrom")<input type="number" min="1990" max="2100" @bind="_invitationYearFrom" /></label>
                        <label>@L("IssuedYearTo")<input type="number" min="1990" max="2100" @bind="_invitationYearTo" /></label>
                    </div>
                    <label>@L("VisaCategory")
                        <EmployeeSearchMultiSelect Options="VisaCategories" @bind-Value="_invitationCategory" FieldName="invitation category" ResetKey="@PickerKey("invitationCategory")" />
                    </label>
                    <label>@L("VisaPeriod")
                        <EmployeeSearchMultiSelect Options="VisaPeriods" @bind-Value="_invitationPeriod" FieldName="visa period" ResetKey="@PickerKey("invitationPeriod")" />
                    </label>
                    <label>@L("StillValidOn")<OfficerDateEdit @bind-Date="_invitationValidOn" CssClass="esearch__date" /></label>
                    <label>@L("InvitationExpired")<EmployeeSearchYesNo @bind-Value="_invitationExpiredNoVisa" Label="@L("InvitationExpired")" /></label>
                    <label>@L("Cancelled")<EmployeeSearchYesNo @bind-Value="_invitationCancelled" Label="@L("Cancelled")" /></label>
                </section>
                }

                @if (_openGroup == 11)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Permit")</h2>
                    <div class="esearch__switch esearch__switch--3" role="group" aria-label="@L("Aria.Permit")">
                        <button type="button" class="@SwitchClass(_permitMode == "")" @onclick='() => _permitMode = ""'>@L("Any")</button>
                        <button type="button" class="@SwitchClass(_permitMode == "ever")" @onclick='() => _permitMode = "ever"'>@L("Ever")</button>
                        <button type="button" class="@SwitchClass(_permitMode == "current")" @onclick='() => _permitMode = "current"'>@L("Current")</button>
                    </div>
                    <label>@L("PermitNumber")<input @bind="_permit" /></label>
                    <label>@L("AsNumber")<input @bind="_asNumber" /></label>
                    <div class="esearch__pair">
                        <label>@L("VisaYearFrom")<input type="number" min="1990" max="2100" @bind="_permitYearFrom" /></label>
                        <label>@L("YearTo")<input type="number" min="1990" max="2100" @bind="_permitYearTo" /></label>
                    </div>
                    <label>@L("PermitLocations")
                        <EmployeeSearchMultiSelect Options="WorkLocations" @bind-Value="_permitLocations" FieldName="work location" ResetKey="@PickerKey("permitLocation")" />
                    </label>
                    <label>@L("PermitPosition")
                        <EmployeeSearchMultiSelect Options="Positions" @bind-Value="_permitPosition" FieldName="permit position" ResetKey="@PickerKey("permitPosition")" />
                    </label>
                    <label>@L("Extended")<EmployeeSearchYesNo @bind-Value="_permitExtended" Label="@L("Extended")" /></label>
                </section>
                }

                @if (_openGroup == 12)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Address")</h2>
                    <label>@L("ResidenceType")
                        <EmployeeSearchMultiSelect Options="ResidenceOptions" @bind-Value="_residence" FieldName="residence type" ResetKey="@PickerKey("residence")" />
                    </label>
                    <label>@L("Region")
                        <EmployeeSearchMultiSelect Options="Regions" @bind-Value="_region" FieldName="region" ResetKey="@PickerKey("region")" />
                    </label>
                    <label>@L("City")
                        <EmployeeSearchMultiSelect Options="Cities" @bind-Value="_city" FieldName="city" ResetKey="@PickerKey("city")" />
                    </label>
                    <label>@L("Lodging")
                        <EmployeeSearchMultiSelect Options="Lodgings" @bind-Value="_lodging" FieldName="lodging" ResetKey="@PickerKey("lodging")" />
                    </label>
                    <label>@L("Hotel")
                        <EmployeeSearchMultiSelect Options="Hotels" @bind-Value="_hotel" FieldName="hotel" ResetKey="@PickerKey("hotel")" />
                    </label>
                    <label>@L("Hospital")
                        <EmployeeSearchMultiSelect Options="Hospitals" @bind-Value="_hospital" FieldName="hospital" ResetKey="@PickerKey("hospital")" />
                    </label>
                    <label>@L("OtherSite")
                        <EmployeeSearchMultiSelect Options="OtherSites" @bind-Value="_otherSite" FieldName="other site" ResetKey="@PickerKey("otherSite")" />
                    </label>
                    <label>@L("AddressText")<input @bind="_addressText" /></label>
                    <label>@L("AddressExpired")<EmployeeSearchYesNo @bind-Value="_addressExpiredDuringVisa" Label="@L("AddressExpired")" /></label>
                </section>
                }

                @if (_openGroup == 13)
                {
                <section class="esearch__card">
                    <h2>@L("Group.Border")</h2>
                    <div class="esearch__switch esearch__switch--3" role="group" aria-label="@L("Aria.Border")">
                        <button type="button" class="@SwitchClass(_borderMode == "")" @onclick='() => _borderMode = ""'>@L("Any")</button>
                        <button type="button" class="@SwitchClass(_borderMode == "ever")" @onclick='() => _borderMode = "ever"'>@L("Ever")</button>
                        <button type="button" class="@SwitchClass(_borderMode == "current")" @onclick='() => _borderMode = "current"'>@L("Current")</button>
                    </div>
                    <div class="esearch__pair">
                        <label>@L("BorderYearFrom")<input type="number" min="1990" max="2100" @bind="_borderYearFrom" /></label>
                        <label>@L("YearTo")<input type="number" min="1990" max="2100" @bind="_borderYearTo" /></label>
                    </div>
                    <label>@L("BorderNumber")<input @bind="_borderNumber" /></label>
                    <label>@L("BorderPlace")<input @bind="_borderPlace" /></label>
                    <label>@L("Rejected")<EmployeeSearchYesNo @bind-Value="_rejected" Label="@L("Rejected")" /></label>
                    <label>@L("RejectedYear")<input type="number" min="1990" max="2100" @bind="_rejectedYear" /></label>
                    <label>@L("MedicalOnFile")<EmployeeSearchYesNo @bind-Value="_medical" Label="@L("MedicalOnFile")" /></label>
                    <label>@L("MedicalNumber")<input @bind="_medicalNumber" /></label>
                    <div class="esearch__pair">
                        <label>@L("MedicalYearFrom")<input type="number" min="1990" max="2100" @bind="_medicalYearFrom" /></label>
                        <label>@L("MedicalYearTo")<input type="number" min="1990" max="2100" @bind="_medicalYearTo" /></label>
                    </div>
                    <label>@L("MedicalOn")<OfficerDateEdit @bind-Date="_medicalOn" CssClass="esearch__date" /></label>
                    <label>@L("MedicalExpired")<EmployeeSearchYesNo @bind-Value="_medicalExpiredDuringVisa" Label="@L("MedicalExpired")" /></label>
                </section>
                }
            </div>
        </form>
    }
    else
    {
        <header class="esearch__head">
            <div>
                <h1 class="esearch__title">@L("Title")</h1>
                <p class="esearch__sub">@CountLabel</p>
            </div>
            <div class="esearch__actions">
                <button type="button" class="esearch__btn" @onclick="OpenColumns">@L("Columns")</button>
                <button type="button" class="esearch__btn" disabled="@(IsBusy || Rows.Count == 0)" @onclick="ExportExcelAsync">@L("OpenInExcel")</button>
                <button type="button" class="esearch__btn" @onclick="() => EditCriteriaRequested.InvokeAsync()">@L("EditCriteria")</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <p class="@(IsStatusError ? "esearch__error" : "esearch__hint")" role="status">@StatusMessage</p>
        }

        @if (_chips.Count > 0)
        {
            <div class="esearch__chips esearch__chips--bar">
                @foreach (var chip in _chips)
                {
                    <button type="button" class="esearch__chip" @onclick="() => RemoveChip(chip.Key)">@chip.Label</button>
                }
            </div>
        }

        @if (Truncated)
        {
            <p class="esearch__hint">@F("Truncated", EmployeeSearchService.ResultLimit, Total)</p>
        }

        <div class="esearch__split @(Selected == null ? "" : "esearch__split--open")">
            <div class="esearch__table-wrap">
                @if (Rows.Count == 0)
                {
                    <p class="esearch__empty">@L("Empty")</p>
                }
                else
                {
                    <table class="esearch__table">
                        <thead>
                            <tr>
                                @foreach (var column in VisibleColumns)
                                {
                                    <th>@column.Caption</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Rows)
                            {
                                <tr class="@(row.PersonId == _selectedId ? "is-selected" : "")" @onclick="() => Select(row.PersonId)">
                                    @foreach (var column in VisibleColumns)
                                    {
                                        <td class="@(column.Key == "WhyMatched" ? "esearch__why-cell" : null)">
                                            @if (column.Key == "WhyMatched")
                                            {
                                                @foreach (var pill in row.Pills)
                                                {
                                                    <span class="esearch__pill">@pill</span>
                                                }
                                            }
                                            else if (column.Key == "Visa")
                                            {
                                                <span class="esearch__visa esearch__visa--@row.VisaStatus.ToLowerInvariant()">@VisaLabel(row.VisaStatus)</span>
                                            }
                                            else
                                            {
                                                @Cell(row, column.Key)
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (Selected != null)
            {
                <aside class="esearch__why">
                    <header>
                        <h2>@F("WhyMatched", FirstNameOf(Selected))</h2>
                        <button type="button" class="esearch__btn" @onclick="() => _selectedId = null">@L("Close")</button>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.VisaLine))
                    {
                        <section class="esearch__fact"><h3>@L("Stay")</h3><p>@Selected.Detail.VisaLine</p></section>
                    }
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.PositionLine))
                    {
                        <section class="esearch__fact"><h3>@L("Work")</h3><p>@Selected.Detail.PositionLine</p></section>
                    }
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.EarlierPositionLine))
                    {
                        <p class="esearch__earlier">@Selected.Detail.EarlierPositionLine</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.ContractLine))
                    {
                        <section class="esearch__fact"><h3>@L("Column.Contract")</h3><p>@Selected.Detail.ContractLine</p></section>
                    }
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.EducationLine))
                    {
                        <section class="esearch__fact"><h3>@L("Education")</h3><p>@Selected.Detail.EducationLine</p></section>
                    }
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.EducationNote))
                    {
                        <p class="esearch__note">@Selected.Detail.EducationNote</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Selected.Detail.MoreLine))
                    {
                        <section class="esearch__fact"><h3>@L("Also")</h3><p>@Selected.Detail.MoreLine</p></section>
                    }
                    <div class="esearch__why-actions">
                        <button type="button" class="esearch__btn esearch__btn--primary" @onclick="() => OpenDossierRequested.InvokeAsync(Selected.PersonId)">@L("OpenDossier")</button>
                        <button type="button" class="esearch__btn" @onclick="() => _selectedId = null">@L("BackToResults")</button>
                    </div>
                </aside>
            }
        </div>
        @if (_columnsOpen)
        {
            <div class="esearch-cols-backdrop" @onclick="CloseColumns"></div>
            <div class="esearch-cols-dialog" role="dialog" aria-modal="true" aria-label="@L("ColumnsTitle")">
                <div class="esearch-cols-title">@L("ColumnsTitle")</div>
                <p class="esearch-cols-hint">@L("ColumnsHint")</p>
                @if (!string.IsNullOrWhiteSpace(_columnsError))
                {
                    <p class="esearch__error" role="status">@_columnsError</p>
                }
                <div class="esearch-cols-list">
                    @for (var columnIndex = 0; columnIndex < _columns.Count; columnIndex++)
                    {
                        var item = _columns[columnIndex];
                        var index = columnIndex;
                        <div @key="item.Key"
                             class="esearch-cols-row @(_columnDragFrom == index ? "is-dragging" : null) @(_columnDragOver == index ? "is-over" : null)"
                             @ondragenter="() => OnColumnDragEnter(index)"
                             @ondragover="OnColumnDragOver"
                             @ondragover:preventDefault
                             @ondrop="() => OnColumnDrop(index)"
                             @ondrop:preventDefault>
                            <span class="esearch-cols-handle"
                                  draggable="true"
                                  aria-hidden="true"
                                  @ondragstart="() => OnColumnDragStart(index)"
                                  @ondragend="OnColumnDragEnd">::</span>
                            <label class="esearch-cols-check">
                                <input type="checkbox" @bind="item.Included" @bind:after="SaveColumns" />
                                <span>@item.Caption</span>
                            </label>
                        </div>
                    }
                </div>
                <div class="esearch-cols-actions">
                    <button type="button" class="esearch__btn" @onclick="CloseColumns">@L("Close")</button>
                </div>
            </div>
        }
    }
</div>

