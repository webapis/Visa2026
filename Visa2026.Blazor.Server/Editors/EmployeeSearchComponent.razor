    [Parameter] public EventCallback<Guid> OpenDossierRequested { get; set; }

    [Inject] private IFileDownloader FileDownloader { get; set; } = null!;

    private async Task ExportExcelAsync()
    {
        if (IsBusy || Rows.Count == 0 || FileDownloader == null)
            return;

        var notes = new List<string>();
        if (_chips.Count > 0)
            notes.Add(string.Join(" · ", _chips.Select(chip => chip.Label)));
        if (Truncated)
            notes.Add(F("Truncated", EmployeeSearchService.ResultLimit, Total));

        var bytes = EmployeeSearchExcel.Build(Rows, VisibleColumns, notes);
        var fileName = SafeFileName(L("Title")) + " " + DateTime.Today.ToString("yyyy-MM-dd") + ".xlsx";
        await using var stream = new MemoryStream(bytes);
        await FileDownloader.DownloadAsync(fileName, stream, EmployeeSearchExcel.ContentType);
    }

    private static string SafeFileName(string name)
    {
        var cleaned = new string((name ?? string.Empty).Select(ch => Path.GetInvalidFileNameChars().Contains(ch) ? ' ' : ch).ToArray()).Trim();
        return string.IsNullOrEmpty(cleaned) ? "Find employees" : cleaned;
    }

    private bool _columnsOpen;
    private bool _wasShowingResults;
    private string _columnsError;
    private int _columnDragFrom = -1;
    private int _columnDragOver = -1;
    private readonly List<EmployeeSearchColumnState> _columns = new();

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; }

    private IReadOnlyList<EmployeeSearchColumnState> VisibleColumns =>
        (_columns.Count == 0 ? EmployeeSearchColumns.Defaults() : _columns).Where(column => column.Included).ToList();

    protected override void OnParametersSet()
    {
        if (ShowResults && !_wasShowingResults)
            ReloadColumns();
        _wasShowingResults = ShowResults;
    }

    private void OpenColumns()
    {
        ReloadColumns();
        _columnDragFrom = -1;
        _columnDragOver = -1;
        _columnsOpen = true;
    }

    private void CloseColumns()
    {
        _columnsOpen = false;
        _columnDragFrom = -1;
        _columnDragOver = -1;
    }

    private void ReloadColumns()
    {
        _columnsError = null;
        try
        {
            if (ObjectSpaceFactory == null)
            {
                ReplaceColumns(EmployeeSearchColumns.Defaults());
                return;
            }

            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<EmployeeSearchColumnSettings>();
            ReplaceColumns(EmployeeSearchColumns.Resolve(objectSpace));
        }
        catch (Exception ex)
        {
            _columnsError = ex.Message;
            if (_columns.Count == 0)
                ReplaceColumns(EmployeeSearchColumns.Defaults());
        }
    }

    private void ReplaceColumns(IReadOnlyList<EmployeeSearchColumnState> columns)
    {
        _columns.Clear();
        _columns.AddRange(columns);
    }

    private void OnColumnDragStart(int index)
    {
        _columnDragFrom = index;
        _columnDragOver = -1;
    }

    private void OnColumnDragEnter(int index)
    {
        if (_columnDragFrom >= 0 && _columnDragFrom != index)
            _columnDragOver = index;
    }

    private void OnColumnDragOver(DragEventArgs _)
    {
    }

    private void OnColumnDragEnd()
    {
        _columnDragOver = -1;
        var from = _columnDragFrom;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(100);
            if (_columnDragFrom == from)
                _columnDragFrom = -1;
            StateHasChanged();
        });
    }

    private void OnColumnDrop(int toIndex)
    {
        var fromIndex = _columnDragFrom;
        _columnDragFrom = -1;
        _columnDragOver = -1;
        if (fromIndex < 0 || fromIndex == toIndex || fromIndex >= _columns.Count || toIndex < 0 || toIndex >= _columns.Count)
            return;

        var item = _columns[fromIndex];
        _columns.RemoveAt(fromIndex);
        if (fromIndex < toIndex)
            toIndex--;
        _columns.Insert(toIndex, item);
        SaveColumns();
    }

    private void SaveColumns()
    {
        _columnsError = null;
        if (_columns.Count > 0 && !_columns.Any(column => column.Included))
            _columns[0].Included = true;

        try
        {
            if (ObjectSpaceFactory == null)
            {
                _columnsError = "Column settings could not be saved.";
                return;
            }

            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<EmployeeSearchColumnSettings>();
            EmployeeSearchColumns.Save(objectSpace, _columns);
        }
        catch (Exception ex)
        {
            _columnsError = ex.Message;
        }
    }

