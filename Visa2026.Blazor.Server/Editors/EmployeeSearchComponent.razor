    private List<SetChip> SetCriteria()
    {
        var set = new List<SetChip>();
        foreach (var chip in BuildChips())
        {
            if (!ChipGroups.TryGetValue(chip.Key, out var group) || string.IsNullOrWhiteSpace(chip.Label))
                continue;

            var tab = SearchTabs.FirstOrDefault(item => item.Id == group);
            set.Add(new SetChip(group, string.IsNullOrEmpty(tab.Label) ? "Tab.Name" : tab.Label, chip.Label));
        }

        return set;
    }

