        AddLookupChip(chips, "visaCategory", _visaCategory);
        AddLookupChip(chips, "visaPlace", _visaPlace);
        Tri(chips, "extended", _visaExtended, "Extended");
        Tri(chips, "extensionRequired", _extensionRequired, "ExtensionRequired");
        Text(chips, "registration", _registration, "Registration");
        Text(chips, "visaBorder", _visaBorder, "VisaBorder");
        if (_stayFrom != null || _stayTo != null || _stayYear != null) chips.Add(new Chip("stay", L("Chip.Stay")));
        Text(chips, "passport", _passport, "Pill.Passport");
        if (_passportCurrent) chips.Add(new Chip("passport", L("Chip.CurrentPassport")));
        AddLookupChip(chips, "passportType", _passportType);
        AddLookupChip(chips, "passportCountry", _passportCountry);
        if (_passportIssuedFrom != null || _passportIssuedTo != null) chips.Add(new Chip("passportIssued", L("Chip.PassportIssued")));
        if (_passportExpiresFrom != null || _passportExpiresTo != null) chips.Add(new Chip("passportExpires", L("Chip.PassportExpires")));
        Tri(chips, "passportExpired", _passportExpired, "Expired");
        Tri(chips, "passportCancelled", _passportCancelled, "Cancelled");
        Tri(chips, "severalPassports", _severalPassports, "SeveralPassports");
        if (!string.IsNullOrEmpty(_invitationMode)) chips.Add(new Chip("invitationMode", F("Chip.Mode", L("Pill.Invitation"), ModeLabel(_invitationMode))));
        Text(chips, "invitation", _invitation, "Pill.Invitation");
        if (_invitationYearFrom != null || _invitationYearTo != null) chips.Add(new Chip("invitationYear", L("Chip.InvitationYear")));
        AddLookupChip(chips, "invitationCategory", _invitationCategory);
        AddLookupChip(chips, "invitationPeriod", _invitationPeriod);
        if (_invitationValidOn != null) chips.Add(new Chip("invitationOn", L("Chip.InvitationOn")));
        Tri(chips, "invitationExpired", _invitationExpiredNoVisa, "InvitationExpired");
        Tri(chips, "invitationCancelled", _invitationCancelled, "Cancelled");
        if (!string.IsNullOrEmpty(_permitMode)) chips.Add(new Chip("permitMode", F("Chip.Mode", L("Pill.Permit"), ModeLabel(_permitMode))));
        Text(chips, "permit", _permit, "Pill.Permit");
        Text(chips, "asNumber", _asNumber, "AsNumber");
        if (_permitYearFrom != null || _permitYearTo != null) chips.Add(new Chip("permitYear", L("Chip.PermitYears")));
        AddLookupChip(chips, "permitLocation", _permitLocations);
        AddLookupChip(chips, "permitPosition", _permitPosition);
        Tri(chips, "permitExtended", _permitExtended, "Extended");
        AddLookupChip(chips, "residence", _residence, ResidenceOptions);
        AddLookupChip(chips, "region", _region);
        AddLookupChip(chips, "city", _city);
        AddLookupChip(chips, "lodging", _lodging);
        AddLookupChip(chips, "hotel", _hotel);
        AddLookupChip(chips, "hospital", _hospital);
        AddLookupChip(chips, "otherSite", _otherSite);
        Text(chips, "address", _addressText, "Pill.Address");
        Tri(chips, "addressExpired", _addressExpiredDuringVisa, "AddressExpired");
        if (!string.IsNullOrEmpty(_borderMode)) chips.Add(new Chip("borderMode", F("Chip.Mode", L("Aria.Border"), ModeLabel(_borderMode))));
        if (_borderYearFrom != null || _borderYearTo != null) chips.Add(new Chip("borderYear", L("Chip.BorderYears")));
        Text(chips, "borderNumber", _borderNumber, "Aria.Border");
        Text(chips, "borderPlace", _borderPlace, "BorderPlace");
        Tri(chips, "rejected", _rejected, "Rejected");
        Tri(chips, "medical", _medical, "MedicalOnFile");
        Text(chips, "medicalNumber", _medicalNumber, "Pill.Medical");
        if (_medicalYearFrom != null || _medicalYearTo != null) chips.Add(new Chip("medicalYear", L("Chip.MedicalYear")));
        if (_medicalOn != null) chips.Add(new Chip("medicalOn", L("Chip.MedicalOn")));
        Tri(chips, "medicalExpired", _medicalExpiredDuringVisa, "MedicalExpired");
        return chips;
    }

    private static void Text(List<Chip> chips, string key, string value, string labelKey)
    {
        if (!string.IsNullOrWhiteSpace(value))
            chips.Add(new Chip(key, L(labelKey) + " " + value.Trim()));
    }

    private static void Tri(List<Chip> chips, string key, bool? value, string labelKey)
    {
        if (value == true) chips.Add(new Chip(key, L(labelKey) + ": " + L("Yes")));
        else if (value == false) chips.Add(new Chip(key, L(labelKey) + ": " + L("No")));
    }

    private static List<string> Labels(string stored) =>
        CaseLocationAutocomplete.ParseChips(stored, string.Empty).ToList();

    private static void AddLookupChip(List<Chip> chips, string key, string stored, IReadOnlyList<EmployeeSearchLookupOption> keyed = null)
    {
        var parts = CaseLocationAutocomplete.ParseChips(stored, string.Empty).Select(part =>
        {
            var match = keyed?.FirstOrDefault(option => string.Equals(option.Key, part, StringComparison.Ordinal));
            return string.IsNullOrEmpty(match?.Caption) ? part : match.Caption;
        });
        var label = string.Join(" " + L("Or") + " ", parts);
        if (!string.IsNullOrWhiteSpace(label))
            chips.Add(new Chip(key, label));
    }

    private static List<Guid> Resolve(string stored, IReadOnlyList<EmployeeSearchLookupOption> options)
    {
        var ids = new List<Guid>();
        foreach (var label in CaseLocationAutocomplete.ParseChips(stored, string.Empty))
        {
            var key = CaseLocationAutocomplete.FoldKey(label);
            foreach (var option in options)
            {
                if (string.Equals(CaseLocationAutocomplete.FoldKey(option.Caption), key, StringComparison.Ordinal))
                    ids.Add(option.Id);
            }
        }

        return ids.Distinct().ToList();
    }

    private static string L(string key) => EmployeeSearchText.Get(key);
    private static string F(string key, params object[] args) => EmployeeSearchText.Format(key, args);

    private static string ModeLabel(string mode) => mode switch
    {
        "ever" => L("Ever"),
        "unused" => L("Unused"),
        "used" => L("Used"),
        "current" => L("Current"),
        _ => mode,
    };

    private static string SwitchClass(bool selected) => selected ? "is-selected" : string.Empty;

    private static string VisaLabel(string status) => status switch
    {
        "Valid" => L("Visa.Valid"),
        "Expiring" => L("Visa.Expiring"),
        "Expired" => L("Visa.Expired"),
        _ => L("Visa.None"),
    };

    private static string FirstNameOf(EmployeeSearchRow row)
    {
        var name = row.FullName?.Trim();
        if (string.IsNullOrEmpty(name))
            return L("ThisEmployee");
        var space = name.IndexOf(' ');
        return space < 0 ? name : name[..space];
    }

    private void Select(Guid personId) => _selectedId = _selectedId == personId ? null : personId;

    private sealed record Chip(string Key, string Label);
}
