@using System.Collections.Generic
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.PreviewSlot

<div class="ct-prog-detail ct-step-correct">
    <dl class="ct-meta">
        <div>
            <dt>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.CurrentState")</dt>
            <dd>
                <span class="os-status os-status--process">
                    @ApplicationProfileLocalization.ProgressStatusWithProcessNumber(
                        StepText(string.IsNullOrWhiteSpace(Step.CurrentStateLabel) ? Step.Label : Step.CurrentStateLabel),
                        Step.ProcessNumber)
                </span>
            </dd>
        </div>
        <div>
            <dt>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.StartedOn")</dt>
            <dd>@(string.IsNullOrWhiteSpace(Step.Date) ? "—" : Step.Date)</dd>
        </div>
        <div>
            <dt>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SlaTarget")</dt>
            <dd>@(string.IsNullOrWhiteSpace(Step.SlaTargetDate) ? "—" : Step.SlaTargetDate)</dd>
        </div>
    </dl>

    <div class="ct-prog-advance" style="margin-top:16px;padding-top:12px;border-top:1px solid var(--os-line)">
        @if (Step.CanCorrectDate && Step.DateProgressId is Guid)
        {
            <label class="ct-label @(IsDateInvalid ? "ct-label--error" : null)" for="step-date-@Step.Key">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Date")</label>
            <OfficerDateEdit InputId="@($"step-date-{Step.Key}")"
                             @bind-Date="_date"
                             CssClass="@(IsDateInvalid ? "ct-prog-date is-invalid" : "ct-prog-date")"
                             Enabled="@(!Busy)" />
            @if (IsDateInvalid && !string.IsNullOrWhiteSpace(DateError))
            {
                <p class="ct-field-error" role="alert">@DateError</p>
            }
        }
        @if (Step.CanEditResultNumber)
        {
            <label class="ct-label" for="step-result-@Step.Key" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ResultNumber")</label>
            <input id="step-result-@Step.Key"
                   type="text"
                   class="os-input"
                   maxlength="@ApplicationProgressResultNumberHelper.MaxLength"
                   @bind="_resultNumber"
                   @bind:event="oninput"
                   disabled="@Busy"
                   placeholder="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ResultNumberPlaceholder")" />
        }
        @if (Step.CanEditSubmissionNumber)
        {
            <label class="ct-label" for="step-number-@Step.Key" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentNumber")</label>
            <input id="step-number-@Step.Key"
                   type="text"
                   class="os-input"
                   maxlength="@ApplicationMigrationSubmission.MaxDocumentNumberLength"
                   @bind="_number"
                   @bind:event="oninput"
                   disabled="@Busy" />
        }
        @if (Step.CanEditProcessNumber)
        {
            <label class="ct-label" for="step-process-@Step.Key" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumber")</label>
            <input id="step-process-@Step.Key"
                   type="text"
                   class="os-input"
                   maxlength="@ApplicationProcessNumberHelper.MaxLength"
                   @bind="_processNumber"
                   @bind:event="oninput"
                   disabled="@Busy"
                   placeholder="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumberPlaceholder")" />
        }

        @if (Step.Files.Count > 0 || Step.CanEditFiles)
        {
            <label class="ct-label" style="margin-top:10px">@FileUploadLabel</label>
            @foreach (var file in Step.Files)
            {
                <div class="ct-step-file" title="@file.FileName">
                    <span class="ct-step-file__name">@file.FileName</span>
                    @if (Step.CanEditFiles)
                    {
                        <label class="ct-step-file__btn">
                            <InputFile OnChange="e => ReplaceAsync(e, file.FileId)" accept="@Accept" disabled="@Busy" />
                            @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ReplaceFile")
                        </label>
                        <button type="button"
                                class="ct-step-file__btn"
                                disabled="@Busy"
                                @onclick="() => RemoveAsync(file.FileId)">
                            @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RemoveFile")
                        </button>
                    }
                </div>
            }
            @if (Step.CanEditFiles)
            {
                <label class="ct-upload ct-upload--action" style="margin-top:8px">
                    <InputFile OnChange="AddAsync" accept="@Accept" multiple disabled="@Busy" />
                    <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadFile")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                </label>
            }
            @if (Step.Files.Count > 0 && FileProgressId is Guid)
            {
                <p class="ct-prog-v__letter" style="margin:8px 0 0">
                    <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                       ProgressId="FileProgressId"
                                                       FileName="@VisaUiMessages.Get("PersonDossier.Progress.ViewFile")"
                                                       LinkText="@VisaUiMessages.Get("PersonDossier.Progress.ViewFile")"
                                                       PreviewAll="true"
                                                       OwnerViewId="@OwnerViewId" />
                </p>
            }
        }

        @if (Step.CanCorrectDate || Step.CanEditSubmissionNumber || Step.CanEditResultNumber || Step.CanEditProcessNumber)
        {
            <button type="button"
                    class="os-btn os-btn--primary"
                    style="margin-top:10px"
                    disabled="@Busy"
                    @onclick="SaveAsync">
                @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SaveSubmission")
            </button>
        }
        @if (ShowRevertToHere)
        {
            <button type="button"
                    class="os-btn os-btn--ghost"
                    style="margin-top:10px;margin-left:8px"
                    disabled="@Busy"
                    @onclick="RevertAsync">
                ◀ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertToHere")
            </button>
        }
    </div>
</div>

@code {
    private const string Accept = ".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp";

    [Parameter] public ApplicationWorkspaceCaseProgressStep Step { get; set; } = new();
    [Parameter] public Guid ApplicationProfileInstanceId { get; set; }
    [Parameter] public string OwnerViewId { get; set; } = string.Empty;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public int MaxUploadMb { get; set; } = 10;
    [Parameter] public bool ShowRevertToHere { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressStepCorrection> SaveRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileChange> FileChangeRequested { get; set; }
    [Parameter] public EventCallback RevertRequested { get; set; }

    private DateTime? _date;
    private string _number = string.Empty;
    private string _resultNumber = string.Empty;
    private string _processNumber = string.Empty;
    private string _stamp = string.Empty;
    private bool _showDateErrors;

    protected override void OnParametersSet()
    {
        var stamp = $"{Step.DateProgressId:N}:{Step.DateValue:yyyyMMdd}:{Step.SubmissionDocumentNumber}:{Step.ResultNumber}:{Step.ProcessNumber}";
        if (stamp == _stamp)
            return;

        _stamp = stamp;
        _showDateErrors = false;
        _date = Step.DateValue;
        _number = Step.SubmissionDocumentNumber ?? string.Empty;
        _resultNumber = Step.ResultNumber ?? string.Empty;
        _processNumber = Step.ProcessNumber ?? string.Empty;
    }

    private static string StepText(string? text) =>
        ApplicationProfileLocalization.ProgressStepLabel(text);

    private string? DateError
    {
        get
        {
            if (_date is not DateTime date || date == default)
                return _showDateErrors
                    ? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.DateRequired")
                    : null;

            return ApplicationProfileInstanceProgressStepDates.TryValidate(
                date,
                Step.EarliestDate,
                Step.LatestDate,
                Step.PrecedingStepLabel,
                Step.FollowingStepLabel,
                out var error)
                ? null
                : error;
        }
    }

    private bool IsDateInvalid =>
        !string.IsNullOrWhiteSpace(DateError)
        && (_showDateErrors || DateError != VisaUiMessages.Get("ApplicationProfileInstance.Workspace.DateRequired"));

    private string FileUploadLabel =>
        string.Equals(Step.Key, "office", StringComparison.OrdinalIgnoreCase)
            ? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.OfficeFile")
            : string.Equals(Step.Key, "migration", StringComparison.OrdinalIgnoreCase)
                ? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Documents")
                : VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ApprovalLetter");

    private async Task SaveAsync()
    {
        if (Busy || Step.DateProgressId is not Guid progressId)
            return;

        _showDateErrors = true;
        if (_date is not DateTime date || date == default || !string.IsNullOrWhiteSpace(DateError))
            return;

        await SaveRequested.InvokeAsync(new OfficerShellCaseProgressStepCorrection
        {
            ProgressId = progressId,
            Date = date.Date,
            SubmissionDocumentNumber = Step.CanEditSubmissionNumber ? _number : null,
            ResultNumber = Step.CanEditResultNumber ? _resultNumber : null,
            ProcessNumber = Step.CanEditProcessNumber ? _processNumber : null,
        });
    }

    private Task RevertAsync() =>
        Busy || !RevertRequested.HasDelegate
            ? Task.CompletedTask
            : RevertRequested.InvokeAsync();

    private Guid? FileProgressId =>
        Step.ProgressId is Guid progressId && progressId != Guid.Empty
            ? progressId
            : Step.DateProgressId is Guid dateId && dateId != Guid.Empty
                ? dateId
                : null;

    private async Task AddAsync(InputFileChangeEventArgs e)
    {
        if (Busy || FileProgressId is not Guid progressId)
            return;

        foreach (var file in e.GetMultipleFiles(100))
        {
            var content = await ReadAsync(file);
            if (content == null)
                continue;

            await FileChangeRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
            {
                ProgressId = progressId,
                Slot = Step.FileSlot,
                FileName = file.Name,
                Content = content,
            });
        }
    }

    private async Task ReplaceAsync(InputFileChangeEventArgs e, Guid fileId)
    {
        var file = e.File;
        if (Busy || file == null || FileProgressId is not Guid progressId)
            return;

        var content = await ReadAsync(file);
        if (content == null)
            return;

        await FileChangeRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
        {
            ProgressId = progressId,
            FileId = fileId,
            Slot = Step.FileSlot,
            FileName = file.Name,
            Content = content,
        });
    }

    private Task RemoveAsync(Guid fileId)
    {
        if (Busy || FileProgressId is not Guid progressId)
            return Task.CompletedTask;

        return FileChangeRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
        {
            ProgressId = progressId,
            FileId = fileId,
            Remove = true,
            Slot = Step.FileSlot,
        });
    }

    private async Task<byte[]?> ReadAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxUploadMb * 1024L * 1024L);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var content = memory.ToArray();
        return content.Length == 0 ? null : content;
    }
}