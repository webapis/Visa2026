@using System.Collections.Generic
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.PreviewSlot

<div class="ct-prog-detail ct-step-correct">
    <div class="ct-prog-advance">
        @if (Step.CanCorrectDate && Step.DateProgressId is Guid)
        {
            <div class="ct-prog-date-stack">
                <div class="ct-prog-date-line__field">
                    <label class="ct-label @DateLabelClass" for="step-date-@Step.Key">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Date")</label>
                    <OfficerDateEdit InputId="@($"step-date-{Step.Key}")"
                                     @bind-Date="_date"
                                     CssClass="@DateCssClass"
                                     Enabled="@(!Busy)" />
                </div>
                <button type="button"
                        class="ct-exceptional-date @(_exceptionalDate ? "is-on" : null)"
                        aria-pressed="@_exceptionalDate"
                        disabled="@Busy"
                        @onclick="ToggleExceptionalDate">
                    <span class="ct-exceptional-date__knob" aria-hidden="true"></span>
                    <span>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ExceptionalDate")</span>
                </button>
                <p class="ct-field-hint @(_exceptionalDate ? null : "ct-field-hint--muted")">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ExceptionalDateHint")</p>
                @if (IsDateInvalid && !string.IsNullOrWhiteSpace(DateError))
                {
                    <p class="ct-field-error" role="alert">@DateError</p>
                }
            </div>
        }
        @if (Step.CanEditResultNumber)
        {
            <label class="ct-label" for="step-result-@Step.Key" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ApprovalNumber")</label>
            <input id="step-result-@Step.Key"
                   type="text"
                   class="os-input"
                   maxlength="@ApplicationProgressResultNumberHelper.MaxLength"
                   @bind="_resultNumber"
                   @bind:event="oninput"
                   disabled="@Busy"
                   placeholder="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ApprovalNumber")" />
        }
        @if (Step.CanEditSubmissionNumber)
        {
            <label class="ct-label" for="step-number-@Step.Key" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentNumber")</label>
            <input id="step-number-@Step.Key"
                   type="text"
                   class="os-input"
                   maxlength="@ApplicationMigrationSubmission.MaxDocumentNumberLength"
                   @bind="_number"
                   @bind:event="oninput"
                   disabled="@Busy" />
        }
        @if (Step.CanEditProcessNumber)
        {
            <label class="ct-label" for="step-process-@Step.Key" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumber")</label>
            <input id="step-process-@Step.Key"
                   type="text"
                   class="os-input"
                   maxlength="@ApplicationProcessNumberHelper.MaxLength"
                   @bind="_processNumber"
                   @bind:event="oninput"
                   disabled="@Busy"
                   placeholder="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumberPlaceholder")" />
        }

        @if (Step.Files.Count > 0 || Step.CanEditFiles)
        {
            <div class="ct-step-files" style="margin-top:10px">
                @foreach (var file in Step.Files)
                {
                    <div class="ct-step-file" title="@file.FileName">
                        @if (FileProgressId is Guid previewProgressId)
                        {
                            <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                               ProgressId="previewProgressId"
                                                               FileId="file.FileId"
                                                               FileName="@file.FileName"
                                                               LinkText="@file.FileName"
                                                               CssClass="ct-step-file__name ct-letter-preview"
                                                               OwnerViewId="@OwnerViewId" />
                        }
                        else
                        {
                            <span class="ct-step-file__name">@file.FileName</span>
                        }
                        @if (Step.CanEditFiles)
                        {
                            <label class="ct-step-file__btn">
                                <InputFile OnChange="e => ReplaceAsync(e, file.FileId)" accept="@Accept" disabled="@Busy" />
                                @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ReplaceFile")
                            </label>
                            <button type="button"
                                    class="ct-step-file__btn ct-step-file__btn--danger"
                                    disabled="@Busy"
                                    @onclick="() => AskRemove(file.FileId, file.FileName)">
                                @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RemoveFile")
                            </button>
                        }
                    </div>
                }
                @if (Step.CanEditFiles)
                {
                    @if (Step.Files.Count > 0)
                    {
                        <label class="ct-upload ct-upload--compact">
                            <InputFile OnChange="AddAsync" accept="@Accept" multiple disabled="@Busy" />
                            <span>+ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.AddFile")
                                <span class="ct-upload__hint">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span>
                            </span>
                        </label>
                    }
                    else
                    {
                        <label class="ct-upload ct-upload--action">
                            <InputFile OnChange="AddAsync" accept="@Accept" multiple disabled="@Busy" />
                            <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadFile")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                        </label>
                    }
                }
            </div>
        }

        <div class="ct-prog-edit-actions">
            @if (CancelRequested.HasDelegate)
            {
                <button type="button"
                        class="os-btn os-btn--ghost"
                        disabled="@Busy"
                        @onclick="CancelAsync">
                    @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.CancelEdit")
                </button>
            }
            @if (Step.CanCorrectDate || Step.CanEditSubmissionNumber || Step.CanEditResultNumber || Step.CanEditProcessNumber)
            {
                <button type="button"
                        class="os-btn os-btn--primary"
                        disabled="@Busy"
                        @onclick="SaveAsync">
                    @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SaveChanges")
                </button>
            }
        </div>
        @if (ShowRevertToHere)
        {
            <button type="button"
                    class="ct-prog-revert-link"
                    disabled="@Busy"
                    @onclick="AskRevert">
                ◀ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertToHere")
            </button>
        }
    </div>
</div>

<OfficerDeleteConfirmDialog @bind-Visible="_removeConfirmVisible"
                            Title="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RemoveFileConfirmTitle")"
                            Message="@_removeConfirmMessage"
                            DeleteText="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RemoveFile")"
                            Confirmed="ConfirmRemoveAsync" />

<OfficerDeleteConfirmDialog @bind-Visible="_revertConfirmVisible"
                            Title="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertProgressConfirmTitle")"
                            Message="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertProgressConfirm")"
                            DeleteText="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertProgress")"
                            Confirmed="ConfirmRevertAsync" />

@code {
    private const string Accept = ".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp";

    [Parameter] public ApplicationWorkspaceCaseProgressStep Step { get; set; } = new();
    [Parameter] public Guid ApplicationProfileInstanceId { get; set; }
    [Parameter] public string OwnerViewId { get; set; } = string.Empty;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public int MaxUploadMb { get; set; } = 10;
    [Parameter] public bool ShowRevertToHere { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressStepCorrection> SaveRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileChange> FileChangeRequested { get; set; }
    [Parameter] public EventCallback RevertRequested { get; set; }
    [Parameter] public EventCallback CancelRequested { get; set; }

    private DateTime? _date;
    private bool _exceptionalDate;
    private string _number = string.Empty;
    private string _resultNumber = string.Empty;
    private string _processNumber = string.Empty;
    private string _stamp = string.Empty;
    private bool _showDateErrors;
    private bool _removeConfirmVisible;
    private bool _revertConfirmVisible;
    private Guid _pendingRemoveFileId;
    private string _removeConfirmMessage = string.Empty;

    protected override void OnParametersSet()
    {
        var stamp = $"{Step.DateProgressId:N}:{Step.DateValue:yyyyMMdd}:{Step.ExceptionalDate}:{Step.SubmissionDocumentNumber}:{Step.ResultNumber}:{Step.ProcessNumber}";
        if (stamp == _stamp)
            return;

        _stamp = stamp;
        _showDateErrors = false;
        _date = Step.DateValue;
        _exceptionalDate = Step.ExceptionalDate;
        _number = Step.SubmissionDocumentNumber ?? string.Empty;
        _resultNumber = Step.ResultNumber ?? string.Empty;
        _processNumber = Step.ProcessNumber ?? string.Empty;
    }

    private string? DateError
    {
        get
        {
            if (_date is not DateTime date || date == default)
                return _showDateErrors
                    ? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.DateRequired")
                    : null;

            if (_exceptionalDate)
                return null;

            return ApplicationProfileInstanceProgressStepDates.TryValidate(
                date,
                Step.EarliestDate,
                Step.LatestDate,
                Step.PrecedingStepLabel,
                Step.FollowingStepLabel,
                out var error)
                ? null
                : error;
        }
    }

    private bool DateBreaksOrder
    {
        get
        {
            if (_date is not DateTime date || date == default)
                return false;

            return !ApplicationProfileInstanceProgressStepDates.TryValidate(
                date,
                Step.EarliestDate,
                Step.LatestDate,
                Step.PrecedingStepLabel,
                Step.FollowingStepLabel,
                out _);
        }
    }

    private bool ShowExceptionalChrome => _exceptionalDate && DateBreaksOrder;

    private string DateCssClass =>
        IsDateInvalid ? "ct-prog-date is-invalid"
        : ShowExceptionalChrome ? "ct-prog-date is-exceptional"
        : "ct-prog-date";

    private string? DateLabelClass =>
        IsDateInvalid ? "ct-label--error"
        : ShowExceptionalChrome ? "ct-label--exceptional"
        : null;

    private void ToggleExceptionalDate() => _exceptionalDate = !_exceptionalDate;

    private bool IsDateInvalid =>
        !string.IsNullOrWhiteSpace(DateError)
        && (_showDateErrors || DateError != VisaUiMessages.Get("ApplicationProfileInstance.Workspace.DateRequired"));

    private Guid? FileProgressId =>
        Step.ProgressId is Guid progressId && progressId != Guid.Empty
            ? progressId
            : Step.DateProgressId is Guid dateId && dateId != Guid.Empty
                ? dateId
                : null;

    private Task CancelAsync() =>
        CancelRequested.HasDelegate ? CancelRequested.InvokeAsync() : Task.CompletedTask;

    private async Task SaveAsync()
    {
        if (Busy || Step.DateProgressId is not Guid progressId)
            return;

        _showDateErrors = true;
        if (_date is not DateTime date || date == default || !string.IsNullOrWhiteSpace(DateError))
            return;

        await SaveRequested.InvokeAsync(new OfficerShellCaseProgressStepCorrection
        {
            ProgressId = progressId,
            Date = date.Date,
            SubmissionDocumentNumber = Step.CanEditSubmissionNumber ? _number : null,
            ResultNumber = Step.CanEditResultNumber ? _resultNumber : null,
            ProcessNumber = Step.CanEditProcessNumber ? _processNumber : null,
            ExceptionalDate = _exceptionalDate,
        });
    }

    private void AskRevert() => _revertConfirmVisible = true;

    private Task ConfirmRevertAsync() =>
        Busy || !RevertRequested.HasDelegate
            ? Task.CompletedTask
            : RevertRequested.InvokeAsync();

    private void AskRemove(Guid fileId, string? fileName)
    {
        _pendingRemoveFileId = fileId;
        _removeConfirmMessage = VisaUiMessages.Format(
            "ApplicationProfileInstance.Workspace.RemoveFileConfirm",
            string.IsNullOrWhiteSpace(fileName) ? "—" : fileName);
        _removeConfirmVisible = true;
    }

    private Task ConfirmRemoveAsync()
    {
        if (Busy || FileProgressId is not Guid progressId || _pendingRemoveFileId == Guid.Empty)
            return Task.CompletedTask;

        var id = _pendingRemoveFileId;
        _pendingRemoveFileId = Guid.Empty;
        return FileChangeRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
        {
            ProgressId = progressId,
            FileId = id,
            Remove = true,
            Slot = Step.FileSlot,
        });
    }

    private async Task AddAsync(InputFileChangeEventArgs e)
    {
        if (Busy || FileProgressId is not Guid progressId)
            return;

        foreach (var file in e.GetMultipleFiles(100))
        {
            var content = await ReadAsync(file);
            if (content == null)
                continue;

            await FileChangeRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
            {
                ProgressId = progressId,
                Slot = Step.FileSlot,
                FileName = file.Name,
                Content = content,
            });
        }
    }

    private async Task ReplaceAsync(InputFileChangeEventArgs e, Guid fileId)
    {
        var file = e.File;
        if (Busy || file == null || FileProgressId is not Guid progressId)
            return;

        var content = await ReadAsync(file);
        if (content == null)
            return;

        await FileChangeRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
        {
            ProgressId = progressId,
            FileId = fileId,
            Slot = Step.FileSlot,
            FileName = file.Name,
            Content = content,
        });
    }

    private async Task<byte[]?> ReadAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxUploadMb * 1024L * 1024L);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var content = memory.ToArray();
        return content.Length == 0 ? null : content;
    }
}