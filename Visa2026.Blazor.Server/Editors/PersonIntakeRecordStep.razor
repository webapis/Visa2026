@using System.IO
@using System.Linq
@using DevExpress.Blazor
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Model
@using DevExpress.ExpressApp.Utils
@using DevExpress.Persistent.BaseImpl.EF
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.AspNetCore.Components.Rendering
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.PersonIntake
@using Visa2026.Module.Services.PreviewSlot

@{
    var deferRecord = State.PendingKeys.Contains(RecordKey);
    var hasRows = HasCards;
    EnsureDefaults();
}

<div class="person-intake-wizard__record-toolbar">
    @if (RecordKey is not PersonPendingTargets.EmployeeSalary and not PersonPendingTargets.WorkDuty)
    {
        <label class="person-intake-wizard__toggle">
            <input type="checkbox" checked="@deferRecord" disabled="@(hasRows || !Access.CanTogglePendingStep(RecordKey))"
                   @onchange="e => OnTogglePending(e.Value is true)" />
            <span>@T("NotReceivedYet")</span>
        </label>
    }
    @if (!UsesGrid && !deferRecord && CanCreate)
    {
        <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--primary"
                disabled="@(!CanAddCard)"
                @onclick="AddCard">@T("Record.AddButton")</button>
    }
</div>
@if (!deferRecord && CanCreate && UsesOneAtATime && !CanAddCard)
{
    <p class="person-intake-wizard__record-hint">@T("Record.OneAtATime")</p>
}

@if (deferRecord)
{
}
else if (UsesGrid)
{
    @if (!hasRows && RecordKey is PersonPendingTargets.EmployeeSalary or PersonPendingTargets.WorkDuty)
    {
        <p class="person-intake-wizard__record-hint">@(RecordKey == PersonPendingTargets.WorkDuty ? T("Record.WorkDutyOptional") : T("Record.SalaryOptional"))</p>
    }
    <div class="pi-lv">
        <div class="pi-lv__toolbar">
            @if (CanCreate)
            {
                <DxButton Text="@T("Grid.New")"
                          IconCssClass="pi-lv__icon pi-lv__icon--new"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          Enabled="CanAddCard"
                          Click="NewRecordAsync" />
            }
            @if (CanDeleteAny)
            {
                <DxButton Text="@T("Grid.Delete")"
                          IconCssClass="pi-lv__icon pi-lv__icon--delete"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          Enabled="CanDeleteSelection"
                          Click="() => _confirmDelete = true" />
            }
        </div>
        @if (_confirmDelete && CanDeleteSelection)
        {
            <div class="pi-lv__confirm" role="alertdialog" aria-label="@T("Grid.Delete")">
                <span>@T("Grid.DeleteConfirm")</span>
                <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--primary" @onclick="DeleteSelectedAsync">@T("Yes")</button>
                <button type="button" class="person-intake-wizard__btn" @onclick="() => _confirmDelete = false">@T("No")</button>
            </div>
        }
        <DxGrid Data="GridItems"
                KeyFieldName="CardId"
                CssClass="pi-lv__grid"
                ShowAllRows="true"
                SelectionMode="GridSelectionMode.Multiple"
                SelectedDataItems="_selected"
                SelectedDataItemsChanged="OnSelectionChanged"
                UnboundColumnData="OnUnboundColumnData"
                RowClick="OnRowClick">
            <Columns>
                <DxGridSelectionColumn Width="2.75rem" />
                @foreach (var column in GridColumns)
                {
                    <DxGridDataColumn FieldName="@column.Key"
                                      Caption="@column.Caption"
                                      UnboundType="@column.UnboundType"
                                      DisplayFormat="@column.DisplayFormat" />
                }
                @if (ShowsCopyPreview)
                {
                    <DxGridDataColumn FieldName="pi_preview"
                                      Caption="@PreviewCaption"
                                      UnboundType="GridUnboundColumnType.String"
                                      Width="6.5rem"
                                      AllowSort="false">
                        <CellDisplayTemplate>
                            @if (context.DataItem != null && HasPreviewCopies(context.DataItem))
                            {
                                <button type="button"
                                        class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                        @onclick="() => PreviewDraftAsync(context.DataItem)"
                                        @onclick:stopPropagation="true">@PreviewCaption</button>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                }
            </Columns>
        </DxGrid>
    </div>
}
else if (!hasRows)
{
    <p class="person-intake-wizard__record-hint">
        @(RecordKey == PersonPendingTargets.EmployeeSalary ? T("Record.SalaryOptional")
            : RecordKey == PersonPendingTargets.WorkDuty ? T("Record.WorkDutyOptional")
            : T("Record.Empty"))
    </p>
}
else
{
    <div class="person-intake-wizard__cards">
        @if (RecordKey == PersonPendingTargets.MedicalRecord)
        {
            @foreach (var draft in State.MedicalDrafts)
            {
                var card = draft;
                <article class="person-intake-wizard__card @(card.Expanded ? "is-expanded" : null)">
                    <div class="person-intake-wizard__card-head">
                        <span class="person-intake-wizard__card-title">@card.SummaryTitle</span>
                        <div class="person-intake-wizard__card-actions">
                            <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                    @onclick="() => ToggleExpand(card)">@(card.Expanded ? T("Card.Collapse") : T("Card.Expand"))</button>
                            @if (CanRemoveCard(card.ExistingId))
                            {
                                <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link is-danger"
                                        @onclick="() => RemoveMedical(card.CardId)">Remove</button>
                            }
                        </div>
                    </div>
                    @if (card.Expanded)
                    {
                        <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!CanEditCard(card.ExistingId))">
                            <div class="person-intake-wizard__field-row"><label>Document number</label>
                                <input class="@FilledCss(card.DocumentNumber)" @bind="card.DocumentNumber" /></div>
                            <div class="person-intake-wizard__field-row"><label>Issue date</label>
                                <OfficerDateEdit @bind-Date="card.IssueDate" CssClass="person-intake-wizard__input" /></div>
                            <div class="person-intake-wizard__field-row"><label>Validity duration</label>
                                @(RenderDraftLookup<ValidityDuration>(card.ValidityDurationId, id => card.ValidityDurationId = id))</div>
                            <div class="person-intake-wizard__field-row"><label>Expiration date</label>
                                <input class="@FilledCss(card.ExpirationDate)" disabled value="@(card.ExpirationDate?.ToString("dd.MM.yyyy") ?? string.Empty)" /></div>
                            <div class="person-intake-wizard__field-row person-intake-wizard__field-row--top person-intake-wizard__field-row--full">
                                <label>Medical copies</label>
                                <div class="person-intake-wizard__copies">
                                    <InputFile OnChange="e => OnCopiesSelected(e, card.Copies)" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" multiple />
                                    @if (card.Copies.Count > 0)
                                    {
                                        <ul class="person-intake-wizard__copy-list">
                                            @foreach (var copy in card.Copies)
                                            {
                                                var copyId = copy.Id;
                                                <li>
                                                    <span>@copy.FileName @(copy.IsExisting ? T("Files.OnFile") : null)</span>
                                                    <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                            @onclick="() => card.Copies.RemoveAll(c => c.Id == copyId)">Remove</button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="person-intake-wizard__card-summary">@(card.IssueDate?.ToString("dd.MM.yyyy") ?? T("Card.NoIssueDate")) · @PersonIntakeText.Format("Card.Scans", card.Copies.Count)</p>
                    }
                </article>
            }
        }
        else if (RecordKey == PersonPendingTargets.AddressOfResidence)
        {
            @foreach (var draft in State.ResidenceDrafts)
            {
                var card = draft;
                <article class="person-intake-wizard__card @(card.Expanded ? "is-expanded" : null)">
                    <div class="person-intake-wizard__card-head">
                        <span class="person-intake-wizard__card-title">@card.SummaryTitle</span>
                        <div class="person-intake-wizard__card-actions">
                            <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                    @onclick="() => ToggleExpand(card)">@(card.Expanded ? T("Card.Collapse") : T("Card.Expand"))</button>
                            @if (CanRemoveCard(card.ExistingId))
                            {
                                <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link is-danger"
                                        @onclick="() => RemoveResidence(card.CardId)">Remove</button>
                            }
                        </div>
                    </div>
                    @if (card.Expanded)
                    {
                        <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!CanEditCard(card.ExistingId))">
                            <div class="person-intake-wizard__field-row"><label>Type</label>
                                <select class="@FilledCss(card.Type)" value="@(card.Type?.ToString() ?? string.Empty)"
                                        @onchange="e => SetResidenceType(card, e.Value?.ToString())">
                                    @foreach (ResidenceType type in Enum.GetValues<ResidenceType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                            <div class="person-intake-wizard__field-row"><label>Region</label>
                                @(RenderDraftLookup<Region>(card.RegionId, id => card.RegionId = id))</div>
                            <div class="person-intake-wizard__field-row"><label>City</label>
                                @(RenderDraftLookup<City>(card.CityId, id => card.CityId = id))</div>
                            @if (card.Type == ResidenceType.PrivateHouse || card.Type == null)
                            {
                                <div class="person-intake-wizard__field-row person-intake-wizard__field-row--full"><label>Full address</label>
                                    <input class="@FilledCss(card.FullAddress)" @bind="card.FullAddress" /></div>
                                <div class="person-intake-wizard__field-row"><label>Expiration date</label>
                                    <OfficerDateEdit @bind-Date="card.ExpirationDate" CssClass="person-intake-wizard__input" /></div>
                            }
                            else if (card.Type == ResidenceType.Lodging)
                            {
                                <div class="person-intake-wizard__field-row"><label>Lodging</label>
                                    @(RenderDraftLookup<Lodging>(card.LodgingId, id => card.LodgingId = id))</div>
                            }
                            else if (card.Type == ResidenceType.Hotel)
                            {
                                <div class="person-intake-wizard__field-row"><label>Hotel</label>
                                    @(RenderDraftLookup<Hotel>(card.HotelId, id => card.HotelId = id))</div>
                            }
                            else if (card.Type == ResidenceType.Hospital)
                            {
                                <div class="person-intake-wizard__field-row"><label>Hospital</label>
                                    @(RenderDraftLookup<Hospital>(card.HospitalId, id => card.HospitalId = id))</div>
                            }
                            else if (card.Type == ResidenceType.Other)
                            {
                                <div class="person-intake-wizard__field-row"><label>Other site</label>
                                    @(RenderDraftLookup<OtherSite>(card.OtherSiteId, id => card.OtherSiteId = id))</div>
                            }
                            <div class="person-intake-wizard__field-row person-intake-wizard__field-row--top person-intake-wizard__field-row--full">
                                <label>Address copies</label>
                                <div class="person-intake-wizard__copies">
                                    <InputFile OnChange="e => OnCopiesSelected(e, card.Copies)" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" multiple />
                                    @if (card.Copies.Count > 0)
                                    {
                                        <ul class="person-intake-wizard__copy-list">
                                            @foreach (var copy in card.Copies)
                                            {
                                                var copyId = copy.Id;
                                                <li>
                                                    <span>@copy.FileName @(copy.IsExisting ? T("Files.OnFile") : null)</span>
                                                    <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                            @onclick="() => card.Copies.RemoveAll(c => c.Id == copyId)">Remove</button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="person-intake-wizard__card-summary">@(card.Type?.ToString() ?? "?") · @PersonIntakeText.Format("Card.Scans", card.Copies.Count)</p>
                    }
                </article>
            }
        }
        else if (RecordKey == PersonPendingTargets.PersonDocument)
        {
            @foreach (var draft in State.DocumentDrafts)
            {
                var card = draft;
                <article class="person-intake-wizard__card @(card.Expanded ? "is-expanded" : null)">
                    <div class="person-intake-wizard__card-head">
                        <span class="person-intake-wizard__card-title">@card.SummaryTitle</span>
                        <div class="person-intake-wizard__card-actions">
                            @if (PersonIntakeCopyPreview.HasPreview(card))
                            {
                                <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                        @onclick="() => PreviewPersonFileAsync(card)">@PreviewCaption</button>
                            }
                            <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                    @onclick="() => ToggleExpand(card)">@(card.Expanded ? T("Card.Collapse") : T("Card.Expand"))</button>
                            @if (CanRemoveCard(card.ExistingId))
                            {
                                <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link is-danger"
                                        @onclick="() => RemoveDocument(card.CardId)">@T("Remove")</button>
                            }
                        </div>
                    </div>
                    @if (card.Expanded)
                    {
                        <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!CanEditCard(card.ExistingId))">
                            <div class="person-intake-wizard__field-row person-intake-wizard__field-row--top person-intake-wizard__field-row--full">
                                <label>@T("Files.File")</label>
                                <div class="person-intake-wizard__copies">
                                    @if (PersonIntakeCopyPreview.HasPreview(card))
                                    {
                                        <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                @onclick="() => PreviewPersonFileAsync(card)">@card.FileName @(card.IsExisting ? T("Files.OnFile") : null)</button>
                                    }
                                    else if (card.IsExisting || !string.IsNullOrWhiteSpace(card.FileName))
                                    {
                                        <span>@card.FileName @(card.IsExisting ? T("Files.OnFile") : null)</span>
                                    }
                                    @if (!card.IsExisting)
                                    {
                                        <InputFile OnChange="e => OnDocumentFileSelected(e, card)"
                                                   accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp,.doc,.docx" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="person-intake-wizard__card-summary">@card.SummaryTitle</p>
                    }
                </article>
            }
        }
        else if (RecordKey == PersonPendingTargets.TravelHistory)
        {
            @foreach (var draft in State.TravelDrafts)
            {
                var card = draft;
                <article class="person-intake-wizard__card @(card.Expanded ? "is-expanded" : null)">
                    <div class="person-intake-wizard__card-head">
                        <span class="person-intake-wizard__card-title">@card.SummaryTitle</span>
                        <div class="person-intake-wizard__card-actions">
                            <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                    @onclick="() => ToggleExpand(card)">@(card.Expanded ? T("Card.Collapse") : T("Card.Expand"))</button>
                            @if (CanRemoveCard(card.ExistingId))
                            {
                                <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--link is-danger"
                                        @onclick="() => RemoveTravel(card.CardId)">Remove</button>
                            }
                        </div>
                    </div>
                    @if (card.Expanded)
                    {
                        <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!CanEditCard(card.ExistingId))">
                            <div class="person-intake-wizard__field-row"><label>Travel type</label>
                                <select class="@FilledCss(card.TravelType)" value="@(card.TravelType?.ToString() ?? string.Empty)"
                                        @onchange="e => SetTravelType(card, e.Value?.ToString())">
                                    <option value="">—</option>
                                    <option value="@TravelType.External">External</option>
                                    <option value="@TravelType.Internal">Internal</option>
                                </select>
                            </div>
                            <div class="person-intake-wizard__field-row"><label>Movement</label>
                                <select class="@FilledCss(card.MovementType)" value="@(card.MovementType?.ToString() ?? string.Empty)"
                                        @onchange="e => SetMovementType(card, e.Value?.ToString())">
                                    <option value="">—</option>
                                    <option value="@MovementType.Entry">Entry</option>
                                    <option value="@MovementType.Exit">Exit</option>
                                </select>
                            </div>
                            <div class="person-intake-wizard__field-row"><label>Travel date</label>
                                <OfficerDateEdit @bind-Date="card.TravelDate" CssClass="person-intake-wizard__input" /></div>
                            @if (card.TravelType == TravelType.External)
                            {
                                <div class="person-intake-wizard__field-row"><label>Check point</label>
                                    @(RenderDraftLookup<CheckPoint>(card.CheckPointId, id => card.CheckPointId = id))</div>
                                <div class="person-intake-wizard__field-row"><label>Country</label>
                                    @(RenderDraftLookup<Country>(card.CountryId, id => card.CountryId = id))</div>
                            }
                            else if (card.TravelType == TravelType.Internal)
                            {
                                <div class="person-intake-wizard__field-row"><label>Region</label>
                                    @(RenderDraftLookup<Region>(card.RegionId, id => { card.RegionId = id; card.CityId = null; }))</div>
                                <div class="person-intake-wizard__field-row"><label>City</label>
                                    @(RenderDraftLookup<City>(card.CityId, id => card.CityId = id))</div>
                            }
                            <div class="person-intake-wizard__field-row"><label>Travel notes</label>
                                <input class="@FilledCss(card.Notes)" @bind="card.Notes" /></div>
                        </div>
                    }
                    else
                    {
                        <p class="person-intake-wizard__card-summary">@(card.TravelDate?.ToString("dd.MM.yyyy") ?? T("Card.NoDate")) · @card.SummaryTitle</p>
                    }
                </article>
            }
        }
    </div>
}

@if (_editing != null)
{
    var editable = CanEditCard(ExistingIdOf(_editing));
    <div class="pi-dlg-backdrop"></div>
    <div class="pi-dlg pi-dlg--record" role="dialog" aria-modal="true" aria-label="@DialogTitle">
        <header class="pi-dlg__head">
            <h2 class="pi-dlg__title">@DialogTitle</h2>
            <button type="button" class="pi-dlg__x" aria-label="@T("Close")" @onclick="CancelEditAsync">×</button>
        </header>
        <div class="pi-dlg__body">
            @if (_editing is PersonIntakePassportDraft passport)
            {
                var card = passport;
                <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!editable)">
                    <div class="person-intake-wizard__field-row"><label>@L("PassportNumber", "Passport number")</label>
                        <input class="@FilledCss(card.PassportNumber)" @bind="card.PassportNumber" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("PassportType", "Passport type")</label>
                        @(RenderDraftLookup<PassportType>(card.PassportTypeId, id => card.PassportTypeId = id, L("PassportType", "Passport type"), PersonIntakeLookupUsage.PassportType))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("IssuedCountry", "Issued country")</label>
                        @(RenderDraftLookup<Country>(card.IssuedCountryId, id => card.IssuedCountryId = id, L("IssuedCountry", "Issued country"), PersonIntakeLookupUsage.PassportIssuedCountry))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("Authority", "Authority")</label>
                        <input class="@FilledCss(card.Authority)" @bind="card.Authority" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("IssueDate", "Issue date")</label>
                        <OfficerDateEdit @bind-Date="card.IssueDate" CssClass="person-intake-wizard__input" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("ExpirationDate", "Expiration date")</label>
                        <OfficerDateEdit @bind-Date="card.ExpirationDate" CssClass="person-intake-wizard__input" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("DaysRemaining", "Days remaining")</label>
                        <input class="@FilledCss(card.DaysRemaining)" disabled value="@(card.DaysRemaining?.ToString() ?? string.Empty)" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("IsCancelled", "Cancelled")</label>
                        <label class="person-intake-wizard__toggle"><input type="checkbox" @bind="card.IsCancelled" /><span>@L("IsCancelled", "Cancelled")</span></label></div>
                </div>
                @RenderCopies(L("Documents", "Passport copies"), card.Copies, () => PreviewCopiesAsync(card.ExistingId, card.CardId, "Passport", card.PassportNumber, typeof(PassportDocument), card.Copies))
            }
            else if (_editing is PersonIntakeEducationDraft education)
            {
                var card = education;
                <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!editable)">
                    <div class="person-intake-wizard__field-row"><label>@L("EducationLevel", "Education level")</label>
                        @(RenderDraftLookup<EducationLevel>(card.EducationLevelId, id => card.EducationLevelId = id, L("EducationLevel", "Education level"), PersonIntakeLookupUsage.EducationLevel))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("EducationInstitution", "Education institution")</label>
                        @(RenderDraftLookup<EducationInstitution>(card.EducationInstitutionId, id => card.EducationInstitutionId = id, L("EducationInstitution", "Education institution"), PersonIntakeLookupUsage.EducationInstitution))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("EducationCountry", "Education country")</label>
                        @(RenderDraftLookup<Country>(card.EducationCountryId, id => card.EducationCountryId = id, L("EducationCountry", "Education country"), PersonIntakeLookupUsage.EducationCountry))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("Specialty", "Specialty")</label>
                        @(RenderDraftLookup<Specialty>(card.SpecialtyId, id => card.SpecialtyId = id, L("Specialty", "Specialty"), PersonIntakeLookupUsage.EducationSpecialty))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("GraduationYear", "Graduation year")</label>
                        <input class="@FilledCss(card.GraduationYear)" maxlength="8" @bind="card.GraduationYear" /></div>
                </div>
                @RenderCopies(L("Documents", "Diploma copies"), card.Copies, () => PreviewCopiesAsync(card.ExistingId, card.CardId, "Education", card.SummaryTitle, typeof(EducationDocument), card.Copies))
            }
            else if (_editing is PersonIntakeSalaryDraft salary)
            {
                var card = salary;
                <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!editable)">
                    <div class="person-intake-wizard__field-row"><label>@L("Amount", "Amount")</label>
                        <input class="@FilledCss(card.Amount)" @bind="card.Amount" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("StartDate", "Start date")</label>
                        <OfficerDateEdit @bind-Date="card.StartDate" CssClass="person-intake-wizard__input" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("EndDate", "End date")</label>
                        <OfficerDateEdit @bind-Date="card.EndDate" CssClass="person-intake-wizard__input" /></div>
                </div>
            }
            else if (_editing is PersonIntakePositionDraft position)
            {
                var card = position;
                <div class="person-intake-wizard__record-form person-intake-wizard__record-form--grid" inert="@(!editable)">
                    <div class="person-intake-wizard__field-row"><label>@L("Position", "Position (visa reports)")</label>
                        @(RenderDraftLookup<Position>(card.PositionId, id => card.PositionId = id, L("Position", "Position (visa reports)"), PersonIntakeLookupUsage.PositionVisaReports))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("ActualPosition", "Position (actual / company)")</label>
                        @(RenderDraftLookup<ActualPosition>(card.ActualPositionId, id => card.ActualPositionId = id, L("ActualPosition", "Position (actual / company)"), PersonIntakeLookupUsage.PositionActual))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("Department", "Department")</label>
                        @(RenderDraftLookup<Department>(card.DepartmentId, id => card.DepartmentId = id, L("Department", "Department"), PersonIntakeLookupUsage.PositionDepartment))</div>
                    <div class="person-intake-wizard__field-row"><label>@L("StartDate", "Start date")</label>
                        <OfficerDateEdit @bind-Date="card.StartDate" CssClass="person-intake-wizard__input" /></div>
                    <div class="person-intake-wizard__field-row"><label>@L("EndDate", "End date")</label>
                        <OfficerDateEdit @bind-Date="card.EndDate" CssClass="person-intake-wizard__input" /></div>
                </div>
                @RenderCopies(L("Documents", "Order for assignment"), card.OrderDocuments, () => PreviewCopiesAsync(card.ExistingId, card.CardId, "EmployeePositionHistory", card.SummaryTitle, typeof(EmployeePositionHistoryDocument), card.OrderDocuments))
            }
            else if (_editing is PersonIntakeWorkDutyDraft duty)
            {
                var card = duty;
                <div class="person-intake-wizard__record-form" inert="@(!editable)">
                    <div class="person-intake-wizard__field-row person-intake-wizard__field-row--top person-intake-wizard__field-row--full">
                        <label>@L("Description", "Description")</label>
                        <textarea class="@FilledCss(card.Description)" rows="4" @bind="card.Description"></textarea>
                    </div>
                </div>
            }
        </div>
        <footer class="pi-dlg__foot">
            @if (editable)
            {
                <button type="button" class="pi-dlg__btn pi-dlg__btn--primary" @onclick="AcceptEditAsync">@T("Ok")</button>
                <button type="button" class="pi-dlg__btn" @onclick="CancelEditAsync">@T("Cancel")</button>
            }
            else
            {
                <button type="button" class="pi-dlg__btn" @onclick="CancelEditAsync">@T("Close")</button>
            }
        </footer>
    </div>
}

@code {
    private static string FilledCss(object? value) =>
        value switch
        {
            null => "person-intake-wizard__input",
            string s when string.IsNullOrWhiteSpace(s) => "person-intake-wizard__input",
            _ => "person-intake-wizard__input is-filled"
