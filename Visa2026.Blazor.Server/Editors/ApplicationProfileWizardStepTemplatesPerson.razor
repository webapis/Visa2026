        _addScope = ApplicationProfileTemplateCatalogScope.ProfileSpecific;
        _addDataScope = ApplicationProfileTemplateDataScope.PeopleM2M;
        ClearAddFile();
        _showAddModal = true;
        _showEditModal = false;
    }

    private void OpenEdit(ApplicationProfileTemplate template)
    {
        _editEntity = template;
        _editName = template.TemplateName ?? string.Empty;
        _editKind = template.TemplateKind;
        _editSort = template.SortOrder;
        _editScope = template.CatalogScope;
        _savedScope = _editScope;
        _scopeChangeConfirmed = true;
        _editCategoryKeys.Clear();
        if (!string.IsNullOrWhiteSpace(template.CategoryKey))
            _editCategoryKeys.Add(template.CategoryKey.Trim());
        _editApplicabilityId = FormatApplicabilityId(template, IsViaMinistry);
        _editDataScope = template.DataScope;
        _editStatus = null;
        _editStatusIsError = false;
        _linkedUserReportTemplateId = Guid.Empty;
        RefreshEditFileLabels(template);
        _showEditModal = true;
        _showAddModal = false;
        _ = EnsureStagingInteropAsync();
        TryResolveLinkedTemplateId();
    }

    private void OpenEditCatalog(ApplicationProfileWizardTemplateCatalog.CatalogRow row)
    {
        var entity = Profile.NestedTemplates?.FirstOrDefault(t =>
            string.Equals(t.TemplateName, row.Name, StringComparison.OrdinalIgnoreCase));
        if (entity == null)
            return;

        OpenEdit(entity);
        _editScope = entity.CatalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific
            ? row.Scope
            : entity.CatalogScope;
        _savedScope = _editScope;
        _editCategoryKeys.Clear();
        foreach (var key in row.CategoryKeys)
            _editCategoryKeys.Add(key);
        if (!string.IsNullOrWhiteSpace(entity.CategoryKey))
            _editCategoryKeys.Add(entity.CategoryKey);
        _editDataScope = entity.DataScope;
        if (!string.IsNullOrWhiteSpace(row.FileLabel))
            _editFileLabel = row.FileLabel!;
        if (row.FileSizeBytes > 0)
            _editFileSizeLabel = FormatBytes(row.FileSizeBytes);
        _linkedUserReportTemplateId = row.UserReportTemplateId;
    }

    private void RefreshEditFileLabels(ApplicationProfileTemplate template)
    {
        var linked = ObjectSpace != null
            ? ApplicationProfileTemplateUserReportBridge.TryFindByName(ObjectSpace, template.TemplateName)
            : null;
        if (linked != null && ApplicationProfileTemplateUserReportBridge.HasExportableContent(linked))
        {
            _editFileLabel = linked.TemplateFile?.FileName ?? $"{template.TemplateName}.docx";
            _editFileSizeLabel = FormatBytes(linked.TemplateFile?.Size ?? linked.TemplateFile?.Content?.Length ?? 0);
            return;
        }

        _editFileLabel = HasFile(template)
            ? (template.TemplateFile?.FileName ?? $"{_editName}.docx")
            : $"{_editName} (no file yet — upload or Replace)";
        _editFileSizeLabel = HasFile(template)
            ? FormatBytes(template.TemplateFile?.Size ?? template.TemplateFile?.Content?.Length ?? 0)
            : "—";
    }

    private void TryResolveLinkedTemplateId()
    {
        if (ObjectSpace == null || string.IsNullOrWhiteSpace(_editName))
            return;

        var linked = ApplicationProfileTemplateUserReportBridge.TryFindByName(ObjectSpace, _editName);
        _linkedUserReportTemplateId = linked?.ID ?? Guid.Empty;
        if (linked != null && ApplicationProfileTemplateUserReportBridge.HasExportableContent(linked))
        {
            _editFileLabel = linked.TemplateFile?.FileName ?? _editFileLabel;
            _editFileSizeLabel = FormatBytes(linked.TemplateFile?.Size ?? linked.TemplateFile?.Content?.Length ?? 0);
        }
    }

    private async Task EnsureStagingInteropAsync()
    {
        if (!_canStageTemplates)
            return;

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("visaTemplateStagingLocal.initDotNetRef", _dotNetRef);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private void CloseModals()
    {
        _showAddModal = false;
        _showEditModal = false;
        _editEntity = null;
        _editStatus = null;
        _editStatusIsError = false;
        _linkedUserReportTemplateId = Guid.Empty;
        _editBusy = false;
        _savedScope = ApplicationProfileTemplateCatalogScope.ProfileSpecific;
        _scopeChangeConfirmed = true;
        _editCategoryKeys.Clear();
        _editApplicabilityId = string.Empty;
    }

    private async Task ToggleIncludeCatalog(ApplicationProfileWizardTemplateCatalog.CatalogRow row)
    {
        if (Disabled)
            return;

        if (IsIncluded(row.Name))
        {
            var existing = Profile.NestedTemplates?.FirstOrDefault(t =>
                string.Equals(t.TemplateName, row.Name, StringComparison.OrdinalIgnoreCase));
            if (existing != null)
                await OnRemoveTemplate.InvokeAsync(existing);
            return;
        }

        var categoryKey = row.CategoryKeys.FirstOrDefault();

        if (OnCreateTemplate.HasDelegate)
        {
            await OnCreateTemplate.InvokeAsync((
                row.Name,
                row.Kind,
                row.SortOrder,
                null,
                null,
                row.Scope,
                row.DataScope,
                categoryKey));
        }
        else
        {
            await OnAddTemplate.InvokeAsync();
        }

        var created = Profile.NestedTemplates?.FirstOrDefault(t =>
            string.Equals(t.TemplateName, row.Name, StringComparison.OrdinalIgnoreCase));
        if (created != null && ObjectSpace != null)
        {
            ApplicationProfileTemplateUserReportBridge.EnsureLinkedUserReportTemplate(
                ObjectSpace,
                created,
                ApplicationProfileWizardTemplateCatalog.RootBoFromDataScope(created.DataScope));
        }
    }

    private async Task OnAddFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _addFileBytes = ms.ToArray();
        _addFileName = file.Name;
        if (string.IsNullOrWhiteSpace(_addName))
            _addName = Path.GetFileNameWithoutExtension(file.Name);
        if (file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            _addKind = ApplicationProfileTemplateKind.Excel;
    }

    private void ClearAddFile()
    {
        _addFileName = null;
        _addFileBytes = null;
    }

    private async Task SubmitAdd(bool requireFile)
    {
        if (string.IsNullOrWhiteSpace(_addName))
            return;
        if (requireFile && (_addFileBytes == null || _addFileBytes.Length == 0))
            return;

        var categoryKey = (string?)null;

        if (OnCreateTemplate.HasDelegate)
        {
            await OnCreateTemplate.InvokeAsync((
                _addName.Trim(),
                _addKind,
                _addSort,
                requireFile ? _addFileBytes : null,
                requireFile ? _addFileName : null,
                _addScope,
                _addDataScope,
                categoryKey));
        }
        else
        {
            await OnAddTemplate.InvokeAsync();
        }

        var created = Profile.NestedTemplates?
            .OrderByDescending(t => t.SortOrder)
            .FirstOrDefault(t => string.Equals(t.TemplateName, _addName.Trim(), StringComparison.OrdinalIgnoreCase));
        if (created != null && ObjectSpace != null)
        {
            var userTemplate = ApplicationProfileTemplateUserReportBridge.EnsureLinkedUserReportTemplate(
                ObjectSpace,
                created,
                ApplicationProfileWizardTemplateCatalog.RootBoFromDataScope(_addDataScope));
            if (requireFile && _addFileBytes is { Length: > 0 })
            {
                ApplicationProfileTemplateUserReportBridge.WriteMasterFile(
                    ObjectSpace,
                    userTemplate,
                    _addFileBytes,
                    _addFileName ?? created.TemplateName + (_addKind == ApplicationProfileTemplateKind.Excel ? ".xlsx" : ".docx"));
            }
        }

        RefreshCatalog();
        CloseModals();
    }

    private async Task OnEditFileSelected(InputFileChangeEventArgs e)
    {
        if (_editEntity == null || ObjectSpace is not { } os)
        {
            SetEditStatus("Include this template on the profile first, then Replace file.", isError: true);
            return;
        }

        var file = e.File;
        if (file == null)
            return;

        await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        _editEntity.TemplateFile ??= os.CreateObject<FileData>();
        _editEntity.TemplateFile.FileName = file.Name;
        _editEntity.TemplateFile.Content = bytes;

        var userTemplate = ApplicationProfileTemplateUserReportBridge.EnsureLinkedUserReportTemplate(
            os,
            _editEntity,
            ApplicationProfileWizardTemplateCatalog.RootBoFromDataScope(_editDataScope));
        ApplicationProfileTemplateUserReportBridge.WriteMasterFile(os, userTemplate, bytes, file.Name);
        _linkedUserReportTemplateId = userTemplate.ID;

        _editFileLabel = file.Name;
        _editFileSizeLabel = FormatBytes(bytes.Length);
        SetEditStatus("File saved on profile nested row and User Report Template.", isError: false);
    }

    private bool _scopeNeedsConfirm =>
        ApplicationProfileWizardTemplateScopeHelper.RequiresSharedVisibilityConfirm(_savedScope, _editScope);

    private void SetEditScope(ApplicationProfileTemplateCatalogScope scope)
    {
        if (Disabled)
            return;

        _editScope = scope;
        _scopeChangeConfirmed = !_scopeNeedsConfirm;
        _editStatus = null;
        _editStatusIsError = false;
    }

    private void SetEditScopeShared() =>
        SetEditScope(ApplicationProfileWizardTemplateScopeHelper.SharedTarget(_savedScope));

    private void ConfirmEditScopeChange()
    {
        _scopeChangeConfirmed = true;
        SetEditStatus("Scope change confirmed. Click Save metadata to apply.", isError: false);
    }

    private void OnEditApplicabilityChanged(ChangeEventArgs e)
    {
        _editApplicabilityId = e.Value?.ToString() ?? string.Empty;
        if (_editEntity != null)
            ApplyEditApplicability(_editEntity);
    }

    private void ApplyEditApplicability(ApplicationProfileTemplate template) =>
        ApplyTemplateApplicability(template, _editApplicabilityId);

    private bool SaveEditMetadata()
    {
        if (_editEntity == null)
        {
            SetEditStatus("Include on the list to attach to this profile, then edit.", isError: true);
            return false;
        }

        if (ObjectSpace is not { } os)
        {
            SetEditStatus("Cannot save — object space is not available.", isError: true);
            return false;
        }

        if (_editScope == ApplicationProfileTemplateCatalogScope.Category && _editCategoryKeys.Count == 0)
        {
            SetEditStatus("Select at least one category.", isError: true);
            return false;
        }

        if (_scopeNeedsConfirm && !_scopeChangeConfirmed)
        {
            SetEditStatus("Confirm the scope change before saving.", isError: true);
            return false;
        }

        _editEntity.TemplateName = _editName.Trim();
        _editEntity.TemplateKind = _editKind;
        _editEntity.SortOrder = _editSort;
        _editEntity.DataScope = _editDataScope;

        try
        {
            var result = ApplicationProfileWizardTemplateScopeHelper.Apply(
                os,
                Profile,
                _editEntity,
                _savedScope,
                _editScope,
                _editCategoryKeys);

            _editName = result.TemplateName;
            _linkedUserReportTemplateId = result.LinkedUserReportTemplateId;
            _savedScope = _editScope;
            _scopeChangeConfirmed = true;

            if (_editScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific)
                ApplyEditApplicability(_editEntity);
            else
                ApplyTemplateApplicability(_editEntity, string.Empty);

            RefreshCatalog();
            SetEditStatus(result.StatusMessage, isError: false);
            return true;
        }
        catch (Exception ex)
        {
            SetEditStatus(ex.Message, isError: true);
            return false;
        }
    }

    private void OnSaveEditMetadataClick() => SaveEditMetadata();

    private void SaveEditAndClose()
    {
        if (SaveEditMetadata())
            CloseModals();
    }

    private async Task OpenInOfficeAsync()
    {
        if (!_canStageTemplates)
        {
            SetEditStatus("Template staging is disabled or you lack User Report Template write access.", isError: true);
            return;
        }

        if (_editEntity == null || ObjectSpace is not { } os)
        {
            SetEditStatus("Include this template on the profile first, then Open.", isError: true);
            return;
        }

        _editBusy = true;
        SetEditStatus(null, isError: false);
        try
        {
            if (!SaveEditMetadata())
                return;

            var userTemplate = ApplicationProfileTemplateUserReportBridge.EnsureLinkedUserReportTemplate(
                os,
                _editEntity,
                ApplicationProfileWizardTemplateCatalog.RootBoFromDataScope(_editDataScope));
            _linkedUserReportTemplateId = userTemplate.ID;

            if (!ApplicationProfileTemplateUserReportBridge.HasExportableContent(userTemplate))
            {
                SetEditStatus("No file content yet. Use Replace file… or Upload when adding the template.", isError: true);
                return;
            }

            var outcome = await TemplateStagingUiService.ExportForEditAsync(userTemplate.ID);
            if (!outcome.Success || outcome.Result?.FileContent == null || outcome.Result.FileContent.Length == 0)
            {
                SetEditStatus(outcome.ErrorMessage ?? "Export failed.", isError: true);
                return;
            }

            await EnsureStagingInteropAsync();
            var downloadResult = await JS.InvokeAsync<UserReportTemplateStagingDownloadJsResult>(
                "visaTemplateStagingLocal.downloadTemplate",
                new
                {
                    fileName = outcome.Result.DocumentFileName,
                    templateId = userTemplate.ID.ToString(),
                    displayName = outcome.Result.DisplayName,
                    fileBase64 = Convert.ToBase64String(outcome.Result.FileContent),
                    exportedAtUtc = DateTime.UtcNow.ToString("o"),
                });

            if (downloadResult == null || !downloadResult.Success)
            {
                SetEditStatus(downloadResult?.Error ?? "Browser download failed.", isError: true);
                return;
            }

            _editFileLabel = outcome.Result.DocumentFileName;
            _editFileSizeLabel = FormatBytes(outcome.Result.FileContent.Length);
            SetEditStatus(
                $"Downloaded {outcome.Result.DocumentFileName}. Edit in Office, Save, then Sync to database.",
                isError: false);
        }
        catch (Exception ex)
        {
            SetEditStatus(ex.Message, isError: true);
        }
        finally
        {
            _editBusy = false;
        }
    }

    [JSInvokable]
    public async Task OnSyncFromFilePickerStarted()
    {
        if (!_canStageTemplates)
            return;

        _editBusy = true;
        SetEditStatus("Syncing… choose the edited file.", isError: false);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSyncFromFilePickerResult(string json)
    {
        try
        {
            if (!_canStageTemplates || string.IsNullOrWhiteSpace(json))
                return;

            var collect = JsonSerializer.Deserialize<UserReportTemplateStagingLocalCollectJsResult>(
                json,
                SyncResultJsonOptions);
            if (collect == null)
            {
                SetEditStatus("Sync failed.", isError: true);
                return;
            }

            if (collect.Cancelled)
            {
                SetEditStatus("Sync cancelled.", isError: false);
                return;
            }

            var result = UserReportTemplateStagingUiService.MapCollectResult(collect);
            if (result.ImportedCount == 0
                && result.FailedCount == 0
                && result.SkippedUnchangedCount > 0)
            {
                SetEditStatus("No local changes detected (file unchanged).", isError: true);
                return;
            }

            var msg =
                $"Imported {result.ImportedCount}, unchanged {result.SkippedUnchangedCount}, failed {result.FailedCount}.";
            var firstFailure = result.Results.FirstOrDefault(r =>
                r.Status == UserReportTemplateStagingImportStatus.Failed
                && !string.IsNullOrWhiteSpace(r.ErrorMessage));
            if (firstFailure?.ErrorMessage != null)
                msg += " " + firstFailure.ErrorMessage;

            SetEditStatus(msg, isError: result.FailedCount > 0);
            if (_editEntity != null)
                RefreshEditFileLabels(_editEntity);
            TryResolveLinkedTemplateId();
            RefreshCatalog();
        }
        finally
        {
            _editBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        if (_dotNetRef != null)
        {
            try
            {
                _ = JS.InvokeVoidAsync("visaTemplateStagingLocal.disposeDotNetRef");
            }
            catch
            {
                // Best-effort on dispose.
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    private void SetEditStatus(string? message, bool isError)
    {
        _editStatus = message;
        _editStatusIsError = isError;
    }

    private static string FormatKind(ApplicationProfileTemplateKind kind) => kind switch
    {
        ApplicationProfileTemplateKind.Excel => "Excel",
        ApplicationProfileTemplateKind.PdfForm => "PDF form",
        _ => "Word",
    };

    private static string FormatDataScope(ApplicationProfileTemplateDataScope scope) => scope switch
    {
        ApplicationProfileTemplateDataScope.ApplicationHeader => "ApplicationProfileInstance header",
        ApplicationProfileTemplateDataScope.Both => "Header + M2M",
        _ => "People (M2M)",
    };

    private static string FormatBytes(long size)
    {
        if (size <= 0)
            return "0 B";
        if (size < 1024)
            return $"{size} B";
        if (size < 1024 * 1024)
            return $"{size / 1024.0:0} KB";
        return $"{size / (1024.0 * 1024.0):0.0} MB";
    }
}
