@using System.Text.Json
@using DevExpress.ExpressApp
@using DevExpress.Persistent.BaseImpl.EF
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationProfileWizard
@using Visa2026.Module.Services.TemplateConvert
@using Visa2026.Module.Services.TemplateScan
@using Visa2026.Module.Services.UserReports
@using Visa2026.Module.Services.WordReports
@implements IDisposable
@inject UserReportTemplateStagingUiService TemplateStagingUiService
@inject IOptions<TemplateAiConvertOptions> ConvertOptions
@inject IOptions<TemplateAiScanOptions> ScanOptions
@inject ITemplateScanAiProvider ScanAiProvider
@inject IJSRuntime JS

<div class="ap-wizard__panel-head">
    <h2>Templates &amp; person data</h2>
    <p>Word/Excel files live on User Report Templates. Profile-specific files belong to this profile; Shared files are included or excluded here.</p>
    @if (!string.IsNullOrEmpty(_previewStatus))
    {
        <p class="ap-wizard__status is-error">@_previewStatus</p>
    }
</div>
<div class="ap-wizard__panel-body">
    @* —— Profile-specific —— *@
    <div class="ap-wizard__section ap-wizard__section--scope">
        <div class="ap-wizard__scope-head">
            <h3>ApplicationProfileInstance templates</h3>
            <span class="ap-wizard__badge ap-wizard__badge--profile">Profile-specific</span>
        </div>
        <p class="ap-wizard__hint">This profile only. Upload GT-15 contract letters here. Assign a Project contract (Via ministry) or Migration service (Direct migration) so the file appears only on matching applications. Leave empty to show for all. Preview shows the stored Word/Excel layout (placeholders), not a filled application.</p>
        <div class="ap-wizard__list">
            @if (ProfileTemplates.Count > 0)
            {
                @foreach (var template in ProfileTemplates)
                {
                    <div class="ap-wizard__list-row ap-wizard__list-row--template @(IsHighlightedTemplate(template) ? "ap-wizard__list-row--focus" : string.Empty)">
                        <span class="ap-wizard__list-ord">@template.SortOrder</span>
                        <span>
                            <strong>@template.TemplateName</strong> · @FormatKind(template.TemplateKind)
                            @if (HasFile(template))
                            {
                                <span class="ap-wizard__tag ap-wizard__tag--ok">file</span>
                            }
                            <span class="ap-wizard__tag">@FormatDataScope(template.DataScope)</span>
                        </span>
                        <select class="ap-wizard__apply-lookup"
                                disabled="@Disabled"
                                title="@ApplicabilityTitle"
                                value="@FormatApplicabilityId(template, IsViaMinistry)"
                                @onchange="e => OnTemplateApplicabilityChanged(template, e)">
                            <option value="">@ApplicabilityEmptyLabel</option>
                            @foreach (var item in ApplicabilityLookups)
                            {
                                <option value="@item.Id.ToString("D")">@item.DisplayName</option>
                                    }
                                </select>
                        @if (CanPreviewProfileTemplate(template) || !Disabled)
                        {
                            <div class="ap-wizard__row-actions">
                                @if (CanPreviewProfileTemplate(template))
                                {
                                    <button type="button" class="ap-wizard__link" @onclick="() => PreviewProfileTemplateAsync(template)">Preview</button>
                                }
                                @if (!Disabled)
                                {
                                    <button type="button" class="ap-wizard__link" @onclick="() => OpenEdit(template)">Edit</button>
                                <button type="button" class="ap-wizard__link" @onclick="() => OnRemoveTemplate.InvokeAsync(template)">Remove</button>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="ap-wizard__hint">No profile-specific templates yet.</p>
            }
        </div>
        @if (!Disabled || AllowTemplateAdd)
        {
            <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary ap-wizard__add-template" @onclick="OpenAdd">+ Add template</button>
            @if (ShowConvertEntry)
            {
                <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary ap-wizard__add-template"
                        title="Upload a filled Word or Excel file and turn it into a template"
                        @onclick="OpenConvertAsync">Convert existing document</button>
            }
            @if (ShowScanEntryVisible)
            {
                <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary ap-wizard__add-template"
                        title="@ScanEntryTitle"
                        @onclick="OpenScanAsync">
                    Create from yellow marks
                </button>
            }
        }
    </div>

    @* —— Shared catalog (typed + global masters) —— *@
    <div class="ap-wizard__section ap-wizard__section--scope">
        <div class="ap-wizard__scope-head">
            <h3>Shared catalog</h3>
            <span class="ap-wizard__badge ap-wizard__badge--global">Shared</span>
        </div>
        <p class="ap-wizard__hint">Include or exclude a User Report Template for this profile. Preview opens the master file layout in the side panel.</p>
        @if (_sharedRows.Count > 0)
        {
            <div class="ap-wizard__shared-toolbar">
                <label class="ap-wizard__shared-search">
                    <span class="ap-wizard__shared-search-icon" aria-hidden="true">⌕</span>
                    <input type="search"
                           value="@_sharedSearch"
                           @oninput="OnSharedSearchInput"
                           placeholder="Search shared templates…"
                           aria-label="Search shared templates" />
                </label>
                <span class="ap-wizard__shared-count">@FilteredSharedRows.Count / @_sharedRows.Count</span>
            </div>
        }
        <div class="ap-wizard__list @(FilteredSharedRows.Count > SharedCatalogScrollAfterCount ? "ap-wizard__list--scroll" : null)">
            @if (_sharedRows.Count == 0)
            {
                <p class="ap-wizard__hint">No shared User Report Templates found.</p>
            }
            else if (FilteredSharedRows.Count == 0)
            {
                <p class="ap-wizard__hint">No templates match “@_sharedSearch”.</p>
            }
            else
            {
                @foreach (var row in FilteredSharedRows)
                {
                    var included = IsIncluded(row.Name);
                    <div class="ap-wizard__list-row ap-wizard__list-row--shared">
                        <span class="ap-wizard__list-ord">@row.SortOrder</span>
                        <span class="ap-wizard__shared-name">
                            <strong>@row.Name</strong> · @FormatKind(row.Kind)
                            <span class="ap-wizard__shared-meta">@FormatDataScope(row.DataScope)</span>
                        </span>
                        <span class="ap-wizard__tag @(included ? "ap-wizard__tag--ok" : null)">@(included ? "included" : "not included")</span>
                        @if (CanPreviewCatalogRow(row) || !Disabled)
                        {
                            <div class="ap-wizard__row-actions">
                                @if (CanPreviewCatalogRow(row))
                                {
                                    <button type="button" class="ap-wizard__link" @onclick="() => PreviewCatalogRowAsync(row)">Preview</button>
                                }
                                @if (!Disabled)
                                {
                                    @if (included)
                                    {
                                        <button type="button" class="ap-wizard__link" @onclick="() => OpenEditCatalog(row)">Edit</button>
                                    }
                                    <button type="button" class="ap-wizard__link" @onclick="() => ToggleIncludeCatalog(row)">
                                        @(included ? "Exclude" : "Include")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <div class="ap-wizard__section">
        <h3>Required person-related data</h3>
        <p class="ap-wizard__hint">Last 1–3 is only for Passport, Visa, Invitation, Work permit, and Border zone. Other types stay one current row. Missing rows are flagged; they do not block create.</p>
        <div class="ap-wizard__choices ap-wizard__choices--grid">
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonPassport" disabled="@Disabled" /> Passport</label>
                @if (Profile.RequirePersonPassport)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonPassportLastCount" disabled="@Disabled" title="How many latest passports to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonEducation" disabled="@Disabled" /> Education</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonPosition" disabled="@Disabled" /> Position</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonAddressOfResidence" disabled="@Disabled" /> Address of residence</label>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonVisa" disabled="@Disabled" /> Visa</label>
                @if (Profile.RequirePersonVisa)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonVisaLastCount" disabled="@Disabled" title="How many latest valid visas to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonInvitationItem" disabled="@Disabled" /> Invitation item</label>
                @if (Profile.RequirePersonInvitationItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonInvitationItemLastCount" disabled="@Disabled" title="How many latest valid invitation items to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonWorkPermitItem" disabled="@Disabled" /> Work permit item</label>
                @if (Profile.RequirePersonWorkPermitItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonWorkPermitItemLastCount" disabled="@Disabled" title="How many latest valid work-permit items to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonBorderZoneItem" disabled="@Disabled" /> Border zone item</label>
                @if (Profile.RequirePersonBorderZoneItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonBorderZoneItemLastCount" disabled="@Disabled" title="How many latest valid border-zone items to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonSalary" disabled="@Disabled" /> Salary</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonMedical" disabled="@Disabled" /> Medical</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonRejectionItem" disabled="@Disabled" /> Rejection item</label>
            @if (!IsBusinessTripProfile)
            {
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonTravelHistory" disabled="@Disabled" /> Travel history</label>
            }
        </div>
    </div>
</div>

@if (_showAddModal)
{
    <div class="ap-wizard-modal" role="dialog" aria-modal="true" aria-labelledby="ap-add-template-title">
        <div class="ap-wizard-modal__backdrop" @onclick="CloseModals"></div>
        <div class="ap-wizard-modal__card ap-wizard-modal__card--wide">
            <header class="ap-wizard-modal__head">
                <div>
                    <h3 id="ap-add-template-title">Add template</h3>
                    <p>Upload file and declare where merge data comes from.</p>
                </div>
                <button type="button" class="ap-wizard-modal__close" @onclick="CloseModals" aria-label="Close">×</button>
            </header>
            <div class="ap-wizard-modal__body">
                <section class="ap-wizard-modal__block">
                    <h4>1. Scope &amp; identity</h4>
                    <div class="ap-wizard__scope-pills" role="radiogroup" aria-label="Template scope">
                        <button type="button"
                                class="ap-wizard__scope-pill @(_addScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific ? "is-on" : null)"
                                @onclick="() => _addScope = ApplicationProfileTemplateCatalogScope.ProfileSpecific">Profile-specific</button>
                        <button type="button"
                                class="ap-wizard__scope-pill @(ApplicationProfileWizardTemplateScopeHelper.IsShared(_addScope) ? "is-on" : null)"
                                @onclick="() => _addScope = ApplicationProfileTemplateCatalogScope.Global">Shared</button>
                    </div>
                    <div class="ap-wizard__grid ap-wizard__grid--add-identity">
                        <label class="ap-wizard__field">
                            <span>Name *</span>
                            <input type="text" @bind="_addName" placeholder="e.g. Sanaw - ckd" />
                        </label>
                        <label class="ap-wizard__field">
                            <span>Kind *</span>
                            <select @bind="_addKind">
                                <option value="@ApplicationProfileTemplateKind.Word">Word</option>
                                <option value="@ApplicationProfileTemplateKind.Excel">Excel</option>
                            </select>
                        </label>
                        <label class="ap-wizard__field ap-wizard__field--sort">
                            <span>Sort *</span>
                            <input type="number" min="0" @bind="_addSort" />
                        </label>
                    </div>
                </section>

                <section class="ap-wizard-modal__block">
                    <h4>2. Upload</h4>
                    @if (!string.IsNullOrEmpty(_addFileName))
                    {
                        <div class="ap-wizard-upload-chip">
                            <span class="ap-wizard-upload-chip__text">
                                <span class="ap-wizard-upload-chip__check" aria-hidden="true">✓</span>
                                @_addFileName · @FormatBytes(_addFileBytes?.Length ?? 0) · uploaded
                            </span>
                            <label class="ap-wizard__link ap-wizard-upload-chip__replace">
                                Replace
                                <InputFile OnChange="OnAddFileSelected" accept=".docx,.xlsx" style="display:none" />
                            </label>
                        </div>
                    }
                    else
                    {
                        <label class="ap-wizard-dropzone">
                            <InputFile OnChange="OnAddFileSelected" accept=".docx,.xlsx" />
                            <span class="ap-wizard-dropzone__title">Drop .docx or .xlsx here</span>
                            <span class="ap-wizard-dropzone__sub">or click to browse · Word (.docx) · Excel (.xlsx)</span>
                        </label>
                    }
                </section>

                <section class="ap-wizard-modal__block">
                    <h4>3. Data for this template</h4>
                    <p class="ap-wizard__hint">
                        Application Profile defaults flow into ApplicationProfileInstance header fields. People data comes from M2M-linked persons on the Application.
                    </p>
                    <div class="ap-wizard-data-cards" role="radiogroup" aria-label="Data for this template">
                        @foreach (var opt in _dataScopeOptions)
                        {
                            var selected = _addDataScope == opt.Scope;
                            <button type="button"
                                    class="ap-wizard-data-card @(selected ? "is-on" : null)"
                                    @onclick="() => _addDataScope = opt.Scope">
                                @if (selected)
                                {
                                    <span class="ap-wizard-data-card__check" aria-hidden="true">✓</span>
                                }
                                <span class="ap-wizard-data-card__icon @opt.IconClass" aria-hidden="true"></span>
                                <strong>@opt.Title</strong>
                                <span>@opt.Description</span>
                            </button>
                        }
                    </div>
                    <div class="ap-wizard-extract-block">
                        <div class="ap-wizard-extract-block__label">After Extract (preview)</div>
                        <div class="ap-wizard-extract">
                            <span class="ap-wizard__tag">4 Application</span>
                            <span class="ap-wizard__tag ap-wizard__tag--person">8 Person</span>
                            <span class="ap-wizard__tag ap-wizard__tag--ok">Valid ✓</span>
                            <span class="ap-wizard-extract__hint">Paths come from the Word file — you set intent, Extract discovers tokens.</span>
                        </div>
                    </div>
                    @if (_addDataScope is ApplicationProfileTemplateDataScope.PeopleM2M or ApplicationProfileTemplateDataScope.Both)
                    {
                        <div class="ap-wizard-callout-warn">
                            Person packs required on this profile: Passport, Education (match Require person toggles on step 4).
                        </div>
                    }
                </section>
            </div>
            <footer class="ap-wizard-modal__foot">
                <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary" @onclick="CloseModals">Cancel</button>
                <button type="button"
                        class="ap-wizard__btn ap-wizard__btn--primary"
                        disabled="@(string.IsNullOrWhiteSpace(_addName) || string.IsNullOrEmpty(_addFileName))"
                        @onclick="() => SubmitAdd(requireFile: true)">Upload &amp; add to profile</button>
            </footer>
        </div>
    </div>
}

@if (_showEditModal)
{
    <div class="ap-wizard-modal" role="dialog" aria-modal="true" aria-labelledby="ap-edit-template-title">
        <div class="ap-wizard-modal__backdrop" @onclick="CloseModals"></div>
        <div class="ap-wizard-modal__card ap-wizard-modal__card--edit">
            <header class="ap-wizard-edit-head">
                <div class="ap-wizard-edit-head__bar">
                    <span class="ap-wizard-edit-head__doc-icon @(_editKind == ApplicationProfileTemplateKind.Excel ? "is-excel" : "is-word")" aria-hidden="true"></span>
                    <h3 id="ap-edit-template-title">Edit @(_editKind == ApplicationProfileTemplateKind.Excel ? "Excel" : "Word") template</h3>
                    <button type="button" class="ap-wizard-edit-head__close" @onclick="CloseModals" aria-label="Close">×</button>
                </div>
                <div class="ap-wizard-edit-head__sub">
                    <p class="ap-wizard-modal__crumb">Configure profile › Templates &amp; person › @_editName</p>
                    <p>File stored on User Report Template — edit without leaving the wizard.</p>
                </div>
            </header>
            <div class="ap-wizard-modal__body ap-wizard-modal__body--split">
                <div class="ap-wizard-preview ap-wizard-preview--letter">
                    <div class="ap-wizard-preview__label">@DisplayEditFileName</div>
                    <div class="ap-wizard-preview__page">
                        <div class="ap-wizard-preview__watermark" aria-hidden="true">SAMPLE</div>
                        <div class="ap-wizard-preview__seal" aria-hidden="true"></div>
                        <p class="ap-wizard-preview__org">MINISTRY OF HOME AFFAIRS</p>
                        <p class="ap-wizard-preview__ref">Ref: {{Application.Number}} · {{Today}}</p>
                        @if (_editDataScope == ApplicationProfileTemplateDataScope.ApplicationHeader)
                        {
                            <p class="ap-wizard-preview__body">{{Application.FullApplicationNumber}}</p>
                            <p class="ap-wizard-preview__body">{{Application.CompanyHead_FullName}}</p>
                        }
                        else
                        {
                            <p class="ap-wizard-preview__body">Dear {{Person.FullName}},</p>
                            <p class="ap-wizard-preview__body">{{Person.AddressLine1}}</p>
                            <p class="ap-wizard-preview__body">{{Person.AddressLine2}}</p>
                            <p class="ap-wizard-preview__muted">{{#ds.rows}} … {{.Person_FullName}} … {{/ds.rows}}</p>
                        }
                        <p class="ap-wizard-preview__sign">{{Officer.FullName}} · {{Officer.Designation}}</p>
                    </div>
                    <div class="ap-wizard-preview__meta">
                        <span class="ap-wizard-preview__kind-icon @(_editKind == ApplicationProfileTemplateKind.Excel ? "is-excel" : "is-word")" aria-hidden="true"></span>
                        <span>@FormatKind(_editKind) · @_editFileSizeLabel · Valid</span>
                        <span class="ap-wizard__tag ap-wizard__tag--ok">✓</span>
                    </div>
                    <button type="button"
                            class="ap-wizard__btn ap-wizard__btn--secondary ap-wizard__btn--block"
                            disabled="@(!CanPreviewEdit)"
                            @onclick="PreviewEditAsync">
                        Preview actual layout
                    </button>
                    <p class="ap-wizard-edit-action__hint">Opens the stored Word/Excel file as PDF in the side panel (placeholders visible).</p>
                </div>
                <div class="ap-wizard-edit-side">
                    <div class="ap-wizard-edit-action">
                        <button type="button"
                                class="ap-wizard__btn ap-wizard__btn--primary ap-wizard__btn--block ap-wizard__btn--office"
                                disabled="@(_editBusy || Disabled || !_canStageTemplates)"
                                @onclick="OpenInOfficeAsync">
                            <span class="ap-wizard__btn-ico ap-wizard__btn-ico--word" aria-hidden="true"></span>
                            Open in Microsoft @(_editKind == ApplicationProfileTemplateKind.Excel ? "Excel" : "Word")
                        </button>
                        <p class="ap-wizard-edit-action__hint">@( _canStageTemplates ? "Writes to local sandbox folder" : "Template staging disabled or no edit permission" )</p>
                    </div>
                    <div class="ap-wizard-edit-action">
                        <button type="button"
                                class="ap-wizard__btn ap-wizard__btn--secondary ap-wizard__btn--block ap-wizard__btn--sync"
                                disabled="@(_editBusy || Disabled || !_canStageTemplates || _linkedUserReportTemplateId == Guid.Empty)"
                                onclick="visaTemplateStagingLocal.syncFromFilePickerDirect()">
                            <span class="ap-wizard__btn-ico ap-wizard__btn-ico--sync" aria-hidden="true"></span>
                            Sync to database
                        </button>
                        <p class="ap-wizard-edit-action__hint">After Save &amp; Close in @(_editKind == ApplicationProfileTemplateKind.Excel ? "Excel" : "Word")</p>
                    </div>
                    <div class="ap-wizard-edit-links">
                        <label class="ap-wizard__link ap-wizard__link--icon-replace">
                            Replace file…
                            <InputFile OnChange="OnEditFileSelected" accept=".docx,.xlsx" style="display:none" disabled="@(_editBusy || Disabled)" />
                        </label>
                        <button type="button" class="ap-wizard__link ap-wizard__link--icon-download" disabled="@(_editBusy || _linkedUserReportTemplateId == Guid.Empty)" @onclick="OpenInOfficeAsync">Download</button>
                    </div>

                    <dl class="ap-wizard-edit-meta">
                        <div class="ap-wizard-edit-meta__row">
                            <dt>Name</dt>
                            <dd>
                                <input type="text" @bind="_editName" disabled="@Disabled" />
                            </dd>
                        </div>
                        <div class="ap-wizard-edit-meta__row">
                            <dt>Kind</dt>
                            <dd>
                                <select @bind="_editKind" disabled="@Disabled">
                                    <option value="@ApplicationProfileTemplateKind.Word">Word</option>
                                    <option value="@ApplicationProfileTemplateKind.Excel">Excel</option>
                                </select>
                            </dd>
                        </div>
                        <div class="ap-wizard-edit-meta__row ap-wizard-edit-meta__row--scope">
                            <dt>Scope</dt>
                            <dd>
                                <div class="ap-wizard__scope-pills ap-wizard__scope-pills--edit" role="radiogroup" aria-label="Template scope">
                                    <button type="button"
                                            class="ap-wizard__scope-pill @(_editScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific ? "is-on" : null)"
                                            disabled="@Disabled"
                                            @onclick="() => SetEditScope(ApplicationProfileTemplateCatalogScope.ProfileSpecific)">Profile-specific</button>
                                    <button type="button"
                                            class="ap-wizard__scope-pill @(ApplicationProfileWizardTemplateScopeHelper.IsShared(_editScope) ? "is-on" : null)"
                                            disabled="@Disabled"
                                            @onclick="SetEditScopeShared">Shared</button>
                                </div>
                                @if (_editScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific)
                                {
                                    <label class="ap-wizard__field ap-wizard__field--edit-apply">
                                        <span>@ApplicabilityTitle</span>
                                        <select disabled="@Disabled"
                                                value="@_editApplicabilityId"
                                                @onchange="OnEditApplicabilityChanged">
                                            <option value="">@ApplicabilityEmptyLabel</option>
                                            @foreach (var item in ApplicabilityLookups)
                                            {
                                                <option value="@item.Id.ToString("D")">@item.DisplayName</option>
                                            }
                                        </select>
                                    </label>
                                }
                                @if (_editScope != _savedScope)
                                {
                                    <p class="ap-wizard-edit-scope-note @(_scopeNeedsConfirm ? "is-warn" : "is-info")">
                                        @ApplicationProfileWizardTemplateScopeHelper.ConfirmMessage(_savedScope, _editScope)
                                    </p>
                                    @if (_scopeNeedsConfirm && !_scopeChangeConfirmed)
                                    {
                                        <button type="button"
                                                class="ap-wizard__btn ap-wizard__btn--secondary ap-wizard__btn--scope-confirm"
                                                disabled="@Disabled"
                                                @onclick="ConfirmEditScopeChange">
                                            Confirm scope change
                                        </button>
                                    }
                                }
                            </dd>
                        </div>
                        <div class="ap-wizard-edit-meta__row">
                            <dt>Sort</dt>
                            <dd>
                                <input type="number" min="0" @bind="_editSort" disabled="@Disabled" />
                            </dd>
                        </div>
                        <div class="ap-wizard-edit-meta__row">
                            <dt>Linked</dt>
                            <dd>
                                UserReportTemplate @_editName
                                @if (_linkedUserReportTemplateId != Guid.Empty)
                                {
                                    <span class="ap-wizard-edit-meta__active">Active</span>
                                }
                                else
                                {
                                    <span class="ap-wizard-edit-meta__missing">not linked yet</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <div class="ap-wizard-edit-status">
                        <span class="ap-wizard-edit-status__label">Status</span>
                        <div class="ap-wizard-edit-pills">
                            <span class="ap-wizard__tag ap-wizard__tag--pill-ok">Placeholders 12</span>
                            <span class="ap-wizard__tag ap-wizard__tag--pill-info">Extracted</span>
                            <span class="ap-wizard__tag ap-wizard__tag--pill-ok">Validated ✓</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_editStatus))
                    {
                        <div class="ap-wizard__status @(_editStatusIsError ? "is-error" : "is-ok")">@_editStatus</div>
                    }
                </div>
            </div>
            <footer class="ap-wizard-modal__foot ap-wizard-modal__foot--edit">
                <button type="button" class="ap-wizard__btn ap-wizard__btn--ghost" @onclick="CloseModals">Cancel</button>
                <div class="ap-wizard-modal__foot-actions">
                    <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary" @onclick="OnSaveEditMetadataClick" disabled="@Disabled">Save metadata</button>
                    <button type="button" class="ap-wizard__btn ap-wizard__btn--primary" @onclick="SaveEditAndClose" disabled="@Disabled">Save &amp; close</button>
                </div>
            </footer>
        </div>
    </div>
}

