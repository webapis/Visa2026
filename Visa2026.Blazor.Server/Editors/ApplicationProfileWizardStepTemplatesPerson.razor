    private Task PreviewCatalogRowAsync(ApplicationProfileWizardTemplateCatalog.CatalogRow row) =>
        OpenTemplatePreviewAsync(UserReportTemplateFilePreviewSource.Key, row.UserReportTemplateId);

    private Task PreviewEditAsync()
    {
        if (_linkedUserReportTemplateId != Guid.Empty)
            return OpenTemplatePreviewAsync(UserReportTemplateFilePreviewSource.Key, _linkedUserReportTemplateId);

        if (_editEntity != null)
            return PreviewProfileTemplateAsync(_editEntity);

        _previewStatus = "No file to preview yet.";
        return Task.CompletedTask;
    }

    private async Task OpenTemplatePreviewAsync(string sourceType, Guid objectId)
    {
        _previewStatus = null;
        if (string.IsNullOrWhiteSpace(sourceType) || objectId == Guid.Empty)
        {
            _previewStatus = "No file to preview yet. Save the profile after upload, then Preview again.";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "visaPreviewDrawerOpenFile",
                sourceType,
                objectId.ToString("D"),
                OwnerViewId ?? string.Empty);
        }
        catch (JSDisconnectedException)
        {
            _previewStatus = "Preview panel is not connected. Refresh the page and try again.";
        }
        catch (Exception)
        {
            _previewStatus = "Preview panel did not open. Hard-refresh (Ctrl+F5) and try again.";
        }
    }

    private void OpenAdd()
    {
        _addName = string.Empty;
        _addKind = ApplicationProfileTemplateKind.Word;
