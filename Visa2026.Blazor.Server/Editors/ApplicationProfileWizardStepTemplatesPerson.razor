@using DevExpress.ExpressApp
@using Microsoft.JSInterop
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationProfileWizard
@using Visa2026.Module.Services.UserReports
@inject IJSRuntime JS

<div class="ap-wizard__panel-head">
    <h2>Templates &amp; person data</h2>
    <p>This-profile files are created on a case (Resminamalar). Here you preview them and include or exclude the shared catalog.</p>
    @if (!string.IsNullOrEmpty(_previewStatus))
    {
        <p class="ap-wizard__status is-error">@_previewStatus</p>
    }
</div>
<div class="ap-wizard__panel-body">
    @* —— Profile-specific —— *@
    <div class="ap-wizard__section ap-wizard__section--scope">
        <div class="ap-wizard__scope-head">
            <h3>ApplicationProfileInstance templates</h3>
            <span class="ap-wizard__badge ap-wizard__badge--profile">Profile-specific</span>
        </div>
        <p class="ap-wizard__hint">This profile only. Officers add these from a case → Resminamalar (Create from yellow marks or Add existing). Preview shows the stored Word/Excel layout, not a filled application.</p>
        <div class="ap-wizard__list">
            @if (ProfileTemplates.Count > 0)
            {
                @foreach (var template in ProfileTemplates)
                {
                    <div class="ap-wizard__list-row ap-wizard__list-row--template">
                        <span class="ap-wizard__list-ord">@template.SortOrder</span>
                        <span>
                            <strong>@template.TemplateName</strong> · @FormatKind(template.TemplateKind)
                            @if (HasFile(template))
                            {
                                <span class="ap-wizard__tag ap-wizard__tag--ok">file</span>
                            }
                            <span class="ap-wizard__tag">@FormatDataScope(template.DataScope)</span>
                        </span>
                        @if (CanPreviewProfileTemplate(template))
                        {
                            <div class="ap-wizard__row-actions">
                                <button type="button" class="ap-wizard__link" @onclick="() => PreviewProfileTemplateAsync(template)">Preview</button>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p class="ap-wizard__hint">No this-profile templates yet. Open a case of this profile and add them from Resminamalar.</p>
            }
        </div>
    </div>

    @* —— Shared catalog (typed + global masters) —— *@
    <div class="ap-wizard__section ap-wizard__section--scope">
        <div class="ap-wizard__scope-head">
            <h3>Shared catalog</h3>
            <span class="ap-wizard__badge ap-wizard__badge--global">Shared</span>
        </div>
        <p class="ap-wizard__hint">Include or exclude a shared User Report Template for this profile. Preview opens the master file layout.</p>
        @if (_sharedRows.Count > 0)
        {
            <div class="ap-wizard__shared-toolbar">
                <label class="ap-wizard__shared-search">
                    <span class="ap-wizard__shared-search-icon" aria-hidden="true">⌕</span>
                    <input type="search"
                           value="@_sharedSearch"
                           @oninput="OnSharedSearchInput"
                           placeholder="Search shared templates…"
                           aria-label="Search shared templates" />
                </label>
                <span class="ap-wizard__shared-count">@FilteredSharedRows.Count / @_sharedRows.Count</span>
            </div>
        }
        <div class="ap-wizard__list @(FilteredSharedRows.Count > SharedCatalogScrollAfterCount ? "ap-wizard__list--scroll" : null)">
            @if (_sharedRows.Count == 0)
            {
                <p class="ap-wizard__hint">No shared User Report Templates found.</p>
            }
            else if (FilteredSharedRows.Count == 0)
            {
                <p class="ap-wizard__hint">No templates match “@_sharedSearch”.</p>
            }
            else
            {
                @foreach (var row in FilteredSharedRows)
                {
                    var included = IsIncluded(row.Name);
                    <div class="ap-wizard__list-row ap-wizard__list-row--shared">
                        <span class="ap-wizard__list-ord">@row.SortOrder</span>
                        <span class="ap-wizard__shared-name">
                            <strong>@row.Name</strong> · @FormatKind(row.Kind)
                            <span class="ap-wizard__shared-meta">@FormatDataScope(row.DataScope)</span>
                        </span>
                        <span class="ap-wizard__tag @(included ? "ap-wizard__tag--ok" : null)">@(included ? "included" : "not included")</span>
                        @if (CanPreviewCatalogRow(row) || !Disabled)
                        {
                            <div class="ap-wizard__row-actions">
                                @if (CanPreviewCatalogRow(row))
                                {
                                    <button type="button" class="ap-wizard__link" @onclick="() => PreviewCatalogRowAsync(row)">Preview</button>
                                }
                                @if (!Disabled)
                                {
                                    <button type="button" class="ap-wizard__link" @onclick="() => ToggleIncludeCatalog(row)">
                                        @(included ? "Exclude" : "Include")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <div class="ap-wizard__section">
        <h3>Required person-related data</h3>
        <p class="ap-wizard__hint">Last 1–3 is only for Passport, Visa, Invitation, Work permit, and Border zone. Other types stay one current row. Missing rows are flagged; they do not block create.</p>
        <div class="ap-wizard__choices ap-wizard__choices--grid">
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonPassport" disabled="@Disabled" /> Passport</label>
                @if (Profile.RequirePersonPassport)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonPassportLastCount" disabled="@Disabled" title="How many latest passports to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonEducation" disabled="@Disabled" /> Education</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonPosition" disabled="@Disabled" /> Position</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonAddressOfResidence" disabled="@Disabled" /> Address of residence</label>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonVisa" disabled="@Disabled" /> Visa</label>
                @if (Profile.RequirePersonVisa)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonVisaLastCount" disabled="@Disabled" title="How many latest valid visas to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonInvitationItem" disabled="@Disabled" /> Invitation item</label>
                @if (Profile.RequirePersonInvitationItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonInvitationItemLastCount" disabled="@Disabled" title="How many latest valid invitation items to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonWorkPermitItem" disabled="@Disabled" /> Work permit item</label>
                @if (Profile.RequirePersonWorkPermitItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonWorkPermitItemLastCount" disabled="@Disabled" title="How many latest valid work-permit items to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonBorderZoneItem" disabled="@Disabled" /> Border zone item</label>
                @if (Profile.RequirePersonBorderZoneItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonBorderZoneItemLastCount" disabled="@Disabled" title="How many latest valid border-zone items to auto-link">
                        <option value="1">Last 1</option>
                        <option value="2">Last 2</option>
                        <option value="3">Last 3</option>
                    </select>
                }
            </div>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonSalary" disabled="@Disabled" /> Salary</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonMedical" disabled="@Disabled" /> Medical</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonRejectionItem" disabled="@Disabled" /> Rejection item</label>
            @if (!IsBusinessTripProfile)
            {
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonTravelHistory" disabled="@Disabled" /> Travel history</label>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IObjectSpace? ObjectSpace { get; set; }
    [Parameter] public string? OwnerViewId { get; set; }
    [Parameter] public EventCallback OnAddTemplate { get; set; }
    [Parameter] public EventCallback<ApplicationProfileTemplate> OnRemoveTemplate { get; set; }
    [Parameter] public EventCallback<(string Name, ApplicationProfileTemplateKind Kind, int SortOrder, byte[]? FileBytes, string? FileName, ApplicationProfileTemplateCatalogScope CatalogScope, ApplicationProfileTemplateDataScope DataScope, string? CategoryKey)> OnCreateTemplate { get; set; }

    private IReadOnlyList<ApplicationProfileWizardTemplateCatalog.CatalogRow> _sharedRows =
        Array.Empty<ApplicationProfileWizardTemplateCatalog.CatalogRow>();
    private string _sharedSearch = string.Empty;
    private const int SharedCatalogScrollAfterCount = 8;
    private string? _previewStatus;

    protected override void OnParametersSet()
    {
        if (IsBusinessTripProfile && Profile.RequirePersonTravelHistory)
            Profile.RequirePersonTravelHistory = false;

        RefreshCatalog();
    }

    private void RefreshCatalog()
    {
        if (ObjectSpace == null)
        {
            _sharedRows = Array.Empty<ApplicationProfileWizardTemplateCatalog.CatalogRow>();
            return;
        }

        try
        {
            _sharedRows = ApplicationProfileWizardTemplateCatalog.Build(ObjectSpace).Shared;
        }
        catch
        {
            _sharedRows = Array.Empty<ApplicationProfileWizardTemplateCatalog.CatalogRow>();
        }
    }

    private void OnSharedSearchInput(ChangeEventArgs e) =>
        _sharedSearch = e.Value?.ToString() ?? string.Empty;

    private IReadOnlyList<ApplicationProfileWizardTemplateCatalog.CatalogRow> FilteredSharedRows =>
        _sharedRows
            .Where(r => ApplicationProfileWizardTemplateCatalog.MatchesSharedSearch(r, _sharedSearch)
                || IncludedSearchHit(r.Name, _sharedSearch))
            .ToList();

    private bool IncludedSearchHit(string name, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return false;
        var q = query.Trim();
        var label = IsIncluded(name) ? "included" : "not included";
        return label.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private IReadOnlyList<ApplicationProfileTemplate> ProfileTemplates =>
        (Profile.NestedTemplates ?? Array.Empty<ApplicationProfileTemplate>())
            .Where(t => t != null
                && (t.CatalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific
                    || ApplicationProfileWizardTemplateCatalog.IsProfileSpecificUploadOnly(t.TemplateName)))
            .OrderBy(t => t.SortOrder)
            .ThenBy(t => t.TemplateName)
            .ToList();

    private bool IsBusinessTripProfile =>
        Profile.ActionFamily == ApplicationProfileActionFamily.BusinessTrip;

    private bool IsIncluded(string name) =>
        Profile.NestedTemplates?.Any(t =>
            string.Equals(t.TemplateName, name, StringComparison.OrdinalIgnoreCase)) == true;

    private static bool HasFile(ApplicationProfileTemplate template) =>
        template.TemplateFile is { Size: > 0 }
        || (template.TemplateFile?.Content?.Length > 0);

    private bool CanPreviewProfileTemplate(ApplicationProfileTemplate template)
    {
        if (HasFile(template))
            return true;
        if (ObjectSpace == null)
            return false;
        var linked = ApplicationProfileTemplateUserReportBridge.TryFindByName(ObjectSpace, template.TemplateName);
        return linked != null && ApplicationProfileTemplateUserReportBridge.HasExportableContent(linked);
    }

    private static bool CanPreviewCatalogRow(ApplicationProfileWizardTemplateCatalog.CatalogRow row) =>
        row.FileSizeBytes > 0;

    private Task PreviewProfileTemplateAsync(ApplicationProfileTemplate template) =>
        OpenTemplatePreviewAsync(ApplicationProfileTemplateFilePreviewSource.Key, template.ID);

    private Task PreviewCatalogRowAsync(ApplicationProfileWizardTemplateCatalog.CatalogRow row) =>
        OpenTemplatePreviewAsync(UserReportTemplateFilePreviewSource.Key, row.UserReportTemplateId);

    private async Task OpenTemplatePreviewAsync(string sourceType, Guid objectId)
    {
        _previewStatus = null;
        if (string.IsNullOrWhiteSpace(sourceType) || objectId == Guid.Empty)
        {
            _previewStatus = "No file to preview yet. Save the profile after upload, then Preview again.";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "visaPreviewDrawerOpenFile",
                sourceType,
                objectId.ToString("D"),
                OwnerViewId ?? string.Empty);
        }
        catch (JSDisconnectedException)
        {
            _previewStatus = "Preview panel is not connected. Refresh the page and try again.";
        }
        catch (Exception)
        {
            _previewStatus = "Preview panel did not open. Hard-refresh (Ctrl+F5) and try again.";
        }
    }

    private async Task ToggleIncludeCatalog(ApplicationProfileWizardTemplateCatalog.CatalogRow row)
    {
        if (Disabled)
            return;

        if (IsIncluded(row.Name))
        {
            var existing = Profile.NestedTemplates?.FirstOrDefault(t =>
                string.Equals(t.TemplateName, row.Name, StringComparison.OrdinalIgnoreCase));
            if (existing != null)
                await OnRemoveTemplate.InvokeAsync(existing);
            return;
        }

        var categoryKey = row.CategoryKeys.FirstOrDefault();

        if (OnCreateTemplate.HasDelegate)
        {
            await OnCreateTemplate.InvokeAsync((
                row.Name,
                row.Kind,
                row.SortOrder,
                null,
                null,
                row.Scope,
                row.DataScope,
                categoryKey));
        }
        else
        {
            await OnAddTemplate.InvokeAsync();
        }

        var created = Profile.NestedTemplates?.FirstOrDefault(t =>
            string.Equals(t.TemplateName, row.Name, StringComparison.OrdinalIgnoreCase));
        if (created != null && ObjectSpace != null)
        {
            ApplicationProfileTemplateUserReportBridge.EnsureLinkedUserReportTemplate(
                ObjectSpace,
                created,
                ApplicationProfileWizardTemplateCatalog.RootBoFromDataScope(created.DataScope));
        }
    }

    private static string FormatKind(ApplicationProfileTemplateKind kind) => kind switch
    {
        ApplicationProfileTemplateKind.Excel => "Excel",
        ApplicationProfileTemplateKind.PdfForm => "PDF form",
        _ => "Word",
    };

    private static string FormatDataScope(ApplicationProfileTemplateDataScope scope) => scope switch
    {
        ApplicationProfileTemplateDataScope.ApplicationHeader => "ApplicationProfileInstance header",
        ApplicationProfileTemplateDataScope.Both => "Header + M2M",
        _ => "People (M2M)",
    };
}
