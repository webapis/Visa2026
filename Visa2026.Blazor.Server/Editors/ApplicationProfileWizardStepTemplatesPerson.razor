@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization

<div class="ap-wizard__panel-head">
    <h2>@Msg("ApplicationProfile.Wizard.Step.Person")</h2>
    <p>@Msg("ApplicationProfile.Wizard.PersonIntro")</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.PersonRequired")</h3>
        <p class="ap-wizard__hint">@Msg("ApplicationProfile.Wizard.PersonHint")</p>
        <div class="ap-wizard__choices ap-wizard__choices--grid">
            <div class="ap-wizard__choice-cluster">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonPassport" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.Passport")</label>
                @if (Profile.RequirePersonPassport)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonPassportLastCount" disabled="@Disabled" title="@Msg("ApplicationProfile.Person.LastNTitle")">
                        <option value="1">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 1)</option>
                        <option value="2">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 2)</option>
                        <option value="3">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 3)</option>
                    </select>
                }
            </div>
            @if (ShowEducationToggle)
            {
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonEducation" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.Education")</label>
            }
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonPosition" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.Position")</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonAddressOfResidence" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.AddressOfResidence")</label>
            <div class="ap-wizard__choice-cluster">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonVisa" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.Visa")</label>
                @if (Profile.RequirePersonVisa)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonVisaLastCount" disabled="@Disabled" title="@Msg("ApplicationProfile.Person.LastNTitle")">
                        <option value="1">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 1)</option>
                        <option value="2">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 2)</option>
                        <option value="3">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 3)</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonInvitationItem" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.InvitationItem")</label>
                @if (Profile.RequirePersonInvitationItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonInvitationItemLastCount" disabled="@Disabled" title="@Msg("ApplicationProfile.Person.LastNTitle")">
                        <option value="1">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 1)</option>
                        <option value="2">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 2)</option>
                        <option value="3">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 3)</option>
                    </select>
                }
            </div>
            <div class="ap-wizard__choice-cluster">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonWorkPermitItem" disabled="@Disabled" @bind:after="OnWorkPermitItemChanged" /> @Msg("ApplicationProfile.Person.WorkPermitItem")</label>
                @if (Profile.RequirePersonWorkPermitItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonWorkPermitItemLastCount" disabled="@Disabled" title="@Msg("ApplicationProfile.Person.LastNTitle")">
                        <option value="1">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 1)</option>
                        <option value="2">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 2)</option>
                        <option value="3">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 3)</option>
                    </select>
                }
            </div>
            @if (ShowWorkPermitLocationToggle)
            {
                <label class="ap-wizard__choice"><input type="checkbox" checked="@Profile.RequireWorkPermitLocation" disabled="@(Disabled || Profile.ProduceWorkPermit)" @onchange="OnWorkPermitLocationChanged" /> @Field("WorkPermitLocation")</label>
            }
            <div class="ap-wizard__choice-cluster">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonBorderZoneItem" disabled="@Disabled" @bind:after="OnBorderZoneItemChanged" /> @Msg("ApplicationProfile.Person.BorderZoneItem")</label>
                @if (Profile.RequirePersonBorderZoneItem)
                {
                    <select class="ap-wizard__last-n" @bind="Profile.PersonBorderZoneItemLastCount" disabled="@Disabled" title="@Msg("ApplicationProfile.Person.LastNTitle")">
                        <option value="1">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 1)</option>
                        <option value="2">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 2)</option>
                        <option value="3">@VisaUiMessages.Format("ApplicationProfile.Person.LastN", 3)</option>
                    </select>
                }
            </div>
            @if (ShowBorderZoneToggle)
            {
                <label class="ap-wizard__choice"><input type="checkbox" checked="@Profile.RequireBorderZone" disabled="@(Disabled || Profile.ProduceInvitation || Profile.ProduceVisa)" @onchange="OnBorderZoneChanged" /> @Field("BorderZone")</label>
            }
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonSalary" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.Salary")</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonMedical" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.Medical")</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonRejectionItem" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.RejectionItem")</label>
            @if (ShowTravelHistoryToggle)
            {
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.RequirePersonTravelHistory" disabled="@Disabled" /> @Msg("ApplicationProfile.Person.TravelHistory")</label>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }

    protected override void OnParametersSet()
    {
        if (!ShowTravelHistoryToggle && Profile.RequirePersonTravelHistory)
            Profile.RequirePersonTravelHistory = false;
        if (!ShowEducationToggle && Profile.RequirePersonEducation)
            Profile.RequirePersonEducation = false;
        if (ShowWorkPermitLocationToggle)
            Profile.RequireWorkPermitLocation = true;
        if (ShowBorderZoneToggle)
            Profile.RequireBorderZone = true;
    }

    private bool ShowTravelHistoryToggle =>
        ApplicationProfileTravelHistoryPolicy.AllowsPersonTravelHistory(Profile);

    private bool ShowEducationToggle =>
        ApplicationProfileEducationPolicy.AllowsPersonEducation(Profile);

    private bool ShowWorkPermitLocationToggle =>
        Profile.ProduceWorkPermit && Profile.RequirePersonWorkPermitItem;

    private void OnWorkPermitItemChanged()
    {
        if (ShowWorkPermitLocationToggle)
            Profile.RequireWorkPermitLocation = true;
    }

    private void OnWorkPermitLocationChanged(ChangeEventArgs e)
    {
        if (Disabled || Profile.ProduceWorkPermit)
            return;
        Profile.RequireWorkPermitLocation = e.Value is bool b && b
            || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(e.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);
    }

    private bool ShowBorderZoneToggle =>
        Profile.RequirePersonBorderZoneItem
        && ApplicationProfileConfigurationResolver.EffectiveRequireBorderZone(Profile);

    private void OnBorderZoneItemChanged()
    {
        if (ShowBorderZoneToggle)
            Profile.RequireBorderZone = true;
    }

    private void OnBorderZoneChanged(ChangeEventArgs e)
    {
        if (Disabled || Profile.ProduceInvitation || Profile.ProduceVisa)
            return;
        Profile.RequireBorderZone = e.Value is bool b && b
            || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
            || string.Equals(e.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);

    private static string Field(string key) => ApplicationProfileLocalization.Field(key);
}
