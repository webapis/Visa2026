@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization

<div class="ap-wizard__panel-head">
    <h2>@Msg("ApplicationProfile.Wizard.Step.Process")</h2>
    <p>@Msg("ApplicationProfile.Wizard.ProcessIntro")</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__callout">
        @Msg("ApplicationProfile.Wizard.ProcessCallout")
    </div>
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.SlaTitle")</h3>
        <div class="ap-wizard__grid">
            @if (Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries)
            {
                <label class="ap-wizard__field">
                    <span>@Msg("ApplicationProfile.Wizard.MinistryDays")</span>
                    <input type="number" min="0" @bind="Profile.MinistrySlaDays" disabled="@Disabled" />
                </label>
            }
            <label class="ap-wizard__field">
                <span>@Msg("ApplicationProfile.Wizard.MigrationDays")</span>
                <input type="number" min="0" @bind="Profile.MigrationSlaDays" disabled="@Disabled" />
            </label>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }

    private static string Msg(string key) => VisaUiMessages.Get(key);
}
