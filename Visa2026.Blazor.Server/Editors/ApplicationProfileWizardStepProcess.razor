@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationProfileWizard

<div class="ap-wizard__panel-head">
    <h2>Process &amp; SLA</h2>
    <p>Progress states and expected process duration.</p>
</div>
<div class="ap-wizard__panel-body">
    @if (Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries)
    {
        <div class="ap-wizard__section">
            <h3>States related to ministry</h3>
            <p class="ap-wizard__hint">SLA track = include in duration tracking.</p>
            @RenderStateTable(ApplicationProfileProgressStateTrack.Ministry)
        </div>
    }

    <div class="ap-wizard__section">
        <h3>States related to migration service</h3>
        @RenderStateTable(ApplicationProfileProgressStateTrack.Migration)
    </div>

    <div class="ap-wizard__section">
        <h3>Expected process duration (SLA)</h3>
        <div class="ap-wizard__grid">
            @if (Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries)
            {
                <label class="ap-wizard__field">
                    <span>Ministry (days)</span>
                    <input type="number" min="0" @bind="Profile.MinistrySlaDays" disabled="@Disabled" />
                </label>
            }
            <label class="ap-wizard__field">
                <span>Migration (days)</span>
                <input type="number" min="0" @bind="Profile.MigrationSlaDays" disabled="@Disabled" />
            </label>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }

    private RenderFragment RenderStateTable(ApplicationProfileProgressStateTrack track) => builder =>
    {
        var settings = Profile.ProgressStateSettings?
            .Where(s => s.Track == track)
            .OrderBy(s => Array.FindIndex(
                ApplicationProfileProgressStateCatalog.All.Select(r => r.StateCode).ToArray(),
                code => string.Equals(code, s.StateCode, StringComparison.OrdinalIgnoreCase)))
            .ToList() ?? [];

        var seq = 0;
        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", "ap-wizard__table");
        builder.OpenElement(seq++, "thead");
        builder.OpenElement(seq++, "tr");
        foreach (var header in new[] { "Include", "State", "SLA track" })
        {
            builder.OpenElement(seq++, "th");
            builder.AddContent(seq++, header);
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(seq++, "tbody");
        foreach (var setting in settings)
        {
            builder.OpenElement(seq++, "tr");
            builder.OpenElement(seq++, "td");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "checked", setting.IsIncluded);
            builder.AddAttribute(seq++, "disabled", Disabled);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => setting.IsIncluded = ParseChecked(e)));
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "td");
            builder.AddContent(seq++, ApplicationProfileProgressStateSeeder.GetDisplayName(setting));
            builder.CloseElement();
            builder.OpenElement(seq++, "td");
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "checkbox");
            builder.AddAttribute(seq++, "checked", setting.IsSlaTracked);
            builder.AddAttribute(seq++, "disabled", Disabled || !setting.IsIncluded);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => setting.IsSlaTracked = ParseChecked(e)));
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    private static bool ParseChecked(ChangeEventArgs e) =>
        e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
}
