@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization

<div class="ap-wizard__panel-head">
    <h2>@Msg("ApplicationProfile.Wizard.Step.Identity")</h2>
    <p>@Msg("ApplicationProfile.Wizard.IdentityIntro")</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__callout">
        @Msg("ApplicationProfile.Wizard.LiveFkNote")
    </div>
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.NameSection")</h3>
        <div class="ap-wizard__grid">
            <label class="ap-wizard__field ap-wizard__field--full">
                <span>@Msg("ApplicationProfile.Wizard.ProfileName")</span>
                <input type="text" @bind="Profile.Name" @bind:event="oninput" @bind:after="NotifyNameChanged" disabled="@Disabled" />
            </label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.DirectedTo")</h3>
        <div class="ap-wizard__choices">
            <label class="ap-wizard__choice">
                <input type="radio" name="route" checked="@(Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries)"
                       disabled="@Disabled"
                       @onchange="@(() => SetRoute(ApplicationProfileInstanceProgressRouteKind.ViaMinistries))" />
                @Msg("ApplicationProfile.Route.ViaMinistry")
            </label>
            <label class="ap-wizard__choice">
                <input type="radio" name="route" checked="@(Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.DirectToMigrationService)"
                       disabled="@Disabled"
                       @onchange="@(() => SetRoute(ApplicationProfileInstanceProgressRouteKind.DirectToMigrationService))" />
                @Msg("ApplicationProfile.Wizard.DirectMigrationService")
            </label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.MayBeFor")</h3>
        <div class="ap-wizard__choices">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ForEmployee" disabled="@Disabled" /> @Msg("ApplicationProfile.Audience.Employee")</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ForFamilyMember" disabled="@Disabled" /> @Msg("ApplicationProfile.Audience.FamilyMember")</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ForTemporaryVisitor" disabled="@Disabled" /> @Msg("ApplicationProfile.Audience.TemporaryVisitor")</label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.RelatedTo")</h3>
        <div class="ap-wizard__choices">
            @foreach (var family in ActionFamilies)
            {
                var selected = family;
                <label class="ap-wizard__choice">
                    <input type="radio" name="actionFamily" checked="@(Profile.ActionFamily == selected)"
                           disabled="@Disabled"
                           @onchange="@(() => SetActionFamily(selected))" />
                    @FormatActionFamily(selected)
                </label>
            }
        </div>
        @if (ShowMayProduce)
        {
            <h3 class="ap-wizard__subhead">@Msg("ApplicationProfile.Wizard.MayProduce")</h3>
            <div class="ap-wizard__choices">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceInvitation" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Invitation")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceWorkPermit" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.WorkPermit")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceVisa" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Visa")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceBorderZone" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.BorderZone")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceRejection" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Rejection")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceWorkLocation" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.WorkLocation")</label>
            </div>
        }
        else if (ShowMayCancel)
        {
            <h3 class="ap-wizard__subhead">@Msg("ApplicationProfile.Wizard.MayCancel")</h3>
            <div class="ap-wizard__choices">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelInvitations" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Invitations")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelWorkPermits" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.WorkPermits")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelVisas" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Visas")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelBorderZonePermits" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.BorderZonePermits")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelApplicationProfileInstances" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Applications")</label>
            </div>
        }
        else if (ShowMayChange)
        {
            <h3 class="ap-wizard__subhead">@Msg("ApplicationProfile.Wizard.MayChange")</h3>
            <div class="ap-wizard__choices">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ChangeInvitations" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Invitations")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ChangeWorkPermits" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.WorkPermits")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ChangeVisas" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Visas")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ChangeBorderZonePermits" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.BorderZonePermits")</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ChangeApplicationProfileInstances" disabled="@Disabled" /> @Msg("ApplicationProfile.Doc.Applications")</label>
            </div>
        }
        else if (ShowRegistrationKind)
        {
            <h3 class="ap-wizard__subhead">@Msg("ApplicationProfile.Wizard.RegistrationIs")</h3>
            <div class="ap-wizard__choices">
                <label class="ap-wizard__choice">
                    <input type="radio" name="registrationKind"
                           checked="@(Profile.RegistrationKind == ApplicationProfileRegistrationKind.CheckIn)"
                           disabled="@Disabled"
                           @onchange="@(() => SetRegistrationKind(ApplicationProfileRegistrationKind.CheckIn))" />
                    @Msg("ApplicationProfile.RegistrationKind.CheckIn")
                </label>
                <label class="ap-wizard__choice">
                    <input type="radio" name="registrationKind"
                           checked="@(Profile.RegistrationKind == ApplicationProfileRegistrationKind.CheckOut)"
                           disabled="@Disabled"
                           @onchange="@(() => SetRegistrationKind(ApplicationProfileRegistrationKind.CheckOut))" />
                    @Msg("ApplicationProfile.RegistrationKind.CheckOut")
                </label>
                <label class="ap-wizard__choice">
                    <input type="radio" name="registrationKind"
                           checked="@(Profile.RegistrationKind == ApplicationProfileRegistrationKind.InfoChange)"
                           disabled="@Disabled"
                           @onchange="@(() => SetRegistrationKind(ApplicationProfileRegistrationKind.InfoChange))" />
                    @Msg("ApplicationProfile.RegistrationKind.InfoChange")
                </label>
                <label class="ap-wizard__choice">
                    <input type="radio" name="registrationKind"
                           checked="@(Profile.RegistrationKind == ApplicationProfileRegistrationKind.Extension)"
                           disabled="@Disabled"
                           @onchange="@(() => SetRegistrationKind(ApplicationProfileRegistrationKind.Extension))" />
                    @Msg("ApplicationProfile.RegistrationKind.Extension")
                </label>
            </div>
            <p class="ap-wizard__hint">@Msg("ApplicationProfile.Wizard.RegistrationHint")</p>
        }
        else
        {
            <p class="ap-wizard__hint">@Msg("ApplicationProfile.Wizard.BusinessTripHint")</p>
        }
    </div>
    <label class="ap-wizard__choice">
        <input type="checkbox" @bind="Profile.IsActive" disabled="@Disabled" /> @Msg("ApplicationProfile.Wizard.ActiveAvailable")
    </label>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback ClearLegsRequested { get; set; }
    [Parameter] public EventCallback NameChanged { get; set; }

    private static readonly ApplicationProfileActionFamily[] ActionFamilies =
    [
        ApplicationProfileActionFamily.Issuance,
        ApplicationProfileActionFamily.Cancellation,
        ApplicationProfileActionFamily.Change,
        ApplicationProfileActionFamily.Registration,
        ApplicationProfileActionFamily.BusinessTrip,
    ];

    private bool ShowMayProduce => Profile.ActionFamily == ApplicationProfileActionFamily.Issuance;
    private bool ShowMayCancel => Profile.ActionFamily == ApplicationProfileActionFamily.Cancellation;
    private bool ShowMayChange => Profile.ActionFamily == ApplicationProfileActionFamily.Change;
    private bool ShowRegistrationKind => Profile.ActionFamily == ApplicationProfileActionFamily.Registration;

    private Task NotifyNameChanged() => NameChanged.InvokeAsync();

    private async Task SetRoute(ApplicationProfileInstanceProgressRouteKind route)
    {
        if (Disabled || Profile.ProgressRoute == route)
            return;

        Profile.ProgressRoute = route;
        if (route != ApplicationProfileInstanceProgressRouteKind.ViaMinistries
            && ClearLegsRequested.HasDelegate)
        {
            await ClearLegsRequested.InvokeAsync();
        }

        if (route == ApplicationProfileInstanceProgressRouteKind.DirectToMigrationService)
            Profile.DefaultApprovalLegProfile = null;
    }

    private void SetActionFamily(ApplicationProfileActionFamily family)
    {
        if (Disabled || Profile.ActionFamily == family)
            return;

        Profile.ActionFamily = family;
        if (family != ApplicationProfileActionFamily.Issuance)
            ClearProduce();
        if (family != ApplicationProfileActionFamily.Cancellation)
            ClearCancel();
        if (family != ApplicationProfileActionFamily.Change)
            ClearChange();
        if (family != ApplicationProfileActionFamily.Registration)
            Profile.RegistrationKind = ApplicationProfileRegistrationKind.None;
        else if (Profile.RegistrationKind == ApplicationProfileRegistrationKind.None)
            Profile.RegistrationKind = ApplicationProfileRegistrationKind.CheckIn;
        ApplicationProfileRegistrationKindHelper.ApplyRegistrationPersonDefaults(Profile);
    }

    private void SetRegistrationKind(ApplicationProfileRegistrationKind kind)
    {
        if (Disabled || Profile.ActionFamily != ApplicationProfileActionFamily.Registration)
            return;

        Profile.RegistrationKind = kind;
    }

    private void ClearProduce()
    {
        Profile.ProduceInvitation = false;
        Profile.ProduceWorkPermit = false;
        Profile.ProduceVisa = false;
        Profile.ProduceBorderZone = false;
        Profile.ProduceRejection = false;
        Profile.ProduceWorkLocation = false;
    }

    private void ClearCancel()
    {
        Profile.CancelInvitations = false;
        Profile.CancelWorkPermits = false;
        Profile.CancelVisas = false;
        Profile.CancelBorderZonePermits = false;
        Profile.CancelApplicationProfileInstances = false;
    }

    private void ClearChange()
    {
        Profile.ChangeInvitations = false;
        Profile.ChangeWorkPermits = false;
        Profile.ChangeVisas = false;
        Profile.ChangeBorderZonePermits = false;
        Profile.ChangeApplicationProfileInstances = false;
    }

    private static string FormatActionFamily(ApplicationProfileActionFamily family) =>
        ApplicationProfileLocalization.ActionFamily(family);

    private static string Msg(string key) => VisaUiMessages.Get(key);
}
