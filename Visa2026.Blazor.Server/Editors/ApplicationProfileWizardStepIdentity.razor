@using Visa2026.Module.BusinessObjects

<div class="ap-wizard__panel-head">
    <h2>Identity &amp; purpose</h2>
    <p>Define who this profile is for and how applications created from it are directed.</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__callout">
        Applications reference this profile via a <strong>live FK</strong> (set only at create).
        Configuration stays editable until a linked application reaches lock state <strong>A</strong>.
    </div>
    <div class="ap-wizard__section">
        <h3>ApplicationProfileInstance name and description</h3>
        <div class="ap-wizard__grid">
            <label class="ap-wizard__field ap-wizard__field--full">
                <span>ApplicationProfileInstance name</span>
                <input type="text" @bind="Profile.Name" @bind:event="oninput" disabled="@Disabled" />
            </label>
            <label class="ap-wizard__field ap-wizard__field--full">
                <span>Description</span>
                <textarea @bind="Profile.Description" @bind:event="oninput" disabled="@Disabled"></textarea>
            </label>
            <label class="ap-wizard__field">
                <span>Code</span>
                <input type="text" @bind="Profile.Code" @bind:event="oninput" disabled="@Disabled" />
            </label>
            <label class="ap-wizard__field">
                <span>Selection / quick code</span>
                <input type="text" maxlength="3" @bind="Profile.SelectionCode" @bind:event="oninput" disabled="@Disabled" />
            </label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>Directed to</h3>
        <div class="ap-wizard__choices">
            <label class="ap-wizard__choice">
                <input type="radio" name="route" checked="@(Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries)"
                       disabled="@Disabled"
                       @onchange="@(() => SetRoute(ApplicationProfileInstanceProgressRouteKind.ViaMinistries))" />
                Via ministry
            </label>
            <label class="ap-wizard__choice">
                <input type="radio" name="route" checked="@(Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.DirectToMigrationService)"
                       disabled="@Disabled"
                       @onchange="@(() => SetRoute(ApplicationProfileInstanceProgressRouteKind.DirectToMigrationService))" />
                Direct migration service
            </label>
        </div>
        @if (ShowApprovalLegs)
        {
            <h3 class="ap-wizard__subhead">Approval legs</h3>
            <div class="ap-wizard__list">
                @if (Profile.ApprovalLegs?.Count > 0)
                {
                    @foreach (var leg in Profile.ApprovalLegs.OrderBy(l => l.Sequence ?? 0))
                    {
                        <div class="ap-wizard__list-row">
                            <span class="ap-wizard__list-ord">@(leg.Sequence ?? 0)</span>
                            <span>@(leg.ApprovingMinistry?.NameTm ?? "—")</span>
                            @if (!Disabled)
                            {
                                <button type="button" class="ap-wizard__link" @onclick="() => OnRemoveLeg.InvokeAsync(leg)">Remove</button>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="ap-wizard__hint">No embedded legs — ministry depth may fall back to ApplicationProfileInstance approval leg profile.</p>
                }
            </div>
            @if (!Disabled)
            {
                <div class="ap-wizard__add-leg">
                    <select @bind="_selectedMinistryId">
                        <option value="@Guid.Empty">Add approval leg…</option>
                        @foreach (var ministry in Ministries)
                        {
                            <option value="@ministry.ID">@(ministry.NameTm ?? ministry.Code)</option>
                        }
                    </select>
                    <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary" @onclick="AddSelectedLeg">Add</button>
                </div>
            }
        }
        else
        {
            <p class="ap-wizard__hint">Direct migration has no ministry approval legs.</p>
        }
    </div>
    <div class="ap-wizard__section">
        <h3>ApplicationProfileInstance may be for</h3>
        <div class="ap-wizard__choices">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ForEmployee" disabled="@Disabled" /> Employee</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ForFamilyMember" disabled="@Disabled" /> Family member</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ForTemporaryVisitor" disabled="@Disabled" /> Temporary visitor</label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>ApplicationProfileInstance related to</h3>
        <div class="ap-wizard__choices">
            @foreach (var family in ActionFamilies)
            {
                var selected = family;
                <label class="ap-wizard__choice">
                    <input type="radio" name="actionFamily" checked="@(Profile.ActionFamily == selected)"
                           disabled="@Disabled"
                           @onchange="@(() => SetActionFamily(selected))" />
                    @FormatActionFamily(selected)
                </label>
            }
        </div>
        @if (ShowMayProduce)
        {
            <h3 class="ap-wizard__subhead">May produce</h3>
            <div class="ap-wizard__choices">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceInvitation" disabled="@Disabled" /> Invitation</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceWorkPermit" disabled="@Disabled" /> Work permit</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceVisa" disabled="@Disabled" /> Visa</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceBorderZone" disabled="@Disabled" /> Border zone</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceRejection" disabled="@Disabled" /> Rejection</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceWorkLocation" disabled="@Disabled" /> Work location</label>
            </div>
        }
        else if (ShowMayCancel)
        {
            <h3 class="ap-wizard__subhead">May cancel existing</h3>
            <div class="ap-wizard__choices">
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelInvitations" disabled="@Disabled" /> Invitation(s)</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelWorkPermits" disabled="@Disabled" /> Work permit(s)</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelVisas" disabled="@Disabled" /> Visa(s)</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelBorderZonePermits" disabled="@Disabled" /> Border zone permit(s)</label>
                <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelApplicationProfileInstances" disabled="@Disabled" /> Application(s)</label>
            </div>
        }
        else
        {
            <p class="ap-wizard__hint">Registration and business-trip profiles do not issue or cancel documents here.</p>
        }
    </div>
    <div class="ap-wizard__section">
        <h3>Applicability scope (optional)</h3>
        <p class="ap-wizard__hint">A profile can be general, or narrowed with XAF criteria (e.g. project contract).</p>
        <div class="ap-wizard__scope">
            <button type="button" class="ap-wizard__scope-card @(_scopeMode == ScopeMode.Always ? "is-active" : null)"
                    disabled="@Disabled" @onclick="SetAlwaysScope">
                <h4>Always available</h4>
                <p>Officers can pick this profile for any new ApplicationProfileInstance matching audience and route.</p>
            </button>
            <button type="button" class="ap-wizard__scope-card @(_scopeMode == ScopeMode.Scoped ? "is-active" : null)"
                    disabled="@Disabled" @onclick="SetScopedMode">
                <h4>Scoped</h4>
                <p>Limit picker visibility with optional XAF criteria on ApplicationProfileInstance context.</p>
            </button>
        </div>
        @if (_scopeMode == ScopeMode.Scoped)
        {
            <label class="ap-wizard__field ap-wizard__field--full">
                <span>Applicability criteria</span>
                <textarea @bind="Profile.ApplicabilityCriteria" disabled="@Disabled" placeholder="Optional XAF criteria"></textarea>
            </label>
        }
    </div>
    <label class="ap-wizard__choice">
        <input type="checkbox" @bind="Profile.IsActive" disabled="@Disabled" /> Active (available in pickers)
    </label>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IReadOnlyList<ApprovingMinistry> Ministries { get; set; } = Array.Empty<ApprovingMinistry>();
    [Parameter] public EventCallback<Guid> OnAddLeg { get; set; }
    [Parameter] public EventCallback<ApplicationProfileApprovalLeg> OnRemoveLeg { get; set; }
    [Parameter] public EventCallback ClearLegsRequested { get; set; }

    private Guid _selectedMinistryId;

    private enum ScopeMode { Always, Scoped }

    private ScopeMode _scopeMode;

    protected override void OnParametersSet()
    {
        _scopeMode = string.IsNullOrWhiteSpace(Profile.ApplicabilityCriteria)
            ? ScopeMode.Always
            : ScopeMode.Scoped;
    }

    private static readonly ApplicationProfileActionFamily[] ActionFamilies =
    [
        ApplicationProfileActionFamily.Issuance,
        ApplicationProfileActionFamily.Cancellation,
        ApplicationProfileActionFamily.Registration,
        ApplicationProfileActionFamily.BusinessTrip,
    ];

    private bool ShowMayProduce => Profile.ActionFamily == ApplicationProfileActionFamily.Issuance;
    private bool ShowMayCancel => Profile.ActionFamily == ApplicationProfileActionFamily.Cancellation;
    private bool ShowApprovalLegs =>
        Profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries;

    private async Task SetRoute(ApplicationProfileInstanceProgressRouteKind route)
    {
        if (Disabled || Profile.ProgressRoute == route)
            return;

        Profile.ProgressRoute = route;
        if (route != ApplicationProfileInstanceProgressRouteKind.ViaMinistries
            && ClearLegsRequested.HasDelegate)
        {
            await ClearLegsRequested.InvokeAsync();
        }
    }

    private async Task AddSelectedLeg()
    {
        if (Disabled || !ShowApprovalLegs || _selectedMinistryId == Guid.Empty)
            return;

        await OnAddLeg.InvokeAsync(_selectedMinistryId);
        _selectedMinistryId = Guid.Empty;
    }

    private void SetActionFamily(ApplicationProfileActionFamily family)
    {
        if (Disabled || Profile.ActionFamily == family)
            return;

        Profile.ActionFamily = family;
        if (family != ApplicationProfileActionFamily.Issuance)
            ClearProduce();
        if (family != ApplicationProfileActionFamily.Cancellation)
            ClearCancel();
    }

    private void ClearProduce()
    {
        Profile.ProduceInvitation = false;
        Profile.ProduceWorkPermit = false;
        Profile.ProduceVisa = false;
        Profile.ProduceBorderZone = false;
        Profile.ProduceRejection = false;
        Profile.ProduceWorkLocation = false;
    }

    private void ClearCancel()
    {
        Profile.CancelInvitations = false;
        Profile.CancelWorkPermits = false;
        Profile.CancelVisas = false;
        Profile.CancelBorderZonePermits = false;
        Profile.CancelApplicationProfileInstances = false;
    }

    private void SetAlwaysScope()
    {
        _scopeMode = ScopeMode.Always;
        Profile.ApplicabilityCriteria = null;
    }

    private void SetScopedMode() => _scopeMode = ScopeMode.Scoped;

    private static string FormatActionFamily(ApplicationProfileActionFamily family) => family switch
    {
        ApplicationProfileActionFamily.Cancellation => "Cancellation",
        ApplicationProfileActionFamily.Registration => "Registration",
        ApplicationProfileActionFamily.BusinessTrip => "Business trip",
        _ => "Issuance",
    };
}
