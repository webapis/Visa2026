@namespace Visa2026.Blazor.Server.Editors
@using Microsoft.AspNetCore.Components.Forms
@using Visa2026.Module.Services.TemplateScan
@using Visa2026.Module.Localization
@using Visa2026.Blazor.Server.Localization
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.AspNetCore.Http

<div class="tas-clarify @(Compact ? "tas-clarify--compact" : null)">
    @if (ShowRejectBanner)
    {
        <div class="tas-banner tas-banner--warn">
            @RejectBannerText
        </div>
    }

    <div class="tas-chat @(Compact ? "tas-chat--compact" : null)">
        <h4>@(Compact && !string.IsNullOrWhiteSpace(FocusCaption) ? Msg("TemplateScan.Chat.AskMark") : Msg("TemplateScan.Chat.Clarify"))</h4>
        @if (!string.IsNullOrWhiteSpace(FocusCaption))
        {
            <p class="tas-chat__focus">@FocusCaption</p>
        }
        <p class="tas-chat__hint">@(Compact && !string.IsNullOrWhiteSpace(FocusCaption)
            ? Msg("TemplateScan.Chat.HintCompact")
            : Msg("TemplateScan.Chat.HintFull"))</p>

        <div class="tas-chat__log">
            @if (Messages.Count == 0)
            {
                <p class="tas-chat__empty">@Msg("TemplateScan.Chat.Empty")</p>
            }
            else
            {
                @foreach (var msg in Messages)
                {
                    <div class="@MessageCss(msg)">
                        @if (!msg.IsOfficer)
                        {
                            <span class="tas-msg__avatar" aria-hidden="true">AI</span>
                        }
                        <div class="tas-msg__body">@msg.Text</div>
                    </div>
                }
            }
        </div>

        @if (QuickReplies.Count > 0)
        {
            <div class="tas-quick-replies">
                @foreach (var reply in QuickReplies)
                {
                    <button type="button" class="tas-btn tas-btn--secondary" disabled="@Busy" @onclick="() => OnQuickReplyClicked(reply)">
                        @reply
                    </button>
                }
            </div>
        }

        @if (OfficerImageNames.Count > 0)
        {
            <ul class="tas-chat__attach-list">
                @foreach (var name in OfficerImageNames)
                {
                    <li class="tas-chat__attach-chip">
                        <span>@name</span>
                        <button type="button"
                                class="tas-row-remove"
                                disabled="@Busy"
                                title="@FormatMsg("TemplateScan.Chat.Remove", name)"
                                @onclick="() => OnClearImage.InvokeAsync(name)">×</button>
                    </li>
                }
            </ul>
        }

        <div class="tas-chat__compose">
            <label class="tas-chat__attach">
                <InputFile accept=".png,.jpg,.jpeg,image/png,image/jpeg"
                           OnChange="OnImageFile"
                           disabled="@Busy" />
                @Msg("TemplateScan.Chat.Attach")
            </label>
            <input class="tas-input" placeholder="@Msg("TemplateScan.Chat.InputPlaceholder")"
                   value="@InputText"
                   disabled="@Busy"
                   @oninput="OnInputChanged"
                   @onkeydown="OnKeyDown" />
            <button type="button" class="tas-btn tas-btn--primary" disabled="@(!CanSend)" @onclick="OnSendClicked">
                @Msg("TemplateScan.Chat.Send")
            </button>
        </div>
    </div>

    <p class="tas-clarify__back">
        <button type="button" class="tas-link" @onclick="OnBackClicked">@(Compact ? Msg("TemplateScan.Btn.HideChat") : Msg("TemplateScan.Chat.Back"))</button>
    </p>
</div>

@code {
    public sealed record ChatMessage(bool IsOfficer, string Text, bool Refused);

    [Parameter] public IReadOnlyList<ChatMessage> Messages { get; set; } = Array.Empty<ChatMessage>();
    [Parameter] public IReadOnlyList<string> QuickReplies { get; set; } = Array.Empty<string>();
    [Parameter] public string InputText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> InputTextChanged { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ShowRejectBanner { get; set; }
    [Parameter] public string RejectBannerText { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSend { get; set; }
    [Parameter] public EventCallback<string> OnQuickReply { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? FocusCaption { get; set; }
    [Parameter] public IReadOnlyList<string> OfficerImageNames { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnImageFile { get; set; }
    [Parameter] public EventCallback<string> OnClearImage { get; set; }

    [Inject] private IXafCultureInfoService CultureInfoService { get; set; } = null!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;

    private string EffectiveUiCulture =>
        VisaUiCultureResolver.Resolve(CultureInfoService, HttpContextAccessor.HttpContext);

    private string Msg(string key) => VisaUiMessages.Get(key, EffectiveUiCulture);

    private string FormatMsg(string key, params object[] args) =>
        VisaUiMessages.FormatForCulture(EffectiveUiCulture, key, args);

    private bool CanSend =>
        !Busy && (!string.IsNullOrWhiteSpace(InputText) || OfficerImageNames.Count > 0);

    private static string MessageCss(ChatMessage msg)
    {
        var cls = msg.IsOfficer ? "tas-msg tas-msg--officer" : "tas-msg tas-msg--assistant";
        if (msg.Refused)
            cls += " is-refused";
        return cls;
    }

    private Task OnInputChanged(ChangeEventArgs e) =>
        InputTextChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSend)
            await OnSend.InvokeAsync();
    }

    private Task OnSendClicked() => OnSend.InvokeAsync();

    private Task OnQuickReplyClicked(string reply) => OnQuickReply.InvokeAsync(reply);

    private Task OnBackClicked() => OnBack.InvokeAsync();
}
