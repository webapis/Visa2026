    public async Task OpenForProfileAsync(ApplicationProfile profile, IObjectSpace objectSpace)
    {
        ArgumentNullException.ThrowIfNull(profile);
        ArgumentNullException.ThrowIfNull(objectSpace);

        Reset();
        _source = EntrySource.Profile;
        _hostObjectSpace = objectSpace;
        _hostProfile = profile;
        _profileId = profile.ID;
        _profileName = profile.Name ?? string.Empty;
        _configLocked = ApplicationProfileLockHelper.IsProfileConfigLocked(profile, objectSpace);
        _instanceOptions = LoadInstanceOptions(profile, objectSpace);
        BindApplicabilityFromProfile(profile, objectSpace);
        _aiEnabled = Options.Value.Enabled && ScanAiProvider.IsEnabled;

        _open = true;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenAsync(Guid applicationProfileInstanceId, string caseNumber)
    {
        Reset();
        _source = EntrySource.Instance;
        _caseNumber = caseNumber ?? string.Empty;
        _selectedInstanceId = applicationProfileInstanceId;
        _scanKind = ScanKind.FilledSample;

        using (var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileInstance>())
        {
            var instance = objectSpace.GetObjectByKey<ApplicationProfileInstance>(applicationProfileInstanceId);
            var profile = instance?.ApplicationProfile;
            if (profile == null)
            {
                _message = "This case has no application profile.";
                _messageIsError = true;
            }
            else
            {
                _profileId = profile.ID;
                _profileName = profile.Name ?? string.Empty;
                _configLocked = ApplicationProfileLockHelper.IsProfileConfigLocked(profile, objectSpace);
                BindApplicabilityFromInstance(instance, profile, objectSpace);
            }
        }

        _aiEnabled = Options.Value.Enabled && ScanAiProvider.IsEnabled;
        _open = true;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenForExistingTemplateAsync(
        Guid applicationProfileInstanceId,
        string caseNumber,
        byte[] content,
        string fileName,
        string templateName,
        ApplicationProfileTemplateDataScope dataScope,
        ApplicationProfileTemplateCatalogScope catalogScope,
        Guid? applicableProjectContractId = null,
        Guid? applicableMigrationServiceId = null,
        bool fromYellowSource = false,
        string? reviewPlanJson = null,
        byte[]? mappedTemplateBytes = null)
    {
        ArgumentNullException.ThrowIfNull(content);
        if (content.Length == 0)
            throw new ArgumentException("Template file has no content.", nameof(content));

        await OpenAsync(applicationProfileInstanceId, caseNumber);
        _reviewFromYellowSource = fromYellowSource;
        _yellowSourceBytes = fromYellowSource && content.Length > 0 ? content : null;
        _reviewPlanJson = reviewPlanJson;
        _mappedTemplateBytes = mappedTemplateBytes is { Length: > 0 } ? mappedTemplateBytes : null;
        _fileBytes = content;
        _fileName = string.IsNullOrWhiteSpace(fileName)
            ? (string.IsNullOrWhiteSpace(templateName) ? "template.docx" : templateName + ".docx")
            : fileName;
        _templateName = templateName?.Trim() ?? string.Empty;
        _editingOriginalName = _templateName;
        _dataScope = dataScope;
        _catalogScope = catalogScope;
        _applicabilityId = FormatApplicabilityId(applicableProjectContractId, applicableMigrationServiceId);
        await RestoreApprovedReviewAsync();
    }

    private static IReadOnlyList<InstanceOption> LoadInstanceOptions(ApplicationProfile profile, IObjectSpace objectSpace)
    {
        if (profile.ID == Guid.Empty)
            return Array.Empty<InstanceOption>();

        return objectSpace.GetObjects<ApplicationProfileInstance>(
                CriteriaOperator.Parse("ApplicationProfile.ID = ?", profile.ID))
            .OrderByDescending(static i => i.ApplicationDate)
            .Take(25)
            .Select(static i => new InstanceOption(
                i.ID,
                string.IsNullOrWhiteSpace(i.FullApplicationNumber)
                    ? $"{i.ApplicationDate:dd.MM.yyyy}"
                    : $"{i.FullApplicationNumber} · {i.ApplicationDate:dd.MM.yyyy}"))
            .ToList();
    }

