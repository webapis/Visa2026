@namespace Visa2026.Blazor.Server.Editors
@using DevExpress.Data.Filtering
@using DevExpress.ExpressApp
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using System.Text.Json.Serialization
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationProfileWizard
@using Visa2026.Module.Services.RuntimeLogging
@using Visa2026.Module.Services.TemplateConvert
@using Visa2026.Module.Services.TemplateScan
@using Visa2026.Module.Services
@using Visa2026.Module.Services.UserReports

@* Officer-facing scan-to-template modal (S3). Interaction contract: docs/TEMPLATE_AI_SCAN_UI_FLOW.md. *@

@if (_open)
{
    <div class="tas-backdrop" @onclick="RequestCloseAsync">
        <div class="tas-modal @ModalWidthClass"
             role="dialog" aria-modal="true" aria-labelledby="tas-title" @onclick:stopPropagation="true">
            <header class="tas-modal__head">
                <div>
                    <h2 id="tas-title">@(IsEditingExisting ? "Review placeholders" : "Create template from yellow marks")</h2>
                    <p>@_profileName@(string.IsNullOrEmpty(_caseNumber) ? string.Empty : " · case " + _caseNumber)</p>
                </div>
                <button type="button" class="tas-icon-btn" aria-label="Close" @onclick="RequestCloseAsync">&#10005;</button>
            </header>

            <ol class="tas-stepper">
                @foreach (var step in StepLabels)
                {
                    <li class="tas-stepper__item @StepCssClass(step.Index)">
                        <span class="tas-stepper__dot">@StepMark(step.Index)</span>
                        <span>@step.Label</span>
                    </li>
                }
            </ol>

            <div class="tas-modal__body">
                @if (_stage == Stage.Upload)
                {
                    <div class="tas-form @(_busy ? "is-busy" : null)">
                        <div class="tas-field">
                            <label class="tas-field__label" for="tas-name">Template name <em>*</em></label>
                            <input id="tas-name" class="tas-input" value="@_templateName"
                                   @oninput="e => _templateName = e.Value?.ToString() ?? string.Empty" />
                        </div>

                        <div class="tas-field">
                            <span class="tas-field__label">
                                Save to
                                <button type="button" class="tas-tip" data-tip="@SaveToHint" aria-label="@SaveToHint">?</button>
                            </span>
                            <label class="tas-radio">
                                <input type="radio" name="tas-scope" checked="@(_catalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific)"
                                       @onchange="() => _catalogScope = ApplicationProfileTemplateCatalogScope.ProfileSpecific" />
                                <span>This profile only</span>
                            </label>
                            <label class="tas-radio">
                                <input type="radio" name="tas-scope" checked="@(_catalogScope == ApplicationProfileTemplateCatalogScope.Global)"
                                       @onchange="() => _catalogScope = ApplicationProfileTemplateCatalogScope.Global" />
                                <span>Shared catalog</span>
                            </label>
                            @if (_catalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific)
                            {
                                <div class="tas-field tas-field--nested">
                                    <span class="tas-field__label">
                                        @ApplicabilityTitle
                                        <button type="button" class="tas-tip" data-tip="@ApplicabilityHint" aria-label="@ApplicabilityHint">?</button>
                                    </span>
                                    <select class="tas-input" value="@_applicabilityId" @onchange="OnApplicabilityChanged">
                                        <option value="">@ApplicabilityEmptyLabel</option>
                                        @foreach (var item in _applicabilityLookups)
                                        {
                                            <option value="@item.Id.ToString("D")">@item.DisplayName</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        @if (_source != EntrySource.Instance)
                        {
                            <div class="tas-field">
                                <span class="tas-field__label">
                                    Case <em>*</em>
                                    <button type="button" class="tas-tip" data-tip="@CaseHint" aria-label="@CaseHint">?</button>
                                </span>
                                @if (_instanceOptions.Count == 0)
                                {
                                    <p class="tas-banner tas-banner--fail" style="margin:0">
                                        No cases on this profile yet. Add a case first to open the template wizard.
                                    </p>
                                }
                                else
                                {
                                    <select id="tas-instance" class="tas-input" value="@_selectedInstanceId" @onchange="OnInstanceChanged">
                                        <option value="@Guid.Empty">Choose a case…</option>
                                        @foreach (var option in _instanceOptions)
                                        {
                                            <option value="@option.Id">@option.Label</option>
                                        }
                                    </select>
                                }
                            </div>
                        }

                        <div class="tas-field">
                            <span class="tas-field__label">
                                File <em>*</em>
                                <button type="button" class="tas-tip" data-tip="@FileHint" aria-label="@FileHint">?</button>
                            </span>
                            <label class="tas-drop @(_fileBytes is { Length: > 0 } ? "is-picked" : string.Empty)">
                                <InputFile id="tas-file" OnChange="OnFileSelectedAsync" accept=".docx,.xlsx" />
                                @if (_fileBytes is { Length: > 0 })
                                {
                                    <strong>@_fileName</strong>
                                    <small>@($"{_fileBytes.Length / 1024:N0} KB")</small>
                                }
                                else
                                {
                                    <strong>Drop Word or Excel here</strong>
                                    <small>.docx / .xlsx with yellow marks</small>
                                }
                            </label>
                            @if (IsEditingExisting)
                            {
                                <small>Upload the yellow-marked Word/Excel. Saved Short codes stay; this page is only to attach the original highlights.</small>
                            }
                        </div>

                        @if (false && _pdfPageCount > 1)
                        {
                            <div class="tas-field">
                                <span class="tas-field__label">PDF pages (@_pdfPageCount total · pick up to @Options.Value.MaxPdfPages)</span>
                                <div class="tas-pdf-pages">
                                    @for (var page = 1; page <= _pdfPageCount; page++)
                                    {
                                        var selected = _selectedPdfPages.Contains(page);
                                        <label class="tas-pdf-page @(selected ? "is-on" : string.Empty)">
                                            <input type="checkbox" checked="@selected" @onchange="e => TogglePdfPage(page, e)" hidden />
                                            <span class="tas-pdf-page__thumb"></span>
                                            <span>Page @(page)</span>
                                        </label>
                                    }
                                </div>
                                <small>@SelectedPdfPagesSummary</small>
                            </div>
                        }
                    </div>
                }
                else if (_stage == Stage.ScanFail && _ingest is { } failedIngest)
                {
                    <div class="tas-fail-panel">
                        <h3>@(IsEditingExisting ? "This template cannot be reviewed" : "Scan quality check failed")</h3>
                        <p>@(IsEditingExisting
                            ? "The catalog file has no yellow highlights and no library placeholders to remap."
                            : "This scan cannot be turned into a template yet. Try a sharper photo, higher resolution, or a different file.")</p>
                        <ul class="tas-issues" style="width:100%;text-align:left">
                            @foreach (var issue in failedIngest.Suitability.Issues)
                            {
                                <li class="tas-issue tas-issue--fail">@issue.Message</li>
                            }
                        </ul>
                    </div>
                }
                else if (_stage == Stage.FieldReview && _ingest is { } ingest && _fieldPlan is { } plan)
                {
                    @if (RequiresLowConfidenceAck)
                    {
                        <div class="tas-banner tas-banner--warn">
                            Some fields have low confidence or the scan quality is borderline. Review boxes on the scan and acknowledge before continuing.
                        </div>
                    }

                    @if (IsEditingExisting)
                    {
                        <div class="tas-form" style="margin-bottom:0.75rem">
                            <div class="tas-field">
                                <label class="tas-field__label" for="tas-review-name">Template name <em>*</em></label>
                                <input id="tas-review-name" class="tas-input" value="@_templateName"
                                       @oninput="e => _templateName = e.Value?.ToString() ?? string.Empty" />
                                @if (IsLockedExistingOverwrite)
                                {
                                    <small>Profile is locked — Approve updates this file. Change the name only to save a new catalog copy.</small>
                                }
                            </div>
                        </div>
                    }

                    @if (IsEditingExisting && !_reviewFromYellowSource)
                    {
                        <div class="tas-banner tas-banner--warn">
                            The yellow-marked original is not stored for this catalog file, so this page shows mapped placeholders.
                            Click <strong>Upload different file</strong> and choose the yellow Word/Excel — saved Short codes stay.
                        </div>
                    }

                    <TemplateScanFieldReviewView FieldPlan="plan"
                                                 Pages="ingest.Input.Pages"
                                                 FileName="@_fileName"
                                                 SuitabilityVerdict="ingest.Suitability.Verdict"
                                                 IsOfficeSource="ingest.Input.IsOfficeSource"
                                                 OfficePackageBytes="ingest.Input.OfficePackageBytes"
                                                 SourceKind="ingest.Input.SourceKind"
                                                 @bind-ActivePageIndex="_reviewPageIndex"
                                                 @bind-HoveredFieldId="_hoveredFieldId"
                                                 @bind-SelectedFieldId="_reviewSelectedFieldId"
                                                 FieldPlanChanged="OnOfficerFieldPlanChanged"
                                                 AskAiEnabled="_aiEnabled"
                                                 AskAi="OpenReviewChat" />

                    @if (_reviewChatOpen)
                    {
                        <div class="tas-review-chat">
                            <TemplateScanClarificationView Compact="true"
                                                         FocusCaption="@ReviewChatFocusCaption"
                                                         Messages="_chatMessages"
                                                         QuickReplies="_quickReplies"
                                                         InputText="@_chatInput"
                                                         InputTextChanged="OnChatInputChanged"
                                                         Busy="_chatBusy"
                                                         ShowRejectBanner="_chatRejectBanner"
                                                         RejectBannerText="@_chatRejectText"
                                                         OfficerImageNames="ChatOfficerImageNames"
                                                         OnImageFile="OnChatImageSelectedAsync"
                                                         OnClearImage="OnChatImageCleared"
                                                         OnSend="SendChatAsync"
                                                         OnQuickReply="SendQuickReplyAsync"
                                                         OnBack="HideReviewChat" />
                        </div>
                    }

                    @if (RequiresLowConfidenceAck)
                    {
                        <label class="tas-ack">
                            <input type="checkbox" checked="@_acknowledgedWarnings"
                                   @onchange="e => _acknowledgedWarnings = (bool?)e.Value == true" />
                            <span><strong>I reviewed the warnings</strong> and want to continue with this field plan.</span>
                        </label>
                    }
                }
                else if (_stage == Stage.Clarification && _fieldPlan is { } chatPlan && _ingest is { } chatIngest)
                {
                    <TemplateScanClarificationView Messages="_chatMessages"
                                                 QuickReplies="_quickReplies"
                                                 InputText="@_chatInput"
                                                 InputTextChanged="OnChatInputChanged"
                                                 Busy="_chatBusy"
                                                 ShowRejectBanner="_chatRejectBanner"
                                                 RejectBannerText="@_chatRejectText"
                                                 OfficerImageNames="ChatOfficerImageNames"
                                                 OnImageFile="OnChatImageSelectedAsync"
                                                 OnClearImage="OnChatImageCleared"
                                                 OnSend="SendChatAsync"
                                                 OnQuickReply="SendQuickReplyAsync"
                                                 OnBack="BackToFieldReview" />
                }
                else if (_stage == Stage.Generating)
                {
                    <div class="tas-generating">
                        <h3>Building draft template…</h3>
                        <p>@(IsOfficeUpload ? "Writing library tokens into your yellow-marked Word/Excel file…" : "Turning the reviewed field plan into a merge template…") Extract/Validate runs next.</p>
                        <div class="tas-progress"><div class="tas-progress__bar tas-progress__bar--indeterminate"></div></div>
                    </div>
                }
                else if (_stage == Stage.NeedsHelp && _fieldPlan is { } helpPlan)
                {
                    <TemplateScanGapHelpView Gaps="helpPlan.Gaps"
                                             UnmappedFields="UnmappedDetectedFields"
                                             ValidationIssues="_outcome?.Validation.Issues ?? Array.Empty<TemplateValidationIssue>()"
                                             ScanFileName="@_fileName"
                                             ProfileName="@_profileName"
                                             InstanceLabel="@HelpInstanceLabel" />
                }
                else if (_stage == Stage.Preview && _outcome is { } outcome)
                {
                    @if (IsEditingExisting)
                    {
                        <div class="tas-form" style="margin-bottom:0.75rem">
                            <div class="tas-field">
                                <label class="tas-field__label" for="tas-preview-name">Template name <em>*</em></label>
                                <input id="tas-preview-name" class="tas-input" value="@_templateName"
                                       @oninput="e => _templateName = e.Value?.ToString() ?? string.Empty" />
                                @if (IsLockedExistingOverwrite)
                                {
                                    <small>Profile is locked — Approve updates this file. Change the name only to save a new catalog copy.</small>
                                }
                            </div>
                        </div>
                    }
                    <TemplateScanPreviewView Outcome="outcome"
                                             TemplateName="@_templateName"
                                             ShowWarningAcknowledgement="outcome.HasWarnings && !outcome.HasErrors"
                                             @bind-WarningAcknowledged="_previewAcknowledgedWarnings" />
                }
                else if (_stage == Stage.Done)
                {
                    <div class="tas-done">
                        <div class="tas-done__main">
                            <div class="tas-done__icon">&#10003;</div>
                            <h3>@(_source == EntrySource.Profile ? "Template added to the profile" : "Template saved")</h3>
                            <p>
                                @(_source == EntrySource.Profile
                                    ? "It is in the profile's template list. Press Save profile to keep it."
                                    : "It is now in the Resminamalar catalog for this case.")
                            </p>
                            <table class="tas-done__table">
                                <tbody>
                                    <tr><th>Template</th><td>@_savedTemplateName</td></tr>
                                    <tr><th>Profile</th><td>@_profileName</td></tr>
                                    <tr><th>Available in</th><td>@(_catalogScope == ApplicationProfileTemplateCatalogScope.Global ? "Shared catalog" : "This profile only")</td></tr>
                                    @if (_catalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific)
                                    {
                                        <tr><th>Visible for</th><td>@ApplicabilitySummary</td></tr>
                                    }
                                    @if (_outcome is { } saved)
                                    {
                                        <tr><th>Placeholders</th><td>@saved.EmittedTokens.Count</td></tr>
                                    }
                                </tbody>
                            </table>
                            @if (_source == EntrySource.Profile && OnFocusSavedTemplate.HasDelegate)
                            {
                                <p class="tas-done__actions">
                                    <button type="button" class="tas-link" @onclick="FocusSavedTemplateAsync">View in template list</button>
                                </p>
                            }
                        </div>
                        <aside class="tas-done__note">
                            <h4>Next</h4>
                            <p>Select it in the catalog to generate, or open it with <strong>Edit template</strong> to adjust wording in Word or Excel.</p>
                        </aside>
                    </div>
                }
            </div>

            <footer class="tas-foot">
                @if ((_stage == Stage.Upload || _stage == Stage.FieldReview) && _busy)
                {
                    <div class="tas-analyze" role="status" aria-live="polite">
                        <div class="tas-progress tas-progress--foot">
                            <div class="tas-progress__bar tas-progress__bar--indeterminate"></div>
                        </div>
                        <span>@_analyzeStatus</span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_message))
                {
                    <span class="tas-foot__hint" style="@(_messageIsError ? "color:#b91c1c" : string.Empty)">@_message</span>
                }
                else if (_busy && _stage == Stage.Generating)
                {
                    <span class="tas-foot__hint">Generating draft…</span>
                }
                else if (_busy)
                {
                    <span class="tas-foot__hint">@(string.IsNullOrWhiteSpace(_analyzeStatus) ? "Analyzing scan…" : _analyzeStatus)</span>
                }
                else if (_stage == Stage.FieldReview)
                {
                    <span class="tas-foot__hint">@(IsEditingExisting
                            ? (_restoredApprovedReview
                                ? (_reviewFromYellowSource
                                    ? "Saved placeholders are restored. Change a Short code if needed, or unlock a row and click Remap unmarked. Continue saves without re-guessing."
                                    : "Saved placeholders are restored, but the left page is the mapped catalog file. Upload the yellow-marked Word/Excel to see highlighted samples — Short codes stay.")
                                : (_reviewFromYellowSource
                                    ? "Numbered marks are the yellow source saved with this catalog template. Lock reviewed rows, then Remap unmarked to re-guess the rest. × removes a redundant row. Comma combinations stay 6.1 / 6.2 / 6.3."
                                    : "Numbered marks are the placeholders already in this catalog template. Lock reviewed rows, then Remap unmarked to re-guess the rest. × removes a redundant row. Comma combinations stay 6.1 / 6.2 / 6.3."))
                        : "Lock correct rows. Tick leftover yellows and/or wrong placeholders, then Remap unmarked. Locked Short codes stay. Click a row to add Short codes.")</span>
                }
                else
                {
                    <span class="tas-foot__grow"></span>
                }

                @if (_stage == Stage.Upload)
                {
                    <div class="tas-foot__actions">
                        <button type="button" class="tas-btn tas-btn--ghost" disabled="@_busy" @onclick="RequestCloseAsync">Cancel</button>
                        <button type="button" class="tas-btn tas-btn--primary" disabled="@(!CanAnalyze)" @onclick="AnalyzeAsync">
                            @(_busy
                                ? "Opening…"
                                : (IsEditingExisting && !string.IsNullOrWhiteSpace(_reviewPlanJson)
                                    ? "Open yellow file"
                                    : "Analyze file"))
                        </button>
                    </div>
                }
                else if (_stage == Stage.ScanFail)
                {
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="RequestCloseAsync">Cancel</button>
                    <button type="button" class="tas-btn tas-btn--primary" @onclick="BackToUpload">Upload different file</button>
                }
                else if (_stage == Stage.FieldReview)
                {
                    <fieldset class="tas-remap-hints" disabled="@_busy" title="@(_aiEnabled ? "Hints go to Remap unmarked. Locked rows stay." : "AI is off — remap still re-guesses unlocked yellows locally.")">
                        <label class="tas-remap-hint">
                            <input type="checkbox" @bind="_remapHintUnidentified" />
                            Unidentified yellows remain
                        </label>
                        <label class="tas-remap-hint">
                            <input type="checkbox" @bind="_remapHintIncorrect" />
                            Some placeholders are wrong
                        </label>
                    </fieldset>
                    <button type="button" class="tas-btn tas-btn--ghost" disabled="@_busy" @onclick="BackToUpload">Upload different file</button>
                    @if (ShowNeedsHelpEntry)
                    {
                        <button type="button" class="tas-btn tas-btn--ghost" @onclick="OpenHelp">Needs help</button>
                    }
                    @if (_reviewChatOpen)
                    {
                        <button type="button" class="tas-btn tas-btn--ghost" disabled="@_busy" @onclick="HideReviewChat">Hide chat</button>
                    }
                    else
                    {
                        <button type="button" class="tas-btn tas-btn--secondary" disabled="@(_busy || !_aiEnabled)" @onclick="OpenClarification" title="@(!_aiEnabled ? "Clarification chat needs a TemplateAiScan AI provider" : null)">Ask for clarification</button>
                    }
                    <button type="button"
                            class="tas-btn tas-btn--secondary"
                            disabled="@(!CanRemapUnmarked)"
                            title="Re-guess placeholders on yellows that are not locked. Tick the checkboxes first if yellows were missed or unlocked Short codes are wrong."
                            @onclick:stopPropagation="true"
                            @onclick="RemapUnlockedAsync">@(_busy && _stage == Stage.FieldReview ? "Remapping…" : "Remap unmarked")</button>
                    <button type="button" class="tas-btn tas-btn--primary" disabled="@(!CanContinue)" @onclick:stopPropagation="true" @onclick="GenerateAsync">Continue</button>
                }
                else if (_stage == Stage.Clarification)
                {
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="BackToFieldReview">Back to field list</button>
                    <button type="button" class="tas-btn tas-btn--primary" disabled="@(!CanContinueFromChat)" @onclick="GenerateAsync">Continue to generate</button>
                }
                else if (_stage == Stage.Preview && _outcome is { })
                {
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="BackToFieldReview">Back to field list</button>
                    @if (ShowNeedsHelpEntry)
                    {
                        <button type="button" class="tas-btn tas-btn--ghost" @onclick="OpenHelp">Needs help</button>
                    }
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="GenerateAsync">Regenerate</button>
                    <button type="button" class="tas-btn tas-btn--primary" disabled="@(!CanApprove)" @onclick="ApproveAsync">Approve — save to profile</button>
                }
                else if (_stage == Stage.NeedsHelp)
                {
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="CloseHelp">Back</button>
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="DownloadGapPacketMarkdownAsync">Download Markdown</button>
                    <button type="button" class="tas-btn tas-btn--primary" @onclick="DownloadGapPacketJsonAsync">Download gap packet</button>
                    @if (CanApproveFromHelp)
                    {
                        <button type="button" class="tas-btn tas-btn--secondary" disabled="@(!CanApprove)" @onclick="ApproveAsync">Approve anyway</button>
                    }
                }
                else if (_stage == Stage.Done)
                {
                    <button type="button" class="tas-btn tas-btn--ghost" @onclick="ScanAnother">Mark another file</button>
                    <button type="button" class="tas-btn tas-btn--primary" @onclick="CloseAsync">Close</button>
                }
            </footer>

            @if (_discardPrompt)
            {
                <div class="tas-confirm">
                    <div class="tas-confirm__box">
                        <h3>Discard this scan?</h3>
                        <ul>
                            <li>The uploaded scan and detected fields are dropped.</li>
                            <li>Nothing has been saved to the profile yet.</li>
                        </ul>
                        <div class="tas-confirm__actions">
                            <button type="button" class="tas-btn tas-btn--ghost" @onclick="() => _discardPrompt = false">Keep working</button>
                            <button type="button" class="tas-btn tas-btn--primary" @onclick="CloseAsync">Discard</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum Stage { Upload = 0, ScanFail = 1, FieldReview = 2, Clarification = 3, Generating = 4, Preview = 5, Done = 6, NeedsHelp = 7 }

    private enum EntrySource { Instance, Profile }

    private sealed record InstanceOption(Guid Id, string Label);

    [Parameter] public EventCallback OnTemplateSaved { get; set; }
    [Parameter] public EventCallback<string> OnFocusSavedTemplate { get; set; }

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private IScanIngestService IngestService { get; set; } = null!;
    [Inject] private IScanOfficeYellowExtractor OfficeYellowExtractor { get; set; } = null!;
    [Inject] private IScanFieldPlanService FieldPlanService { get; set; } = null!;
    [Inject] private IApplicationProfilePlaceholderSetService PlaceholderSets { get; set; } = null!;
    [Inject] private IApplicationProfileInstanceValueMapService ValueMaps { get; set; } = null!;
    [Inject] private ITemplateScanAiProvider ScanAiProvider { get; set; } = null!;
    [Inject] private ITemplateScanClarificationService ClarificationService { get; set; } = null!;
    [Inject] private ITemplateScanOrchestrator Orchestrator { get; set; } = null!;
    [Inject] private IScanGapPacketExporter GapPacketExporter { get; set; } = null!;
    [Inject] private IFileDownloader FileDownloader { get; set; } = null!;
    [Inject] private IOptions<TemplateAiScanOptions> Options { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private IApplicationErrorReporter ErrorReporter { get; set; } = null!;
    [Inject] private IUserReportTemplateMaintenanceService UserReportMaintenance { get; set; } = null!;

    private bool _open;
    private EntrySource _source = EntrySource.Profile;
    private Stage _stage = Stage.Upload;
    private Stage _helpReturnStage = Stage.Upload;
    private bool _busy;
    private string _analyzeStatus = string.Empty;
    private bool _discardPrompt;
    private bool _configLocked;
    private bool _aiEnabled;

    private IObjectSpace? _hostObjectSpace;
    private ApplicationProfile? _hostProfile;
    private IReadOnlyList<InstanceOption> _instanceOptions = Array.Empty<InstanceOption>();
    private Guid _selectedInstanceId;
    private Guid _profileId;
    private string _profileName = string.Empty;
    private string _caseNumber = string.Empty;
    private string _savedTemplateName = string.Empty;

    private byte[]? _fileBytes;
    private string _fileName = string.Empty;
    private string _templateName = string.Empty;
    private string? _editingOriginalName;
    private bool _reviewFromYellowSource;
    private byte[]? _yellowSourceBytes;
    private bool _restoredApprovedReview;
    private string? _reviewPlanJson;
    private byte[]? _mappedTemplateBytes;
    private ApplicationProfileTemplateCatalogScope _catalogScope = ApplicationProfileTemplateCatalogScope.ProfileSpecific;
    private bool _isViaMinistry;
    private string _applicabilityId = string.Empty;
    private IReadOnlyList<ApplicationProfileWizardLookupItem> _applicabilityLookups =
        Array.Empty<ApplicationProfileWizardLookupItem>();
    private ApplicationProfileTemplateDataScope _dataScope = ApplicationProfileTemplateDataScope.Both;
    private ScanKind _scanKind = ScanKind.FilledSample;

    private int _pdfPageCount;
    private readonly HashSet<int> _selectedPdfPages = new();

    private ScanIngestResult? _ingest;
    private ScanFieldPlan? _fieldPlan;
    private ScanFieldPlan? _reviewPlanBeforeGenerate;
    private ApplicationProfilePlaceholderSet? _placeholderSet;
