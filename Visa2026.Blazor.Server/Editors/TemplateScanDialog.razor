    }

    private async Task<IReadOnlyList<ScanPageImage>> CaptureReviewPageImagesAsync(
        int maxWidth = 1280,
        int timeoutMs = 15000)
    {
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromMilliseconds(Math.Clamp(timeoutMs, 1000, 30000)));
            var dtos = await JS.InvokeAsync<ReviewPagePngDto[]>(
                "visaTemplateScanPdfPreview.exportPagePngs",
                timeout.Token,
                2,
                maxWidth);
            if (dtos == null || dtos.Length == 0)
                return Array.Empty<ScanPageImage>();

            var pages = new List<ScanPageImage>();
            for (var i = 0; i < dtos.Length; i++)
            {
                var dto = dtos[i];
                if (string.IsNullOrWhiteSpace(dto.B64))
                    continue;
                byte[] bytes;
                try
                {
                    bytes = Convert.FromBase64String(dto.B64);
                }
                catch (FormatException)
                {
                    continue;
                }

                pages.Add(new ScanPageImage
                {
                    PageIndex = i,
                    PngBytes = bytes,
                    WidthPx = dto.Width > 0 ? dto.Width : 1,
                    HeightPx = dto.Height > 0 ? dto.Height : 1,
                    MimeType = string.IsNullOrWhiteSpace(dto.Mime) ? "image/jpeg" : dto.Mime,
                });
            }

            return pages;
        }
        catch (JSException)
        {
            return Array.Empty<ScanPageImage>();
        }
        catch (JSDisconnectedException)
        {
            return Array.Empty<ScanPageImage>();
        }
        catch (TaskCanceledException)
        {
            return Array.Empty<ScanPageImage>();
        }
        catch (OperationCanceledException)
        {
            return Array.Empty<ScanPageImage>();
        }
    }

    private async Task SendChatInternalAsync(string rawMessage)
    {
        if (_chatBusy || _fieldPlan == null || _ingest == null || _placeholderSet == null)
            return;

        var message = (rawMessage ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(message) && _chatOfficerImages.Count == 0)
            return;

        if (string.IsNullOrWhiteSpace(message))
            message = "Use the attached image to place the missing placeholders on the correct yellow marks.";

        var display = message;
        if (_chatOfficerImages.Count > 0)
            display += " (attached: " + string.Join(", ", _chatOfficerImages.Select(static x => x.Name)) + ")";

        _chatBusy = true;
        _chatRejectBanner = false;
        _chatRejectText = string.Empty;
        _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(true, display, Refused: false));
        _chatInput = string.Empty;
        await InvokeAsync(StateHasChanged);

        var serviceMessage = message;
        if (_fieldPlan != null && !string.IsNullOrWhiteSpace(_reviewChatFocusFieldId))
        {
            var ordered = ScanReviewFieldOrder.Order(_fieldPlan.Fields, _fieldPlan.Gaps);
            var mark = ordered.FirstOrDefault(m =>
                string.Equals(m.DisplayId, _reviewChatFocusFieldId, StringComparison.Ordinal)
                || string.Equals(m.FieldId, _reviewChatFocusFieldId, StringComparison.Ordinal));
            var displayOrder = mark?.DisplayOrder ?? "0";
            var parentId = mark?.FieldId ?? ScanReviewFieldOrder.ParentFieldId(_reviewChatFocusFieldId);
            serviceMessage = ScanFieldPlanOfficerOverride.FormatChatContext(_fieldPlan, parentId, displayOrder)
                + " Officer request: "
                + message;
        }

        IReadOnlyList<ScanPageImage> pages = Array.Empty<ScanPageImage>();
        try
        {
            var captured = await CaptureReviewPageImagesAsync();
            pages = captured.Count > 0 ? captured : _ingest.Input.Pages;
            var result = await ClarificationService.ApplyAsync(new ScanClarificationTurnRequest
            {
                OfficerMessage = serviceMessage,
                CurrentPlan = _fieldPlan,
                Playbook = _ingest.Playbook,
                PlaceholderSet = _placeholderSet,
                ScanKind = _scanKind,
                ValueHints = _valueHints,
                Pages = pages,
                OfficerImages = _chatOfficerImages.Select(static x => x.Image).ToList(),
            }).ConfigureAwait(false);

            var refused = !result.Accepted
                && result.RejectReason == ScanClarificationRejectReason.OutOfScopeContentEdit;
            _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(false, result.ReplyText, refused));

            if (result.Accepted)
            {
                var locked = _fieldPlan.Fields.Where(static f => f.IsLocked).ToList();
                _fieldPlan = ScanFieldPlanLockMerge.Apply(result.Plan, locked);
                _quickReplies = _fieldPlan.PendingQuestions
                    .SelectMany(static q => q.SuggestedAnswers)
                    .Where(static a => !string.IsNullOrWhiteSpace(a))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Take(6)
                    .ToList();
                RefreshAcknowledgement();
            }
            else if (refused)
            {
                _chatRejectBanner = true;
                _chatRejectText = result.ReplyText;
            }
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan clarification failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(
                false,
                "Something went wrong sending that message. Try again or go back to the field list.",
                Refused: true));
        }
        finally
        {
            _chatBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

