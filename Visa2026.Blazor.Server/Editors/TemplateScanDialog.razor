    private void TogglePdfPage(int page, ChangeEventArgs args)
    {
        var selected = (bool?)args.Value == true;
        if (selected)
            _selectedPdfPages.Add(page);
        else
            _selectedPdfPages.Remove(page);
    }

    private string SelectedPdfPagesSummary
    {
        get
        {
            if (_selectedPdfPages.Count == 0)
                return "Select at least one page.";
            var ordered = _selectedPdfPages.OrderBy(static p => p).ToList();
            if (ordered.Count > Options.Value.MaxPdfPages)
                return $"Too many pages selected ({ordered.Count}). Maximum is {Options.Value.MaxPdfPages}.";
            return $"Analyzing pages: {string.Join(", ", ordered)}";
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
            return;

        _message = null;
        _messageIsError = false;
        _fileBytes = null;
        _fileName = string.Empty;
        _pdfPageCount = 0;
        _selectedPdfPages.Clear();

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".docx" or ".xlsx"))
        {
            _message = "Only Word (.docx) and Excel (.xlsx) with yellow highlights are supported. PNG/JPG/PDF uploads are retired.";
            _messageIsError = true;
            return;
        }

        var hardLimit = Options.Value.HardMaxUploadBytes;
        if (file.Size > hardLimit)
        {
            _message = $"This file is {file.Size / 1048576} MB and the hard limit is {hardLimit / 1048576} MB.";
            _messageIsError = true;
            return;
        }

        if (file.Size > Options.Value.MaxUploadBytes)
        {
            _message = $"Large file ({file.Size / 1048576} MB). Analysis may be slower; warn threshold is {Options.Value.MaxUploadBytes / 1048576} MB.";
            _messageIsError = false;
        }

        await using var stream = file.OpenReadStream(hardLimit);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);

        _fileBytes = buffer.ToArray();
        _fileName = file.Name;
        if (string.IsNullOrWhiteSpace(_templateName))
            _templateName = Path.GetFileNameWithoutExtension(file.Name);

        if (!IsEditingExisting)
            _dataScope = ApplicationProfileTemplateDataScope.Both;

        if (extension == ".pdf")
        {
            try
            {
                _pdfPageCount = ScanPdfMetadataReader.ReadPageCount(_fileBytes);
                for (var page = 1; page <= Math.Min(_pdfPageCount, Options.Value.MaxPdfPages); page++)
                    _selectedPdfPages.Add(page);
            }
            catch (Exception ex)
            {
                _message = $"Could not read PDF: {ex.Message}";
                _messageIsError = true;
            }
        }
    }

    private bool IsOfficeUpload =>
        Path.GetExtension(_fileName).ToLowerInvariant() is ".docx" or ".xlsx";

    private bool CanAnalyze =>
        !_busy
        && IsOfficeUpload
        && _fileBytes is { Length: > 0 }
        && !string.IsNullOrWhiteSpace(_templateName)
        && _profileId != Guid.Empty
        && _selectedInstanceId != Guid.Empty;

    private bool PdfSelectionValid =>
        _pdfPageCount <= 1
        || (_selectedPdfPages.Count > 0 && _selectedPdfPages.Count <= Options.Value.MaxPdfPages);

    private bool RequiresLowConfidenceAck =>
        _fieldPlan?.Fields.Any(static f => f.Confidence == ScanFieldConfidence.Low) == true
        || _ingest?.Suitability.Verdict == ScanSuitabilityVerdict.Warn;

    private bool CanContinue =>
        !_busy
        && _fieldPlan is { HasMappedFields: true }
        && _ingest?.Suitability.CanContinue == true
        && (!RequiresLowConfidenceAck || _acknowledgedWarnings);

    private async Task AnalyzeAsync()
    {
        if (!CanAnalyze || _fileBytes == null)
            return;
        if (_source == EntrySource.Profile && (_hostProfile == null || _hostObjectSpace == null))
            return;
        if (_source == EntrySource.Instance && _profileId == Guid.Empty)
            return;

        _busy = true;
        _analyzeStatus = "Reading file…";
        _message = null;
        _messageIsError = false;
        _ingest = null;
        _fieldPlan = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        IObjectSpace? ownedObjectSpace = _source == EntrySource.Profile
            ? null
            : ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfile>();

        try
        {
            var objectSpace = ownedObjectSpace ?? _hostObjectSpace!;
            var profile = _source == EntrySource.Profile
                ? _hostProfile!
                : objectSpace.GetObjectByKey<ApplicationProfile>(_profileId);
            if (profile == null)
            {
                _message = "The application profile is no longer available.";
                _messageIsError = true;
                return;
            }

            IReadOnlyList<int>? selectedPages = null;
            if (_pdfPageCount > 1)
                selectedPages = _selectedPdfPages.OrderBy(static p => p).ToList();

            var ingest = IngestService.Ingest(new ScanNormalizeRequest
            {
                Content = _fileBytes,
                FileName = _fileName,
                SelectedPages = selectedPages,
            });

            await SetAnalyzeStatusAsync("Finding yellow marks…");

            var templateKind = Path.GetExtension(_fileName).Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
                ? ApplicationProfileTemplateKind.Excel
                : ApplicationProfileTemplateKind.Word;
            _placeholderSet = PlaceholderSets.GetSet(new ApplicationProfilePlaceholderSetQuery
            {
                Profile = profile,
                DataScope = _dataScope,
                TemplateKind = templateKind,
            });

            if (!ingest.Suitability.CanContinue)
            {
                _ingest = ingest;
                _stage = Stage.ScanFail;
                return;
            }

            var valueCandidates = Array.Empty<ValueCandidate>();
            _valueHints = BuildValueHints(_placeholderSet, objectSpace);
            if (_scanKind == ScanKind.FilledSample && _selectedInstanceId != Guid.Empty)
            {
                var instance = objectSpace.GetObjectByKey<ApplicationProfileInstance>(_selectedInstanceId);
                if (instance != null)
                {
                    var map = ValueMaps.Build(new ApplicationProfileInstanceValueMapRequest
                    {
                        Instance = instance,
                        PlaceholderSet = _placeholderSet,
                        DataScope = _dataScope,
                        RetainAmbiguousLiterals = true,
                    });
                    valueCandidates = map.Candidates.ToArray();
                    _valueHints = map.Candidates
                        .Select(static c => new ScanValueHint(c.Token, c.RawValue ?? c.NormalizedValue, null))
                        .ToList();
                }
            }

            await SetAnalyzeStatusAsync("Matching placeholders…");
            var fieldPlan = await FieldPlanService.BuildAsync(new ScanFieldPlanBuildRequest
            {
                Ingest = ingest,
                PlaceholderSet = _placeholderSet,
                ScanKind = _scanKind,
                ValueHints = _valueHints,
                ValueCandidates = valueCandidates,
            }).ConfigureAwait(false);

            var gatedSuitability = ScanYellowHighlightGate.Apply(
                ingest.Suitability,
                fieldPlan.YellowHighlightCount,
                fieldPlan);
            ingest = new ScanIngestResult
            {
                Input = ingest.Input,
                Ocr = ingest.Ocr,
                Suitability = gatedSuitability,
                Playbook = ingest.Playbook,
            };

            if (!gatedSuitability.CanContinue)
            {
                _ingest = ingest;
                _fieldPlan = fieldPlan;
                _stage = Stage.ScanFail;
                return;
            }

            _ingest = ingest;
            _fieldPlan = fieldPlan;
            _reviewPageIndex = 0;
            _reviewSelectedFieldId = null;
            _reviewChatOpen = false;
            _reviewChatFocusFieldId = null;
            _chatMessages.Clear();
            _quickReplies = Array.Empty<string>();
            _chatInput = string.Empty;
            _chatRejectBanner = false;
            _chatRejectText = string.Empty;
            _chatSeeded = false;
            var needsAck = fieldPlan.Fields.Any(static f => f.Confidence == ScanFieldConfidence.Low)
                || ingest.Suitability.Verdict == ScanSuitabilityVerdict.Warn;
            _acknowledgedWarnings = !needsAck;
            _analyzeStatus = "Opening review…";
            _stage = Stage.FieldReview;
        }
        catch (ScanNormalizationException ex)
        {
            _ingest = new ScanIngestResult
            {
                Input = new ScanNormalizedInput
                {
                    SourceKind = ScanSourceKind.Pdf,
                    Pages = Array.Empty<ScanPageImage>(),
                    OriginalByteLength = _fileBytes.LongLength,
                    FileName = _fileName,
                },
                Ocr = new ScanOcrResult { Lines = Array.Empty<ScanOcrLine>(), TextConfidence = 0 },
                Suitability = new ScanSuitabilityReport
                {
                    Verdict = ScanSuitabilityVerdict.Fail,
                    TextConfidence = 0,
                    Issues =
                    [
                        new ScanSuitabilityIssue { Code = ex.Code, Message = ex.Message },
                    ],
                },
                Playbook = new ScanAuthoringPlaybook
                {
                    Markdown = string.Empty,
                    Fingerprint = string.Empty,
                    VersionLabel = string.Empty,
                },
            };
            _stage = Stage.ScanFail;
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan analysis failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _message = "Analysis failed: " + ex.Message;
            _messageIsError = true;
        }
        finally
        {
            ownedObjectSpace?.Dispose();
            _busy = false;
            _analyzeStatus = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetAnalyzeStatusAsync(string status)
    {
        _analyzeStatus = status;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
    }

    private IReadOnlyList<ScanValueHint> BuildValueHints(
        ApplicationProfilePlaceholderSet placeholderSet,
        IObjectSpace objectSpace)
    {
        if (_scanKind != ScanKind.FilledSample || _selectedInstanceId == Guid.Empty)
            return Array.Empty<ScanValueHint>();

        var instance = objectSpace.GetObjectByKey<ApplicationProfileInstance>(_selectedInstanceId);
        if (instance == null)
            return Array.Empty<ScanValueHint>();

        var map = ValueMaps.Build(new ApplicationProfileInstanceValueMapRequest
        {
            Instance = instance,
            PlaceholderSet = placeholderSet,
            DataScope = _dataScope,
            RetainAmbiguousLiterals = true,
        });

        return map.Candidates
            .Select(static c => new ScanValueHint(c.Token, c.RawValue ?? c.NormalizedValue, null))
            .ToList();
    }

    private Task OnOfficerFieldPlanChanged(ScanFieldPlan plan)
    {
        _fieldPlan = plan;
        RefreshAcknowledgement();
        return Task.CompletedTask;
    }

    private bool CanContinueFromChat => CanContinue && !_chatBusy;

    private string? ReviewChatFocusCaption
    {
        get
        {
            if (_fieldPlan == null || string.IsNullOrWhiteSpace(_reviewChatFocusFieldId))
                return null;

            var mark = ScanReviewFieldOrder.Order(_fieldPlan.Fields, _fieldPlan.Gaps)
                .FirstOrDefault(m =>
                    string.Equals(m.DisplayId, _reviewChatFocusFieldId, StringComparison.Ordinal)
                    || string.Equals(m.FieldId, _reviewChatFocusFieldId, StringComparison.Ordinal));
            if (mark == null)
                return null;

            var token = mark.ProposedToken;
            if (string.IsNullOrWhiteSpace(token))
                token = "unmapped";
            return $"Mark #{mark.DisplayOrder}: “{mark.LabelText}” → {token}";
        }
    }

    private void OpenClarification() => OpenReviewChatCore(_reviewSelectedFieldId);

    private void OpenReviewChat(string fieldId) => OpenReviewChatCore(fieldId);

    private void OpenReviewChatCore(string? fieldId)
    {
        if (!_aiEnabled || _fieldPlan == null || _ingest == null)
            return;

        SeedClarificationChat();
        _reviewChatOpen = true;
        _message = null;
        _messageIsError = false;

        var focusId = string.IsNullOrWhiteSpace(fieldId) ? null : fieldId.Trim();
        if (string.IsNullOrWhiteSpace(focusId))
            return;

        if (string.Equals(_reviewChatFocusFieldId, focusId, StringComparison.Ordinal))
            return;

        _reviewChatFocusFieldId = focusId;
        var ordered = ScanReviewFieldOrder.Order(_fieldPlan.Fields, _fieldPlan.Gaps);
        var mark = ordered.FirstOrDefault(m =>
            string.Equals(m.DisplayId, focusId, StringComparison.Ordinal)
            || string.Equals(m.FieldId, focusId, StringComparison.Ordinal));
        var displayOrder = mark?.DisplayOrder ?? "0";
        var parentId = mark?.FieldId ?? ScanReviewFieldOrder.ParentFieldId(focusId);
        _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(
            false,
            ScanFieldPlanOfficerOverride.FormatOfficerHint(_fieldPlan, parentId, displayOrder),
            Refused: false));
    }

    private void HideReviewChat()
    {
        _reviewChatOpen = false;
        _chatRejectBanner = false;
        _chatRejectText = string.Empty;
    }

    private void SeedClarificationChat()
    {
        if (_chatSeeded || _fieldPlan == null)
            return;

        _chatSeeded = true;
        foreach (var prompt in _fieldPlan.PendingQuestions)
        {
            if (!string.IsNullOrWhiteSpace(prompt.Question))
                _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(false, prompt.Question, Refused: false));
        }

        _quickReplies = _fieldPlan.PendingQuestions
            .SelectMany(static q => q.SuggestedAnswers)
            .Where(static a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToList();
    }

    private void BackToFieldReview()
    {
        _stage = Stage.FieldReview;
        _outcome = null;
        _previewAcknowledgedWarnings = false;
        _chatRejectBanner = false;
        _chatRejectText = string.Empty;
        _message = null;
        _messageIsError = false;
        RefreshAcknowledgement();
    }

    private void RefreshAcknowledgement()
    {
        if (_fieldPlan == null)
            return;

        var needsAck = _fieldPlan.Fields.Any(static f => f.Confidence == ScanFieldConfidence.Low)
            || _ingest?.Suitability.Verdict == ScanSuitabilityVerdict.Warn;
        if (!needsAck)
            _acknowledgedWarnings = true;
    }

    private Task OnChatInputChanged(string value)
    {
        _chatInput = value;
        return Task.CompletedTask;
    }

    private Task SendQuickReplyAsync(string reply) => SendChatInternalAsync(reply);

    private Task SendChatAsync() => SendChatInternalAsync(_chatInput);

    private async Task SendChatInternalAsync(string rawMessage)
    {
        if (_chatBusy || _fieldPlan == null || _ingest == null || _placeholderSet == null)
            return;

        var message = (rawMessage ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(message))
            return;

        _chatBusy = true;
        _chatRejectBanner = false;
        _chatRejectText = string.Empty;
        _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(true, message, Refused: false));
        _chatInput = string.Empty;
        await InvokeAsync(StateHasChanged);

        var serviceMessage = message;
        if (_fieldPlan != null && !string.IsNullOrWhiteSpace(_reviewChatFocusFieldId))
        {
            var ordered = ScanReviewFieldOrder.Order(_fieldPlan.Fields, _fieldPlan.Gaps);
            var mark = ordered.FirstOrDefault(m =>
                string.Equals(m.DisplayId, _reviewChatFocusFieldId, StringComparison.Ordinal)
                || string.Equals(m.FieldId, _reviewChatFocusFieldId, StringComparison.Ordinal));
            var displayOrder = mark?.DisplayOrder ?? "0";
            var parentId = mark?.FieldId ?? ScanReviewFieldOrder.ParentFieldId(_reviewChatFocusFieldId);
            serviceMessage = ScanFieldPlanOfficerOverride.FormatChatContext(_fieldPlan, parentId, displayOrder)
                + " Officer request: "
                + message;
        }

        try
        {
            var result = await ClarificationService.ApplyAsync(new ScanClarificationTurnRequest
            {
                OfficerMessage = serviceMessage,
                CurrentPlan = _fieldPlan,
                Playbook = _ingest.Playbook,
                PlaceholderSet = _placeholderSet,
                ScanKind = _scanKind,
                ValueHints = _valueHints,
            }).ConfigureAwait(false);

            var refused = !result.Accepted
                && result.RejectReason == ScanClarificationRejectReason.OutOfScopeContentEdit;
            _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(false, result.ReplyText, refused));

            if (result.Accepted)
            {
                _fieldPlan = result.Plan;
                _quickReplies = result.Plan.PendingQuestions
                    .SelectMany(static q => q.SuggestedAnswers)
                    .Where(static a => !string.IsNullOrWhiteSpace(a))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Take(6)
                    .ToList();
                RefreshAcknowledgement();
            }
            else if (refused)
            {
                _chatRejectBanner = true;
                _chatRejectText = result.ReplyText;
            }
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan clarification failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _chatMessages.Add(new TemplateScanClarificationView.ChatMessage(
                false,
                "Something went wrong sending that message. Try again or go back to the field list.",
                Refused: true));
        }
        finally
        {
            _chatBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool CanApprove =>
        !_busy
        && _outcome is { CanApprove: true }
        && (_source == EntrySource.Profile
            ? _hostProfile != null && _hostObjectSpace != null
            : _profileId != Guid.Empty)
        && (!_outcome.HasWarnings || _previewAcknowledgedWarnings)
        && !IsLockedExistingOverwrite;

    private bool IsEditingExisting => !string.IsNullOrWhiteSpace(_editingOriginalName);

    private bool IsLockedExistingOverwrite =>
        _configLocked
        && IsEditingExisting
        && string.Equals(_templateName.Trim(), _editingOriginalName!.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool CanApproveFromHelp => _outcome != null && _helpReturnStage == Stage.Preview;

    private bool ShowNeedsHelpEntry => _fieldPlan is { Gaps.Count: > 0 }
        || UnmappedDetectedFields.Count > 0
        || _outcome is { Validation.HasHardFailure: true };

    private IReadOnlyList<ScanDetectedField> UnmappedDetectedFields =>
        _fieldPlan?.Fields.Where(static f => string.IsNullOrWhiteSpace(f.ProposedToken)).ToList()
        ?? (IReadOnlyList<ScanDetectedField>)Array.Empty<ScanDetectedField>();

    private string HelpInstanceLabel =>
        _selectedInstanceId == Guid.Empty
            ? "—"
            : (string.IsNullOrWhiteSpace(_caseNumber) ? _selectedInstanceId.ToString("D") : _caseNumber);

    private TemplateScanAnalysis? BuildAnalysis()
    {
        if (_ingest == null || _fieldPlan == null || _placeholderSet == null)
            return null;

        return new TemplateScanAnalysis
        {
            NormalizedInput = _ingest.Input,
            Suitability = _ingest.Suitability,
            FieldPlan = _fieldPlan,
            PlaceholderSet = _placeholderSet,
            Playbook = _ingest.Playbook,
            TemplateName = _templateName,
            DataScope = _dataScope,
            ScanKind = _scanKind,
            OcrLines = _ingest.Ocr.Lines,
            ValueHints = _valueHints ?? Array.Empty<ScanValueHint>(),
        };
    }

    private async Task GenerateAsync()
    {
        var analysis = BuildAnalysis();
        if (analysis == null || !analysis.CanGenerate)
            return;

        _stage = Stage.Generating;
        _busy = true;
        _message = null;
        _messageIsError = false;
        _outcome = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var outcome = await Orchestrator.GenerateAsync(analysis).ConfigureAwait(false);
            _outcome = outcome;
            _previewAcknowledgedWarnings = !outcome.HasWarnings;
            _stage = Stage.Preview;
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan generate failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _message = "Draft generation failed. Try reviewing fields again or upload a different scan.";
            _messageIsError = true;
            _stage = Stage.FieldReview;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApproveAsync()
    {
        if (!CanApprove || _outcome == null)
            return;
        if (_source == EntrySource.Profile && (_hostProfile == null || _hostObjectSpace == null))
            return;

        _busy = true;
        _message = null;
        _messageIsError = false;

        IObjectSpace? ownedObjectSpace = _source == EntrySource.Profile
            ? null
            : ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfile>();

        try
        {
            var objectSpace = ownedObjectSpace ?? _hostObjectSpace!;
            var profile = _source == EntrySource.Profile
                ? _hostProfile!
                : objectSpace.GetObjectByKey<ApplicationProfile>(_profileId);
            if (profile == null)
            {
                _message = "The application profile is no longer available.";
                _messageIsError = true;
                return;
            }

            var ext = _outcome.SourceFormat == TemplateSourceFormat.Xlsx ? ".xlsx" : ".docx";
            Orchestrator.Save(new TemplateScanSaveRequest
            {
                ObjectSpace = objectSpace,
                Profile = profile,
                TemplateName = _templateName.Trim(),
                DataScope = _dataScope,
                CatalogScope = _catalogScope,
                Content = _outcome.Content,
                FileName = _templateName.Trim() + ext,
                TemplateKind = _outcome.TemplateKind,
                ApplicableProjectContractId = SelectedProjectContractId,
                ApplicableMigrationServiceId = SelectedMigrationServiceId,
            });

            if (_source == EntrySource.Instance)
                objectSpace.CommitChanges();

            var userTemplate = ApplicationProfileTemplateUserReportBridge.TryFindByName(
                objectSpace,
                _templateName.Trim());
            if (userTemplate != null)
                await UserReportMaintenance.ExtractAndValidatePlaceholdersAsync(userTemplate.ID);

            _savedTemplateName = _templateName.Trim();
            _stage = Stage.Done;
            _message = null;
            _messageIsError = false;

            if (OnTemplateSaved.HasDelegate)
                await OnTemplateSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan save failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            ownedObjectSpace?.Dispose();
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenHelp()
    {
        if (_fieldPlan == null)
            return;

        _helpReturnStage = _stage;
        _stage = Stage.NeedsHelp;
        _message = null;
        _messageIsError = false;
    }

    private void CloseHelp()
    {
        _stage = _helpReturnStage;
        _message = null;
        _messageIsError = false;
    }

    private ScanGapPacketRequest? BuildGapPacketRequest()
    {
        if (_fieldPlan == null || _fileBytes is not { Length: > 0 } || _profileId == Guid.Empty)
            return null;

        return new ScanGapPacketRequest
        {
            ApplicationProfileId = _profileId,
            ApplicationProfileInstanceId = _selectedInstanceId == Guid.Empty ? null : _selectedInstanceId,
            ScanContentSha256 = ScanGapPacketExporter.ComputeContentSha256(_fileBytes),
            FieldPlan = _fieldPlan,
            Validation = _outcome?.Validation,
            PlaybookFingerprint = _ingest?.Playbook.Fingerprint ?? _fieldPlan.PlaceholderSet.Fingerprint,
            PlaceholderSetFingerprint = _fieldPlan.PlaceholderSet.Fingerprint,
            TemplateName = _templateName,
            ScanFileName = _fileName,
            ProfileName = _profileName,
            CatalogScope = _catalogScope,
            DataScope = _dataScope,
        };
    }

    private async Task DownloadGapPacketJsonAsync() => await DownloadGapPacketAsync(json: true);

    private async Task DownloadGapPacketMarkdownAsync() => await DownloadGapPacketAsync(json: false);

    private async Task DownloadGapPacketAsync(bool json)
    {
        var request = BuildGapPacketRequest();
        if (request == null)
        {
            _message = "Nothing to export yet — analyze a scan first.";
            _messageIsError = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var bytes = json
                ? GapPacketExporter.ExportJson(request)
                : GapPacketExporter.ExportMarkdown(request);
            var stem = string.IsNullOrWhiteSpace(_templateName) ? "scan-gaps" : _templateName.Trim();
            var fileName = json ? $"{stem}-gaps.json" : $"{stem}-gaps.md";
            var contentType = json ? "application/json" : "text/markdown";
            await using var stream = new MemoryStream(bytes);
            await FileDownloader.DownloadAsync(fileName, stream, contentType);
            _message = json ? "Gap packet downloaded (JSON)." : "Gap packet downloaded (Markdown).";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan gap packet export failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _message = "Gap packet export failed.";
            _messageIsError = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task FocusSavedTemplateAsync()
    {
        if (string.IsNullOrWhiteSpace(_savedTemplateName) || !OnFocusSavedTemplate.HasDelegate)
            return;

        await OnFocusSavedTemplate.InvokeAsync(_savedTemplateName);
        await CloseAsync();
    }

    private void ScanAnother()
    {
        var source = _source;
        var caseNumber = _caseNumber;
        var profileId = _profileId;
        var profileName = _profileName;
        var hostObjectSpace = _hostObjectSpace;
        var hostProfile = _hostProfile;
        var instanceOptions = _instanceOptions;
        var selectedInstanceId = _selectedInstanceId;
        var configLocked = _configLocked;

        Reset();

        _source = source;
        _caseNumber = caseNumber;
        _profileId = profileId;
        _profileName = profileName;
        _hostObjectSpace = hostObjectSpace;
        _hostProfile = hostProfile;
        _instanceOptions = instanceOptions;
        _selectedInstanceId = selectedInstanceId;
        _configLocked = configLocked;
        _scanKind = ScanKind.FilledSample;
        _aiEnabled = Options.Value.Enabled && ScanAiProvider.IsEnabled;
    }

    private void BackToUpload()
    {
        _stage = Stage.Upload;
        _ingest = null;
        _fieldPlan = null;
        _outcome = null;
        _acknowledgedWarnings = false;
        _previewAcknowledgedWarnings = false;
        _chatMessages.Clear();
        _quickReplies = Array.Empty<string>();
        _chatInput = string.Empty;
        _chatRejectBanner = false;
        _chatRejectText = string.Empty;
        _chatSeeded = false;
        _message = null;
        _messageIsError = false;
        _reviewSelectedFieldId = null;
        _reviewChatOpen = false;
        _reviewChatFocusFieldId = null;
    }

    private string ModalWidthClass => _stage switch
    {
        Stage.FieldReview or Stage.Preview => "tas-modal--wide tas-modal--review",
        Stage.Clarification or Stage.NeedsHelp => "tas-modal--wide",
        _ => string.Empty,
    };

    private string StepCssClass(int index)
    {
        var active = _stage switch
        {
            Stage.Upload => 1,
            Stage.ScanFail => 1,
            Stage.FieldReview => 2,
            Stage.Clarification => 2,
            Stage.Generating => 3,
            Stage.Preview => 4,
            Stage.Done => 5,
            _ => 1,
        };

        var doneThrough = _stage switch
        {
            Stage.Done => 5,
            Stage.Preview => 4,
            Stage.Generating => 2,
            Stage.Clarification or Stage.FieldReview => 1,
            _ => 0,
        };

        if (index == active)
            return "is-active";
        if (index <= doneThrough)
            return "is-done";
        return "is-future";
    }

    private static string StepMark(int index) => index switch
    {
        1 => "1",
        2 => "2",
        _ => "•",
    };
}
