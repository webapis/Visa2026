        _isViaMinistry ? "Project contract" : "Migration service";

    private string ApplicabilityEmptyLabel =>
        _isViaMinistry ? "All contracts" : "All migration services";

    private string ApplicabilityHint =>
        _isViaMinistry
            ? "All contracts = every via-ministry case of this profile. Pick one Project contract to show only on matching cases."
            : "All migration services = every direct-migration case of this profile. Pick one service to show only on matching cases.";

    private const string SaveToHint =
        "This profile only stays on this profile. Shared catalog is confirmed when you Approve.";

    private const string CaseHint =
        "Workspace context only. Yellow marks use the sample in the file, not this case's people.";

    private const string FileHint =
        "Upload a filled sample. Highlight every value that should become a placeholder in yellow (Word Text Highlight Color or Excel cell fill). Other text stays as printed.";

    private string ApplicabilitySummary
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_applicabilityId))
                return ApplicabilityEmptyLabel;

            var match = _applicabilityLookups.FirstOrDefault(item =>
                string.Equals(item.Id.ToString("D"), _applicabilityId, StringComparison.OrdinalIgnoreCase));
            return match?.DisplayName ?? _applicabilityId;
        }
    }

    private Guid? SelectedProjectContractId =>
        _catalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific && _isViaMinistry
            ? ParseApplicabilityId()
            : null;

    private Guid? SelectedMigrationServiceId =>
        _catalogScope == ApplicationProfileTemplateCatalogScope.ProfileSpecific && !_isViaMinistry
            ? ParseApplicabilityId()
            : null;

    private Guid? ParseApplicabilityId() =>
        Guid.TryParse(_applicabilityId, out var id) && id != Guid.Empty ? id : null;

    private void OnApplicabilityChanged(ChangeEventArgs e) =>
        _applicabilityId = e.Value?.ToString() ?? string.Empty;

    private void BindApplicabilityFromProfile(ApplicationProfile profile, IObjectSpace objectSpace)
    {
        _isViaMinistry = profile.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries;
        _applicabilityLookups = ApplicationProfileWizardLookupData.LoadApplicabilityItems(objectSpace, _isViaMinistry);
    }

    private void BindApplicabilityFromInstance(
        ApplicationProfileInstance? instance,
        ApplicationProfile profile,
        IObjectSpace objectSpace)
    {
        var route = ApplicationProfileConfigurationResolver.GetProgressRoute(instance)
            ?? profile.ProgressRoute;
        _isViaMinistry = route == ApplicationProfileInstanceProgressRouteKind.ViaMinistries;
        _applicabilityLookups = ApplicationProfileWizardLookupData.LoadApplicabilityItems(objectSpace, _isViaMinistry);
    }

    private string FormatApplicabilityId(Guid? projectContractId, Guid? migrationServiceId)
    {
        var id = _isViaMinistry ? projectContractId : migrationServiceId;
        return id is Guid value && value != Guid.Empty ? value.ToString("D") : string.Empty;
    }

    private Task RequestCloseAsync()
    {
        if (_busy)
            return Task.CompletedTask;

        if (_stage is Stage.FieldReview or Stage.Clarification or Stage.Generating or Stage.Preview)
        {
            _discardPrompt = true;
            return InvokeAsync(StateHasChanged);
        }

        if (_stage == Stage.NeedsHelp)
        {
            CloseHelp();
            return InvokeAsync(StateHasChanged);
        }

        return CloseAsync();
    }

    private async Task CloseAsync()
    {
        _open = false;
        Reset();
        await InvokeAsync(StateHasChanged);
    }

    private void OnScanKindChanged(ScanKind kind)
    {
        _scanKind = kind;
        if (kind == ScanKind.BlankForm)
            _selectedInstanceId = Guid.Empty;
    }

    private void OnInstanceChanged(ChangeEventArgs args)
    {
        _selectedInstanceId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
    }

    private void TogglePdfPage(int page, ChangeEventArgs args)
    {
        var selected = (bool?)args.Value == true;
        if (selected)
            _selectedPdfPages.Add(page);
        else
            _selectedPdfPages.Remove(page);
    }

    private string SelectedPdfPagesSummary
    {
        get
        {
            if (_selectedPdfPages.Count == 0)
                return "Select at least one page.";
            var ordered = _selectedPdfPages.OrderBy(static p => p).ToList();
            if (ordered.Count > Options.Value.MaxPdfPages)
                return $"Too many pages selected ({ordered.Count}). Maximum is {Options.Value.MaxPdfPages}.";
            return $"Analyzing pages: {string.Join(", ", ordered)}";
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
            return;

        _message = null;
        _messageIsError = false;
        _fileBytes = null;
        _fileName = string.Empty;
        _pdfPageCount = 0;
        _selectedPdfPages.Clear();

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".docx" or ".xlsx"))
        {
            _message = "Only Word (.docx) and Excel (.xlsx) with yellow highlights are supported. PNG/JPG/PDF uploads are retired.";
            _messageIsError = true;
            return;
        }

        var hardLimit = Options.Value.HardMaxUploadBytes;
        if (file.Size > hardLimit)
        {
            _message = $"This file is {file.Size / 1048576} MB and the hard limit is {hardLimit / 1048576} MB.";
            _messageIsError = true;
            return;
        }

        if (file.Size > Options.Value.MaxUploadBytes)
        {
            _message = $"Large file ({file.Size / 1048576} MB). Analysis may be slower; warn threshold is {Options.Value.MaxUploadBytes / 1048576} MB.";
            _messageIsError = false;
        }

        await using var stream = file.OpenReadStream(hardLimit);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);

        _fileBytes = buffer.ToArray();
        _fileName = file.Name;
        if (string.IsNullOrWhiteSpace(_templateName))
            _templateName = Path.GetFileNameWithoutExtension(file.Name);

        if (!IsEditingExisting)
            _dataScope = ApplicationProfileTemplateDataScope.Both;

        if (extension == ".pdf")
        {
            try
            {
                _pdfPageCount = ScanPdfMetadataReader.ReadPageCount(_fileBytes);
                for (var page = 1; page <= Math.Min(_pdfPageCount, Options.Value.MaxPdfPages); page++)
                    _selectedPdfPages.Add(page);
            }
            catch (Exception ex)
            {
                _message = $"Could not read PDF: {ex.Message}";
                _messageIsError = true;
            }
        }
    }

    private bool IsOfficeUpload =>
        Path.GetExtension(_fileName).ToLowerInvariant() is ".docx" or ".xlsx";

    private bool CanAnalyze =>
        !_busy
        && IsOfficeUpload
        && _fileBytes is { Length: > 0 }
        && !string.IsNullOrWhiteSpace(_templateName)
        && _profileId != Guid.Empty
        && _selectedInstanceId != Guid.Empty;

    private bool PdfSelectionValid =>
        _pdfPageCount <= 1
        || (_selectedPdfPages.Count > 0 && _selectedPdfPages.Count <= Options.Value.MaxPdfPages);

    private bool RequiresLowConfidenceAck =>
        _fieldPlan?.Fields.Any(static f => f.Confidence == ScanFieldConfidence.Low) == true
        || _ingest?.Suitability.Verdict == ScanSuitabilityVerdict.Warn;

    private bool CanContinue =>
        !_busy
        && _fieldPlan is { HasMappedFields: true }
        && _ingest?.Suitability.CanContinue == true
        && (!RequiresLowConfidenceAck || _acknowledgedWarnings);

    private bool CanRemapUnmarked =>
        !_busy
        && IsOfficeUpload
        && _fileBytes is { Length: > 0 }
        && _fieldPlan != null
        && _profileId != Guid.Empty
        && (_source != EntrySource.Profile || (_hostProfile != null && _hostObjectSpace != null))
        && (_source != EntrySource.Instance || _profileId != Guid.Empty);

    private Task RemapUnlockedAsync() => RunFieldPlanAsync(remap: true);

    private void ApplyRemapReviewSelection(ScanFieldPlan fieldPlan, string? selectionKey)
    {
        if (selectionKey == null)
            return;

        var match = fieldPlan.Fields.FirstOrDefault(f =>
            string.Equals(ScanDocumentRegionKey.ForField(f), selectionKey, StringComparison.Ordinal));
        if (match == null)
            return;

        var ordered = ScanReviewFieldOrder.Order(fieldPlan.Fields, fieldPlan.Gaps);
        _reviewSelectedFieldId = ordered.FirstOrDefault(m =>
                string.Equals(m.FieldId, match.FieldId, StringComparison.Ordinal))
            ?.DisplayId ?? match.FieldId;
    }

    private Task AnalyzeAsync()
    {
        if (IsEditingExisting && !string.IsNullOrWhiteSpace(_reviewPlanJson))
            return RestoreApprovedReviewAsync();
        return RunFieldPlanAsync(remap: false);
    }

    private async Task RestoreApprovedReviewAsync()
    {
        if (_fileBytes is not { Length: > 0 } || _profileId == Guid.Empty)
            return;
        if (_source == EntrySource.Profile && (_hostProfile == null || _hostObjectSpace == null))
            return;

        _busy = true;
        _analyzeStatus = "Opening saved placeholders…";
        _message = null;
        _messageIsError = false;
        _restoredApprovedReview = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        IObjectSpace? ownedObjectSpace = _source == EntrySource.Profile
            ? null
            : ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfile>();

        try
        {
            var objectSpace = ownedObjectSpace ?? _hostObjectSpace!;
            var profile = _source == EntrySource.Profile
                ? _hostProfile!
                : objectSpace.GetObjectByKey<ApplicationProfile>(_profileId);
            if (profile == null)
            {
                _message = "The application profile is no longer available.";
                _messageIsError = true;
                return;
            }

            var fileBytes = _fileBytes;
            var fileName = _fileName;
            var ingest = await Task.Run(() => IngestService.Ingest(new ScanNormalizeRequest
            {
                Content = fileBytes,
                FileName = fileName,
            })).ConfigureAwait(true);
            AdoptRepairedOfficeBytes(ingest);

            if (!ingest.Suitability.CanContinue)
            {
                _ingest = ingest;
                _stage = Stage.ScanFail;
                return;
            }

            var templateKind = Path.GetExtension(_fileName).Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
                ? ApplicationProfileTemplateKind.Excel
                : ApplicationProfileTemplateKind.Word;
            _placeholderSet = PlaceholderSets.GetSet(ScanPlaceholderLibrary.Query(profile, templateKind));

            var sourceKind = ingest.Input.SourceKind;
            var officeBytes = ingest.Input.OfficePackageBytes ?? fileBytes;
            var yellows = await Task.Run(() => OfficeYellowExtractor.Extract(officeBytes, sourceKind))
                .ConfigureAwait(true);
            _reviewFromYellowSource = yellows.Count > 0;
            if (_reviewFromYellowSource)
                _yellowSourceBytes = _fileBytes;

            var snapshot = ScanApprovedReviewSnapshot.Deserialize(_reviewPlanJson);
            IReadOnlyList<ScanOfficeYellowSpan>? mappedSpans = null;
            if (snapshot == null && _mappedTemplateBytes is { Length: > 0 } mappedBytes)
            {
                var set = _placeholderSet;
                mappedSpans = await Task.Run(() =>
                        ScanOfficeLibraryTokenExtractor.Extract(mappedBytes, sourceKind, set))
                    .ConfigureAwait(true);
            }

            var fieldPlan = ScanApprovedReviewRestorer.Restore(
                _placeholderSet,
                yellows,
                snapshot,
                mappedSpans,
                officeBytes,
                sourceKind);

            var gatedSuitability = ScanYellowHighlightGate.Apply(
                ingest.Suitability,
                fieldPlan.YellowHighlightCount,
                fieldPlan);
            if (!ReferenceEquals(ingest.Suitability, gatedSuitability))
            {
                ingest = new ScanIngestResult
                {
                    Input = ingest.Input,
                    Ocr = ingest.Ocr,
                    Suitability = gatedSuitability,
                    Playbook = ingest.Playbook,
                };
            }

            if (!gatedSuitability.CanContinue)
            {
                _ingest = ingest;
                _fieldPlan = fieldPlan;
                _stage = Stage.ScanFail;
                return;
            }

            _ingest = ingest;
            _fieldPlan = fieldPlan;
            _restoredApprovedReview = true;
            _reviewPageIndex = 0;
            _reviewSelectedFieldId = null;
            _reviewChatOpen = false;
            _reviewChatFocusFieldId = null;
            _chatMessages.Clear();
            _quickReplies = Array.Empty<string>();
            _chatInput = string.Empty;
            _chatRejectBanner = false;
            _chatRejectText = string.Empty;
            _chatSeeded = false;
            _chatOfficerImages.Clear();
            _acknowledgedWarnings = true;
            _analyzeStatus = string.Empty;
            _stage = Stage.FieldReview;
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError(
                "Template scan restore Review failed.",
                ApplicationRuntimeLogCategories.TemplateScan,
                ex);
            _message = "Could not open the saved placeholders. Remap unmarked only if you want to re-guess.";
            _messageIsError = true;
        }
        finally
        {
            ownedObjectSpace?.Dispose();
            _busy = false;
            _analyzeStatus = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunFieldPlanAsync(bool remap)
    {
        if (remap)
        {
            if (!CanRemapUnmarked || _fileBytes == null)
                return;
        }
        else if (!CanAnalyze || _fileBytes == null)
            return;
        if (_source == EntrySource.Profile && (_hostProfile == null || _hostObjectSpace == null))
            return;
        if (_source == EntrySource.Instance && _profileId == Guid.Empty)
            return;

        if (remap)
            _restoredApprovedReview = false;

        var lockedFields = remap && _fieldPlan != null
            ? _fieldPlan.Fields.Where(static f => f.IsLocked).ToList()
            : (IReadOnlyList<ScanDetectedField>)Array.Empty<ScanDetectedField>();
        string? selectionKey = null;
        if (remap && _fieldPlan != null && !string.IsNullOrWhiteSpace(_reviewSelectedFieldId))
        {
            var mark = ScanReviewFieldOrder.Order(_fieldPlan.Fields, _fieldPlan.Gaps)
                .FirstOrDefault(m =>
                    string.Equals(m.DisplayId, _reviewSelectedFieldId, StringComparison.Ordinal)
                    || string.Equals(m.FieldId, _reviewSelectedFieldId, StringComparison.Ordinal));
            var selected = mark == null
                ? null
                : _fieldPlan.Fields.FirstOrDefault(f =>
                    string.Equals(f.FieldId, mark.FieldId, StringComparison.Ordinal));
            if (selected != null)
                selectionKey = ScanDocumentRegionKey.ForField(selected);
        }

        _busy = true;
        _analyzeStatus = remap ? "Remapping unmarked yellows…" : "Reading file…";
        _message = null;
        _messageIsError = false;
        if (!remap)
        {
            _ingest = null;
            _fieldPlan = null;
            _reviewPlanBeforeGenerate = null;
            _remapHintUnidentified = false;
            _remapHintIncorrect = false;
        }
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        IObjectSpace? ownedObjectSpace = _source == EntrySource.Profile
            ? null
            : ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfile>();

        try
        {
            var objectSpace = ownedObjectSpace ?? _hostObjectSpace!;
            var profile = _source == EntrySource.Profile
                ? _hostProfile!
                : objectSpace.GetObjectByKey<ApplicationProfile>(_profileId);
            if (profile == null)
            {
                _message = "The application profile is no longer available.";
                _messageIsError = true;
                return;
            }

            IReadOnlyList<int>? selectedPages = null;
            if (_pdfPageCount > 1)
                selectedPages = _selectedPdfPages.OrderBy(static p => p).ToList();

            ScanIngestResult ingest;
            if (remap && _ingest != null)
            {
                ingest = _ingest;
            }
            else
            {
                var fileBytes = _fileBytes;
                var fileName = _fileName;
                ingest = await Task.Run(() => IngestService.Ingest(new ScanNormalizeRequest
                {
                    Content = fileBytes,
                    FileName = fileName,
                    SelectedPages = selectedPages,
                })).ConfigureAwait(true);
                AdoptRepairedOfficeBytes(ingest);
            }

            await SetAnalyzeStatusAsync("Finding yellow marks…");

            var templateKind = Path.GetExtension(_fileName).Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
                ? ApplicationProfileTemplateKind.Excel
                : ApplicationProfileTemplateKind.Word;
            if (!remap || _placeholderSet == null)
            {
                _placeholderSet = PlaceholderSets.GetSet(ScanPlaceholderLibrary.Query(profile, templateKind));
            }

            if (!ingest.Suitability.CanContinue)
            {
                if (remap)
                {
                    _message = "Remap could not re-read the file. Locked placeholders were not changed.";
                    _messageIsError = true;
                    return;
                }

                _ingest = ingest;
                _stage = Stage.ScanFail;
                return;
            }

            IReadOnlyList<ValueCandidate> valueCandidates;
            if (remap && _valueCandidates.Count > 0)
            {
                valueCandidates = _valueCandidates;
            }
            else
            {
                valueCandidates = Array.Empty<ValueCandidate>();
                _valueHints = BuildValueHints(_placeholderSet, objectSpace);
                if (_scanKind == ScanKind.FilledSample && _selectedInstanceId != Guid.Empty)
                {
                    var instance = objectSpace.GetObjectByKey<ApplicationProfileInstance>(_selectedInstanceId);
                    if (instance != null)
                    {
                        var map = ValueMaps.Build(new ApplicationProfileInstanceValueMapRequest
                        {
                            Instance = instance,
                            PlaceholderSet = _placeholderSet,
                            DataScope = _dataScope,
                            RetainAmbiguousLiterals = true,
                        });
                        valueCandidates = map.Candidates.ToArray();
                        _valueHints = map.Candidates
                            .Select(static c => new ScanValueHint(c.Token, c.RawValue ?? c.NormalizedValue, null))
                            .ToList();
                    }
                }

                _valueCandidates = valueCandidates;
            }

            await SetAnalyzeStatusAsync("Matching placeholders…");
            var remapHints = remap
                ? new ScanRemapOfficerHints(_remapHintUnidentified, _remapHintIncorrect)
                : ScanRemapOfficerHints.None;
            var askAi = remap && remapHints.Any && _aiEnabled;

            var fieldPlan = await ScanFieldPlanBuildOffCircuit.RunAsync(
                FieldPlanService,
                new ScanFieldPlanBuildRequest
                {
                    Ingest = ingest,
                    PlaceholderSet = _placeholderSet,
                    ScanKind = _scanKind,
                    ValueHints = _valueHints,
                    ValueCandidates = valueCandidates,
                    LockedFields = lockedFields,
                    RemapHints = remapHints,
                    SkipAiRefinement = askAi,
                }).ConfigureAwait(true);

            var gatedSuitability = ScanYellowHighlightGate.Apply(
                ingest.Suitability,
                fieldPlan.YellowHighlightCount,
                fieldPlan);
            if (!ReferenceEquals(ingest.Suitability, gatedSuitability))
            {
                ingest = new ScanIngestResult
                {
                    Input = ingest.Input,
                    Ocr = ingest.Ocr,
                    Suitability = gatedSuitability,
                    Playbook = ingest.Playbook,
                };
            }

            if (!gatedSuitability.CanContinue)
            {
                if (remap)
                {
                    _message = "Remap could not match the yellow marks. Locked placeholders were not changed.";
                    _messageIsError = true;
                    return;
                }

                _ingest = ingest;
                _fieldPlan = fieldPlan;
                _stage = Stage.ScanFail;
                return;
            }

            _ingest = ingest;
            _fieldPlan = fieldPlan;
            if (remap)
            {
                ApplyRemapReviewSelection(fieldPlan, selectionKey);
                var remapNeedsAck = fieldPlan.Fields.Any(static f => f.Confidence == ScanFieldConfidence.Low)
                    || ingest.Suitability.Verdict == ScanSuitabilityVerdict.Warn;
                if (remapNeedsAck)
                    _acknowledgedWarnings = false;
                _message = "Unlocked placeholders were remapped. Review the numbered list, then Continue.";
                _messageIsError = false;
                _stage = Stage.FieldReview;
                await InvokeAsync(StateHasChanged);
                await Task.Yield();
            }

            if (askAi)
            {
                await SetAnalyzeStatusAsync(remapHints.UnidentifiedYellows
                    ? "Asking AI about leftover yellows…"
                    : "Asking AI to re-check placeholders…");
                try
                {
                    fieldPlan = await ScanFieldPlanBuildOffCircuit.RunAsync(
                        FieldPlanService,
                        new ScanFieldPlanBuildRequest
                        {
                            Ingest = ingest,
                            PlaceholderSet = _placeholderSet,
                            ScanKind = _scanKind,
                            ValueHints = _valueHints,
                            ValueCandidates = valueCandidates,
                            LockedFields = lockedFields,
                            RemapHints = remapHints,
                        }).ConfigureAwait(true);
                    _fieldPlan = fieldPlan;
                    if (remap)
                        ApplyRemapReviewSelection(fieldPlan, selectionKey);
                }
                catch (Exception ex)
                {
                    ErrorReporter.ReportReportPackageError(
                        "Template scan AI remap failed.",
                        ApplicationRuntimeLogCategories.TemplateScan,
                        ex);
                }
            }

            if (remap)
                return;

            _reviewPageIndex = 0;
            _reviewSelectedFieldId = null;
            _reviewChatOpen = false;
            _reviewChatFocusFieldId = null;
            _chatMessages.Clear();
            _quickReplies = Array.Empty<string>();
            _chatInput = string.Empty;
            _chatRejectBanner = false;
            _chatRejectText = string.Empty;
            _chatSeeded = false;
            _chatOfficerImages.Clear();
            var needsAck = fieldPlan.Fields.Any(static f => f.Confidence == ScanFieldConfidence.Low)
                || ingest.Suitability.Verdict == ScanSuitabilityVerdict.Warn;
            _acknowledgedWarnings = !needsAck;
            _analyzeStatus = "Opening review…";
            _stage = Stage.FieldReview;
        }
        catch (ScanNormalizationException ex)
        {
            if (remap)
            {
                _message = ex.Message;
                _messageIsError = true;
                return;
            }

            _ingest = new ScanIngestResult
            {
                Input = new ScanNormalizedInput
                {
                    SourceKind = ScanSourceKind.Pdf,
                    Pages = Array.Empty<ScanPageImage>(),
                    OriginalByteLength = _fileBytes.LongLength,
                    FileName = _fileName,
                },
                Ocr = new ScanOcrResult { Lines = Array.Empty<ScanOcrLine>(), TextConfidence = 0 },
                Suitability = new ScanSuitabilityReport
                {
                    Verdict = ScanSuitabilityVerdict.Fail,
                    TextConfidence = 0,
                    Issues =
                    [
                        new ScanSuitabilityIssue { Code = ex.Code, Message = ex.Message },
                    ],
                },
                Playbook = new ScanAuthoringPlaybook
                {
                    Markdown = string.Empty,
                    Fingerprint = string.Empty,
                    VersionLabel = string.Empty,
                },
            };
            _stage = Stage.ScanFail;
        }
        catch (Exception ex)
        {
            ErrorReporter.ReportReportPackageError("Template scan analysis failed.", ApplicationRuntimeLogCategories.TemplateScan, ex);
            _message = IsMissingOpenXmlPart(ex)
                ? "This Word file has a missing internal part and could not be read. In Word, use File → Save As (.docx), then Analyze that copy."
                : "Analysis failed: " + ex.Message;
            _messageIsError = true;
        }
        finally
        {
            ownedObjectSpace?.Dispose();
            _busy = false;
            _analyzeStatus = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

