    private async Task OnChatImageSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
            return;

        var maxImages = Math.Max(1, Options.Value.MaxChatImages);
        if (_chatOfficerImages.Count >= maxImages)
        {
            _chatRejectBanner = true;
            _chatRejectText = $"Attach at most {maxImages} images.";
            return;
        }

        var maxBytes = Options.Value.MaxChatImageBytes > 0 ? Options.Value.MaxChatImageBytes : 8_388_608;
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            if (!ScanChatImageAttachment.TryCreate(memory.ToArray(), file.Name, maxBytes, out var image, out var error))
            {
                _chatRejectBanner = true;
                _chatRejectText = error;
                return;
            }

            var name = string.IsNullOrWhiteSpace(file.Name) ? "image.png" : file.Name.Trim();
            _chatOfficerImages.Add((name, image));
            _chatRejectBanner = false;
            _chatRejectText = string.Empty;
        }
        catch (IOException)
        {
            _chatRejectBanner = true;
            _chatRejectText = "Could not read that image.";
        }
    }

