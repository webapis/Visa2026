@using System.Globalization
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Module.BusinessObjects.PersonDossier
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.PersonDossier

<div class="person-dossier @(_viewMode == DossierViewMode.Paper ? "person-dossier--paper" : null)">
    @if (IsLoading || Snapshot == null)
    {
        <div class="person-dossier__loading" role="status" aria-live="polite" aria-busy="true">
            <div class="person-dossier__loading-panel">
                <div class="person-dossier__loading-kicker">@Msg("PersonDossier.Title")</div>
                <div class="person-dossier__loading-label">
                    @(string.IsNullOrWhiteSpace(LoadingMessage) ? Msg("PersonDossier.Chrome.Loading") : LoadingMessage)
                </div>
                <div class="person-dossier__loading-track"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@(ShowIndeterminateLoading ? null : EffectiveLoadingPercent)"
                     aria-label="@Msg("PersonDossier.Chrome.LoadingProgress")">
                    <div class="person-dossier__loading-fill @(ShowIndeterminateLoading ? "person-dossier__loading-fill--indeterminate" : null)"
                         style="@(ShowIndeterminateLoading ? null : $"width:{EffectiveLoadingPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                </div>
                @if (!ShowIndeterminateLoading)
                {
                    <div class="person-dossier__loading-pct">@EffectiveLoadingPercent%</div>
                }
                <div class="person-dossier__skeleton" aria-hidden="true">
                    <div class="person-dossier__skeleton-photo"></div>
                    <div class="person-dossier__skeleton-lines">
                        <div class="person-dossier__skeleton-line person-dossier__skeleton-line--lg"></div>
                        <div class="person-dossier__skeleton-line"></div>
                        <div class="person-dossier__skeleton-line person-dossier__skeleton-line--sm"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Snapshot.PersonId == Guid.Empty)
    {
        <div class="person-dossier__loading person-dossier__loading--empty">@Msg("PersonDossier.Chrome.NoPerson")</div>
    }
    else
    {
        @if (_viewMode == DossierViewMode.Paper)
        {
            <div class="person-dossier__toolbar">
                <div class="person-dossier__toolbar-title">@Msg("PersonDossier.Title")</div>
                <div class="person-dossier__view-switch" role="group" aria-label="@Msg("PersonDossier.View.SwitchLabel")">
                    <button type="button"
                            class="person-dossier__view-btn @(_viewMode == DossierViewMode.Screen ? "is-active" : null)"
                            @onclick="ShowScreen">
                        @Msg("PersonDossier.View.Screen")
                    </button>
                    <button type="button"
                            class="person-dossier__view-btn is-active"
                            @onclick="ShowPaper">
                        @Msg("PersonDossier.View.Paper")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(ExportMessage))
                {
                    <div class="person-dossier__export-msg">@ExportMessage</div>
                }
                <button type="button" class="person-dossier__copies-btn" @onclick="OnExport" disabled="@IsExportQueued">
                    <span class="person-dossier__clip">&#11015;</span>
                    @Msg("PersonDossier.Action.Export")
                </button>
                <button type="button" class="doc-copies-brand" @onclick="OnOpenCopies">
                    <span class="doc-copies-brand__icon doc-copies-brand__icon--svg" aria-hidden="true">
                        @((MarkupString)DocumentCopiesBrandMark.SvgMarkup)
                    </span>
                    @Msg("PersonDossier.Action.Copies")
                </button>
            </div>
            <div class="person-dossier__paper-stage">
                <div class="person-dossier__paper-sheet">
                    @((MarkupString)_paperHtml)
                </div>
            </div>
        }
        else
        {
            @* Centered column with side gutters (Word-like padding), wider than A4 so tables fit. *@
            <div class="person-dossier__screen-stage">
                <div class="person-dossier__screen-column">
                    <div class="person-dossier__toolbar">
                        <div class="person-dossier__toolbar-title">@Msg("PersonDossier.Title")</div>
                        <div class="person-dossier__view-switch" role="group" aria-label="@Msg("PersonDossier.View.SwitchLabel")">
                            <button type="button"
                                    class="person-dossier__view-btn is-active"
                                    @onclick="ShowScreen">
                                @Msg("PersonDossier.View.Screen")
                            </button>
                            <button type="button"
                                    class="person-dossier__view-btn"
                                    @onclick="ShowPaper">
                                @Msg("PersonDossier.View.Paper")
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ExportMessage))
                        {
                            <div class="person-dossier__export-msg">@ExportMessage</div>
                        }
                        <button type="button" class="person-dossier__copies-btn" @onclick="OnExport" disabled="@IsExportQueued">
                            <span class="person-dossier__clip">&#11015;</span>
                            @Msg("PersonDossier.Action.Export")
                        </button>
                        <button type="button" class="doc-copies-brand" @onclick="OnOpenCopies">
                            <span class="doc-copies-brand__icon doc-copies-brand__icon--svg" aria-hidden="true">
                                @((MarkupString)DocumentCopiesBrandMark.SvgMarkup)
                            </span>
                            @Msg("PersonDossier.Action.Copies")
                        </button>
                    </div>

            <div class="person-dossier__identity">
                <div class="person-dossier__photo">
                    @if (!string.IsNullOrEmpty(Snapshot.PhotoDataUri))
                    {
                        <img src="@Snapshot.PhotoDataUri" alt="@Snapshot.PersonDisplayName" />
                    }
                    else
                    {
                        <div class="person-dossier__photo-empty">@Msg("PersonDossier.Chrome.NoPhoto")</div>
                    }
                </div>

                <div class="person-dossier__identity-body">
                    <div class="person-dossier__name">@Snapshot.PersonDisplayName</div>

                    <div class="person-dossier__badges">
                        <span class="person-dossier__badge person-dossier__badge--role">@Snapshot.PersonRoleLabel</span>
                        @if (!string.IsNullOrWhiteSpace(Snapshot.ProjectContractName))
                        {
                            <span class="person-dossier__badge">@Snapshot.ProjectContractName</span>
                        }
                        @if (Snapshot.IsArchived)
                        {
                            <span class="person-dossier__badge person-dossier__badge--archived">@Msg("PersonDossier.Status.Archived")</span>
                        }
                    </div>

                    <div class="person-dossier__fields">
                        @foreach (var field in Snapshot.IdentityFields)
                        {
                            <div class="person-dossier__field">
                                <span class="person-dossier__field-label">@field.Label</span>
                                <span class="person-dossier__field-value">@field.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (Snapshot.StatusTiles.Count > 0)
            {
                <div class="person-dossier__tiles">
                    @foreach (var tile in Snapshot.StatusTiles)
                    {
                        <div class="person-dossier__tile">
                            <div class="person-dossier__tile-label">@tile.Label</div>
                            <div class="person-dossier__tile-value">@tile.Value</div>
                            @if (!string.IsNullOrWhiteSpace(tile.StatusLabel))
                            {
                                <div class="person-dossier__pill @tile.StatusCssClass">@tile.StatusLabel</div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="person-dossier__sections">
                @foreach (var block in ScreenBlocks())
                {
                    var section = block.Section;
                    var visibleRecords = VisibleRecords(section);
                    var displayedRecords = DisplayedRecords(section, visibleRecords);
                    var hiddenCount = visibleRecords.Count - displayedRecords.Count;
                    var canCollapse = IsSectionExpanded(section) && visibleRecords.Count > SectionPreviewLimit;
                    <section class="person-dossier__section">
                        @if (block.Tabs.Count > 0)
                        {
                            var tabGroupId = block.TabGroupId!;
                            <div class="person-dossier__groups person-dossier__tabs" role="tablist">
                                @foreach (var tab in block.Tabs)
                                {
                                    var tabId = tab.SectionId;
                                    var selected = string.Equals(section.SectionId, tabId, StringComparison.Ordinal);
                                    <button type="button"
                                            class="person-dossier__group @(selected ? "is-selected" : null)"
                                            role="tab"
                                            aria-selected="@selected"
                                            @onclick="() => SelectTab(tabGroupId, tabId)">
                                        <span>@tab.SectionLabel</span>
                                        <span class="person-dossier__group-count">@tab.Records.Count</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <header class="person-dossier__section-head">
                                <span class="person-dossier__section-title">@(section.SectionLabel)</span>
                                <span class="person-dossier__section-count">@visibleRecords.Count</span>
                            </header>
                        }
                        @if (section.ApplicationGroups.Count > 0)
                        {
                            <div class="person-dossier__groups" role="tablist">
                                @foreach (var group in section.ApplicationGroups)
                                {
                                    var groupId = group.GroupId;
                                    var selected = string.Equals(SelectedApplicationGroup, groupId, StringComparison.Ordinal);
                                    <button type="button"
                                            class="person-dossier__group @(selected ? "is-selected" : null)"
                                            role="tab"
                                            aria-selected="@selected"
                                            @onclick="() => SelectApplicationGroup(groupId)">
                                        <span>@group.Label</span>
                                        <span class="person-dossier__group-count">@group.Count</span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="person-dossier__table-scroll">
                            <table class="person-dossier__table">
                                <thead>
                                    <tr>
                                        @if (section.HasMemberColumn)
                                        {
                                            <th>@Msg("PersonDossier.Column.Name")</th>
                                        }
                                        @foreach (var header in section.ColumnHeaders)
                                        {
                                            <th>@header</th>
                                        }
                                        @if (section.ShowsStatusColumn)
                                        {
                                            <th class="person-dossier__col-status">@Msg("PersonDossier.Column.Status")</th>
                                        }
                                        @if (section.HasProgressColumn)
                                        {
                                            <th class="person-dossier__col-progress">@Msg("PersonDossier.Column.Progress")</th>
                                        }
                                        @if (section.HasIssuedOutcomeColumn)
                                        {
                                            <th class="person-dossier__col-issued">@Msg("PersonDossier.Column.Issued")</th>
                                        }
                                        @if (section.HasCopyColumn)
                                        {
                                            <th class="person-dossier__col-copy">@Msg("PersonDossier.Column.Copy")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (visibleRecords.Count == 0 && section.ApplicationGroups.Count > 0)
                                    {
                                        <tr>
                                            <td class="person-dossier__group-empty" colspan="@SectionColumnCount(section)">
                                                @Msg("PersonDossier.ApplicationGroup.Empty")
                                            </td>
                                        </tr>
                                    }
                                    else if (visibleRecords.Count == 0)
                                    {
                                        <tr>
                                            <td class="person-dossier__group-empty" colspan="@SectionColumnCount(section)">—</td>
                                        </tr>
                                    }
                                    @foreach (var record in displayedRecords)
                                    {
                                        <tr class="@(record.IsCurrent ? "person-dossier__row--current" : null)">
                                            @if (section.HasMemberColumn)
                                            {
                                                <td>@record.MemberName</td>
                                            }
                                            @for (var cellIndex = 0; cellIndex < record.Cells.Count; cellIndex++)
                                            {
                                                var cell = record.Cells[cellIndex];
                                                <td class="@(section.HasIssuedOutcomeColumn && cellIndex == 0 ? "person-dossier__col-application" : null)">
                                                    <div class="@(IsInlineProgressCell(section, record, cellIndex) ? "person-dossier__app-row" : null)">
                                                    <div class="@(IsInlineProgressCell(section, record, cellIndex) ? "person-dossier__app-main" : null)">
                                                    @if (IsApplicationNumberLink(section, record, cellIndex))
                                                    {
                                                        <button type="button"
                                                                class="person-dossier__app-link"
                                                                title="@Msg("PersonDossier.Applications.OpenWorkspace")"
                                                                @onclick="() => OnOpenApplication(record.SourceObjectId!.Value)">
                                                            @cell
                                                        </button>
                                                    }
                                                    else if (IsApplicationLinkCell(record, cellIndex))
                                                    {
                                                        <button type="button"
                                                                class="person-dossier__app-link"
                                                                title="@Msg("PersonDossier.Applications.OpenWorkspace")"
                                                                @onclick="() => OnOpenApplication(record.ApplicationLinkId!.Value)">
                                                            @cell
                                                        </button>
                                                    }
                                                    else if (record.CompanionCellIndex == cellIndex)
                                                    {
                                                        <span class="person-dossier__visa-issued">
                                                            <span>@cell</span>
                                                            @if (!string.IsNullOrWhiteSpace(record.CompanionStatusLabel))
                                                            {
                                                                <span class="person-dossier__pill @record.CompanionStatusCssClass">@record.CompanionStatusLabel</span>
                                                            }
                                                        </span>
                                                    }
                                                    else if (record.MultiChipCellIndex == cellIndex && record.MultiChips.Count > 0)
                                                    {
                                                        <span class="person-dossier__visa-issued">
                                                            @foreach (var proof in record.MultiChips)
                                                            {
                                                                <button type="button"
                                                                        class="person-dossier__app-link"
                                                                        @onclick="() => OnPreviewChip(proof)">
                                                                    @proof.Number
                                                                </button>
                                                            }
                                                        </span>
                                                    }
                                                    else if (ChipAt(record, cellIndex) is { } chip)
                                                    {
                                                        <span class="person-dossier__visa-issued">
                                                            @if (chip.HasPreview)
                                                            {
                                                                <button type="button"
                                                                        class="person-dossier__app-link"
                                                                        @onclick="() => OnPreviewChip(chip)">
                                                                    @chip.Number
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span>@chip.Number</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(chip.StatusLabel))
                                                            {
                                                                <span class="person-dossier__pill @chip.StatusCssClass">@chip.StatusLabel</span>
                                                            }
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @cell
                                                    }
                                                    @if (cellIndex == 0 && !string.IsNullOrWhiteSpace(record.FirstCellDetail))
                                                    {
                                                        <span class="person-dossier__cell-detail">@record.FirstCellDetail</span>
                                                    }
                                                    @if (cellIndex == 0 && !string.IsNullOrWhiteSpace(record.FirstCellNote))
                                                    {
                                                        <span class="person-dossier__cell-note">@record.FirstCellNote</span>
                                                    }
                                                    @if (cellIndex == 0 && IsApprovalLettersCell(section, record))
                                                    {
                                                        <span class="person-dossier__approval-letters">
                                                            @if (record.HasApprovalLetters && record.ApplicationLinkId is Guid lettersApplicationId)
                                                            {
                                                                <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="lettersApplicationId"
                                                                                                   PreviewAllMinistryLetters="true"
                                                                                                   OwnerViewId="@PersonDossierViewIds.DetailView"
                                                                                                   LinkText="@Msg("PersonDossier.ApprovalLetters")"
                                                                                                   FileName="@Msg("PersonDossier.ApprovalLetters")"
                                                                                                   CssClass="person-dossier__app-link" />
                                                            }
                                                            @foreach (var missingStep in record.MissingApprovalSteps)
                                                            {
                                                                <span class="person-dossier__missing-letter">
                                                                    <span>@missingStep</span>
                                                                    <span class="person-dossier__pill st-pending">@Msg("ApplicationProfileInstance.Workspace.Missing")</span>
                                                                </span>
                                                            }
                                                        </span>
                                                    }
                                                    </div>
                                                    @if (IsInlineProgressCell(section, record, cellIndex))
                                                    {
                                                        @if (!IsActiveProcessSection(section))
                                                        {
                                                            <button type="button"
                                                                    class="person-dossier__group @(IsProgressOpen(record) ? "is-selected" : null)"
                                                                    @onclick="() => ToggleProgress(record)">
                                                                @Msg("PersonDossier.Progress.Toggle")
                                                            </button>
                                                        }
                                                        @if (IsActiveProcessSection(section) || IsProgressOpen(record))
                                                        {
                                                            <div class="person-dossier__inline-progress">
                                                                <div class="lv-progress-stepper">
                                                                    @for (var stepIndex = 0; stepIndex < record.ProgressSteps.Count; stepIndex++)
                                                                    {
                                                                        var step = record.ProgressSteps[stepIndex];
                                                                        <div class="lv-progress-step lv-progress-step--@(step.Tone)">
                                                                            <div class="lv-progress-step__track">
                                                                                <span class="lv-progress-step__dot">@step.Glyph</span>
                                                                                @if (stepIndex < record.ProgressSteps.Count - 1)
                                                                                {
                                                                                    <span class="lv-progress-step__line @(step.ConnectorDone ? "lv-progress-step__line--done" : null)"></span>
                                                                                }
                                                                            </div>
                                                                            <div class="lv-progress-step__meta">
                                                                                <div class="lv-progress-step__label">@step.Label</div>
                                                                                @if (!string.IsNullOrWhiteSpace(step.StatusLabel))
                                                                                {
                                                                                    <span class="lv-progress-step__status">@step.StatusLabel</span>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(step.Date))
                                                                                {
                                                                                    <span class="lv-progress-step__date">@step.Date</span>
                                                                                }
                                                                                @if (!string.IsNullOrWhiteSpace(step.ResultNumber))
                                                                                {
                                                                                    <span class="person-dossier__progress-result">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ResultNumberValue", step.ResultNumber)</span>
                                                                                }
                                                                                @if (step.LetterProgressId is Guid letterId
                                                                                     && letterId != Guid.Empty
                                                                                     && !string.IsNullOrWhiteSpace(step.LetterFileName)
                                                                                     && record.SourceObjectId is Guid instanceId)
                                                                                {
                                                                                    <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="instanceId"
                                                                                                                       ProgressId="letterId"
                                                                                                                       FileName="@Msg("PersonDossier.Progress.ViewFile")"
                                                                                                                       OwnerViewId="@PersonDossierViewIds.DetailView"
                                                                                                                       LinkText="@Msg("PersonDossier.Progress.ViewFile")"
                                                                                                                       PreviewAll="true"
                                                                                                                       CssClass="person-dossier__progress-letter" />
                                                                                }
                                                                                else if (step.ShowMissingLetter)
                                                                                {
                                                                                    <span class="person-dossier__pill st-pending">@Msg("ApplicationProfileInstance.Workspace.Missing")</span>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    </div>
                                                </td>
                                            }
                                            @if (section.ShowsStatusColumn)
                                            {
                                                <td class="person-dossier__col-status">
                                                    @if (record.IsCurrent)
                                                    {
                                                        <span class="person-dossier__pill st-approved">@Msg("PersonDossier.Status.Current")</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(record.StatusLabel))
                                                    {
                                                        <span class="person-dossier__pill @record.StatusCssClass">@record.StatusLabel</span>
                                                    }
                                                </td>
                                            }
                                            @if (section.HasProgressColumn)
                                            {
                                                <td class="person-dossier__col-progress">
                                                    @if (record.ProgressSteps.Count == 0)
                                                    {
                                                        <span class="person-dossier__progress-empty">—</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="lv-progress-with-result">
                                                        <div class="lv-progress-stepper @(record.ResultChips.Count > 0 ? "lv-progress-stepper--with-stems" : null)">
                                                            @for (var stepIndex = 0; stepIndex < record.ProgressSteps.Count; stepIndex++)
                                                            {
                                                                var step = record.ProgressSteps[stepIndex];
                                                                <div class="lv-progress-step lv-progress-step--@(step.Tone)">
                                                                    <div class="lv-progress-step__track">
                                                                        <span class="lv-progress-step__dot">@step.Glyph</span>
                                                                        @if (stepIndex < record.ProgressSteps.Count - 1)
                                                                        {
                                                                            <span class="lv-progress-step__line @(step.ConnectorDone ? "lv-progress-step__line--done" : null)"></span>
                                                                        }
                                                                    </div>
                                                                    <div class="lv-progress-step__meta">
                                                                        <div class="lv-progress-step__label">@step.Label</div>
                                                                        @if (!string.IsNullOrWhiteSpace(step.StatusLabel))
                                                                        {
                                                                            <span class="lv-progress-step__status">@step.StatusLabel</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(step.Date))
                                                                        {
                                                                            <span class="lv-progress-step__date">@step.Date</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(step.ResultNumber))
                                                                        {
                                                                            <span class="person-dossier__progress-result">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ResultNumberValue", step.ResultNumber)</span>
                                                                        }
                                                                        @if (step.LetterProgressId is Guid letterId
                                                                             && letterId != Guid.Empty
                                                                             && !string.IsNullOrWhiteSpace(step.LetterFileName)
                                                                             && record.SourceObjectId is Guid instanceId)
                                                                        {
                                                                            <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="instanceId"
                                                                                                               ProgressId="letterId"
                                                                                                               FileName="@Msg("PersonDossier.Progress.ViewFile")"
                                                                                                               OwnerViewId="@PersonDossierViewIds.DetailView"
                                                                                                               LinkText="@Msg("PersonDossier.Progress.ViewFile")"
                                                                                                               PreviewAll="true"
                                                                                                               CssClass="person-dossier__progress-letter" />
                                                                        }
                                                                        else if (step.ShowMissingLetter)
                                                                        {
                                                                            <span class="person-dossier__pill st-pending">@Msg("ApplicationProfileInstance.Workspace.Missing")</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                        @if (record.ResultChips.Count > 0)
                                                        {
                                                            <div class="lv-result-neck"></div>
                                                            <div class="lv-result-stems">
                                                                <div class="lv-result-chips lv-result-chips--stack" aria-label="@Msg("ApplicationProfileInstance.Workspace.ApplicationResult")">
                                                                    @foreach (var chip in record.ResultChips)
                                                                    {
                                                                        <span class="lv-result-chip lv-result-chip--@ApplicationWorkspaceIssuedResultListCoverage.Tone(chip)">
                                                                            @ApplicationWorkspaceIssuedResultListCoverage.Caption(chip)
                                                                            <strong>@ApplicationWorkspaceIssuedResultListCoverage.RatioText(chip)</strong>
                                                                        </span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        </div>
                                                    }
                                                </td>
                                            }
                                            @if (section.HasIssuedOutcomeColumn)
                                            {
                                                <td class="person-dossier__col-issued">
                                                    @if (record.IssuedOutcome is { } outcome)
                                                    {
                                                        <div class="person-dossier__issued-stack">
                                                            <div class="person-dossier__issued-primary">
                                                                @if (outcome.HasPreview)
                                                                {
                                                                    <button type="button"
                                                                            class="person-dossier__app-link"
                                                                            @onclick="() => OnPreviewIssuedOutcome(outcome)">
                                                                        @outcome.Number
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span>@outcome.Number</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(outcome.StatusLabel))
                                                                {
                                                                    <span class="person-dossier__pill @outcome.StatusCssClass">@outcome.StatusLabel</span>
                                                                }
                                                            </div>
                                                            @if (outcome.HasDetail)
                                                            {
                                                                <div class="person-dossier__issued-detail" title="@outcome.Detail">@outcome.Detail</div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="person-dossier__progress-empty">—</span>
                                                    }
                                                </td>
                                            }
                                            @if (section.HasCopyColumn)
                                            {
                                                <td class="person-dossier__col-copy">
                                                    @if (record.HasPreview)
                                                    {
                                                        <button type="button"
                                                                class="person-dossier__app-link"
                                                                @onclick="() => OnPreviewRecord(record)">
                                                            @Msg("PersonDossier.Copy.Preview")
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="person-dossier__pill st-pending">@Msg("PersonDossier.Copy.None")</span>
                                                        @if (record.CanUpload)
                                                        {
                                                            <button type="button"
                                                                    class="person-dossier__app-link person-dossier__copy-upload"
                                                                    @onclick="() => OnUploadRecord(record)">
                                                                @Msg("PersonDossier.Copy.Upload")
                                                            </button>
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (hiddenCount > 0 || canCollapse)
                        {
                            <div class="person-dossier__more">
                                <button type="button"
                                        class="person-dossier__more-btn"
                                        aria-expanded="@canCollapse"
                                        @onclick="() => ToggleSectionExpansion(section)">
                                    @if (canCollapse)
                                    {
                                        @Msg("PersonDossier.Section.ShowLess")
                                    }
                                    else
                                    {
                                        <span>@Msg("PersonDossier.Section.ShowMore")</span>
                                        <span class="person-dossier__more-count">@VisaUiMessages.Format("PersonDossier.Section.MoreCount", hiddenCount)</span>
                                    }
                                </button>
                            </div>
                        }
                    </section>
                }
            </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private enum DossierViewMode
    {
        Screen,
        Paper
    }

    [Parameter] public PersonDossierSnapshot? Snapshot { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int LoadingProgressPercent { get; set; }
    [Parameter] public string LoadingMessage { get; set; } = string.Empty;
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback OpenCopiesRequested { get; set; }
    [Parameter] public EventCallback ExportRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenApplicationRequested { get; set; }
    [Parameter] public EventCallback<PersonDossierRecord> PreviewRecordRequested { get; set; }
    [Parameter] public EventCallback<PersonDossierRecord> UploadRecordRequested { get; set; }
    [Parameter] public string? ExportMessage { get; set; }
    [Parameter] public bool IsExportQueued { get; set; }

    private bool ShowIndeterminateLoading => IsLoading && LoadingProgressPercent < 0;
    private int EffectiveLoadingPercent => IsLoading && LoadingProgressPercent >= 0 ? LoadingProgressPercent : 0;

    private bool _initialLoadStarted;
    private const int SectionPreviewLimit = 5;
    private readonly HashSet<string> _expandedSections = new(StringComparer.Ordinal);
    private Guid _expandedForPersonId;
    private string _applicationGroupId = PersonDossierApplicationGroups.Invitation;

    private string SelectedApplicationGroup =>
        string.IsNullOrWhiteSpace(_applicationGroupId)
            ? PersonDossierApplicationGroups.Invitation
            : _applicationGroupId;

    private void SelectApplicationGroup(string groupId) => _applicationGroupId = groupId;

    private static readonly string[] IssuedTabOrder =
        ["activeProcesses", "byApplication", "visas", "workPermits", "borderZones", "workPermitLocations", "rejections"];
    private static readonly string[] IdentityTabOrder = ["passports", "education", "positionHistory", "addresses", "familyMembers", "travel"];
    private static readonly string[] FamilyCaseTabOrder =
        ["familyActiveProcesses", "familyInvitations", "familyVisas", "familyBorderZones"];
    private readonly Dictionary<string, string> _selectedTabs = new(StringComparer.Ordinal);

    private void SelectTab(string groupId, string sectionId) => _selectedTabs[groupId] = sectionId;

    private IReadOnlyList<ScreenBlock> ScreenBlocks()
    {
        var sections = Snapshot?.Sections ?? Array.Empty<PersonDossierSection>();
        var byId = new Dictionary<string, PersonDossierSection>(StringComparer.Ordinal);
        foreach (var section in sections)
            byId[section.SectionId] = section;

        var blocks = new List<ScreenBlock>();
        AddTabGroup(blocks, "issued", IssuedTabOrder, byId);
        var identity = AddTabGroup(blocks, "identity", IdentityTabOrder, byId);
        if (identity?.Section is { SectionId: "familyMembers" } family && family.NestedSections.Count > 0)
        {
            var nested = new Dictionary<string, PersonDossierSection>(StringComparer.Ordinal);
            foreach (var section in family.NestedSections)
                nested[section.SectionId] = section;
            AddTabGroup(blocks, "familyCases", FamilyCaseTabOrder, nested);
        }

        var tabbed = new HashSet<string>(IssuedTabOrder.Concat(IdentityTabOrder), StringComparer.Ordinal);
        foreach (var section in sections)
        {
            if (!tabbed.Contains(section.SectionId))
                blocks.Add(new ScreenBlock { Section = section });
        }

        return blocks;
    }

    private ScreenBlock? AddTabGroup(
        List<ScreenBlock> blocks,
        string groupId,
        IReadOnlyList<string> order,
        IReadOnlyDictionary<string, PersonDossierSection> byId)
    {
        var tabs = new List<PersonDossierSection>(order.Count);
        foreach (var sectionId in order)
        {
            if (byId.TryGetValue(sectionId, out var section))
                tabs.Add(section);
        }

        if (tabs.Count == 0)
            return null;

        PersonDossierSection selected = tabs.FirstOrDefault(tab => tab.Records.Count > 0) ?? tabs[0];
        if (_selectedTabs.TryGetValue(groupId, out var selectedId))
        {
            foreach (var tab in tabs)
            {
                if (string.Equals(tab.SectionId, selectedId, StringComparison.Ordinal))
                {
                    selected = tab;
                    break;
                }
            }
        }

        blocks.Add(new ScreenBlock
        {
            TabGroupId = groupId,
            Tabs = tabs,
            Section = selected,
        });
        return blocks[^1];
    }

    private sealed class ScreenBlock
    {
        public string? TabGroupId { get; init; }

        public IReadOnlyList<PersonDossierSection> Tabs { get; init; } = Array.Empty<PersonDossierSection>();

        public required PersonDossierSection Section { get; init; }
    }

    private static int SectionColumnCount(PersonDossierSection section)
    {
        var count = section.ColumnHeaders.Count;
        if (section.HasMemberColumn)
            count++;
        if (section.ShowsStatusColumn)
            count++;
        if (section.HasProgressColumn)
            count++;
        if (section.HasIssuedOutcomeColumn)
            count++;
        if (section.HasCopyColumn)
            count++;
        return count;
    }

    private IReadOnlyList<PersonDossierRecord> VisibleRecords(PersonDossierSection section)
    {
        if (section.ApplicationGroups.Count == 0
            || string.Equals(SelectedApplicationGroup, PersonDossierApplicationGroups.All, StringComparison.Ordinal))
            return section.Records;

        return section.Records
            .Where(record => string.Equals(record.ApplicationGroupId, SelectedApplicationGroup, StringComparison.Ordinal))
            .ToList();
    }

    private IReadOnlyList<PersonDossierRecord> DisplayedRecords(
        PersonDossierSection section,
        IReadOnlyList<PersonDossierRecord> visibleRecords) =>
        IsSectionExpanded(section) || visibleRecords.Count <= SectionPreviewLimit
            ? visibleRecords
            : visibleRecords.Take(SectionPreviewLimit).ToList();

    private string ExpansionKey(PersonDossierSection section) =>
        section.ApplicationGroups.Count == 0
            ? section.SectionId
            : section.SectionId + "|" + SelectedApplicationGroup;

    private bool IsSectionExpanded(PersonDossierSection section) =>
        _expandedSections.Contains(ExpansionKey(section));

    private void ToggleSectionExpansion(PersonDossierSection section)
    {
        var key = ExpansionKey(section);
        if (!_expandedSections.Add(key))
            _expandedSections.Remove(key);
    }
    private DossierViewMode _viewMode = DossierViewMode.Screen;
    private string _paperHtml = string.Empty;
    private PersonDossierSnapshot? _paperSnapshotRef;
    private string? _paperCulture;

    private static bool IsApplicationNumberLink(PersonDossierSection section, PersonDossierRecord record, int cellIndex) =>
        cellIndex == 0
        && string.Equals(section.SectionId, "applications", StringComparison.Ordinal)
        && record.SourceObjectId is { } id
        && id != Guid.Empty
        && record.Cells.Count > 0
        && !string.IsNullOrWhiteSpace(record.Cells[0]);

    private static bool IsApplicationLinkCell(PersonDossierRecord record, int cellIndex) =>
        record.ApplicationLinkCellIndex == cellIndex
        && record.ApplicationLinkId is { } id
        && id != Guid.Empty;

    private static bool IsActiveProcessSection(PersonDossierSection section) =>
        section.SectionId is "activeProcesses" or "familyActiveProcesses";

    private static bool IsCaseRowSection(PersonDossierSection section) =>
        IsActiveProcessSection(section)
        || section.SectionId is "byApplication" or "visas" or "borderZones" or "workPermitLocations" or "rejections"
            or "familyInvitations" or "familyVisas" or "familyBorderZones";

    private static bool IsApprovalLettersCell(PersonDossierSection section, PersonDossierRecord record) =>
        IsCaseRowSection(section)
        && (record.HasApprovalLetters || record.MissingApprovalSteps.Count > 0);

    private static bool IsInlineProgressCell(PersonDossierSection section, PersonDossierRecord record, int cellIndex) =>
        cellIndex == 0
        && IsCaseRowSection(section)
        && record.ProgressSteps.Count > 0;

    private readonly HashSet<string> _openProgressRows = new(StringComparer.Ordinal);

    private bool IsProgressOpen(PersonDossierRecord record) =>
        ProcessNeedsAttention(record) || _openProgressRows.Contains(record.RecordKey);

    private void ToggleProgress(PersonDossierRecord record)
    {
        if (ProcessNeedsAttention(record))
            return;

        if (!_openProgressRows.Add(record.RecordKey))
            _openProgressRows.Remove(record.RecordKey);
    }

    /// <summary>
    /// A case that has not reached its last step stays open so the remaining steps are visible.
    /// Issued, rejected, and cancelled tracks stay collapsed until Progress is clicked.
    /// </summary>
    private static bool ProcessNeedsAttention(PersonDossierRecord record)
    {
        if (record.ProgressSteps.Count == 0)
            return false;

        if (record.ProgressSteps.Any(step => step.Tone is "rej" or "cancel" or "issued"))
            return false;

        return record.ProgressSteps.Any(step =>
            step.IsCurrentStep || step.Tone is "current" or "pending");
    }

    private static PersonDossierIssuedChip? ChipAt(PersonDossierRecord record, int cellIndex) =>
        cellIndex >= 0 && cellIndex < record.CellChips.Count
            ? record.CellChips[cellIndex]
            : null;

    private Task OnPreviewChip(PersonDossierIssuedChip chip) =>
        OnPreviewRecord(new PersonDossierRecord
        {
            RecordKey = chip.PersonCopyRecordKey ?? $"header:{chip.PreviewFamily}:{chip.PreviewParentId}",
            PreviewFamily = chip.PreviewFamily,
            PreviewParentId = chip.PreviewParentId,
            PersonCopyPersonId = chip.PersonCopyPersonId,
            PersonCopyRecordKey = chip.PersonCopyRecordKey,
            PersonCopySectionId = chip.PersonCopySectionId,
            PersonCopyDisplayName = chip.PersonCopyDisplayName,
            AppendIssuedVisaBesidePassport = chip.AppendIssuedVisaBesidePassport,
            Cells = [chip.Number],
        });

    private Task OnPreviewIssuedOutcome(PersonDossierIssuedOutcome outcome) =>
        OnPreviewRecord(new PersonDossierRecord
        {
            PreviewFamily = outcome.PreviewFamily,
            PreviewParentId = outcome.PreviewParentId,
            AppendIssuedVisaBesidePassport = outcome.AppendIssuedVisaBesidePassport,
            Cells = [outcome.Number],
        });

    private async Task OnPreviewRecord(PersonDossierRecord record)
    {
        if (PreviewRecordRequested.HasDelegate)
            await PreviewRecordRequested.InvokeAsync(record);
    }

    private async Task OnUploadRecord(PersonDossierRecord record)
    {
        if (UploadRecordRequested.HasDelegate)
            await UploadRecordRequested.InvokeAsync(record);
    }

    private async Task OnOpenApplication(Guid instanceId)
    {
        if (OpenApplicationRequested.HasDelegate)
            await OpenApplicationRequested.InvokeAsync(instanceId);
    }

    protected override void OnParametersSet()
    {
        var personId = Snapshot?.PersonId ?? Guid.Empty;
        if (personId != _expandedForPersonId)
        {
            _expandedForPersonId = personId;
            _expandedSections.Clear();
            _openProgressRows.Clear();
        }

        // Snapshot arrives after InitialLoadRequested — refresh Paper if that mode is already open.
        if (_viewMode == DossierViewMode.Paper)
            RebuildPaperHtmlIfNeeded();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !InitialLoadRequested.HasDelegate)
            return;

        _initialLoadStarted = true;
        await InitialLoadRequested.InvokeAsync();
    }

    private void ShowScreen() => _viewMode = DossierViewMode.Screen;

    private void ShowPaper()
    {
        RebuildPaperHtmlIfNeeded();
        _viewMode = DossierViewMode.Paper;
    }

    private void RebuildPaperHtmlIfNeeded()
    {
        if (Snapshot == null || Snapshot.PersonId == Guid.Empty)
        {
            _paperHtml = string.Empty;
            _paperSnapshotRef = null;
            _paperCulture = null;
            return;
        }

        var culture = CultureInfo.CurrentUICulture.Name;
        if (ReferenceEquals(Snapshot, _paperSnapshotRef)
            && string.Equals(culture, _paperCulture, StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrEmpty(_paperHtml))
        {
            return;
        }

        _paperHtml = PersonDossierDocumentHtmlBuilder.BuildFragment(Snapshot, culture);
        _paperSnapshotRef = Snapshot;
        _paperCulture = culture;
    }

    private async Task OnOpenCopies()
    {
        if (OpenCopiesRequested.HasDelegate)
            await OpenCopiesRequested.InvokeAsync();
    }

    private async Task OnExport()
    {
        if (ExportRequested.HasDelegate)
            await ExportRequested.InvokeAsync();
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);
}
