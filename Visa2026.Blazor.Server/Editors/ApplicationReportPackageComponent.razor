@implements IDisposable
@namespace Visa2026.Blazor.Server.Editors
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.AspNetCore.Http
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.WordReports
@using Visa2026.Module.Services.UserReports
@using Visa2026.Module.BusinessObjects
@using System.Text.Json
@using Visa2026.Module.Services.RuntimeLogging

<div class="app-report-package app-item-doc-copies @(UseInlinePreview ? "app-report-package--inline-slot" : string.Empty)">
    @if (ApplicationProfileInstanceId != Guid.Empty && CatalogEntries.Count > 0)
    {
        <div class="app-item-doc-copies__top-actions app-report-package__top-selection">
            <DxButton Text="@Msg("ApplicationReportPackage.SelectAll")"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      CssClass="app-item-doc-copies__action-btn"
                      Click="@SelectAllAsync" />
            <DxButton Text="@Msg("ApplicationReportPackage.ClearSelection")"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      CssClass="app-item-doc-copies__action-btn"
                      Click="@ClearSelectionAsync" />
            <DxButton Text="@Msg("ApplicationReportPackage.PlaceholderManual")"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      CssClass="app-item-doc-copies__action-btn"
                      Click="@OpenPlaceholderManualAsync" />
        </div>
    }
    <div class="app-item-doc-copies__body">
        @if (ApplicationProfileInstanceId == Guid.Empty || CatalogEntries.Count == 0)
        {
            <div class="app-item-doc-copies__empty" role="status">
                <p>@Msg("ApplicationReportPackage.Empty")</p>
            </div>
        }
        else
        {
            <div class="resminamalar-catalog">
                <div class="resminamalar-catalog__cards">
                    @foreach (var entry in CatalogEntries)
                    {
                        <section class="@GetEntryCssClass(entry, IsSelected(entry))" aria-label="@entry.DisplayName">
                            <div class="resminamalar-catalog__card-head">
                                <label class="resminamalar-catalog__include" title="@entry.DisplayName">
                                    <input type="checkbox"
                                           checked="@IsSelected(entry)"
                                           @onchange="e => OnIncludeChanged(entry, e)" />
                                </label>
                                <span class="resminamalar-catalog__nav-icon @ResminamalarCatalogFormatIcons.CssClass(entry.Kind)"
                                      aria-hidden="true">
                                    @((MarkupString)ResminamalarCatalogFormatIcons.Svg(entry.Kind))
                                </span>
                                <div class="resminamalar-catalog__main">
                                    <span class="resminamalar-catalog__title">@entry.DisplayName</span>
                                    <span class="resminamalar-catalog__summary">@FormatKindSummary(entry)</span>
                                </div>
                                <div class="resminamalar-catalog__actions">
                                    <span class="app-report-package__readiness @GetReadinessCssClass(entry)">
                                        @ReadinessLabel(entry)
                                    </span>
                                    @if (IsPreviewingEntry(entry))
                                    {
                                        <span class="app-report-package__preview-busy-label" role="status">
                                            @FormatMsg("ApplicationReportPackage.Preview.Downloading", entry.DisplayName)
                                        </span>
                                    }
                                    else
                                    {
                                        @if (ShowDetails && CanEditTemplate(entry))
                                        {
                                            <DxButton Text="@Msg("ApplicationReportPackage.EditTemplate")"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      SizeMode="SizeMode.Small"
                                                      CssClass="app-item-doc-copies__action-btn"
                                                      title="@Msg("ApplicationReportPackage.EditTemplate.Tooltip")"
                                                      Enabled="@(!_packageBusy && !_previewBusy && !_refreshBusy && !_syncBusy && _editTemplateId == null)"
                                                      Click="@(() => EditTemplateAsync(entry))" />
                                            @if (IsDownloadedForEdit(entry))
                                            {
                                                <span class="app-report-package__staging-badge" role="status">
                                                    @Msg("ApplicationReportPackage.EditTemplate.OnDownloaded")
                                                </span>
                                            }
                                        }
                                        <DxButton Text="@Msg("ApplicationReportPackage.Preview")"
                                                  RenderStyle="ButtonRenderStyle.Link"
                                                  SizeMode="SizeMode.Small"
                                                  CssClass="app-item-doc-copies__action-btn"
                                                  Enabled="@(!_packageBusy && !_previewBusy)"
                                                  Click="@(() => PreviewEntryAsync(entry))" />
                                    }
                                </div>
                            </div>
                            @if (IsPreviewingEntry(entry) || HasCardDetails(entry))
                            {
                                <div class="resminamalar-catalog__card-body">
                                    @if (IsPreviewingEntry(entry))
                                    {
                                        <div class="app-report-package__entry-progress" role="progressbar" aria-busy="true"
                                             aria-label="@FormatMsg("ApplicationReportPackage.Preview.Downloading", entry.DisplayName)">
                                            <div class="app-report-package__preview-progress-track">
                                                <div class="app-report-package__preview-progress-indeterminate"></div>
                                            </div>
                                        </div>
                                    }
                                    @if (HasCardDetails(entry))
                                    {
                                        <div class="app-item-doc-copies__status">
                                            @if (!UseInlinePreview && !string.IsNullOrWhiteSpace(entry.OutputFileName))
                                            {
                                                <p class="app-item-doc-copies__summary">@entry.OutputFileName</p>
                                            }
                                            @if (ShowDetails)
                                            {
                                                @if (!string.IsNullOrWhiteSpace(entry.ReadinessMessageKey))
                                                {
                                                    <p class="app-item-doc-copies__hint app-item-doc-copies__hint--warning">@Msg(entry.ReadinessMessageKey)</p>
                                                }
                                                @if (entry.ReadinessHints.Count > 0)
                                                {
                                                    <ul class="app-report-package__hints">
                                                        @foreach (var hint in entry.ReadinessHints)
                                                        {
                                                            <li class="app-report-package__hint">@FormatHint(hint)</li>
                                                        }
                                                    </ul>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            </div>
        }
    </div>

    @if (ApplicationProfileInstanceId != Guid.Empty && CatalogEntries.Count > 0)
    {
        <footer class="app-item-doc-copies__footer">
            <div class="app-item-doc-copies__package-bar">
                <div class="app-item-doc-copies__package-bar-main">
                    <p class="app-item-doc-copies__subtitle">@GetSubtitle()</p>
                    @if (_packageConfirmPending)
                    {
                        <p class="app-item-doc-copies__toolbar-hint">@Msg("ApplicationReportPackage.PackageConfirmPrompt")</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_packageStatusMessage))
                    {
                        <p class="app-item-doc-copies__toolbar-hint @(_packageStatusIsError ? "app-item-doc-copies__toolbar-hint--error" : string.Empty)"
                           role="@(_packageStatusIsError ? "alert" : "status")">
                            @_packageStatusMessage
                        </p>
                    }
                </div>
                <div class="app-item-doc-copies__package-bar-actions">
                    @if (_packageConfirmPending)
                    {
                        <DxButton Text="@Msg("ApplicationReportPackage.PackageConfirmDownload")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Enabled="@(!_packageBusy && SelectedCount > 0)"
                                  Click="@ConfirmDownloadPackageAsync" />
                        <DxButton Text="@Msg("ApplicationReportPackage.PackageCancelConfirm")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Click="@CancelPackageConfirm" />
                    }
                    else
                    {
                        <DxButton Text="@Msg("ApplicationReportPackage.DownloadPackage")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Enabled="@(!_packageBusy && SelectedCount > 0)"
                                  Click="@OnDownloadPackageClickAsync" />
                    }
                    @if (_canEditUserTemplates)
                    {
                        @* Native button — file picker needs a live user-activation token from onclick. *@
                        <button type="button"
                                class="dxbl-btn dxbl-btn-link dxbl-btn-sm app-item-doc-copies__action-btn app-report-package__sync-templates-btn"
                                disabled="@(_syncBusy || _packageBusy || _refreshBusy)"
                                onclick="visaTemplateStagingLocal.syncFromFilePickerDirect()">
                            @Msg("ApplicationReportPackage.SyncTemplates")
                        </button>
                    }
                    <DxButton Text="@Msg("ApplicationReportPackage.Refresh")"
                              RenderStyle="ButtonRenderStyle.Link"
                              SizeMode="SizeMode.Small"
                              CssClass="app-item-doc-copies__action-btn"
                              Enabled="@(!_refreshBusy && !_packageBusy && !_syncBusy)"
                              Click="@OnRefreshClickAsync" />
                </div>
            </div>
            <button type="button"
                    class="@GearButtonCssClass"
                    title="@GearToolTip"
                    aria-label="@GearToolTip"
                    aria-pressed="@ShowDetails"
                    @onclick="ToggleDetailsAsync">
                <svg class="cs-multi-select-popup__gear-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81a.488.488 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L2.74 8.87a.488.488 0 0 0 .12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.488.488 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.488.488 0 0 0-.12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 15.6 12 3.6 3.6 0 0 1 12 15.6z" />
                </svg>
            </button>
        </footer>
    }
</div>

@if (!UseInlinePreview)
{
    <ApplicationReportPackagePreviewDialog @ref="_previewDialog" />
}

@code {
    [Parameter] public Guid ApplicationProfileInstanceId { get; set; }
    [Parameter] public WordReportPackageScope PackageScope { get; set; } = WordReportPackageScope.ApplicationProfileInstance;
    [Parameter] public IReadOnlyList<Guid> ApplicationItemIds { get; set; } = Array.Empty<Guid>();
    [Parameter] public string ApplicationNumber { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<ApplicationWordReportPackageCatalogEntry> CatalogEntries { get; set; } =
        Array.Empty<ApplicationWordReportPackageCatalogEntry>();
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public string UiCultureName { get; set; } = string.Empty;
    [Parameter] public bool UseInlinePreview { get; set; }
    [Parameter] public string? FocusEntryKey { get; set; }
    [Parameter] public EventCallback<ReportPackagePreviewRequest> OnInlinePreviewRequested { get; set; }

    [Inject] private ApplicationWordReportPackageEnqueueService PackageEnqueueService { get; set; } = null!;
    [Inject] private UserReportTemplateStagingUiService TemplateStagingUiService { get; set; } = null!;
    [Inject] private IXafCultureInfoService CultureInfoService { get; set; } = null!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private IApplicationErrorReporter ErrorReporter { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService PreviewSlotService { get; set; } = null!;

    private ApplicationReportPackagePreviewDialog? _previewDialog;
    private DotNetObjectReference<ApplicationReportPackageComponent>? _dotNetRef;

    private readonly HashSet<string> _selectedKeys = new(StringComparer.Ordinal);
    private bool _selectionInitialized;
    private bool _packageConfirmPending;
    private bool _packageBusy;
    private bool _previewBusy;
    private string? _previewEntryKey;
    private string? _handledFocusEntryKey;

    private string _packageStatusMessage = string.Empty;
    private bool _packageStatusIsError;
    private bool _canEditUserTemplates;
    private bool _refreshBusy;
    private bool _syncBusy;
    private Guid? _editTemplateId;
    private readonly HashSet<Guid> _downloadedTemplateIds = new();
    private bool ShowDetails;

    private static readonly JsonSerializerOptions SyncResultJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    private int SelectedCount => _selectedKeys.Count;

    private ApplicationWordReportPackageReadinessSummary SelectedReadinessSummary =>
        ApplicationWordReportPackageReadinessSummary.Compute(CatalogEntries, _selectedKeys);

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(FocusEntryKey)
            || CatalogEntries.Count == 0
            || string.Equals(_handledFocusEntryKey, FocusEntryKey, StringComparison.Ordinal))
        {
            return;
        }

        var entry = CatalogEntries.FirstOrDefault(e =>
            string.Equals(e.EntryKey, FocusEntryKey, StringComparison.Ordinal));
        if (entry == null)
            return;

        _handledFocusEntryKey = FocusEntryKey;
        await PreviewEntryAsync(entry);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _canEditUserTemplates)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("visaTemplateStagingLocal.initDotNetRef", _dotNetRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }

    /// <summary>Called by <c>visaTemplateStagingLocal.syncFromFilePickerDirect()</c> before the file picker opens.</summary>
    [JSInvokable]
    public async Task OnSyncFromFilePickerStarted()
    {
        if (!_canEditUserTemplates)
            return;

        _packageConfirmPending = false;
        ClearStatusMessages();
        _syncBusy = true;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called by <c>visaTemplateStagingLocal.syncFromFilePickerDirect()</c> after uploads finish.</summary>
    [JSInvokable]
    public async Task OnSyncFromFilePickerResult(string json)
    {
        try
        {
            if (!_canEditUserTemplates || string.IsNullOrWhiteSpace(json))
                return;

            var collect = JsonSerializer.Deserialize<UserReportTemplateStagingLocalCollectJsResult>(
                json,
                SyncResultJsonOptions);
            if (collect == null)
            {
                _packageStatusMessage = Msg("ApplicationReportPackage.SyncTemplates.ImportFailed");
                _packageStatusIsError = true;
                return;
            }

            if (collect.Cancelled)
            {
                ClearStatusMessages();
                return;
            }

            await ApplySyncCollectResultAsync(collect);
        }
        catch (Exception ex)
        {
            _packageStatusMessage = Msg("ApplicationReportPackage.SyncTemplates.ImportFailed");
            _packageStatusIsError = true;
            ErrorReporter.ReportReportPackageError(
                "Resminamalar template staging import failed.",
                ApplicationRuntimeLogCategories.ReportPackageComponent,
                ex);
        }
        finally
        {
            _syncBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        if (_dotNetRef != null)
        {
            try
            {
                JS.InvokeVoidAsync("visaTemplateStagingLocal.disposeDotNetRef").AsTask().GetAwaiter();
            }
            catch
            {
                // Best-effort; component is being disposed.
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    protected override void OnParametersSet()
    {
        _canEditUserTemplates = TemplateStagingUiService.CanEditTemplates();

        var currentKeys = CatalogEntries
            .Select(entry => entry.EntryKey)
            .ToHashSet(StringComparer.Ordinal);

        if (_selectionInitialized)
        {
            _selectedKeys.IntersectWith(currentKeys);
            return;
        }

        _selectedKeys.Clear();
        foreach (var key in currentKeys)
            _selectedKeys.Add(key);

        _selectionInitialized = currentKeys.Count > 0;
    }

    private string EffectiveUiCulture =>
        VisaUiCultureResolver.Resolve(CultureInfoService, HttpContextAccessor.HttpContext, UiCultureName);

    private string Msg(string key) => VisaUiMessages.Get(key, EffectiveUiCulture);

    private string FormatMsg(string key, params object[] args) =>
        VisaUiMessages.FormatForCulture(EffectiveUiCulture, key, args);

    private string GetSubtitle() =>
        FormatMsg("ApplicationReportPackage.SubtitleSelected", SelectedCount, CatalogEntries.Count, ApplicationNumber);

    private string GearToolTip => ShowDetails
        ? Msg("ApplicationReportPackage.Gear.HideDetails")
        : Msg("ApplicationReportPackage.Gear.ShowDetails");

    private string GearButtonCssClass => ShowDetails
        ? "cs-multi-select-popup__gear-btn cs-multi-select-popup__gear-btn--active"
        : "cs-multi-select-popup__gear-btn";

    private Task ToggleDetailsAsync()
    {
        ShowDetails = !ShowDetails;
        return Task.CompletedTask;
    }

    private bool IsSelected(ApplicationWordReportPackageCatalogEntry entry) =>
        _selectedKeys.Contains(entry.EntryKey);

    private void OnIncludeChanged(ApplicationWordReportPackageCatalogEntry entry, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
            _selectedKeys.Add(entry.EntryKey);
        else
            _selectedKeys.Remove(entry.EntryKey);

        _packageConfirmPending = false;
        ClearStatusMessages();
    }

    private Task SelectAllAsync()
    {
        foreach (var entry in CatalogEntries)
            _selectedKeys.Add(entry.EntryKey);
        _packageConfirmPending = false;
        ClearStatusMessages();
        return Task.CompletedTask;
    }

    private Task ClearSelectionAsync()
    {
        _selectedKeys.Clear();
        _packageConfirmPending = false;
        ClearStatusMessages();
        return Task.CompletedTask;
    }

    private async Task OpenPlaceholderManualAsync()
    {
        var rootBoType = PackageScope == WordReportPackageScope.RosterPerson
            ? UserReportBoType.ApplicationItem
            : UserReportBoType.ApplicationProfileInstance;

        await PreviewSlotService.OpenPlaceholderManualAsync(
            new PlaceholderManualSlotRequest { FilterRootBoType = rootBoType });
    }

    private static string FormatKind(ApplicationWordReportPackageEntryKind kind) =>
        kind switch
        {
            ApplicationWordReportPackageEntryKind.UserExcel => ".xlsx",
            _ => ".docx"
        };

    private static string FormatKindSummary(ApplicationWordReportPackageCatalogEntry entry) =>
        entry.Kind == ApplicationWordReportPackageEntryKind.UserExcel
            ? $"Excel · {FormatKind(entry.Kind)}"
            : $"Word · {FormatKind(entry.Kind)}";

    private bool HasCardDetails(ApplicationWordReportPackageCatalogEntry entry) =>
        (!UseInlinePreview && !string.IsNullOrWhiteSpace(entry.OutputFileName))
        || (ShowDetails
            && (!string.IsNullOrWhiteSpace(entry.ReadinessMessageKey) || entry.ReadinessHints.Count > 0));

    private bool CanEditTemplate(ApplicationWordReportPackageCatalogEntry entry) =>
        _canEditUserTemplates
        && entry.UserReportTemplateId is Guid templateId
        && templateId != Guid.Empty;

    private bool IsDownloadedForEdit(ApplicationWordReportPackageCatalogEntry entry) =>
        entry.UserReportTemplateId is Guid templateId
        && _downloadedTemplateIds.Contains(templateId);

    private async Task EditTemplateAsync(ApplicationWordReportPackageCatalogEntry entry)
    {
        if (!_canEditUserTemplates
            || entry.UserReportTemplateId is not Guid templateId
            || templateId == Guid.Empty
            || _editTemplateId.HasValue
            || _packageBusy
            || _previewBusy
            || _refreshBusy)
        {
            return;
        }

        ClearStatusMessages();
        _editTemplateId = templateId;
        await InvokeAsync(StateHasChanged);

        try
        {
            var outcome = await TemplateStagingUiService.ExportForEditAsync(templateId);
            if (!outcome.Success || outcome.Result == null)
            {
                _packageStatusMessage = outcome.ErrorMessage ?? Msg("ApplicationReportPackage.EditTemplate.ExportFailed");
                _packageStatusIsError = true;
                return;
            }

            if (outcome.Result.FileContent == null || outcome.Result.FileContent.Length == 0)
            {
                _packageStatusMessage = Msg("ApplicationReportPackage.EditTemplate.ExportFailed");
                _packageStatusIsError = true;
                return;
            }

            var downloadResult = await JS.InvokeAsync<UserReportTemplateStagingDownloadJsResult>(
                "visaTemplateStagingLocal.downloadTemplate",
                new
                {
                    fileName = outcome.Result.DocumentFileName,
                    templateId = templateId.ToString(),
                    displayName = outcome.Result.DisplayName,
                    fileBase64 = Convert.ToBase64String(outcome.Result.FileContent),
                    exportedAtUtc = DateTime.UtcNow.ToString("o"),
                });

            if (downloadResult == null || !downloadResult.Success)
            {
                _packageStatusMessage = downloadResult?.Error
                    ?? Msg("ApplicationReportPackage.EditTemplate.ExportFailed");
                _packageStatusIsError = true;
                return;
            }

            _downloadedTemplateIds.Add(templateId);
            _packageStatusMessage = FormatMsg(
                "ApplicationReportPackage.EditTemplate.Downloaded",
                outcome.Result.DisplayName,
                outcome.Result.DocumentFileName);
            _packageStatusIsError = false;
        }
        catch (Exception ex)
        {
            _packageStatusMessage = Msg("ApplicationReportPackage.EditTemplate.ExportFailed");
            _packageStatusIsError = true;
            ErrorReporter.ReportReportPackageError(
                "Resminamalar template staging export failed.",
                ApplicationRuntimeLogCategories.ReportPackageComponent,
                ex);
        }
        finally
        {
            _editTemplateId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplySyncCollectResultAsync(UserReportTemplateStagingLocalCollectJsResult collect)
    {
        var result = UserReportTemplateStagingUiService.MapCollectResult(collect);
        if (result.ImportedCount == 0
            && result.FailedCount == 0
            && result.SkippedUnchangedCount > 0)
        {
            _packageStatusMessage = Msg("ApplicationReportPackage.SyncTemplates.NoLocalChanges");
            _packageStatusIsError = true;
            return;
        }

        _packageStatusMessage = FormatMsg(
            "ApplicationReportPackage.SyncTemplates.ImportSummary",
            result.ImportedCount,
            result.SkippedUnchangedCount,
            result.FailedCount);
        _packageStatusIsError = result.FailedCount > 0;

        var firstFailure = result.Results.FirstOrDefault(r =>
            r.Status == UserReportTemplateStagingImportStatus.Failed
            && !string.IsNullOrWhiteSpace(r.ErrorMessage));
        if (firstFailure?.ErrorMessage != null)
        {
            _packageStatusMessage += " " + firstFailure.ErrorMessage;
        }

        foreach (var imported in result.Results.Where(r =>
                     r.Status == UserReportTemplateStagingImportStatus.Imported))
        {
            _downloadedTemplateIds.Remove(imported.TemplateId);
        }

        var locked = result.Results.FirstOrDefault(r =>
            r.Status == UserReportTemplateStagingImportStatus.Failed
            && !string.IsNullOrWhiteSpace(r.ErrorMessage)
            && r.ErrorMessage.Contains("locked", StringComparison.OrdinalIgnoreCase));
        if (locked != null)
        {
            _packageStatusMessage = Msg("ApplicationReportPackage.SyncTemplates.FileLocked");
            _packageStatusIsError = true;
            return;
        }

        if (RefreshRequested.HasDelegate)
            await RefreshRequested.InvokeAsync();
    }

    private async Task OnRefreshClickAsync()
    {
        if (_refreshBusy || _packageBusy || _syncBusy)
            return;

        _packageConfirmPending = false;
        ClearStatusMessages();
        _refreshBusy = true;

        try
        {
            if (RefreshRequested.HasDelegate)
                await RefreshRequested.InvokeAsync();
        }
        finally
        {
            _refreshBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string ReadinessLabel(ApplicationWordReportPackageCatalogEntry entry) =>
        entry.Readiness == ApplicationWordReportPackageReadinessLevel.Warning
            ? Msg("ApplicationReportPackage.Readiness.Warning")
            : Msg("ApplicationReportPackage.Readiness.Ready");

    private string GetEntryCssClass(ApplicationWordReportPackageCatalogEntry entry, bool isSelected) =>
        IsPreviewingEntry(entry)
            ? $"{GetEntryStateCssClass(entry, isSelected)} app-report-package__entry--previewing"
            : GetEntryStateCssClass(entry, isSelected);

    private static string GetEntryStateCssClass(ApplicationWordReportPackageCatalogEntry entry, bool isSelected)
    {
        var stateClass = !isSelected
            ? "app-report-package__entry--unchecked"
            : entry.Readiness == ApplicationWordReportPackageReadinessLevel.Warning
                ? "app-report-package__entry--warning"
                : "app-report-package__entry--ready";
        return $"resminamalar-catalog__card app-report-package__entry {stateClass}";
    }

    private static string GetReadinessCssClass(ApplicationWordReportPackageCatalogEntry entry) =>
        entry.Readiness == ApplicationWordReportPackageReadinessLevel.Warning
            ? "app-report-package__readiness--warning"
            : "app-report-package__readiness--ready";

    private Task OnDownloadPackageClickAsync()
    {
        if (SelectedCount == 0)
        {
            _packageStatusMessage = Msg("ApplicationReportPackage.EnqueueErrorNoSelection");
            _packageStatusIsError = true;
            return Task.CompletedTask;
        }

        if (SelectedReadinessSummary.HasWarnings)
        {
            _packageConfirmPending = true;
            ClearStatusMessages();
            return Task.CompletedTask;
        }

        return EnqueuePackageAsync();
    }

    private Task ConfirmDownloadPackageAsync()
    {
        _packageConfirmPending = false;
        return EnqueuePackageAsync();
    }

    private Task CancelPackageConfirm()
    {
        _packageConfirmPending = false;
        return Task.CompletedTask;
    }

    private string FormatHint(ApplicationWordReportPackageReadinessHint hint) =>
        hint.FormatArgs.Count == 0
            ? Msg(hint.MessageKey)
            : FormatMsg(hint.MessageKey, hint.FormatArgs.Cast<object>().ToArray());

    private bool IsPreviewingEntry(ApplicationWordReportPackageCatalogEntry entry) =>
        _previewBusy
        && !string.IsNullOrWhiteSpace(_previewEntryKey)
        && string.Equals(_previewEntryKey, entry.EntryKey, StringComparison.Ordinal);

    private async Task PreviewEntryAsync(ApplicationWordReportPackageCatalogEntry entry)
    {
        if (ApplicationProfileInstanceId == Guid.Empty || _previewBusy || _packageBusy)
            return;

        if (!UseInlinePreview && _previewDialog == null)
            return;

        ClearStatusMessages();
        _previewBusy = true;
        _previewEntryKey = entry.EntryKey;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            if (UseInlinePreview && OnInlinePreviewRequested.HasDelegate)
            {
                await OnInlinePreviewRequested.InvokeAsync(new ReportPackagePreviewRequest
                {
                    ApplicationProfileInstanceId = ApplicationProfileInstanceId,
                    EntryKey = entry.EntryKey,
                    DisplayName = entry.DisplayName,
                    ApplicationItemIds = ApplicationItemIds,
                });
            }
            else if (_previewDialog != null)
            {
                await _previewDialog.OpenAsync(ApplicationProfileInstanceId, entry.EntryKey, entry.DisplayName, ApplicationItemIds);
            }
        }
        finally
        {
            _previewBusy = false;
            _previewEntryKey = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnqueuePackageAsync()
    {
        if (_packageBusy || ApplicationProfileInstanceId == Guid.Empty || SelectedCount == 0)
            return;

        _packageBusy = true;
        ClearStatusMessages();

        try
        {
            var outcome = await PackageEnqueueService.EnqueuePackageAsync(
                ApplicationProfileInstanceId,
                _selectedKeys.ToList(),
                ApplicationItemIds);

            if (!outcome.Success)
            {
                _packageStatusMessage = outcome.ErrorMessage ?? Msg("ApplicationReportPackage.Package.Error");
                _packageStatusIsError = true;
                ErrorReporter.ReportReportPackageError(
                    _packageStatusMessage,
                    ApplicationRuntimeLogCategories.ReportPackageComponent,
                    relatedBatchId: outcome.BatchId != Guid.Empty ? outcome.BatchId : null);
                return;
            }

            await JS.InvokeVoidAsync("visaWordBatchToast.setCurrentBatchId", outcome.BatchId.ToString("D"));
            _packageStatusMessage = FormatMsg("ApplicationReportPackage.Package.Queued", outcome.ReportCount);
            _packageStatusIsError = false;
        }
        catch (Exception ex)
        {
            _packageStatusMessage = Msg("ApplicationReportPackage.Package.Error");
            _packageStatusIsError = true;
            ErrorReporter.ReportReportPackageError(
                "Resminamalar report package enqueue failed unexpectedly.",
                ApplicationRuntimeLogCategories.ReportPackageComponent,
                ex);
        }
        finally
        {
            _packageBusy = false;
        }
    }

    private void ClearStatusMessages()
    {
        _packageStatusMessage = string.Empty;
        _packageStatusIsError = false;
        _previewEntryKey = null;
    }
}
