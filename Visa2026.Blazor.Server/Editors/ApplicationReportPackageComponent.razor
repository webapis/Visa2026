@implements IDisposable
@namespace Visa2026.Blazor.Server.Editors
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using DevExpress.ExpressApp
@using DevExpress.ExpressApp.Security
@using DevExpress.ExpressApp.Blazor.Services
@using Microsoft.AspNetCore.Http
@using Visa2026.Blazor.Server.Localization
@using Visa2026.Blazor.Server.Services
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.WordReports
@using Visa2026.Module.Services.UserReports
@using Visa2026.Module.Services.TemplateConvert
@using Visa2026.Module.Services.TemplateScan
@using Visa2026.Module.BusinessObjects
@using Microsoft.Extensions.Options
@using System.Text.Json
@using Visa2026.Module.Services.RuntimeLogging

<div class="app-report-package app-item-doc-copies @(UseInlinePreview ? "app-report-package--inline-slot" : string.Empty)">
    @if (ApplicationProfileInstanceId != Guid.Empty)
    {
        <div class="app-item-doc-copies__top-actions app-report-package__top-selection">
            @if (ShowRecycleBinTab)
            {
                <div class="resminamalar-catalog__pane-tabs" role="tablist">
                    <DxButton Text="@Msg("ApplicationReportPackage.CatalogTab")"
                              RenderStyle="ButtonRenderStyle.Link"
                              SizeMode="SizeMode.Small"
                              CssClass="@CatalogPaneTabCss"
                              Click="@ShowCatalogPaneAsync" />
                    <DxButton Text="@FormatMsg("ApplicationReportPackage.RecycleBinTab", VisibleRecycleBinEntries.Count)"
                              RenderStyle="ButtonRenderStyle.Link"
                              SizeMode="SizeMode.Small"
                              CssClass="@RecycleBinPaneTabCss"
                              Click="@ShowRecycleBinPaneAsync" />
                </div>
            }
            @if (IsCatalogPane && VisibleCatalogEntries.Count > 0)
            {
            <DxButton Text="@Msg("ApplicationReportPackage.SelectAll")"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      CssClass="app-item-doc-copies__action-btn"
                      Click="@SelectAllAsync" />
            <DxButton Text="@Msg("ApplicationReportPackage.ClearSelection")"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      CssClass="app-item-doc-copies__action-btn"
                      Click="@ClearSelectionAsync" />
            }
            @if (IsCatalogPane)
            {
            <DxButton Text="@Msg("ApplicationReportPackage.PlaceholderManual")"
                      RenderStyle="ButtonRenderStyle.Link"
                      SizeMode="SizeMode.Small"
                      CssClass="app-item-doc-copies__action-btn"
                      Click="@OpenPlaceholderManualAsync" />
            @if (ShowScanEntryVisible)
            {
                <DxButton Text="Create from yellow marks"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          CssClass="app-item-doc-copies__action-btn"
                          title="@ScanEntryTitle"
                          Click="@OpenScanAsync" />
            }
            @if (ShowConvertEntry)
            {
                <DxButton Text="Convert existing document"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          CssClass="app-item-doc-copies__action-btn"
                          Click="@(() => OpenConvertAsync(manual: false))" />
                <DxButton Text="Add prepared template"
                          RenderStyle="ButtonRenderStyle.Link"
                          SizeMode="SizeMode.Small"
                          CssClass="app-item-doc-copies__action-btn"
                          Click="@(() => OpenConvertAsync(manual: true))" />
            }
            }
        </div>
    }
    <div class="app-item-doc-copies__body">
        @if (ApplicationProfileInstanceId == Guid.Empty)
        {
            <div class="app-item-doc-copies__empty" role="status">
                <p>@Msg("ApplicationReportPackage.Empty")</p>
            </div>
        }
        else if (!IsCatalogPane)
        {
            @if (VisibleRecycleBinEntries.Count == 0)
            {
                <div class="app-item-doc-copies__empty" role="status">
                    <p>@Msg("ApplicationReportPackage.RecycleBin.Empty")</p>
                </div>
            }
            else
            {
                <div class="resminamalar-catalog">
                    <div class="resminamalar-catalog__cards">
                        @foreach (var entry in VisibleRecycleBinEntries)
                        {
                            <section @key="entry.EntryKey" class="resminamalar-catalog__card app-report-package__entry" aria-label="@entry.DisplayName">
                                <div class="resminamalar-catalog__card-head">
                                    <span class="resminamalar-catalog__nav-icon @ResminamalarCatalogFormatIcons.CssClass(entry.Kind)"
                                          aria-hidden="true">
                                        @((MarkupString)ResminamalarCatalogFormatIcons.Svg(entry.Kind))
                                    </span>
                                    <div class="resminamalar-catalog__main">
                                        <span class="resminamalar-catalog__title">@entry.DisplayName</span>
                                        <span class="resminamalar-catalog__summary">@FormatRecycleSummary(entry)</span>
                                    </div>
                                    <div class="resminamalar-catalog__actions">
                                        <span class="app-report-package__readiness app-report-package__readiness--warning">
                                            @Msg("ApplicationReportPackage.RecycleBin.InBin")
                                        </span>
                                        @if (IsRecyclingEntry(entry))
                                        {
                                            <span class="app-report-package__preview-busy-label" role="status">
                                                @GetRecycleBusyPrompt()
                                            </span>
                                        }
                                        else
                                        {
                                        <DxButton Text="@Msg("ApplicationReportPackage.Restore")"
                                                  RenderStyle="ButtonRenderStyle.Link"
                                                  SizeMode="SizeMode.Small"
                                                  CssClass="app-item-doc-copies__action-btn"
                                                  title="@Msg("ApplicationReportPackage.Restore.Tooltip")"
                                                  Enabled="@(!_recycleBusy && !_packageBusy && !_previewBusy)"
                                                  Click="@(() => RestoreFromRecycleBinAsync(entry))" />
                                        <DxButton Text="@Msg("ApplicationReportPackage.DeletePermanently")"
                                                  RenderStyle="ButtonRenderStyle.Link"
                                                  SizeMode="SizeMode.Small"
                                                  CssClass="app-item-doc-copies__action-btn"
                                                  title="@Msg("ApplicationReportPackage.DeletePermanently.Tooltip")"
                                                  Enabled="@(!_recycleBusy && !_packageBusy && !_previewBusy)"
                                                  Click="@(() => BeginPurgeConfirm(entry))" />
                                        }
                                    </div>
                                </div>
                                @if (IsRecyclingEntry(entry))
                                {
                                    <div class="resminamalar-catalog__card-body">
                                        <div class="app-report-package__entry-progress" role="progressbar" aria-busy="true"
                                             aria-label="@GetRecycleBusyPrompt()">
                                            <div class="app-report-package__preview-progress-track">
                                                <div class="app-report-package__preview-progress-indeterminate"></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                </div>
            }
        }
        else if (VisibleCatalogEntries.Count == 0)
        {
            <div class="app-item-doc-copies__empty" role="status">
                <p>@Msg("ApplicationReportPackage.Empty")</p>
            </div>
        }
        else
        {
            <div class="resminamalar-catalog">
                <div class="resminamalar-catalog__cards">
                    @foreach (var entry in VisibleCatalogEntries)
                    {
                        <section @key="entry.EntryKey" class="@GetEntryCssClass(entry, IsSelected(entry))" aria-label="@entry.DisplayName">
                            <div class="resminamalar-catalog__card-head">
                                <label class="resminamalar-catalog__include" title="@entry.DisplayName">
                                    <input type="checkbox"
                                           checked="@IsSelected(entry)"
                                           @onchange="e => OnIncludeChanged(entry, e)" />
                                </label>
                                <span class="resminamalar-catalog__nav-icon @ResminamalarCatalogFormatIcons.CssClass(entry.Kind)"
                                      aria-hidden="true">
                                    @((MarkupString)ResminamalarCatalogFormatIcons.Svg(entry.Kind))
                                </span>
                                <div class="resminamalar-catalog__main">
                                    <span class="resminamalar-catalog__title">@entry.DisplayName</span>
                                    <span class="resminamalar-catalog__summary">@FormatKindSummary(entry)</span>
                                </div>
                                <div class="resminamalar-catalog__actions">
                                    <span class="app-report-package__readiness @GetReadinessCssClass(entry)">
                                        @ReadinessLabel(entry)
                                    </span>
                                    @if (IsRecyclingEntry(entry))
                                    {
                                        <span class="app-report-package__preview-busy-label" role="status">
                                            @GetRecycleBusyPrompt()
                                        </span>
                                    }
                                    else if (IsPreviewingEntry(entry))
                                    {
                                        <span class="app-report-package__preview-busy-label" role="status">
                                            @FormatMsg("ApplicationReportPackage.Preview.Downloading", entry.DisplayName)
                                        </span>
                                    }
                                    else
                                    {
                                        <DxButton Text="@Msg("ApplicationReportPackage.Preview")"
                                                  RenderStyle="ButtonRenderStyle.Link"
                                                  SizeMode="SizeMode.Small"
                                                  CssClass="app-item-doc-copies__action-btn"
                                                  Enabled="@(!_packageBusy && !_previewBusy && !_recycleBusy)"
                                                  Click="@(() => PreviewEntryAsync(entry))" />
                                        @if (ShowDetails && CanDownloadTemplate(entry))
                                        {
                                            <DxButton Text="@Msg("ApplicationReportPackage.DownloadTemplate")"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      SizeMode="SizeMode.Small"
                                                      CssClass="app-item-doc-copies__action-btn"
                                                      title="@Msg("ApplicationReportPackage.DownloadTemplate.Tooltip")"
                                                      Enabled="@(!_packageBusy && !_previewBusy && !_refreshBusy && !_syncBusy && _editTemplateId == null && _downloadTemplateId == null)"
                                                      Click="@(() => DownloadTemplateAsync(entry))" />
                                        }
                                        @if (ShowDetails && CanReviewPlaceholders(entry))
                                        {
                                            <DxButton Text="Review placeholders"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      SizeMode="SizeMode.Small"
                                                      CssClass="app-item-doc-copies__action-btn"
                                                      title="Open Create from yellow marks on this catalog template"
                                                      Enabled="@(!_packageBusy && !_previewBusy && !_recycleBusy && !_scanReviewBusy)"
                                                      Click="@(() => OpenScanReviewAsync(entry))" />
                                        }
                                        @if (ShowDetails && entry.CanMoveToRecycleBin)
                                        {
                                            <button type="button"
                                                    class="resminamalar-catalog__recycle-btn"
                                                    title="@Msg("ApplicationReportPackage.MoveToRecycleBin.Tooltip")"
                                                    aria-label="@Msg("ApplicationReportPackage.MoveToRecycleBin.Tooltip")"
                                                    disabled="@(_packageBusy || _previewBusy || _recycleBusy)"
                                                    @onclick="() => BeginMoveToRecycleBinConfirm(entry)">
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                    <path d="M4 7h16" />
                                                    <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                                    <path d="M6 7l1.2 13.2A1 1 0 0 0 8.2 21h7.6a1 1 0 0 0 1-.8L18 7" />
                                                    <path d="M10 11v6M14 11v6" />
                                                </svg>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                            @if (IsRecyclingEntry(entry) || IsPreviewingEntry(entry) || HasCardDetails(entry))
                            {
                                <div class="resminamalar-catalog__card-body">
                                    @if (IsRecyclingEntry(entry) || IsPreviewingEntry(entry))
                                    {
                                        <div class="app-report-package__entry-progress" role="progressbar" aria-busy="true"
                                             aria-label="@(IsRecyclingEntry(entry)
                                                 ? GetRecycleBusyPrompt()
                                                 : FormatMsg("ApplicationReportPackage.Preview.Downloading", entry.DisplayName))">
                                            <div class="app-report-package__preview-progress-track">
                                                <div class="app-report-package__preview-progress-indeterminate"></div>
                                            </div>
                                        </div>
                                    }
                                    @if (HasCardDetails(entry))
                                    {
                                        <div class="app-item-doc-copies__status">
                                            @if (!UseInlinePreview && !string.IsNullOrWhiteSpace(entry.OutputFileName))
                                            {
                                                <p class="app-item-doc-copies__summary">@entry.OutputFileName</p>
                                            }
                                            @if (ShowDetails)
                                            {
                                                @if (!string.IsNullOrWhiteSpace(entry.ReadinessMessageKey))
                                                {
                                                    <p class="app-item-doc-copies__hint app-item-doc-copies__hint--warning">@Msg(entry.ReadinessMessageKey)</p>
                                                }
                                                @if (entry.ReadinessHints.Count > 0)
                                                {
                                                    <ul class="app-report-package__hints">
                                                        @foreach (var hint in entry.ReadinessHints)
                                                        {
                                                            <li class="app-report-package__hint">@FormatHint(hint)</li>
                                                        }
                                                    </ul>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            </div>
        }
    </div>

    @if (ApplicationProfileInstanceId != Guid.Empty && ShouldShowFooter)
    {
        <footer class="app-item-doc-copies__footer">
            <div class="app-item-doc-copies__package-bar">
                <div class="app-item-doc-copies__package-bar-main">
                    @if (_recycleBusy && _recycleBusyEntry != null)
                    {
                        <p class="app-item-doc-copies__toolbar-hint" role="status">@GetRecycleBusyPrompt()</p>
                        <div class="app-report-package__entry-progress app-report-package__recycle-progress"
                             role="progressbar" aria-busy="true" aria-label="@GetRecycleBusyPrompt()">
                            <div class="app-report-package__preview-progress-track">
                                <div class="app-report-package__preview-progress-indeterminate"></div>
                            </div>
                        </div>
                    }
                    else if (_recycleConfirmKind != RecycleConfirmKind.None && _recycleConfirmEntry != null)
                    {
                        <p class="app-item-doc-copies__toolbar-hint">@GetRecycleConfirmPrompt()</p>
                    }
                    else if (IsCatalogPane)
                    {
                    <p class="app-item-doc-copies__subtitle">@GetSubtitle()</p>
                    @if (_packageConfirmPending)
                    {
                        <p class="app-item-doc-copies__toolbar-hint">@Msg("ApplicationReportPackage.PackageConfirmPrompt")</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(_packageStatusMessage))
                    {
                        <p class="app-item-doc-copies__toolbar-hint @(_packageStatusIsError ? "app-item-doc-copies__toolbar-hint--error" : string.Empty)"
                           role="@(_packageStatusIsError ? "alert" : "status")">
                            @_packageStatusMessage
                        </p>
                    }
                    }
                    else if (!string.IsNullOrWhiteSpace(_packageStatusMessage))
                    {
                        <p class="app-item-doc-copies__toolbar-hint @(_packageStatusIsError ? "app-item-doc-copies__toolbar-hint--error" : string.Empty)"
                           role="@(_packageStatusIsError ? "alert" : "status")">
                            @_packageStatusMessage
                        </p>
                    }
                </div>
                <div class="app-item-doc-copies__package-bar-actions">
                    @if (!_recycleBusy && _recycleConfirmKind != RecycleConfirmKind.None)
                    {
                        <DxButton Text="@GetRecycleConfirmActionLabel()"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Enabled="@(!_recycleBusy)"
                                  Click="@ConfirmRecycleActionAsync" />
                        <DxButton Text="@Msg("ApplicationReportPackage.PackageCancelConfirm")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Enabled="@(!_recycleBusy)"
                                  Click="@CancelRecycleConfirm" />
                    }
                    else if (IsCatalogPane)
                    {
                    @if (_packageConfirmPending)
                    {
                        <DxButton Text="@Msg("ApplicationReportPackage.PackageConfirmDownload")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Enabled="@(!_packageBusy && SelectedCount > 0)"
                                  Click="@ConfirmDownloadPackageAsync" />
                        <DxButton Text="@Msg("ApplicationReportPackage.PackageCancelConfirm")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Click="@CancelPackageConfirm" />
                    }
                    else
                    {
                        <DxButton Text="@Msg("ApplicationReportPackage.DownloadPackage")"
                                  RenderStyle="ButtonRenderStyle.Link"
                                  SizeMode="SizeMode.Small"
                                  CssClass="app-item-doc-copies__action-btn"
                                  Enabled="@(!_packageBusy && SelectedCount > 0)"
                                  Click="@OnDownloadPackageClickAsync" />
                    }
                    <DxButton Text="@Msg("ApplicationReportPackage.Refresh")"
                              RenderStyle="ButtonRenderStyle.Link"
                              SizeMode="SizeMode.Small"
                              CssClass="app-item-doc-copies__action-btn"
                              Enabled="@(!_refreshBusy && !_packageBusy && !_syncBusy)"
                              Click="@OnRefreshClickAsync" />
                    }
                </div>
            </div>
            @if (IsCatalogPane)
            {
            <button type="button"
                    class="@GearButtonCssClass"
                    title="@GearToolTip"
                    aria-label="@GearToolTip"
                    aria-pressed="@ShowDetails"
                    @onclick="ToggleDetailsAsync">
                <svg class="cs-multi-select-popup__gear-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81a.488.488 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L2.74 8.87a.488.488 0 0 0 .12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.488.488 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.488.488 0 0 0-.12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 15.6 12 3.6 3.6 0 0 1 12 15.6z" />
                </svg>
            </button>
            }
        </footer>
    }
</div>

@if (!UseInlinePreview)
{
    <ApplicationReportPackagePreviewDialog @ref="_previewDialog" />
}

@if (ShowConvertEntry)
{
    <TemplateConvertDialog @ref="_convertDialog" OnTemplateSaved="OnConvertSavedAsync" />
}

@if (ShowScanEntryVisible)
{
    <TemplateScanDialog @ref="_scanDialog" OnTemplateSaved="OnScanSavedAsync" />
}

@code {
    [Parameter] public Guid ApplicationProfileInstanceId { get; set; }
    [Parameter] public WordReportPackageScope PackageScope { get; set; } = WordReportPackageScope.ApplicationProfileInstance;
    [Parameter] public IReadOnlyList<Guid> ApplicationItemIds { get; set; } = Array.Empty<Guid>();
    [Parameter] public string ApplicationNumber { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<ApplicationWordReportPackageCatalogEntry> CatalogEntries { get; set; } =
        Array.Empty<ApplicationWordReportPackageCatalogEntry>();
    [Parameter] public IReadOnlyList<ApplicationWordReportPackageCatalogEntry> RecycleBinEntries { get; set; } =
        Array.Empty<ApplicationWordReportPackageCatalogEntry>();
    [Parameter] public bool ShowRecycleBin { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public string UiCultureName { get; set; } = string.Empty;
    [Parameter] public bool UseInlinePreview { get; set; }
    [Parameter] public string? FocusEntryKey { get; set; }
    [Parameter] public EventCallback<ReportPackagePreviewRequest> OnInlinePreviewRequested { get; set; }

    [Inject] private INonSecuredObjectSpaceFactory ObjectSpaceFactory { get; set; } = null!;
    [Inject] private ApplicationWordReportPackageEnqueueService PackageEnqueueService { get; set; } = null!;
    [Inject] private UserReportTemplateStagingUiService TemplateStagingUiService { get; set; } = null!;
    [Inject] private IFileDownloader FileDownloader { get; set; } = null!;
    [Inject] private IXafCultureInfoService CultureInfoService { get; set; } = null!;
    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private IApplicationErrorReporter ErrorReporter { get; set; } = null!;
    [Inject] private IVisaPreviewSlotService PreviewSlotService { get; set; } = null!;
    [Inject] private IOptions<TemplateAiConvertOptions> ConvertOptions { get; set; } = null!;
    [Inject] private IOptions<TemplateAiScanOptions> ScanOptions { get; set; } = null!;
    [Inject] private ITemplateScanAiProvider ScanAiProvider { get; set; } = null!;

    private ApplicationReportPackagePreviewDialog? _previewDialog;
    private TemplateConvertDialog? _convertDialog;
    private TemplateScanDialog? _scanDialog;
    private bool _canConvertTemplates;
    private bool _canScanTemplates;
    private DotNetObjectReference<ApplicationReportPackageComponent>? _dotNetRef;

    private readonly HashSet<string> _selectedKeys = new(StringComparer.Ordinal);
    private bool _selectionInitialized;
    private bool _packageConfirmPending;
    private bool _packageBusy;
    private bool _previewBusy;
    private bool _scanReviewBusy;
    private string? _previewEntryKey;
    private string? _handledFocusEntryKey;

    private string _packageStatusMessage = string.Empty;
    private bool _packageStatusIsError;
    private bool _canEditUserTemplates;
    private bool _refreshBusy;
    private bool _syncBusy;
    private Guid? _editTemplateId;
    private Guid? _downloadTemplateId;
    private readonly HashSet<Guid> _downloadedTemplateIds = new();
    private bool ShowDetails;
    private bool _recycleBusy;
    private RecycleConfirmKind _recycleBusyKind = RecycleConfirmKind.None;
    private ApplicationWordReportPackageCatalogEntry? _recycleBusyEntry;
    private RecycleConfirmKind _recycleConfirmKind = RecycleConfirmKind.None;
    private ApplicationWordReportPackageCatalogEntry? _recycleConfirmEntry;
    private bool _showRecycleBinPane;
    private readonly Dictionary<string, ApplicationWordReportPackageCatalogEntry> _pendingToBin =
        new(StringComparer.Ordinal);
    private readonly HashSet<string> _pendingRestoredKeys = new(StringComparer.Ordinal);
    private readonly HashSet<string> _pendingPurgedKeys = new(StringComparer.Ordinal);

    private enum RecycleConfirmKind
    {
        None,
        Move,
        Purge
    }

    private bool IsCatalogPane => !_showRecycleBinPane;

    private bool ShowRecycleBinTab =>
        ShowRecycleBin || RecycleBinEntries.Count > 0 || _pendingToBin.Count > 0;

    private IReadOnlyList<ApplicationWordReportPackageCatalogEntry> VisibleCatalogEntries
    {
        get
        {
            var list = new List<ApplicationWordReportPackageCatalogEntry>();
            foreach (var entry in CatalogEntries)
            {
                if (_pendingToBin.ContainsKey(entry.EntryKey))
                    continue;
                list.Add(entry);
            }

            foreach (var entry in RecycleBinEntries)
            {
                if (!_pendingRestoredKeys.Contains(entry.EntryKey))
                    continue;
                if (list.Exists(e => string.Equals(e.EntryKey, entry.EntryKey, StringComparison.Ordinal)))
                    continue;
                list.Add(entry);
            }

            return list;
        }
    }

    private IReadOnlyList<ApplicationWordReportPackageCatalogEntry> VisibleRecycleBinEntries
    {
        get
        {
            var list = new List<ApplicationWordReportPackageCatalogEntry>();
            foreach (var entry in RecycleBinEntries)
            {
                if (_pendingPurgedKeys.Contains(entry.EntryKey)
                    || _pendingRestoredKeys.Contains(entry.EntryKey))
                {
                    continue;
                }

                list.Add(entry);
            }

            foreach (var pending in _pendingToBin.Values)
            {
                if (list.Exists(e => string.Equals(e.EntryKey, pending.EntryKey, StringComparison.Ordinal)))
                    continue;
                list.Add(pending);
            }

            return list;
        }
    }

    private bool ShouldShowFooter =>
        _recycleBusy
        || _recycleConfirmKind != RecycleConfirmKind.None
        || (IsCatalogPane && VisibleCatalogEntries.Count > 0)
        || (!IsCatalogPane && VisibleRecycleBinEntries.Count > 0)
        || !string.IsNullOrWhiteSpace(_packageStatusMessage);

    private string CatalogPaneTabCss =>
        IsCatalogPane
            ? "app-item-doc-copies__action-btn resminamalar-catalog__pane-tab resminamalar-catalog__pane-tab--active"
            : "app-item-doc-copies__action-btn resminamalar-catalog__pane-tab";

    private string RecycleBinPaneTabCss =>
        !IsCatalogPane
            ? "app-item-doc-copies__action-btn resminamalar-catalog__pane-tab resminamalar-catalog__pane-tab--active"
            : "app-item-doc-copies__action-btn resminamalar-catalog__pane-tab";

    private static readonly JsonSerializerOptions SyncResultJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    private int SelectedCount => _selectedKeys.Count;

    private ApplicationWordReportPackageReadinessSummary SelectedReadinessSummary =>
