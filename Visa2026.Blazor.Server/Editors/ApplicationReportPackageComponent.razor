    private async Task MutateRecycleBinAsync(
        ApplicationWordReportPackageCatalogEntry? entry,
        RecycleConfirmKind expectedKind,
        Action<ApplicationProfileTemplate> mutate,
        string successKey,
        bool stayOnRecycleBin,
        bool purge = false)
    {
        if (entry?.ApplicationProfileTemplateId is not Guid templateId || templateId == Guid.Empty)
        {
            _recycleConfirmKind = RecycleConfirmKind.None;
            _recycleConfirmEntry = null;
            _packageStatusMessage = Msg("ApplicationReportPackage.RecycleBin.Failed");
            _packageStatusIsError = true;
            return;
        }
        if (_recycleBusy)
            return;

        _recycleBusy = true;
        _recycleBusyKind = expectedKind;
        _recycleBusyEntry = entry;
        ClearStatusMessages();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileTemplate>();
            var template = ApplicationProfileNestedTemplateCatalogHelper.LoadProfileTemplate(objectSpace, templateId);
            if (template == null)
            {
                _recycleConfirmKind = RecycleConfirmKind.None;
                _recycleConfirmEntry = null;
                _packageStatusMessage = Msg("ApplicationReportPackage.RecycleBin.Failed");
                _packageStatusIsError = true;
                return;
            }

            if (purge)
                ApplicationProfileTemplateRecycleBin.Purge(objectSpace, template);
            else
            {
                mutate(template);
                objectSpace.SetModified(template);
            }

            objectSpace.CommitChanges();

            _recycleConfirmKind = RecycleConfirmKind.None;
            _recycleConfirmEntry = null;
            RememberPendingRecycleOverlay(entry, expectedKind, purge);
            await InvokeAsync(StateHasChanged);

            if (RefreshRequested.HasDelegate)
                await RefreshRequested.InvokeAsync();

            _packageStatusMessage = FormatMsg(successKey, entry.DisplayName);
            _packageStatusIsError = false;
        }
        catch (Exception ex)
        {
            _recycleConfirmKind = RecycleConfirmKind.None;
            _recycleConfirmEntry = null;
            _packageStatusMessage = ex is UserFriendlyException
                ? ex.Message
                : Msg("ApplicationReportPackage.RecycleBin.Failed");
            _packageStatusIsError = true;
            ErrorReporter.ReportReportPackageError(
                "Resminamalar Recycle Bin update failed.",
                ApplicationRuntimeLogCategories.ReportPackageComponent,
                ex);
        }
        finally
        {
            _recycleBusy = false;
            _recycleBusyKind = RecycleConfirmKind.None;
            _recycleBusyEntry = null;
            await InvokeAsync(StateHasChanged);
        }
    }

