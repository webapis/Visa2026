    private async Task OpenScanReviewAsync(ApplicationWordReportPackageCatalogEntry entry)
    {
        if (!CanReviewPlaceholders(entry) || _scanDialog == null || _scanReviewBusy)
            return;

        if (entry.ApplicationProfileTemplateId is not Guid profileTemplateId || profileTemplateId == Guid.Empty)
            return;

        ClearStatusMessages();
        _scanReviewBusy = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var objectSpace = ObjectSpaceFactory.CreateNonSecuredObjectSpace<ApplicationProfileTemplate>();
            var template = ApplicationProfileNestedTemplateCatalogHelper.LoadProfileTemplate(objectSpace, profileTemplateId);
            if (template == null)
            {
                _packageStatusMessage = "This catalog template is no longer available.";
                _packageStatusIsError = true;
                return;
            }

            var content = ReadProfileTemplateBytes(objectSpace, template);
            if (content == null || content.Length == 0)
            {
                if (entry.UserReportTemplateId is Guid userTemplateId && userTemplateId != Guid.Empty)
                {
                    var outcome = await TemplateStagingUiService.DownloadTemplateAsync(userTemplateId);
                    content = outcome.Result?.FileContent;
                }
            }

            if (content == null || content.Length == 0)
            {
                _packageStatusMessage = "This catalog template has no file to review.";
                _packageStatusIsError = true;
                return;
            }

            var fileName = template.TemplateFile?.FileName;
            if (string.IsNullOrWhiteSpace(fileName))
            {
                var ext = entry.Kind == ApplicationWordReportPackageEntryKind.UserExcel ? ".xlsx" : ".docx";
                fileName = (template.TemplateName?.Trim() ?? entry.DisplayName) + ext;
            }

            await _scanDialog.OpenForExistingTemplateAsync(
                ApplicationProfileInstanceId,
                ApplicationNumber,
                content,
                fileName,
                template.TemplateName?.Trim() ?? entry.DisplayName,
                template.DataScope,
                template.CatalogScope);
        }
        catch (Exception ex)
        {
            _packageStatusMessage = "Could not open Review for this template.";
            _packageStatusIsError = true;
            ErrorReporter.ReportReportPackageError(
                "Resminamalar open scan Review failed.",
                ApplicationRuntimeLogCategories.ReportPackageComponent,
                ex);
        }
        finally
        {
            _scanReviewBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static byte[]? ReadProfileTemplateBytes(IObjectSpace objectSpace, ApplicationProfileTemplate template)
    {
        var file = template.TemplateFile;
        if (file == null)
            return null;

        if (file.Content is { Length: > 0 } content)
            return content.ToArray();

        if (file.ID == Guid.Empty)
            return null;

        return objectSpace.GetObjectsQuery<DevExpress.Persistent.BaseImpl.EF.FileData>()
            .Where(f => f.ID == file.ID)
            .Select(f => f.Content)
            .FirstOrDefault();
    }

