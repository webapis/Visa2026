    private void RememberPendingRecycleOverlay(
        ApplicationWordReportPackageCatalogEntry entry,
        RecycleConfirmKind expectedKind,
        bool purge)
    {
        if (purge)
        {
            _pendingPurgedKeys.Add(entry.EntryKey);
            _pendingToBin.Remove(entry.EntryKey);
            _pendingRestoredKeys.Remove(entry.EntryKey);
            return;
        }

        if (expectedKind == RecycleConfirmKind.Move)
        {
            _pendingToBin[entry.EntryKey] = entry;
            _pendingRestoredKeys.Remove(entry.EntryKey);
            _pendingPurgedKeys.Remove(entry.EntryKey);
            _showRecycleBinPane = false;
            _selectedKeys.Remove(entry.EntryKey);
            return;
        }

        _pendingRestoredKeys.Add(entry.EntryKey);
        _pendingToBin.Remove(entry.EntryKey);
        _pendingPurgedKeys.Remove(entry.EntryKey);
        _showRecycleBinPane = false;
    }

    private void ReconcilePendingRecycleOverlays()
    {
        foreach (var key in _pendingToBin.Keys.ToList())
        {
            var inBin = RecycleBinEntries.Any(e =>
                string.Equals(e.EntryKey, key, StringComparison.Ordinal));
            var inCatalog = CatalogEntries.Any(e =>
                string.Equals(e.EntryKey, key, StringComparison.Ordinal));
            // Keep the overlay until both parent lists catch up. Dropping it when the bin
            // list updates first would put the row back in Catalog.
            if (!inCatalog && inBin)
                _pendingToBin.Remove(key);
        }

        foreach (var key in _pendingRestoredKeys.ToList())
        {
            var inCatalog = CatalogEntries.Any(e =>
                string.Equals(e.EntryKey, key, StringComparison.Ordinal));
            var inBin = RecycleBinEntries.Any(e =>
                string.Equals(e.EntryKey, key, StringComparison.Ordinal));
            if (inCatalog && !inBin)
                _pendingRestoredKeys.Remove(key);
        }

        foreach (var key in _pendingPurgedKeys.ToList())
        {
            if (!RecycleBinEntries.Any(e =>
                    string.Equals(e.EntryKey, key, StringComparison.Ordinal)))
            {
                _pendingPurgedKeys.Remove(key);
            }
        }
    }

