        _canConvertTemplates = TemplateConvertAccess.CanConvertTemplates();
        _canScanTemplates = TemplateScanAccess.CanCreateFromScan();

        ReconcilePendingRecycleOverlays();

        if (!ShowRecycleBinTab)
            _showRecycleBinPane = false;
        else if (!IsCatalogPane
            && VisibleRecycleBinEntries.Count == 0
            && VisibleCatalogEntries.Count > 0)
            _showRecycleBinPane = false;

        var currentKeys = VisibleCatalogEntries
            .Select(entry => entry.EntryKey)
            .ToHashSet(StringComparer.Ordinal);

        if (_selectionInitialized)
        {
            _selectedKeys.IntersectWith(currentKeys);
            return;
        }

        _selectedKeys.Clear();
        foreach (var key in currentKeys)
            _selectedKeys.Add(key);

        _selectionInitialized = currentKeys.Count > 0;
    }

