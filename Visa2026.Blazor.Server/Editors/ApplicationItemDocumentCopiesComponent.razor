    private string GetSubtitle()
    {
        if (ApplicationItemIds.Count > 1)
            return FormatMsg("ApplicationItemDocumentCopies.List.Subtitle", ApplicationItemIds.Count);

        return Msg("ApplicationItemDocumentCopies.Subtitle");
    }

    private string GetApplicationFormSummary()
    {
        if (ApplicationItemIds.Count <= 1)
            return Msg("ApplicationItemDocumentCopies.Summary.ApplicationForm");

        return FormatMsg(
            "ApplicationItemDocumentCopies.Summary.ApplicationFormLines",
            ApplicationItemIds.Count,
            ApplicationItemIds.Count);
    }

    private string GetLinkedSectionSummary()
    {
        var total = MergedGroups.Count;
        var withFiles = MergedGroups.Count(g => g.Files.Count > 0);
        if (total == 0)
            return Msg("PersonDocumentCopies.Section.SummaryOneNone");

        if (total == 1)
        {
            if (withFiles > 0)
                return FormatMsg("PersonDocumentCopies.Section.SummaryOneWithFiles", withFiles);
            return Msg("PersonDocumentCopies.Section.SummaryOneNone");
        }

        if (withFiles > 0)
            return FormatMsg("PersonDocumentCopies.Section.Summary", total, withFiles);

        return FormatMsg("PersonDocumentCopies.Section.SummaryNone", total);
    }

    private string GetGroupStatusLabel(ApplicationItemLinkedDocumentMergedGroup group)
    {
        if (group.LinkMissing || group.Files.Count == 0)
            return StatusMissing;

        if (group.MissingLines.Count > 0)
            return StatusPartial;

        return StatusReady;
    }

    private static string GetGroupStatusPillCss(ApplicationItemLinkedDocumentMergedGroup group)
    {
        if (group.LinkMissing || group.Files.Count == 0)
            return "person-dossier__pill st-expiring doc-copies-catalog__pill";

        if (group.MissingLines.Count > 0)
            return "person-dossier__pill st-pending doc-copies-catalog__pill";

        return "person-dossier__pill st-approved doc-copies-catalog__pill";
    }

    private static string GetGroupRowCssClass(
        ApplicationItemLinkedDocumentMergedGroup group,
        bool canPreview,
        bool rowLoading)
    {
        var classes = new List<string> { "doc-copies-catalog__row" };
        if (group.Files.Count == 0)
            classes.Add("doc-copies-catalog__row--empty");
        if (canPreview)
            classes.Add("doc-copies-catalog__row--clickable");
        if (rowLoading)
            classes.Add("doc-copies-catalog__row--loading");
        return string.Join(' ', classes);
    }

    private static string GetFormRowCssClass(bool formLoading)
    {
        var classes = new List<string> { "doc-copies-catalog__row", "doc-copies-catalog__row--clickable" };
        if (formLoading)
            classes.Add("doc-copies-catalog__row--loading");
        return string.Join(' ', classes);
    }

    private async Task OnGroupRowClickAsync(ApplicationItemLinkedDocumentMergedGroup group)
    {
        if (group.Files.Count == 0 || IsAnyPreviewLoading)
            return;

        await PreviewMergedAsync(group);
    }

    private async Task OnFormRowClickAsync()
    {
        if (IsAnyPreviewLoading)
            return;

        await PreviewApplicationFormAsync();
    }

    private string GetGroupSummary(ApplicationItemLinkedDocumentMergedGroup group)
    {
        if (group.InScopeLineCount <= 1)
            return FormatMsg("ApplicationItemDocumentCopies.Summary.Files", group.Files.Count);

        if (group.MissingLines.Count > 0)
            return FormatMsg("ApplicationItemDocumentCopies.Summary.PartialMissing", group.Files.Count, group.MissingLines.Count);

        return FormatMsg("ApplicationItemDocumentCopies.Summary.LinesWithCopies", group.LinesWithFilesCount, group.InScopeLineCount);
    }

    private string GetMissingLinesSummary(ApplicationItemLinkedDocumentMergedGroup group)
    {
        var labels = group.MissingLines
            .Select(entry => entry.LineLabel)
            .Where(label => !string.IsNullOrWhiteSpace(label))
            .ToList();

        if (labels.Count == 0)
            return FormatMsg("ApplicationItemDocumentCopies.Summary.PartialMissing", group.Files.Count, group.MissingLines.Count);

        return FormatMsg("ApplicationItemDocumentCopies.Summary.MissingLines", string.Join(", ", labels));
    }

    private async Task PreviewMergedAsync(ApplicationItemLinkedDocumentMergedGroup group)
    {
        if (IsAnyPreviewLoading || string.IsNullOrWhiteSpace(group.SlotKey))
            return;

        if (!UseInlinePreview && _previewDialog == null)
            return;

        if (UseInlinePreview && !OnInlinePreviewRequested.HasDelegate)
            return;

        var slotLabel = SlotLabel(group.SlotKey);
        _previewLoadingKey = group.SlotKey;
        _previewStatusMessage = FormatMsg("ApplicationReportPackage.Preview.Downloading", slotLabel);
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await Task.Delay(100);

        var progressStartedUtc = DateTime.UtcNow;
        var previewSucceeded = false;

        try
        {
            if (UseInlinePreview)
            {
                await OnInlinePreviewRequested.InvokeAsync(new DocumentCopiesInlinePreviewRequest
                {
                    SlotKey = group.SlotKey,
                    DisplayName = slotLabel,
                    PackageOptions = _packageOptions,
                });
            }
            else
            {
                await _previewDialog!.OpenMergedSlotAsync(group.SlotKey, slotLabel);
            }

            previewSucceeded = true;
        }
        finally
        {
            if (previewSucceeded)
                await WaitRemainingPreviewProgressTimeAsync(progressStartedUtc);

            _previewLoadingKey = null;
            _previewStatusMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PreviewApplicationFormAsync()
    {
        if (IsAnyPreviewLoading || ApplicationItemIds.Count == 0)
            return;

        _previewLoadingKey = ApplicationFormPreviewKey;
        _previewStatusMessage = FormatMsg("ApplicationReportPackage.Preview.Downloading", FormSlotLabel);
        ClearPackageStatus();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await Task.Delay(100);

        var progressStartedUtc = DateTime.UtcNow;
        var downloadSucceeded = false;

        try
        {
            if (!DocumentFileAccess.TryGetFilledApplicationFormPdf(
                    LineScope,
                    ApplicationItemIds,
                    out var result,
                    out var errorMessageKey)
                || result == null)
            {
                _packageStatusMessage = !string.IsNullOrWhiteSpace(errorMessageKey)
                    ? Msg(errorMessageKey)
                    : Msg("ApplicationItemDocumentCopies.Preview.Error");
                _packageStatusIsError = true;
                ErrorReporter.ReportDocumentCopiesError(
                    _packageStatusMessage,
                    ApplicationRuntimeLogCategories.DocumentCopiesComponent);
                return;
            }

            using var stream = new MemoryStream(result.Content, writable: false);
            await FileDownloader.DownloadAsync(
                string.IsNullOrWhiteSpace(result.FileName) ? "ApplicationForm.pdf" : result.FileName,
                stream,
                result.ContentType);

            _packageStatusMessage = result.ContentType == "application/zip"
                ? Msg("ApplicationItemDocumentCopies.Preview.ApplicationFormZipDownloaded")
                : Msg("ApplicationItemDocumentCopies.Preview.ApplicationFormDownloaded");
            _packageStatusIsError = false;
            downloadSucceeded = true;
        }
        catch (Exception ex)
        {
            _packageStatusMessage = Msg("ApplicationItemDocumentCopies.Preview.Error");
            _packageStatusIsError = true;
            ErrorReporter.ReportDocumentCopiesError(
                "Application form preview failed unexpectedly.",
                ApplicationRuntimeLogCategories.DocumentCopiesComponent,
                ex);
        }
        finally
        {
            if (downloadSucceeded)
                await WaitRemainingPreviewProgressTimeAsync(progressStartedUtc);

            _previewLoadingKey = null;
            _previewStatusMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task WaitRemainingPreviewProgressTimeAsync(DateTime startedUtc)
    {
        var remaining = MinimumPreviewProgressDuration - (DateTime.UtcNow - startedUtc);
        if (remaining > TimeSpan.Zero)
            await Task.Delay(remaining);
    }

    private Task ToggleDetailsAsync()
    {
        ShowDetails = !ShowDetails;
        return Task.CompletedTask;
    }

    private Task ToggleSectionNavAsync(string sectionId)
    {
        if (_collapsedSections.Contains(sectionId))
        {
            _collapsedSections.Clear();
            if (!string.Equals(sectionId, DocumentCopiesCatalogNavIcons.LinkedDocuments, StringComparison.Ordinal))
                _collapsedSections.Add(DocumentCopiesCatalogNavIcons.LinkedDocuments);
            if (!string.Equals(sectionId, DocumentCopiesCatalogNavIcons.ApplicationForm, StringComparison.Ordinal))
                _collapsedSections.Add(DocumentCopiesCatalogNavIcons.ApplicationForm);
        }
        else
        {
            _collapsedSections.Add(sectionId);
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task OnSectionNavKeyDownAsync(KeyboardEventArgs e, string sectionId)
    {
        if (e.Key is "Enter" or " ")
            return ToggleSectionNavAsync(sectionId);

        return Task.CompletedTask;
    }

    private Task TogglePackageOptionsAsync()
    {
        _showPackageOptions = !_showPackageOptions;
        return Task.CompletedTask;
    }

    private Task ResetPackageOptionsAsync()
    {
        _packageOptions.ResetToDefaults();
        return Task.CompletedTask;
    }

    private void OnDiplomaScopeChanged(ChangeEventArgs e)
    {
        if (e.Value == null || !int.TryParse(e.Value.ToString(), out var value))
            return;

        _packageOptions.DiplomaScope = (PdfBatchDiplomaScope)value;
    }

    private void OnSupportingZipMergeChanged(ChangeEventArgs e)
    {
        if (e.Value == null || !int.TryParse(e.Value.ToString(), out var value))
            return;

        _packageOptions.SupportingZipMergeOption = (PdfSupportingZipMergeOption)value;
        if (!_packageOptions.ShowMergedDiplomaOption)
            _packageOptions.IncludeMergedDiplomaPdf = false;
    }

    private async Task OnRefreshClick()
    {
        _packageConfirmPending = false;
        ClearPackageStatus();
        if (RefreshRequested.HasDelegate)
            await RefreshRequested.InvokeAsync();
    }

    private Task OnDownloadPackageClickAsync()
    {
        if (ReadinessSummary.HasPackagingGaps)
        {
            _packageConfirmPending = true;
            ClearPackageStatus();
            return Task.CompletedTask;
        }

        return EnqueuePackageAsync();
    }

    private Task ConfirmDownloadPackageAsync()
    {
        _packageConfirmPending = false;
        return EnqueuePackageAsync();
    }

    private Task CancelPackageConfirm()
    {
        _packageConfirmPending = false;
        return Task.CompletedTask;
    }

    private async Task EnqueuePackageAsync()
    {
        if (_packageBusy || ApplicationItemIds.Count == 0)
            return;

        _packageBusy = true;
        ClearPackageStatus();

        try
        {
            var outcome = await PackageEnqueueService.EnqueuePackageAsync(LineScope, ApplicationItemIds, _packageOptions);
            if (!outcome.Success)
            {
                _packageStatusMessage = outcome.ErrorMessage
                    ?? Msg("ApplicationItemDocumentCopies.Package.Error");
                _packageStatusIsError = true;
                ErrorReporter.ReportDocumentCopiesError(
                    _packageStatusMessage,
                    ApplicationRuntimeLogCategories.DocumentCopiesComponent,
                    relatedBatchId: outcome.BatchId != Guid.Empty ? outcome.BatchId : null);
                return;
            }

            await JS.InvokeVoidAsync("visaPdfBatchToast.setCurrentBatchId", outcome.BatchId.ToString("D"));

            _packageStatusMessage = outcome.NoticeMessage ?? string.Empty;
            _packageStatusIsError = false;
        }
        catch (Exception ex)
        {
            _packageStatusMessage = Msg("ApplicationItemDocumentCopies.Package.Error");
            _packageStatusIsError = true;
            ErrorReporter.ReportDocumentCopiesError(
                "Document copies package enqueue failed unexpectedly.",
                ApplicationRuntimeLogCategories.DocumentCopiesComponent,
                ex);
        }
        finally
        {
            _packageBusy = false;
        }
    }

    private void ClearPackageStatus()
    {
        _packageStatusMessage = string.Empty;
        _packageStatusIsError = false;
    }

    private static string FormatSize(int bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }
