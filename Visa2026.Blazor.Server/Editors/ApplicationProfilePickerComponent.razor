@using System.Linq
@using Visa2026.Blazor.Server.Editors

<div class="ap-picker">
    @if (IsLoading)
    {
        <div class="ap-picker__loading" role="status">Loading Application Profiles…</div>
    }
    else if (Step == 2)
    {
        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">Choose Approval legs</h1>
                <p class="ap-picker__profile-name" title="@SelectedProfileName">@SelectedProfileName</p>
                <p class="ap-picker__sub">
                    These chains are shared for every via-ministry application. Pick one for this case; ministries are copied onto it and will not change if the shared catalog is edited later.
                    <strong>Make default</strong> is the pre-selected chain the next time someone creates from this profile.
                </p>
            </div>
        </header>

        @RenderStatus()

        @if (SelectedRow != null)
        {
            <div class="ap-picker__section-head">
                <h2 class="ap-picker__section-title">Approval legs *</h2>
                <div class="ap-picker__section-actions">
                    <button type="button" class="ap-picker__link" @onclick="OpenApprovalLegCatalogAsync">Catalog</button>
                    <button type="button" class="ap-picker__link" @onclick="NewApprovalLegAsync">+ New</button>
                </div>
            </div>
            @if (SelectedRow.MissingApprovalLegVersions)
            {
                <div class="ap-picker__versions-empty" role="status">
                    <p class="ap-picker__versions-empty-title">No shared approval-leg versions yet</p>
                    <p>Create the first ministry chain here. It is shared for all via-ministry applications, not only this case. After Create, pick the card and Use profile. Catalog on the right lists inactive chains too.</p>
                    <div class="ap-picker__section-actions ap-picker__section-actions--empty">
                        <button type="button" class="ap-picker__link" @onclick="OpenApprovalLegCatalogAsync">Catalog</button>
                        <button type="button" class="ap-picker__btn ap-picker__btn--primary" @onclick="NewApprovalLegAsync">+ New</button>
                    </div>
                </div>
            }
            else
            {
                <div class="ap-picker__versions">
                    @foreach (var version in SelectedRow.ApprovalLegVersions)
                    {
                        var versionSelected = version.VersionId == SelectedVersionId;
                        <div class="ap-picker__version @(versionSelected ? "is-selected" : null)"
                             role="button"
                             tabindex="0"
                             @onclick="() => SelectVersion(version.VersionId)"
                             @onkeydown="e => OnVersionKey(e, version.VersionId)">
                            <span class="ap-picker__version-title">
                                @version.Name
                                @if (version.IsDefault)
                                {
                                    <span class="ap-picker__badge ap-picker__badge--on">Default</span>
                                }
                            </span>
                            <ol class="ap-picker__version-legs">
                                @foreach (var ministry in version.MinistryNames)
                                {
                                    <li>@ministry</li>
                                }
                            </ol>
                            <div class="ap-picker__version-foot">
                                <span class="ap-picker__meta">@version.MinistryNames.Count ministries</span>
                                <span class="ap-picker__version-foot-actions">
                                    @if (!version.IsDefault)
                                    {
                                        <button type="button"
                                                class="ap-picker__link"
                                                @onclick="() => MakeDefaultApprovalLegAsync(version.VersionId)"
                                                @onclick:stopPropagation="true">
                                            Make default
                                        </button>
                                    }
                                    <button type="button"
                                            class="ap-picker__link"
                                            @onclick="() => OpenApprovalLegAsync(version.VersionId)"
                                            @onclick:stopPropagation="true">
                                        Open
                                    </button>
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <div class="ap-picker__actions">
            <button type="button" class="ap-picker__btn" @onclick="BackStepAsync">Back</button>
            <button type="button"
                    class="ap-picker__btn ap-picker__btn--primary"
                    disabled="@(!CanCreateOnLegsStep)"
                    @onclick="UseProfileAsync">
                Use profile (live link)
            </button>
        </div>
    }
    else
    {
        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">Choose Application Profile</h1>
                <p class="ap-picker__sub">
                    Sets a live configuration link and seeds per-ApplicationProfileInstance defaults once. Profile cannot be changed after save.
                </p>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(RouteHint))
        {
            <div class="ap-picker__hint">@RouteHint</div>
        }

        @RenderStatus()

        @if (Rows.Count == 0)
        {
            <div class="ap-picker__empty">
                No active Application Profiles match this list. Configure profiles under <strong>Configuration → Application Profiles</strong>.
            </div>
        }
        else
        {
            <ul class="ap-picker__list" role="listbox" aria-label="Application Profiles">
                @foreach (var row in Rows)
                {
                    var selected = row.ProfileId == SelectedProfileId;
                    <li class="ap-picker__item @(selected ? "is-selected" : null)"
                        role="option"
                        aria-selected="@selected"
                        @onclick="() => SelectProfile(row.ProfileId)">
                        <div class="ap-picker__item-main">
                            <strong>@row.Name</strong>
                            <div class="ap-picker__meta">@row.MetaLine</div>
                        </div>
                        <div class="ap-picker__badges">
                            @if (row.IsConfigLocked)
                            {
                                <span class="ap-picker__badge ap-picker__badge--muted">Config locked</span>
                            }
                            @if (selected)
                            {
                                <span class="ap-picker__badge ap-picker__badge--on">Selected</span>
                            }
                        </div>
                    </li>
                }
            </ul>

            @if (SelectedRow?.MissingApprovalLegVersions == true)
            {
                <div class="ap-picker__hint">Continue to choose or create a shared approval-leg version. New chains are available for every via-ministry application.</div>
            }

            <div class="ap-picker__actions">
                @if (SelectedRow?.RequiresApprovalLegVersion == true)
                {
                    <button type="button"
                            class="ap-picker__btn ap-picker__btn--primary"
                            disabled="@(!CanContinueToLegs)"
                            @onclick="NextStepAsync">
                        Continue →
                    </button>
                }
                else
                {
                    <button type="button"
                            class="ap-picker__btn ap-picker__btn--primary"
                            disabled="@(SelectedProfileId == Guid.Empty)"
                            @onclick="UseProfileAsync">
                        Use profile (live link)
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public IReadOnlyList<ApplicationProfilePickerModel.PickerRowModel> Rows { get; set; } = Array.Empty<ApplicationProfilePickerModel.PickerRowModel>();
    [Parameter] public Guid SelectedProfileId { get; set; }
    [Parameter] public Guid SelectedVersionId { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public bool IsStatusWarning { get; set; }
    [Parameter] public string? RouteHint { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback UseProfileRequested { get; set; }
    [Parameter] public EventCallback NextStepRequested { get; set; }
    [Parameter] public EventCallback BackStepRequested { get; set; }
    [Parameter] public EventCallback<Guid> SelectProfileRequested { get; set; }
    [Parameter] public EventCallback<Guid> SelectVersionRequested { get; set; }
    [Parameter] public EventCallback NewApprovalLegRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenApprovalLegRequested { get; set; }
    [Parameter] public EventCallback OpenApprovalLegCatalogRequested { get; set; }
    [Parameter] public EventCallback<Guid> MakeDefaultApprovalLegRequested { get; set; }

    private bool _initialLoadStarted;

    private ApplicationProfilePickerModel.PickerRowModel? SelectedRow =>
        Rows.FirstOrDefault(r => r.ProfileId == SelectedProfileId);

    private string SelectedProfileName =>
        string.IsNullOrWhiteSpace(SelectedRow?.Name) ? "Unnamed profile" : SelectedRow.Name;

    private bool CanContinueToLegs =>
        SelectedRow != null
        && SelectedRow.RequiresApprovalLegVersion;

    private bool CanCreateOnLegsStep =>
        SelectedRow != null
        && SelectedVersionId != Guid.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !InitialLoadRequested.HasDelegate)
            return;

        _initialLoadStarted = true;
        await InitialLoadRequested.InvokeAsync();
    }

    private RenderFragment RenderStatus() => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            var css = IsStatusError ? "is-error" : IsStatusWarning ? "is-warn" : "is-ok";
            <div class="ap-picker__status @css" role="status">@StatusMessage</div>
        }
    };

    private async Task SelectProfile(Guid profileId)
    {
        if (SelectProfileRequested.HasDelegate)
            await SelectProfileRequested.InvokeAsync(profileId);
    }

    private async Task SelectVersion(Guid versionId)
    {
        if (SelectVersionRequested.HasDelegate)
            await SelectVersionRequested.InvokeAsync(versionId);
    }

    private async Task UseProfileAsync()
    {
        if (UseProfileRequested.HasDelegate)
            await UseProfileRequested.InvokeAsync();
    }

    private async Task NextStepAsync()
    {
        if (NextStepRequested.HasDelegate)
            await NextStepRequested.InvokeAsync();
    }

    private async Task BackStepAsync()
    {
        if (BackStepRequested.HasDelegate)
            await BackStepRequested.InvokeAsync();
    }

    private async Task NewApprovalLegAsync()
    {
        if (NewApprovalLegRequested.HasDelegate)
            await NewApprovalLegRequested.InvokeAsync();
    }

    private async Task OpenApprovalLegAsync(Guid versionId)
    {
        if (OpenApprovalLegRequested.HasDelegate)
            await OpenApprovalLegRequested.InvokeAsync(versionId);
    }

    private async Task OpenApprovalLegCatalogAsync()
    {
        if (OpenApprovalLegCatalogRequested.HasDelegate)
            await OpenApprovalLegCatalogRequested.InvokeAsync();
    }

    private async Task MakeDefaultApprovalLegAsync(Guid versionId)
    {
        if (MakeDefaultApprovalLegRequested.HasDelegate)
            await MakeDefaultApprovalLegRequested.InvokeAsync(versionId);
    }

    private async Task OnVersionKey(KeyboardEventArgs e, Guid versionId)
    {
        if (e.Key is "Enter" or " ")
            await SelectVersion(versionId);
    }
}