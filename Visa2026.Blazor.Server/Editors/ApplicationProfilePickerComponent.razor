@using System.Linq
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Editors
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationProfilePicker
@using Visa2026.Module.Services.ApplicationWorkspace

<div class="ap-picker" aria-busy="@IsAdvancing">
    @if (IsLoading)
    {
        <div class="ap-picker__loading" role="status">@Msg("ApplicationProfileInstance.Picker.Loading")</div>
    }
    else if (Step == 2)
    {
        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.ChooseLegs")</h1>
                <p class="ap-picker__profile-name" title="@SelectedProfileName">@SelectedProfileName</p>
                <p class="ap-picker__sub">@Msg("ApplicationProfileInstance.Picker.ApprovalLegsSub")</p>
            </div>
        </header>

        @RenderStatus()

        @if (SelectedRow != null)
        {
            <div class="ap-picker__section-head">
                <h2 class="ap-picker__section-title">@Msg("ApplicationProfileInstance.Picker.ApprovalLegsTitle")</h2>
                <div class="ap-picker__section-actions">
                    <button type="button" class="ap-picker__link" @onclick="OpenApprovalLegCatalogAsync">@Msg("ApplicationProfileInstance.Picker.Catalog")</button>
                    <button type="button" class="ap-picker__link" @onclick="NewApprovalLegAsync">@Msg("ApplicationProfileInstance.Picker.New")</button>
                </div>
            </div>
            @if (SelectedRow.MissingApprovalLegVersions)
            {
                <div class="ap-picker__versions-empty" role="status">
                    <p class="ap-picker__versions-empty-title">@Msg("ApplicationProfileInstance.Picker.NoVersionsTitle")</p>
                    <p>@Msg("ApplicationProfileInstance.Picker.NoVersionsBody")</p>
                    <div class="ap-picker__section-actions ap-picker__section-actions--empty">
                        <button type="button" class="ap-picker__link" @onclick="OpenApprovalLegCatalogAsync">@Msg("ApplicationProfileInstance.Picker.Catalog")</button>
                        <button type="button" class="ap-picker__btn ap-picker__btn--primary" @onclick="NewApprovalLegAsync">@Msg("ApplicationProfileInstance.Picker.New")</button>
                    </div>
                </div>
            }
            else
            {
                <div class="ap-picker__versions">
                    @foreach (var version in SelectedRow.ApprovalLegVersions)
                    {
                        var versionSelected = version.VersionId == SelectedVersionId;
                        <div class="ap-picker__version @(versionSelected ? "is-selected" : null)"
                             role="button"
                             tabindex="0"
                             @onclick="() => SelectVersion(version.VersionId)"
                             @onkeydown="e => OnVersionKey(e, version.VersionId)">
                            <span class="ap-picker__version-title">
                                @version.Name
                                @if (version.IsDefault)
                                {
                                    <span class="ap-picker__badge ap-picker__badge--on">@Msg("ApplicationProfileInstance.Picker.Default")</span>
                                }
                            </span>
                            <ol class="ap-picker__version-legs">
                                @foreach (var ministry in version.MinistryNames)
                                {
                                    <li>@ministry</li>
                                }
                            </ol>
                            <div class="ap-picker__version-foot">
                                <span class="ap-picker__meta">@VisaUiMessages.Format("ApplicationProfileInstance.Picker.MinistriesCount", version.MinistryNames.Count)</span>
                                <span class="ap-picker__version-foot-actions">
                                    @if (!version.IsDefault)
                                    {
                                        <button type="button"
                                                class="ap-picker__link"
                                                @onclick="() => MakeDefaultApprovalLegAsync(version.VersionId)"
                                                @onclick:stopPropagation="true">
                                            @Msg("ApplicationProfileInstance.Picker.MakeDefault")
                                        </button>
                                    }
                                    <button type="button"
                                            class="ap-picker__link"
                                            @onclick="() => OpenApprovalLegAsync(version.VersionId)"
                                            @onclick:stopPropagation="true">
                                        @Msg("ApplicationProfileInstance.Picker.Open")
                                    </button>
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <div class="ap-picker__actions">
            @RenderAdvance()
            <button type="button" class="ap-picker__btn" disabled="@IsAdvancing" @onclick="BackStepAsync">@Msg("ApplicationProfileInstance.Picker.Back")</button>
            <button type="button"
                    class="ap-picker__btn ap-picker__btn--primary"
                    disabled="@(IsAdvancing || !CanContinueFromLegs)"
                    @onclick="NextStepAsync">
                @Msg("ApplicationProfileInstance.Picker.Continue")
            </button>
        </div>
    }
    else if (Step == 3)
    {
        <header class="ap-picker__header ap-picker__header--with-gear">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.ChooseOrg")</h1>
                <p class="ap-picker__profile-name" title="@SelectedProfileName">@SelectedProfileName</p>
                <p class="ap-picker__sub">@Msg("ApplicationProfileInstance.Picker.OrgSub")</p>
            </div>
            <button type="button"
                    class="cs-multi-select-popup__gear-btn @(_orgCatalogManageOpen ? "cs-multi-select-popup__gear-btn--active" : null)"
                    title="@(_orgCatalogManageOpen ? Msg("ApplicationProfileInstance.Picker.HideCatalogManage") : Msg("ApplicationProfileInstance.Picker.ShowCatalogManage"))"
                    aria-label="@(_orgCatalogManageOpen ? Msg("ApplicationProfileInstance.Picker.HideCatalogManage") : Msg("ApplicationProfileInstance.Picker.ShowCatalogManage"))"
                    aria-pressed="@_orgCatalogManageOpen"
                    @onclick="ToggleOrgCatalogManage">
                <svg class="cs-multi-select-popup__gear-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81a.488.488 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L2.74 8.87a.488.488 0 0 0 .12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.488.488 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.488.488 0 0 0 .12-.61l-2.03-1.58zM12 15.6A3.6 3.6 0 1 1 15.6 12 3.6 3.6 0 0 1 12 15.6z" />
                </svg>
            </button>
        </header>

        @RenderStatus()

        <div class="ap-picker__org">
            @RenderOrgDropdown(Msg("ApplicationProfileInstance.Picker.Company"), OrganizationCatalogHelper.Company, SelectedCompanyId, Companies, Msg("ApplicationProfileInstance.Picker.CompanyHint"))
            @RenderOrgDropdown(Msg("ApplicationProfileInstance.Picker.Signatory"), OrganizationCatalogHelper.Signatory, SelectedSignatoryId, Signatories, null)
            @RenderOrgDropdown(Msg("ApplicationProfileInstance.Picker.Representative"), OrganizationCatalogHelper.Representative, SelectedRepresentativeId, Representatives, null)
        </div>

        <div class="ap-picker__callout" role="note">
            @Msg("ApplicationProfileInstance.Picker.OrgCallout")
            @if (_orgCatalogManageOpen)
            {
                <text>@Msg("ApplicationProfileInstance.Picker.OrgCalloutManage")</text>
            }
        </div>

        <div class="ap-picker__actions">
            @RenderAdvance()
            <button type="button" class="ap-picker__btn" disabled="@IsAdvancing" @onclick="BackStepAsync">@Msg("ApplicationProfileInstance.Picker.Back")</button>
            <button type="button"
                    class="ap-picker__btn ap-picker__btn--primary"
                    disabled="@(IsAdvancing || !CanContinueFromOrganization)"
                    @onclick="NextStepAsync">
                @Msg("ApplicationProfileInstance.Picker.Continue")
            </button>
        </div>
        <p class="ap-picker__foot-note">@VisaUiMessages.Format("ApplicationProfileInstance.Picker.FootNote", SelectedProfileName)</p>
    }
    else if (Step == 4)
    {
        var missing = ApplicationWorkspaceCaseSummaryCompletenessGate.MissingRequiredFields(CaseSummaryFields);

        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.CaseSummary")</h1>
                <p class="ap-picker__profile-name" title="@SelectedProfileName">@SelectedProfileName</p>
                <p class="ap-picker__sub">@Msg("ApplicationProfileInstance.Picker.CaseSummarySub")</p>
                <p class="ap-picker__crumb">
                    @Msg("ApplicationProfileInstance.Picker.CrumbProfile") ·
                    @(SelectedRow?.RequiresApprovalLegVersion == true ? Msg("ApplicationProfileInstance.Picker.CrumbLegs") + " · " : null)
                    @Msg("ApplicationProfileInstance.Picker.ChooseOrg") ·
                    <strong>@Msg("ApplicationProfileInstance.Picker.CaseSummary")</strong>
                </p>
            </div>
        </header>

        @RenderStatus()

        @if (CaseSummaryFields.Count == 0)
        {
            <p class="ap-picker__hint">@Msg("ApplicationProfileInstance.Picker.NoRequiredProps")</p>
        }
        else
        {
            <div class="ap-picker__summary">
                <div class="ap-picker__summary-form">
                    @foreach (var field in CaseSummaryFields)
                    {
                        @RenderSummaryField(field)
                    }
                </div>
            </div>
        }

        <div class="ap-picker__callout" role="note">
            @Msg("ApplicationProfileInstance.Picker.CreateOpensPeople")
        </div>
        @if (missing.Count > 0)
        {
            <div class="ap-picker__status is-error" role="status">@ApplicationWorkspaceCaseSummaryCompletenessGate.FormatBannerMessage(missing)</div>
        }

        <div class="ap-picker__actions">
            @RenderAdvance()
            <button type="button" class="ap-picker__btn" disabled="@IsAdvancing" @onclick="BackStepAsync">@Msg("ApplicationProfileInstance.Picker.Back")</button>
            <button type="button"
                    class="ap-picker__btn ap-picker__btn--primary"
                    disabled="@(IsAdvancing || !CanCreateOnCaseSummaryStep)"
                    @onclick="UseProfileAsync">
                @Msg("ApplicationProfileInstance.Picker.Create")
            </button>
        </div>
        <p class="ap-picker__foot-note">@VisaUiMessages.Format("ApplicationProfileInstance.Picker.FootNoteLast", SelectedProfileName)</p>
    }
    else
    {
        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.ChooseProfile")</h1>
                <p class="ap-picker__sub">
                    @Msg("ApplicationProfileInstance.Picker.ChooseProfileSub")
                </p>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(RouteHint))
        {
            <div class="ap-picker__hint">@RouteHint</div>
        }

        @RenderStatus()

        @if (Rows.Count == 0)
        {
            <div class="ap-picker__empty">
                @((MarkupString)Msg("ApplicationProfileInstance.Picker.Empty"))
            </div>
        }
        else
        {
            <ul class="ap-picker__list" role="listbox" aria-label="@Msg("ApplicationProfileInstance.Picker.ListAria")">
                @foreach (var row in Rows)
                {
                    var selected = row.ProfileId == SelectedProfileId;
                    <li class="ap-picker__item @(selected ? "is-selected" : null)"
                        role="option"
                        aria-selected="@selected"
                        @onclick="() => SelectProfile(row.ProfileId)">
                        <div class="ap-picker__item-main">
                            <strong>@row.Name</strong>
                            <div class="ap-picker__meta">@row.MetaLine</div>
                        </div>
                        <div class="ap-picker__badges">
                            @if (row.IsConfigLocked)
                            {
                                <span class="ap-picker__badge ap-picker__badge--muted">@Msg("ApplicationProfile.Status.ConfigLocked")</span>
                            }
                            @if (selected)
                            {
                                <span class="ap-picker__badge ap-picker__badge--on">@Msg("ApplicationProfileInstance.Picker.Selected")</span>
                            }
                        </div>
                    </li>
                }
            </ul>

            @if (SelectedRow?.MissingApprovalLegVersions == true)
            {
                <div class="ap-picker__hint">@Msg("ApplicationProfileInstance.Picker.ContinueMissingVersions")</div>
            }

            <div class="ap-picker__actions">
                @RenderAdvance()
                <button type="button"
                        class="ap-picker__btn ap-picker__btn--primary"
                        disabled="@(IsAdvancing || SelectedProfileId == Guid.Empty)"
                        @onclick="NextStepAsync">
                    @Msg("ApplicationProfileInstance.Picker.Continue")
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsAdvancing { get; set; }
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public IReadOnlyList<ApplicationProfilePickerModel.PickerRowModel> Rows { get; set; } = Array.Empty<ApplicationProfilePickerModel.PickerRowModel>();
    [Parameter] public Guid SelectedProfileId { get; set; }
    [Parameter] public Guid SelectedVersionId { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public bool IsStatusWarning { get; set; }
    [Parameter] public string? RouteHint { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback UseProfileRequested { get; set; }
    [Parameter] public EventCallback NextStepRequested { get; set; }
    [Parameter] public EventCallback BackStepRequested { get; set; }
    [Parameter] public EventCallback<Guid> SelectProfileRequested { get; set; }
    [Parameter] public EventCallback<Guid> SelectVersionRequested { get; set; }
    [Parameter] public EventCallback NewApprovalLegRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenApprovalLegRequested { get; set; }
    [Parameter] public EventCallback OpenApprovalLegCatalogRequested { get; set; }
    [Parameter] public EventCallback<Guid> MakeDefaultApprovalLegRequested { get; set; }
    [Parameter] public IReadOnlyList<OrganizationCatalogOption> Companies { get; set; } = Array.Empty<OrganizationCatalogOption>();
    [Parameter] public IReadOnlyList<OrganizationCatalogOption> Signatories { get; set; } = Array.Empty<OrganizationCatalogOption>();
    [Parameter] public IReadOnlyList<OrganizationCatalogOption> Representatives { get; set; } = Array.Empty<OrganizationCatalogOption>();
    [Parameter] public Guid SelectedCompanyId { get; set; }
    [Parameter] public Guid SelectedSignatoryId { get; set; }
    [Parameter] public Guid SelectedRepresentativeId { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceOrganizationLetterheadUpdate> OrganizationChanged { get; set; }
    [Parameter] public EventCallback<ApplicationWorkspaceOrganizationLetterheadUpdate> MakeDefaultOrganizationRequested { get; set; }
    [Parameter] public EventCallback<(string Kind, Guid Id)> OrganizationCatalogEditorRequested { get; set; }
    [Parameter] public IReadOnlyList<ApplicationWorkspaceCaseHeaderField> CaseSummaryFields { get; set; } = Array.Empty<ApplicationWorkspaceCaseHeaderField>();
    [Parameter] public EventCallback<ApplicationWorkspaceCaseHeaderFieldUpdate> CaseSummaryFieldChanged { get; set; }

    private bool _initialLoadStarted;
    private bool _orgCatalogManageOpen;

    private ApplicationProfilePickerModel.PickerRowModel? SelectedRow =>
        Rows.FirstOrDefault(r => r.ProfileId == SelectedProfileId);

    private string SelectedProfileName =>
        string.IsNullOrWhiteSpace(SelectedRow?.Name) ? Msg("ApplicationProfileInstance.Picker.Unnamed") : SelectedRow.Name;

    private bool CanContinueFromLegs =>
        SelectedRow != null
        && SelectedVersionId != Guid.Empty;

    private bool CanContinueFromOrganization =>
        SelectedCompanyId != Guid.Empty
        && SelectedSignatoryId != Guid.Empty
        && SelectedRepresentativeId != Guid.Empty;

    private bool CanCreateOnCaseSummaryStep =>
        CanContinueFromOrganization
        && ApplicationProfilePickerCaseSummaryDraft.CanCreate(CaseSummaryFields);

    private void ToggleOrgCatalogManage() => _orgCatalogManageOpen = !_orgCatalogManageOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !InitialLoadRequested.HasDelegate)
            return;

        _initialLoadStarted = true;
        await InitialLoadRequested.InvokeAsync();
    }

    private RenderFragment RenderAdvance() => __builder =>
    {
        if (!IsAdvancing || string.IsNullOrWhiteSpace(StatusMessage))
            return;

        <div class="ap-picker__progress" role="status" aria-live="polite">
            <span class="ap-picker__progress-label">@StatusMessage</span>
            <span class="ap-picker__progress-track" aria-hidden="true"><span class="ap-picker__progress-bar"></span></span>
        </div>
    };

    private RenderFragment RenderStatus() => __builder =>
    {
        if (!IsAdvancing && !string.IsNullOrWhiteSpace(StatusMessage))
        {
            var css = IsStatusError ? "is-error" : IsStatusWarning ? "is-warn" : "is-ok";
            <div class="ap-picker__status @css" role="status">@StatusMessage</div>
        }
    };

    private RenderFragment RenderOrgDropdown(
        string label,
        string kind,
        Guid selectedId,
        IReadOnlyList<OrganizationCatalogOption> options,
        string? hint) => __builder =>
    {
        var selected = options.FirstOrDefault(o => o.Id == selectedId);
        <div class="ap-picker__org-field">
            <label class="ap-picker__org-label">@label <span class="ap-picker__req" aria-hidden="true">*</span></label>
            <div class="ap-picker__org-row">
                <select class="ap-picker__org-select"
                        value="@selectedId"
                        @onchange="e => OnOrganizationChanged(kind, e.Value?.ToString())">
                    @if (options.Count == 0)
                    {
                        <option value="">@(_orgCatalogManageOpen ? Msg("ApplicationProfileInstance.Picker.EmptyCatalog") : Msg("ApplicationProfileInstance.Picker.EmptyCatalogGear"))</option>
                    }
                    else
                    {
                        @foreach (var option in options)
                        {
                            <option value="@option.Id" selected="@(option.Id == selectedId)">@option.DisplayName</option>
                        }
                    }
                </select>
                @if (_orgCatalogManageOpen)
                {
                    <button type="button"
                            class="ap-picker__org-new"
                            @onclick="() => OnNewOrganization(kind)">
                        @Msg("ApplicationProfileInstance.Picker.New")
                    </button>
                    <button type="button"
                            class="ap-picker__org-edit"
                            aria-label="@VisaUiMessages.Format("ApplicationProfileInstance.Picker.EditLabel", label)"
                            disabled="@(selectedId == Guid.Empty)"
                            @onclick="() => OnEditOrganization(kind, selectedId)">
                        ✎
                    </button>
                }
                @if (selected?.IsDefault == true)
                {
                    <span class="ap-picker__badge ap-picker__badge--on">@Msg("ApplicationProfileInstance.Picker.Default")</span>
                }
                @if (selected != null && !selected.IsDefault)
                {
                    <button type="button"
                            class="ap-picker__link"
                            @onclick="() => OnMakeDefaultOrganization(kind, selectedId)">
                        @Msg("ApplicationProfileInstance.Picker.MakeDefault")
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(hint))
            {
                <p class="ap-picker__org-hint">@hint</p>
            }
        </div>
    };

    private async Task SelectProfile(Guid profileId)
    {
        if (SelectProfileRequested.HasDelegate)
            await SelectProfileRequested.InvokeAsync(profileId);
    }

    private async Task SelectVersion(Guid versionId)
    {
        if (SelectVersionRequested.HasDelegate)
            await SelectVersionRequested.InvokeAsync(versionId);
    }

    private async Task UseProfileAsync()
    {
        if (UseProfileRequested.HasDelegate)
            await UseProfileRequested.InvokeAsync();
    }

    private async Task NextStepAsync()
    {
        if (NextStepRequested.HasDelegate)
            await NextStepRequested.InvokeAsync();
    }

    private async Task BackStepAsync()
    {
        if (BackStepRequested.HasDelegate)
            await BackStepRequested.InvokeAsync();
    }

    private async Task NewApprovalLegAsync()
    {
        if (NewApprovalLegRequested.HasDelegate)
            await NewApprovalLegRequested.InvokeAsync();
    }

    private async Task OpenApprovalLegAsync(Guid versionId)
    {
        if (OpenApprovalLegRequested.HasDelegate)
            await OpenApprovalLegRequested.InvokeAsync(versionId);
    }

    private async Task OpenApprovalLegCatalogAsync()
    {
        if (OpenApprovalLegCatalogRequested.HasDelegate)
            await OpenApprovalLegCatalogRequested.InvokeAsync();
    }

    private async Task MakeDefaultApprovalLegAsync(Guid versionId)
    {
        if (MakeDefaultApprovalLegRequested.HasDelegate)
            await MakeDefaultApprovalLegRequested.InvokeAsync(versionId);
    }

    private async Task OnOrganizationChanged(string kind, string? raw)
    {
        if (!OrganizationChanged.HasDelegate)
            return;

        Guid.TryParse(raw, out var id);
        await OrganizationChanged.InvokeAsync(new ApplicationWorkspaceOrganizationLetterheadUpdate
        {
            Kind = kind,
            SelectedId = id == Guid.Empty ? null : id,
        });
    }

    private async Task OnMakeDefaultOrganization(string kind, Guid selectedId)
    {
        if (!MakeDefaultOrganizationRequested.HasDelegate)
            return;

        await MakeDefaultOrganizationRequested.InvokeAsync(new ApplicationWorkspaceOrganizationLetterheadUpdate
        {
            Kind = kind,
            SelectedId = selectedId,
            MakeDefault = true,
        });
    }

    private Task OnNewOrganization(string kind) =>
        OrganizationCatalogEditorRequested.HasDelegate
            ? OrganizationCatalogEditorRequested.InvokeAsync((kind, Guid.Empty))
            : Task.CompletedTask;

    private Task OnEditOrganization(string kind, Guid id) =>
        id == Guid.Empty || !OrganizationCatalogEditorRequested.HasDelegate
            ? Task.CompletedTask
            : OrganizationCatalogEditorRequested.InvokeAsync((kind, id));

    private RenderFragment RenderSummaryField(ApplicationWorkspaceCaseHeaderField field) => __builder =>
    {
        var required = field.FillState == ApplicationWorkspaceCaseSummaryFillState.Empty
            && !ApplicationWorkspaceCaseHeaderFieldsHelper.IsIdentityField(field.Key);
        <label class="cw-summary-field cw-summary-field--fill-@ApplicationWorkspaceCaseSummaryFill.CssToken(field.FillState)">
            <span class="cw-summary-field__label">
                @field.Label
                @if (required)
                {
                    <span class="ap-picker__req" aria-hidden="true"> *</span>
                }
            </span>
            @if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Date)
            {
                <input type="date"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.CommaSeparatedMultiSelect)
            {
                <BorderZoneLocationField Value="@field.Value"
                                         EditorAlias="@EditorAliasFor(field.Key)"
                                         ReadOnly="@field.ReadOnly"
                                         CatalogItems="@field.MultiSelectOptions"
                                         ValueChanged="@(value => OnCaseSummaryFieldChanged(field.Key, value))" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Lookup)
            {
                <select class="cw-summary-field__input"
                        value="@field.Value"
                        disabled="@field.ReadOnly"
                        @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())">
                    <option value="">@Msg("ApplicationProfileInstance.Picker.SelectPlaceholder")</option>
                    @foreach (var option in field.Options)
                    {
                        var optionId = option.Id.ToString("D");
                        <option value="@optionId" selected="@(string.Equals(field.Value, optionId, StringComparison.OrdinalIgnoreCase))">@option.DisplayName</option>
                    }
                </select>
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.ShortText)
            {
                <input type="text"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       maxlength="@(field.MaxLength ?? ApplicationWorkspaceCaseHeaderFieldsHelper.InstanceNumberMaxLength)"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Text)
            {
                <textarea class="cw-summary-field__input cw-summary-field__textarea"
                          maxlength="@ApplicationWorkspaceCaseHeaderFieldsHelper.PurposeMaxLength"
                          rows="4"
                          disabled="@field.ReadOnly"
                          @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())">@field.Value</textarea>
            }
            else
            {
                <input type="text"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())" />
            }
        </label>
    };

    private static string EditorAliasFor(string? fieldKey) =>
        string.Equals(fieldKey, ApplicationWorkspaceCaseHeaderFieldsHelper.WorkPermitLocation, StringComparison.Ordinal)
            ? CommaSeparatedMultiSelectEditorAliases.WorkPermittedLocation
            : CommaSeparatedMultiSelectEditorAliases.BorderZone;

    private Task OnCaseSummaryFieldChanged(string key, string? value)
    {
        if (!CaseSummaryFieldChanged.HasDelegate || string.IsNullOrWhiteSpace(key))
            return Task.CompletedTask;

        return CaseSummaryFieldChanged.InvokeAsync(new ApplicationWorkspaceCaseHeaderFieldUpdate
        {
            Key = key,
            Value = value,
        });
    }

    private async Task OnVersionKey(KeyboardEventArgs e, Guid versionId)
    {
        if (e.Key is "Enter" or " ")
            await SelectVersion(versionId);
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);
}