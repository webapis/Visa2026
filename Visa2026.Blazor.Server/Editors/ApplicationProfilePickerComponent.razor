@using System.Linq
@using Visa2026.Blazor.Server.Components
@using Visa2026.Blazor.Server.Editors
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Editors
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.ApplicationProfilePicker
@using Visa2026.Module.Services.ApplicationWorkspace

<div class="ap-picker" aria-busy="@IsAdvancing">
    @if (IsLoading)
    {
        <div class="ap-picker__loading" role="status">@Msg("ApplicationProfileInstance.Picker.Loading")</div>
    }
    else if (Step == 2)
    {
        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.ChooseLegs")</h1>
                <p class="ap-picker__profile-name" title="@SelectedProfileName">@SelectedProfileName</p>
                <p class="ap-picker__sub">@Msg("ApplicationProfileInstance.Picker.ApprovalLegsSub")</p>
            </div>
        </header>

        @RenderStatus()

        @if (SelectedRow != null)
        {
            <div class="ap-picker__section-head">
                <h2 class="ap-picker__section-title">@Msg("ApplicationProfileInstance.Picker.ApprovalLegsTitle")</h2>
                <div class="ap-picker__section-actions">
                    <button type="button" class="ap-picker__link" @onclick="OpenApprovalLegCatalogAsync">@Msg("ApplicationProfileInstance.Picker.Catalog")</button>
                    <button type="button" class="ap-picker__link" @onclick="NewApprovalLegAsync">@Msg("ApplicationProfileInstance.Picker.New")</button>
                </div>
            </div>
            @if (SelectedRow.MissingApprovalLegVersions)
            {
                <div class="ap-picker__versions-empty" role="status">
                    <p class="ap-picker__versions-empty-title">@Msg("ApplicationProfileInstance.Picker.NoVersionsTitle")</p>
                    <p>@Msg("ApplicationProfileInstance.Picker.NoVersionsBody")</p>
                    <div class="ap-picker__section-actions ap-picker__section-actions--empty">
                        <button type="button" class="ap-picker__link" @onclick="OpenApprovalLegCatalogAsync">@Msg("ApplicationProfileInstance.Picker.Catalog")</button>
                        <button type="button" class="ap-picker__btn ap-picker__btn--primary" @onclick="NewApprovalLegAsync">@Msg("ApplicationProfileInstance.Picker.New")</button>
                    </div>
                </div>
            }
            else
            {
                <div class="ap-picker__versions">
                    @foreach (var version in SelectedRow.ApprovalLegVersions)
                    {
                        var versionSelected = version.VersionId == SelectedVersionId;
                        <div class="ap-picker__version @(versionSelected ? "is-selected" : null)"
                             role="button"
                             tabindex="0"
                             @onclick="() => SelectVersionAndContinueAsync(version.VersionId)"
                             @onkeydown="e => OnVersionKey(e, version.VersionId)">
                            <span class="ap-picker__version-title">
                                @version.Name
                                @if (version.IsDefault)
                                {
                                    <span class="ap-picker__badge ap-picker__badge--on">@Msg("ApplicationProfileInstance.Picker.Default")</span>
                                }
                            </span>
                            <ol class="ap-picker__version-legs">
                                @foreach (var ministry in version.MinistryNames)
                                {
                                    <li>@ministry</li>
                                }
                            </ol>
                            <div class="ap-picker__version-foot">
                                <span class="ap-picker__meta">@VisaUiMessages.Format("ApplicationProfileInstance.Picker.MinistriesCount", version.MinistryNames.Count)</span>
                                <span class="ap-picker__version-foot-actions">
                                    @if (!version.IsDefault)
                                    {
                                        <button type="button"
                                                class="ap-picker__link"
                                                @onclick="() => MakeDefaultApprovalLegAsync(version.VersionId)"
                                                @onclick:stopPropagation="true">
                                            @Msg("ApplicationProfileInstance.Picker.MakeDefault")
                                        </button>
                                    }
                                    <button type="button"
                                            class="ap-picker__link"
                                            @onclick="() => OpenApprovalLegAsync(version.VersionId)"
                                            @onclick:stopPropagation="true">
                                        @Msg("ApplicationProfileInstance.Picker.Open")
                                    </button>
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <div class="ap-picker__actions">
            @RenderAdvance()
            <button type="button" class="ap-picker__btn" disabled="@IsAdvancing" @onclick="BackStepAsync">@Msg("ApplicationProfileInstance.Picker.Back")</button>
        </div>
    }
    else if (Step == 4)
    {
        var missing = ApplicationWorkspaceCaseSummaryCompletenessGate.MissingRequiredFields(CaseSummaryFields);

        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.CaseSummary")</h1>
                <p class="ap-picker__profile-name" title="@SelectedProfileName">@SelectedProfileName</p>
                <p class="ap-picker__sub">@Msg("ApplicationProfileInstance.Picker.CaseSummarySub")</p>
                <p class="ap-picker__crumb">
                    @Msg("ApplicationProfileInstance.Picker.CrumbProfile") ·
                    @(SelectedRow?.RequiresApprovalLegVersion == true ? Msg("ApplicationProfileInstance.Picker.CrumbLegs") + " · " : null)
                    <strong>@Msg("ApplicationProfileInstance.Picker.CaseSummary")</strong>
                </p>
            </div>
        </header>

        @RenderStatus()

        @if (CaseSummaryFields.Count == 0)
        {
            <p class="ap-picker__hint">@Msg("ApplicationProfileInstance.Picker.NoRequiredProps")</p>
        }
        else
        {
            <div class="ap-picker__summary">
                <div class="ap-picker__summary-form">
                    @foreach (var field in CaseSummaryFields)
                    {
                        @RenderSummaryField(field)
                    }
                </div>
            </div>
        }

        <div class="ap-picker__callout" role="note">
            @Msg("ApplicationProfileInstance.Picker.CreateOpensPeople")
        </div>
        @if (missing.Count > 0)
        {
            <div class="ap-picker__status is-error" role="status">@ApplicationWorkspaceCaseSummaryCompletenessGate.FormatBannerMessage(missing)</div>
        }

        <div class="ap-picker__actions">
            @RenderAdvance()
            <button type="button" class="ap-picker__btn" disabled="@IsAdvancing" @onclick="BackStepAsync">@Msg("ApplicationProfileInstance.Picker.Back")</button>
            <button type="button"
                    class="ap-picker__btn ap-picker__btn--primary"
                    disabled="@(IsAdvancing || !CanCreateOnCaseSummaryStep)"
                    @onclick="UseProfileAsync">
                @Msg("ApplicationProfileInstance.Picker.Create")
            </button>
        </div>
        <p class="ap-picker__foot-note">@VisaUiMessages.Format("ApplicationProfileInstance.Picker.FootNoteLast", SelectedProfileName)</p>
    }
    else
    {
        <header class="ap-picker__header">
            <div>
                <h1 class="ap-picker__title">@Msg("ApplicationProfileInstance.Picker.ChooseProfile")</h1>
                <p class="ap-picker__sub">
                    @Msg("ApplicationProfileInstance.Picker.ChooseProfileSub")
                </p>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(RouteHint))
        {
            <div class="ap-picker__hint">@RouteHint</div>
        }

        @RenderStatus()

        @if (Rows.Count == 0)
        {
            <div class="ap-picker__empty">
                @((MarkupString)Msg("ApplicationProfileInstance.Picker.Empty"))
            </div>
        }
        else
        {
            <div class="ap-picker__tabs" role="tablist" aria-label="@Msg("ApplicationProfileInstance.Picker.Shelf.TabsAria")">
                <button type="button"
                        class="ap-picker__tab @(_tab.Kind == ApplicationProfilePickerTabKind.Recent ? "is-active" : null)"
                        role="tab"
                        aria-selected="@(_tab.Kind == ApplicationProfilePickerTabKind.Recent)"
                        @onclick="() => SelectTab(new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.Recent))"
                        @oncontextmenu:preventDefault="true">@Msg("ApplicationProfileInstance.Picker.Tab.Recent")</button>
                <button type="button"
                        class="ap-picker__tab @(_tab.Kind == ApplicationProfilePickerTabKind.All ? "is-active" : null)"
                        role="tab"
                        aria-selected="@(_tab.Kind == ApplicationProfilePickerTabKind.All)"
                        @onclick="() => SelectTab(new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.All))"
                        @oncontextmenu:preventDefault="true">@Msg("ApplicationProfileInstance.Picker.Tab.All")</button>
                @foreach (var shelf in Shelves)
                {
                    var shelfActive = _tab.Kind == ApplicationProfilePickerTabKind.Shelf && _tab.ShelfId == shelf.Id;
                    <button type="button"
                            class="ap-picker__tab @(shelfActive ? "is-active" : null)"
                            role="tab"
                            aria-selected="@shelfActive"
                            @onclick="() => SelectTab(new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.Shelf, shelf.Id))"
                            @oncontextmenu="e => OnShelfTabContextMenu(e, shelf)"
                            @oncontextmenu:preventDefault="true">@shelf.Name</button>
                }
            </div>

            @if (VisibleRows.Count == 0)
            {
                <div class="ap-picker__empty">
                    @(_tab.Kind == ApplicationProfilePickerTabKind.Recent
                        ? Msg("ApplicationProfileInstance.Picker.Shelf.EmptyRecent")
                        : Msg("ApplicationProfileInstance.Picker.Shelf.Empty"))
                </div>
            }
            else
            {
                <ul class="ap-picker__list" role="listbox" aria-label="@Msg("ApplicationProfileInstance.Picker.ListAria")" aria-busy="@IsAdvancing">
                    @foreach (var row in VisibleRows)
                    {
                        var selected = row.ProfileId == SelectedProfileId;
                        var advancing = IsAdvancing && selected;
                        <li class="ap-picker__item @(selected ? "is-selected" : null) @(advancing ? "is-advancing" : null)"
                            role="option"
                            aria-selected="@selected"
                            aria-busy="@advancing"
                            tabindex="@(IsAdvancing && !advancing ? -1 : 0)"
                            @onclick="() => SelectProfileAndContinueAsync(row.ProfileId)"
                            @oncontextmenu="e => OnProfileContextMenu(e, row)"
                            @oncontextmenu:preventDefault="true"
                            @onkeydown="e => OnProfileKey(e, row.ProfileId)">
                            <div class="ap-picker__item-main">
                                <div class="ap-picker__item-title">
                                    <strong>@row.Name</strong>
                                    @if (advancing)
                                    {
                                        <span class="ap-picker__item-spinner" aria-hidden="true"></span>
                                    }
                                </div>
                                <div class="ap-picker__meta">@row.MetaLine</div>
                            </div>
                            <div class="ap-picker__badges">
                                @if (advancing)
                                {
                                    <span class="ap-picker__item-advance" role="status">@StatusMessage</span>
                                }
                                else
                                {
                                    @if (row.IsConfigLocked)
                                    {
                                        <span class="ap-picker__badge ap-picker__badge--muted">@Msg("ApplicationProfile.Status.ConfigLocked")</span>
                                    }
                                    @if (selected)
                                    {
                                        <span class="ap-picker__badge ap-picker__badge--on">@Msg("ApplicationProfileInstance.Picker.Selected")</span>
                                    }
                                }
                            </div>
                            @if (advancing)
                            {
                                <span class="ap-picker__item-track" aria-hidden="true"><span class="ap-picker__item-bar"></span></span>
                            }
                        </li>
                    }
                </ul>
            }

            @if (SelectedRow?.MissingApprovalLegVersions == true)
            {
                <div class="ap-picker__hint">@Msg("ApplicationProfileInstance.Picker.ContinueMissingVersions")</div>
            }

        }

        @if (_menuOpen)
        {
            <div class="ap-picker__ctx-backdrop" @onclick="CloseMenus"></div>
            <div class="ap-picker__ctx" style="left:@(_menuX.ToString(System.Globalization.CultureInfo.InvariantCulture))px;top:@(_menuY.ToString(System.Globalization.CultureInfo.InvariantCulture))px" role="menu">
                @if (_menuMode == MenuMode.Profile)
                {
                    <div class="ap-picker__ctx-label">@Msg("ApplicationProfileInstance.Picker.Shelf.MoveTo")</div>
                    <button type="button" class="ap-picker__ctx-item @(_menuProfileShelfId == null ? "is-current" : null)" role="menuitem" @onclick="() => MoveProfileAsync(null)">@Msg("ApplicationProfileInstance.Picker.Shelf.RemoveFromShelf")</button>
                    @foreach (var shelf in Shelves)
                    {
                        <button type="button" class="ap-picker__ctx-item @(_menuProfileShelfId == shelf.Id ? "is-current" : null)" role="menuitem" @onclick="() => MoveProfileAsync(shelf.Id)">@shelf.Name</button>
                    }
                    <div class="ap-picker__ctx-sep"></div>
                    <button type="button" class="ap-picker__ctx-item" role="menuitem" @onclick="OpenCreateDialog">@Msg("ApplicationProfileInstance.Picker.Shelf.CreateNewTab")</button>
                }
                else if (_menuMode == MenuMode.Shelf && _menuShelf != null && !_menuShelf.IsSystem)
                {
                    <button type="button" class="ap-picker__ctx-item" role="menuitem" @onclick="OpenRenameDialog">@Msg("ApplicationProfileInstance.Picker.Shelf.Rename")</button>
                    <button type="button" class="ap-picker__ctx-item ap-picker__ctx-item--danger" role="menuitem" @onclick="DeleteMenuShelfAsync">@Msg("ApplicationProfileInstance.Picker.Shelf.Delete")</button>
                }
            </div>
        }

        @if (_dialogOpen)
        {
            <div class="ap-picker__dialog-backdrop" @onclick="CloseDialog"></div>
            <div class="ap-picker__dialog" role="dialog" aria-modal="true" aria-label="@Msg("ApplicationProfileInstance.Picker.Shelf.CreateTitle")">
                <h2 class="ap-picker__dialog-title">@(_dialogRename ? Msg("ApplicationProfileInstance.Picker.Shelf.Rename") : Msg("ApplicationProfileInstance.Picker.Shelf.CreateTitle"))</h2>
                <label class="ap-picker__dialog-label">
                    <span>@Msg("ApplicationProfileInstance.Picker.Shelf.NameLabel")</span>
                    <input class="ap-picker__dialog-input" @bind="_dialogName" @bind:event="oninput" maxlength="100" />
                </label>
                <div class="ap-picker__dialog-actions">
                    <button type="button" class="ap-picker__btn" @onclick="CloseDialog">@Msg("ApplicationProfileInstance.Picker.Shelf.Cancel")</button>
                    <button type="button" class="ap-picker__btn ap-picker__btn--primary" @onclick="ConfirmDialogAsync">@Msg("ApplicationProfileInstance.Picker.Shelf.Create")</button>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsAdvancing { get; set; }
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public IReadOnlyList<ApplicationProfilePickerModel.PickerRowModel> Rows { get; set; } = Array.Empty<ApplicationProfilePickerModel.PickerRowModel>();
    [Parameter] public IReadOnlyList<ApplicationProfilePickerModel.ShelfModel> Shelves { get; set; } = Array.Empty<ApplicationProfilePickerModel.ShelfModel>();
    [Parameter] public Guid SelectedProfileId { get; set; }
    [Parameter] public Guid SelectedVersionId { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public bool IsStatusWarning { get; set; }
    [Parameter] public string? RouteHint { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback UseProfileRequested { get; set; }
    [Parameter] public EventCallback NextStepRequested { get; set; }
    [Parameter] public EventCallback BackStepRequested { get; set; }
    [Parameter] public EventCallback<Guid> SelectProfileRequested { get; set; }
    [Parameter] public EventCallback<Guid> SelectVersionRequested { get; set; }
    [Parameter] public EventCallback NewApprovalLegRequested { get; set; }
    [Parameter] public EventCallback<Guid> OpenApprovalLegRequested { get; set; }
    [Parameter] public EventCallback OpenApprovalLegCatalogRequested { get; set; }
    [Parameter] public EventCallback<Guid> MakeDefaultApprovalLegRequested { get; set; }
    [Parameter] public IReadOnlyList<ApplicationWorkspaceCaseHeaderField> CaseSummaryFields { get; set; } = Array.Empty<ApplicationWorkspaceCaseHeaderField>();
    [Parameter] public EventCallback<ApplicationWorkspaceCaseHeaderFieldUpdate> CaseSummaryFieldChanged { get; set; }
    [Parameter] public EventCallback AlternativeAddressCreateRequested { get; set; }

    [Parameter] public EventCallback<string> InvitationSiteCreateRequested { get; set; }
    [Parameter] public EventCallback<(Guid ProfileId, Guid? ShelfId)> MoveToShelfRequested { get; set; }
    [Parameter] public EventCallback<(Guid ProfileId, string Name)> CreateShelfRequested { get; set; }
    [Parameter] public EventCallback<(Guid ShelfId, string Name)> RenameShelfRequested { get; set; }
    [Parameter] public EventCallback<Guid> DeleteShelfRequested { get; set; }

    private bool _initialLoadStarted;
    private bool _tabInitialized;
    private ApplicationProfilePickerTabKey _tab = new(ApplicationProfilePickerTabKind.All);
    private bool _menuOpen;
    private MenuMode _menuMode;
    private double _menuX;
    private double _menuY;
    private Guid? _menuProfileId;
    private Guid? _menuProfileShelfId;
    private ApplicationProfilePickerModel.ShelfModel? _menuShelf;
    private bool _dialogOpen;
    private bool _dialogRename;
    private string _dialogName = string.Empty;

    private enum MenuMode { Profile, Shelf }

    private IReadOnlyList<ApplicationProfilePickerModel.PickerRowModel> VisibleRows
    {
        get
        {
            IEnumerable<ApplicationProfilePickerModel.PickerRowModel> q = _tab.Kind switch
            {
                ApplicationProfilePickerTabKind.All => Rows,
                ApplicationProfilePickerTabKind.Recent => Rows
                    .Where(r => r.LastUsedAt.HasValue)
                    .OrderByDescending(r => r.LastUsedAt)
                    .Take(ApplicationProfilePickerShelfCodes.RecentCap),
                ApplicationProfilePickerTabKind.Shelf when _tab.ShelfId is Guid shelfId && shelfId != Guid.Empty =>
                    Rows.Where(r => r.ShelfId == shelfId),
                _ => Array.Empty<ApplicationProfilePickerModel.PickerRowModel>(),
            };
            return q.ToList();
        }
    }

    private ApplicationProfilePickerModel.PickerRowModel? SelectedRow =>
        Rows.FirstOrDefault(r => r.ProfileId == SelectedProfileId);

    private string SelectedProfileName =>
        string.IsNullOrWhiteSpace(SelectedRow?.Name) ? Msg("ApplicationProfileInstance.Picker.Unnamed") : SelectedRow.Name;

    private bool CanCreateOnCaseSummaryStep =>
        ApplicationProfilePickerCaseSummaryDraft.CanCreate(CaseSummaryFields);

    protected override void OnParametersSet()
    {
        EnsureDefaultTab();
    }

    private void EnsureDefaultTab()
    {
        if (_tabInitialized || Rows.Count == 0)
            return;

        _tab = Rows.Any(r => r.LastUsedAt.HasValue)
            ? new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.Recent)
            : new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.All);
        _tabInitialized = true;
    }

    private void SelectTab(ApplicationProfilePickerTabKey tab)
    {
        _tab = tab;
        CloseMenus();
    }

    private void CloseMenus()
    {
        _menuOpen = false;
        _menuProfileId = null;
        _menuShelf = null;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _dialogName = string.Empty;
    }

    private void OnProfileContextMenu(MouseEventArgs e, ApplicationProfilePickerModel.PickerRowModel row)
    {
        _menuMode = MenuMode.Profile;
        _menuProfileId = row.ProfileId;
        _menuProfileShelfId = row.ShelfId;
        _menuShelf = null;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuOpen = true;
    }

    private void OnShelfTabContextMenu(MouseEventArgs e, ApplicationProfilePickerModel.ShelfModel shelf)
    {
        if (shelf.IsSystem)
            return;

        _menuMode = MenuMode.Shelf;
        _menuShelf = shelf;
        _menuProfileId = null;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuOpen = true;
    }

    private async Task MoveProfileAsync(Guid? shelfId)
    {
        var profileId = _menuProfileId ?? Guid.Empty;
        CloseMenus();
        if (profileId == Guid.Empty || !MoveToShelfRequested.HasDelegate)
            return;
        await MoveToShelfRequested.InvokeAsync((profileId, shelfId));
    }

    private void OpenCreateDialog()
    {
        _dialogRename = false;
        _dialogName = string.Empty;
        _dialogOpen = true;
        _menuOpen = false;
    }

    private void OpenRenameDialog()
    {
        if (_menuShelf == null)
            return;
        _dialogRename = true;
        _dialogName = _menuShelf.Name;
        _dialogOpen = true;
        _menuOpen = false;
    }

    private async Task ConfirmDialogAsync()
    {
        var name = _dialogName;
        var rename = _dialogRename;
        var shelfId = _menuShelf?.Id ?? Guid.Empty;
        var profileId = _menuProfileId ?? Guid.Empty;
        CloseDialog();

        if (rename)
        {
            if (shelfId == Guid.Empty || !RenameShelfRequested.HasDelegate)
                return;
            await RenameShelfRequested.InvokeAsync((shelfId, name));
            return;
        }

        if (!CreateShelfRequested.HasDelegate)
            return;
        await CreateShelfRequested.InvokeAsync((profileId, name));
        // After create, prefer showing the new shelf once Shelves refresh — All until then.
        _tab = new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.All);
    }

    private async Task DeleteMenuShelfAsync()
    {
        var shelfId = _menuShelf?.Id ?? Guid.Empty;
        CloseMenus();
        if (shelfId == Guid.Empty || !DeleteShelfRequested.HasDelegate)
            return;
        await DeleteShelfRequested.InvokeAsync(shelfId);
        if (_tab.Kind == ApplicationProfilePickerTabKind.Shelf && _tab.ShelfId == shelfId)
            _tab = new ApplicationProfilePickerTabKey(ApplicationProfilePickerTabKind.All);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadStarted || !InitialLoadRequested.HasDelegate)
            return;

        _initialLoadStarted = true;
        await InitialLoadRequested.InvokeAsync();
    }

    private RenderFragment RenderAdvance() => __builder =>
    {
        if (!IsAdvancing || string.IsNullOrWhiteSpace(StatusMessage))
            return;

        <div class="ap-picker__progress" role="status" aria-live="polite">
            <span class="ap-picker__progress-label">@StatusMessage</span>
            <span class="ap-picker__progress-track" aria-hidden="true"><span class="ap-picker__progress-bar"></span></span>
        </div>
    };

    private RenderFragment RenderStatus() => __builder =>
    {
        if (!IsAdvancing && !string.IsNullOrWhiteSpace(StatusMessage))
        {
            var css = IsStatusError ? "is-error" : IsStatusWarning ? "is-warn" : "is-ok";
            <div class="ap-picker__status @css" role="status">@StatusMessage</div>
        }
    };

    private async Task SelectProfileAndContinueAsync(Guid profileId)
    {
        if (IsAdvancing || profileId == Guid.Empty)
            return;

        if (SelectProfileRequested.HasDelegate)
            await SelectProfileRequested.InvokeAsync(profileId);

        if (NextStepRequested.HasDelegate)
            await NextStepRequested.InvokeAsync();
    }

    private async Task OnProfileKey(KeyboardEventArgs e, Guid profileId)
    {
        if (e.Key is "Enter" or " ")
            await SelectProfileAndContinueAsync(profileId);
    }

    private async Task SelectVersionAndContinueAsync(Guid versionId)
    {
        if (IsAdvancing || versionId == Guid.Empty)
            return;

        if (SelectVersionRequested.HasDelegate)
            await SelectVersionRequested.InvokeAsync(versionId);

        if (NextStepRequested.HasDelegate)
            await NextStepRequested.InvokeAsync();
    }

    private async Task UseProfileAsync()
    {
        if (UseProfileRequested.HasDelegate)
            await UseProfileRequested.InvokeAsync();
    }

    private async Task BackStepAsync()
    {
        if (BackStepRequested.HasDelegate)
            await BackStepRequested.InvokeAsync();
    }

    private async Task NewApprovalLegAsync()
    {
        if (NewApprovalLegRequested.HasDelegate)
            await NewApprovalLegRequested.InvokeAsync();
    }

    private async Task OpenApprovalLegAsync(Guid versionId)
    {
        if (OpenApprovalLegRequested.HasDelegate)
            await OpenApprovalLegRequested.InvokeAsync(versionId);
    }

    private async Task OpenApprovalLegCatalogAsync()
    {
        if (OpenApprovalLegCatalogRequested.HasDelegate)
            await OpenApprovalLegCatalogRequested.InvokeAsync();
    }

    private async Task MakeDefaultApprovalLegAsync(Guid versionId)
    {
        if (MakeDefaultApprovalLegRequested.HasDelegate)
            await MakeDefaultApprovalLegRequested.InvokeAsync(versionId);
    }

    private RenderFragment RenderSummaryField(ApplicationWorkspaceCaseHeaderField field) => __builder =>
    {
        var required = field.FillState == ApplicationWorkspaceCaseSummaryFillState.Empty
            && !ApplicationWorkspaceCaseHeaderFieldsHelper.IsIdentityField(field.Key);
        <label class="cw-summary-field cw-summary-field--fill-@ApplicationWorkspaceCaseSummaryFill.CssToken(field.FillState)">
            <span class="cw-summary-field__label">
                @field.Label
                @if (required)
                {
                    <span class="ap-picker__req" aria-hidden="true"> *</span>
                }
            </span>
            @if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Date)
            {
                <OfficerDateEdit Date="@field.EditorDate"
                                 DateChanged="value => OnCaseSummaryDateChanged(field.Key, value)"
                                 CssClass="cw-summary-date"
                                 ReadOnly="@field.ReadOnly"
                                 Enabled="@(!field.ReadOnly)" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.CommaSeparatedMultiSelect)
            {
                <BorderZoneLocationField Value="@field.Value"
                                         EditorAlias="@EditorAliasFor(field.Key)"
                                         ReadOnly="@field.ReadOnly"
                                         CatalogItems="@field.MultiSelectOptions"
                                         ValueChanged="@(value => OnCaseSummaryFieldChanged(field.Key, value))" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Lookup)
            {
                <div class="cw-summary-lookup-row">
                    <select class="cw-summary-field__input"
                            value="@field.Value"
                            disabled="@field.ReadOnly"
                            @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())">
                        <option value="">@Msg("ApplicationProfileInstance.Picker.SelectPlaceholder")</option>
                        @foreach (var option in field.Options)
                        {
                            var optionId = option.Id.ToString("D");
                            <option value="@optionId" selected="@(string.Equals(field.Value, optionId, StringComparison.OrdinalIgnoreCase))">@option.DisplayName</option>
                        }
                    </select>
                    @if (CanAddAlternativeAddress(field))
                    {
                        <button type="button"
                                class="ap-picker__org-new"
                                @onclick="OnNewAlternativeAddress">
                            @Msg("ApplicationProfileInstance.Picker.New")
                        </button>
                    }
                    @if (CanAddInvitationSite(field))
                    {
                        <button type="button"
                                class="ap-picker__org-new"
                                @onclick="() => OnNewInvitationSite(field.Key)">
                            @Msg("ApplicationProfileInstance.Picker.New")
                        </button>
                    }
                </div>
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.ShortText)
            {
                <input type="text"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       maxlength="@(field.MaxLength ?? ApplicationWorkspaceCaseHeaderFieldsHelper.InstanceNumberMaxLength)"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())" />
            }
            else if (field.Kind == ApplicationWorkspaceCaseHeaderFieldKind.Text)
            {
                <textarea class="cw-summary-field__input cw-summary-field__textarea"
                          maxlength="@ApplicationWorkspaceCaseHeaderFieldsHelper.PurposeMaxLength"
                          rows="4"
                          disabled="@field.ReadOnly"
                          @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())">@field.Value</textarea>
            }
            else
            {
                <input type="text"
                       class="cw-summary-field__input"
                       value="@field.Value"
                       disabled="@field.ReadOnly"
                       @onchange="e => OnCaseSummaryFieldChanged(field.Key, e.Value?.ToString())" />
            }
        </label>
    };

    private static string EditorAliasFor(string? fieldKey) =>
        string.Equals(fieldKey, ApplicationWorkspaceCaseHeaderFieldsHelper.WorkPermitLocation, StringComparison.Ordinal)
            ? CommaSeparatedMultiSelectEditorAliases.WorkPermittedLocation
            : CommaSeparatedMultiSelectEditorAliases.BorderZone;

    private static bool CanAddAlternativeAddress(ApplicationWorkspaceCaseHeaderField field) =>
        !field.ReadOnly
        && string.Equals(field.Key, ApplicationWorkspaceCaseHeaderFieldsHelper.InvitationAlternativeAddress, StringComparison.Ordinal);

    private Task OnNewAlternativeAddress() =>
        AlternativeAddressCreateRequested.HasDelegate
            ? AlternativeAddressCreateRequested.InvokeAsync()
            : Task.CompletedTask;

    private bool CanAddInvitationSite(ApplicationWorkspaceCaseHeaderField field) =>
        ApplicationWorkspaceCaseHeaderFieldsHelper.CanCreateInvitationSite(field, CaseSummaryFields);

    private Task OnNewInvitationSite(string fieldKey) =>
        InvitationSiteCreateRequested.HasDelegate
            ? InvitationSiteCreateRequested.InvokeAsync(fieldKey)
            : Task.CompletedTask;

    private Task OnCaseSummaryDateChanged(string key, DateTime? value) =>
        OnCaseSummaryFieldChanged(key, ApplicationWorkspaceCaseHeaderField.FormatEditorDate(value));

    private Task OnCaseSummaryFieldChanged(string key, string? value)
    {
        if (!CaseSummaryFieldChanged.HasDelegate || string.IsNullOrWhiteSpace(key))
            return Task.CompletedTask;

        return CaseSummaryFieldChanged.InvokeAsync(new ApplicationWorkspaceCaseHeaderFieldUpdate
        {
            Key = key,
            Value = value,
        });
    }

    private async Task OnVersionKey(KeyboardEventArgs e, Guid versionId)
    {
        if (e.Key is "Enter" or " ")
            await SelectVersionAndContinueAsync(versionId);
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);
}