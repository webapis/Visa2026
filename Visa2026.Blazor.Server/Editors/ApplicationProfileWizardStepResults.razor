    }

    private void TogglePurposeDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequirePurpose) return;
        if (!ParseChecked(e)) Profile.DefaultPurpose = null;
    }

    private void ToggleWorkPermitLocationDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireWorkPermitLocation) return;
        if (!ParseChecked(e)) Profile.DefaultWorkPermitLocation = null;
        else if (Profile.DefaultWorkPermitLocation == null)
            Profile.DefaultWorkPermitLocation = string.Empty;
    }

    private Task OnWorkPermitLocationDefaultChanged(string? value)
    {
        Profile.DefaultWorkPermitLocation = value;
        return Task.CompletedTask;
    }

    private void OnPurposeUseChanged()
    {
        if (!Profile.RequirePurpose)
            Profile.DefaultPurpose = null;
    }

    private void OnWorkPermitLocationUseChanged()
    {
