@using System.Linq
@using DevExpress.ExpressApp
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Editors
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.ApplicationProfileWizard

<div class="ap-wizard__panel-head">
    <h2>@Msg("ApplicationProfile.Wizard.Step.Results")</h2>
    <p>@Msg("ApplicationProfile.Wizard.ResultsIntro")</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__section">
        <h3>@Msg("ApplicationProfile.Wizard.RequiredProps")</h3>
        <p class="ap-wizard__hint">@Msg("ApplicationProfile.Wizard.UseHint")</p>
        <table class="ap-wizard__table">
            <thead>
                <tr>
                    <th>@Msg("ApplicationProfile.Wizard.ColUse")</th>
                    <th>@Msg("ApplicationProfile.Wizard.ColProperty")</th>
                    <th>@Msg("ApplicationProfile.Wizard.ColKind")</th>
                    <th>@Msg("ApplicationProfile.Wizard.ColHasDefault")</th>
                    <th>@Msg("ApplicationProfile.Wizard.ColDefaultValue")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireVisaType" disabled="@Disabled" /></td>
                    <td>@Field("VisaType")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasVisaTypeDefault" disabled="@(Disabled || !Profile.RequireVisaType)" @onchange="ToggleVisaTypeDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireVisaType)" value="@FormatGuid(Profile.DefaultVisaTypeId)" @onchange="OnVisaTypeChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.VisaTypes) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireVisaCategory" disabled="@Disabled" /></td>
                    <td>@Field("VisaCategory")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasVisaCategoryDefault" disabled="@(Disabled || !Profile.RequireVisaCategory)" @onchange="ToggleVisaCategoryDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireVisaCategory)" value="@FormatGuid(Profile.DefaultVisaCategoryId)" @onchange="OnVisaCategoryChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.VisaCategories) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireVisaPeriod" disabled="@Disabled" /></td>
                    <td>@Field("VisaPeriod")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasVisaPeriodDefault" disabled="@(Disabled || !Profile.RequireVisaPeriod)" @onchange="ToggleVisaPeriodDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireVisaPeriod)" value="@FormatGuid(Profile.DefaultVisaPeriodId)" @onchange="OnVisaPeriodChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.VisaPeriods) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireBorderZone" disabled="@(Disabled || Profile.ProduceInvitation || Profile.ProduceVisa)" /></td>
                    <td>@Field("BorderZone")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindMulti")</span></td>
                    <td><input type="checkbox" checked="@HasBorderZoneDefault" disabled="@(Disabled || !Profile.RequireBorderZone)" @onchange="ToggleBorderZoneDefault" /></td>
                    <td>
                        <BorderZoneLocationField Value="@Profile.DefaultBorderZoneLocation"
                                                 ReadOnly="@(Disabled || !Profile.RequireBorderZone || !HasBorderZoneDefault)"
                                                 ObjectSpace="@ObjectSpace"
                                                 ValueChanged="@OnBorderZoneDefaultChanged" />
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireMigrationService" disabled="@Disabled" /></td>
                    <td>@Field("MigrationService")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasMigrationServiceDefault" disabled="@(Disabled || !Profile.RequireMigrationService)" @onchange="ToggleMigrationServiceDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireMigrationService)" value="@FormatGuid(Profile.DefaultMigrationServiceId)" @onchange="OnMigrationServiceChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.MigrationServices) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireStartDate" disabled="@Disabled" /></td>
                    <td>@Field("StartDate")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindDate")</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireEndDate" disabled="@Disabled" /></td>
                    <td>@Field("EndDate")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindDate")</span></td>
                    <td>—</td><td>—</td>
                </tr>
                @if (ShowFromToRegionCityBlock)
                {
                <tr>
                    <td><input type="checkbox" checked="true" disabled="true" /></td>
                    <td>@Field("FromRegion")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasFromRegionDefault" disabled="@Disabled" @onchange="ToggleFromRegionDefault" /></td>
                    <td>
                        <select disabled="@Disabled" value="@FormatGuid(Profile.DefaultFromRegionId)" @onchange="OnFromRegionChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.Regions) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" checked="true" disabled="true" /></td>
                    <td>@Field("FromCity")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasFromCityDefault" disabled="@Disabled" @onchange="ToggleFromCityDefault" /></td>
                    <td>
                        <select disabled="@Disabled" value="@FormatGuid(Profile.DefaultFromCityId)" @onchange="OnFromCityChanged">
                            <option value="">—</option>
                            @foreach (var item in FromCityOptions) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" checked="true" disabled="true" /></td>
                    <td>@Field("ToRegion")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasToRegionDefault" disabled="@Disabled" @onchange="ToggleToRegionDefault" /></td>
                    <td>
                        <select disabled="@Disabled" value="@FormatGuid(Profile.DefaultToRegionId)" @onchange="OnToRegionChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.Regions) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" checked="true" disabled="true" /></td>
                    <td>@Field("ToCity")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasToCityDefault" disabled="@Disabled" @onchange="ToggleToCityDefault" /></td>
                    <td>
                        <select disabled="@Disabled" value="@FormatGuid(Profile.DefaultToCityId)" @onchange="OnToCityChanged">
                            <option value="">—</option>
                            @foreach (var item in ToCityOptions) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                }
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireBusinessTripAddress" disabled="@Disabled" /></td>
                    <td>@Field("BusinessTripAddress")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindTypeSite")</span></td>
                    <td><input type="checkbox" checked="@HasBusinessTripAddressDefault" disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" @onchange="ToggleBusinessTripAddressDefault" /></td>
                    <td>
                        <div class="ap-wizard__stacked">
                            <select disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" value="@FormatResidenceType(Profile.DefaultBusinessTripAddressType)" @onchange="OnBusinessTripAddressTypeChanged">
                                <option value="">@Msg("ApplicationProfile.Site.TypePlaceholder")</option>
                                <option value="@((int)ResidenceType.Lodging)">@Msg("ApplicationProfile.Site.Lodging")</option>
                                <option value="@((int)ResidenceType.Hotel)">@Msg("ApplicationProfile.Site.Hotel")</option>
                                <option value="@((int)ResidenceType.Hospital)">@Msg("ApplicationProfile.Site.Hospital")</option>
                                <option value="@((int)ResidenceType.Other)">@Msg("ApplicationProfile.Site.Other")</option>
                                <option value="@((int)ResidenceType.PrivateHouse)">@Msg("ApplicationProfile.Site.PrivateHouse")</option>
                            </select>
                            @if (Profile.DefaultBusinessTripAddressType == ResidenceType.Lodging)
                            {
                                <select disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" value="@FormatGuid(Profile.DefaultBusinessTripLodgingId)" @onchange="OnBusinessTripLodgingChanged">
                                    <option value="">@Msg("ApplicationProfile.Site.LodgingPlaceholder")</option>
                                    @foreach (var item in Lookups.Lodgings) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                                </select>
                            }
                            else if (Profile.DefaultBusinessTripAddressType == ResidenceType.Hotel)
                            {
                                <select disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" value="@FormatGuid(Profile.DefaultBusinessTripHotelId)" @onchange="OnBusinessTripHotelChanged">
                                    <option value="">@Msg("ApplicationProfile.Site.HotelPlaceholder")</option>
                                    @foreach (var item in Lookups.Hotels) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                                </select>
                            }
                            else if (Profile.DefaultBusinessTripAddressType == ResidenceType.Hospital)
                            {
                                <select disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" value="@FormatGuid(Profile.DefaultBusinessTripHospitalId)" @onchange="OnBusinessTripHospitalChanged">
                                    <option value="">@Msg("ApplicationProfile.Site.HospitalPlaceholder")</option>
                                    @foreach (var item in Lookups.Hospitals) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                                </select>
                            }
                            else if (Profile.DefaultBusinessTripAddressType == ResidenceType.Other)
                            {
                                <select disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" value="@FormatGuid(Profile.DefaultBusinessTripOtherSiteId)" @onchange="OnBusinessTripOtherSiteChanged">
                                    <option value="">@Msg("ApplicationProfile.Site.OtherPlaceholder")</option>
                                    @foreach (var item in Lookups.OtherSites) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                                </select>
                            }
                            else if (Profile.DefaultBusinessTripAddressType == ResidenceType.PrivateHouse)
                            {
                                <input type="text" maxlength="255" disabled="@(Disabled || !Profile.RequireBusinessTripAddress)" @bind="Profile.DefaultBusinessTripPrivateHouseAddress" />
                            }
                        </div>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequirePurpose" disabled="@Disabled" @bind:after="OnPurposeUseChanged" /></td>
                    <td>@Field("Purpose")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindText")</span></td>
                    <td><input type="checkbox" checked="@HasPurposeDefault" disabled="@(Disabled || !Profile.RequirePurpose)" @onchange="TogglePurposeDefault" /></td>
                    <td>
                        <textarea class="ap-wizard__textarea" maxlength="700" rows="3" disabled="@(Disabled || !Profile.RequirePurpose)" @bind="Profile.DefaultPurpose"></textarea>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireProject" disabled="@Disabled" /></td>
                    <td>@Field("Project")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasProjectDefault" disabled="@(Disabled || !Profile.RequireProject)" @onchange="ToggleProjectDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireProject)" value="@FormatGuid(Profile.DefaultProjectContractId)" @onchange="OnProjectChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.ProjectContracts) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                @if (Profile.ActionFamily != ApplicationProfileActionFamily.Registration)
                {
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireUrgency" disabled="@Disabled" /></td>
                    <td>@Field("Urgency")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasUrgencyDefault" disabled="@(Disabled || !Profile.RequireUrgency)" @onchange="ToggleUrgencyDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireUrgency)" value="@FormatGuid(Profile.DefaultUrgencyId)" @onchange="OnUrgencyChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.Urgencies) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
                }
                <tr>
                    <td><input type="checkbox"
                               @bind="Profile.RequireProcessNumber"
                               disabled="@(Disabled || ApplicationProfileConfigurationResolver.ProcessNumberUseLocked(Profile.ProduceInvitation, Profile.ProduceWorkPermit, Profile.ProduceVisa))" /></td>
                    <td>@Field("ProcessNumber")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindText")</span></td>
                    <td></td>
                    <td class="ap-wizard__hint">@Msg("ApplicationProfile.Wizard.ProcessNumberHint")</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireWorkPermitLocation" disabled="@(Disabled || Profile.ProduceWorkPermit)" @bind:after="OnWorkPermitLocationUseChanged" /></td>
                    <td>@Field("WorkPermitLocation")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindMulti")</span></td>
                    <td><input type="checkbox" checked="@HasWorkPermitLocationDefault" disabled="@(Disabled || !Profile.RequireWorkPermitLocation)" @onchange="ToggleWorkPermitLocationDefault" /></td>
                    <td>
                        <BorderZoneLocationField Value="@Profile.DefaultWorkPermitLocation"
                                                 EditorAlias="@CommaSeparatedMultiSelectEditorAliases.WorkPermittedLocation"
                                                 ReadOnly="@(Disabled || !Profile.RequireWorkPermitLocation || !HasWorkPermitLocationDefault)"
                                                 ObjectSpace="@ObjectSpace"
                                                 ValueChanged="@OnWorkPermitLocationDefaultChanged" />
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireEntryDate" disabled="@Disabled" /></td>
                    <td>@Field("EntryDate")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindDate")</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireEntryCheckPoint" disabled="@Disabled" /></td>
                    <td>@Field("EntryCheckPoint")</td><td><span class="ap-wizard__tag">@Msg("ApplicationProfile.Wizard.KindLookup")</span></td>
                    <td><input type="checkbox" checked="@HasCheckPointDefault" disabled="@(Disabled || !Profile.RequireEntryCheckPoint)" @onchange="ToggleCheckPointDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !Profile.RequireEntryCheckPoint)" value="@FormatGuid(Profile.DefaultEntryCheckPointId)" @onchange="OnCheckPointChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.CheckPoints) { <option value="@item.Id.ToString("D")">@item.DisplayName</option> }
                        </select>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ApplicationProfileWizardLookupData Lookups { get; set; } = new();
    [Parameter] public IObjectSpace? ObjectSpace { get; set; }

    protected override void OnParametersSet()
    {
        if (Profile == null)
            return;

        if (ApplicationProfileConfigurationResolver.RequireBorderZoneWhenProducingInvitationOrVisa(
            Profile.ProduceInvitation, Profile.ProduceVisa, Profile.RequireBorderZone))
            Profile.RequireBorderZone = true;

        if (ApplicationProfileConfigurationResolver.RequireWorkPermitLocationWhenProducingWorkPermit(
            Profile.ProduceWorkPermit, Profile.RequireWorkPermitLocation))
            Profile.RequireWorkPermitLocation = true;

        if (ApplicationProfileConfigurationResolver.RequireProcessNumberWhenProducingIssuedDocuments(
            Profile.ProduceInvitation, Profile.ProduceWorkPermit, Profile.ProduceVisa, Profile.RequireProcessNumber))
            Profile.RequireProcessNumber = true;

        if (ApplicationProfileConfigurationResolver.UsesFromToRegionCity(Profile))
        {
            Profile.RequireFromRegion = true;
            Profile.RequireFromCity = true;
            Profile.RequireToRegion = true;
            Profile.RequireToCity = true;
        }

        if (Profile.RequireBorderZone && string.IsNullOrWhiteSpace(Profile.DefaultBorderZoneLocation))
            Profile.DefaultBorderZoneLocation = BorderZoneSelectionHelper.NoneValue;
    }

    private bool ShowFromToRegionCityBlock =>
        ApplicationProfileConfigurationResolver.UsesFromToRegionCity(Profile);

    private bool HasVisaTypeDefault => Profile.DefaultVisaTypeId.HasValue;
    private bool HasVisaCategoryDefault => Profile.DefaultVisaCategoryId.HasValue;
    private bool HasVisaPeriodDefault => Profile.DefaultVisaPeriodId.HasValue;
    private bool HasBorderZoneDefault => !string.IsNullOrWhiteSpace(Profile.DefaultBorderZoneLocation);
    private bool HasMigrationServiceDefault => Profile.DefaultMigrationServiceId.HasValue;
    private bool HasProjectDefault => Profile.DefaultProjectContractId.HasValue;
    private bool HasUrgencyDefault => Profile.DefaultUrgencyId.HasValue;
    private bool HasCheckPointDefault => Profile.DefaultEntryCheckPointId.HasValue;
    private bool HasFromRegionDefault => Profile.DefaultFromRegionId.HasValue;
    private bool HasFromCityDefault => Profile.DefaultFromCityId.HasValue;
    private bool HasToRegionDefault => Profile.DefaultToRegionId.HasValue;
    private bool HasToCityDefault => Profile.DefaultToCityId.HasValue;
    private bool HasBusinessTripAddressDefault =>
        Profile.DefaultBusinessTripAddressType != null
        || Profile.DefaultBusinessTripLodgingId.HasValue
        || Profile.DefaultBusinessTripHotelId.HasValue
        || Profile.DefaultBusinessTripHospitalId.HasValue
        || Profile.DefaultBusinessTripOtherSiteId.HasValue
        || !string.IsNullOrWhiteSpace(Profile.DefaultBusinessTripPrivateHouseAddress);

    private bool HasPurposeDefault => !string.IsNullOrWhiteSpace(Profile.DefaultPurpose);
    private bool HasWorkPermitLocationDefault => Profile.DefaultWorkPermitLocation != null;

    private IEnumerable<ApplicationProfileWizardLookupItem> FromCityOptions
    {
        get
        {
            if (Profile.DefaultFromRegionId is Guid regionId && regionId != Guid.Empty)
                return ApplicationProfileWizardLookupData.CitiesForRegion(Lookups.Cities, Lookups.Regions, regionId);
            return Lookups.Cities;
        }
    }

    private IEnumerable<ApplicationProfileWizardLookupItem> ToCityOptions
    {
        get
        {
            if (Profile.DefaultToRegionId is Guid regionId && regionId != Guid.Empty)
                return ApplicationProfileWizardLookupData.CitiesForRegion(Lookups.Cities, Lookups.Regions, regionId);
            return Lookups.Cities;
        }
    }

    private static string FormatGuid(Guid? id) =>
        id.HasValue && id.Value != Guid.Empty ? id.Value.ToString("D") : string.Empty;

    private static bool ParseChecked(ChangeEventArgs e) =>
        e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private void ToggleVisaTypeDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireVisaType) return;
        if (!ParseChecked(e)) Profile.DefaultVisaType = null;
        else if (Profile.DefaultVisaType == null) Profile.DefaultVisaType = FirstLookup<VisaType>(Lookups.VisaTypes);
    }

    private void ToggleVisaCategoryDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireVisaCategory) return;
        if (!ParseChecked(e)) Profile.DefaultVisaCategory = null;
        else if (Profile.DefaultVisaCategory == null) Profile.DefaultVisaCategory = FirstLookup<VisaCategory>(Lookups.VisaCategories);
    }

    private void ToggleVisaPeriodDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireVisaPeriod) return;
        if (!ParseChecked(e)) Profile.DefaultVisaPeriod = null;
        else if (Profile.DefaultVisaPeriod == null) Profile.DefaultVisaPeriod = FirstLookup<VisaPeriod>(Lookups.VisaPeriods);
    }

    private void ToggleBorderZoneDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireBorderZone) return;
        if (!ParseChecked(e)) Profile.DefaultBorderZoneLocation = null;
        else if (string.IsNullOrWhiteSpace(Profile.DefaultBorderZoneLocation))
            Profile.DefaultBorderZoneLocation = BorderZoneSelectionHelper.NoneValue;
    }

    private Task OnBorderZoneDefaultChanged(string? value)
    {
        Profile.DefaultBorderZoneLocation = value;
        return Task.CompletedTask;
    }

    private void ToggleMigrationServiceDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireMigrationService) return;
        if (!ParseChecked(e)) Profile.DefaultMigrationService = null;
        else if (Profile.DefaultMigrationService == null) Profile.DefaultMigrationService = FirstLookup<MigrationService>(Lookups.MigrationServices);
    }

    private void ToggleProjectDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireProject) return;
        if (!ParseChecked(e)) Profile.DefaultProjectContract = null;
        else if (Profile.DefaultProjectContract == null) Profile.DefaultProjectContract = FirstLookup<ProjectContract>(Lookups.ProjectContracts);
    }

    private void ToggleUrgencyDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireUrgency) return;
        if (!ParseChecked(e)) Profile.DefaultUrgency = null;
        else if (Profile.DefaultUrgency == null) Profile.DefaultUrgency = FirstLookup<Urgency>(Lookups.Urgencies);
    }

    private void ToggleCheckPointDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireEntryCheckPoint) return;
        if (!ParseChecked(e)) Profile.DefaultEntryCheckPoint = null;
        else if (Profile.DefaultEntryCheckPoint == null) Profile.DefaultEntryCheckPoint = FirstLookup<CheckPoint>(Lookups.CheckPoints);
    }

    private void ToggleFromRegionDefault(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (!ParseChecked(e))
        {
            Profile.DefaultFromRegion = null;
            ClearFromCityIfRegionMismatch();
        }
        else if (Profile.DefaultFromRegion == null)
            Profile.DefaultFromRegion = FirstLookup<Region>(Lookups.Regions);
    }

    private void ToggleFromCityDefault(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (!ParseChecked(e)) Profile.DefaultFromCity = null;
        else if (Profile.DefaultFromCity == null)
            Profile.DefaultFromCity = FirstLookup<City>(FromCityOptions.ToList());
    }

    private void ToggleToRegionDefault(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (!ParseChecked(e))
        {
            Profile.DefaultToRegion = null;
            ClearToCityIfRegionMismatch();
        }
        else if (Profile.DefaultToRegion == null)
            Profile.DefaultToRegion = FirstLookup<Region>(Lookups.Regions);
    }

    private void ToggleToCityDefault(ChangeEventArgs e)
    {
        if (Disabled) return;
        if (!ParseChecked(e)) Profile.DefaultToCity = null;
        else if (Profile.DefaultToCity == null)
            Profile.DefaultToCity = FirstLookup<City>(ToCityOptions.ToList());
    }

    private void ToggleBusinessTripAddressDefault(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireBusinessTripAddress) return;
        if (!ParseChecked(e))
            ClearBusinessTripDestinationDefaults();
        else if (Profile.DefaultBusinessTripAddressType == null)
            Profile.DefaultBusinessTripAddressType = ResidenceType.Lodging;
    }

    private void ClearBusinessTripDestinationDefaults()
    {
        Profile.DefaultBusinessTripAddressType = null;
        Profile.DefaultBusinessTripLodging = null;
        Profile.DefaultBusinessTripHotel = null;
        Profile.DefaultBusinessTripHospital = null;
        Profile.DefaultBusinessTripOtherSite = null;
        Profile.DefaultBusinessTripPrivateHouseAddress = null;
#pragma warning disable CS0618
        Profile.DefaultBusinessTripAddress = null;
#pragma warning restore CS0618
    }

    private static string FormatResidenceType(ResidenceType? type) =>
        type.HasValue ? ((int)type.Value).ToString() : string.Empty;

    private void OnBusinessTripAddressTypeChanged(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireBusinessTripAddress) return;
        ClearBusinessTripSiteDefaultsOnly();
        if (int.TryParse(e.Value?.ToString(), out var value)
            && Enum.IsDefined(typeof(ResidenceType), value))
            Profile.DefaultBusinessTripAddressType = (ResidenceType)value;
        else
            Profile.DefaultBusinessTripAddressType = null;
    }

    private void ClearBusinessTripSiteDefaultsOnly()
    {
        Profile.DefaultBusinessTripLodging = null;
        Profile.DefaultBusinessTripHotel = null;
        Profile.DefaultBusinessTripHospital = null;
        Profile.DefaultBusinessTripOtherSite = null;
        Profile.DefaultBusinessTripPrivateHouseAddress = null;
    }

    private void OnBusinessTripLodgingChanged(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireBusinessTripAddress) return;
        Profile.DefaultBusinessTripLodging = ResolveLookup<Lodging>(e);
    }

    private void OnBusinessTripHotelChanged(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireBusinessTripAddress) return;
        Profile.DefaultBusinessTripHotel = ResolveLookup<Hotel>(e);
    }

    private void OnBusinessTripHospitalChanged(ChangeEventArgs e)
    {
        if (Disabled || !Profile.RequireBusinessTripAddress) return;
        Profile.DefaultBusinessTripHospital = ResolveLookup<Hospital>(e);
    }

