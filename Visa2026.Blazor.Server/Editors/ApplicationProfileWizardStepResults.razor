@using DevExpress.ExpressApp
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationProfileWizard

<div class="ap-wizard__panel-head">
    <h2>Results &amp; fields</h2>
    <p>What processing may produce or cancel, and which Application header fields are required.</p>
</div>
<div class="ap-wizard__panel-body">
    <div class="ap-wizard__section">
        <h3>May produce</h3>
        <div class="ap-wizard__choices">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceInvitation" disabled="@Disabled" /> Invitation</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceWorkPermit" disabled="@Disabled" /> Work permit</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceVisa" disabled="@Disabled" /> Visa</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceBorderZone" disabled="@Disabled" /> Border zone</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.ProduceWorkLocation" disabled="@Disabled" /> Work location</label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>May cancel existing</h3>
        <div class="ap-wizard__choices">
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelInvitations" disabled="@Disabled" /> Invitation(s)</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelWorkPermits" disabled="@Disabled" /> Work permit(s)</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelVisas" disabled="@Disabled" /> Visa(s)</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelBorderZonePermits" disabled="@Disabled" /> Border zone permit(s)</label>
            <label class="ap-wizard__choice"><input type="checkbox" @bind="Profile.CancelApplications" disabled="@Disabled" /> Application(s)</label>
        </div>
    </div>
    <div class="ap-wizard__section">
        <h3>Application properties required</h3>
        <p class="ap-wizard__hint">Per-Application values get defaults at create when set below.</p>
        <table class="ap-wizard__table">
            <thead>
                <tr>
                    <th>Use</th>
                    <th>Property</th>
                    <th>Kind</th>
                    <th>Has default</th>
                    <th>Default value</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireVisaType" disabled="@Disabled" /></td>
                    <td>Visa type</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasVisaTypeDefault" disabled="@Disabled" @onchange="ToggleVisaTypeDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasVisaTypeDefault)" value="@FormatGuid(Profile.DefaultVisaTypeId)" @onchange="OnVisaTypeChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.VisaTypes) { <option value="@item.ID">@item.LocalizedDisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireVisaCategory" disabled="@Disabled" /></td>
                    <td>Visa category</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasVisaCategoryDefault" disabled="@Disabled" @onchange="ToggleVisaCategoryDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasVisaCategoryDefault)" value="@FormatGuid(Profile.DefaultVisaCategoryId)" @onchange="OnVisaCategoryChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.VisaCategories) { <option value="@item.ID">@item.LocalizedDisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireVisaPeriod" disabled="@Disabled" /></td>
                    <td>Visa period</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasVisaPeriodDefault" disabled="@Disabled" @onchange="ToggleVisaPeriodDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasVisaPeriodDefault)" value="@FormatGuid(Profile.DefaultVisaPeriodId)" @onchange="OnVisaPeriodChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.VisaPeriods) { <option value="@item.ID">@item.LocalizedDisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireBorderZone" disabled="@Disabled" /></td>
                    <td>Border zone</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasBorderZoneDefault" disabled="@Disabled" @onchange="ToggleBorderZoneDefault" /></td>
                    <td><input type="text" disabled="@(Disabled || !HasBorderZoneDefault)" @bind="Profile.DefaultBorderZoneLocation" /></td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireMigrationService" disabled="@Disabled" /></td>
                    <td>Migration service</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasMigrationServiceDefault" disabled="@Disabled" @onchange="ToggleMigrationServiceDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasMigrationServiceDefault)" value="@FormatGuid(Profile.DefaultMigrationServiceId)" @onchange="OnMigrationServiceChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.MigrationServices) { <option value="@item.ID">@item.LocalizedDisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireStartDate" disabled="@Disabled" /></td>
                    <td>Start date</td><td><span class="ap-wizard__tag">date</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireEndDate" disabled="@Disabled" /></td>
                    <td>End date</td><td><span class="ap-wizard__tag">date</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireRegionCity" disabled="@Disabled" /></td>
                    <td>Region (city)</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireBusinessTripAddress" disabled="@Disabled" /></td>
                    <td>Business trip address</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireProject" disabled="@Disabled" /></td>
                    <td>Project</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasProjectDefault" disabled="@Disabled" @onchange="ToggleProjectDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasProjectDefault)" value="@FormatGuid(Profile.DefaultProjectContractId)" @onchange="OnProjectChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.ProjectContracts) { <option value="@item.ID">@item.NameTm</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireUrgency" disabled="@Disabled" /></td>
                    <td>Urgency</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasUrgencyDefault" disabled="@Disabled" @onchange="ToggleUrgencyDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasUrgencyDefault)" value="@FormatGuid(Profile.DefaultUrgencyId)" @onchange="OnUrgencyChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.Urgencies) { <option value="@item.ID">@item.LocalizedDisplayName</option> }
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireWorkPermitLocation" disabled="@Disabled" /></td>
                    <td>Work permit location</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireEntryDate" disabled="@Disabled" /></td>
                    <td>Entry date</td><td><span class="ap-wizard__tag">date</span></td>
                    <td>—</td><td>—</td>
                </tr>
                <tr>
                    <td><input type="checkbox" @bind="Profile.RequireEntryCheckPoint" disabled="@Disabled" /></td>
                    <td>Entry check point</td><td><span class="ap-wizard__tag">lookup</span></td>
                    <td><input type="checkbox" checked="@HasCheckPointDefault" disabled="@Disabled" @onchange="ToggleCheckPointDefault" /></td>
                    <td>
                        <select disabled="@(Disabled || !HasCheckPointDefault)" value="@FormatGuid(Profile.DefaultEntryCheckPointId)" @onchange="OnCheckPointChanged">
                            <option value="">—</option>
                            @foreach (var item in Lookups.CheckPoints) { <option value="@item.ID">@item.LocalizedDisplayName</option> }
                        </select>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="ap-wizard__section">
        <h3>Application signatory</h3>
        <p class="ap-wizard__hint">Defaults at Application create; officers may change per Application.</p>
        <div class="ap-wizard__grid">
            <label class="ap-wizard__field">
                <span>Authorized signatory</span>
                <select disabled="@Disabled" value="@FormatGuid(Profile.DefaultAuthorizedSignatoryId)" @onchange="OnSignatoryChanged">
                    <option value="">—</option>
                    @foreach (var item in Lookups.AuthorizedSignatories) { <option value="@item.ID">@item.FullName</option> }
                </select>
            </label>
            <label class="ap-wizard__field">
                <span>Visa representative</span>
                <select disabled="@Disabled" value="@FormatGuid(Profile.DefaultVisaRepresentativeId)" @onchange="OnRepresentativeChanged">
                    <option value="">—</option>
                    @foreach (var item in Lookups.VisaRepresentatives) { <option value="@item.ID">@item.FullName</option> }
                </select>
            </label>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApplicationProfile Profile { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ApplicationProfileWizardLookupData Lookups { get; set; } = new();
    [Parameter] public IObjectSpace? ObjectSpace { get; set; }

    private bool HasVisaTypeDefault => Profile.DefaultVisaTypeId.HasValue;
    private bool HasVisaCategoryDefault => Profile.DefaultVisaCategoryId.HasValue;
    private bool HasVisaPeriodDefault => Profile.DefaultVisaPeriodId.HasValue;
    private bool HasBorderZoneDefault => !string.IsNullOrWhiteSpace(Profile.DefaultBorderZoneLocation);
    private bool HasMigrationServiceDefault => Profile.DefaultMigrationServiceId.HasValue;
    private bool HasProjectDefault => Profile.DefaultProjectContractId.HasValue;
    private bool HasUrgencyDefault => Profile.DefaultUrgencyId.HasValue;
    private bool HasCheckPointDefault => Profile.DefaultEntryCheckPointId.HasValue;

    private static string FormatGuid(Guid? id) => id.HasValue && id.Value != Guid.Empty ? id.Value.ToString() : string.Empty;

    private static bool ParseChecked(ChangeEventArgs e) =>
        e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private void ToggleVisaTypeDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultVisaType = null; else if (Profile.DefaultVisaType == null && Lookups.VisaTypes.Count > 0) Profile.DefaultVisaType = Lookups.VisaTypes[0]; }
    private void ToggleVisaCategoryDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultVisaCategory = null; else if (Profile.DefaultVisaCategory == null && Lookups.VisaCategories.Count > 0) Profile.DefaultVisaCategory = Lookups.VisaCategories[0]; }
    private void ToggleVisaPeriodDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultVisaPeriod = null; else if (Profile.DefaultVisaPeriod == null && Lookups.VisaPeriods.Count > 0) Profile.DefaultVisaPeriod = Lookups.VisaPeriods[0]; }
    private void ToggleBorderZoneDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultBorderZoneLocation = null; }
    private void ToggleMigrationServiceDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultMigrationService = null; else if (Profile.DefaultMigrationService == null && Lookups.MigrationServices.Count > 0) Profile.DefaultMigrationService = Lookups.MigrationServices[0]; }
    private void ToggleProjectDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultProjectContract = null; else if (Profile.DefaultProjectContract == null && Lookups.ProjectContracts.Count > 0) Profile.DefaultProjectContract = Lookups.ProjectContracts[0]; }
    private void ToggleUrgencyDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultUrgency = null; else if (Profile.DefaultUrgency == null && Lookups.Urgencies.Count > 0) Profile.DefaultUrgency = Lookups.Urgencies[0]; }
    private void ToggleCheckPointDefault(ChangeEventArgs e) { if (!ParseChecked(e)) Profile.DefaultEntryCheckPoint = null; else if (Profile.DefaultEntryCheckPoint == null && Lookups.CheckPoints.Count > 0) Profile.DefaultEntryCheckPoint = Lookups.CheckPoints[0]; }

    private void OnVisaTypeChanged(ChangeEventArgs e) => Profile.DefaultVisaType = ResolveLookup<VisaType>(e);
    private void OnVisaCategoryChanged(ChangeEventArgs e) => Profile.DefaultVisaCategory = ResolveLookup<VisaCategory>(e);
    private void OnVisaPeriodChanged(ChangeEventArgs e) => Profile.DefaultVisaPeriod = ResolveLookup<VisaPeriod>(e);
    private void OnMigrationServiceChanged(ChangeEventArgs e) => Profile.DefaultMigrationService = ResolveLookup<MigrationService>(e);
    private void OnProjectChanged(ChangeEventArgs e) => Profile.DefaultProjectContract = ResolveLookup<ProjectContract>(e);
    private void OnUrgencyChanged(ChangeEventArgs e) => Profile.DefaultUrgency = ResolveLookup<Urgency>(e);
    private void OnCheckPointChanged(ChangeEventArgs e) => Profile.DefaultEntryCheckPoint = ResolveLookup<CheckPoint>(e);
    private void OnSignatoryChanged(ChangeEventArgs e) => Profile.DefaultAuthorizedSignatory = ResolveLookup<AuthorizedSignatory>(e);
    private void OnRepresentativeChanged(ChangeEventArgs e) => Profile.DefaultVisaRepresentative = ResolveLookup<AuthorizedRepresentative>(e);

    private T? ResolveLookup<T>(ChangeEventArgs e) where T : class
    {
        if (ObjectSpace == null || !Guid.TryParse(e.Value?.ToString(), out var id) || id == Guid.Empty)
            return null;

        return ObjectSpace.GetObjectByKey<T>(id);
    }
}
