    private void OnFromRegionChanged(ChangeEventArgs e)
    {
        if (Disabled) return;
        Profile.DefaultFromRegion = ResolveLookup<Region>(e);
        ClearFromCityIfRegionMismatch();
    }

    private void OnFromCityChanged(ChangeEventArgs e)
    {
        if (Disabled) return;
        Profile.DefaultFromCity = ResolveLookup<City>(e);
        if (Profile.DefaultFromCity?.Region != null)
            Profile.DefaultFromRegion = Profile.DefaultFromCity.Region;
    }

    private void OnToRegionChanged(ChangeEventArgs e)
    {
        if (Disabled) return;
        Profile.DefaultToRegion = ResolveLookup<Region>(e);
        ClearToCityIfRegionMismatch();
    }

    private void OnToCityChanged(ChangeEventArgs e)
    {
        if (Disabled) return;
        Profile.DefaultToCity = ResolveLookup<City>(e);
        if (Profile.DefaultToCity?.Region != null)
            Profile.DefaultToRegion = Profile.DefaultToCity.Region;
    }

    private void ClearFromCityIfRegionMismatch()
    {
        if (Profile.DefaultFromCity == null)
            return;
        if (Profile.DefaultFromRegionId is not Guid regionId || regionId == Guid.Empty)
            return;
        if (Profile.DefaultFromCity.Region?.ID != regionId)
            Profile.DefaultFromCity = null;
    }

    private void ClearToCityIfRegionMismatch()
    {
        if (Profile.DefaultToCity == null)
            return;
        if (Profile.DefaultToRegionId is not Guid regionId || regionId == Guid.Empty)
            return;
        if (Profile.DefaultToCity.Region?.ID != regionId)
            Profile.DefaultToCity = null;
    }

    private T? FirstLookup<T>(IReadOnlyList<ApplicationProfileWizardLookupItem> items) where T : class =>
        items.Count > 0 ? ResolveById<T>(items[0].Id) : null;

    private T? ResolveLookup<T>(ChangeEventArgs e) where T : class =>
        Guid.TryParse(e.Value?.ToString(), out var id) ? ResolveById<T>(id) : null;

    private T? ResolveById<T>(Guid id) where T : class
    {
        if (ObjectSpace == null || id == Guid.Empty)
            return null;

        return ObjectSpace.GetObjectByKey<T>(id);
    }

    private static string Msg(string key) => VisaUiMessages.Get(key);

    private static string Field(string fieldKey) => ApplicationProfileLocalization.Field(fieldKey);
}
