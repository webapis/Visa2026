@using Visa2026.Module.Services.ApplicationPersonLink

@if (IsOpen)
{
    <section class="os-person-link-picker @(IsBusyLinking ? "is-linking" : null)" aria-label="Link existing person" aria-busy="@(IsBusyLinking ? "true" : "false")">
        <header class="os-person-link-picker__head">
            <div>
                <h3 class="os-person-link-picker__title">Link existing person</h3>
                <p class="os-person-link-picker__sub">Search by name, personal number, or passport number.</p>
            </div>
            <button type="button" class="os-btn os-btn--ghost" disabled="@IsBusy" @onclick="CloseAsync">Cancel</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="os-banner @(IsStatusError ? "os-banner--warn" : "os-banner--ok")" style="margin-bottom:10px">@StatusMessage</div>
        }

        <div class="os-person-link-picker__search">
            <input type="search"
                   class="os-input"
                   placeholder="Search people…"
                   value="@_searchText"
                   @oninput="OnSearchInput"
                   @onkeydown="OnSearchKeyDown"
                   disabled="@IsBusy" />
            <button type="button" class="os-btn" disabled="@IsBusy" @onclick="SearchAsync">Search</button>
        </div>

        @if (IsSearching)
        {
            <div class="os-person-link-picker__loading" role="status">Searching…</div>
        }
        else if (Candidates.Count == 0)
        {
            <p class="os-empty">No matching people found. Try another search or create the person first.</p>
        }
        else
        {
            <ul class="os-person-link-picker__list" role="list">
                @foreach (var row in Candidates)
                {
                    var isThisLinking = IsBusyLinking && row.PersonId == _linkingPersonId;
                    var linkDisabled = IsBusy || !row.CanLink;
                    <li class="os-person-link-picker__item @(isThisLinking ? "is-linking" : null) @(!row.CanLink ? "is-blocked" : null)">
                        <div class="os-person-link-picker__avatar" aria-hidden="true">@Initials(row.FullName)</div>
                        <div class="os-person-link-picker__body">
                            <strong>@row.FullName</strong>
                            <span class="os-person-link-picker__meta">
                                @row.RoleLabel · @row.PersonalNumber · Passport @row.PassportNumber
                            </span>
                            @if (!row.CanLink && !string.IsNullOrWhiteSpace(row.BlockReason))
                            {
                                <span class="os-person-link-picker__block">@row.BlockReason</span>
                            }
                        </div>
                        <button type="button"
                                class="os-btn os-btn--primary os-person-link-picker__link @(isThisLinking ? "is-busy" : null)"
                                disabled="@linkDisabled"
                                title="@(row.CanLink ? null : row.BlockReason)"
                                aria-busy="@(isThisLinking ? "true" : "false")"
                                @onclick="() => LinkAsync(row)">
                            @if (isThisLinking)
                            {
                                <span class="os-person-link-picker__spin" aria-hidden="true"></span>
                                <span>Linking…</span>
                            }
                            else
                            {
                                <span>Link</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        }

        @if (IsBusyLinking)
        {
            <div class="os-person-link-picker__busy" role="status" aria-live="polite">
                <div class="os-person-link-picker__busy-panel">
                    <p class="os-person-link-picker__busy-label">Linking @LinkingPersonName…</p>
                    <div class="os-person-link-picker__busy-track" role="progressbar" aria-label="Linking person">
                        <div class="os-person-link-picker__busy-fill"></div>
                    </div>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public IReadOnlyList<ApplicationProfileInstancePersonLinkCandidateRow> Candidates { get; set; } = Array.Empty<ApplicationProfileInstancePersonLinkCandidateRow>();
    [Parameter] public bool IsSearching { get; set; }
    [Parameter] public bool IsLinking { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public EventCallback<string> SearchRequested { get; set; }
    [Parameter] public EventCallback<Guid> LinkRequested { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    private string _searchText = string.Empty;
    private Guid _linkingPersonId;

    private bool IsBusyLinking => IsLinking || _linkingPersonId != Guid.Empty;
    private bool IsBusy => IsSearching || IsBusyLinking;

    private string LinkingPersonName
    {
        get
        {
            foreach (var row in Candidates)
            {
                if (row.PersonId == _linkingPersonId && !string.IsNullOrWhiteSpace(row.FullName))
                    return row.FullName;
            }

            return "person";
        }
    }

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _searchText = string.Empty;
            _linkingPersonId = Guid.Empty;
        }
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private Task SearchAsync() => SearchRequested.InvokeAsync(_searchText);

    private async Task LinkAsync(ApplicationProfileInstancePersonLinkCandidateRow row)
    {
        if (IsBusy || row == null || !row.CanLink || row.PersonId == Guid.Empty)
            return;

        _linkingPersonId = row.PersonId;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(16);
        try
        {
            if (LinkRequested.HasDelegate)
                await LinkRequested.InvokeAsync(row.PersonId);
        }
        finally
        {
            _linkingPersonId = Guid.Empty;
        }
    }

    private Task CloseAsync() => CloseRequested.InvokeAsync();

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }
}
