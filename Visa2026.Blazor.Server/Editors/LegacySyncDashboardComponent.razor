@namespace Visa2026.Blazor.Server.Editors
@using Microsoft.Extensions.Options
@using Visa2026.Module.Localization
@using Visa2026.Module.Services.LegacySyncDashboard
@implements IAsyncDisposable
@inject ILegacySyncDashboardService DashboardService
@inject IOptions<LegacySyncDashboardOptions> DashboardOptions

<div class="legacy-sync-dashboard">
    <header class="legacy-sync-dashboard__header">
        <div class="legacy-sync-dashboard__header-text">
            <h2 class="legacy-sync-dashboard__title">@VisaUiMessages.Get("LegacySync.Title")</h2>
            <p class="legacy-sync-dashboard__subtitle">
                @VisaUiMessages.Get("LegacySync.Subtitle")
            </p>
        </div>
        <div class="legacy-sync-dashboard__actions">
            <a class="legacy-sync-dashboard__open"
               href="@LegacySyncDashboardPaths.DashboardHtml"
               target="_blank"
               rel="noopener">
                @VisaUiMessages.Get("LegacySync.OpenInNewTab")
            </a>
            <button type="button"
                    class="legacy-sync-dashboard__refresh @(_isRefreshing ? "legacy-sync-dashboard__refresh--busy" : null)"
                    disabled="@_isRefreshing"
                    @onclick="RefreshAsync">
                @(_isRefreshing ? VisaUiMessages.Get("LegacySync.Refreshing") : VisaUiMessages.Get("LegacySync.Refresh"))
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="legacy-sync-dashboard__alert" role="alert">@_errorMessage</div>
    }

    @if (string.IsNullOrWhiteSpace(_errorMessage))
    {
        <iframe class="legacy-sync-dashboard__frame"
                src="@_frameSource"
                title="@VisaUiMessages.Get("LegacySync.ReportFrameTitle")"
                loading="lazy"></iframe>
    }
</div>

@code {
    private string _errorMessage = "";
    private string _frameSource = LegacySyncDashboardPaths.DashboardHtml;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private bool _isRefreshing;
    private int _pollSeconds = 30;

    protected override async Task OnInitializedAsync()
    {
        _pollSeconds = Math.Max(10, DashboardOptions.Value.PollIntervalSeconds);
        await LoadAsync(regenerate: false);
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_pollSeconds));
        _ = PollLoopAsync(_cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        if (_timer == null)
            return;

        try
        {
            while (await _timer.WaitForNextTickAsync(token))
                await LoadAsync(regenerate: false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task RefreshAsync() => LoadAsync(regenerate: true);

    private async Task LoadAsync(bool regenerate)
    {
        _isRefreshing = true;
        try
        {
            if (regenerate)
            {
                var result = await Task.Run(() => DashboardService.RefreshSnapshot());
                if (!result.Success)
                {
                    _errorMessage = result.ErrorMessage ?? "Failed to refresh legacy sync dashboard.";
                    return;
                }
            }

            var snapshot = DashboardService.GetSnapshot();
            if (!snapshot.Enabled)
            {
                _errorMessage = snapshot.ErrorMessage ?? "Legacy sync dashboard is disabled.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(snapshot.ErrorMessage))
            {
                _errorMessage = snapshot.ErrorMessage;
                return;
            }

            _errorMessage = "";
            _frameSource = $"{LegacySyncDashboardPaths.DashboardHtml}?t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
        }
        finally
        {
            _isRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts != null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }

        _timer?.Dispose();
    }
}
