@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime Js

<div class="smtp-password-field">
    <input @ref="input"
           class="smtp-password-field__input"
           type="@(Revealed ? "text" : "password")"
           value="@Shown"
           placeholder="@Placeholder"
           autocomplete="new-password"
           spellcheck="false"
           aria-label="Password"
           title="@FieldTitle"
           @onfocus="OnFocus"
           @oninput="OnInput" />
    <button type="button"
            class="smtp-password-field__toggle"
            title="@ToggleTitle"
            aria-label="@ToggleTitle"
            aria-pressed="@Revealed"
            @onclick="ToggleReveal">
        @if (Revealed)
        {
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3.3 2.3 2 3.6l3.2 3.2A12.4 12.4 0 0 0 1.1 12S4.4 19 12 19a11 11 0 0 0 4.6-1l3.1 3.1 1.3-1.3L3.3 2.3zM12 17c-5.2 0-8.2-4.6-9.1-6 .4-.7 1.2-1.8 2.3-2.8l2.4 2.4A4 4 0 0 0 12 16a4 4 0 0 0 1.4-.3l1.6 1.6A9 9 0 0 1 12 17zm2.2-3.2-1.5-1.5a2 2 0 0 1-2.5-2.5L8.7 8.3A4 4 0 0 0 14.2 13.8zM12 7a5 5 0 0 1 5 5c0 .5-.1 1-.2 1.4l2.4 2.4A12 12 0 0 0 22.9 12S19.6 5 12 5c-1.1 0-2.1.2-3.1.5l1.8 1.8c.4-.2.9-.3 1.3-.3z" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 5c-7.6 0-10.9 7-10.9 7S4.4 19 12 19s10.9-7 10.9-7S19.6 5 12 5zm0 12c-5.2 0-8.2-4.6-9.1-6C3.8 9.6 6.8 7 12 7s8.2 2.6 9.1 4c-.9 1.4-3.9 6-9.1 6zm0-9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
            </svg>
        }
    </button>
</div>

@code {
    private ElementReference input;

    [Parameter] public string Text { get; set; } = string.Empty;

    [Parameter] public string SavedPassword { get; set; } = string.Empty;

    [Parameter] public bool HasSavedPassword { get; set; }

    [Parameter] public bool Editing { get; set; }

    [Parameter] public bool Revealed { get; set; }

    [Parameter] public EventCallback<string> TextChanged { get; set; }

    [Parameter] public EventCallback ToggleReveal { get; set; }

    private string Shown =>
        Editing ? Text
        : Revealed ? SavedPassword
        : string.Empty;

    private string Placeholder =>
        HasSavedPassword && !Editing && !Revealed ? "••••••••" : "Type a password";

    private string FieldTitle =>
        HasSavedPassword
            ? "Click and type a new password. Save replaces the saved one."
            : "Type the mailbox password";

    private string ToggleTitle => Revealed ? "Hide password" : "Show password";

    private async Task OnFocus()
    {
        if (!Revealed || Editing || string.IsNullOrEmpty(SavedPassword))
            return;

        await Js.InvokeVoidAsync("eval", "document.activeElement && document.activeElement.select && document.activeElement.select()");
    }

    private Task OnInput(ChangeEventArgs e) =>
        TextChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
