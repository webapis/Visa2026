@using DevExpress.ExpressApp
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Services.ApplicationProfileWizard

<div class="ap-wizard">
    @if (IsLoading)
    {
        <div class="ap-wizard__loading" role="status">Loading configuration wizard…</div>
    }
    else if (Profile == null)
    {
        <div class="ap-wizard__loading ap-wizard__loading--empty">No Application Profile selected.</div>
    }
    else
    {
        <header class="ap-wizard__header">
            <div>
                <h1 class="ap-wizard__title">Application Profile</h1>
                <p class="ap-wizard__sub">
                    Configure what applications using this profile need — live FK; per-ApplicationProfileInstance values get defaults at create.
                </p>
            </div>
            <div class="ap-wizard__pills">
                <span class="ap-wizard__pill ap-wizard__pill--on">Live configuration</span>
                @if (IsReadOnly)
                {
                    <span class="ap-wizard__pill ap-wizard__pill--warn">Config locked</span>
                }
                else
                {
                    <span class="ap-wizard__pill">Draft · save to publish</span>
                }
            </div>
        </header>

        @if (IsReadOnly)
        {
            <div class="ap-wizard__lock-banner">
                This profile is <strong>config-locked</strong> because a linked application has left office preparation.
                <strong>Approval leg versions</strong> can still be added or edited — already-started applications keep their snapshot.
                Other configuration stays locked. Use <strong>Clone</strong> on the profile list to copy the rest of the profile.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="ap-wizard__status @(IsStatusError ? "is-error" : "is-ok")" role="status">@StatusMessage</div>
        }

        <div class="ap-wizard__layout">
            <nav class="ap-wizard__steps" aria-label="Wizard steps">
                <h2>Steps</h2>
                @for (var i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    <button type="button"
                            class="ap-wizard__step @(i == _activeStep ? "is-active" : null)"
                            @onclick="() => GoToStep(i)">
                        <span class="ap-wizard__step-n">@(i + 1)</span>
                        <span>
                            <span class="ap-wizard__step-t">@step.Title</span>
                            <span class="ap-wizard__step-d">@step.Description</span>
                        </span>
                    </button>
                }
            </nav>

            <div class="ap-wizard__panel">
                @if (_activeStep == 0)
                {
                    <ApplicationProfileWizardStepIdentity Profile="Profile"
                        Disabled="IsReadOnly"
                        Ministries="Ministries"
                        OnAddVersion="AddVersionCallback"
                        OnRemoveVersion="RemoveVersionCallback"
                        OnDuplicateVersion="DuplicateVersionCallback"
                        OnSetDefaultVersion="SetDefaultVersionCallback"
                        OnAddLeg="AddLegCallback"
                        OnRemoveLeg="RemoveLegCallback"
                        ClearLegsRequested="ClearLegsCallback" />
                }
                else if (_activeStep == 1)
                {
                    <ApplicationProfileWizardStepCompanySignatories Snapshot="OrganizationSnapshot"
                        OpenCompanyRequested="OpenCompanyRequested"
                        OpenSignatoryRequested="OpenSignatoryRequested"
                        OpenRepresentativeRequested="OpenRepresentativeRequested"
                        RefreshRequested="RefreshOrganizationRequested" />
                }
                else if (_activeStep == 2)
                {
                    <ApplicationProfileWizardStepResults Profile="Profile"
                        Disabled="IsReadOnly"
                        Lookups="Lookups"
                        ObjectSpace="ObjectSpace" />
                }
                else if (_activeStep == 3)
                {
                    <ApplicationProfileWizardStepProcess Profile="Profile" Disabled="IsReadOnly" />
                }
                else if (_activeStep == 4)
                {
                    <ApplicationProfileWizardStepTemplatesPerson Profile="Profile"
                        Disabled="IsReadOnly"
                        ObjectSpace="ObjectSpace"
                        OwnerViewId="OwnerViewId"
                        Lookups="Lookups"
                        OnAddTemplate="AddTemplateCallback"
                        OnRemoveTemplate="RemoveTemplateCallback"
                        OnCreateTemplate="CreateTemplateCallback" />
                }
                else
                {
                    <ApplicationProfileWizardStepReview Profile="Profile"
                        Organization="OrganizationSnapshot" />
                }

                <div class="ap-wizard__foot">
                    <button type="button" class="ap-wizard__btn ap-wizard__btn--secondary"
                            disabled="@(_activeStep == 0)"
                            @onclick="PreviousStep">← Back</button>
                    <div class="ap-wizard__foot-right">
                        @if (_activeStep < _steps.Length - 1)
                        {
                            <button type="button" class="ap-wizard__btn ap-wizard__btn--primary" @onclick="NextStep">Continue →</button>
                        }
                        else if (!IsReadOnly || CanSaveLockedVersions)
                        {
                            <button type="button" class="ap-wizard__btn ap-wizard__btn--primary" @onclick="PublishAsync">Save profile</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly (string Title, string Description)[] _steps =
    [
        ("Identity & purpose", "Name, route, legs, audience"),
        ("Company, Signatories", "Letterhead, signatory, representative"),
        ("Results & fields", "Required instance properties"),
        ("Process & SLA", "Ministry and migration duration"),
        ("Templates & person", "Reports + person data"),
        ("Review & save", "Summary before publish"),
    ];

    [Parameter] public ApplicationProfile? Profile { get; set; }
    [Parameter] public IObjectSpace? ObjectSpace { get; set; }
    [Parameter] public string? OwnerViewId { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public EventCallback InitialLoadRequested { get; set; }
    [Parameter] public EventCallback PublishRequested { get; set; }
    [Parameter] public ApplicationProfileWizardOrganizationSnapshot OrganizationSnapshot { get; set; } =
        ApplicationProfileWizardOrganizationSnapshot.Empty;
    [Parameter] public EventCallback OpenCompanyRequested { get; set; }
    [Parameter] public EventCallback OpenSignatoryRequested { get; set; }
    [Parameter] public EventCallback OpenRepresentativeRequested { get; set; }
    [Parameter] public EventCallback RefreshOrganizationRequested { get; set; }
    [Parameter] public ApplicationProfileWizardLookupData Lookups { get; set; } =
        ApplicationProfileWizardLookupData.Empty;

    private int _activeStep;
    private IReadOnlyList<ApprovingMinistry> _ministries = Array.Empty<ApprovingMinistry>();

    private IReadOnlyList<ApprovingMinistry> Ministries => _ministries;

    private bool CanSaveLockedVersions =>
        IsReadOnly
        && Profile?.ProgressRoute == ApplicationProfileInstanceProgressRouteKind.ViaMinistries;

    private EventCallback AddVersionCallback => EventCallback.Factory.Create(this, AddVersion);
    private EventCallback<ApplicationProfileApprovalLegVersion> RemoveVersionCallback =>
        EventCallback.Factory.Create<ApplicationProfileApprovalLegVersion>(this, RemoveVersion);
    private EventCallback<ApplicationProfileApprovalLegVersion> DuplicateVersionCallback =>
        EventCallback.Factory.Create<ApplicationProfileApprovalLegVersion>(this, DuplicateVersion);
    private EventCallback<ApplicationProfileApprovalLegVersion> SetDefaultVersionCallback =>
        EventCallback.Factory.Create<ApplicationProfileApprovalLegVersion>(this, SetDefaultVersion);
    private EventCallback<(Guid VersionId, Guid MinistryId)> AddLegCallback =>
        EventCallback.Factory.Create<(Guid, Guid)>(this, AddLeg);
    private EventCallback<ApplicationProfileApprovalLeg> RemoveLegCallback =>
        EventCallback.Factory.Create<ApplicationProfileApprovalLeg>(this, RemoveLeg);
    private EventCallback ClearLegsCallback => EventCallback.Factory.Create(this, ClearLegs);

    private EventCallback AddTemplateCallback => EventCallback.Factory.Create(this, AddTemplate);

    private EventCallback<ApplicationProfileTemplate> RemoveTemplateCallback =>
        EventCallback.Factory.Create<ApplicationProfileTemplate>(this, RemoveTemplate);

    private EventCallback<(string Name, ApplicationProfileTemplateKind Kind, int SortOrder, byte[]? FileBytes, string? FileName, ApplicationProfileTemplateCatalogScope CatalogScope, ApplicationProfileTemplateDataScope DataScope, string? CategoryKey)> CreateTemplateCallback =>
        EventCallback.Factory.Create<(string, ApplicationProfileTemplateKind, int, byte[]?, string?, ApplicationProfileTemplateCatalogScope, ApplicationProfileTemplateDataScope, string?)>(this, CreateTemplate);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialLoadRequested.HasDelegate)
            await InitialLoadRequested.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        if (Profile == null || ObjectSpace == null)
            return;

        if (_ministries.Count == 0)
        {
            _ministries = ObjectSpace.GetObjectsQuery<ApprovingMinistry>()
                .OrderBy(m => m.NameTm)
                .ToList();
        }
    }

    private async Task GoToStep(int index)
    {
        _activeStep = Math.Clamp(index, 0, _steps.Length - 1);
        if (RefreshOrganizationRequested.HasDelegate)
            await RefreshOrganizationRequested.InvokeAsync();
    }

    private Task NextStep() => GoToStep(_activeStep + 1);
    private Task PreviousStep() => GoToStep(_activeStep - 1);

    private async Task PublishAsync()
    {
        if (PublishRequested.HasDelegate)
            await PublishRequested.InvokeAsync();
    }

    private void AddVersion()
    {
        if (Profile == null || ObjectSpace is not { } os)
            return;

        if (Profile.ProgressRoute != ApplicationProfileInstanceProgressRouteKind.ViaMinistries)
            return;

        var version = os.CreateObject<ApplicationProfileApprovalLegVersion>();
        version.ApplicationProfile = Profile;
        version.Sequence = (Profile.ApprovalLegVersions?.Count ?? 0) + 1;
        version.Name = version.Sequence == 1
            ? ApplicationProfileApprovalLegVersionHelper.DefaultVersionName
            : $"Version {version.Sequence}";
        version.IsDefault = (Profile.ApprovalLegVersions?.Count ?? 0) == 0;
        if (Profile.ApprovalLegVersions != null && !Profile.ApprovalLegVersions.Contains(version))
            Profile.ApprovalLegVersions.Add(version);

        ApplicationProfileApprovalLegVersionHelper.EnsureSingleDefault(Profile, version.IsDefault ? version : null);
        ApplicationProfileApprovalLegVersionHelper.RenumberVersions(Profile);
    }

    private void RemoveVersion(ApplicationProfileApprovalLegVersion version)
    {
        if (ObjectSpace is not { } os || version == null)
            return;

        if (IsReadOnly && !ApplicationProfileLockHelper.CanRemoveApprovalLegVersion(Profile, version))
            return;

        os.Delete(version);
        ApplicationProfileApprovalLegVersionHelper.EnsureSingleDefault(Profile);
        ApplicationProfileApprovalLegVersionHelper.RenumberVersions(Profile);
    }

    private void DuplicateVersion(ApplicationProfileApprovalLegVersion source)
    {
        if (Profile == null || ObjectSpace is not { } os || source == null)
            return;

        var copy = os.CreateObject<ApplicationProfileApprovalLegVersion>();
        copy.ApplicationProfile = Profile;
        copy.Name = string.IsNullOrWhiteSpace(source.Name) ? "Version copy" : $"{source.Name} copy";
        copy.IsDefault = false;
        copy.Sequence = (Profile.ApprovalLegVersions?.Count ?? 0) + 1;
        if (Profile.ApprovalLegVersions != null && !Profile.ApprovalLegVersions.Contains(copy))
            Profile.ApprovalLegVersions.Add(copy);

        foreach (var leg in ApplicationProfileApprovalLegVersionHelper.GetOrderedLegs(source))
        {
            var cloned = os.CreateObject<ApplicationProfileApprovalLeg>();
            cloned.ApplicationProfile = Profile;
            cloned.ApprovalLegVersion = copy;
            cloned.ApprovingMinistry = leg.ApprovingMinistry;
            cloned.Sequence = (copy.Legs?.Count ?? 0) + 1;
            if (copy.Legs != null && !copy.Legs.Contains(cloned))
                copy.Legs.Add(cloned);
            if (Profile.ApprovalLegs != null && !Profile.ApprovalLegs.Contains(cloned))
                Profile.ApprovalLegs.Add(cloned);
        }

        ApplicationProfileApprovalLegVersionHelper.RenumberVersions(Profile);
    }

    private void SetDefaultVersion(ApplicationProfileApprovalLegVersion version)
    {
        if (Profile == null || version == null)
            return;

        ApplicationProfileApprovalLegVersionHelper.EnsureSingleDefault(Profile, version);
    }

    private void AddLeg((Guid VersionId, Guid MinistryId) args)
    {
        if (Profile == null || ObjectSpace is not { } os
            || args.VersionId == Guid.Empty || args.MinistryId == Guid.Empty)
            return;

        if (Profile.ProgressRoute != ApplicationProfileInstanceProgressRouteKind.ViaMinistries)
            return;

        var version = ApplicationProfileApprovalLegVersionHelper.FindVersion(Profile, args.VersionId);
        if (version == null)
            return;

        var ministry = os.GetObjectByKey<ApprovingMinistry>(args.MinistryId);
        if (ministry == null)
            return;

        var leg = os.CreateObject<ApplicationProfileApprovalLeg>();
        leg.ApplicationProfile = Profile;
        leg.ApprovalLegVersion = version;
        leg.ApprovingMinistry = ministry;
        leg.Sequence = (version.Legs?.Count ?? 0) + 1;
        if (version.Legs != null && !version.Legs.Contains(leg))
            version.Legs.Add(leg);
        if (Profile.ApprovalLegs != null && !Profile.ApprovalLegs.Contains(leg))
            Profile.ApprovalLegs.Add(leg);
    }

    private void ClearLegs()
    {
        if (IsReadOnly || Profile == null || ObjectSpace is not { } os)
            return;

        foreach (var version in (Profile.ApprovalLegVersions ?? []).ToList())
            os.Delete(version);
        foreach (var leg in (Profile.ApprovalLegs ?? []).ToList())
            os.Delete(leg);
    }

    private void RemoveLeg(ApplicationProfileApprovalLeg leg)
    {
        if (ObjectSpace is not { } os || leg == null)
            return;

        var version = leg.ApprovalLegVersion;
        os.Delete(leg);
        if (version != null)
            ApplicationProfileApprovalLegVersionHelper.RenumberLegs(version);
    }

    private void AddTemplate()
    {
        if (IsReadOnly || Profile == null || ObjectSpace is not { } os)
            return;

        var template = os.CreateObject<ApplicationProfileTemplate>();
        template.ApplicationProfile = Profile;
        template.TemplateName = "New template";
        template.SortOrder = (Profile.NestedTemplates?.Count ?? 0) + 1;
        if (Profile.NestedTemplates != null && !Profile.NestedTemplates.Contains(template))
            Profile.NestedTemplates.Add(template);
    }

    private void CreateTemplate((string Name, ApplicationProfileTemplateKind Kind, int SortOrder, byte[]? FileBytes, string? FileName, ApplicationProfileTemplateCatalogScope CatalogScope, ApplicationProfileTemplateDataScope DataScope, string? CategoryKey) args)
    {
        if (IsReadOnly || Profile == null || ObjectSpace is not { } os)
            return;

        var name = args.Name?.Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;

        var existing = Profile.NestedTemplates?
            .FirstOrDefault(t => string.Equals(t.TemplateName, name, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            existing.TemplateKind = args.Kind;
            existing.SortOrder = args.SortOrder;
            existing.CatalogScope = args.CatalogScope;
            existing.DataScope = args.DataScope;
            existing.CategoryKey = string.IsNullOrWhiteSpace(args.CategoryKey) ? existing.CategoryKey : args.CategoryKey.Trim();
            if (args.FileBytes is { Length: > 0 })
                AttachFile(os, existing, args.FileBytes, args.FileName ?? $"{name}.docx");
            return;
        }

        var template = os.CreateObject<ApplicationProfileTemplate>();
        template.ApplicationProfile = Profile;
        template.TemplateName = name;
        template.TemplateKind = args.Kind;
        template.SortOrder = args.SortOrder > 0 ? args.SortOrder : (Profile.NestedTemplates?.Count ?? 0) + 1;
        template.CatalogScope = args.CatalogScope;
        template.DataScope = args.DataScope;
        template.CategoryKey = string.IsNullOrWhiteSpace(args.CategoryKey) ? null : args.CategoryKey.Trim();
        if (Profile.NestedTemplates != null && !Profile.NestedTemplates.Contains(template))
            Profile.NestedTemplates.Add(template);
        if (args.FileBytes is { Length: > 0 })
            AttachFile(os, template, args.FileBytes, args.FileName ?? $"{name}.docx");
    }

    private static void AttachFile(
        IObjectSpace os,
        ApplicationProfileTemplate template,
        byte[] bytes,
        string fileName)
    {
        template.TemplateFile ??= os.CreateObject<DevExpress.Persistent.BaseImpl.EF.FileData>();
        template.TemplateFile.FileName = fileName;
        template.TemplateFile.Content = bytes;
    }

    private void RemoveTemplate(ApplicationProfileTemplate template)
    {
        if (IsReadOnly || ObjectSpace is not { } os || template == null)
            return;

        os.Delete(template);
    }
}
