@using System.Collections.Generic
@using System.Linq
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.BusinessObjects.ApplicationWorkspace
@using Visa2026.Module.BusinessObjects.OfficerShell
@using Visa2026.Module.Localization
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.PreviewSlot

<div class="ct-page">
    @if (!string.IsNullOrWhiteSpace(DisplayStatusMessage))
    {
        <div class="os-banner @(DisplayStatusIsError ? "os-banner--error" : "os-banner--ok")"
             style="margin-bottom:12px"
             role="@(DisplayStatusIsError ? "alert" : "status")">@DisplayStatusMessage</div>
    }

    <h2 class="ct-page__title">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Progress")</h2>
    <p class="ct-page__sub">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ProgressSubtitle", view.Chrome.TemplateFamilyLabel, LocalizedCurrentStepHeading)</p>
    @{
        var progressChips = ApplicationWorkspaceIssuedResultListCoverage.FromIssuedTiles(view.IssuedRecordTiles);
        var progressResultChips = ApplicationWorkspaceListProgressSteps.ShouldShowResultChips(view.ProgressSteps, progressChips)
            ? progressChips
            : Array.Empty<ApplicationWorkspaceIssuedResultListCoverage.Chip>();
    }
    <div class="ct-prog-v-list">
        @foreach (var step in view.ProgressSteps)
        {
            // Result dropdown is unsaved until Advance. Keep the current node blue + pen
            // (same as Office preparation), not Issued/Approved green tick.
            var isCurrent = string.Equals(step.State, "current", StringComparison.OrdinalIgnoreCase);
            var badge = StepBadge(step, isCurrent);
            var tone = isCurrent ? "current" : step.OutcomeKind;
            var badgeCls = tone switch
            {
                "issued" => "issued",
                "rejected" => "rejected",
                "cancelled" => "cancelled",
                "current" => "active",
                "pending" => "muted",
                _ => "ok",
            };
            var letterName = step.MinistryLetterFileName;
            var letterProgressId = step.ProgressId;
            var showResultBeside = progressResultChips.Count > 0
                && ApplicationWorkspaceListProgressSteps.IsResultChipAnchor(view.ProgressSteps, step);
            var icon = isCurrent
                ? "✎"
                : tone switch
                {
                    "rejected" => "✕",
                    "cancelled" => "–",
                    "issued" or "ok" => "✓",
                    _ => "○",
                };
            <div class="ct-prog-v ct-prog-v--@step.State ct-prog-v--tone-@tone @(IsMigrationStep(step) ? "ct-prog-v--migration" : null)">
                <div class="ct-prog-v__rail">
                    <span class="ct-prog-v__date">@(string.IsNullOrWhiteSpace(step.Date) ? "—" : step.Date)</span>
                    <span class="ct-prog-v__dot">@icon</span>
                    <span class="ct-prog-v__line"></span>
                </div>
                <div class="ct-prog-v__body">
                    <div class="@(showResultBeside ? "ct-prog-v__body-row" : null)">
                    <div class="@(showResultBeside ? "ct-prog-v__body-main" : null)">
                    <div class="ct-prog-v__head">
                        <strong>@StepText(step.Label)</strong>
                        @if (!string.IsNullOrWhiteSpace(badge))
                        {
                            <span class="cw-prog-step__badge cw-prog-step__badge--@badgeCls">@badge</span>
                        }
                        @if (CanOfferPen(step))
                        {
                            <button type="button"
                                    class="ct-step-pen @(IsEditing(step) ? "is-open" : null)"
                                    title="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.EditStep")"
                                    aria-label="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.EditStep")"
                                    aria-pressed="@IsEditing(step)"
                                    disabled="@_busy"
                                    @onclick="() => ToggleStepEdit(step)">
                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                    <path fill="currentColor" d="M12.1 1.3a1.5 1.5 0 0 1 2.1 2.1l-8.4 8.4-2.8.7.7-2.8 8.4-8.4zM2 13.2h12v1.3H2z" />
                                </svg>
                            </button>
                        }
                    </div>
                    @if (!IsEditing(step) && !string.IsNullOrWhiteSpace(step.ResultNumber))
                    {
                        <p class="ct-prog-v__result-number">@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ResultNumberValue", step.ResultNumber)</p>
                    }
                    @if (IsEditing(step))
                    {
                        <OfficerShellProgressStepCorrection Step="step"
                                                            ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                            OwnerViewId="@PreviewSlotOwnerViewId"
                                                            Busy="_busy"
                                                            MaxUploadMb="MaxUploadMb"
                                                            SaveRequested="SaveStepAsync"
                                                            FileChangeRequested="ChangeFileAsync" />
                    }
                    else if (CanOfferPen(step))
                    {
                        @if (!string.IsNullOrWhiteSpace(step.SubmissionDocumentNumber))
                        {
                            <p class="ct-prog-v__result-number">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentNumber"): @step.SubmissionDocumentNumber</p>
                        }
                        @if (step.MissingMinistryLetter)
                        {
                            <span class="person-dossier__pill st-pending doc-copies-catalog__pill doc-copies-catalog__pill--missing">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Missing")</span>
                        }
                        @if (step.Files.Count > 0 && (step.ProgressId ?? step.DateProgressId) is Guid fileProgressId)
                        {
                            <div class="ct-step-files">
                                @foreach (var file in step.Files)
                                {
                                    <div class="ct-step-file" title="@file.FileName">
                                        <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                           ProgressId="fileProgressId"
                                                                           FileId="file.FileId"
                                                                           FileName="@file.FileName"
                                                                           LinkText="@file.FileName"
                                                                           CssClass="ct-step-file__name"
                                                                           OwnerViewId="@PreviewSlotOwnerViewId" />
                                    </div>
                                }
                                @if (step.Files.Count > 1)
                                {
                                    <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                       ProgressId="fileProgressId"
                                                                       FileName="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.PreviewAllFiles")"
                                                                       LinkText="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.PreviewAllFiles")"
                                                                       PreviewAll="true"
                                                                       CssClass="ct-step-file__btn"
                                                                       OwnerViewId="@PreviewSlotOwnerViewId" />
                                }
                            </div>
                        }
                    }
                    @if (step.State != "current" && ShowRevertToHere && step.CanRevertToHere)
                    {
                        <p style="margin:6px 0 0">
                            <button type="button"
                                    class="os-btn os-btn--ghost"
                                    disabled="@_busy"
                                    @onclick="() => RevertAsync(step)">
                                ◀ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertToHere")
                            </button>
                        </p>
                    }
                    @if (!CanOfferPen(step)
                        && !IsEditing(step)
                        && step.State != "current"
                        && !string.IsNullOrWhiteSpace(letterName)
                        && letterProgressId is Guid)
                    {
                        <p class="ct-prog-v__letter">
                            <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                               ProgressId="letterProgressId"
                                                               FileName="@letterName"
                                                               OwnerViewId="@PreviewSlotOwnerViewId" />
                        </p>
                    }
                    else if (!CanOfferPen(step) && !IsEditing(step) && step.State != "current" && step.ShowMigrationSubmission)
                    {
                        <div class="ct-prog-v__letter-missing">
                            <label class="ct-label" for="submission-date-@ApplicationProfileInstanceId">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Date")</label>
                            <OfficerDateEdit @ref="_backfillDateEdit"
                                             InputId="@($"submission-date-{ApplicationProfileInstanceId}")"
                                             @bind-Date="_backfillDate"
                                             Enabled="@(!_busy)" />
                            <label class="ct-label" for="submission-number-@ApplicationProfileInstanceId" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentNumber")</label>
                            <input id="submission-number-@ApplicationProfileInstanceId"
                                   type="text"
                                   class="os-input"
                                   maxlength="@ApplicationMigrationSubmission.MaxDocumentNumberLength"
                                   @bind="_backfillNumber"
                                   @bind:event="oninput"
                                   disabled="@_busy" />
                            <label class="ct-label" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentCopy")</label>
                            @if (!string.IsNullOrWhiteSpace(_backfillFileName))
                            {
                                <p class="ct-muted" style="margin:0 0 8px">@_backfillFileName</p>
                            }
                            <label class="ct-upload ct-upload--action ct-upload--missing">
                                <InputFile OnChange="OnSubmissionCopySelected" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" disabled="@_busy" />
                                <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadFile")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                            </label>
                            <button type="button"
                                    class="os-btn os-btn--primary"
                                    style="margin-top:10px"
                                    disabled="@_busy"
                                    @onclick="SaveSubmissionAsync">
                                @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SaveSubmission")
                            </button>
                        </div>
                    }
                    else if (!CanOfferPen(step) && !IsEditing(step) && step.State != "current" && step.MissingMinistryLetter)
                    {
                        <div class="ct-prog-v__letter-missing">
                            <span class="person-dossier__pill st-pending doc-copies-catalog__pill doc-copies-catalog__pill--missing">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Missing")</span>
                            <label class="ct-label">@FileUploadLabel(step)</label>
                            <label class="ct-upload ct-upload--action ct-upload--missing">
                                <InputFile OnChange="e => OnMinistryLetterSelected(e, step)" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" disabled="@_busy" />
                                <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadApprovalCopy")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                            </label>
                        </div>
                    }
                    @if (step.State == "current")
                    {
                        <div class="ct-prog-detail">
                            <dl class="ct-meta">
                                <div><dt>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.CurrentState")</dt><dd><span class="os-status os-status--process">@ApplicationProfileLocalization.ProgressStatusWithProcessNumber(StepText(string.IsNullOrWhiteSpace(step.CurrentStateLabel) ? step.Label : step.CurrentStateLabel), step.ProcessNumber)</span></dd></div>
                                <div><dt>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.StartedOn")</dt><dd>@step.Date</dd></div>
                                <div><dt>@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SlaTarget")</dt><dd>@(string.IsNullOrWhiteSpace(step.SlaTargetDate) ? "—" : step.SlaTargetDate)</dd></div>
                            </dl>
                            @if (IsOpenAdvanceStep(step) && step.Files.Count > 0 && (step.ProgressId ?? step.DateProgressId) is Guid currentFileProgressId)
                            {
                                <div class="ct-step-files" style="margin-top:10px">
                                    @foreach (var file in step.Files)
                                    {
                                        <div class="ct-step-file" title="@file.FileName">
                                            <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                               ProgressId="currentFileProgressId"
                                                                               FileId="file.FileId"
                                                                               FileName="@file.FileName"
                                                                               LinkText="@file.FileName"
                                                                               CssClass="ct-step-file__name"
                                                                               OwnerViewId="@PreviewSlotOwnerViewId" />
                                        </div>
                                    }
                                    @if (step.Files.Count > 1)
                                    {
                                        <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                           ProgressId="currentFileProgressId"
                                                                           FileName="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.PreviewAllFiles")"
                                                                           LinkText="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.PreviewAllFiles")"
                                                                           PreviewAll="true"
                                                                           CssClass="ct-step-file__btn"
                                                                           OwnerViewId="@PreviewSlotOwnerViewId" />
                                    }
                                </div>
                            }

                            @if (step.CanAdvance)
                            {
                                <div class="ct-prog-advance" style="margin-top:16px;padding-top:12px;border-top:1px solid var(--os-line)">
                                    <label class="ct-label @(IsDateInvalid ? "ct-label--error" : null)" for="advance-date-@ApplicationProfileInstanceId">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Date")</label>
                                    <OfficerDateEdit @ref="_advanceDateEdit"
                                                     InputId="@($"advance-date-{ApplicationProfileInstanceId}")"
                                                     @bind-Date="_advanceDate"
                                                     CssClass="@AdvanceDateCssClass"
                                                     Enabled="@(!_busy)" />
                                    @if (step.ResultOptions.Count > 0)
                                    {
                                        <label class="ct-label @(IsResultInvalid ? "ct-label--error" : null)" for="advance-state-@ApplicationProfileInstanceId" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Result")</label>
                                        <select id="advance-state-@ApplicationProfileInstanceId"
                                                @ref="_advanceResultInput"
                                                class="os-input @(IsResultInvalid ? "is-invalid" : null)"
                                                aria-invalid="@IsResultInvalid"
                                                @bind="_selectedAdvanceStateCode"
                                                disabled="@_busy">
                                            @if (step.ResultOptions.All(o => o.StateCode != _selectedAdvanceStateCode))
                                            {
                                                <option value="@_selectedAdvanceStateCode">—</option>
                                            }
                                            @foreach (var option in step.ResultOptions)
                                            {
                                                <option value="@option.StateCode">@StepText(option.Label)</option>
                                            }
                                        </select>
                                    }
                                    @if (step.ShowMigrationSubmission)
                                    {
                                        @if (step.RequireSubmissionDocumentNumber)
                                        {
                                            <label class="ct-label @(IsSubmissionNumberInvalid ? "ct-label--error" : null)" for="advance-submission-number-@ApplicationProfileInstanceId" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentNumber")</label>
                                            <input id="advance-submission-number-@ApplicationProfileInstanceId"
                                                   @ref="_advanceSubmissionNumberInput"
                                                   type="text"
                                                   class="os-input @(IsSubmissionNumberInvalid ? "is-invalid" : null)"
                                                   aria-invalid="@IsSubmissionNumberInvalid"
                                                   maxlength="@ApplicationMigrationSubmission.MaxDocumentNumberLength"
                                                   @bind="_submissionDocumentNumber"
                                                   @bind:event="oninput"
                                                   disabled="@_busy" />
                                        }
                                        <label class="ct-label" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentCopy")</label>
                                        <OfficerShellPendingProgressFiles Files="_pendingFiles"
                                                                          ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                          OwnerViewId="@PreviewSlotOwnerViewId"
                                                                          Busy="_busy"
                                                                          RemoveRequested="RemovePending" />
                                        <label class="ct-upload ct-upload--action">
                                            <InputFile OnChange="e => OnMinistryLetterSelected(e, step)" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" multiple disabled="@_busy" />
                                            <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadFile")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                                        </label>
                                    }
                                    @if (ShowResultNumberOnAdvance)
                                    {
                                        <label class="ct-label @(IsResultNumberInvalid ? "ct-label--error" : null)" for="advance-result-number-@ApplicationProfileInstanceId" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ResultNumber")</label>
                                        <input id="advance-result-number-@ApplicationProfileInstanceId"
                                               @ref="_advanceResultNumberInput"
                                               type="text"
                                               class="os-input @(IsResultNumberInvalid ? "is-invalid" : null)"
                                               aria-invalid="@IsResultNumberInvalid"
                                               maxlength="@ApplicationProgressResultNumberHelper.MaxLength"
                                               @bind="_resultNumber"
                                               @bind:event="oninput"
                                               disabled="@_busy"
                                               placeholder="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ResultNumberPlaceholder")" />
                                    }
                                    @if (ShowProcessNumberOnAdvance)
                                    {
                                        <label class="ct-label @(IsProcessNumberInvalid ? "ct-label--error" : null)" for="advance-process-number-@ApplicationProfileInstanceId" style="margin-top:10px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumber")</label>
                                        <input id="advance-process-number-@ApplicationProfileInstanceId"
                                               @ref="_advanceProcessNumberInput"
                                               type="text"
                                               class="os-input @(IsProcessNumberInvalid ? "is-invalid" : null)"
                                               aria-invalid="@IsProcessNumberInvalid"
                                               maxlength="@ApplicationProcessNumberHelper.MaxLength"
                                               @bind="_processNumber"
                                               @bind:event="oninput"
                                               disabled="@_busy"
                                               placeholder="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumberPlaceholder")" />
                                    }
                                    @if (step.ShowMinistryLetterUpload)
                                    {
                                        <label class="ct-label @(step.MissingMinistryLetter ? "ct-label--warn" : null)" style="margin-top:10px">@FileUploadLabel(step)</label>
                                        @if (step.MissingMinistryLetter)
                                        {
                                            <span class="person-dossier__pill st-pending doc-copies-catalog__pill doc-copies-catalog__pill--missing" style="margin:0 0 8px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Missing")</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(letterName) && letterProgressId is Guid)
                                        {
                                            <p class="ct-muted" style="margin:0 0 8px">
                                                <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                                   ProgressId="letterProgressId"
                                                                                   FileName="@letterName"
                                                                                   OwnerViewId="@PreviewSlotOwnerViewId" />
                                            </p>
                                        }
                                        <OfficerShellPendingProgressFiles Files="_pendingFiles"
                                                                          ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                          OwnerViewId="@PreviewSlotOwnerViewId"
                                                                          Busy="_busy"
                                                                          RemoveRequested="RemovePending" />
                                        <label class="ct-upload ct-upload--action @(step.MissingMinistryLetter ? "ct-upload--missing" : null)">
                                            <InputFile OnChange="e => OnMinistryLetterSelected(e, step)" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" multiple disabled="@_busy" />
                                            <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadFile")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                                        </label>
                                    }
                                    <button type="button"
                                            class="os-btn os-btn--primary"
                                            style="margin-top:10px"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_selectedAdvanceStateCode))"
                                            @onclick="AdvanceAsync">
                                        ▶ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.AdvanceProgress")
                                    </button>
                                    @if (step.ShowCancelProgress && !string.IsNullOrWhiteSpace(step.CancelStateCode))
                                    {
                                        <button type="button"
                                                class="os-btn os-btn--ghost"
                                                style="margin-top:10px;margin-left:8px"
                                                disabled="@_busy"
                                                @onclick="() => CancelProgressAsync(step)">
                                            @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Cancelled")
                                        </button>
                                    }
                                    @if (step.CanRevert)
                                    {
                                        <button type="button"
                                                class="os-btn os-btn--ghost"
                                                style="margin-top:10px;margin-left:8px"
                                                disabled="@_busy"
                                                @onclick="() => RevertAsync(step)">
                                            ◀ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertProgress")
                                        </button>
                                    }
                                </div>
                            }
                            else if ((step.ShowMinistryLetterUpload && !IsEditing(step))
                                || step.CanRevert
                                || !string.IsNullOrWhiteSpace(step.AdvanceBlockedReason))
                            {
                                <div class="ct-prog-advance" style="margin-top:16px;padding-top:12px;border-top:1px solid var(--os-line)">
                                    @if (!string.IsNullOrWhiteSpace(step.AdvanceBlockedReason))
                                    {
                                        <p class="ct-muted" style="margin:0 0 10px">@ApplicationProfileLocalization.ProgressReason(step.AdvanceBlockedReason)</p>
                                    }
                                    @if (step.ShowMinistryLetterUpload && !IsEditing(step))
                                    {
                                        <label class="ct-label @(step.MissingMinistryLetter ? "ct-label--warn" : null)">@FileUploadLabel(step)</label>
                                        @if (step.MissingMinistryLetter)
                                        {
                                            <span class="person-dossier__pill st-pending doc-copies-catalog__pill doc-copies-catalog__pill--missing" style="margin:0 0 8px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Missing")</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(letterName) && letterProgressId is Guid)
                                        {
                                            <p class="ct-muted" style="margin:0 0 8px">
                                                <ProgressMinistryLetterPreviewLink ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                                   ProgressId="letterProgressId"
                                                                                   FileName="@letterName"
                                                                                   OwnerViewId="@PreviewSlotOwnerViewId" />
                                            </p>
                                        }
                                        <OfficerShellPendingProgressFiles Files="_pendingFiles"
                                                                          ApplicationProfileInstanceId="ApplicationProfileInstanceId"
                                                                          OwnerViewId="@PreviewSlotOwnerViewId"
                                                                          Busy="_busy"
                                                                          RemoveRequested="RemovePending" />
                                        <label class="ct-upload ct-upload--action @(step.MissingMinistryLetter ? "ct-upload--missing" : null)" style="margin-bottom:10px">
                                            <InputFile OnChange="e => OnMinistryLetterSelected(e, step)" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp" multiple disabled="@_busy" />
                                            <span>☁ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.UploadFile")<br /><span>@VisaUiMessages.Format("ApplicationProfileInstance.Workspace.ScanLimit", MaxUploadMb)</span></span>
                                        </label>
                                    }
                                    @if (step.CanRevert)
                                    {
                                        <button type="button"
                                                class="os-btn os-btn--ghost"
                                                disabled="@_busy"
                                                @onclick="() => RevertAsync(step)">
                                            ◀ @VisaUiMessages.Get("ApplicationProfileInstance.Workspace.RevertProgress")
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    </div>
                    @if (showResultBeside)
                    {
                        <div class="ct-prog-v__result-chips lv-result-stems">
                        <div class="lv-result-chips lv-result-chips--stack"
                             aria-label="@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ApplicationResult")">
                            @foreach (var chip in progressResultChips)
                            {
                                <span class="lv-result-chip lv-result-chip--@ApplicationWorkspaceIssuedResultListCoverage.Tone(chip)">
                                    @ApplicationWorkspaceIssuedResultListCoverage.Caption(chip)
                                    <strong>@ApplicationWorkspaceIssuedResultListCoverage.RatioText(chip)</strong>
                                </span>
                            }
                        </div>
                        </div>
                    }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ProgressHistory.Count > 0)
    {
        <h3 class="ct-page__title" style="margin-top:24px">@VisaUiMessages.Get("ApplicationProfileInstance.Workspace.History")</h3>
        <ul class="cw-timeline">
            @foreach (var row in ProgressHistory)
            {
                <li><strong>@StepText(row.State)</strong><span>@row.Date</span></li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public Guid ApplicationProfileInstanceId { get; set; }
    [Parameter] public ApplicationWorkspaceCaseView View { get; set; } = new();
    [Parameter] public IReadOnlyList<ApplicationWorkspaceProgressRow> ProgressHistory { get; set; }
        = Array.Empty<ApplicationWorkspaceProgressRow>();
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public int CorrectionSavedRevision { get; set; }
    [Parameter] public EventCallback<string> SaveNotesRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileUpload> UploadMinistryLetterRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressAdvanceRequest> AdvanceProgressRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseMigrationSubmissionRequest> SaveMigrationSubmissionRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressRevertRequest> RevertProgressRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressStepCorrection> SaveStepRequested { get; set; }
    [Parameter] public EventCallback<OfficerShellCaseProgressFileChange> ChangeFileRequested { get; set; }
    [Parameter] public bool ShowRevertToHere { get; set; }
    [Parameter] public string PreviewSlotOwnerViewId { get; set; } = OfficerShellViewIds.DetailView;

    private string _selectedAdvanceStateCode = string.Empty;
    private string _processNumber = string.Empty;
    private string _resultNumber = string.Empty;
    private DateTime? _advanceDate = DateTime.Today;
    private bool _busy;
    private string? _editingStepKey;
    private int _seenCorrectionRevision;
    private string _pendingLetterStepKey = string.Empty;
    private readonly List<ProgressLetterInlineFile> _pendingFiles = new();
    private string? _localAdvanceError;
    private bool _advanceFieldErrors;
    private bool _wasStatusError;
    private string? _previousStatusMessage;
    private bool _focusInvalidAdvanceField;
    private OfficerDateEdit? _advanceDateEdit;
    private ElementReference _advanceResultInput;
    private ElementReference _advanceResultNumberInput;
    private ElementReference _advanceSubmissionNumberInput;
    private string _submissionDocumentNumber = string.Empty;
    private OfficerDateEdit? _backfillDateEdit;
    private DateTime? _backfillDate;
    private string _backfillNumber = string.Empty;
    private string? _backfillFileName;
    private byte[]? _backfillFileContent;
    private ElementReference _advanceProcessNumberInput;

    internal DateTime AdvanceDate =>
        _advanceDate is DateTime date && date != default ? date.Date : DateTime.Today;

    private string AdvanceDateCssClass => IsDateInvalid ? "ct-prog-date is-invalid" : "ct-prog-date";

    private static bool IsMissingAdvanceDate(DateTime? value) =>
        value is not DateTime date || date == default;

    internal string SelectedAdvanceStateCode => _selectedAdvanceStateCode;

    internal string ProcessNumberOnAdvance => _processNumber;

    internal string? SubmissionDocumentNumberOnAdvance =>
        ApplicationMigrationSubmission.IsState(_selectedAdvanceStateCode) ? _submissionDocumentNumber : null;

    private bool ShowProcessNumberOnAdvance
    {
        get
        {
            if (ApplicationMigrationSlaHelper.IsMigrationServiceProcessStartedStep(_selectedAdvanceStateCode)
                && view.Chrome.ShowProcessNumber)
                return true;

            var current = View.ProgressSteps.FirstOrDefault(s => s.State == "current");
            return current?.RequireProcessNumberOnAdvance == true
                && string.Equals(
                    _selectedAdvanceStateCode,
                    ApplicationProfileInstanceProgressStateCodes.ProcessIssued,
                    StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool ShowResultNumberOnAdvance =>
        ApplicationProgressResultNumberHelper.AppliesTo(_selectedAdvanceStateCode);

    private string? DisplayStatusMessage =>
        !string.IsNullOrWhiteSpace(_localAdvanceError) ? _localAdvanceError : StatusMessage;

    private bool DisplayStatusIsError =>
        !string.IsNullOrWhiteSpace(_localAdvanceError) || IsStatusError;

    private bool IsAdvanceFieldErrorMode => _advanceFieldErrors || IsStatusError;

    private bool IsDateInvalid => IsAdvanceFieldErrorMode && IsMissingAdvanceDate(_advanceDate);

    private bool IsResultInvalid
    {
        get
        {
            if (!IsAdvanceFieldErrorMode)
                return false;

            var current = View.ProgressSteps.FirstOrDefault(s => s.State == "current");
            return current != null
                && current.ResultOptions.Count > 0
                && string.IsNullOrWhiteSpace(_selectedAdvanceStateCode);
        }
    }

    private bool IsResultNumberInvalid
    {
        get
        {
            if (!IsAdvanceFieldErrorMode || !ShowResultNumberOnAdvance)
                return false;

            return !ApplicationProgressResultNumberHelper.TryNormalize(_resultNumber, required: true, out _, out _);
        }
    }

    private bool IsProcessNumberInvalid
    {
        get
        {
            if (!IsAdvanceFieldErrorMode || !ShowProcessNumberOnAdvance)
                return false;

            if (string.IsNullOrWhiteSpace(_processNumber))
                return true;

            return IsStatusError
                && !string.IsNullOrWhiteSpace(StatusMessage)
                && StatusMessage.Contains("Process number", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool IsSubmissionNumberInvalid
    {
        get
        {
            if (!IsAdvanceFieldErrorMode || !ApplicationMigrationSubmission.IsState(_selectedAdvanceStateCode))
                return false;

            var current = View.ProgressSteps.FirstOrDefault(s => s.State == "current");
            if (current?.RequireSubmissionDocumentNumber != true)
                return false;

            return !ApplicationMigrationSubmission.TryNormalizeDocumentNumber(_submissionDocumentNumber, out _, out _);
        }
    }

    internal string? PendingLetterFileName =>
        _pendingFiles.Count == 0 ? null : _pendingFiles[0].FileName;

    internal byte[]? PendingLetterContent =>
        _pendingFiles.Count == 0 ? null : _pendingFiles[0].Content;

    private ApplicationWorkspaceCaseView view => View;
    private int MaxUploadMb => 10;

    protected override void OnParametersSet()
    {
        if (CorrectionSavedRevision != _seenCorrectionRevision)
        {
            _seenCorrectionRevision = CorrectionSavedRevision;
            if (!IsStatusError)
                _editingStepKey = null;
        }

        if (IsStatusError)
        {
            if (!_wasStatusError)
                _focusInvalidAdvanceField = true;
            _advanceFieldErrors = true;
            _localAdvanceError = null;
        }
        else if (string.Equals(StatusMessage, "Progress advanced.", StringComparison.Ordinal))
        {
            _advanceFieldErrors = false;
            _localAdvanceError = null;
            if (!string.Equals(_previousStatusMessage, StatusMessage, StringComparison.Ordinal))
                _resultNumber = string.Empty;
        }

        _wasStatusError = IsStatusError;
        _previousStatusMessage = StatusMessage;

        var current = View.ProgressSteps.FirstOrDefault(s => s.State == "current");
        if (current == null)
            return;

        if (!string.Equals(_pendingLetterStepKey, current.Key, StringComparison.OrdinalIgnoreCase))
        {
            _pendingLetterStepKey = string.Empty;
            _pendingFiles.Clear();
        }

        if (string.IsNullOrWhiteSpace(_processNumber) && !string.IsNullOrWhiteSpace(view.Chrome.ProcessNumber))
            _processNumber = view.Chrome.ProcessNumber;

        if (string.IsNullOrWhiteSpace(_selectedAdvanceStateCode)
            || current.ResultOptions.All(o => o.StateCode != _selectedAdvanceStateCode))
        {
            _selectedAdvanceStateCode = ApplicationWorkspaceProgressAdvancePreview.PreferredAdvanceCode(
                current.Key,
                current.AdvanceOptions,
                _selectedAdvanceStateCode) ?? string.Empty;
        }
    }

    private string LocalizedCurrentStepHeading
    {
        get
        {
            var current = view.ProgressSteps.FirstOrDefault(s => s.State == "current");
            return ApplicationProfileLocalization.ProgressStatusWithProcessNumber(
                StepText(CurrentStepHeading),
                current?.ProcessNumber);
        }
    }

    private static string StepText(string? label) => ApplicationProfileLocalization.ProgressStepLabel(label);

    private static bool IsMigrationStep(ApplicationWorkspaceCaseProgressStep step) =>
        string.Equals(step.Key, "migration", StringComparison.OrdinalIgnoreCase);

    private static string FileUploadLabel(ApplicationWorkspaceCaseProgressStep step) =>
        string.Equals(step.Key, "office", StringComparison.OrdinalIgnoreCase)
            ? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.OfficeFile")
            : IsMigrationStep(step)
                ? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Documents")
                : VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ApprovalLetter");

    private static string StepBadge(ApplicationWorkspaceCaseProgressStep step, bool isCurrent)
    {
        string text;
        if (!string.IsNullOrWhiteSpace(step.CurrentStateLabel))
            text = ApplicationProfileLocalization.ProgressStepLabel(step.CurrentStateLabel);
        else if (step.State == "done" && !string.Equals(step.Key, "office", StringComparison.OrdinalIgnoreCase))
            text = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Completed");
        else if (isCurrent)
            text = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.InProgress");
        else if (step.State == "pending")
            text = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.Pending");
        else
            text = string.Empty;

        return ApplicationProfileLocalization.ProgressStatusWithProcessNumber(text, step.ProcessNumber);
    }

    private string CurrentStepHeading
    {
        get
        {
            var current = view.ProgressSteps.FirstOrDefault(s => s.State == "current");
            if (current == null)
                return view.Chrome.CurrentStep;

            var result = current.CurrentStateLabel;
            if (string.IsNullOrWhiteSpace(result)
                || string.Equals(result, current.Label, StringComparison.OrdinalIgnoreCase))
                return current.Label;

            return $"{current.Label} · {result}";
        }
    }

    private static bool IsOpenAdvanceStep(ApplicationWorkspaceCaseProgressStep step) =>
        step.State == "current"
        && step.OutcomeKind is not ("issued" or "rejected" or "cancelled");

    private static bool CanOfferPen(ApplicationWorkspaceCaseProgressStep step) =>
        !IsOpenAdvanceStep(step)
        && (step.CanCorrectDate || step.CanEditFiles);

    private bool IsEditing(ApplicationWorkspaceCaseProgressStep step) =>
        CanOfferPen(step)
        && string.Equals(_editingStepKey, step.Key, StringComparison.OrdinalIgnoreCase);

    private void ToggleStepEdit(ApplicationWorkspaceCaseProgressStep step)
    {
        if (_busy || !CanOfferPen(step))
            return;

        _editingStepKey = IsEditing(step) ? null : step.Key;
    }

    private void RemovePending(int index)
    {
        if (index < 0 || index >= _pendingFiles.Count)
            return;
        _pendingFiles.RemoveAt(index);
    }

    private async Task OnMinistryLetterSelected(InputFileChangeEventArgs e, ApplicationWorkspaceCaseProgressStep step)
    {
        if (_busy)
            return;

        var files = e.GetMultipleFiles(100);
        if (files.Count == 0)
            return;

        _busy = true;
        try
        {
            var attachTo = step.DecisionProgressId
                ?? (step.MissingMinistryLetter ? step.ProgressId : null);
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(MaxUploadMb * 1024L * 1024L);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                var content = memory.ToArray();
                if (content.Length == 0)
                    continue;

                if (attachTo is Guid progressId && progressId != Guid.Empty)
                {
                    await ChangeFileRequested.InvokeAsync(new OfficerShellCaseProgressFileChange
                    {
                        ProgressId = progressId,
                        Slot = step.ShowMigrationSubmission
                            ? ApplicationProfileInstanceProgressFiles.SubmissionDocument
                            : ApplicationProfileInstanceProgressFiles.MinistryLetter,
                        FileName = file.Name,
                        Content = content,
                    });
                    continue;
                }

                _pendingLetterStepKey = step.Key;
                _pendingFiles.Add(new ProgressLetterInlineFile { FileName = file.Name, Content = content });
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveStepAsync(OfficerShellCaseProgressStepCorrection request)
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            await SaveStepRequested.InvokeAsync(request);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeFileAsync(OfficerShellCaseProgressFileChange request)
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            await ChangeFileRequested.InvokeAsync(request);
        }
        finally
        {
            _busy = false;
        }
    }

    internal Task AdvanceFromRailAsync() => AdvanceAsync();

    private async Task CancelProgressAsync(ApplicationWorkspaceCaseProgressStep step)
    {
        if (_busy || string.IsNullOrWhiteSpace(step.CancelStateCode))
            return;

        _selectedAdvanceStateCode = step.CancelStateCode;
        await AdvanceAsync();
    }

    private async Task AdvanceAsync()
    {
        if (_busy)
            return;

        var current = View.ProgressSteps.FirstOrDefault(s => s.State == "current");
        var code = ApplicationWorkspaceProgressAdvancePreview.PreferredAdvanceCode(
            current?.Key ?? string.Empty,
            current?.AdvanceOptions ?? Array.Empty<ApplicationWorkspaceCaseProgressAdvanceOption>(),
            _selectedAdvanceStateCode);
        if (string.IsNullOrWhiteSpace(code))
            return;

        _localAdvanceError = null;
        if (!TryValidateAdvance(code, out var validationError))
        {
            _advanceFieldErrors = true;
            _localAdvanceError = validationError;
            _focusInvalidAdvanceField = true;
            return;
        }

        _busy = true;
        try
        {
            await AdvanceProgressRequested.InvokeAsync(new OfficerShellCaseProgressAdvanceRequest
            {
                StateCode = code,
                Date = AdvanceDate,
                LetterFileName = _pendingFiles.Count == 0 ? null : _pendingFiles[0].FileName,
                LetterContent = _pendingFiles.Count == 0 ? null : _pendingFiles[0].Content,
                AdditionalFiles = _pendingFiles.Skip(1).ToList(),
                ProcessNumber = _processNumber,
                ResultNumber = ApplicationProgressResultNumberHelper.AppliesTo(code) ? _resultNumber : null,
                SubmissionDocumentNumber = ApplicationMigrationSubmission.IsState(code) ? _submissionDocumentNumber : null,
            });
        }
        finally
        {
            _busy = false;
        }
    }

    private bool TryValidateAdvance(string code, out string? error)
    {
        if (IsMissingAdvanceDate(_advanceDate))
        {
            error = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.DateRequired");
            return false;
        }

        var current = View.ProgressSteps.FirstOrDefault(s => s.State == "current");
        if (current != null
            && current.ResultOptions.Count > 0
            && string.IsNullOrWhiteSpace(_selectedAdvanceStateCode))
        {
            error = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ResultRequired");
            return false;
        }

        if (ApplicationProgressResultNumberHelper.AppliesTo(code)
            && !ApplicationProgressResultNumberHelper.TryNormalize(_resultNumber, required: true, out _, out var resultNumberError))
        {
            error = resultNumberError ?? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ResultNumberRequired");
            return false;
        }

        if (ApplicationMigrationSubmission.IsState(code)
            && current?.RequireSubmissionDocumentNumber == true
            && !ApplicationMigrationSubmission.TryNormalizeDocumentNumber(_submissionDocumentNumber, out _, out var submissionNumberError))
        {
            error = submissionNumberError ?? VisaUiMessages.Get("ApplicationProfileInstance.Workspace.SubmissionDocumentNumberRequired");
            return false;
        }

        var requireProcessNumber =
            (view.Chrome.ShowProcessNumber
                && ApplicationMigrationSlaHelper.IsMigrationServiceProcessStartedStep(code))
            || (current?.RequireProcessNumberOnAdvance == true
                && string.Equals(
                    code,
                    ApplicationProfileInstanceProgressStateCodes.ProcessIssued,
                    StringComparison.OrdinalIgnoreCase));
        if (requireProcessNumber && string.IsNullOrWhiteSpace(_processNumber))
        {
            error = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.ProcessNumberRequired");
            return false;
        }

        error = null;
        return true;
    }

    private async Task FocusFirstInvalidAdvanceFieldAsync()
    {
        try
        {
            if (IsDateInvalid && _advanceDateEdit != null)
                await _advanceDateEdit.FocusAsync();
            else if (IsResultInvalid)
                await _advanceResultInput.FocusAsync();
            else if (IsResultNumberInvalid)
                await _advanceResultNumberInput.FocusAsync();
            else if (IsSubmissionNumberInvalid)
                await _advanceSubmissionNumberInput.FocusAsync();
            else if (IsProcessNumberInvalid)
                await _advanceProcessNumberInput.FocusAsync();
        }
        catch (InvalidOperationException)
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusInvalidAdvanceField)
            return;

        _focusInvalidAdvanceField = false;
        await FocusFirstInvalidAdvanceFieldAsync();
    }

    private async Task OnSubmissionCopySelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        await using var stream = file.OpenReadStream(MaxUploadMb * 1024L * 1024L);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        _backfillFileName = file.Name;
        _backfillFileContent = buffer.ToArray();
    }

    private async Task SaveSubmissionAsync()
    {
        if (_busy)
            return;

        if (IsMissingAdvanceDate(_backfillDate))
        {
            _localAdvanceError = VisaUiMessages.Get("ApplicationProfileInstance.Workspace.DateRequired");
            return;
        }

        if (!ApplicationMigrationSubmission.TryNormalizeDocumentNumber(_backfillNumber, out _, out var numberError))
        {
            _localAdvanceError = numberError;
            return;
        }

        _busy = true;
        _localAdvanceError = null;
        try
        {
            await SaveMigrationSubmissionRequested.InvokeAsync(new OfficerShellCaseMigrationSubmissionRequest
            {
                Date = _backfillDate!.Value.Date,
                DocumentNumber = _backfillNumber,
                FileName = _backfillFileName,
                FileContent = _backfillFileContent,
            });
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevertAsync(ApplicationWorkspaceCaseProgressStep step)
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            await RevertProgressRequested.InvokeAsync(new OfficerShellCaseProgressRevertRequest
            {
                StepKey = step.CanRevertToHere && !step.CanRevert ? step.Key : null,
            });
        }
        finally
        {
            _busy = false;
        }
    }
}
