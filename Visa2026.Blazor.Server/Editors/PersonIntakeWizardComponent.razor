    private void EnsureRecordDraftDefaults(string recordKey)
    {
        if (ObjectSpace == null)
            return;

        if (recordKey == PersonPendingTargets.Passport)
        {
            if (!State.PassportDraft.PassportTypeId.HasValue)
            {
                var type = ObjectSpace.GetObjectsQuery<PassportType>().FirstOrDefault(t => t.IsDefault)
                    ?? ObjectSpace.GetObjectsQuery<PassportType>().FirstOrDefault(t =>
                        string.Equals(t.PdfForm_Code, Passport.DefaultPassportTypeCode, StringComparison.OrdinalIgnoreCase));
                State.PassportDraft.PassportTypeId = type?.ID;
            }

            if (!State.PassportDraft.IssuedCountryId.HasValue)
                State.PassportDraft.IssuedCountryId = ObjectSpace.GetObjectsQuery<Country>().FirstOrDefault(c => c.IsDefault)?.ID;
        }
        else if (recordKey == PersonPendingTargets.Education)
        {
            if (!State.EducationDraft.EducationLevelId.HasValue)
                State.EducationDraft.EducationLevelId = ObjectSpace.GetObjectsQuery<EducationLevel>().FirstOrDefault(e => e.IsDefault)?.ID;
            if (!State.EducationDraft.EducationCountryId.HasValue)
                State.EducationDraft.EducationCountryId = ObjectSpace.GetObjectsQuery<Country>().FirstOrDefault(c => c.IsDefault)?.ID;
            if (!State.EducationDraft.SpecialtyId.HasValue)
                State.EducationDraft.SpecialtyId = ObjectSpace.GetObjectsQuery<Specialty>().FirstOrDefault(s => s.IsDefault)?.ID;
        }
    }

    private string EducationDraftDescription()
    {
        if (ObjectSpace == null)
            return string.Empty;

        var parts = new List<string>();
        void Add(Guid? id, Func<Guid, LookupBase?> resolve)
        {
            if (!id.HasValue)
                return;
            var entity = resolve(id.Value);
            var caption = entity == null ? null : LookupCaption(entity);
            if (!string.IsNullOrWhiteSpace(caption))
                parts.Add(caption);
        }

        Add(State.EducationDraft.EducationLevelId, id => ObjectSpace.GetObjectByKey<EducationLevel>(id));
        Add(State.EducationDraft.EducationInstitutionId, id => ObjectSpace.GetObjectByKey<EducationInstitution>(id));
        Add(State.EducationDraft.EducationCountryId, id => ObjectSpace.GetObjectByKey<Country>(id));
        Add(State.EducationDraft.SpecialtyId, id => ObjectSpace.GetObjectByKey<Specialty>(id));
        if (!string.IsNullOrWhiteSpace(State.EducationDraft.GraduationYear))
            parts.Add(State.EducationDraft.GraduationYear.Trim());

        return string.Join(", ", parts);
    }

    private async Task OnPassportCopiesSelected(InputFileChangeEventArgs args)
    {
        _passportCopyStatus = string.Empty;
        _passportCopyStatusError = false;
        if (args.FileCount == 0)
            return;

        var maxMb = ObjectSpace != null
            ? (SystemSettings.TryGetInstance(ObjectSpace)?.MaxDocumentSizeInMB ?? SystemSettings.DefaultMaxDocumentSizeInMB)
            : SystemSettings.DefaultMaxDocumentSizeInMB;
        var maxBytes = maxMb * 1024L * 1024L;

        foreach (var file in args.GetMultipleFiles(10))
        {
            if (file.Size > maxBytes)
            {
                _passportCopyStatus = PersonIntakeText.Format("Files.TooLarge", file.Name, maxMb);
                _passportCopyStatusError = true;
                continue;
            }

            await using var stream = file.OpenReadStream(maxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();

            if (ObjectSpace != null)
            {
                var validationError = PersonLinkedDocumentUploadService.ValidateBytes(ObjectSpace, file.Name, content);
                if (!string.IsNullOrEmpty(validationError))
                {
                    _passportCopyStatus = $"\"{file.Name}\": {validationError}";
                    _passportCopyStatusError = true;
                    continue;
                }
            }

            State.PassportDraft.Copies.Add(new PersonIntakeDocumentCopyDraft
            {
                FileName = file.Name,
                Content = content
            });
        }

        if (!_passportCopyStatusError && State.PassportDraft.Copies.Count > 0)
            _passportCopyStatus = PersonIntakeText.Format("Files.Ready", State.PassportDraft.Copies.Count);

        await InvokeAsync(StateHasChanged);
    }

    private Task RemovePassportCopy(Guid copyId)
    {
        State.PassportDraft.Copies.RemoveAll(c => c.Id == copyId);
        _passportCopyStatus = State.PassportDraft.Copies.Count == 0
            ? string.Empty
            : PersonIntakeText.Format("Files.Ready", State.PassportDraft.Copies.Count);
        _passportCopyStatusError = false;
        return Task.CompletedTask;
    }

