    private async Task<bool> TrySaveAsync()
    {
        if (!State.Unsaved)
            return true;
        if (!SaveRequested.HasDelegate)
            return false;

        await SaveRequested.InvokeAsync();
        return !State.Unsaved;
    }

    private void MarkUnsaved()
    {
        if (Access.IsViewOnly || State.Unsaved)
            return;
        State.Unsaved = true;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!ShowIncompleteOverview || Person == null)
            return;

        if (_overviewPersonId == Person.ID)
            return;

        _overviewPersonId = Person.ID;
        _stepIndex = 0;
    }

    private IReadOnlyList<PersonIntakeStep> VisibleSteps()
    {
        var steps = PersonIntakeStepCatalog.Steps(Person)
            .Select(ApplyReadAccess)
            .Where(step => step != null)
            .ToList();
        if (!ShowIncompleteOverview)
            return steps;

        steps.Add(new PersonIntakeStep
        {
            Id = "overview",
            Title = T("Step.Overview"),
            Hint = T("Step.Overview.Hint"),
            Kind = PersonIntakeStepKind.Overview
        });
        return steps;
    }

    /// <summary>Drops fields, record steps, and other-record options the role cannot read.</summary>
    private PersonIntakeStep? ApplyReadAccess(PersonIntakeStep step)
    {
        switch (step.Kind)
        {
            case PersonIntakeStepKind.Form:
                var fields = step.FieldKeys.Where(Access.CanReadField).ToList();
                var companion = step.CompanionFieldKeys.Where(Access.CanReadField).ToList();
                return fields.Count == 0 && companion.Count == 0 ? null : new PersonIntakeStep
                {
                    Id = step.Id,
                    Title = step.Title,
                    Hint = step.Hint,
                    Kind = step.Kind,
                    FieldKeys = fields,
                    CompanionFieldKeys = companion,
                    CompanionTitle = step.CompanionTitle
                };
            case PersonIntakeStepKind.Record:
                return Access.CanReadStep(step.RecordTargetKey) ? step : null;
            case PersonIntakeStepKind.Others:
                var options = step.OtherOptions.Where(o => Access.CanReadStep(o.TargetKey)).ToList();
                return options.Count == 0 ? null : new PersonIntakeStep
                {
                    Id = step.Id,
                    Title = step.Title,
                    Hint = step.Hint,
                    Kind = step.Kind,
                    OtherOptions = options
                };
            default:
                return step;
        }
    }

    private static string DisplayName(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private bool HasPhoto => Person?.Photo is { Length: > 0 };

    private string PersonHeading
    {
        get
        {
            var first = Person?.FirstName?.Trim();
            var last = Person?.LastName?.Trim();
            if (string.IsNullOrEmpty(first) && string.IsNullOrEmpty(last))
                return T("NameNotEntered");
            return string.Join(" ", new[] { first, last }.Where(s => !string.IsNullOrEmpty(s)));
        }
    }

    private string PersonInitials
    {
        get
        {
            var first = NameInitial(Person?.FirstName);
            var last = NameInitial(Person?.LastName);
            if (first == null && last == null)
                return "—";
            if (first != null && last != null)
                return first + "." + last + ".";
            return (first ?? last) + ".";
        }
    }

    private static string? NameInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;
        var text = value.Trim();
        return char.ToUpperInvariant(text[0]).ToString();
    }
    private Task GoToStep(int index)
    {
        if (Person == null)
            return Task.CompletedTask;

        var stepCount = VisibleSteps().Count;
        _stepIndex = Math.Clamp(index, 0, Math.Max(0, stepCount - 1));
        return Task.CompletedTask;
    }

