    private void RenderLookup<T>(
        RenderTreeBuilder builder,
        ref int seq,
        string key,
        string css,
        bool deferred,
        T? current,
        Action<T?> assign) where T : BaseObject
    {
        if (ObjectSpace == null)
            return;

        var options = PersonIntakeLookupHelper.LoadOptions<T>(ObjectSpace);
        builder.OpenComponent<PersonIntakeSearchableLookup>(seq++);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.Options), options);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.Value), current?.ID);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.ValueChanged),
            EventCallback.Factory.Create<Guid?>(this, id => AssignLookup(key, assign, id)));
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.CssClass),
            css + " person-intake-wizard__lookup");
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.Enabled), !deferred);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.ReadOnly), deferred);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.ShowTools), _showLookupTools);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.LookupType), typeof(T));
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.ObjectSpace), ObjectSpace);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.Application), Application);
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.FieldName), PersonIntakeFieldLabels.Label(key));
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.UsageKey), PersonLookupUsageKey(key));
        builder.AddAttribute(seq++, nameof(PersonIntakeSearchableLookup.LookupChanged),
            EventCallback.Factory.Create(this, () => InvokeAsync(StateHasChanged)));
        builder.CloseComponent();
    }

