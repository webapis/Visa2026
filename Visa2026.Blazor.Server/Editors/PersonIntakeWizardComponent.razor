    private void OnFamilyMemberRowClick(GridRowClickEventArgs e)
    {
        _familyOpenBlocked = string.Empty;
        if (Application == null || ObjectSpace == null || Person?.FamilyMembers == null)
            return;

        var row = e.Grid.GetDataItem(e.VisibleIndex) as FamilyMemberRow;
        var member = row == null ? null : Person.FamilyMembers.FirstOrDefault(item => item != null && item.ID == row.Id);
        if (member == null)
            return;

        if (ObjectSpace?.IsModified == true || ObjectSpace?.IsNewObject(Person) == true || ObjectSpace?.IsNewObject(member) == true)
        {
            _familyOpenBlocked = T("FamilyMembers.SaveFirst");
            return;
        }

        var wizard = PersonIntakeWizardAccess.IsWizardEnabled(ObjectSpace)
            ? PersonIntakeWizardOpenHelper.OpenExisting(Application, member)
            : PersonIntakeWizardOpenHelper.OpenNativeExisting(Application, member);
        if (wizard == null)
            return;

        Application.ShowViewStrategy.ShowView(
            new ShowViewParameters(wizard) { TargetWindow = TargetWindow.Current },
            new ShowViewSource(Application.MainWindow, null));
    }

