    private RenderFragment RenderDocumentCopiesEditor(
        List<PersonIntakeDocumentCopyDraft> copies,
        string noun,
        EventCallback<InputFileChangeEventArgs> onChange,
        Func<Guid, Task> onRemove,
        bool editable = true) => __builder =>
    {
        var seq = 0;
        var status = copies == State.OtherDrafts.FamilyRelationDocuments ? _familyDocStatus : string.Empty;
        var statusError = copies == State.OtherDrafts.FamilyRelationDocuments && _familyDocStatusError;

        __builder.OpenElement(seq++, "div");
        __builder.AddAttribute(seq++, "class", "person-intake-wizard__copies");
        if (editable)
        {
            __builder.OpenComponent<InputFile>(seq++);
            __builder.AddAttribute(seq++, "accept", ".pdf,.png,.jpg,.jpeg,.tif,.tiff,.gif,.bmp");
            __builder.AddAttribute(seq++, "multiple", true);
            __builder.AddAttribute(seq++, "OnChange", onChange);
            __builder.CloseComponent();
        }
        if (!string.IsNullOrWhiteSpace(status))
        {
            __builder.OpenElement(seq++, "p");
            __builder.AddAttribute(seq++, "class", "person-intake-wizard__record-hint" + (statusError ? " is-error" : string.Empty));
            __builder.AddContent(seq++, status);
            __builder.CloseElement();
        }

        if (copies.Count > 0)
        {
            __builder.OpenElement(seq++, "ul");
            __builder.AddAttribute(seq++, "class", "person-intake-wizard__copy-list");
            foreach (var copy in copies)
            {
                var copyId = copy.Id;
                __builder.OpenElement(seq++, "li");
                __builder.OpenElement(seq++, "span");
                __builder.AddContent(seq++, copy.FileName);
