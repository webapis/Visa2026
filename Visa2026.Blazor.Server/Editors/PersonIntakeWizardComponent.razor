@using System.IO
@using System.Linq
@using DevExpress.Blazor
@using DevExpress.ExpressApp
@using DevExpress.Persistent.BaseImpl.EF
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Web
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.ApplicationWorkspace
@using Visa2026.Module.Services.HeaderLinkedDocuments
@using Visa2026.Module.Services.PersonIntake
@using Visa2026.Module.Services.PersonLinkedDocuments
@using Visa2026.Module.Services.PreviewSlot
@using Visa2026.Module.Services.StateEvaluation

@if (Person == null)
{
    <div class="person-intake-wizard__empty">@T("NoPerson")</div>
}
else
{
    var steps = VisibleSteps();
    var currentIndex = Math.Clamp(_stepIndex, 0, Math.Max(0, steps.Count - 1));
    var active = steps[currentIndex];
    var findings = PersonIntakeCompleteness.Evaluate(Person, State.PendingKeys, State.DraftSatisfiedKeys());
    var unresolved = findings.Where(f => f.State == PersonIntakeItemState.Unresolved).ToList();
    var pending = findings.Where(f => f.State == PersonIntakeItemState.Pending).ToList();
    var blocksSave = unresolved.Any(f => !f.CanDefer);

    <div class="person-intake-wizard" @oninput="MarkUnsaved" @onchange="MarkUnsaved">
        <DetailRecordRibbon RecordTitle="@PersonHeading"
                            IsDirty="@State.Unsaved"
                            CanSave="@(State.Unsaved && !blocksSave)"
                            CanWrite="@(!Access.IsViewOnly)"
                            CanCreate="@(!Access.IsViewOnly && NewRequested.HasDelegate)"
                            CanDelete="@Access.CanDeletePerson"
                            TrySave="TrySaveAsync"
                            CloseRequested="CloseRequested"
                            NewRequested="NewRequested"
                            DeleteRequested="DeleteRequested" />
        <header class="person-intake-wizard__header">
            <div class="person-intake-wizard__who">
                <div class="person-intake-wizard__avatar" title="@PersonHeading">
                    @if (HasPhoto)
                    {
                        <img class="person-intake-wizard__avatar-img" alt="" src="@PhotoDataUrl(Person.Photo)" />
                    }
                    else
                    {
                        <span class="person-intake-wizard__avatar-initials">@PersonInitials</span>
                    }
                </div>
                <div class="person-intake-wizard__who-text">
                    <p class="person-intake-wizard__who-initials">@PersonInitials</p>
                    <p class="person-intake-wizard__who-name">@PersonHeading</p>
                    <h1 class="person-intake-wizard__title">
                        @WizardTitle
                    </h1>
                    <p class="person-intake-wizard__sub">@PersonIntakeText.Format("StepOf", currentIndex + 1, steps.Count, active.Title)</p>
                </div>
            </div>
            @if (pending.Count > 0)
            {
                <span class="person-intake-wizard__pending-pill">@PersonIntakeText.Format("Status.PendingCount", pending.Count)</span>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="person-intake-wizard__status @(IsStatusError ? "is-error" : "is-ok")" role="status">@StatusMessage</div>
        }
        @if (Access.IsViewOnly)
        {
            <div class="person-intake-wizard__status is-info" role="note">@PersonIntakeWizardAccess.ViewOnlyMessage</div>
        }

        <div class="person-intake-wizard__layout">
            <nav class="person-intake-wizard__nav" aria-label="@T("Nav.AriaLabel")">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var stepIndex = i;
                    var step = steps[stepIndex];
                    var stepFindings = findingsForStep(step, findings);
                    var status = StatusFor(step, stepFindings);
                    <button type="button"
                            class="person-intake-wizard__nav-item @NavTone(step) @(stepIndex == currentIndex ? "is-active" : null) @status.Css"
                            @onclick="() => GoToStep(stepIndex)">
                        <span class="person-intake-wizard__nav-badge">@status.Badge</span>
                        <span>
                            <span class="person-intake-wizard__nav-label">@step.Title</span>
                            <span class="person-intake-wizard__nav-status">@status.Text</span>
                        </span>
                    </button>
                }
            </nav>

            <div class="person-intake-wizard__panel">
                <div class="person-intake-wizard__panel-head">
                    <h2 class="person-intake-wizard__panel-title">@active.Title</h2>
                    @if (StepHasLookupTools(active))
                    {
                        <button type="button"
                                class="person-intake-wizard__gear @(_showLookupTools ? "is-on" : null)"
                                aria-pressed="@(_showLookupTools ? "true" : "false")"
                                title="@(_showLookupTools ? T("Gear.Hide") : T("Gear.Show"))"
                                aria-label="@T("Gear.AriaLabel")"
                                @onclick="() => _showLookupTools = !_showLookupTools">
                            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M19.14 12.94a7.07 7.07 0 0 0 .05-.94 7.07 7.07 0 0 0-.05-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.03 7.03 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 13.9 2h-3.8a.5.5 0 0 0-.49.42l-.36 2.54a7.03 7.03 0 0 0-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 8.48a.5.5 0 0 0 .12.64l2.03 1.58a7.07 7.07 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .6.22l2.39-.96c.5.38 1.05.7 1.63.94l.36 2.54a.5.5 0 0 0 .49.42h3.8a.5.5 0 0 0 .49-.42l.36-2.54a7.03 7.03 0 0 0 1.63-.94l2.39.96a.5.5 0 0 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64zM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7z"/>
                            </svg>
                        </button>
                    }
                </div>
                <p class="person-intake-wizard__panel-hint">@active.Hint</p>

                @if (active.Kind == PersonIntakeStepKind.Overview)
                {
                    <div class="person-intake-overview">
                        <p class="person-intake-overview__kicker">@T("Overview.Kicker")</p>
                        <div class="person-intake-overview__names">
                            <div class="person-intake-overview__name">
                                <span class="person-intake-overview__label">@PersonIntakeFieldLabels.Label(PersonPendingTargets.FirstName)</span>
                                <span class="person-intake-overview__value">@DisplayName(Person.FirstName)</span>
                            </div>
                            <div class="person-intake-overview__name">
                                <span class="person-intake-overview__label">@PersonIntakeFieldLabels.Label(PersonPendingTargets.LastName)</span>
                                <span class="person-intake-overview__value">@DisplayName(Person.LastName)</span>
                            </div>
                        </div>
                    </div>
                    @if (pending.Count > 0)
                    {
                        <div class="person-intake-wizard__review-block is-pending">
                            <strong>@PersonIntakeText.Format("Review.Pending", pending.Count)</strong>
                            <ul>
                                @foreach (var p in pending)
                                {
                                    <li>@PersonIntakeFieldLabels.Label(p.TargetKey)</li>
                                }
                            </ul>
                        </div>
                    }
                }
                else if (active.Kind == PersonIntakeStepKind.Form)
                {
                    var showPhoto = active.FieldKeys.Contains(PersonPendingTargets.Photo);
                    var sideKeys = active.CompanionFieldKeys;
                    var showSide = sideKeys.Count > 0;
                    var columns = new List<(string Css, string Title, IReadOnlyList<string> Keys)>
                    {
                        ("person-intake-wizard__form-fields-main", null, active.FieldKeys)
                    };
                    if (showSide)
                        columns.Add(("person-intake-wizard__form-fields-side", active.CompanionTitle, sideKeys));
                    <div class="person-intake-wizard__form-fields @(showPhoto ? "has-photo" : null) @(showSide ? "has-companion" : null)">
                    @foreach (var column in columns)
                    {
                    <div class="@column.Css">
                    @if (!string.IsNullOrWhiteSpace(column.Title))
                    {
                        <h3 class="person-intake-wizard__form-column-title">@column.Title</h3>
                    }
                    @foreach (var key in column.Keys)
                    {
                        if (key == PersonPendingTargets.Age || key == PersonPendingTargets.Photo)
                            continue;

                        var defer = State.PendingKeys.Contains(key);
                        var canDefer = PersonIntakeFieldLabels.CanDefer(key);
                        var canToggle = Access.CanTogglePendingField(key);
                        if (key == PersonPendingTargets.DateOfBirth)
                        {
                            var showAge = !defer && Person.DateOfBirth != default;
                            <div class="person-intake-wizard__field-row">
                                <label>@PersonIntakeFieldLabels.Label(key)</label>
                                <div class="person-intake-wizard__dob-age">
                                    <div class="person-intake-wizard__dob-age-date">
                                        @RenderField(key, defer)
                                    </div>
                                    @if (showAge)
                                    {
                                        <div class="person-intake-wizard__dob-age-calc" title="@T("Identity.AgeCalculated")">
                                            <span class="person-intake-wizard__dob-age-label">@PersonIntakeFieldLabels.Label(PersonPendingTargets.Age)</span>
                                            <input class="@FilledCss("person-intake-wizard__input person-intake-wizard__age-readonly", Person.DateOfBirth != default)"
                                                   disabled
                                                   value="@Person.Age.ToString()" />
                                        </div>
                                    }
                                </div>
                                @if (canDefer && (canToggle || defer))
                                {
                                    <label class="person-intake-wizard__toggle">
                                        <input type="checkbox" checked="@defer" disabled="@(!canToggle)" @onchange="e => TogglePending(key, e.Value is true)" />
                                        <span>@T("NotReceived")</span>
                                    </label>
                                }
                            </div>
                            continue;
                        }

                        <div class="person-intake-wizard__field-row">
                            <label>@PersonIntakeFieldLabels.Label(key)</label>
                            @RenderField(key, defer)
                            @if (canDefer && (canToggle || defer))
                            {
                                <label class="person-intake-wizard__toggle">
                                    <input type="checkbox" checked="@defer" disabled="@(!canToggle)" @onchange="e => TogglePending(key, e.Value is true)" />
                                    <span>@T("NotReceived")</span>
                                </label>
                            }
                        </div>
                    }
                    </div>
                    }
                    @if (showPhoto)
                    {
                        var photoKey = PersonPendingTargets.Photo;
                        var photoDefer = State.PendingKeys.Contains(photoKey);
                        var photoCanToggle = Access.CanTogglePendingField(photoKey);
                        <aside class="person-intake-wizard__photo-aside">
                            <span class="person-intake-wizard__photo-aside-label">@PersonIntakeFieldLabels.Label(photoKey)</span>
                            @RenderField(photoKey, photoDefer)
                            @if (PersonIntakeFieldLabels.CanDefer(photoKey) && (photoCanToggle || photoDefer))
                            {
                                <label class="person-intake-wizard__toggle">
                                    <input type="checkbox" checked="@photoDefer" disabled="@(!photoCanToggle)" @onchange="e => TogglePending(photoKey, e.Value is true)" />
                                    <span>@T("NotReceived")</span>
                                </label>
                            }
                        </aside>
                    }
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.FamilyMembers)
                {
                    @if (!string.IsNullOrWhiteSpace(_familyOpenBlocked))
                    {
                        <div class="person-intake-wizard__status is-error" role="alert">@_familyOpenBlocked</div>
                    }
                    <div class="pi-lv">
                        <DxGrid Data="FamilyMemberRows"
                                KeyFieldName="Id"
                                CssClass="pi-lv__grid"
                                ShowAllRows="true"
                                RowClick="OnFamilyMemberRowClick">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(FamilyMemberRow.FullName)" Caption="@FamilyNameCaption" />
                                <DxGridDataColumn FieldName="@nameof(FamilyMemberRow.Relationship)" Caption="@FamilyRelationshipCaption" />
                                <DxGridDataColumn FieldName="@nameof(FamilyMemberRow.DateOfBirth)" Caption="@FamilyBirthCaption" />
                                <DxGridDataColumn FieldName="@nameof(FamilyMemberRow.Nationality)" Caption="@FamilyNationalityCaption" />
                            </Columns>
                        </DxGrid>
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.Visas)
                {
                    <div class="pi-lv">
                        <DxGrid Data="VisaRows"
                                KeyFieldName="Id"
                                CssClass="pi-lv__grid"
                                ShowAllRows="true">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Preview)" Caption="@VisaPreviewCaption" Width="6.5rem" AllowSort="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var previewRow = context.DataItem as VisaRow;
                                        }
                                        @if (previewRow?.CanPreview == true)
                                        {
                                            <button type="button"
                                                    class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                    @onclick="() => PreviewVisaAsync(previewRow)">@VisaPreviewCaption</button>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(VisaRow.StateLabel)" Caption="@VisaStateCaption">
                                    <CellDisplayTemplate>
                                        @{
                                            var stateRow = context.DataItem as VisaRow;
                                        }
                                        @if (stateRow != null)
                                        {
                                            <span class="pi-wp-state @stateRow.StateCss">@stateRow.StateLabel</span>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Number)" Caption="@VisaNumberCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Type)" Caption="@VisaTypeCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Category)" Caption="@VisaCategoryCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.IssuedPlace)" Caption="@VisaIssuedPlaceCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.IssueDate)" Caption="@VisaIssueDateCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Start)" Caption="@VisaStartCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Expiration)" Caption="@VisaExpirationCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Days)" Caption="@VisaDaysCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.Passport)" Caption="@VisaPassportCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.ProcessNumber)" Caption="@VisaProcessNumberCaption" />
                                <DxGridDataColumn FieldName="@nameof(VisaRow.IssuingApplication)" Caption="@VisaIssuingApplicationCaption" />
                            </Columns>
                        </DxGrid>
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.Invitations)
                {
                    <div class="pi-lv">
                        <DxGrid Data="InvitationRows"
                                KeyFieldName="Id"
                                CssClass="pi-lv__grid"
                                ShowAllRows="true">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.Preview)" Caption="@InvitationPreviewCaption" Width="6.5rem" AllowSort="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var previewRow = context.DataItem as InvitationRow;
                                        }
                                        @if (previewRow?.CanPreview == true)
                                        {
                                            <button type="button"
                                                    class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                    @onclick="() => PreviewInvitationAsync(previewRow)">@InvitationPreviewCaption</button>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.StateLabel)" Caption="@InvitationStateCaption">
                                    <CellDisplayTemplate>
                                        @{
                                            var stateRow = context.DataItem as InvitationRow;
                                        }
                                        @if (stateRow != null)
                                        {
                                            <span class="pi-wp-state @stateRow.StateCss">@stateRow.StateLabel</span>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.Number)" Caption="@InvitationNumberCaption" />
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.Issued)" Caption="@InvitationIssuedCaption" />
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.Expiration)" Caption="@InvitationExpirationCaption" />
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.Passport)" Caption="@InvitationPassportCaption" />
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.Profile)" Caption="@InvitationProfileCaption" />
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.IssuedVisa)" Caption="@InvitationIssuedVisaCaption" />
                                <DxGridDataColumn FieldName="@nameof(InvitationRow.ProcessNumber)" Caption="@InvitationProcessNumberCaption" />
                            </Columns>
                        </DxGrid>
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.MedicalRecords)
                {
                    <div class="pi-lv">
                        <DxGrid Data="MedicalRows"
                                KeyFieldName="Id"
                                CssClass="pi-lv__grid"
                                ShowAllRows="true">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.Preview)" Caption="@MedicalPreviewCaption" Width="6.5rem" AllowSort="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var previewRow = context.DataItem as MedicalRow;
                                        }
                                        @if (previewRow?.CanPreview == true)
                                        {
                                            <button type="button"
                                                    class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                    @onclick="() => PreviewMedicalAsync(previewRow)">@MedicalPreviewCaption</button>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.StateLabel)" Caption="@MedicalStateCaption">
                                    <CellDisplayTemplate>
                                        @{
                                            var stateRow = context.DataItem as MedicalRow;
                                        }
                                        @if (stateRow != null)
                                        {
                                            <span class="pi-wp-state @stateRow.StateCss">@stateRow.StateLabel</span>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.Number)" Caption="@MedicalNumberCaption" />
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.IssueDate)" Caption="@MedicalIssueCaption" />
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.Validity)" Caption="@MedicalValidityCaption" />
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.Expiration)" Caption="@MedicalExpirationCaption" />
                                <DxGridDataColumn FieldName="@nameof(MedicalRow.Days)" Caption="@MedicalDaysCaption" />
                            </Columns>
                        </DxGrid>
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.WorkPermits)
                {
                    <div class="pi-lv">
                        <DxGrid Data="WorkPermitRows"
                                KeyFieldName="Id"
                                CssClass="pi-lv__grid"
                                ShowAllRows="true">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Preview)" Caption="@WorkPermitPreviewCaption" Width="6.5rem" AllowSort="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var previewRow = context.DataItem as WorkPermitRow;
                                        }
                                        @if (previewRow?.CanPreview == true)
                                        {
                                            <button type="button"
                                                    class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                    @onclick="() => PreviewWorkPermitAsync(previewRow)">@WorkPermitPreviewCaption</button>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.StateLabel)" Caption="@WorkPermitStateCaption">
                                    <CellDisplayTemplate>
                                        @{
                                            var stateRow = context.DataItem as WorkPermitRow;
                                        }
                                        @if (stateRow != null)
                                        {
                                            <span class="pi-wp-state @stateRow.StateCss">@stateRow.StateLabel</span>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Number)" Caption="@WorkPermitNumberCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Start)" Caption="@WorkPermitStartCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Expiration)" Caption="@WorkPermitExpirationCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Days)" Caption="@WorkPermitDaysCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Locations)" Caption="@WorkPermitLocationsCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.AsNumber)" Caption="@WorkPermitAsNumberCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Position)" Caption="@WorkPermitPositionCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Passport)" Caption="@WorkPermitPassportCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Header)" Caption="@WorkPermitHeaderCaption" />
                                <DxGridDataColumn FieldName="@nameof(WorkPermitRow.Profile)" Caption="@WorkPermitProfileCaption" />
                            </Columns>
                        </DxGrid>
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.ApplicationProfileInstances)
                {
                    <div class="pi-lv">
                        <DxGrid Data="ApplicationProfileInstanceRows"
                                KeyFieldName="Id"
                                CssClass="pi-lv__grid"
                                ShowAllRows="true">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(ApplicationProfileInstanceRow.StateLabel)" Caption="@ApplicationStateCaption">
                                    <CellDisplayTemplate>
                                        @{
                                            var stateRow = context.DataItem as ApplicationProfileInstanceRow;
                                        }
                                        @if (stateRow != null)
                                        {
                                            <span class="pi-wp-state @stateRow.StateCss">@stateRow.StateLabel</span>
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(ApplicationProfileInstanceRow.Number)" Caption="@ApplicationNumberCaption">
                                    <CellDisplayTemplate>
                                        @{
                                            var numberRow = context.DataItem as ApplicationProfileInstanceRow;
                                        }
                                        @if (numberRow != null && numberRow.Id != Guid.Empty && !string.IsNullOrWhiteSpace(numberRow.Number))
                                        {
                                            <button type="button"
                                                    class="person-intake-wizard__btn person-intake-wizard__btn--link"
                                                    @onclick="() => OpenApplicationProfileInstance(numberRow)">@numberRow.Number</button>
                                        }
                                        else
                                        {
                                            @(numberRow?.Number)
                                        }
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(ApplicationProfileInstanceRow.Profile)" Caption="@ApplicationProfileCaption" />
                                <DxGridDataColumn FieldName="@nameof(ApplicationProfileInstanceRow.Date)" Caption="@ApplicationDateCaption" />
                                <DxGridDataColumn FieldName="@nameof(ApplicationProfileInstanceRow.ProcessNumber)" Caption="@ApplicationProcessCaption" />
                            </Columns>
                        </DxGrid>
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.Record)
                {
                    <PersonIntakeRecordStep RecordKey="@active.RecordTargetKey"
                                            Person="Person"
                                            OwnerViewId="@OwnerViewId"
                                            State="State"
                                            Access="Access"
                                            ShowLookupTools="_showLookupTools"
                                            ObjectSpace="ObjectSpace"
                                            Application="Application"
                                            StateChanged="OnRecordStateChanged" />
                }
                else if (active.Kind == PersonIntakeStepKind.Others)
                {
                    @foreach (var option in active.OtherOptions)
                    {
                        var targetKey = option.TargetKey;
                        var on = State.PendingKeys.Contains(targetKey);
                        var canToggleOther = Access.CanTogglePendingStep(targetKey);
                        <div class="person-intake-wizard__other-card">
                            <div class="person-intake-wizard__other-row">
                                <div>
                                    <strong>@option.Label</strong>
                                    <p>@option.Help</p>
                                </div>
                                <label class="person-intake-wizard__toggle">
                                    <input type="checkbox" checked="@on" disabled="@(!canToggleOther)" @onchange="e => TogglePending(targetKey, e.Value is true)" />
                                    <span>@T("NotReceived")</span>
                                </label>
                            </div>
                            @if (on)
                            {
                                <p class="person-intake-wizard__record-hint">Marked as waiting — no row is created until this is cleared.</p>
                            }
                            else if (targetKey == PersonPendingTargets.PersonFamilyRelationDocument)
                            {
                                @RenderDocumentCopiesEditor(
                                    State.OtherDrafts.FamilyRelationDocuments,
                                    T("Other.FamilyRelationFile"),
                                    EventCallback.Factory.Create<InputFileChangeEventArgs>(this, OnFamilyRelationDocumentsSelected),
                                    RemoveFamilyRelationDocument,
                                    Access.CanAddRecord(targetKey))
                            }
                        </div>
                    }
                }
                else if (active.Kind == PersonIntakeStepKind.Review)
                {
                    @if (unresolved.Count > 0)
                    {
                        <div class="person-intake-wizard__review-block is-error">
                            <strong>@PersonIntakeText.Format("Review.Unresolved", unresolved.Count)</strong>
                            <ul>
                                @foreach (var u in unresolved)
                                {
                                    <li>@PersonIntakeFieldLabels.Label(u.TargetKey)</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (pending.Count > 0)
                    {
                        <div class="person-intake-wizard__review-block is-pending">
                            <strong>@PersonIntakeText.Format("Review.Pending", pending.Count)</strong>
                            <ul>
                                @foreach (var p in pending)
                                {
                                    <li>@PersonIntakeFieldLabels.Label(p.TargetKey)</li>
                                }
                            </ul>
                        </div>
                    }
                    <p class="person-intake-wizard__record-hint">
                        @T("Review.LaterNote")
                    </p>
                }
            </div>
        </div>
    </div>
}

