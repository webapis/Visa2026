    private async Task AddDocumentCopiesAsync(
        InputFileChangeEventArgs args,
        List<PersonIntakeDocumentCopyDraft> target,
        string noun,
        Action<string, bool> setStatus)
    {
        setStatus(string.Empty, false);
        if (args.FileCount == 0)
            return;

        MarkUnsaved();

        var maxMb = ObjectSpace != null
            ? (SystemSettings.TryGetInstance(ObjectSpace)?.MaxDocumentSizeInMB ?? SystemSettings.DefaultMaxDocumentSizeInMB)
            : SystemSettings.DefaultMaxDocumentSizeInMB;
        var maxBytes = maxMb * 1024L * 1024L;
        var hadError = false;

        foreach (var file in args.GetMultipleFiles(10))
        {
            if (file.Size > maxBytes)
            {
                setStatus(PersonIntakeText.Format("Files.TooLarge", file.Name, maxMb), true);
                hadError = true;
                continue;
            }

            await using var stream = file.OpenReadStream(maxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();

            if (ObjectSpace != null)
            {
                var validationError = PersonLinkedDocumentUploadService.ValidateBytes(ObjectSpace, file.Name, content);
                if (!string.IsNullOrEmpty(validationError))
                {
                    setStatus($"\"{file.Name}\": {validationError}", true);
                    hadError = true;
                    continue;
                }
            }

            target.Add(new PersonIntakeDocumentCopyDraft
            {
                FileName = file.Name,
                Content = content
            });
        }

        if (!hadError && target.Count > 0)
            setStatus(PersonIntakeText.Format("Files.Ready", target.Count), false);

        await InvokeAsync(StateHasChanged);
    }

