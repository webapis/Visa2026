@using System.IO
@using System.Linq
@using DevExpress.Blazor
@using DevExpress.ExpressApp
@using DevExpress.Persistent.BaseImpl.EF
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Web
@using Visa2026.Blazor.Server.Components
@using Visa2026.Module.BusinessObjects
@using Visa2026.Module.Localization
@using Visa2026.Module.Services
@using Visa2026.Module.Services.PersonIntake
@using Visa2026.Module.Services.PersonLinkedDocuments

@if (Person == null)
{
    <div class="person-intake-wizard__empty">@T("NoPerson")</div>
}
else
{
    var steps = VisibleSteps();
    var currentIndex = Math.Clamp(_stepIndex, 0, Math.Max(0, steps.Count - 1));
    var active = steps[currentIndex];
    var findings = PersonIntakeCompleteness.Evaluate(Person, State.PendingKeys, State.DraftSatisfiedKeys());
    var unresolved = findings.Where(f => f.State == PersonIntakeItemState.Unresolved).ToList();
    var pending = findings.Where(f => f.State == PersonIntakeItemState.Pending).ToList();

    <div class="person-intake-wizard">
        <header class="person-intake-wizard__header">
            <div class="person-intake-wizard__who">
                <div class="person-intake-wizard__avatar" title="@PersonHeading">
                    @if (HasPhoto)
                    {
                        <img class="person-intake-wizard__avatar-img" alt="" src="@PhotoDataUrl(Person.Photo)" />
                    }
                    else
                    {
                        <span class="person-intake-wizard__avatar-initials">@PersonInitials</span>
                    }
                </div>
                <div class="person-intake-wizard__who-text">
                    <p class="person-intake-wizard__who-initials">@PersonInitials</p>
                    <p class="person-intake-wizard__who-name">@PersonHeading</p>
                    <h1 class="person-intake-wizard__title">
                        @WizardTitle
                    </h1>
                    <p class="person-intake-wizard__sub">@PersonIntakeText.Format("StepOf", currentIndex + 1, steps.Count, active.Title)</p>
                </div>
            </div>
            @if (pending.Count > 0)
            {
                <span class="person-intake-wizard__pending-pill">@PersonIntakeText.Format("Status.PendingCount", pending.Count)</span>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="person-intake-wizard__status @(IsStatusError ? "is-error" : "is-ok")" role="status">@StatusMessage</div>
        }
        @if (Access.IsViewOnly)
        {
            <div class="person-intake-wizard__status is-info" role="note">@PersonIntakeWizardAccess.ViewOnlyMessage</div>
        }

        <div class="person-intake-wizard__layout">
            <nav class="person-intake-wizard__nav" aria-label="@T("Nav.AriaLabel")">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var stepIndex = i;
                    var step = steps[stepIndex];
                    var stepFindings = findingsForStep(step, findings);
                    var status = StatusFor(step, stepFindings);
                    <button type="button"
                            class="person-intake-wizard__nav-item @(stepIndex == currentIndex ? "is-active" : null) @status.Css"
                            @onclick="() => GoToStep(stepIndex)">
                        <span class="person-intake-wizard__nav-badge">@status.Badge</span>
                        <span>
                            <span class="person-intake-wizard__nav-label">@step.Title</span>
                            <span class="person-intake-wizard__nav-status">@status.Text</span>
                        </span>
                    </button>
                }
            </nav>

            <div class="person-intake-wizard__panel">
                <div class="person-intake-wizard__panel-head">
                    <h2 class="person-intake-wizard__panel-title">@active.Title</h2>
                    @if (StepHasLookupTools(active))
                    {
                        <button type="button"
                                class="person-intake-wizard__gear @(_showLookupTools ? "is-on" : null)"
                                aria-pressed="@(_showLookupTools ? "true" : "false")"
                                title="@(_showLookupTools ? T("Gear.Hide") : T("Gear.Show"))"
                                aria-label="@T("Gear.AriaLabel")"
                                @onclick="() => _showLookupTools = !_showLookupTools">
                            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M19.14 12.94a7.07 7.07 0 0 0 .05-.94 7.07 7.07 0 0 0-.05-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.03 7.03 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 13.9 2h-3.8a.5.5 0 0 0-.49.42l-.36 2.54a7.03 7.03 0 0 0-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 8.48a.5.5 0 0 0 .12.64l2.03 1.58a7.07 7.07 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .6.22l2.39-.96c.5.38 1.05.7 1.63.94l.36 2.54a.5.5 0 0 0 .49.42h3.8a.5.5 0 0 0 .49-.42l.36-2.54a7.03 7.03 0 0 0 1.63-.94l2.39.96a.5.5 0 0 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64zM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7z"/>
                            </svg>
                        </button>
                    }
                </div>
                <p class="person-intake-wizard__panel-hint">@active.Hint</p>

                @if (active.Kind == PersonIntakeStepKind.Overview)
                {
                    <div class="person-intake-overview">
                        <p class="person-intake-overview__kicker">@T("Overview.Kicker")</p>
                        <div class="person-intake-overview__names">
                            <div class="person-intake-overview__name">
                                <span class="person-intake-overview__label">@PersonIntakeFieldLabels.Label(PersonPendingTargets.FirstName)</span>
                                <span class="person-intake-overview__value">@DisplayName(Person.FirstName)</span>
                            </div>
                            <div class="person-intake-overview__name">
                                <span class="person-intake-overview__label">@PersonIntakeFieldLabels.Label(PersonPendingTargets.LastName)</span>
                                <span class="person-intake-overview__value">@DisplayName(Person.LastName)</span>
                            </div>
                        </div>
                    </div>
                    @if (pending.Count > 0)
                    {
                        <div class="person-intake-wizard__review-block is-pending">
                            <strong>@PersonIntakeText.Format("Review.Pending", pending.Count)</strong>
                            <ul>
                                @foreach (var p in pending)
                                {
                                    <li>@PersonIntakeFieldLabels.Label(p.TargetKey)</li>
                                }
                            </ul>
                        </div>
                    }
                }
                else if (active.Kind == PersonIntakeStepKind.Form)
                {
                    <div class="person-intake-wizard__form-fields">
                    @foreach (var key in active.FieldKeys)
                    {
                        if (key == PersonPendingTargets.Age)
                            continue;

                        var defer = State.PendingKeys.Contains(key);
                        var canDefer = PersonIntakeFieldLabels.CanDefer(key);
                        var canToggle = Access.CanTogglePendingField(key);
                        if (key == PersonPendingTargets.DateOfBirth)
                        {
                            var showAge = !defer && Person.DateOfBirth != default;
                            <div class="person-intake-wizard__field-row">
                                <label>@PersonIntakeFieldLabels.Label(key)</label>
                                <div class="person-intake-wizard__dob-age">
                                    <div class="person-intake-wizard__dob-age-date">
                                        @RenderField(key, defer)
                                    </div>
                                    @if (showAge)
                                    {
                                        <div class="person-intake-wizard__dob-age-calc" title="@T("Identity.AgeCalculated")">
                                            <span class="person-intake-wizard__dob-age-label">@PersonIntakeFieldLabels.Label(PersonPendingTargets.Age)</span>
                                            <input class="@FilledCss("person-intake-wizard__input person-intake-wizard__age-readonly", Person.DateOfBirth != default)"
                                                   disabled
                                                   value="@Person.Age.ToString()" />
                                        </div>
                                    }
                                </div>
                                @if (canDefer && (canToggle || defer))
                                {
                                    <label class="person-intake-wizard__toggle">
                                        <input type="checkbox" checked="@defer" disabled="@(!canToggle)" @onchange="e => TogglePending(key, e.Value is true)" />
                                        <span>@T("NotReceived")</span>
                                    </label>
                                }
                            </div>
                            continue;
                        }

                        <div class="person-intake-wizard__field-row @(key == PersonPendingTargets.Photo ? "person-intake-wizard__field-row--top" : null)">
                            <label>@PersonIntakeFieldLabels.Label(key)</label>
                            @RenderField(key, defer)
                            @if (canDefer && (canToggle || defer))
                            {
                                <label class="person-intake-wizard__toggle">
                                    <input type="checkbox" checked="@defer" disabled="@(!canToggle)" @onchange="e => TogglePending(key, e.Value is true)" />
                                    <span>@T("NotReceived")</span>
                                </label>
                            }
                        </div>
                    }
                    </div>
                }
                else if (active.Kind == PersonIntakeStepKind.Record)
                {
                    <PersonIntakeRecordStep RecordKey="@active.RecordTargetKey"
                                            Person="Person"
                                            OwnerViewId="@OwnerViewId"
                                            State="State"
                                            Access="Access"
                                            ShowLookupTools="_showLookupTools"
                                            ObjectSpace="ObjectSpace"
                                            Application="Application"
                                            StateChanged="OnRecordStateChanged" />
                }
                else if (active.Kind == PersonIntakeStepKind.Others)
                {
                    @foreach (var option in active.OtherOptions)
                    {
                        var targetKey = option.TargetKey;
                        var on = State.PendingKeys.Contains(targetKey);
                        var canToggleOther = Access.CanTogglePendingStep(targetKey);
                        <div class="person-intake-wizard__other-card">
                            <div class="person-intake-wizard__other-row">
                                <div>
                                    <strong>@option.Label</strong>
                                    <p>@option.Help</p>
                                </div>
                                <label class="person-intake-wizard__toggle">
                                    <input type="checkbox" checked="@on" disabled="@(!canToggleOther)" @onchange="e => TogglePending(targetKey, e.Value is true)" />
                                    <span>@T("NotReceived")</span>
                                </label>
                            </div>
                            @if (on)
                            {
                                <p class="person-intake-wizard__record-hint">Marked as waiting — no row is created until this is cleared.</p>
                            }
                            else if (targetKey == PersonPendingTargets.PersonFamilyRelationDocument)
                            {
                                @RenderDocumentCopiesEditor(
                                    State.OtherDrafts.FamilyRelationDocuments,
                                    T("Other.FamilyRelationFile"),
                                    EventCallback.Factory.Create<InputFileChangeEventArgs>(this, OnFamilyRelationDocumentsSelected),
                                    RemoveFamilyRelationDocument,
                                    Access.CanAddRecord(targetKey))
                            }
                            else if (targetKey == PersonPendingTargets.WorkDuty)
                            {
                                <div class="person-intake-wizard__record-form">
                                    <div class="person-intake-wizard__field-row person-intake-wizard__field-row--top">
                                        <label>@PersonIntakeFieldLabels.Label(PersonPendingTargets.WorkDuty)</label>
                                        <textarea class="@FilledCss("person-intake-wizard__input", State.OtherDrafts.WorkDuty.Description)" rows="4" disabled="@(!Access.CanAddRecord(targetKey))" @bind="State.OtherDrafts.WorkDuty.Description"></textarea>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (active.Kind == PersonIntakeStepKind.Review)
                {
                    @if (unresolved.Count > 0)
                    {
                        <div class="person-intake-wizard__review-block is-error">
                            <strong>@PersonIntakeText.Format("Review.Unresolved", unresolved.Count)</strong>
                            <ul>
                                @foreach (var u in unresolved)
                                {
                                    <li>@PersonIntakeFieldLabels.Label(u.TargetKey)</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (pending.Count > 0)
                    {
                        <div class="person-intake-wizard__review-block is-pending">
                            <strong>@PersonIntakeText.Format("Review.Pending", pending.Count)</strong>
                            <ul>
                                @foreach (var p in pending)
                                {
                                    <li>@PersonIntakeFieldLabels.Label(p.TargetKey)</li>
                                }
                            </ul>
                        </div>
                    }
                    <p class="person-intake-wizard__record-hint">
                        @T("Review.LaterNote")
                    </p>
                }

                <footer class="person-intake-wizard__footer">
                    <button type="button" class="person-intake-wizard__btn" disabled="@(currentIndex == 0)" @onclick="PreviousStep">@T("Back")</button>
                    <div class="person-intake-wizard__footer-right">
                        @if (currentIndex < steps.Count - 1)
                        {
                            <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--primary" @onclick="NextStep">@T("Next")</button>
                        }
                        else if (!Access.IsViewOnly)
                        {
                            <button type="button" class="person-intake-wizard__btn person-intake-wizard__btn--primary"
                                    disabled="@(unresolved.Count > 0)"
                                    @onclick="SaveAsync">
                                @(pending.Count > 0 ? SaveIncompleteLabel() : SaveCompleteLabel())
                            </button>
                        }
                    </div>
                </footer>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Person? Person { get; set; }
    [Parameter] public string? OwnerViewId { get; set; }
    [Parameter] public IObjectSpace? ObjectSpace { get; set; }
    [Parameter] public XafApplication? Application { get; set; }
    [Parameter] public PersonIntakeWizardState State { get; set; } = new();
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public bool IsStatusError { get; set; }
    [Parameter] public bool ShowIncompleteOverview { get; set; }
    [Parameter] public PersonIntakeWizardAccess Access { get; set; } = PersonIntakeWizardAccess.Unrestricted;
    [Parameter] public EventCallback SaveRequested { get; set; }

    private int _stepIndex;
    private bool _showLookupTools;

    private static readonly HashSet<string> LookupFieldKeys = new(StringComparer.Ordinal)
    {
        PersonPendingTargets.Gender,
        PersonPendingTargets.CountryOfBirth,
        PersonPendingTargets.Nationality,
        PersonPendingTargets.ForeignAddressCountry,
        PersonPendingTargets.MaritalStatus,
        PersonPendingTargets.ProjectContract,
        PersonPendingTargets.Subcontractor,
        PersonPendingTargets.Relationship
    };

    private static readonly HashSet<string> LookupRecordKeys = new(StringComparer.Ordinal)
    {
        PersonPendingTargets.Passport,
        PersonPendingTargets.Education,
        PersonPendingTargets.MedicalRecord,
        PersonPendingTargets.AddressOfResidence,
        PersonPendingTargets.TravelHistory,
        PersonPendingTargets.EmployeePositionHistory
    };

    /// <summary>Gear only on steps that render add / edit-capable list fields, and only for editors.</summary>
    private bool StepHasLookupTools(PersonIntakeStep step) =>
        !Access.IsViewOnly && step.Kind switch
        {
            PersonIntakeStepKind.Form => step.FieldKeys.Any(k => LookupFieldKeys.Contains(k) && Access.CanWriteField(k)),
            PersonIntakeStepKind.Record => LookupRecordKeys.Contains(step.RecordTargetKey),
            _ => false
        };
    private Guid? _overviewPersonId;
    private Guid? _familyPersonId;
    private string? _familySourceText;
    private IReadOnlyList<VisaFamilyMemberLineDto> _familyLines = Array.Empty<VisaFamilyMemberLineDto>();
    private IReadOnlyList<VisaFamilyMemberLineDto> _familyDraft = Array.Empty<VisaFamilyMemberLineDto>();
    private IReadOnlyList<RelationshipLookupItem> _familyRelationships = Array.Empty<RelationshipLookupItem>();
    private IReadOnlyList<CountryLookupItem> _familyCountries = Array.Empty<CountryLookupItem>();
    private bool _familyPopupVisible;
    private string _familyStatus = string.Empty;
    private bool _familyStatusError;
    private VisaFamilyMembersTextLocalization.UiTexts? _familyUi;
    private string _passportCopyStatus = string.Empty;
    private bool _passportCopyStatusError;
    private string _educationCopyStatus = string.Empty;
    private bool _educationCopyStatusError;
    private string _familyDocStatus = string.Empty;
    private bool _familyDocStatusError;

    private Task SaveAsync() => SaveRequested.HasDelegate ? SaveRequested.InvokeAsync() : Task.CompletedTask;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ShowIncompleteOverview || Person == null)
            return;

        if (_overviewPersonId == Person.ID)
            return;

        _overviewPersonId = Person.ID;
        _stepIndex = 0;
    }

    private IReadOnlyList<PersonIntakeStep> VisibleSteps()
    {
        var steps = PersonIntakeStepCatalog.Steps(Person)
            .Select(ApplyReadAccess)
            .Where(step => step != null)
            .ToList();
        if (!ShowIncompleteOverview)
            return steps;

        steps.Insert(0, new PersonIntakeStep
        {
            Id = "overview",
            Title = T("Step.Overview"),
            Hint = T("Step.Overview.Hint"),
            Kind = PersonIntakeStepKind.Overview
        });
        return steps;
    }

    /// <summary>Drops fields, record steps, and other-record options the role cannot read.</summary>
    private PersonIntakeStep? ApplyReadAccess(PersonIntakeStep step)
    {
        switch (step.Kind)
        {
            case PersonIntakeStepKind.Form:
                var fields = step.FieldKeys.Where(Access.CanReadField).ToList();
                return fields.Count == 0 ? null : new PersonIntakeStep
                {
                    Id = step.Id,
                    Title = step.Title,
                    Hint = step.Hint,
                    Kind = step.Kind,
                    FieldKeys = fields
                };
            case PersonIntakeStepKind.Record:
                return Access.CanReadStep(step.RecordTargetKey) ? step : null;
            case PersonIntakeStepKind.Others:
                var options = step.OtherOptions.Where(o => Access.CanReadStep(o.TargetKey)).ToList();
                return options.Count == 0 ? null : new PersonIntakeStep
                {
                    Id = step.Id,
                    Title = step.Title,
                    Hint = step.Hint,
                    Kind = step.Kind,
                    OtherOptions = options
                };
            default:
                return step;
        }
    }

    private static string DisplayName(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private bool HasPhoto => Person?.Photo is { Length: > 0 };

    private string PersonHeading
    {
        get
        {
            var first = Person?.FirstName?.Trim();
            var last = Person?.LastName?.Trim();
            if (string.IsNullOrEmpty(first) && string.IsNullOrEmpty(last))
                return T("NameNotEntered");
            return string.Join(" ", new[] { first, last }.Where(s => !string.IsNullOrEmpty(s)));
        }
    }

    private string PersonInitials
    {
        get
        {
            var first = NameInitial(Person?.FirstName);
            var last = NameInitial(Person?.LastName);
            if (first == null && last == null)
                return "—";
            if (first != null && last != null)
                return first + "." + last + ".";
            return (first ?? last) + ".";
        }
    }

    private static string? NameInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;
        var text = value.Trim();
        return char.ToUpperInvariant(text[0]).ToString();
    }
    private Task NextStep()
    {
        if (Person != null)
        {
            var steps = VisibleSteps();
            _stepIndex = Math.Min(_stepIndex + 1, steps.Count - 1);
        }
        return Task.CompletedTask;
    }

    private Task PreviousStep()
    {
        _stepIndex = Math.Max(0, _stepIndex - 1);
        return Task.CompletedTask;
    }

    private Task GoToStep(int index)
    {
        if (Person == null)
            return Task.CompletedTask;

        var stepCount = VisibleSteps().Count;
        _stepIndex = Math.Clamp(index, 0, Math.Max(0, stepCount - 1));
        return Task.CompletedTask;
    }

    private void TogglePending(string key, bool on)
    {
        if (on)
            State.PendingKeys.Add(key);
        else
            State.PendingKeys.Remove(key);
        InvokeAsync(StateHasChanged);
    }

    private string SaveCompleteLabel()
    {
        if (ObjectSpace?.IsNewObject(Person) != true)
            return T("Save.SaveChanges");
        return Person?.PersonRole == PersonRecordRole.Employee ? T("Save.CreateEmployee") : T("Save.CreateFamilyMember");
    }

    private string SaveIncompleteLabel() =>
        ObjectSpace?.IsNewObject(Person) == true ? T("Save.CreateIncomplete") : T("Save.SaveIncomplete");

    private string WizardTitle
    {
        get
        {
            var mode = Access.IsViewOnly ? "View" : ObjectSpace?.IsNewObject(Person) == true ? "New" : "Edit";
            var role = Person?.PersonRole == PersonRecordRole.Employee ? "Employee" : "FamilyMember";
            return T($"Title.{mode}{role}");
        }
    }

    private static string T(string key) => PersonIntakeText.Get(key);

    private Task OnRecordStateChanged() => InvokeAsync(StateHasChanged);

    private string GetRecordNote(string key) =>
        State.RecordNotes.TryGetValue(key, out var note) ? note : string.Empty;

    private void SetRecordNote(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            State.RecordNotes.Remove(key);
        else
            State.RecordNotes[key] = value;
    }

    private bool RecordHasRows(string recordKey) => recordKey switch
    {
        PersonPendingTargets.Passport => Person?.Passports?.Any(p => p != null) == true,
        PersonPendingTargets.Education => Person?.Educations?.Any(e => e != null) == true,
        PersonPendingTargets.MedicalRecord => Person?.MedicalRecords?.Any(m => m != null) == true,
        PersonPendingTargets.AddressOfResidence => Person?.AddressesOfResidence?.Any(a => a != null) == true,
        _ => false
    };

    private RenderFragment RenderField(string key, bool deferred) => builder =>
    {
        if (Person == null)
            return;

        var seq = 0;
        var css = "person-intake-wizard__input" + (deferred ? " is-pending" : string.Empty);
        var locked = deferred || !Access.CanWriteField(key);
        switch (key)
        {
            case PersonPendingTargets.FirstName:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", FilledCss(css, Person.FirstName));
                builder.AddAttribute(seq++, "disabled", locked);
                builder.AddAttribute(seq++, "value", Person.FirstName ?? string.Empty);
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => Person.FirstName = e.Value?.ToString()));
                builder.CloseElement();
                break;
            case PersonPendingTargets.LastName:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", FilledCss(css, Person.LastName));
                builder.AddAttribute(seq++, "disabled", locked);
                builder.AddAttribute(seq++, "value", Person.LastName ?? string.Empty);
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => Person.LastName = e.Value?.ToString()));
                builder.CloseElement();
                break;
            case PersonPendingTargets.DateOfBirth:
                builder.OpenComponent<OfficerDateEdit>(seq++);
                builder.AddAttribute(seq++, nameof(OfficerDateEdit.Date), Person.DateOfBirth == default ? null : Person.DateOfBirth);
                builder.AddAttribute(seq++, nameof(OfficerDateEdit.DateChanged), EventCallback.Factory.Create<DateTime?>(this, value =>
                {
                    Person.DateOfBirth = value ?? default;
                }));
                builder.AddAttribute(seq++, nameof(OfficerDateEdit.CssClass), "person-intake-wizard__input");
                builder.AddAttribute(seq++, nameof(OfficerDateEdit.Enabled), !locked);
                builder.AddAttribute(seq++, nameof(OfficerDateEdit.ReadOnly), locked);
                builder.CloseComponent();
                break;
            case PersonPendingTargets.PersonalNumber:
            case PersonPendingTargets.BirthPlace:
            case PersonPendingTargets.ForeignAddress:
                AddTextInput(builder, ref seq, css, locked, GetScalar(key), v => SetScalar(key, v));
                break;
            case PersonPendingTargets.Age:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", FilledCss(css, Person.DateOfBirth != default));
                builder.AddAttribute(seq++, "disabled", true);
                builder.AddAttribute(seq++, "value", Person.DateOfBirth == default ? string.Empty : Person.Age.ToString());
                builder.CloseElement();
                break;
            case PersonPendingTargets.VisaApplicationFamilyMembersText:
                EnsureVisaFamilyEditor();
                var familyUi = _familyUi ?? VisaFamilyMembersTextLocalization.Resolve();
                builder.OpenComponent<VisaFamilyMembersTextComponent>(seq++);
                builder.AddAttribute(seq++, nameof(VisaFamilyMembersTextComponent.DisplayText), VisaFamilyDisplayText(familyUi));
                builder.AddAttribute(seq++, nameof(VisaFamilyMembersTextComponent.Lines), _familyLines);
                builder.AddAttribute(seq++, nameof(VisaFamilyMembersTextComponent.DraftLines), _familyDraft);
                builder.AddAttribute(seq++, nameof(VisaFamilyMembersTextComponent.RelationshipOptions), _familyRelationships);
                builder.AddAttribute(seq++, nameof(VisaFamilyMembersTextComponent.CountryOptions), _familyCountries);
                builder.AddAttribute(seq++, nameof(VisaFamilyMembersTextComponent.LinesCommitted), EventCallback.Factory.Create<IReadOnlyList<VisaFamilyMemberLineDto>>(this, OnVisaFamilyLinesCommittedAsync));
