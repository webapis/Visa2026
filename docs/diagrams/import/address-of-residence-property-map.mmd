flowchart TB
  subgraph sources["VISA2015 source"]
    direction TB
    AOR["dbo.AddressOfResidence<br/>active: GCRecord IS NULL"]
    P["dbo.Person"]
    A["dbo.Address"]
    R["dbo.Region"]
    SE["dbo.SaherEtrap"]
    DOA["dbo.DocumentOfAddress<br/>type discriminator not a file"]
    AOR --- P
