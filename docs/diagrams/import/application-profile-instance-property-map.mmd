flowchart TB
  subgraph sources["VISA2015 source"]
    direction TB
    A["dbo.Application<br/>active: GCRecord IS NULL"]
    REG["dbo.IRegistration_Data"]
    ATE["dbo.ApplicationTypeForEmployee"]
    ATF["dbo.ApplicationTypeForFamilyMember"]
    CT["dbo.Contract"]
    BZ["dbo.BorderZoneForVisa"]
    A --- REG
    A --- ATE
    A --- ATF
    A --- CT
    A --- BZ
  end

  subgraph number["Numbering → ApplicationProfileInstance.cs"]
    direction LR
    L_MN["ManualApplicationNumber"] -->|"trim skip_row"| T_FULL["FullApplicationNumber"]
    L_MN -->|"parse suffix / prefix"| T_NUM["ApplicationNumber + AppNumberPrefix"]
    L_DT["ManualApplicationDate"] -->|"date skip_row"| T_DT["ApplicationDate"]
    L_DT -->|"year / month"| T_YM["Year + Month"]
    L_AR["AutoRegistration"] -->|"always true on import"| T_ME["IsManualEntry"]
  end

  subgraph typeMap["Type / profile → ApplicationProfileInstance.cs"]
    direction LR
    L_CMP["ForEmployee / ForFamilyMember<br/>subtype + InvWP / WizaWP + ChangeInformation"] -->|"composite → ApplicationType.Name<br/>skip E:33 / E:55"| T_AT["ApplicationType"]
    T_AT -->|"Wave 2 Code → tenant catalog"| T_AP["ApplicationProfile"]
    L_INF["no legacy VisaType FK"] -->|"infer from ApplicationType"| T_VT["VisaType"]
  end

  subgraph lookups["Lookups → ApplicationProfileInstance.cs"]
    direction LR
    L_UG["Urgency"] -->|"{Urgency}:{mgCode} default NORM"| T_UG["Urgency"]
    L_VP["VisaPeriod"] -->|"allow_null"| T_VP["VisaPeriod"]
    L_VC["VisaCategory"] -->|"allow_null"| T_VC["VisaCategory"]
    L_PC["Contract.NumberOfContract"] -->|"calik overlay Code"| T_PC["ProjectContract"]
    L_BZ["BorderZoneForVisa bits"] -->|"same as Visa"| T_BZ["BorderZoneLocation"]
    L_MP["GosmacaIslemageRugsatYeri"] -->|"NameTm"| T_MP["MovementPermitLocation"]
    L_MS["DepartmentForRegistration"] -->|"MigrationService NameTm"| T_MS["MigrationService"]
  end

  subgraph trip["Business trip → ApplicationProfileInstance.cs"]
    direction LR
    L_CY["BusinessTripDestination"] -->|"SaherEtrap → City"| T_CY["ToCity"]
    L_DEP["DateOfDeparture"] -->|"date"| T_ST["BusinessTripStartDate"]
    L_DEP -->|"+ DurationOfStay - 1"| T_EN["BusinessTripEndDate"]
  end

  A --> number
  A --> typeMap
  A --> lookups
  A --> trip
