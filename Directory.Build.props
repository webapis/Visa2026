<Project>
  <PropertyGroup>
    <!-- Existing compiler/analyzer noise (nullable annotations outside #nullable, generated catalog, duplicate usings, Windows GDI in PDF/scan). Does not hide CS errors. -->
    <NoWarn>$(NoWarn);CS0105;CS8632;CS8669;CA1416;XAF0022;XAF0025;XAF0031;XAF0033</NoWarn>
    <!-- File-lock retries (MSB3021/MSB3027): fail sooner when F5 and CLI share repo bin. -->
    <CopyRetryCount Condition="'$(CopyRetryCount)' == ''">3</CopyRetryCount>
    <CopyRetryDelayMilliseconds Condition="'$(CopyRetryDelayMilliseconds)' == ''">400</CopyRetryDelayMilliseconds>
  </PropertyGroup>

  <!-- Isolated builds: ArtifactsPath from artifacts-path CLI, or VISA2026_ISOLATED_BUILD=1. -->
  <PropertyGroup Condition="'$(ArtifactsPath)' != '' Or '$(VISA2026_ISOLATED_BUILD)' == '1'">
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <UseSharedCompilation>false</UseSharedCompilation>
    <CopyRetryCount>1</CopyRetryCount>
    <CopyRetryDelayMilliseconds>250</CopyRetryDelayMilliseconds>
  </PropertyGroup>
</Project>
