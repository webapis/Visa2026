# Copy to .env.prod and fill values for production.
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_USER=postgres
DEVEXPRESS_LICENSEKEY=CHANGE_ME_LICENSE_KEY

# Optional overrides
APP_PORT=80
DB_NAME=visa2026_prod
# Host-mapped Postgres port (default 5432).
# PG_HOST_PORT=5432
APP_IMAGE_TAG=latest
IMPORTER_IMAGE_TAG=latest
# One-shot: FORCE_XAF_DB_UPDATE=true (then remove) to run all XAF ModuleUpdaters when UpdateOldDatabase would skip them.
# FORCE_XAF_DB_UPDATE=true

# Officer manual (separate nginx service — not in app image; opt-in compose profile)
# COMPOSE_PROFILES=manual
# MANUAL_PORT=8082
# MANUAL_SITE_ROOT=./deploy/manual/site
# MANUAL_MEDIA_ROOT=./deploy/manual/media
# Build-time only (Publish-ManualRelease.ps1 / Build-UserManual.ps1):
# MANUAL_MEDIA_BASE_URL=https://your-host:8082/manual-media